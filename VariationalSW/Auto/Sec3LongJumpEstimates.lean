/-- `|e(x) - 1| ≤ 2π|x|` for the additive character `e(x) = e^{2πix}`. -/
theorem lj_norm_fourierChar_sub_one_le (x : ℝ) :
    ‖((Real.fourierChar x : Circle) : ℂ) - 1‖ ≤ 2 * π * |x| := by
  have h := norm_exp_I_mul_mul_sub_one_le (2 * π) x
  rw [Real.fourierChar_apply]
  have he : Complex.exp (((2 * π * x : ℝ) : ℂ) * I) =
      Complex.exp (I * ((2 * π : ℝ) : ℂ) * (x : ℂ)) := by
    congr 1; push_cast; ring
  rw [he]
  refine h.trans (le_of_eq ?_)
  rw [abs_of_pos (by positivity)]

/-- Change of variables under dilation for lower Lebesgue integrals on `ℝⁿ`:
`∫⁻ g(c x) dx = |c|^{-n} ∫⁻ g`. -/
theorem lj_lintegral_comp_smul (g : Rn n → ℝ≥0∞) {c : ℝ} (hc : c ≠ 0) :
    ∫⁻ x, g (c • x) = ENNReal.ofReal |(c ^ n)⁻¹| * ∫⁻ x, g x := by
  have h1 : ∫⁻ x, g (c • x) = ∫⁻ y, g y ∂(Measure.map (fun x : Rn n => c • x) volume) :=
    (lintegral_map_equiv g
      (Homeomorph.smul (isUnit_iff_ne_zero.2 hc).unit).toMeasurableEquiv).symm
  rw [h1, Measure.map_addHaar_smul volume hc, lintegral_smul_measure, finrank_euclideanSpace_fin]
  rfl

/-- **Translation estimate**: for a `C¹` function `ψ` on `ℝⁿ`,
`∫ |ψ(x - z) - ψ(x)| dx ≤ |z| ∫ |∇ψ|`. -/
theorem lj_lintegral_enorm_sub_le_of_contDiff {ψ : Rn n → ℂ} (hψ : ContDiff ℝ 1 ψ)
    (z : Rn n) :
    ∫⁻ x, ‖ψ (x - z) - ψ x‖ₑ ≤ ‖z‖ₑ * ∫⁻ x, ‖fderiv ℝ ψ x‖ₑ := by
  have hdc : Continuous (fderiv ℝ ψ) := hψ.continuous_fderiv (by norm_num)
  have hd : Differentiable ℝ ψ := hψ.differentiable (by norm_num)
  have hpt : ∀ x, ‖ψ (x - z) - ψ x‖ₑ ≤
      ∫⁻ s in Icc (0 : ℝ) 1, ‖fderiv ℝ ψ (x - s • z)‖ₑ * ‖z‖ₑ := by
    intro x
    set g : ℝ → ℂ := fun s => ψ (x - s • z) with hg
    have hgd : ∀ s, HasDerivAt g (fderiv ℝ ψ (x - s • z) (-z)) s := by
      intro s
      have h1 : HasDerivAt (fun s : ℝ => x - s • z) (-z) s := by
        simpa using ((hasDerivAt_id s).smul_const z).const_sub x
      exact (hd _).hasFDerivAt.comp_hasDerivAt s h1
    have hc1 : Continuous fun s : ℝ => x - s • z := by fun_prop
    have hcont : Continuous fun s => fderiv ℝ ψ (x - s • z) (-z) :=
      (hdc.comp hc1).clm_apply continuous_const
    have hint := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := 1)
      (fun s _ => hgd s) (hcont.intervalIntegrable 0 1)
    have hval : ψ (x - z) - ψ x = g 1 - g 0 := by simp [hg]
    rw [hval, ← hint, intervalIntegral.integral_of_le zero_le_one]
    refine (enorm_integral_le_lintegral_enorm _).trans ?_
    refine (lintegral_mono_set Ioc_subset_Icc_self).trans ?_
    refine lintegral_mono fun s => ?_
    refine (ContinuousLinearMap.le_opENorm _ _).trans ?_
    rw [enorm_neg]
  have hmeas : Measurable (Function.uncurry fun (x : Rn n) (s : ℝ) =>
      ‖fderiv ℝ ψ (x - s • z)‖ₑ * ‖z‖ₑ) := by
    have hc2 : Continuous fun p : Rn n × ℝ => p.1 - p.2 • z := by fun_prop
    exact (hdc.comp hc2).enorm.measurable.mul_const _
  calc ∫⁻ x, ‖ψ (x - z) - ψ x‖ₑ
      ≤ ∫⁻ x, ∫⁻ s in Icc (0 : ℝ) 1, ‖fderiv ℝ ψ (x - s • z)‖ₑ * ‖z‖ₑ := lintegral_mono hpt
    _ = ∫⁻ s in Icc (0 : ℝ) 1, ∫⁻ x, ‖fderiv ℝ ψ (x - s • z)‖ₑ * ‖z‖ₑ :=
        lintegral_lintegral_swap hmeas.aemeasurable
    _ = ∫⁻ s in Icc (0 : ℝ) 1, (∫⁻ x, ‖fderiv ℝ ψ x‖ₑ) * ‖z‖ₑ := by
        refine lintegral_congr fun s => ?_
        rw [lintegral_mul_const' _ _ enorm_ne_top]
        congr 1
        exact lintegral_sub_right_eq_self (fun x => ‖fderiv ℝ ψ x‖ₑ) (s • z)
    _ = ‖z‖ₑ * ∫⁻ x, ‖fderiv ℝ ψ x‖ₑ := by
        rw [setLIntegral_const, Real.volume_Icc, sub_zero, ENNReal.ofReal_one, mul_one,
          mul_comm]

/-- **Fourier decay from the translation modulus**: if
`∫ |ψ(x - z) - ψ(x)| dx ≤ |z| D` for all `z`, then `4 |η| |𝓕ψ(η)| ≤ D`
(shift by `h = η/(2|η|²)`, for which `e(-⟪h, η⟫) = -1`). -/
theorem lj_norm_fourier_mul_le {ψ : Rn n → ℂ} (hψ : Integrable ψ) {D : ℝ} (hD0 : 0 ≤ D)
    (hD : ∀ z, ∫⁻ x, ‖ψ (x - z) - ψ x‖ₑ ≤ ENNReal.ofReal (‖z‖ * D)) (η : Rn n) :
    ‖𝓕 ψ η‖ * (4 * ‖η‖) ≤ D := by
  rcases eq_or_ne η 0 with rfl | hη
  · simpa using hD0
  have hηp : 0 < ‖η‖ := norm_pos_iff.2 hη
  set h : Rn n := (2 * ‖η‖ ^ 2)⁻¹ • η with hh
  have hin : inner ℝ h η = 1 / 2 := by
    rw [hh, real_inner_smul_left, real_inner_self_eq_norm_sq]
    field_simp
  have hnh : ‖h‖ = (2 * ‖η‖)⁻¹ := by
    rw [hh, norm_smul, Real.norm_of_nonneg (by positivity)]
    field_simp
  have hchar : ∀ w : Rn n, (Real.fourierChar (-inner ℝ (w + h) η) : ℂ) =
      -(Real.fourierChar (-inner ℝ w η) : ℂ) := by
    intro w
    rw [inner_add_left, hin, neg_add, Real.fourierChar_apply, Real.fourierChar_apply]
    rw [show ((2 * π * (-inner ℝ w η + -(1 / 2)) : ℝ) : ℂ) * I =
      ((2 * π * -inner ℝ w η : ℝ) : ℂ) * I + (-(π : ℂ) * I) by push_cast; ring,
      Complex.exp_add]
    rw [show -(π : ℂ) * I = -(π * I) by ring, Complex.exp_neg, Complex.exp_pi_mul_I]
    ring
  have hshift : ∫ v, (Real.fourierChar (-inner ℝ v η) : ℂ) * ψ (v - h) = -𝓕 ψ η := by
    rw [← integral_add_right_eq_self _ h]
    simp_rw [add_sub_cancel_right, hchar, neg_mul]
    rw [integral_neg, Real.fourier_eq]
    simp_rw [Circle.smul_def, smul_eq_mul]
  have hI1 : Integrable fun v => (Real.fourierChar (-inner ℝ v η) : ℂ) * ψ v := by
    have := (Real.fourierIntegral_convergent_iff (μ := volume) (w := η)).2 hψ
    simpa [Circle.smul_def] using this
  have hI2 : Integrable fun v => (Real.fourierChar (-inner ℝ v η) : ℂ) * ψ (v - h) := by
    have hψh : Integrable fun v => ψ (v - h) := hψ.comp_sub_right h
    have := (Real.fourierIntegral_convergent_iff (μ := volume) (w := η)).2 hψh
    simpa [Circle.smul_def] using this
  have h2 : 2 * 𝓕 ψ η = ∫ v, (Real.fourierChar (-inner ℝ v η) : ℂ) * (ψ v - ψ (v - h)) := by
    simp_rw [mul_sub]
    rw [integral_sub hI1 hI2, hshift, Real.fourier_eq]
    simp_rw [Circle.smul_def, smul_eq_mul]
    ring
  have hle : ‖2 * 𝓕 ψ η‖ₑ ≤ ENNReal.ofReal (‖h‖ * D) := by
    rw [h2]
    refine (enorm_integral_le_lintegral_enorm _).trans ?_
    calc ∫⁻ v, ‖(Real.fourierChar (-inner ℝ v η) : ℂ) * (ψ v - ψ (v - h))‖ₑ
        = ∫⁻ v, ‖ψ (v - h) - ψ v‖ₑ := by
          refine lintegral_congr fun v => ?_
          rw [enorm_mul, ← enorm_neg (ψ v - ψ (v - h)), neg_sub]
          simp [enorm_eq_nnnorm]
      _ ≤ _ := hD h
  rw [← ofReal_norm, ENNReal.ofReal_le_ofReal_iff (by positivity), norm_mul,
    Complex.norm_two, hnh] at hle
  have : ‖𝓕 ψ η‖ * (4 * ‖η‖) = (2 * ‖𝓕 ψ η‖) * (2 * ‖η‖) := by ring
  rw [this]
  calc (2 * ‖𝓕 ψ η‖) * (2 * ‖η‖) ≤ ((2 * ‖η‖)⁻¹ * D) * (2 * ‖η‖) :=
        mul_le_mul_of_nonneg_right hle (by positivity)
    _ = D := by field_simp

/-- **Fourier transform near the origin**: if `ψ` is integrable and vanishes outside the ball of
radius `R`, then `|𝓕ψ(η) - ∫ψ| ≤ 2π R |η| ∫ |ψ|`. -/
theorem lj_norm_fourier_sub_integral_le {ψ : Rn n → ℂ} (hψ : Integrable ψ) {R : ℝ}
    (hsupp : ∀ x, R < ‖x‖ → ψ x = 0) (η : Rn n) :
    ‖𝓕 ψ η - ∫ x, ψ x‖ ≤ 2 * π * R * ‖η‖ * ∫ x, ‖ψ x‖ := by
  have hI1 : Integrable fun v => (Real.fourierChar (-inner ℝ v η) : ℂ) * ψ v := by
    have := (Real.fourierIntegral_convergent_iff (μ := volume) (w := η)).2 hψ
    simpa [Circle.smul_def] using this
  have heq : 𝓕 ψ η - ∫ x, ψ x =
      ∫ v, ((Real.fourierChar (-inner ℝ v η) : ℂ) - 1) * ψ v := by
    simp_rw [sub_mul, one_mul]
    rw [integral_sub hI1 hψ, Real.fourier_eq]
    simp_rw [Circle.smul_def, smul_eq_mul]
  rw [heq, ← integral_const_mul]
  refine norm_integral_le_of_norm_le (hψ.norm.const_mul _) (Eventually.of_forall fun v => ?_)
  rw [norm_mul]
  by_cases hv : R < ‖v‖
  · rw [hsupp v hv]; simp
  · replace hv := not_lt.1 hv
    refine mul_le_mul_of_nonneg_right ((lj_norm_fourierChar_sub_one_le _).trans ?_)
      (norm_nonneg _)
    rw [abs_neg]
    have := abs_real_inner_le_norm v η
    have h2 : ‖v‖ * ‖η‖ ≤ R * ‖η‖ := mul_le_mul_of_nonneg_right hv (norm_nonneg _)
    nlinarith [Real.pi_pos]

end Tools

section SquareFunction

variable {n : ℕ}

/-- `(∑ aᵢ²)^{1/2} ≤ ∑ aᵢ` for nonnegative `aᵢ`. -/
theorem lj_sqrt_sum_sq_le {ι : Type*} (s : Finset ι) (a : ι → ℝ) (ha : ∀ i ∈ s, 0 ≤ a i) :
    √(∑ i ∈ s, a i ^ 2) ≤ ∑ i ∈ s, a i := by
  rw [show ∑ i ∈ s, a i = √((∑ i ∈ s, a i) ^ 2) from
    (Real.sqrt_sq (Finset.sum_nonneg ha)).symm]
  exact Real.sqrt_le_sqrt (Finset.sum_sq_le_sq_sum_of_nonneg ha)

/-- `min(a, b) ≤ a^{1-δ} b^δ` for `a, b ≥ 0`, `0 ≤ δ ≤ 1`. -/
theorem lj_min_le_rpow_mul_rpow {a b δ : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hδ0 : 0 ≤ δ)
    (hδ1 : δ ≤ 1) : min a b ≤ a ^ (1 - δ) * b ^ δ := by
  rcases le_total a b with h | h
  · rw [min_eq_left h]
    calc a = a ^ (1 - δ) * a ^ δ := by
          rw [← Real.rpow_add' ha (by norm_num), sub_add_cancel, Real.rpow_one]
      _ ≤ a ^ (1 - δ) * b ^ δ := by gcongr
  · rw [min_eq_right h]
    calc b = b ^ (1 - δ) * b ^ δ := by
          rw [← Real.rpow_add' hb (by norm_num), sub_add_cancel, Real.rpow_one]
      _ ≤ a ^ (1 - δ) * b ^ δ := by gcongr

/-- The geometric constant `G_δ = ∑_{i ∈ ℤ} 2^{-δ |i|}`. -/
noncomputable def ljGeom (δ : ℝ) : ℝ := ∑' i : ℤ, ((2 : ℝ) ^ (-δ)) ^ i.natAbs

/-- Summability of `2^{-δ |i|}` for `δ > 0`. -/
theorem lj_summable_geom {δ : ℝ} (hδ : 0 < δ) :
    Summable fun i : ℤ => ((2 : ℝ) ^ (-δ)) ^ i.natAbs := by
  have hr0 : 0 ≤ (2 : ℝ) ^ (-δ) := by positivity
  have hr1 : (2 : ℝ) ^ (-δ) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  refine Summable.of_nat_of_neg ?_ ?_
  · simpa using summable_geometric_of_lt_one hr0 hr1
  · simpa using summable_geometric_of_lt_one hr0 hr1

/-- `G_δ ≥ 0`. -/
theorem ljGeom_nonneg (δ : ℝ) : 0 ≤ ljGeom δ :=
  tsum_nonneg fun i => by positivity

/-- **Geometric sum over dyadic scales**: for `t ≥ 0`, `R > 0`, `δ > 0` and every finite set
`s ⊆ ℤ`, `∑_{j ∈ s, 2^j t < R} (2^j t)^δ ≤ R^δ G_δ`. -/
theorem lj_sum_geom_le {δ : ℝ} (hδ : 0 < δ) {t R : ℝ} (ht : 0 ≤ t) (hR : 0 < R)
    (s : Finset ℤ) :
    ∑ j ∈ s, (if (2 : ℝ) ^ j * t < R then ((2 : ℝ) ^ j * t) ^ δ else 0) ≤
      R ^ δ * ljGeom δ := by
  have hG := ljGeom_nonneg δ
  rcases ht.eq_or_lt with rfl | ht
  · refine (Finset.sum_nonpos fun j _ => ?_).trans (by positivity)
    split_ifs
    · rw [mul_zero, Real.zero_rpow hδ.ne']
    · exact le_rfl
  obtain ⟨N, hN1, hN2⟩ := exists_mem_Ico_zpow (div_pos ht hR) one_lt_two
  set r : ℝ := (2 : ℝ) ^ (-δ) with hr
  have hterm : ∀ j : ℤ, (if (2 : ℝ) ^ j * t < R then ((2 : ℝ) ^ j * t) ^ δ else 0) ≤
      R ^ δ * r ^ (j + (N + 1)).natAbs := by
    intro j
    split_ifs with hj
    · have h2j : (0 : ℝ) < 2 ^ j := zpow_pos two_pos j
      have hlow : (2 : ℝ) ^ (j + N) ≤ 2 ^ j * t / R := by
        rw [zpow_add₀ two_ne_zero, mul_div_assoc]; gcongr
      have hup : 2 ^ j * t / R < (2 : ℝ) ^ (j + (N + 1)) := by
        rw [zpow_add₀ two_ne_zero, mul_div_assoc]; gcongr
      have hlt1 : 2 ^ j * t / R < 1 := (div_lt_one hR).2 hj
      have hneg : j + N < 0 := by
        by_contra h
        have : (1 : ℝ) ≤ 2 ^ (j + N) := one_le_zpow₀ one_le_two (not_lt.1 h)
        linarith
      have hk : j + (N + 1) ≤ 0 := by omega
      have hpow : ((2 : ℝ) ^ (j + (N + 1))) ^ δ = r ^ (j + (N + 1)).natAbs := by
        rw [hr, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_intCast,
          ← Real.rpow_mul (by norm_num)]
        congr 1
        have hc : ((j + (N + 1)).natAbs : ℝ) = -((j + (N + 1) : ℤ) : ℝ) := by
          rw [← Int.cast_natCast, Int.ofNat_natAbs_of_nonpos hk, Int.cast_neg]
        rw [hc]; push_cast; ring
      calc ((2 : ℝ) ^ j * t) ^ δ = (R * (2 ^ j * t / R)) ^ δ := by
            rw [mul_div_cancel₀ _ hR.ne']
        _ = R ^ δ * (2 ^ j * t / R) ^ δ := Real.mul_rpow hR.le (by positivity)
        _ ≤ R ^ δ * ((2 : ℝ) ^ (j + (N + 1))) ^ δ := by gcongr
        _ = R ^ δ * r ^ (j + (N + 1)).natAbs := by rw [hpow]
    · positivity
  have hsum := (lj_summable_geom hδ).comp_injective (add_left_injective (N + 1))
  calc ∑ j ∈ s, (if (2 : ℝ) ^ j * t < R then ((2 : ℝ) ^ j * t) ^ δ else 0)
      ≤ ∑ j ∈ s, R ^ δ * r ^ (j + (N + 1)).natAbs := Finset.sum_le_sum fun j _ => hterm j
    _ = R ^ δ * ∑ j ∈ s, r ^ (j + (N + 1)).natAbs := by rw [Finset.mul_sum]
    _ ≤ R ^ δ * ∑' j : ℤ, r ^ (j + (N + 1)).natAbs := by
        gcongr
        exact hsum.sum_le_tsum s fun j _ => by positivity
    _ = R ^ δ * ljGeom δ := by
        congr 1
        exact (Equiv.addRight (N + 1)).tsum_eq fun i : ℤ => r ^ i.natAbs

/-- **Multiplier sums over dyadic dilates**: there is `B` such that whenever
`|𝓕ψ(η)|² ≤ c (min(|η|, |η|⁻¹) + min(|η|/ρ, ρ/|η|))` for all `η` (`c ≥ 0`, `ρ > 0`), then
`∑_{j ∈ s} |𝓕ψ_j(ξ)|² ≤ 2 c B` for all finite `s ⊆ ℤ` and all `ξ`
(`ψ_j(x) = 2^{jn} ψ(2^j x)`, `𝓕ψ_j(ξ) = 𝓕ψ(2^{-j} ξ)`). This is the form in which the
multiplier bounds (3.12) of the paper enter. -/
theorem lj_sum_norm_fourier_lpDilate_sq_le :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (ψ : Rn n → ℂ) (c ρ : ℝ), 0 ≤ c → 0 < ρ →
      (∀ η, ‖𝓕 ψ η‖ ^ 2 ≤ c * (min ‖η‖ ‖η‖⁻¹ + min (‖η‖ / ρ) (‖η‖ / ρ)⁻¹)) →
      ∀ (s : Finset ℤ) (ξ : Rn n), ∑ j ∈ s, ‖𝓕 (lpDilate n ψ j) ξ‖ ^ 2 ≤ 2 * c * B := by
  obtain ⟨B, hB, hsum⟩ := lp_sum_min_le
  refine ⟨B, hB, fun ψ c ρ hc hρ hψ s ξ => ?_⟩
  have hterm : ∀ j : ℤ, ‖𝓕 (lpDilate n ψ j) ξ‖ ^ 2 ≤
      c * (min ((2 : ℝ) ^ (-j) * ‖ξ‖) ((2 : ℝ) ^ (-j) * ‖ξ‖)⁻¹ +
        min ((2 : ℝ) ^ (-j) * (‖ξ‖ / ρ)) ((2 : ℝ) ^ (-j) * (‖ξ‖ / ρ))⁻¹) := by
    intro j
    rw [fourier_lpDilate]
    have hn : ‖((2 : ℝ) ^ j)⁻¹ • ξ‖ = (2 : ℝ) ^ (-j) * ‖ξ‖ := by
      rw [norm_smul, Real.norm_of_nonneg (by positivity), zpow_neg]
    have h := hψ (((2 : ℝ) ^ j)⁻¹ • ξ)
    rwa [hn, mul_div_assoc] at h
  calc ∑ j ∈ s, ‖𝓕 (lpDilate n ψ j) ξ‖ ^ 2
      ≤ ∑ j ∈ s, c * (min ((2 : ℝ) ^ (-j) * ‖ξ‖) ((2 : ℝ) ^ (-j) * ‖ξ‖)⁻¹ +
        min ((2 : ℝ) ^ (-j) * (‖ξ‖ / ρ)) ((2 : ℝ) ^ (-j) * (‖ξ‖ / ρ))⁻¹) :=
        Finset.sum_le_sum fun j _ => hterm j
    _ = c * (∑ j ∈ s, min ((2 : ℝ) ^ (-j) * ‖ξ‖) ((2 : ℝ) ^ (-j) * ‖ξ‖)⁻¹ +
        ∑ j ∈ s, min ((2 : ℝ) ^ (-j) * (‖ξ‖ / ρ)) ((2 : ℝ) ^ (-j) * (‖ξ‖ / ρ))⁻¹) := by
        rw [← Finset.sum_add_distrib, Finset.mul_sum]
    _ ≤ c * (B + B) := by
        gcongr
        · exact lp_sum_min_neg_le hsum s (norm_nonneg ξ)
        · exact lp_sum_min_neg_le hsum s (by positivity)
    _ = 2 * c * B := by ring

/-- The class of kernels used for the square functions of Section 3: `ψ` is continuous,
vanishes outside the ball of radius `R`, has `∫ |ψ| ≤ B₀`, and has translation modulus
`∫ |ψ(x - z) - ψ(x)| dx ≤ |z| D`. -/
structure LjKernel (n : ℕ) (ψ : Rn n → ℂ) (R B₀ D : ℝ) : Prop where
  continuous : Continuous ψ
  eq_zero : ∀ x, R < ‖x‖ → ψ x = 0
  lintegral_le : ∫⁻ x, ‖ψ x‖ₑ ≤ ENNReal.ofReal B₀
  translate_le : ∀ z, ∫⁻ x, ‖ψ (x - z) - ψ x‖ₑ ≤ ENNReal.ofReal (‖z‖ * D)

/-- Kernels of the class `LjKernel` have compact support. -/
theorem LjKernel.hasCompactSupport {ψ : Rn n → ℂ} {R B₀ D : ℝ} (h : LjKernel n ψ R B₀ D) :
    HasCompactSupport ψ :=
  HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) R) fun x hx =>
    h.eq_zero x (by simpa using hx)

/-- Kernels of the class `LjKernel` are integrable. -/
theorem LjKernel.integrable {ψ : Rn n → ℂ} {R B₀ D : ℝ} (h : LjKernel n ψ R B₀ D) :
    Integrable ψ :=
  h.continuous.integrable_of_hasCompactSupport h.hasCompactSupport

/-- Dilates of continuous functions are continuous. -/
theorem continuous_lpDilate {ψ : Rn n → ℂ} (hψ : Continuous ψ) (j : ℤ) :
    Continuous (lpDilate n ψ j) := by
  unfold lpDilate
  exact continuous_const.mul (hψ.comp (continuous_const_smul _))

/-- The single-kernel Hörmander integral: for `ψ ∈ LjKernel n ψ R B₀ D` and `0 ≤ δ ≤ 1`,
`∫_{|w| > 2|z|} |ψ(w - z) - ψ(w)| dw ≤ (2B₀)^{1-δ} (|z| D)^δ` if `|z| < R`, and `= 0`
otherwise. -/
theorem LjKernel.setLIntegral_sub_le {ψ : Rn n → ℂ} {R B₀ D : ℝ} (h : LjKernel n ψ R B₀ D)
    (hR : 0 < R) (hB : 0 ≤ B₀) (hD : 0 ≤ D) {δ : ℝ} (hδ0 : 0 ≤ δ) (hδ1 : δ ≤ 1) (z : Rn n) :
    ∫⁻ w in {w | 2 * ‖z‖ < ‖w‖}, ‖ψ (w - z) - ψ w‖ₑ ≤
      ENNReal.ofReal (if ‖z‖ < R then (2 * B₀) ^ (1 - δ) * (‖z‖ * D) ^ δ else 0) := by
  split_ifs with hz
  · have h1 : ∫⁻ w in {w | 2 * ‖z‖ < ‖w‖}, ‖ψ (w - z) - ψ w‖ₑ ≤ ENNReal.ofReal (2 * B₀) := by
      refine (setLIntegral_le_lintegral _ _).trans ?_
      calc ∫⁻ w, ‖ψ (w - z) - ψ w‖ₑ ≤ ∫⁻ w, (‖ψ (w - z)‖ₑ + ‖ψ w‖ₑ) :=
            lintegral_mono fun w => enorm_sub_le
        _ = (∫⁻ w, ‖ψ (w - z)‖ₑ) + ∫⁻ w, ‖ψ w‖ₑ :=
            lintegral_add_right _ h.continuous.enorm.measurable
        _ = (∫⁻ w, ‖ψ w‖ₑ) + ∫⁻ w, ‖ψ w‖ₑ := by
            rw [lintegral_sub_right_eq_self (fun w => ‖ψ w‖ₑ) z]
        _ ≤ ENNReal.ofReal B₀ + ENNReal.ofReal B₀ := add_le_add h.lintegral_le h.lintegral_le
        _ = ENNReal.ofReal (2 * B₀) := by rw [← ENNReal.ofReal_add hB hB, two_mul]
    have h2 : ∫⁻ w in {w | 2 * ‖z‖ < ‖w‖}, ‖ψ (w - z) - ψ w‖ₑ ≤ ENNReal.ofReal (‖z‖ * D) :=
      (setLIntegral_le_lintegral _ _).trans (h.translate_le z)
    refine (le_min h1 h2).trans ?_
    rw [← ENNReal.ofReal_min]
    exact ENNReal.ofReal_le_ofReal
      (lj_min_le_rpow_mul_rpow (by positivity) (by positivity) hδ0 hδ1)
  · rw [ENNReal.ofReal_zero, nonpos_iff_eq_zero]
    refine setLIntegral_eq_zero (measurableSet_lt measurable_const measurable_norm)
      fun w hw => ?_
    have hw : 2 * ‖z‖ < ‖w‖ := hw
    have hz : R ≤ ‖z‖ := not_lt.1 hz
    have h1 : ψ w = 0 := h.eq_zero w (by linarith)
    have h2 : ψ (w - z) = 0 := h.eq_zero _ (by
      have := norm_sub_norm_le w z
      linarith)
    simp [h1, h2]


/-- Change of variables for the Hörmander integral of a dilate:
`∫_{|x| > 2|y|} |ψ_j(x - y) - ψ_j(x)| dx = ∫_{|w| > 2|2^j y|} |ψ(w - 2^j y) - ψ(w)| dw`. -/
theorem lj_setLIntegral_lpDilate_sub (ψ : Rn n → ℂ) (j : ℤ) (y : Rn n) :
    ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖}, ‖lpDilate n ψ j (x - y) - lpDilate n ψ j x‖ₑ =
      ∫⁻ w in {w | 2 * ‖(2 : ℝ) ^ j • y‖ < ‖w‖}, ‖ψ (w - (2 : ℝ) ^ j • y) - ψ w‖ₑ := by
  have h2j : (0 : ℝ) < 2 ^ j := zpow_pos two_pos j
  have hS : MeasurableSet {x : Rn n | 2 * ‖y‖ < ‖x‖} :=
    measurableSet_lt measurable_const measurable_norm
  have hS' : MeasurableSet {w : Rn n | 2 * ‖(2 : ℝ) ^ j • y‖ < ‖w‖} :=
    measurableSet_lt measurable_const measurable_norm
  set F : Rn n → ℝ≥0∞ := fun w => ENNReal.ofReal ((2 : ℝ) ^ (j * n)) *
    {w : Rn n | 2 * ‖(2 : ℝ) ^ j • y‖ < ‖w‖}.indicator
      (fun w => ‖ψ (w - (2 : ℝ) ^ j • y) - ψ w‖ₑ) w with hF
  have hpt : ∀ x, {x : Rn n | 2 * ‖y‖ < ‖x‖}.indicator
      (fun x => ‖lpDilate n ψ j (x - y) - lpDilate n ψ j x‖ₑ) x = F ((2 : ℝ) ^ j • x) := by
    intro x
    have hmem : (x ∈ {x : Rn n | 2 * ‖y‖ < ‖x‖}) ↔
        ((2 : ℝ) ^ j • x ∈ {w : Rn n | 2 * ‖(2 : ℝ) ^ j • y‖ < ‖w‖}) := by
      simp only [mem_ofPred_eq, norm_smul, Real.norm_of_nonneg h2j.le]
      constructor
      · intro h; nlinarith
      · intro h; nlinarith
    by_cases hx : x ∈ {x : Rn n | 2 * ‖y‖ < ‖x‖}
    · rw [indicator_of_mem hx, hF]
      simp only
      rw [indicator_of_mem (hmem.1 hx)]
      simp only [lpDilate, smul_sub]
      rw [← mul_sub, enorm_mul]
      congr 1
      rw [← ofReal_norm]
      congr 1
      simp [norm_zpow]
    · rw [indicator_of_notMem hx, hF]
      simp only
      rw [indicator_of_notMem (fun h => hx (hmem.2 h)), mul_zero]
  rw [← lintegral_indicator hS, ← lintegral_indicator hS']
  simp_rw [hpt]
  rw [lj_lintegral_comp_smul F h2j.ne', hF, lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    ← mul_assoc, ← ENNReal.ofReal_mul (abs_nonneg _)]
  have : |(((2 : ℝ) ^ j) ^ n)⁻¹| * (2 : ℝ) ^ (j * n) = 1 := by
    rw [abs_of_pos (by positivity), zpow_mul, zpow_natCast, inv_mul_cancel₀ (by positivity)]
  rw [this, ENNReal.ofReal_one, one_mul]

/-- **Hörmander's condition for the dilates** (`ℓ²`-valued kernel `x ↦ (ψ_j(x))_{j ∈ s}`): for
`ψ ∈ LjKernel n ψ R B₀ D` and `0 < δ ≤ 1`,
`∫_{|x| > 2|y|} (∑_{j ∈ s} |ψ_j(x - y) - ψ_j(x)|²)^{1/2} dx ≤ (2B₀)^{1-δ} (DR)^δ G_δ`,
uniformly in `y` and the finite set `s`. -/
theorem LjKernel.hormander {ψ : Rn n → ℂ} {R B₀ D : ℝ} (h : LjKernel n ψ R B₀ D)
    (hR : 0 < R) (hB : 0 ≤ B₀) (hD : 0 ≤ D) {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1)
    (s : Finset ℤ) (y : Rn n) :
    ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖},
        ENNReal.ofReal √(∑ j ∈ s, ‖lpDilate n ψ j (x - y) - lpDilate n ψ j x‖ ^ 2) ≤
      ENNReal.ofReal ((2 * B₀) ^ (1 - δ) * (D * R) ^ δ * ljGeom δ) := by
  have hc : ∀ j, Continuous (lpDilate n ψ j) := continuous_lpDilate h.continuous
  calc ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖},
        ENNReal.ofReal √(∑ j ∈ s, ‖lpDilate n ψ j (x - y) - lpDilate n ψ j x‖ ^ 2)
      ≤ ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖},
          ∑ j ∈ s, ‖lpDilate n ψ j (x - y) - lpDilate n ψ j x‖ₑ := by
        refine lintegral_mono fun x => ?_
        refine (ENNReal.ofReal_le_ofReal (lj_sqrt_sum_sq_le s _ fun j _ => norm_nonneg _)).trans
          (le_of_eq ?_)
        rw [ENNReal.ofReal_sum_of_nonneg fun j _ => norm_nonneg _]
        simp_rw [ofReal_norm]
    _ = ∑ j ∈ s, ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖},
          ‖lpDilate n ψ j (x - y) - lpDilate n ψ j x‖ₑ := by
        refine lintegral_finsetSum' _ fun j _ => ?_
        exact (((hc j).comp (continuous_id.sub continuous_const)).sub (hc j)).enorm.aemeasurable
    _ = ∑ j ∈ s, ∫⁻ w in {w | 2 * ‖(2 : ℝ) ^ j • y‖ < ‖w‖},
          ‖ψ (w - (2 : ℝ) ^ j • y) - ψ w‖ₑ :=
        Finset.sum_congr rfl fun j _ => lj_setLIntegral_lpDilate_sub ψ j y
    _ ≤ ∑ j ∈ s, ENNReal.ofReal (if ‖(2 : ℝ) ^ j • y‖ < R then
          (2 * B₀) ^ (1 - δ) * (‖(2 : ℝ) ^ j • y‖ * D) ^ δ else 0) :=
        Finset.sum_le_sum fun j _ => h.setLIntegral_sub_le hR hB hD hδ0.le hδ1 _
    _ = ENNReal.ofReal (∑ j ∈ s, (if ‖(2 : ℝ) ^ j • y‖ < R then
          (2 * B₀) ^ (1 - δ) * (‖(2 : ℝ) ^ j • y‖ * D) ^ δ else 0)) := by
        rw [ENNReal.ofReal_sum_of_nonneg fun j _ => by split_ifs <;> positivity]
    _ ≤ ENNReal.ofReal ((2 * B₀) ^ (1 - δ) * (D * R) ^ δ * ljGeom δ) := by
        refine ENNReal.ofReal_le_ofReal ?_
        have hn2 : ∀ j : ℤ, ‖(2 : ℝ) ^ j • y‖ = (2 : ℝ) ^ j * ‖y‖ := fun j => by
          rw [norm_smul, Real.norm_of_nonneg (by positivity)]
        have hterm : ∀ j : ℤ, (if ‖(2 : ℝ) ^ j • y‖ < R then
            (2 * B₀) ^ (1 - δ) * (‖(2 : ℝ) ^ j • y‖ * D) ^ δ else 0) =
            (2 * B₀) ^ (1 - δ) * D ^ δ *
              (if (2 : ℝ) ^ j * ‖y‖ < R then ((2 : ℝ) ^ j * ‖y‖) ^ δ else 0) := by
          intro j
          rw [hn2]
          split_ifs
          · rw [Real.mul_rpow (by positivity) hD]; ring
          · ring
        simp_rw [hterm]
        rw [← Finset.mul_sum]
        calc (2 * B₀) ^ (1 - δ) * D ^ δ *
              ∑ j ∈ s, (if (2 : ℝ) ^ j * ‖y‖ < R then ((2 : ℝ) ^ j * ‖y‖) ^ δ else 0)
            ≤ (2 * B₀) ^ (1 - δ) * D ^ δ * (R ^ δ * ljGeom δ) := by
              gcongr
              exact lj_sum_geom_le hδ0 (norm_nonneg y) hR s
          _ = (2 * B₀) ^ (1 - δ) * (D * R) ^ δ * ljGeom δ := by
              rw [Real.mul_rpow hD hR.le]; ring

/-- **`L^p` bound for square functions of dilates** (via the Benedek–Calderón–Panzone theorem
`vcz_eLpNorm_sqFun_le`): for `1 < p < ∞` there is `C` such that for every kernel
`ψ ∈ LjKernel n ψ R B₀ D` whose Fourier transform satisfies
`|𝓕ψ(η)|² ≤ c (min(|η|, |η|⁻¹) + min(|η|/ρ, ρ/|η|))`, every `0 < δ ≤ 1`, every finite set of
scales `s` and every `f ∈ L^p`,
`‖(∑_{j ∈ s} |ψ_j * f|²)^{1/2}‖_p ≤ C max(√c, (2B₀)^{1-δ} (DR)^δ G_δ) ‖f‖_p`. -/
theorem lj_eLpNorm_sqFun_le (hn : 0 < n) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ψ : Rn n → ℂ) (R B₀ D c ρ δ : ℝ), LjKernel n ψ R B₀ D → 0 < R →
      0 ≤ B₀ → 0 ≤ D → 0 ≤ c → 0 < ρ → 0 < δ → δ ≤ 1 →
      (∀ η, ‖𝓕 ψ η‖ ^ 2 ≤ c * (min ‖η‖ ‖η‖⁻¹ + min (‖η‖ / ρ) (‖η‖ / ρ)⁻¹)) →
      ∀ (s : Finset ℤ) (f : Rn n → ℂ), MemLp f (ENNReal.ofReal p) volume →
        eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, lpDilate n ψ j (x - y) * f y‖ ^ 2))
          (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * max (√c) ((2 * B₀) ^ (1 - δ) * (D * R) ^ δ * ljGeom δ)) *
          eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨B, hB, hsum⟩ := lj_sum_norm_fourier_lpDilate_sq_le (n := n)
  refine ⟨vczConst n p * max (2 * √B) 1,
    mul_nonneg (vczConst_nonneg n p) (le_max_of_le_right zero_le_one), ?_⟩
  intro ψ R B₀ D c ρ δ hψ hR hB₀ hD hc hρ hδ0 hδ1 hF s f hf
  set H := (2 * B₀) ^ (1 - δ) * (D * R) ^ δ * ljGeom δ with hH
  have hH0 : 0 ≤ H := by have := ljGeom_nonneg δ; positivity
  set A := max (2 * √B * √c) H with hA
  have hA0 : 0 ≤ A := le_max_of_le_right hH0
  have hk : ∀ j ∈ s, Integrable (lpDilate n ψ j) := fun j _ =>
    integrable_lpDilate hψ.integrable j
  have hL2 : ∀ g : Rn n → ℂ, MemLp g 2 volume →
      ∑ j ∈ s, eLpNorm (fun x => ∫ y, lpDilate n ψ j (x - y) * g y) 2 volume ^ 2 ≤
        ENNReal.ofReal A ^ 2 * eLpNorm g 2 volume ^ 2 := by
    intro g hg
    have hconv : ∀ j, (fun x => ∫ y, lpDilate n ψ j (x - y) * g y) =
        lpDilate n ψ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g := fun j =>
      funext fun x => (convolution_eq_integral_sub _ _ x).symm
    simp_rw [hconv]
    refine (lp_sum_eLpNorm_conv_le s hk (hsum ψ c ρ hc hρ hF s) hg).trans ?_
    gcongr
    rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul zero_le_two,
      ← ENNReal.ofReal_pow hA0]
    refine ENNReal.ofReal_le_ofReal ?_
    have h1 : 2 * √B * √c ≤ A := le_max_left _ _
    have h2 : (2 * √B * √c) ^ 2 = 4 * B * c := by
      rw [mul_pow, mul_pow, Real.sq_sqrt hB, Real.sq_sqrt hc]; ring
    nlinarith [mul_nonneg (mul_nonneg zero_le_two (Real.sqrt_nonneg B)) (Real.sqrt_nonneg c)]
  have hHor : ∀ y : Rn n, ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖},
      ENNReal.ofReal √(∑ j ∈ s, ‖lpDilate n ψ j (x - y) - lpDilate n ψ j x‖ ^ 2) ≤
        ENNReal.ofReal A := fun y =>
    (hψ.hormander hR hB₀ hD hδ0 hδ1 s y).trans (ENNReal.ofReal_le_ofReal (le_max_right _ _))
  refine (vcz_eLpNorm_sqFun_le hn hp s (lpDilate n ψ) hA0 hk hL2 hHor hf).trans ?_
  refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) zero_le
  rw [mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ (vczConst_nonneg n p)
  have e1 : 2 * √B * √c ≤ max (2 * √B) 1 * max (√c) H :=
    mul_le_mul (le_max_left _ _) (le_max_left _ _) (Real.sqrt_nonneg _)
      (le_max_of_le_right zero_le_one)
  have e2 : 1 * H ≤ max (2 * √B) 1 * max (√c) H :=
    mul_le_mul (le_max_right _ _) (le_max_right _ _) hH0 (le_max_of_le_right zero_le_one)
  rw [one_mul] at e2
  exact max_le e1 e2

end SquareFunction

section SquareFunctionTsum

variable {n : ℕ}

/-- `‖h‖_p = (∫ h^p)^{1/p}` for an a.e. measurable `[0, ∞]`-valued `h` and `0 < p < ∞`. -/
theorem lj_eLpNorm_ennreal_eq {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {h : X → ℝ≥0∞} (hh : AEMeasurable h μ) {p : ℝ} (hp : 0 < p) :
    eLpNorm h (ENNReal.ofReal p) μ = (∫⁻ x, h x ^ p ∂μ) ^ (1 / p) := by
  rw [eLpNorm_eq_eLpNorm' (by simpa using hp) ENNReal.ofReal_ne_top hh.aestronglyMeasurable,
    eLpNorm'_eq_lintegral_enorm, ENNReal.toReal_ofReal hp.le]
  simp only [enorm_eq_self]

/-- **Monotone convergence for `L^p` norms**: if `(G_i)` is a countable directed family of
a.e. measurable `[0, ∞]`-valued functions with `‖G_i‖_p ≤ K`, then `‖sup_i G_i‖_p ≤ K`. -/
theorem lj_eLpNorm_iSup_le {X : Type*} [MeasurableSpace X] {μ : Measure X} {ι : Type*}
    [Countable ι] [Nonempty ι] {G : ι → X → ℝ≥0∞} (hG : ∀ i, AEMeasurable (G i) μ)
    (hdir : Directed (· ≤ ·) G) {p : ℝ} (hp : 0 < p) {K : ℝ≥0∞}
    (hK : ∀ i, eLpNorm (G i) (ENNReal.ofReal p) μ ≤ K) :
    eLpNorm (fun x => ⨆ i, G i x) (ENNReal.ofReal p) μ ≤ K := by
  rw [lj_eLpNorm_ennreal_eq (AEMeasurable.iSup hG) hp]
  have h1 : ∀ x, (⨆ i, G i x) ^ p = ⨆ i, G i x ^ p := fun x =>
    (ENNReal.orderIsoRpow p hp).map_iSup _
  simp_rw [h1]
  rw [lintegral_iSup_directed (fun i => (hG i).pow_const p)]
  · have h2 : (⨆ i, ∫⁻ x, G i x ^ p ∂μ) ^ (1 / p) = ⨆ i, (∫⁻ x, G i x ^ p ∂μ) ^ (1 / p) :=
      (ENNReal.orderIsoRpow (1 / p) (by positivity)).map_iSup _
    rw [h2]
    refine iSup_le fun i => ?_
    have := hK i
    rwa [lj_eLpNorm_ennreal_eq (hG i) hp] at this
  · intro i j
    obtain ⟨k, hik, hjk⟩ := hdir i j
    exact ⟨k, fun x => ENNReal.rpow_le_rpow (hik x) hp.le,
      fun x => ENNReal.rpow_le_rpow (hjk x) hp.le⟩

/-- `‖(∑_{j ∈ s} |u_j|²)^{1/2}‖_ℝ` as an element of `[0, ∞]`. -/
theorem lj_ofReal_sqrt_sum_sq {ι : Type*} (s : Finset ι) (u : ι → ℂ) :
    ENNReal.ofReal √(∑ j ∈ s, ‖u j‖ ^ 2) = (∑ j ∈ s, ‖u j‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
  rw [Real.sqrt_eq_rpow, ← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num),
    ENNReal.ofReal_sum_of_nonneg fun j _ => by positivity]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]

/-- **From finite to infinite square sums**: if
`‖(∑_{j ∈ s} |u_j|²)^{1/2}‖_p ≤ K` for every finite `s ⊆ ℤ` (with `u_j` a.e. measurable), then
`‖(∑_{j ∈ ℤ} |u_j|²)^{1/2}‖_p ≤ K`, the square function taken in `[0, ∞]`. -/
theorem lj_eLpNorm_tsum_sq_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {u : ℤ → X → ℂ} (hu : ∀ j, AEMeasurable (u j) μ) {p : ℝ} (hp : 0 < p) {K : ℝ≥0∞}
    (hK : ∀ s : Finset ℤ, eLpNorm (fun x => √(∑ j ∈ s, ‖u j x‖ ^ 2)) (ENNReal.ofReal p) μ ≤ K) :
    eLpNorm (fun x => (∑' j, ‖u j x‖ₑ ^ 2) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) μ ≤ K := by
  have heq : (fun x => (∑' j, ‖u j x‖ₑ ^ 2) ^ (1 / 2 : ℝ)) =
      fun x => ⨆ s : Finset ℤ, (∑ j ∈ s, ‖u j x‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
    funext x
    rw [ENNReal.tsum_eq_iSup_sum]
    exact (ENNReal.orderIsoRpow (1 / 2) (by norm_num)).map_iSup _
  rw [heq]
  refine lj_eLpNorm_iSup_le (fun s => ?_) (fun s t => ⟨s ∪ t, fun x => ?_, fun x => ?_⟩) hp
    fun s => ?_
  · exact (Finset.aemeasurable_fun_sum _ fun j _ => ((hu j).enorm.pow_const 2)).pow_const _
  · exact ENNReal.rpow_le_rpow (Finset.sum_le_sum_of_subset Finset.subset_union_left)
      (by norm_num)
  · exact ENNReal.rpow_le_rpow (Finset.sum_le_sum_of_subset Finset.subset_union_right)
      (by norm_num)
  · have h := hK s
    have hmR : AEStronglyMeasurable (fun x => √(∑ j ∈ s, ‖u j x‖ ^ 2)) μ :=
      (Real.continuous_sqrt.measurable.comp_aemeasurable
        (Finset.aemeasurable_fun_sum _ fun j _ => (hu j).norm.pow_const 2)).aestronglyMeasurable
    rw [← eLpNorm_enorm _ hmR] at h
    refine le_trans (le_of_eq ?_) h
    congr 1
    funext x
    rw [Real.enorm_eq_ofReal (Real.sqrt_nonneg _), lj_ofReal_sqrt_sum_sq]

/-- Minkowski's inequality for finite `ℓ²` sums:
`(∑ |u_j + v_j|²)^{1/2} ≤ (∑ |u_j|²)^{1/2} + (∑ |v_j|²)^{1/2}`. -/
theorem lj_sqrt_sum_norm_add_le {ι : Type*} (s : Finset ι) (u v : ι → ℂ) :
    √(∑ j ∈ s, ‖u j + v j‖ ^ 2) ≤ √(∑ j ∈ s, ‖u j‖ ^ 2) + √(∑ j ∈ s, ‖v j‖ ^ 2) := by
  have key : ∀ w : ι → ℂ, ‖(WithLp.toLp 2 (fun j : s => w j) : EuclideanSpace ℂ s)‖ =
      √(∑ j ∈ s, ‖w j‖ ^ 2) := by
    intro w
    rw [EuclideanSpace.norm_eq]
    congr 1
    exact Finset.sum_coe_sort s fun j => ‖w j‖ ^ 2
  rw [← key, ← key, ← key]
  have : (WithLp.toLp 2 (fun j : s => u j + v j) : EuclideanSpace ℂ s) =
      WithLp.toLp 2 (fun j : s => u j) + WithLp.toLp 2 (fun j : s => v j) := rfl
  rw [this]
  exact norm_add_le _ _

/-- The square function `T f(x) = (∑_{j ∈ s} |k_j * f(x)|²)^{1/2}` of a finite family of
integrable kernels is sublinear on `L^a`, `a ≥ 1`. -/
theorem lj_isSublinearOn_sqFun {k : ℤ → Rn n → ℂ} (s : Finset ℤ)
    (hk : ∀ j ∈ s, Integrable (k j)) {a : ℝ} (ha : 1 ≤ a) (D : Set (Rn n → ℂ))
    (hD : ∀ f ∈ D, MemLp f (ENNReal.ofReal a)) :
    IsSublinearOn (fun f x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) D volume := by
  intro f hf g hg
  have ha' : 1 ≤ ENNReal.ofReal a := by simpa using ha
  have hf' := (Finset.eventually_all s).2 fun j hj =>
    ae_convolutionExistsAt_of_memLp ha' (memLp_one_iff_integrable.2 (hk j hj)) (hD f hf)
  have hg' := (Finset.eventually_all s).2 fun j hj =>
    ae_convolutionExistsAt_of_memLp ha' (memLp_one_iff_integrable.2 (hk j hj)) (hD g hg)
  filter_upwards [hf', hg'] with x hx hy
  simp only [Real.norm_of_nonneg (Real.sqrt_nonneg _)]
  have hsum : ∀ j ∈ s, ∫ y, k j (x - y) * (f + g) y =
      (∫ y, k j (x - y) * f y) + ∫ y, k j (x - y) * g y := by
    intro j hj
    rw [← convolution_eq_integral_sub, ← convolution_eq_integral_sub,
      ← convolution_eq_integral_sub, (hx j hj).distrib_add (hy j hj)]
  rw [Finset.sum_congr rfl fun j hj => by rw [hsum j hj]]
  exact lj_sqrt_sum_norm_add_le s _ _

/-- The square function of a finite family of integrable kernels applied to `f ∈ L^a`
(`a ≥ 1`) is a.e. strongly measurable. -/
theorem lj_aestronglyMeasurable_sqFun {k : ℤ → Rn n → ℂ} (s : Finset ℤ)
    (hk : ∀ j ∈ s, Integrable (k j)) {a : ℝ} (ha : 1 ≤ a) {f : Rn n → ℂ}
    (hf : MemLp f (ENNReal.ofReal a)) :
    AEStronglyMeasurable (fun x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) volume := by
  have ha' : 1 ≤ ENNReal.ofReal a := by simpa using ha
  have hjm : ∀ j ∈ s, AEStronglyMeasurable (fun x => ∫ y, k j (x - y) * f y) volume := by
    intro j hj
    have := (memLp_convolution_of_memLp ha' (memLp_one_iff_integrable.2 (hk j hj))
      hf).aestronglyMeasurable
    refine this.congr (Eventually.of_forall fun x => ?_)
    exact convolution_eq_integral_sub _ _ x
  refine Real.continuous_sqrt.comp_aestronglyMeasurable ?_
  exact Finset.aestronglyMeasurable_fun_sum _ fun j hj => (hjm j hj).norm.pow 2

/-- **Interpolation of square-function bounds** (Marcinkiewicz): if the square function
`T f = (∑_{j ∈ s} |k_j * f|²)^{1/2}` satisfies `‖T f‖_a ≤ A ‖f‖_a` and `‖T f‖_b ≤ B ‖f‖_b`
(`1 ≤ a < p < b`), then `‖T f‖_p ≤ C(a,b,p) A^{1-θ} B^θ ‖f‖_p` for `f ∈ L^a ∩ L^b`, where
`1/p = (1-θ)/a + θ/b`. -/
theorem lj_eLpNorm_sqFun_interp {k : ℤ → Rn n → ℂ} (s : Finset ℤ)
    (hk : ∀ j ∈ s, Integrable (k j)) {a b p θ : ℝ} (ha : 1 ≤ a) (hap : a < p) (hpb : p < b)
    (hθ : 1 / p = (1 - θ) / a + θ / b) {A B : ℝ≥0}
    (hA : ∀ f : Rn n → ℂ, MemLp f (ENNReal.ofReal a) →
      eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) (ENNReal.ofReal a) ≤
        A * eLpNorm f (ENNReal.ofReal a))
    (hB : ∀ f : Rn n → ℂ, MemLp f (ENNReal.ofReal b) →
      eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) (ENNReal.ofReal b) ≤
        B * eLpNorm f (ENNReal.ofReal b))
    {f : Rn n → ℂ} (hfa : MemLp f (ENNReal.ofReal a)) (hfb : MemLp f (ENNReal.ofReal b)) :
    eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) (ENNReal.ofReal p) ≤
      (marcinkiewiczConst a b p : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - θ) * (B : ℝ≥0∞) ^ θ *
        eLpNorm f (ENNReal.ofReal p) := by
  set D : Set (Rn n → ℂ) :=
    {f | MemLp f (ENNReal.ofReal a) ∧ MemLp f (ENNReal.ofReal b)}
  have ha0 : 0 < a := by linarith
  have hTA : HasWeakTypeOn (fun f x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) D a A
      volume volume :=
    HasStrongTypeOn.hasWeakTypeOn ha0 fun f hf => hA f hf.1
  have hTB : HasWeakTypeOn (fun f x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) D b B
      volume volume :=
    HasStrongTypeOn.hasWeakTypeOn (by linarith) fun f hf => hB f hf.2
  exact eLpNorm_le_of_hasWeakTypeOn ha0 hap hpb hθ hTA hTB
    (lj_isSublinearOn_sqFun s hk ha D fun f hf => hf.1) (isTruncationClosed_memLp_inter _ _)
    ⟨hfa, hfb⟩ hfa.aestronglyMeasurable (lj_aestronglyMeasurable_sqFun s hk ha hfa)

end SquareFunctionTsum

section Kernels

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The unit-scale piece `k₀ = φ₀ K` of the kernel (`φ₀ = dyadicPhi`, `K = Ω/|·|ⁿ`), as a
complex-valued function. Its dilates `2^{-ℓn} k₀(2^{-ℓ} ·) = φ_ℓ K` are the smooth dyadic pieces
of the kernel (`lpDilate_ljOsc`). -/
noncomputable def ljAmp (n : ℕ) (Ω : Rn n → ℝ) (t : Rn n) : ℂ :=
  ((dyadicPhi n t * czKernel n Ω t : ℝ) : ℂ)

/-- The oscillatory unit-scale piece `q̃_λ(t) = e^{iλ|t|^α} φ₀(t) K(t)`. For `λ = 2^{mα}` its
dilates are the pieces `e^{i 2^{jα} |t|^α} φ_{m-j}(t) K(t)` of `𝓗^{(2^{jα})}` (`lpDilate_ljOsc`).
For `λ = 0` it is `k₀ = ljAmp`. -/
noncomputable def ljOsc (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (lam : ℝ) (t : Rn n) : ℂ :=
  exp (I * lam * (‖t‖ ^ α : ℝ)) * ljAmp n Ω t

/-- `k₀(t) = 0` for `|t| ≤ 1/2`. -/
theorem ljAmp_eq_zero_of_le {t : Rn n} (ht : ‖t‖ ≤ 1 / 2) : ljAmp n Ω t = 0 := by
  simp [ljAmp, dyadicPhi_eq_zero_of_le ht]

/-- `k₀(t) = 0` for `|t| ≥ 2`. -/
theorem ljAmp_eq_zero_of_ge {t : Rn n} (ht : 2 ≤ ‖t‖) : ljAmp n Ω t = 0 := by
  simp [ljAmp, dyadicPhi_eq_zero_of_ge ht]

/-- Support of `k₀`: `k₀(t) ≠ 0 → 1/2 < |t| < 2`. -/
theorem ljAmp_ne_zero {t : Rn n} (ht : ljAmp n Ω t ≠ 0) : 1 / 2 < ‖t‖ ∧ ‖t‖ < 2 := by
  by_contra h
  rw [not_and_or, not_lt, not_lt] at h
  rcases h with h | h
  · exact ht (ljAmp_eq_zero_of_le h)
  · exact ht (ljAmp_eq_zero_of_ge h)

/-- `ljOsc` vanishes where `k₀` does. -/
theorem ljOsc_eq_zero_of_ljAmp {α lam : ℝ} {t : Rn n} (ht : ljAmp n Ω t = 0) :
    ljOsc n α Ω lam t = 0 := by
  simp [ljOsc, ht]

/-- A function which is smooth off the origin and vanishes near the origin is smooth. -/
theorem lj_contDiff_of_contDiffAt {g : Rn n → ℂ} (hg : ∀ x, x ≠ 0 → ContDiffAt ℝ (⊤ : ℕ∞) g x)
    (h0 : ∀ x, ‖x‖ ≤ 1 / 2 → g x = 0) : ContDiff ℝ (⊤ : ℕ∞) g := by
  refine contDiff_iff_contDiffAt.2 fun x => ?_
  rcases lt_or_ge ‖x‖ (1 / 2) with hx | hx
  · have hev : g =ᶠ[𝓝 x] fun _ => 0 := by
      have : Metric.ball (0 : Rn n) (1 / 2) ∈ 𝓝 x :=
        Metric.isOpen_ball.mem_nhds (by rw [Metric.mem_ball, dist_zero_right]; exact hx)
      filter_upwards [this] with y hy
      exact h0 y (by simpa using (Metric.mem_ball.1 hy).le)
    exact contDiffAt_const.congr_of_eventuallyEq hev
  · refine hg x ?_
    rintro rfl
    simp at hx
    linarith

/-- `k₀` is smooth. -/
theorem IsHomogeneousCZKernel.contDiff_ljAmp (hΩ : IsHomogeneousCZKernel n Ω) :
    ContDiff ℝ (⊤ : ℕ∞) (ljAmp n Ω) := by
  refine lj_contDiff_of_contDiffAt (fun x hx => ?_) fun x hx => ljAmp_eq_zero_of_le hx
  have hK : ContDiffAt ℝ (⊤ : ℕ∞) (czKernel n Ω) x :=
    hΩ.contDiffOn_czKernel.contDiffAt (isOpen_compl_singleton.mem_nhds hx)
  have h1 : ContDiffAt ℝ (⊤ : ℕ∞) (fun t => dyadicPhi n t * czKernel n Ω t) x :=
    (contDiff_dyadicPhi n).contDiffAt.mul hK
  exact Complex.ofRealCLM.contDiff.contDiffAt.comp x h1

/-- `q̃_λ` is smooth. -/
theorem IsHomogeneousCZKernel.contDiff_ljOsc (hΩ : IsHomogeneousCZKernel n Ω) (α lam : ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (ljOsc n α Ω lam) := by
  refine lj_contDiff_of_contDiffAt (fun x hx => ?_) fun x hx =>
    ljOsc_eq_zero_of_ljAmp (ljAmp_eq_zero_of_le hx)
  have hN : ContDiffAt ℝ (⊤ : ℕ∞) (fun t : Rn n => ‖t‖ ^ α) x :=
    (contDiffAt_norm ℝ hx).rpow_const_of_ne (norm_ne_zero_iff.2 hx)
  have hE : ContDiffAt ℝ (⊤ : ℕ∞) (fun t : Rn n => exp (I * lam * ((‖t‖ ^ α : ℝ) : ℂ))) x := by
    have h2 : ContDiffAt ℝ (⊤ : ℕ∞) (fun t : Rn n => I * lam * ((‖t‖ ^ α : ℝ) : ℂ)) x :=
      contDiffAt_const.mul (Complex.ofRealCLM.contDiff.contDiffAt.comp x hN)
    exact Complex.contDiff_exp.contDiffAt.comp x h2
  exact hE.mul (hΩ.contDiff_ljAmp.contDiffAt)

/-- `k₀` has compact support (in the closed ball of radius `2`). -/
theorem hasCompactSupport_ljAmp : HasCompactSupport (ljAmp n Ω) :=
  HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) 2) fun x hx =>
    ljAmp_eq_zero_of_ge (le_of_lt (by simpa using hx))

/-- `q̃_λ` has compact support. -/
theorem hasCompactSupport_ljOsc (α lam : ℝ) : HasCompactSupport (ljOsc n α Ω lam) :=
  HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) 2) fun x hx =>
    ljOsc_eq_zero_of_ljAmp (ljAmp_eq_zero_of_ge (le_of_lt (by simpa using hx)))

/-- The topological support of `q̃_λ` lies in the annulus `1/2 ≤ |t| ≤ 2`. -/
theorem tsupport_ljOsc_subset (α lam : ℝ) :
    tsupport (ljOsc n α Ω lam) ⊆ {t | 1 / 2 ≤ ‖t‖ ∧ ‖t‖ ≤ 2} := by
  refine closure_minimal (fun t ht => ?_) ?_
  · have h := ljAmp_ne_zero (n := n) (Ω := Ω) (t := t) fun h0 => ht (ljOsc_eq_zero_of_ljAmp h0)
    exact ⟨h.1.le, h.2.le⟩
  · exact (isClosed_le continuous_const continuous_norm).inter
      (isClosed_le continuous_norm continuous_const)

/-- `q̃_λ` is integrable. -/
theorem IsHomogeneousCZKernel.integrable_ljOsc (hΩ : IsHomogeneousCZKernel n Ω) (α lam : ℝ) :
    Integrable (ljOsc n α Ω lam) :=
  (hΩ.contDiff_ljOsc α lam).continuous.integrable_of_hasCompactSupport
    (hasCompactSupport_ljOsc α lam)

/-- `k₀` is integrable. -/
theorem IsHomogeneousCZKernel.integrable_ljAmp (hΩ : IsHomogeneousCZKernel n Ω) :
    Integrable (ljAmp n Ω) :=
  hΩ.contDiff_ljAmp.continuous.integrable_of_hasCompactSupport hasCompactSupport_ljAmp

/-- `q̃_0 = k₀`. -/
theorem ljOsc_zero (α : ℝ) : ljOsc n α Ω 0 = ljAmp n Ω := by
  funext t; simp [ljOsc]

/-- **Mean zero** (radial cut-off times `K`; this is why the constants `c_ℓ` of (3.4) vanish):
`∫ e^{iλ|t|^α} φ₀(t) K(t) dt = 0`. -/
theorem IsHomogeneousCZKernel.integral_ljOsc (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    (α lam : ℝ) : ∫ t, ljOsc n α Ω lam t = 0 := by
  set G : ℝ → ℂ := fun r => exp (I * lam * ((r ^ α : ℝ) : ℂ)) *
    ((Real.smoothTransition ((4 - r ^ 2) / 3) -
      Real.smoothTransition ((4 - (2 * r) ^ 2) / 3) : ℝ) : ℂ) with hG
  have heq : ∀ t : Rn n, ljOsc n α Ω lam t = G ‖t‖ * (czKernel n Ω t : ℂ) := by
    intro t
    have h2 : ‖(2 : ℝ) • t‖ = 2 * ‖t‖ := by rw [norm_smul]; simp
    simp only [ljOsc, ljAmp, hG, dyadicPhi, dyadicEta, h2]
    push_cast
    ring
  simp_rw [heq]
  exact hΩ.integral_radial_mul_czKernel hn G

/-- `∫ k₀ = 0`. -/
theorem IsHomogeneousCZKernel.integral_ljAmp (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) :
    ∫ t, ljAmp n Ω t = 0 := by
  have := hΩ.integral_ljOsc hn 1 0
  rwa [ljOsc_zero] at this

/-- **Scaling identity**: the dilates of `q̃_λ` are the modulated dyadic pieces,
`2^{kn} q̃_λ(2^k t) = e^{i λ 2^{kα} |t|^α} φ_{-k}(t) K(t)`. -/
theorem IsHomogeneousCZKernel.lpDilate_ljOsc (hΩ : IsHomogeneousCZKernel n Ω) (α lam : ℝ)
    (k : ℤ) (t : Rn n) :
    lpDilate n (ljOsc n α Ω lam) k t =
      exp (I * ((lam * (2 : ℝ) ^ ((k : ℝ) * α) : ℝ) : ℂ) * (‖t‖ ^ α : ℝ)) *
        ((dyadicPhiScale n (-k) t * czKernel n Ω t : ℝ) : ℂ) := by
  have h2k : (0 : ℝ) < 2 ^ k := zpow_pos two_pos k
  have hnorm : ‖(2 : ℝ) ^ k • t‖ ^ α = (2 : ℝ) ^ ((k : ℝ) * α) * ‖t‖ ^ α := by
    rw [norm_smul, Real.norm_of_nonneg h2k.le, Real.mul_rpow h2k.le (norm_nonneg _),
      ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]
  have hK := hΩ.czKernel_smul h2k t
  have hφ : dyadicPhi n ((2 : ℝ) ^ k • t) = dyadicPhiScale n (-k) t := by
    simp [dyadicPhiScale]
  unfold lpDilate ljOsc ljAmp
  rw [hnorm, hK, hφ]
  have hexp : exp (I * lam * (((2 : ℝ) ^ ((k : ℝ) * α) * ‖t‖ ^ α : ℝ) : ℂ)) =
      exp (I * ((lam * (2 : ℝ) ^ ((k : ℝ) * α) : ℝ) : ℂ) * ((‖t‖ ^ α : ℝ) : ℂ)) := by
    congr 1; push_cast; ring
  have hreal : (((2 : ℝ) ^ (k * (n : ℤ)) : ℝ) : ℂ) *
      ((dyadicPhiScale n (-k) t * ((((2 : ℝ) ^ k) ^ n)⁻¹ * czKernel n Ω t) : ℝ) : ℂ) =
      ((dyadicPhiScale n (-k) t * czKernel n Ω t : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul]
    congr 1
    rw [zpow_mul, zpow_natCast]
    field_simp
  rw [hexp, ← hreal]
  push_cast
  ring


/-- `A₁ = ∫ |k₀|`. -/
noncomputable def ljA1 (n : ℕ) (Ω : Rn n → ℝ) : ℝ := ∫ t, ‖ljAmp n Ω t‖

/-- `D₀ = ∫ |∇k₀|`. -/
noncomputable def ljD0 (n : ℕ) (Ω : Rn n → ℝ) : ℝ :=
  (∫⁻ t, ‖fderiv ℝ (ljAmp n Ω) t‖ₑ).toReal

/-- `A₁ ≥ 0`. -/
theorem ljA1_nonneg : 0 ≤ ljA1 n Ω := integral_nonneg fun _ => norm_nonneg _

/-- `D₀ ≥ 0`. -/
theorem ljD0_nonneg : 0 ≤ ljD0 n Ω := ENNReal.toReal_nonneg

/-- `∫ |k₀| = A₁` as a lower integral. -/
theorem IsHomogeneousCZKernel.lintegral_ljAmp (hΩ : IsHomogeneousCZKernel n Ω) :
    ∫⁻ t, ‖ljAmp n Ω t‖ₑ = ENNReal.ofReal (ljA1 n Ω) :=
  (ofReal_integral_norm_eq_lintegral_enorm hΩ.integrable_ljAmp).symm

/-- `∫ |∇k₀| < ∞`. -/
theorem IsHomogeneousCZKernel.lintegral_fderiv_ljAmp_ne_top (hΩ : IsHomogeneousCZKernel n Ω) :
    ∫⁻ t, ‖fderiv ℝ (ljAmp n Ω) t‖ₑ ≠ ∞ := by
  have hc : Continuous (fderiv ℝ (ljAmp n Ω)) := hΩ.contDiff_ljAmp.continuous_fderiv (by simp)
  have hs : HasCompactSupport (fderiv ℝ (ljAmp n Ω)) := hasCompactSupport_ljAmp.fderiv (𝕜 := ℝ)
  exact (hc.integrable_of_hasCompactSupport hs).2.ne

/-- `k₀` belongs to the kernel class with `R = 2`, `B₀ = A₁`, `D = D₀`. -/
theorem IsHomogeneousCZKernel.ljKernel_ljAmp (hΩ : IsHomogeneousCZKernel n Ω) :
    LjKernel n (ljAmp n Ω) 2 (ljA1 n Ω) (ljD0 n Ω) where
  continuous := hΩ.contDiff_ljAmp.continuous
  eq_zero := fun x hx => ljAmp_eq_zero_of_ge hx.le
  lintegral_le := hΩ.lintegral_ljAmp.le
  translate_le := fun z => by
    refine (lj_lintegral_enorm_sub_le_of_contDiff (hΩ.contDiff_ljAmp.of_le (by simp)) z).trans
      (le_of_eq ?_)
    rw [ljD0, ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm,
      ENNReal.ofReal_toReal hΩ.lintegral_fderiv_ljAmp_ne_top]

/-- **Lipschitz bound for `|·|^α`** (`α > 1`): `||x - z|^α - |x|^α| ≤ α 3^{α-1} |z|` for
`|x| ≤ 2`, `|z| ≤ 1`. -/
theorem lj_abs_norm_rpow_sub_le {α : ℝ} (hα : 1 < α) {x z : Rn n} (hx : ‖x‖ ≤ 2)
    (hz : ‖z‖ ≤ 1) : |‖x - z‖ ^ α - ‖x‖ ^ α| ≤ α * 3 ^ (α - 1) * ‖z‖ := by
  have hderiv : ∀ t ∈ Metric.closedBall (0 : Rn n) 3, HasFDerivWithinAt (fun t : Rn n => ‖t‖ ^ α)
      ((α * ‖t‖ ^ (α - 2)) • innerSL ℝ t) (Metric.closedBall (0 : Rn n) 3) t :=
    fun t _ => (hasFDerivAt_norm_rpow t hα).hasFDerivWithinAt
  have hbound : ∀ t ∈ Metric.closedBall (0 : Rn n) 3,
      ‖(α * ‖t‖ ^ (α - 2)) • innerSL ℝ t‖ ≤ α * 3 ^ (α - 1) := by
    intro t ht
    have ht3 : ‖t‖ ≤ 3 := by simpa using ht
    rw [norm_smul, innerSL_apply_norm, Real.norm_of_nonneg (by positivity)]
    rcases eq_or_ne t 0 with rfl | ht0
    · simp only [norm_zero, mul_zero]; positivity
    · have hpos : 0 < ‖t‖ := norm_pos_iff.2 ht0
      have : ‖t‖ ^ (α - 2) * ‖t‖ = ‖t‖ ^ (α - 1) := by
        rw [← Real.rpow_add_one hpos.ne']; ring_nf
      rw [mul_assoc, this]
      gcongr
  have h := (convex_closedBall (0 : Rn n) 3).norm_image_sub_le_of_norm_hasFDerivWithin_le
    hderiv hbound (x := x) (y := x - z) (by simp; linarith) (by
      simp only [Metric.mem_closedBall, dist_zero_right]
      have := norm_sub_le x z
      linarith)
  rw [sub_sub_cancel_left, norm_neg, Real.norm_eq_abs] at h
  exact h

/-- **Products with `k₀`**: if `g` is continuous, `|g| ≤ M` on the ball of radius `3`, and
`|g(x - z) - g(x)| ≤ L |z|` for `|x| ≤ 2`, `|z| ≤ 1`, then `g k₀` belongs to the kernel class
with `R = 2`, `B₀ = M A₁`, `D = M D₀ + L A₁ + 2 M A₁`. -/
theorem IsHomogeneousCZKernel.ljKernel_mul (hΩ : IsHomogeneousCZKernel n Ω) {g : Rn n → ℂ}
    (hg : Continuous g) {M L : ℝ} (hM0 : 0 ≤ M) (hL0 : 0 ≤ L)
    (hM : ∀ y : Rn n, ‖y‖ ≤ 3 → ‖g y‖ ≤ M)
    (hL : ∀ x z : Rn n, ‖x‖ ≤ 2 → ‖z‖ ≤ 1 → ‖g (x - z) - g x‖ ≤ L * ‖z‖) :
    LjKernel n (fun t => g t * ljAmp n Ω t) 2 (M * ljA1 n Ω)
      (M * ljD0 n Ω + L * ljA1 n Ω + 2 * M * ljA1 n Ω) := by
  have ha := hΩ.ljKernel_ljAmp
  have hA1 := ljA1_nonneg (n := n) (Ω := Ω)
  have hD0 := ljD0_nonneg (n := n) (Ω := Ω)
  have hpt : ∀ x, ‖g x * ljAmp n Ω x‖ₑ ≤ ENNReal.ofReal M * ‖ljAmp n Ω x‖ₑ := by
    intro x
    by_cases hx : ljAmp n Ω x = 0
    · simp [hx]
    · rw [enorm_mul]
      gcongr
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (hM x (by linarith [(ljAmp_ne_zero hx).2]))
  have hl1 : ∫⁻ x, ‖g x * ljAmp n Ω x‖ₑ ≤ ENNReal.ofReal (M * ljA1 n Ω) := by
    calc ∫⁻ x, ‖g x * ljAmp n Ω x‖ₑ ≤ ∫⁻ x, ENNReal.ofReal M * ‖ljAmp n Ω x‖ₑ :=
          lintegral_mono hpt
      _ = ENNReal.ofReal M * ∫⁻ x, ‖ljAmp n Ω x‖ₑ := lintegral_const_mul' _ _ (by simp)
      _ = ENNReal.ofReal (M * ljA1 n Ω) := by
          rw [hΩ.lintegral_ljAmp, ENNReal.ofReal_mul hM0]
  refine ⟨hg.mul ha.continuous, fun x hx => by simp [ljAmp_eq_zero_of_ge hx.le], hl1,
    fun z => ?_⟩
  rcases le_or_gt 1 ‖z‖ with hz | hz
  · -- large translations: trivial bound
    calc ∫⁻ x, ‖g (x - z) * ljAmp n Ω (x - z) - g x * ljAmp n Ω x‖ₑ
        ≤ ∫⁻ x, (‖g (x - z) * ljAmp n Ω (x - z)‖ₑ + ‖g x * ljAmp n Ω x‖ₑ) :=
          lintegral_mono fun x => enorm_sub_le
      _ = (∫⁻ x, ‖g (x - z) * ljAmp n Ω (x - z)‖ₑ) + ∫⁻ x, ‖g x * ljAmp n Ω x‖ₑ :=
          lintegral_add_right _ (hg.mul ha.continuous).enorm.measurable
      _ = (∫⁻ x, ‖g x * ljAmp n Ω x‖ₑ) + ∫⁻ x, ‖g x * ljAmp n Ω x‖ₑ := by
          rw [lintegral_sub_right_eq_self (fun x => ‖g x * ljAmp n Ω x‖ₑ) z]
      _ ≤ ENNReal.ofReal (M * ljA1 n Ω) + ENNReal.ofReal (M * ljA1 n Ω) := add_le_add hl1 hl1
      _ = ENNReal.ofReal (2 * M * ljA1 n Ω) := by
          rw [← ENNReal.ofReal_add (by positivity) (by positivity)]; ring_nf
      _ ≤ ENNReal.ofReal (‖z‖ * (M * ljD0 n Ω + L * ljA1 n Ω + 2 * M * ljA1 n Ω)) := by
          refine ENNReal.ofReal_le_ofReal ?_
          nlinarith [mul_nonneg hM0 hD0, mul_nonneg hL0 hA1, mul_nonneg hM0 hA1]
  · -- small translations
    have hpt2 : ∀ x, ‖g (x - z) * ljAmp n Ω (x - z) - g x * ljAmp n Ω x‖ₑ ≤
        ENNReal.ofReal M * ‖ljAmp n Ω (x - z) - ljAmp n Ω x‖ₑ +
          ENNReal.ofReal (L * ‖z‖) * ‖ljAmp n Ω x‖ₑ := by
      intro x
      have hsplit : g (x - z) * ljAmp n Ω (x - z) - g x * ljAmp n Ω x =
          g (x - z) * (ljAmp n Ω (x - z) - ljAmp n Ω x) + (g (x - z) - g x) * ljAmp n Ω x := by
        ring
      rw [hsplit]
      refine (enorm_add_le _ _).trans (add_le_add ?_ ?_)
      · by_cases h0 : ljAmp n Ω (x - z) - ljAmp n Ω x = 0
        · simp [h0]
        · rw [enorm_mul]
          gcongr
          rw [← ofReal_norm]
          refine ENNReal.ofReal_le_ofReal (hM _ ?_)
          by_cases h1 : ljAmp n Ω (x - z) = 0
          · have h2 : ljAmp n Ω x ≠ 0 := fun h => h0 (by rw [h1, h]; ring)
            have := (ljAmp_ne_zero h2).2
            have := norm_sub_le x z
            linarith
          · linarith [(ljAmp_ne_zero h1).2]
      · by_cases h0 : ljAmp n Ω x = 0
        · simp [h0]
        · rw [enorm_mul]
          gcongr
          rw [← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal
            (hL x z (by linarith [(ljAmp_ne_zero h0).2]) hz.le)
    calc ∫⁻ x, ‖g (x - z) * ljAmp n Ω (x - z) - g x * ljAmp n Ω x‖ₑ
        ≤ ∫⁻ x, (ENNReal.ofReal M * ‖ljAmp n Ω (x - z) - ljAmp n Ω x‖ₑ +
          ENNReal.ofReal (L * ‖z‖) * ‖ljAmp n Ω x‖ₑ) := lintegral_mono hpt2
      _ = ENNReal.ofReal M * (∫⁻ x, ‖ljAmp n Ω (x - z) - ljAmp n Ω x‖ₑ) +
          ENNReal.ofReal (L * ‖z‖) * ∫⁻ x, ‖ljAmp n Ω x‖ₑ := by
          rw [lintegral_add_right _ (ha.continuous.enorm.measurable.const_mul _),
            lintegral_const_mul' _ _ (by simp), lintegral_const_mul' _ _ (by simp)]
      _ ≤ ENNReal.ofReal M * ENNReal.ofReal (‖z‖ * ljD0 n Ω) +
          ENNReal.ofReal (L * ‖z‖) * ENNReal.ofReal (ljA1 n Ω) := by
          rw [hΩ.lintegral_ljAmp]
          gcongr
          exact ha.translate_le z
      _ = ENNReal.ofReal (M * (‖z‖ * ljD0 n Ω) + L * ‖z‖ * ljA1 n Ω) := by
          rw [← ENNReal.ofReal_mul hM0, ← ENNReal.ofReal_mul (by positivity),
            ENNReal.ofReal_add (by positivity) (by positivity)]
      _ ≤ ENNReal.ofReal (‖z‖ * (M * ljD0 n Ω + L * ljA1 n Ω + 2 * M * ljA1 n Ω)) := by
          refine ENNReal.ofReal_le_ofReal ?_
          nlinarith [mul_nonneg (mul_nonneg hM0 hA1) (norm_nonneg z)]

/-- `|e^{iλ|y|^α}| = 1`, and the phase is Lipschitz near the support of `k₀`. -/
theorem lj_norm_phase_sub_le {α : ℝ} (hα : 1 < α) (lam : ℝ) (x z : Rn n) (hx : ‖x‖ ≤ 2)
    (hz : ‖z‖ ≤ 1) :
    ‖exp (I * lam * (‖x - z‖ ^ α : ℝ)) - exp (I * lam * (‖x‖ ^ α : ℝ))‖ ≤
      |lam| * α * 3 ^ (α - 1) * ‖z‖ := by
  have h := norm_exp_sub_exp_le (‖x - z‖ ^ α) (‖x‖ ^ α) lam
  have e : ∀ r : ℝ, exp (I * lam * (r : ℂ)) = exp (I * r * (lam : ℂ)) := fun r => by
    congr 1; ring
  rw [e, e]
  refine h.trans ?_
  have h2 := lj_abs_norm_rpow_sub_le hα hx hz
  calc |‖x - z‖ ^ α - ‖x‖ ^ α| * |lam| ≤ (α * 3 ^ (α - 1) * ‖z‖) * |lam| :=
        mul_le_mul_of_nonneg_right h2 (abs_nonneg _)
    _ = |lam| * α * 3 ^ (α - 1) * ‖z‖ := by ring

/-- `q̃_λ` belongs to the kernel class (`α > 1`) with `R = 2`, `B₀ = A₁` and
`D = D₀ + |λ| α 3^{α-1} A₁ + 2 A₁`. -/
theorem IsHomogeneousCZKernel.ljKernel_ljOsc (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ}
    (hα : 1 < α) (lam : ℝ) :
    LjKernel n (ljOsc n α Ω lam) 2 (ljA1 n Ω)
      (ljD0 n Ω + |lam| * α * 3 ^ (α - 1) * ljA1 n Ω + 2 * ljA1 n Ω) := by
  have hc : Continuous fun t : Rn n => exp (I * lam * ((‖t‖ ^ α : ℝ) : ℂ)) := by
    have : Continuous fun t : Rn n => ‖t‖ ^ α :=
      continuous_norm.rpow_const fun _ => Or.inr (by linarith)
    fun_prop
  have h := hΩ.ljKernel_mul hc (M := 1) (L := |lam| * α * 3 ^ (α - 1)) zero_le_one
    (by have : 0 < α := by linarith
        positivity)
    (fun y _ => (norm_exp_I_mul_mul lam _).le)
    (fun x z hx hz => lj_norm_phase_sub_le hα lam x z hx hz)
  simp only [one_mul, mul_one] at h
  exact h

/-- `q̃_λ - k₀ = (e^{iλ|t|^α} - 1) k₀` belongs to the kernel class (`α > 1`) with `R = 2`,
`B₀ = |λ| 3^α A₁`, `D = |λ| 3^α D₀ + |λ| α 3^{α-1} A₁ + 2 |λ| 3^α A₁`. -/
theorem IsHomogeneousCZKernel.ljKernel_ljOsc_sub (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ}
    (hα : 1 < α) (lam : ℝ) :
    LjKernel n (fun t => ljOsc n α Ω lam t - ljAmp n Ω t) 2 (|lam| * 3 ^ α * ljA1 n Ω)
      (|lam| * 3 ^ α * ljD0 n Ω + |lam| * α * 3 ^ (α - 1) * ljA1 n Ω +
        2 * (|lam| * 3 ^ α) * ljA1 n Ω) := by
  have hα0 : 0 < α := by linarith
  have hc : Continuous fun t : Rn n => exp (I * lam * ((‖t‖ ^ α : ℝ) : ℂ)) - 1 := by
    have : Continuous fun t : Rn n => ‖t‖ ^ α :=
      continuous_norm.rpow_const fun _ => Or.inr hα0.le
    fun_prop
  have h := hΩ.ljKernel_mul hc (M := |lam| * 3 ^ α) (L := |lam| * α * 3 ^ (α - 1))
    (by positivity) (by positivity)
    (fun y hy => by
      refine (norm_exp_I_mul_mul_sub_one_le lam _).trans ?_
      rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖y‖ ^ α)]
      gcongr)
    (fun x z hx hz => by
      rw [sub_sub_sub_cancel_right]
      exact lj_norm_phase_sub_le hα lam x z hx hz)
  have heq : (fun t => (exp (I * lam * ((‖t‖ ^ α : ℝ) : ℂ)) - 1) * ljAmp n Ω t) =
      fun t => ljOsc n α Ω lam t - ljAmp n Ω t := by
    funext t; simp only [ljOsc]; ring
  rw [heq] at h
  exact h

end Kernels

section KernelClass

variable {n : ℕ}

/-- The dilate with the real factor `2^{jn}` displayed as a real number. -/
theorem lpDilate_apply_ofReal (ψ : Rn n → ℂ) (j : ℤ) (x : Rn n) :
    lpDilate n ψ j x = (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) * ψ ((2 : ℝ) ^ j • x) := by
  rw [lpDilate]; push_cast; ring

/-- `∫ |ψ| ≤ B₀` as a Bochner integral, for kernels of the class. -/
theorem LjKernel.integral_norm_le {ψ : Rn n → ℂ} {R B₀ D : ℝ} (h : LjKernel n ψ R B₀ D)
    (hB : 0 ≤ B₀) : ∫ x, ‖ψ x‖ ≤ B₀ := by
  have h1 := h.lintegral_le
  rw [← ofReal_integral_norm_eq_lintegral_enorm h.integrable] at h1
  exact (ENNReal.ofReal_le_ofReal_iff hB).1 h1

/-- `min(y, y⁻¹) ≤ 1`. -/
theorem lj_min_inv_le_one {y : ℝ} (_hy : 0 ≤ y) : min y y⁻¹ ≤ 1 := by
  rcases le_or_gt y 1 with h | h
  · exact (min_le_left _ _).trans h
  · exact (min_le_right _ _).trans (inv_le_one_of_one_le₀ h.le)

/-- `min(y, y⁻¹) ≥ 0`. -/
theorem lj_min_inv_nonneg {y : ℝ} (hy : 0 ≤ y) : 0 ≤ min y y⁻¹ :=
  le_min hy (inv_nonneg.2 hy)

/-- **Fourier bound for mean-zero kernels of the class** (the bounds of Lemma 3.3 for the
non-oscillatory pieces): if `∫ ψ = 0`, then
`|𝓕ψ(η)| ≤ max(2π R B₀, D/4) min(|η|, |η|⁻¹)`. -/
theorem LjKernel.norm_fourier_le {ψ : Rn n → ℂ} {R B₀ D : ℝ} (h : LjKernel n ψ R B₀ D)
    (hR : 0 ≤ R) (hB : 0 ≤ B₀) (hD : 0 ≤ D) (hmean : ∫ x, ψ x = 0) (η : Rn n) :
    ‖𝓕 ψ η‖ ≤ max (2 * π * R * B₀) (D / 4) * min ‖η‖ ‖η‖⁻¹ := by
  have h1 : ‖𝓕 ψ η‖ ≤ 2 * π * R * B₀ * ‖η‖ := by
    have := lj_norm_fourier_sub_integral_le h.integrable h.eq_zero η
    rw [hmean, sub_zero] at this
    refine this.trans ?_
    have := h.integral_norm_le hB
    calc 2 * π * R * ‖η‖ * ∫ x, ‖ψ x‖ ≤ 2 * π * R * ‖η‖ * B₀ := by gcongr
      _ = 2 * π * R * B₀ * ‖η‖ := by ring
  have h2 : ‖𝓕 ψ η‖ * (4 * ‖η‖) ≤ D := lj_norm_fourier_mul_le h.integrable hD h.translate_le η
  rw [mul_min_of_nonneg _ _ (le_max_of_le_right (by positivity))]
  refine le_min (h1.trans (by gcongr; exact le_max_left _ _)) ?_
  rcases eq_or_ne η 0 with rfl | hη
  · simp only [norm_zero, inv_zero, mul_zero]
    have := lj_norm_fourier_sub_integral_le h.integrable h.eq_zero 0
    rw [hmean, sub_zero] at this
    simpa using this
  · have hp : 0 < ‖η‖ := norm_pos_iff.2 hη
    calc ‖𝓕 ψ η‖ = ‖𝓕 ψ η‖ * (4 * ‖η‖) / (4 * ‖η‖) := by field_simp
      _ ≤ D / (4 * ‖η‖) := by gcongr
      _ = D / 4 * ‖η‖⁻¹ := by field_simp
      _ ≤ max (2 * π * R * B₀) (D / 4) * ‖η‖⁻¹ := by gcongr; exact le_max_right _ _

/-- The squared form of `LjKernel.norm_fourier_le`, as needed in `lj_eLpNorm_sqFun_le`:
`|𝓕ψ(η)|² ≤ max(2π R B₀, D/4)² (min(|η|, |η|⁻¹) + min(|η|/ρ, ρ/|η|))`. -/
theorem LjKernel.norm_fourier_sq_le {ψ : Rn n → ℂ} {R B₀ D : ℝ} (h : LjKernel n ψ R B₀ D)
    (hR : 0 ≤ R) (hB : 0 ≤ B₀) (hD : 0 ≤ D) (hmean : ∫ x, ψ x = 0) (ρ : ℝ) (hρ : 0 < ρ)
    (η : Rn n) :
    ‖𝓕 ψ η‖ ^ 2 ≤ max (2 * π * R * B₀) (D / 4) ^ 2 *
      (min ‖η‖ ‖η‖⁻¹ + min (‖η‖ / ρ) (‖η‖ / ρ)⁻¹) := by
  have h1 := h.norm_fourier_le hR hB hD hmean η
  have hm0 := lj_min_inv_nonneg (norm_nonneg η)
  have hm1 := lj_min_inv_le_one (norm_nonneg η)
  have hm2 := lj_min_inv_nonneg (div_nonneg (norm_nonneg η) hρ.le)
  have hM : 0 ≤ max (2 * π * R * B₀) (D / 4) := le_max_of_le_right (by positivity)
  calc ‖𝓕 ψ η‖ ^ 2 ≤ (max (2 * π * R * B₀) (D / 4) * min ‖η‖ ‖η‖⁻¹) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h1 2
    _ = max (2 * π * R * B₀) (D / 4) ^ 2 * (min ‖η‖ ‖η‖⁻¹ * min ‖η‖ ‖η‖⁻¹) := by ring
    _ ≤ max (2 * π * R * B₀) (D / 4) ^ 2 * (min ‖η‖ ‖η‖⁻¹ * 1) := by gcongr
    _ ≤ _ := by gcongr; linarith

/-- **Dilates stay in the kernel class**: `ψ_j = 2^{jn} ψ(2^j ·)` belongs to the class with
`R' = 2^{-j} R`, `B₀' = B₀`, `D' = 2^j D`. -/
theorem LjKernel.dilate {ψ : Rn n → ℂ} {R B₀ D : ℝ} (h : LjKernel n ψ R B₀ D)
    (j : ℤ) : LjKernel n (Auto.lpDilate n ψ j) ((2 : ℝ) ^ (-j) * R) B₀ ((2 : ℝ) ^ j * D) := by
  have h2j : (0 : ℝ) < 2 ^ j := zpow_pos two_pos j
  have hscale : ∀ g : Rn n → ℝ≥0∞, ∫⁻ x, ENNReal.ofReal ((2 : ℝ) ^ (j * n)) * g ((2 : ℝ) ^ j • x)
      = ∫⁻ w, g w := by
    intro g
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
      lj_lintegral_comp_smul (fun w => g w) h2j.ne', ← mul_assoc,
      ← ENNReal.ofReal_mul (by positivity)]
    have : (2 : ℝ) ^ (j * n) * |(((2 : ℝ) ^ j) ^ n)⁻¹| = 1 := by
      rw [abs_of_pos (by positivity), zpow_mul, zpow_natCast, mul_inv_cancel₀ (by positivity)]
    rw [this, ENNReal.ofReal_one, one_mul]
  have hnorm : ∀ x : Rn n, ‖lpDilate n ψ j x‖ₑ =
      ENNReal.ofReal ((2 : ℝ) ^ (j * n)) * ‖ψ ((2 : ℝ) ^ j • x)‖ₑ := by
    intro x
    rw [lpDilate_apply_ofReal, enorm_mul, ← ofReal_norm (((2 : ℝ) ^ (j * n) : ℝ) : ℂ),
      Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  refine ⟨continuous_lpDilate h.continuous j, fun x hx => ?_, ?_, fun z => ?_⟩
  · have : R < ‖(2 : ℝ) ^ j • x‖ := by
      rw [norm_smul, Real.norm_of_nonneg h2j.le]
      rw [zpow_neg, ← div_eq_inv_mul, div_lt_iff₀ h2j] at hx
      linarith
    simp [lpDilate_apply_ofReal, h.eq_zero _ this]
  · simp_rw [hnorm]
    rw [hscale (fun w => ‖ψ w‖ₑ)]
    exact h.lintegral_le
  · have hnorm2 : ∀ x : Rn n, ‖lpDilate n ψ j (x - z) - lpDilate n ψ j x‖ₑ =
        ENNReal.ofReal ((2 : ℝ) ^ (j * n)) *
          ‖ψ ((2 : ℝ) ^ j • x - (2 : ℝ) ^ j • z) - ψ ((2 : ℝ) ^ j • x)‖ₑ := by
      intro x
      rw [lpDilate_apply_ofReal, lpDilate_apply_ofReal, smul_sub, ← mul_sub, enorm_mul,
        ← ofReal_norm (((2 : ℝ) ^ (j * n) : ℝ) : ℂ), Complex.norm_real,
        Real.norm_of_nonneg (by positivity)]
    simp_rw [hnorm2]
    rw [hscale (fun w => ‖ψ (w - (2 : ℝ) ^ j • z) - ψ w‖ₑ)]
    refine (h.translate_le _).trans (le_of_eq ?_)
    rw [norm_smul, Real.norm_of_nonneg h2j.le]
    ring_nf

/-- Dilation preserves integrals: `∫ ψ_j = ∫ ψ`. -/
theorem integral_lpDilate (ψ : Rn n → ℂ) (j : ℤ) : ∫ x, lpDilate n ψ j x = ∫ x, ψ x := by
  have h2j : (0 : ℝ) < 2 ^ j := zpow_pos two_pos j
  simp only [lpDilate_apply_ofReal]
  rw [integral_const_mul, Measure.integral_comp_smul, finrank_euclideanSpace_fin,
    abs_of_pos (by positivity), Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul]
  have : (2 : ℝ) ^ (j * n) * (((2 : ℝ) ^ j) ^ n)⁻¹ = 1 := by
    rw [zpow_mul, zpow_natCast, mul_inv_cancel₀ (by positivity)]
  rw [this, Complex.ofReal_one, one_mul]

end KernelClass

section OscillatoryMultiplier

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- `min(x, x⁻¹) = x` for `0 ≤ x ≤ 1`. -/
theorem lj_min_inv_of_le_one {x : ℝ} (hx : 0 ≤ x) (hx1 : x ≤ 1) : min x x⁻¹ = x := by
  rcases hx.eq_or_lt with h | h
  · rw [← h]; simp
  · exact min_eq_left (hx1.trans ((one_le_inv₀ h).2 hx1))

/-- `min(x, x⁻¹) = x⁻¹` for `x ≥ 1`. -/
theorem lj_min_inv_of_one_le {x : ℝ} (hx1 : 1 ≤ x) : min x x⁻¹ = x⁻¹ :=
  min_eq_right ((inv_le_one_of_one_le₀ hx1).trans hx1)

/-- The elementary case analysis behind the multiplier bound for `q̃_λ` (Lemma 3.3): from the
trivial bound `F ≤ A₁`, the mean-zero bound `F ≤ 4π A₁ x`, the stationary-phase bound
`F² ≤ S λ⁻¹` and the non-stationary bound `F ≤ K (λ + 2πx)⁻²` (valid when `2πx ≥ c₂ λ` or
`2πx ≤ c₁ λ`), one gets `F² ≤ C λ⁻¹ (min(x, x⁻¹) + min(x/λ, λ/x))` (`λ ≥ 1`). -/
theorem lj_osc_real_bound {F x lam A₁ K S c₁ c₂ : ℝ} (hF : 0 ≤ F) (hx : 0 ≤ x)
    (hlam : 1 ≤ lam) (hA : 0 ≤ A₁) (hK : 0 ≤ K) (hS0 : 0 ≤ S) (hc₁ : 0 < c₁) (hc₂ : 0 < c₂)
    (hT : F ≤ A₁) (hZ : F ≤ 4 * π * A₁ * x) (hS : F ^ 2 ≤ S * lam⁻¹)
    (hN : c₂ * lam ≤ 2 * π * x ∨ 2 * π * x ≤ c₁ * lam → F ≤ K * ((lam + 2 * π * x) ^ 2)⁻¹) :
    F ^ 2 ≤ (4 * π * A₁ * K + K ^ 2 * c₁ / (2 * π) + K ^ 2 / (2 * π) + 8 * π ^ 2 * A₁ ^ 2 / c₂ +
      S / min (c₁ / (2 * π)) (2 * π / c₂)) * lam⁻¹ *
        (min x x⁻¹ + min (x / lam) (x / lam)⁻¹) := by
  have hpi := Real.pi_pos
  have hlam0 : 0 < lam := by linarith
  have hli : 0 < lam⁻¹ := inv_pos.2 hlam0
  have hli1 : lam⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hlam
  set κ := min (c₁ / (2 * π)) (2 * π / c₂) with hκ
  have hκ0 : 0 < κ := lt_min (by positivity) (by positivity)
  set m₁ := min x x⁻¹ with hm₁
  set m₂ := min (x / lam) (x / lam)⁻¹ with hm₂
  have hm₁0 : 0 ≤ m₁ := lj_min_inv_nonneg hx
  have hm₂0 : 0 ≤ m₂ := lj_min_inv_nonneg (div_nonneg hx hlam0.le)
  set C := 4 * π * A₁ * K + K ^ 2 * c₁ / (2 * π) + K ^ 2 / (2 * π) + 8 * π ^ 2 * A₁ ^ 2 / c₂ +
      S / κ with hC
  have t1 : 0 ≤ 4 * π * A₁ * K := by positivity
  have t2 : 0 ≤ K ^ 2 * c₁ / (2 * π) := by positivity
  have t3 : 0 ≤ K ^ 2 / (2 * π) := by positivity
  have t4 : 0 ≤ 8 * π ^ 2 * A₁ ^ 2 / c₂ := by positivity
  have t5 : 0 ≤ S / κ := by positivity
  -- reduction: it suffices to bound by one case constant times one of the `min` terms
  have key : ∀ c m : ℝ, 0 ≤ c → c ≤ C → (m = m₁ ∨ m = m₂) → F ^ 2 ≤ c * lam⁻¹ * m →
      F ^ 2 ≤ C * lam⁻¹ * (m₁ + m₂) := by
    intro c m hc hcC hm h
    refine h.trans ?_
    have hm' : m ≤ m₁ + m₂ := by rcases hm with rfl | rfl <;> linarith
    have hm0 : 0 ≤ m := by rcases hm with rfl | rfl <;> assumption
    calc c * lam⁻¹ * m ≤ C * lam⁻¹ * m := by gcongr
      _ ≤ C * lam⁻¹ * (m₁ + m₂) := by gcongr
  have hF2 : F ^ 2 = F * F := sq F
  rcases le_or_gt (2 * π * x) (c₁ * lam) with ha | ha
  · -- low frequencies (no critical point)
    have hNF := hN (Or.inr ha)
    have hden : (lam ^ 2)⁻¹ ≥ ((lam + 2 * π * x) ^ 2)⁻¹ := by
      gcongr; nlinarith
    rcases le_or_gt x 1 with hx1 | hx1
    · have hmx : m₁ = x := lj_min_inv_of_le_one hx hx1
      refine key (4 * π * A₁ * K) m₁ t1 (by linarith) (Or.inl rfl) ?_
      rw [hF2, hmx]
      have h2 : F ≤ K * (lam ^ 2)⁻¹ := hNF.trans (by gcongr)
      have h3 : (lam ^ 2)⁻¹ ≤ lam⁻¹ := by
        rw [inv_le_inv₀ (by positivity) hlam0]; nlinarith
      calc F * F ≤ (4 * π * A₁ * x) * (K * (lam ^ 2)⁻¹) :=
            mul_le_mul hZ h2 hF (by positivity)
        _ ≤ (4 * π * A₁ * x) * (K * lam⁻¹) := by gcongr
        _ = 4 * π * A₁ * K * lam⁻¹ * x := by ring
    · have hmx : m₁ = x⁻¹ := lj_min_inv_of_one_le hx1.le
      refine key (K ^ 2 * c₁ / (2 * π)) m₁ t2 (by linarith) (Or.inl rfl) ?_
      rw [hmx]
      have h2 : F ≤ K * (lam ^ 2)⁻¹ := hNF.trans (by gcongr)
      have hxlam : lam⁻¹ ≤ c₁ / (2 * π) * x⁻¹ := by
        have hx0 : 0 < x := by linarith
        rw [show c₁ / (2 * π) * x⁻¹ = c₁ / (2 * π * x) by field_simp,
          le_div_iff₀ (by positivity)]
        calc lam⁻¹ * (2 * π * x) ≤ lam⁻¹ * (c₁ * lam) := by gcongr
          _ = c₁ := by field_simp
      have h4 : (lam ^ 2)⁻¹ ≤ lam⁻¹ := by
        rw [inv_le_inv₀ (by positivity) hlam0]; nlinarith
      calc F ^ 2 ≤ (K * (lam ^ 2)⁻¹) ^ 2 := pow_le_pow_left₀ hF h2 2
        _ = K ^ 2 * ((lam ^ 2)⁻¹ * (lam ^ 2)⁻¹) := by ring
        _ ≤ K ^ 2 * (lam⁻¹ * (c₁ / (2 * π) * x⁻¹)) := by
            exact mul_le_mul_of_nonneg_left
              (mul_le_mul h4 (h4.trans hxlam) (by positivity) (by positivity)) (sq_nonneg K)
        _ = K ^ 2 * c₁ / (2 * π) * lam⁻¹ * x⁻¹ := by ring
  rcases le_or_gt (c₂ * lam) (2 * π * x) with hb | hb
  · -- high frequencies (no critical point)
    have hNF := hN (Or.inl hb)
    rcases le_or_gt 1 x with hx1 | hx1
    · have hmx : m₁ = x⁻¹ := lj_min_inv_of_one_le hx1
      refine key (K ^ 2 / (2 * π)) m₁ t3 (by linarith) (Or.inl rfl) ?_
      rw [hmx]
      have hx0 : 0 < x := by linarith
      have h2pi : (1 : ℝ) ≤ 2 * π := by linarith [Real.pi_gt_three]
      have hz1 : 1 ≤ 2 * π * x := by
        calc (1 : ℝ) = 1 * 1 := by ring
          _ ≤ 2 * π * x := mul_le_mul h2pi hx1 zero_le_one (by positivity)
      have h5 : ((lam + 2 * π * x) ^ 2)⁻¹ ^ 2 ≤ lam⁻¹ * (2 * π * x)⁻¹ := by
        set z := 2 * π * x with hz
        have hz0 : 0 ≤ z := by linarith
        have h6 : lam * z ≤ (lam + z) ^ 2 := by
          have e : (lam + z) ^ 2 = lam * z + (lam ^ 2 + lam * z + z ^ 2) := by ring
          have : 0 ≤ lam ^ 2 + lam * z + z ^ 2 := by positivity
          linarith
        have h7 : (lam + z) ^ 2 ≤ ((lam + z) ^ 2) ^ 2 :=
          le_self_pow₀ (one_le_pow₀ (by linarith)) (by norm_num)
        rw [inv_pow, ← mul_inv]
        exact inv_anti₀ (by positivity) (h6.trans h7)
      calc F ^ 2 ≤ (K * ((lam + 2 * π * x) ^ 2)⁻¹) ^ 2 := pow_le_pow_left₀ hF hNF 2
        _ = K ^ 2 * ((lam + 2 * π * x) ^ 2)⁻¹ ^ 2 := by ring
        _ ≤ K ^ 2 * (lam⁻¹ * (2 * π * x)⁻¹) := by gcongr
        _ = K ^ 2 / (2 * π) * lam⁻¹ * x⁻¹ := by ring
    · have hmx : m₁ = x := lj_min_inv_of_le_one hx hx1.le
      refine key (8 * π ^ 2 * A₁ ^ 2 / c₂) m₁ t4 (by linarith) (Or.inl rfl) ?_
      rw [hmx]
      have hl : 1 ≤ 2 * π / c₂ * lam⁻¹ := by
        rw [show 2 * π / c₂ * lam⁻¹ = 2 * π / (c₂ * lam) by field_simp,
          le_div_iff₀ (by positivity), one_mul]
        nlinarith
      calc F ^ 2 = F * F := hF2
        _ ≤ (4 * π * A₁ * x) * A₁ := mul_le_mul hZ hT hF (by positivity)
        _ ≤ (4 * π * A₁ * x) * A₁ * (2 * π / c₂ * lam⁻¹) :=
            le_mul_of_one_le_right (by positivity) hl
        _ = 8 * π ^ 2 * A₁ ^ 2 / c₂ * lam⁻¹ * x := by field_simp; ring
  · -- intermediate frequencies: stationary phase
    refine key (S / κ) m₂ t5 (by linarith) (Or.inr rfl) ?_
    have hx0 : 0 < x := by
      by_contra h
      have : x = 0 := le_antisymm (not_lt.1 h) hx
      rw [this, mul_zero] at ha
      nlinarith
    have hm2 : κ ≤ m₂ := by
      refine le_min ?_ ?_
      · refine (min_le_left _ _).trans ?_
        rw [div_le_div_iff₀ (by positivity) hlam0]; linarith
      · refine (min_le_right _ _).trans ?_
        rw [inv_div, div_le_div_iff₀ hc₂ hx0]; linarith
    calc F ^ 2 ≤ S * lam⁻¹ := hS
      _ = S / κ * lam⁻¹ * κ := by field_simp
      _ ≤ S / κ * lam⁻¹ * m₂ := by gcongr

/-- Uniform bounds for the derivatives of `k₀` up to order `N`. -/
theorem IsHomogeneousCZKernel.exists_iteratedFDeriv_ljAmp_le (hΩ : IsHomogeneousCZKernel n Ω)
    (N : ℕ) : ∃ A, ∀ j, j ≤ N → ∀ x, ‖iteratedFDeriv ℝ j (ljAmp n Ω) x‖ ≤ A := by
  have hb : ∀ j : ℕ, ∃ C, ∀ x, ‖iteratedFDeriv ℝ j (ljAmp n Ω) x‖ ≤ C := by
    intro j
    exact (hΩ.contDiff_ljAmp.continuous_iteratedFDeriv
      (by exact_mod_cast le_top)).bounded_above_of_compact_support
        (hasCompactSupport_ljAmp.iteratedFDeriv j)
  choose C hC using hb
  refine ⟨∑ j ∈ Finset.range (N + 1), |C j|, fun j hj x => ?_⟩
  refine (hC j x).trans ((le_abs_self _).trans ?_)
  exact Finset.single_le_sum (f := fun j => |C j|) (fun i _ => abs_nonneg _)
    (Finset.mem_range.2 (by omega))

/-- The topological support of `k₀` lies in the annulus `1/2 ≤ |t| ≤ 2`. -/
theorem tsupport_ljAmp_subset : tsupport (ljAmp n Ω) ⊆ {t | 1 / 2 ≤ ‖t‖ ∧ ‖t‖ ≤ 2} := by
  have := tsupport_ljOsc_subset (n := n) (Ω := Ω) 1 0
  rwa [ljOsc_zero] at this

/-- The Fourier transform of `q̃_λ` as an oscillatory integral with phase
`λ |x|^α - ⟪x, 2π η⟫` (Mathlib's convention `𝓕 f(η) = ∫ e^{-2πi⟪x, η⟫} f(x) dx`). -/
theorem fourier_ljOsc_eq (α lam : ℝ) (η : Rn n) :
    𝓕 (ljOsc n α Ω lam) η = ∫ x, exp (I * ((lam * 1 * ‖x‖ ^ α - inner ℝ x ((2 * π) • η) : ℝ) : ℂ)) *
      ljAmp n Ω x := by
  rw [Real.fourier_eq']
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only [ljOsc, smul_eq_mul]
  rw [← mul_assoc, ← Complex.exp_add, real_inner_smul_right]
  congr 2
  push_cast
  ring

/-- `|𝓕 f(η)| ≤ ∫ |f|`. -/
theorem lj_norm_fourier_le_integral_norm (f : Rn n → ℂ) (η : Rn n) :
    ‖𝓕 f η‖ ≤ ∫ x, ‖f x‖ := by
  rw [Real.fourier_eq]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  simp

/-- **Lemma 3.3 (oscillatory pieces)**: for `α > 1` there is `C` such that for all `λ ≥ 1`
and `η`, `|𝓕 q̃_λ(η)|² ≤ C λ⁻¹ (min(|η|, |η|⁻¹) + min(|η|/λ, λ/|η|))`, where
`q̃_λ(t) = e^{iλ|t|^α} φ₀(t) K(t)`. This combines the stationary phase bound `≲ λ^{-n/2}`
(convex phase), non-stationary phase away from `|η| ≈ λ`, and the mean-zero bound `≲ |η|`
near the origin (the paper's `|m_ℓ(ξ)| ≲ min(2^{-γℓ}, 2^{αℓ} |ξ|^{-γ})`). -/
theorem IsHomogeneousCZKernel.norm_fourier_ljOsc_sq_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) :
    ∃ C, 0 ≤ C ∧ ∀ lam : ℝ, 1 ≤ lam → ∀ η : Rn n, ‖𝓕 (ljOsc n α Ω lam) η‖ ^ 2 ≤
      C * lam⁻¹ * (min ‖η‖ ‖η‖⁻¹ + min (‖η‖ / lam) (‖η‖ / lam)⁻¹) := by
  obtain ⟨A, hA⟩ := hΩ.exists_iteratedFDeriv_ljAmp_le (n + 1)
  obtain ⟨CS, hCS0, hS⟩ := norm_integral_exp_radial_le n hα 1 A
  obtain ⟨CN, hCN0, hN⟩ := norm_integral_exp_radial_le_of_nonstationary n 2 hα 1
  set AN := ∑ k ∈ Finset.range (2 + 1), ∫ x, ‖iteratedFDeriv ℝ k (ljAmp n Ω) x‖ with hAN
  have hAN0 : 0 ≤ AN := Finset.sum_nonneg fun k _ => integral_nonneg fun _ => norm_nonneg _
  set A₁ := ljA1 n Ω
  have hA₁ : 0 ≤ A₁ := ljA1_nonneg
  have hα0 : 0 < α := by linarith
  set c₁ := α * 2 ^ (-|α - 1|) / 2 with hc₁
  set c₂ := 2 * α * 1 * 2 ^ |α - 1| with hc₂
  have hc₁0 : 0 < c₁ := by positivity
  have hc₂0 : 0 < c₂ := by positivity
  set K := CN * AN
  refine ⟨4 * π * A₁ * K + K ^ 2 * c₁ / (2 * π) + K ^ 2 / (2 * π) +
    8 * π ^ 2 * A₁ ^ 2 / c₂ + CS ^ 2 / min (c₁ / (2 * π)) (2 * π / c₂), ?_, ?_⟩
  · have : 0 < min (c₁ / (2 * π)) (2 * π / c₂) := lt_min (by positivity) (by positivity)
    positivity
  intro lam hlam η
  have hlam0 : 0 < lam := by linarith
  have hsupp := tsupport_ljAmp_subset (n := n) (Ω := Ω)
  have hamp := hΩ.contDiff_ljAmp
  have hξ : ‖(2 * π) • η‖ = 2 * π * ‖η‖ := by
    rw [norm_smul, Real.norm_of_nonneg (by positivity)]
  have hint : ∫ x, ‖ljOsc n α Ω lam x‖ = A₁ := by
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp [ljOsc, norm_exp_I_mul_mul]
  refine lj_osc_real_bound (norm_nonneg _) (norm_nonneg η) hlam hA₁ (by positivity)
    (sq_nonneg CS) hc₁0 hc₂0 ?_ ?_ ?_ ?_
  · -- trivial bound
    exact (lj_norm_fourier_le_integral_norm _ η).trans hint.le
  · -- mean-zero bound
    have h := lj_norm_fourier_sub_integral_le (hΩ.integrable_ljOsc α lam) (R := 2)
      (fun x hx => ljOsc_eq_zero_of_ljAmp (ljAmp_eq_zero_of_ge hx.le)) η
    rw [hΩ.integral_ljOsc hn, sub_zero, hint] at h
    linarith
  · -- stationary phase
    have h := hS (ljAmp n Ω) lam 1 ((2 * π) • η) hlam0 le_rfl le_rfl hamp hsupp hA
    rw [← fourier_ljOsc_eq] at h
    have h2 : (lam ^ (-(n : ℝ) / 2)) ^ 2 ≤ lam⁻¹ := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hlam0.le, ← Real.rpow_neg_one]
      refine Real.rpow_le_rpow_of_exponent_le hlam ?_
      have : (1 : ℝ) ≤ n := by exact_mod_cast hn
      push_cast
      linarith
    calc ‖𝓕 (ljOsc n α Ω lam) η‖ ^ 2 ≤ (CS * lam ^ (-(n : ℝ) / 2)) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h 2
      _ = CS ^ 2 * (lam ^ (-(n : ℝ) / 2)) ^ 2 := by ring
      _ ≤ CS ^ 2 * lam⁻¹ := by gcongr
  · -- non-stationary phase
    intro hcase
    have hcase' : 2 * α * 1 * 2 ^ |α - 1| * lam ≤ ‖(2 * π) • η‖ ∨
        ‖(2 * π) • η‖ ≤ α * 2 ^ (-|α - 1|) * lam / 2 := by
      rw [hξ]
      rcases hcase with h | h
      · exact Or.inl h
      · right; rw [hc₁] at h; linarith
    have h := hN (ljAmp n Ω) lam 1 ((2 * π) • η) hlam0 le_rfl le_rfl hamp hsupp hcase'
    rw [← fourier_ljOsc_eq, hξ] at h
    have he : (lam + 2 * π * ‖η‖) ^ (-((2 : ℕ) : ℝ)) = ((lam + 2 * π * ‖η‖) ^ 2)⁻¹ := by
      rw [Real.rpow_neg (by positivity), Real.rpow_natCast]
    rw [he] at h
    calc ‖𝓕 (ljOsc n α Ω lam) η‖ ≤ CN * ((lam + 2 * π * ‖η‖) ^ 2)⁻¹ * AN := h
      _ = K * ((lam + 2 * π * ‖η‖) ^ 2)⁻¹ := by ring

end OscillatoryMultiplier

section Bump

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- `∫ η`, the normalizing constant of the bump. -/
noncomputable def ljEtaInt (n : ℕ) : ℝ := ∫ t, dyadicEta n t

/-- The approximate identity `φ = η / ∫ η` (smooth, radial, nonnegative, supported in the ball
of radius `2`, `∫ φ = 1`), used for the comparison `φ_j * 𝓗^{(0)} f` (the function `S` of
(`eq:Sk_jump`) in the paper). -/
noncomputable def ljBump (n : ℕ) (t : Rn n) : ℂ := (((ljEtaInt n)⁻¹ * dyadicEta n t : ℝ) : ℂ)

/-- `η` is integrable. -/
theorem integrable_dyadicEta (n : ℕ) : Integrable (dyadicEta n) :=
  (contDiff_dyadicEta n).continuous.integrable_of_hasCompactSupport
    (HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) 2) fun x hx =>
      dyadicEta_eq_zero (le_of_lt (by simpa using hx)))

/-- `∫ η > 0`. -/
theorem ljEtaInt_pos (n : ℕ) : 0 < ljEtaInt n := by
  rw [ljEtaInt, integral_pos_iff_support_of_nonneg (dyadicEta_nonneg n) (integrable_dyadicEta n)]
  refine lt_of_lt_of_le (Metric.measure_ball_pos volume (0 : Rn n) one_pos)
    (measure_mono fun x hx => ?_)
  rw [Function.mem_support, dyadicEta_eq_one (by simpa using (Metric.mem_ball.1 hx).le)]
  exact one_ne_zero

/-- `φ` is smooth. -/
theorem contDiff_ljBump (n : ℕ) : ContDiff ℝ (⊤ : ℕ∞) (ljBump n) :=
  Complex.ofRealCLM.contDiff.comp (contDiff_const.mul (contDiff_dyadicEta n))

/-- `φ(t) = 0` for `|t| ≥ 2`. -/
theorem ljBump_eq_zero {t : Rn n} (ht : 2 ≤ ‖t‖) : ljBump n t = 0 := by
  simp [ljBump, dyadicEta_eq_zero ht]

/-- `φ` has compact support. -/
theorem hasCompactSupport_ljBump (n : ℕ) : HasCompactSupport (ljBump n) :=
  HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) 2) fun x hx =>
    ljBump_eq_zero (le_of_lt (by simpa using hx))

/-- `φ` is integrable. -/
theorem integrable_ljBump (n : ℕ) : Integrable (ljBump n) :=
  (contDiff_ljBump n).continuous.integrable_of_hasCompactSupport (hasCompactSupport_ljBump n)

/-- `∫ φ = 1`. -/
theorem integral_ljBump (n : ℕ) : ∫ t, ljBump n t = 1 := by
  change ∫ t, (((ljEtaInt n)⁻¹ * dyadicEta n t : ℝ) : ℂ) = 1
  rw [integral_complex_ofReal, integral_const_mul, ← ljEtaInt,
    inv_mul_cancel₀ (ljEtaInt_pos n).ne', Complex.ofReal_one]

/-- `|φ(t)| = φ(t)` (as a real number). -/
theorem norm_ljBump (t : Rn n) : ‖ljBump n t‖ = (ljEtaInt n)⁻¹ * dyadicEta n t := by
  rw [ljBump, Complex.norm_real, Real.norm_of_nonneg
    (mul_nonneg (inv_nonneg.2 (ljEtaInt_pos n).le) (dyadicEta_nonneg n t))]

/-- `∫ |φ| = 1`. -/
theorem lintegral_ljBump (n : ℕ) : ∫⁻ t, ‖ljBump n t‖ₑ = 1 := by
  rw [← ofReal_integral_norm_eq_lintegral_enorm (integrable_ljBump n)]
  simp_rw [norm_ljBump]
  rw [integral_const_mul, ← ljEtaInt, inv_mul_cancel₀ (ljEtaInt_pos n).ne', ENNReal.ofReal_one]

/-- The translation constant `D_φ = ∫ |∇φ|` of the bump. -/
noncomputable def ljBumpD (n : ℕ) : ℝ := (∫⁻ t, ‖fderiv ℝ (ljBump n) t‖ₑ).toReal

/-- `D_φ ≥ 0`. -/
theorem ljBumpD_nonneg : 0 ≤ ljBumpD n := ENNReal.toReal_nonneg

/-- `φ` belongs to the kernel class with `R = 2`, `B₀ = 1`, `D = D_φ`. -/
theorem ljKernel_ljBump (n : ℕ) : LjKernel n (ljBump n) 2 1 (ljBumpD n) where
  continuous := (contDiff_ljBump n).continuous
  eq_zero := fun x hx => ljBump_eq_zero hx.le
  lintegral_le := by rw [lintegral_ljBump, ENNReal.ofReal_one]
  translate_le := fun z => by
    have hfin : ∫⁻ t, ‖fderiv ℝ (ljBump n) t‖ₑ ≠ ∞ := by
      have hc : Continuous (fderiv ℝ (ljBump n)) :=
        (contDiff_ljBump n).continuous_fderiv (by simp)
      exact (hc.integrable_of_hasCompactSupport
        ((hasCompactSupport_ljBump n).fderiv (𝕜 := ℝ))).2.ne
    refine (lj_lintegral_enorm_sub_le_of_contDiff ((contDiff_ljBump n).of_le (by simp)) z).trans
      (le_of_eq ?_)
    rw [ljBumpD, ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ENNReal.ofReal_toReal hfin]

/-- The bump `φ` as a Schwartz function (for the Jones–Seeger–Wright inequality). -/
noncomputable def ljBumpSchwartz (n : ℕ) : SchwartzMap (Rn n) ℂ :=
  (hasCompactSupport_ljBump n).toSchwartzMap (contDiff_ljBump n)

/-- The Schwartz bump coerces to `φ`. -/
theorem coe_ljBumpSchwartz (n : ℕ) : (ljBumpSchwartz n : Rn n → ℂ) = ljBump n := rfl

/-- **Minkowski's integral inequality** in `L¹`, for a jointly measurable integrand. -/
theorem lj_lintegral_enorm_integral_le {F : Rn n → Rn n → ℂ}
    (hF : Measurable (Function.uncurry F)) :
    ∫⁻ x, ‖∫ t, F x t‖ₑ ≤ ∫⁻ t, ∫⁻ x, ‖F x t‖ₑ := by
  calc ∫⁻ x, ‖∫ t, F x t‖ₑ ≤ ∫⁻ x, ∫⁻ t, ‖F x t‖ₑ :=
        lintegral_mono fun x => enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ t, ∫⁻ x, ‖F x t‖ₑ := lintegral_lintegral_swap hF.enorm.aemeasurable

end Bump

section BumpConvolution

variable {n : ℕ}

/-- `(φ * g)(x) = ∫ φ(t) g(x - t) dt`. -/
theorem lj_conv_apply (g : Rn n → ℂ) (x : Rn n) :
    (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x = ∫ t, ljBump n t * g (x - t) := by
  rw [convolution_def]; rfl

/-- `(φ * g)(x) = ∫ φ(x - s) g(s) ds`. -/
theorem lj_conv_apply_swap (g : Rn n → ℂ) (x : Rn n) :
    (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x = ∫ s, ljBump n (x - s) * g s :=
  convolution_mul_swap

/-- Integrability of `t ↦ φ(t) g(x - t)` for bounded continuous `g`. -/
theorem LjKernel.integrable_bump_mul {g : Rn n → ℂ} {R B D : ℝ} (h : LjKernel n g R B D)
    (x : Rn n) : Integrable fun t => ljBump n t * g (x - t) := by
  obtain ⟨C, hC⟩ := h.continuous.bounded_above_of_compact_support h.hasCompactSupport
  exact (integrable_ljBump n).mul_bdd (h.continuous.comp (continuous_const.sub continuous_id)
    ).aestronglyMeasurable (Eventually.of_forall fun t => hC _)

/-- Integrability of `s ↦ φ(x - s) g(s)` for integrable `g`. -/
theorem LjKernel.integrable_mul_bump {g : Rn n → ℂ} {R B D : ℝ} (h : LjKernel n g R B D)
    (x : Rn n) : Integrable fun s => ljBump n (x - s) * g s := by
  obtain ⟨C, hC⟩ := (contDiff_ljBump n).continuous.bounded_above_of_compact_support
    (hasCompactSupport_ljBump n)
  exact h.integrable.bdd_mul ((contDiff_ljBump n).continuous.comp
    (continuous_const.sub continuous_id)).aestronglyMeasurable
    (Eventually.of_forall fun s => hC _)

/-- `φ * g` is continuous. -/
theorem LjKernel.continuous_conv {g : Rn n → ℂ} {R B D : ℝ} (h : LjKernel n g R B D) :
    Continuous (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) :=
  (hasCompactSupport_ljBump n).continuous_convolution_left _ (contDiff_ljBump n).continuous
    h.integrable.locallyIntegrable

/-- `φ * g` vanishes outside the ball of radius `2 + R`. -/
theorem LjKernel.conv_eq_zero {g : Rn n → ℂ} {R B D : ℝ} (h : LjKernel n g R B D) (x : Rn n)
    (hx : 2 + R < ‖x‖) : (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x = 0 := by
  rw [lj_conv_apply]
  refine integral_eq_zero_of_ae (Eventually.of_forall fun t => ?_)
  by_cases ht : ljBump n t = 0
  · simp [ht]
  · have ht2 : ‖t‖ < 2 := by
      by_contra h2; exact ht (ljBump_eq_zero (not_lt.1 h2))
    have : R < ‖x - t‖ := by
      have := norm_sub_norm_le x t
      linarith
    simp [h.eq_zero _ this]

/-- Translation estimate for `φ * g` through `g`:
`∫ |(φ * g)(x - z) - (φ * g)(x)| dx ≤ |z| D`. -/
theorem LjKernel.conv_translate_le {g : Rn n → ℂ} {R B D : ℝ} (h : LjKernel n g R B D)
    (z : Rn n) :
    ∫⁻ x, ‖(ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) (x - z) -
      (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x‖ₑ ≤ ENNReal.ofReal (‖z‖ * D) := by
  have heq : ∀ x, (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) (x - z) -
      (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x =
      ∫ t, ljBump n t * (g (x - t - z) - g (x - t)) := by
    intro x
    rw [lj_conv_apply, lj_conv_apply, ← integral_sub (h.integrable_bump_mul _)
      (h.integrable_bump_mul _)]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [sub_right_comm x z t]
    ring
  simp_rw [heq]
  have hm : Measurable (Function.uncurry fun x t : Rn n =>
      ljBump n t * (g (x - t - z) - g (x - t))) := by
    have hb := (contDiff_ljBump n).continuous
    have hg := h.continuous
    exact (by fun_prop : Continuous fun p : Rn n × Rn n =>
      ljBump n p.2 * (g (p.1 - p.2 - z) - g (p.1 - p.2))).measurable
  refine (lj_lintegral_enorm_integral_le hm).trans ?_
  calc ∫⁻ t, ∫⁻ x, ‖ljBump n t * (g (x - t - z) - g (x - t))‖ₑ
      = ∫⁻ t, ‖ljBump n t‖ₑ * ∫⁻ x, ‖g (x - z) - g x‖ₑ := by
        refine lintegral_congr fun t => ?_
        simp_rw [enorm_mul]
        rw [lintegral_const_mul' _ _ enorm_ne_top]
        congr 1
        exact lintegral_sub_right_eq_self (fun x => ‖g (x - z) - g x‖ₑ) t
    _ ≤ ∫⁻ t, ‖ljBump n t‖ₑ * ENNReal.ofReal (‖z‖ * D) :=
        lintegral_mono fun t => mul_le_mul_of_nonneg_left (h.translate_le z) zero_le
    _ = ENNReal.ofReal (‖z‖ * D) := by
        rw [lintegral_mul_const' _ _ ENNReal.ofReal_ne_top, lintegral_ljBump, one_mul]

/-- Translation estimate for `φ * g` through `φ`:
`∫ |(φ * g)(x - z) - (φ * g)(x)| dx ≤ |z| D_φ B`. -/
theorem LjKernel.conv_translate_le' {g : Rn n → ℂ} {R B D : ℝ} (h : LjKernel n g R B D)
    (_hB : 0 ≤ B) (z : Rn n) :
    ∫⁻ x, ‖(ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) (x - z) -
      (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x‖ₑ ≤
        ENNReal.ofReal (‖z‖ * (ljBumpD n * B)) := by
  have heq : ∀ x, (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) (x - z) -
      (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x =
      ∫ s, (ljBump n (x - s - z) - ljBump n (x - s)) * g s := by
    intro x
    rw [lj_conv_apply_swap, lj_conv_apply_swap, ← integral_sub (h.integrable_mul_bump _)
      (h.integrable_mul_bump _)]
    refine integral_congr_ae (Eventually.of_forall fun s => ?_)
    simp only [sub_right_comm x z s]
    ring
  simp_rw [heq]
  have hm : Measurable (Function.uncurry fun x s : Rn n =>
      (ljBump n (x - s - z) - ljBump n (x - s)) * g s) := by
    have hb := (contDiff_ljBump n).continuous
    have hg := h.continuous
    exact (by fun_prop : Continuous fun p : Rn n × Rn n =>
      (ljBump n (p.1 - p.2 - z) - ljBump n (p.1 - p.2)) * g p.2).measurable
  refine (lj_lintegral_enorm_integral_le hm).trans ?_
  have hφ := (ljKernel_ljBump n).translate_le z
  calc ∫⁻ s, ∫⁻ x, ‖(ljBump n (x - s - z) - ljBump n (x - s)) * g s‖ₑ
      = ∫⁻ s, (∫⁻ x, ‖ljBump n (x - z) - ljBump n x‖ₑ) * ‖g s‖ₑ := by
        refine lintegral_congr fun s => ?_
        simp_rw [enorm_mul]
        rw [lintegral_mul_const' _ _ enorm_ne_top]
        congr 1
        exact lintegral_sub_right_eq_self (fun x => ‖ljBump n (x - z) - ljBump n x‖ₑ) s
    _ ≤ ∫⁻ s, ENNReal.ofReal (‖z‖ * ljBumpD n) * ‖g s‖ₑ :=
        lintegral_mono fun s => mul_le_mul_of_nonneg_right hφ zero_le
    _ = ENNReal.ofReal (‖z‖ * ljBumpD n) * ∫⁻ s, ‖g s‖ₑ :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal (‖z‖ * ljBumpD n) * ENNReal.ofReal B := by gcongr; exact h.lintegral_le
    _ = ENNReal.ofReal (‖z‖ * (ljBumpD n * B)) := by
        rw [← ENNReal.ofReal_mul (mul_nonneg (norm_nonneg _) ljBumpD_nonneg)]; ring_nf

/-- **`φ * g` for mean-zero `g`** belongs to the kernel class with `R' = 2 + R`,
`B₀ = R D_φ B` and `D' = D_φ B` (the `L¹` bound uses `∫ g = 0`:
`(φ * g)(x) = ∫ (φ(x - s) - φ(x)) g(s) ds`). -/
theorem LjKernel.conv_meanZero {g : Rn n → ℂ} {R B D : ℝ} (h : LjKernel n g R B D)
    (hR : 0 ≤ R) (hB : 0 ≤ B) (hmean : ∫ x, g x = 0) :
    LjKernel n (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) (2 + R)
      (R * ljBumpD n * B) (ljBumpD n * B) := by
  refine ⟨h.continuous_conv, fun x hx => h.conv_eq_zero x hx, ?_, h.conv_translate_le' hB⟩
  have heq : ∀ x, (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x =
      ∫ s, (ljBump n (x - s) - ljBump n x) * g s := by
    intro x
    rw [lj_conv_apply_swap]
    simp_rw [sub_mul]
    rw [integral_sub (h.integrable_mul_bump x) (h.integrable.const_mul _), integral_const_mul,
      hmean, mul_zero, sub_zero]
  simp_rw [heq]
  have hm : Measurable (Function.uncurry fun x s : Rn n =>
      (ljBump n (x - s) - ljBump n x) * g s) := by
    have hb := (contDiff_ljBump n).continuous
    have hg := h.continuous
    exact (by fun_prop : Continuous fun p : Rn n × Rn n =>
      (ljBump n (p.1 - p.2) - ljBump n p.1) * g p.2).measurable
  refine (lj_lintegral_enorm_integral_le hm).trans ?_
  calc ∫⁻ s, ∫⁻ x, ‖(ljBump n (x - s) - ljBump n x) * g s‖ₑ
      = ∫⁻ s, (∫⁻ x, ‖ljBump n (x - s) - ljBump n x‖ₑ) * ‖g s‖ₑ := by
        refine lintegral_congr fun s => ?_
        simp_rw [enorm_mul]
        rw [lintegral_mul_const' _ _ enorm_ne_top]
    _ ≤ ∫⁻ s, ENNReal.ofReal (R * ljBumpD n) * ‖g s‖ₑ := by
        refine lintegral_mono fun s => ?_
        by_cases hs : g s = 0
        · simp [hs]
        · gcongr
          refine ((ljKernel_ljBump n).translate_le s).trans (ENNReal.ofReal_le_ofReal ?_)
          have : ‖s‖ ≤ R := by
            by_contra h'; exact hs (h.eq_zero s (not_le.1 h'))
          exact mul_le_mul_of_nonneg_right this ljBumpD_nonneg
    _ = ENNReal.ofReal (R * ljBumpD n) * ∫⁻ s, ‖g s‖ₑ :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal (R * ljBumpD n) * ENNReal.ofReal B := by gcongr; exact h.lintegral_le
    _ = ENNReal.ofReal (R * ljBumpD n * B) := by
        rw [← ENNReal.ofReal_mul (mul_nonneg hR ljBumpD_nonneg)]

/-- **`φ * g - g`** belongs to the kernel class with `R' = 2 + R`, `B₀ = 2D`, `D' = 2D`
(the `L¹` bound uses `∫ φ = 1`: `(φ * g)(x) - g(x) = ∫ φ(t) (g(x - t) - g(x)) dt`). -/
theorem LjKernel.conv_sub {g : Rn n → ℂ} {R B D : ℝ} (h : LjKernel n g R B D) (_hR : 0 ≤ R)
    (hD : 0 ≤ D) :
    LjKernel n (fun x => (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x - g x) (2 + R)
      (2 * D) (2 * D) := by
  refine ⟨h.continuous_conv.sub h.continuous, fun x hx => ?_, ?_, fun z => ?_⟩
  · rw [h.conv_eq_zero x hx, h.eq_zero x (by linarith), sub_zero]
  · have heq : ∀ x, (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x - g x =
        ∫ t, ljBump n t * (g (x - t) - g x) := by
      intro x
      rw [lj_conv_apply]
      simp_rw [mul_sub]
      rw [integral_sub (h.integrable_bump_mul x) ((integrable_ljBump n).mul_const _),
        integral_mul_const, integral_ljBump, one_mul]
    simp_rw [heq]
    have hm : Measurable (Function.uncurry fun x t : Rn n =>
        ljBump n t * (g (x - t) - g x)) := by
      have hb := (contDiff_ljBump n).continuous
      have hg := h.continuous
      exact (by fun_prop : Continuous fun p : Rn n × Rn n =>
        ljBump n p.2 * (g (p.1 - p.2) - g p.1)).measurable
    refine (lj_lintegral_enorm_integral_le hm).trans ?_
    calc ∫⁻ t, ∫⁻ x, ‖ljBump n t * (g (x - t) - g x)‖ₑ
        = ∫⁻ t, ‖ljBump n t‖ₑ * ∫⁻ x, ‖g (x - t) - g x‖ₑ := by
          refine lintegral_congr fun t => ?_
          simp_rw [enorm_mul]
          rw [lintegral_const_mul' _ _ enorm_ne_top]
      _ ≤ ∫⁻ t, ‖ljBump n t‖ₑ * ENNReal.ofReal (2 * D) := by
          refine lintegral_mono fun t => ?_
          by_cases ht : ljBump n t = 0
          · simp [ht]
          · gcongr
            refine (h.translate_le t).trans (ENNReal.ofReal_le_ofReal ?_)
            have : ‖t‖ ≤ 2 := by
              by_contra h'; exact ht (ljBump_eq_zero (not_le.1 h').le)
            exact mul_le_mul_of_nonneg_right this hD
      _ = ENNReal.ofReal (2 * D) := by
          rw [lintegral_mul_const' _ _ ENNReal.ofReal_ne_top, lintegral_ljBump, one_mul]
  · calc ∫⁻ x, ‖((ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) (x - z) - g (x - z)) -
          ((ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x - g x)‖ₑ
        ≤ ∫⁻ x, (‖(ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) (x - z) -
            (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x‖ₑ + ‖g (x - z) - g x‖ₑ) := by
          refine lintegral_mono fun x => ?_
          rw [sub_sub_sub_comm]
          exact enorm_sub_le
      _ = (∫⁻ x, ‖(ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) (x - z) -
            (ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x‖ₑ) +
            ∫⁻ x, ‖g (x - z) - g x‖ₑ :=
          lintegral_add_right _ ((h.continuous.comp (continuous_id.sub continuous_const)).sub
            h.continuous).enorm.measurable
      _ ≤ ENNReal.ofReal (‖z‖ * D) + ENNReal.ofReal (‖z‖ * D) :=
          add_le_add (h.conv_translate_le z) (h.translate_le z)
      _ = ENNReal.ofReal (‖z‖ * (2 * D)) := by
          rw [← ENNReal.ofReal_add (by positivity) (by positivity)]; ring_nf

end BumpConvolution

section SmoothTruncationMultipliers

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- `𝓕(f - g) = 𝓕 f - 𝓕 g` for integrable `f`, `g`. -/
theorem lj_fourier_sub {f g : Rn n → ℂ} (hf : Integrable f) (hg : Integrable g) (η : Rn n) :
    𝓕 (fun x => f x - g x) η = 𝓕 f η - 𝓕 g η := by
  have hf' := (Real.fourierIntegral_convergent_iff (μ := volume) (w := η)).2 hf
  have hg' := (Real.fourierIntegral_convergent_iff (μ := volume) (w := η)).2 hg
  rw [Real.fourier_eq, Real.fourier_eq, Real.fourier_eq, ← integral_sub hf' hg']
  simp_rw [smul_sub]

/-- `min(y, y⁻¹)² ≤ y` for `y ≥ 0`. -/
theorem lj_min_inv_sq_le {y : ℝ} (hy : 0 ≤ y) : min y y⁻¹ ^ 2 ≤ y := by
  rcases le_or_gt y 1 with h | h
  · rw [lj_min_inv_of_le_one hy h]; nlinarith
  · rw [lj_min_inv_of_one_le h.le]
    have : y⁻¹ ^ 2 ≤ 1 := pow_le_one₀ (by positivity) (inv_le_one_of_one_le₀ h.le)
    linarith

/-- The Fourier constant `c_k = max(4π A₁, D₀/4)` of `k₀`: `|𝓕k₀(ζ)| ≤ c_k min(|ζ|, |ζ|⁻¹)`. -/
noncomputable def ljCk (n : ℕ) (Ω : Rn n → ℝ) : ℝ :=
  max (2 * π * 2 * ljA1 n Ω) (ljD0 n Ω / 4)

/-- `c_k ≥ 0`. -/
theorem ljCk_nonneg : 0 ≤ ljCk n Ω :=
  le_max_of_le_right (div_nonneg ljD0_nonneg (by norm_num))

/-- `|𝓕k₀(ζ)| ≤ c_k min(|ζ|, |ζ|⁻¹)` (mean zero and smoothness of `k₀`). -/
theorem IsHomogeneousCZKernel.norm_fourier_ljAmp_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) (ζ : Rn n) : ‖𝓕 (ljAmp n Ω) ζ‖ ≤ ljCk n Ω * min ‖ζ‖ ‖ζ‖⁻¹ :=
  hΩ.ljKernel_ljAmp.norm_fourier_le (by norm_num) ljA1_nonneg ljD0_nonneg
    (hΩ.integral_ljAmp hn) ζ

/-- The smooth dyadic piece `k_m = φ_m K = 2^{-mn} k₀(2^{-m} ·)` at scale `2^m`. -/
noncomputable def ljPiece (n : ℕ) (Ω : Rn n → ℝ) (m : ℤ) : Rn n → ℂ :=
  lpDilate n (ljAmp n Ω) (-m)

/-- `𝓕k_m(η) = 𝓕k₀(2^m η)`. -/
theorem fourier_ljPiece (m : ℤ) (η : Rn n) :
    𝓕 (ljPiece n Ω m) η = 𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η) := by
  rw [ljPiece, fourier_lpDilate, zpow_neg, inv_inv]

/-- `k_m` belongs to the kernel class with `R = 2^m · 2`, `B₀ = A₁`, `D = 2^{-m} D₀`. -/
theorem IsHomogeneousCZKernel.ljKernel_ljPiece (hΩ : IsHomogeneousCZKernel n Ω) (m : ℤ) :
    LjKernel n (ljPiece n Ω m) ((2 : ℝ) ^ m * 2) (ljA1 n Ω) ((2 : ℝ) ^ (-m) * ljD0 n Ω) := by
  have h := hΩ.ljKernel_ljAmp.dilate (-m)
  rwa [neg_neg] at h

/-- `∫ k_m = 0`. -/
theorem IsHomogeneousCZKernel.integral_ljPiece (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    (m : ℤ) : ∫ x, ljPiece n Ω m x = 0 := by
  rw [ljPiece, integral_lpDilate, hΩ.integral_ljAmp hn]

/-- `|𝓕φ| ≤ 1`. -/
theorem norm_fourier_ljBump_le (η : Rn n) : ‖𝓕 (ljBump n) η‖ ≤ 1 := by
  refine (lj_norm_fourier_le_integral_norm _ η).trans (le_of_eq ?_)
  have := lintegral_ljBump n
  rw [← ofReal_integral_norm_eq_lintegral_enorm (integrable_ljBump n)] at this
  have h0 : 0 ≤ ∫ t, ‖ljBump n t‖ := integral_nonneg fun _ => norm_nonneg _
  rw [← ENNReal.ofReal_one] at this
  exact (ENNReal.ofReal_eq_ofReal_iff h0 zero_le_one).1 this

/-- `|𝓕φ(η) - 1| ≤ 4π|η|` (since `∫ φ = 1`, `∫|φ| = 1` and `supp φ ⊆ B(0, 2)`). -/
theorem norm_fourier_ljBump_sub_one_le (η : Rn n) : ‖𝓕 (ljBump n) η - 1‖ ≤ 4 * π * ‖η‖ := by
  have h := lj_norm_fourier_sub_integral_le (integrable_ljBump n) (R := 2)
    (fun x hx => ljBump_eq_zero hx.le) η
  rw [integral_ljBump] at h
  have h1 : ∫ x, ‖ljBump n x‖ = 1 := by
    have := lintegral_ljBump n
    rw [← ofReal_integral_norm_eq_lintegral_enorm (integrable_ljBump n), ← ENNReal.ofReal_one]
      at this
    exact (ENNReal.ofReal_eq_ofReal_iff (integral_nonneg fun _ => norm_nonneg _)
      zero_le_one).1 this
  rw [h1] at h
  linarith

/-- The convolution `χ_m = φ * k_m` of the bump with the dyadic piece. -/
noncomputable def ljConv (n : ℕ) (Ω : Rn n → ℝ) (m : ℤ) : Rn n → ℂ :=
  ljBump n ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] ljPiece n Ω m

/-- `𝓕χ_m(η) = 𝓕φ(η) 𝓕k₀(2^m η)`. -/
theorem IsHomogeneousCZKernel.fourier_ljConv (hΩ : IsHomogeneousCZKernel n Ω) (m : ℤ)
    (η : Rn n) :
    𝓕 (ljConv n Ω m) η = 𝓕 (ljBump n) η * 𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η) := by
  rw [ljConv, Real.fourier_mul_convolution_eq (integrable_ljBump n)
    (hΩ.ljKernel_ljPiece m).integrable, fourier_ljPiece]

/-- **Multiplier bound for `φ * k_m`, `m ≤ 0`** (the paper's `|Ŝ(2^{-k}ξ) m(2^{...}ξ)|`
bounds): `|𝓕χ_m(η)|² ≤ c 2^m min(|η|, |η|⁻¹)`. -/
theorem IsHomogeneousCZKernel.norm_fourier_ljConv_sq_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {m : ℤ} (hm : m ≤ 0) (η : Rn n) :
    ‖𝓕 (ljConv n Ω m) η‖ ^ 2 ≤
      ljCk n Ω ^ 2 * max 1 ((ljBumpD n / 4) ^ 2) * (2 : ℝ) ^ m * min ‖η‖ ‖η‖⁻¹ := by
  set μ : ℝ := (2 : ℝ) ^ m with hμ
  have hμ0 : 0 < μ := zpow_pos two_pos m
  have hμ1 : μ ≤ 1 := zpow_le_one_of_nonpos₀ one_le_two hm
  set x := ‖η‖ with hx
  have hζ : ‖(2 : ℝ) ^ m • η‖ = μ * x := by rw [norm_smul, Real.norm_of_nonneg hμ0.le]
  have hk := hΩ.norm_fourier_ljAmp_le hn ((2 : ℝ) ^ m • η)
  rw [hζ] at hk
  have hck := ljCk_nonneg (n := n) (Ω := Ω)
  have hM1 : 1 ≤ max 1 ((ljBumpD n / 4) ^ 2) := le_max_left _ _
  have hM2 : (ljBumpD n / 4) ^ 2 ≤ max 1 ((ljBumpD n / 4) ^ 2) := le_max_right _ _
  rw [hΩ.fourier_ljConv, norm_mul, mul_pow]
  have hφ1 := norm_fourier_ljBump_le (n := n) η
  rcases le_or_gt x 1 with hx1 | hx1
  · rw [lj_min_inv_of_le_one (norm_nonneg η) hx1]
    have hk' : ‖𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η)‖ ≤ ljCk n Ω * (μ * x) :=
      hk.trans (by gcongr; exact min_le_left _ _)
    have hμx : μ * x ≤ 1 := by nlinarith [norm_nonneg η]
    calc ‖𝓕 (ljBump n) η‖ ^ 2 * ‖𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η)‖ ^ 2
        ≤ 1 ^ 2 * (ljCk n Ω * (μ * x)) ^ 2 := by gcongr
      _ = ljCk n Ω ^ 2 * (μ * x) * (μ * x) := by ring
      _ ≤ ljCk n Ω ^ 2 * (μ * x) * 1 := by gcongr
      _ ≤ ljCk n Ω ^ 2 * max 1 ((ljBumpD n / 4) ^ 2) * μ * x := by
          have : 0 ≤ ljCk n Ω ^ 2 * (μ * x) := by positivity
          nlinarith
  · rw [lj_min_inv_of_one_le hx1.le]
    have hx0 : 0 < x := by linarith
    have hφ2 : ‖𝓕 (ljBump n) η‖ ≤ ljBumpD n / 4 * x⁻¹ := by
      have h := lj_norm_fourier_mul_le (integrable_ljBump n) ljBumpD_nonneg
        (ljKernel_ljBump n).translate_le η
      rw [← hx] at h
      calc ‖𝓕 (ljBump n) η‖ = ‖𝓕 (ljBump n) η‖ * (4 * x) / (4 * x) := by field_simp
        _ ≤ ljBumpD n / (4 * x) := by gcongr
        _ = ljBumpD n / 4 * x⁻¹ := by field_simp
    have hk2 : ‖𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η)‖ ^ 2 ≤ ljCk n Ω ^ 2 * (μ * x) := by
      calc ‖𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η)‖ ^ 2 ≤ (ljCk n Ω * min (μ * x) (μ * x)⁻¹) ^ 2 :=
            pow_le_pow_left₀ (norm_nonneg _) hk 2
        _ = ljCk n Ω ^ 2 * min (μ * x) (μ * x)⁻¹ ^ 2 := by ring
        _ ≤ ljCk n Ω ^ 2 * (μ * x) := by gcongr; exact lj_min_inv_sq_le (by positivity)
    calc ‖𝓕 (ljBump n) η‖ ^ 2 * ‖𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η)‖ ^ 2
        ≤ (ljBumpD n / 4 * x⁻¹) ^ 2 * (ljCk n Ω ^ 2 * (μ * x)) := by gcongr
      _ = ljCk n Ω ^ 2 * (ljBumpD n / 4) ^ 2 * μ * x⁻¹ := by field_simp
      _ ≤ ljCk n Ω ^ 2 * max 1 ((ljBumpD n / 4) ^ 2) * μ * x⁻¹ := by gcongr

/-- **Multiplier bound for `φ * k_m - k_m`, `m ≥ 0`**: with `ρ = 2^{-m}`,
`|𝓕(χ_m - k_m)(η)|² ≤ 16π² c_k² 2^{-m} min(|η|/ρ, ρ/|η|)`. -/
theorem IsHomogeneousCZKernel.norm_fourier_ljConv_sub_sq_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {m : ℤ} (hm : 0 ≤ m) (η : Rn n) :
    ‖𝓕 (fun x => ljConv n Ω m x - ljPiece n Ω m x) η‖ ^ 2 ≤
      16 * π ^ 2 * ljCk n Ω ^ 2 * (2 : ℝ) ^ (-m) *
        min (‖η‖ / (2 : ℝ) ^ (-m)) (‖η‖ / (2 : ℝ) ^ (-m))⁻¹ := by
  have hint : Integrable (ljConv n Ω m) := by
    have := ((hΩ.ljKernel_ljPiece m).conv_meanZero (by positivity) ljA1_nonneg
      (hΩ.integral_ljPiece hn m)).integrable
    exact this
  rw [lj_fourier_sub hint (hΩ.ljKernel_ljPiece m).integrable, hΩ.fourier_ljConv,
    fourier_ljPiece, ← sub_one_mul, norm_mul, mul_pow]
  set ρ : ℝ := (2 : ℝ) ^ (-m) with hρ
  have hρ0 : 0 < ρ := zpow_pos two_pos _
  have hρ1 : ρ ≤ 1 := zpow_le_one_of_nonpos₀ one_le_two (by omega)
  set ζ := ‖η‖ / ρ with hζdef
  have hζ : ‖(2 : ℝ) ^ m • η‖ = ζ := by
    rw [norm_smul, Real.norm_of_nonneg (by positivity), hζdef, hρ, zpow_neg, div_inv_eq_mul,
      mul_comm]
  have hx : ‖η‖ = ρ * ζ := by rw [hζdef]; field_simp
  have hk := hΩ.norm_fourier_ljAmp_le hn ((2 : ℝ) ^ m • η)
  rw [hζ] at hk
  have hck := ljCk_nonneg (n := n) (Ω := Ω)
  have hζ0 : 0 ≤ ζ := by positivity
  have hφa := norm_fourier_ljBump_sub_one_le (n := n) η
  have hφb : ‖𝓕 (ljBump n) η - 1‖ ≤ 2 :=
    (norm_sub_le _ _).trans (by rw [norm_one]; linarith [norm_fourier_ljBump_le (n := n) η])
  rw [hx] at hφa
  rcases le_or_gt ζ 1 with hz1 | hz1
  · rw [lj_min_inv_of_le_one hζ0 hz1] at hk ⊢
    calc ‖𝓕 (ljBump n) η - 1‖ ^ 2 * ‖𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η)‖ ^ 2
        ≤ (4 * π * (ρ * ζ)) ^ 2 * (ljCk n Ω * ζ) ^ 2 := by gcongr
      _ = 16 * π ^ 2 * ljCk n Ω ^ 2 * ρ * ζ * (ρ * ζ ^ 3) := by ring
      _ ≤ 16 * π ^ 2 * ljCk n Ω ^ 2 * ρ * ζ * 1 := by
          gcongr
          calc ρ * ζ ^ 3 ≤ 1 * 1 := by
                gcongr
                · exact pow_le_one₀ hζ0 hz1
            _ = 1 := by ring
      _ = 16 * π ^ 2 * ljCk n Ω ^ 2 * ρ * ζ := by ring
  · rw [lj_min_inv_of_one_le hz1.le] at hk ⊢
    have hmin : min (4 * π * (ρ * ζ)) 2 ^ 2 ≤ 4 * π * (ρ * ζ) * 2 := by
      rw [sq]
      exact mul_le_mul (min_le_left _ _) (min_le_right _ _) (le_min (by positivity)
        (by norm_num)) (by positivity)
    have hφ : ‖𝓕 (ljBump n) η - 1‖ ^ 2 ≤ 4 * π * (ρ * ζ) * 2 :=
      (pow_le_pow_left₀ (norm_nonneg _) (le_min hφa hφb) 2).trans hmin
    have hζp : 0 < ζ := by linarith
    calc ‖𝓕 (ljBump n) η - 1‖ ^ 2 * ‖𝓕 (ljAmp n Ω) ((2 : ℝ) ^ m • η)‖ ^ 2
        ≤ (4 * π * (ρ * ζ) * 2) * (ljCk n Ω * ζ⁻¹) ^ 2 := by gcongr
      _ = 8 * π * ljCk n Ω ^ 2 * ρ * ζ⁻¹ := by field_simp; ring
      _ ≤ 16 * π ^ 2 * ljCk n Ω ^ 2 * ρ * ζ⁻¹ := by
          have : π ≤ π ^ 2 := by nlinarith [Real.pi_gt_three]
          have h8 : 8 * π ≤ 16 * π ^ 2 := by linarith [sq_nonneg π]
          gcongr

end SmoothTruncationMultipliers

section SquareFunctionsDecay

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- Dilates compose: `(ψ_a)_b = ψ_{a+b}`. -/
theorem lpDilate_lpDilate (ψ : Rn n → ℂ) (a b : ℤ) :
    lpDilate n (lpDilate n ψ a) b = lpDilate n ψ (a + b) := by
  funext x
  simp only [lpDilate_apply_ofReal, smul_smul, ← mul_assoc, ← Complex.ofReal_mul]
  congr 2
  · rw [← zpow_add₀ two_ne_zero]; congr 1; ring
  · rw [← zpow_add₀ two_ne_zero, add_comm]

/-- Dilation is linear in the kernel: `(ψ₁ + ψ₂)_j = (ψ₁)_j + (ψ₂)_j`. -/
theorem lpDilate_add (ψ₁ ψ₂ : Rn n → ℂ) (j : ℤ) :
    lpDilate n (fun x => ψ₁ x + ψ₂ x) j = fun x => lpDilate n ψ₁ j x + lpDilate n ψ₂ j x := by
  funext x; simp only [lpDilate]; ring

/-- Dilation is linear in the kernel: `(ψ₁ - ψ₂)_j = (ψ₁)_j - (ψ₂)_j`. -/
theorem lpDilate_sub (ψ₁ ψ₂ : Rn n → ℂ) (j : ℤ) :
    lpDilate n (fun x => ψ₁ x - ψ₂ x) j = fun x => lpDilate n ψ₁ j x - lpDilate n ψ₂ j x := by
  funext x; simp only [lpDilate]; ring

/-- The `[0, ∞]`-valued square function `(∑_{j ∈ ℤ} |ψ_j * f(x)|²)^{1/2}` of the dyadic dilates
of a kernel `ψ`. -/
noncomputable def ljSq (n : ℕ) (ψ : Rn n → ℂ) (f : Rn n → ℂ) (x : Rn n) : ℝ≥0∞ :=
  (∑' j : ℤ, ‖∫ y, lpDilate n ψ j (x - y) * f y‖ₑ ^ 2) ^ (1 / 2 : ℝ)

/-- The square function is invariant under dilation of the kernel. -/
theorem ljSq_lpDilate (ψ : Rn n → ℂ) (k : ℤ) (f : Rn n → ℂ) :
    ljSq n (lpDilate n ψ k) f = ljSq n ψ f := by
  funext x
  simp only [ljSq, lpDilate_lpDilate]
  congr 1
  exact (Equiv.addLeft k).tsum_eq fun j => ‖∫ y, lpDilate n ψ j (x - y) * f y‖ₑ ^ 2

/-- Convolutions of integrable kernels with `L^p` functions (`p ≥ 1`) are a.e. measurable. -/
theorem lj_aemeasurable_conv {ψ : Rn n → ℂ} (hψ : Integrable ψ) {p : ℝ} (hp : 1 ≤ p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) :
    AEMeasurable fun x => ∫ y, ψ (x - y) * f y := by
  have hp' : 1 ≤ ENNReal.ofReal p := by simpa using hp
  have := (memLp_convolution_of_memLp hp' (memLp_one_iff_integrable.2 hψ) hf).aestronglyMeasurable
  refine (this.congr (Eventually.of_forall fun x => ?_)).aemeasurable
  exact convolution_eq_integral_sub _ _ x

/-- The square function `ljSq` of an integrable kernel and `f ∈ L^p` is a.e. measurable. -/
theorem lj_aemeasurable_ljSq {ψ : Rn n → ℂ} (hψ : Integrable ψ) {p : ℝ} (hp : 1 ≤ p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) : AEMeasurable (ljSq n ψ f) := by
  unfold ljSq
  refine (AEMeasurable.tsum fun j => ?_).pow_const _
  exact (lj_aemeasurable_conv (integrable_lpDilate hψ j) hp hf).enorm.pow_const 2

/-- **Square function bound for kernels of the class** (`L^p`, `1 < p < ∞`, via
Benedek–Calderón–Panzone), in the `[0, ∞]`-valued form `ljSq`. -/
theorem lj_eLpNorm_ljSq_le (hn : 0 < n) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ψ : Rn n → ℂ) (R B₀ D c ρ δ : ℝ), LjKernel n ψ R B₀ D → 0 < R →
      0 ≤ B₀ → 0 ≤ D → 0 ≤ c → 0 < ρ → 0 < δ → δ ≤ 1 →
      (∀ η, ‖𝓕 ψ η‖ ^ 2 ≤ c * (min ‖η‖ ‖η‖⁻¹ + min (‖η‖ / ρ) (‖η‖ / ρ)⁻¹)) →
      ∀ f : Rn n → ℂ, MemLp f (ENNReal.ofReal p) volume →
        eLpNorm (ljSq n ψ f) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * max √c ((2 * B₀) ^ (1 - δ) * (D * R) ^ δ * ljGeom δ)) *
          eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC, h⟩ := lj_eLpNorm_sqFun_le hn hp
  refine ⟨C, hC, fun ψ R B₀ D c ρ δ hψ hR hB hD hc hρ hδ0 hδ1 hF f hf => ?_⟩
  exact lj_eLpNorm_tsum_sq_le
    (fun j => lj_aemeasurable_conv (integrable_lpDilate hψ.integrable j) hp.le hf)
    (by linarith) fun s => h ψ R B₀ D c ρ δ hψ hR hB hD hc hρ hδ0 hδ1 hF s f hf

/-- **Square functions for `q̃_λ - k₀` with decay** (`0 ≤ λ ≤ 1`; the pieces `(e^{iu|t|^α} - 1)
φ_ℓ K` with `u |t|^α ≲ 1`): `‖(∑_j |(q̃_λ - k₀)_j * f|²)^{1/2}‖_p ≤ C λ ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_ljSq_osc_sub_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ lam : ℝ, 0 ≤ lam → ∀ f : Rn n → ℂ, MemLp f (ENNReal.ofReal p) volume →
      eLpNorm (ljSq n (fun t => ljOsc n α Ω lam t - ljAmp n Ω t) f) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * lam) * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C₀, hC₀, h⟩ := lj_eLpNorm_ljSq_le (by omega : 0 < n) hp
  have hA := ljA1_nonneg (n := n) (Ω := Ω)
  have hD0 := ljD0_nonneg (n := n) (Ω := Ω)
  have hα0 : 0 < α := by linarith
  set Dc := 3 ^ α * ljD0 n Ω + α * 3 ^ (α - 1) * ljA1 n Ω + 2 * 3 ^ α * ljA1 n Ω with hDc
  have hDc0 : 0 ≤ Dc := by positivity
  set M₁ := max (2 * π * 2 * (3 ^ α * ljA1 n Ω)) (Dc / 4) with hM₁
  have hM₁0 : 0 ≤ M₁ := le_max_of_le_right (by positivity)
  have hG := ljGeom_nonneg 1
  refine ⟨C₀ * max M₁ (Dc * 2 * ljGeom 1), by positivity, fun lam hlam f hf => ?_⟩
  have hk := hΩ.ljKernel_ljOsc_sub hα lam
  rw [abs_of_nonneg hlam] at hk
  have hk' : LjKernel n (fun t => ljOsc n α Ω lam t - ljAmp n Ω t) 2
      (lam * (3 ^ α * ljA1 n Ω)) (lam * Dc) := by
    convert hk using 1 <;> ring
  have hmean : ∫ t, (ljOsc n α Ω lam t - ljAmp n Ω t) = 0 := by
    rw [integral_sub (hΩ.integrable_ljOsc α lam) hΩ.integrable_ljAmp, hΩ.integral_ljOsc hn,
      hΩ.integral_ljAmp hn, sub_zero]
  have hF := hk'.norm_fourier_sq_le (by norm_num) (by positivity) (by positivity) hmean 1 one_pos
  have hmax : max (2 * π * 2 * (lam * (3 ^ α * ljA1 n Ω))) (lam * Dc / 4) = lam * M₁ := by
    rw [hM₁, mul_max_of_nonneg _ _ hlam]; ring_nf
  rw [hmax] at hF
  refine (h _ 2 _ _ _ 1 1 hk' two_pos (by positivity) (by positivity) (by positivity) one_pos
    one_pos le_rfl hF f hf).trans ?_
  refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal (le_of_eq ?_)) zero_le
  rw [Real.sqrt_sq (by positivity), sub_self, Real.rpow_zero, one_mul, Real.rpow_one]
  calc C₀ * max (lam * M₁) (lam * Dc * 2 * ljGeom 1)
      = C₀ * (lam * max M₁ (Dc * 2 * ljGeom 1)) := by
        rw [show lam * Dc * 2 * ljGeom 1 = lam * (Dc * 2 * ljGeom 1) by ring,
          ← mul_max_of_nonneg M₁ (Dc * 2 * ljGeom 1) hlam]
    _ = C₀ * max M₁ (Dc * 2 * ljGeom 1) * lam := by ring

/-- `x^{1 - 1/2} y^{1/2} = √x √y`. -/
theorem lj_rpow_half_mul (x y : ℝ) :
    x ^ (1 - 1 / 2 : ℝ) * y ^ (1 / 2 : ℝ) = √x * √y := by
  rw [show (1 - 1 / 2 : ℝ) = 1 / 2 by norm_num, Real.sqrt_eq_rpow, Real.sqrt_eq_rpow]

/-- **Square functions for `φ * k_m`, `m ≤ 0`, with decay**:
`‖(∑_j |(φ * k_m)_j * f|²)^{1/2}‖_p ≤ C 2^{m/2} ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_ljSq_conv_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ m : ℤ, m ≤ 0 → ∀ f : Rn n → ℂ, MemLp f (ENNReal.ofReal p) volume →
      eLpNorm (ljSq n (ljConv n Ω m) f) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * √((2 : ℝ) ^ m)) * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C₀, hC₀, h⟩ := lj_eLpNorm_ljSq_le (by omega : 0 < n) hp
  have hA := ljA1_nonneg (n := n) (Ω := Ω)
  have hDφ := ljBumpD_nonneg (n := n)
  have hck := ljCk_nonneg (n := n) (Ω := Ω)
  have hG := ljGeom_nonneg (1 / 2)
  set Mφ := max 1 ((ljBumpD n / 4) ^ 2) with hMφ
  have hMφ0 : 0 ≤ Mφ := le_max_of_le_left zero_le_one
  set K := max (ljCk n Ω * √Mφ) (4 * (ljBumpD n * ljA1 n Ω) * ljGeom (1 / 2)) with hK
  refine ⟨C₀ * K, mul_nonneg hC₀ (le_max_of_le_left (by positivity)), fun m hm f hf => ?_⟩
  have h2m : (0 : ℝ) < 2 ^ m := zpow_pos two_pos m
  have h2m1 : (2 : ℝ) ^ m ≤ 1 := zpow_le_one_of_nonpos₀ one_le_two hm
  have hk := (hΩ.ljKernel_ljPiece m).conv_meanZero (by positivity) hA (hΩ.integral_ljPiece hn m)
  set c := ljCk n Ω ^ 2 * Mφ * (2 : ℝ) ^ m with hc
  have hF : ∀ η : Rn n, ‖𝓕 (ljConv n Ω m) η‖ ^ 2 ≤
      c * (min ‖η‖ ‖η‖⁻¹ + min (‖η‖ / 1) (‖η‖ / 1)⁻¹) := by
    intro η
    refine (hΩ.norm_fourier_ljConv_sq_le hn hm η).trans ?_
    have : 0 ≤ min (‖η‖ / 1) (‖η‖ / 1)⁻¹ := lj_min_inv_nonneg (by positivity)
    have hc0 : 0 ≤ c := by positivity
    nlinarith
  refine (h _ _ _ _ c 1 (1 / 2) hk (by positivity) (by positivity) (by positivity)
    (by positivity) one_pos (by norm_num) (by norm_num) hF f hf).trans ?_
  refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) zero_le
  rw [mul_assoc C₀]
  refine mul_le_mul_of_nonneg_left ?_ hC₀
  rw [lj_rpow_half_mul]
  refine max_le ?_ ?_
  · calc √c = ljCk n Ω * √Mφ * √((2 : ℝ) ^ m) := by
          rw [hc, Real.sqrt_mul (by positivity), Real.sqrt_mul (by positivity),
            Real.sqrt_sq hck]
      _ ≤ K * √((2 : ℝ) ^ m) := by gcongr; exact le_max_left _ _
  · have e1 : √(2 * ((2 : ℝ) ^ m * 2 * ljBumpD n * ljA1 n Ω)) =
        √((2 : ℝ) ^ m) * √(4 * (ljBumpD n * ljA1 n Ω)) := by
      rw [← Real.sqrt_mul h2m.le]; congr 1; ring
    have e2 : √(ljBumpD n * ljA1 n Ω * (2 + (2 : ℝ) ^ m * 2)) ≤
        √(4 * (ljBumpD n * ljA1 n Ω)) := by
      refine Real.sqrt_le_sqrt ?_
      have : 0 ≤ ljBumpD n * ljA1 n Ω := by positivity
      nlinarith
    calc √(2 * ((2 : ℝ) ^ m * 2 * ljBumpD n * ljA1 n Ω)) *
          √(ljBumpD n * ljA1 n Ω * (2 + (2 : ℝ) ^ m * 2)) * ljGeom (1 / 2)
        ≤ √((2 : ℝ) ^ m) * √(4 * (ljBumpD n * ljA1 n Ω)) *
            √(4 * (ljBumpD n * ljA1 n Ω)) * ljGeom (1 / 2) := by
          rw [e1]; gcongr
      _ = (4 * (ljBumpD n * ljA1 n Ω) * ljGeom (1 / 2)) * √((2 : ℝ) ^ m) := by
          rw [mul_assoc (√((2 : ℝ) ^ m)), Real.mul_self_sqrt (by positivity)]; ring
      _ ≤ K * √((2 : ℝ) ^ m) := by gcongr; exact le_max_right _ _

/-- **Square functions for `φ * k_m - k_m`, `m ≥ 0`, with decay**:
`‖(∑_j |(φ * k_m - k_m)_j * f|²)^{1/2}‖_p ≤ C 2^{-m/2} ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_ljSq_conv_sub_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ m : ℤ, 0 ≤ m → ∀ f : Rn n → ℂ, MemLp f (ENNReal.ofReal p) volume →
      eLpNorm (ljSq n (fun x => ljConv n Ω m x - ljPiece n Ω m x) f) (ENNReal.ofReal p)
        volume ≤ ENNReal.ofReal (C * √((2 : ℝ) ^ (-m))) * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C₀, hC₀, h⟩ := lj_eLpNorm_ljSq_le (by omega : 0 < n) hp
  have hD := ljD0_nonneg (n := n) (Ω := Ω)
  have hck := ljCk_nonneg (n := n) (Ω := Ω)
  have hG := ljGeom_nonneg (1 / 2)
  set K := max (4 * π * ljCk n Ω) (√(4 * ljD0 n Ω) * √(8 * ljD0 n Ω) * ljGeom (1 / 2)) with hK
  refine ⟨C₀ * K, mul_nonneg hC₀ (le_max_of_le_left (by positivity)), fun m hm f hf => ?_⟩
  have h2m : (0 : ℝ) < 2 ^ (-m) := zpow_pos two_pos _
  have h2m1 : (2 : ℝ) ^ (-m) ≤ 1 := zpow_le_one_of_nonpos₀ one_le_two (by omega)
  have h2mm : (2 : ℝ) ^ (-m) * (2 : ℝ) ^ m = 1 := by
    rw [← zpow_add₀ two_ne_zero]; simp
  have hk := (hΩ.ljKernel_ljPiece m).conv_sub (by positivity) (by positivity)
  set c := 16 * π ^ 2 * ljCk n Ω ^ 2 * (2 : ℝ) ^ (-m) with hc
  have hF : ∀ η : Rn n, ‖𝓕 (fun x => ljConv n Ω m x - ljPiece n Ω m x) η‖ ^ 2 ≤
      c * (min ‖η‖ ‖η‖⁻¹ + min (‖η‖ / (2 : ℝ) ^ (-m)) (‖η‖ / (2 : ℝ) ^ (-m))⁻¹) := by
    intro η
    refine (hΩ.norm_fourier_ljConv_sub_sq_le hn hm η).trans ?_
    have : 0 ≤ min ‖η‖ ‖η‖⁻¹ := lj_min_inv_nonneg (norm_nonneg _)
    have hc0 : 0 ≤ c := by positivity
    nlinarith
  refine (h _ _ _ _ c _ (1 / 2) hk (by positivity) (by positivity) (by positivity)
    (by positivity) h2m (by norm_num) (by norm_num) hF f hf).trans ?_
  refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) zero_le
  rw [mul_assoc C₀]
  refine mul_le_mul_of_nonneg_left ?_ hC₀
  rw [lj_rpow_half_mul]
  refine max_le ?_ ?_
  · calc √c = 4 * π * ljCk n Ω * √((2 : ℝ) ^ (-m)) := by
          rw [hc, Real.sqrt_mul (by positivity),
            show 16 * π ^ 2 * ljCk n Ω ^ 2 = (4 * π * ljCk n Ω) ^ 2 by ring,
            Real.sqrt_sq (by positivity)]
      _ ≤ K * √((2 : ℝ) ^ (-m)) := by gcongr; exact le_max_left _ _
  · have e1 : √(2 * (2 * ((2 : ℝ) ^ (-m) * ljD0 n Ω))) =
        √((2 : ℝ) ^ (-m)) * √(4 * ljD0 n Ω) := by
      rw [← Real.sqrt_mul h2m.le]; congr 1; ring
    have e2 : √(2 * ((2 : ℝ) ^ (-m) * ljD0 n Ω) * (2 + (2 : ℝ) ^ m * 2)) ≤
        √(8 * ljD0 n Ω) := by
      refine Real.sqrt_le_sqrt ?_
      have : 2 * ((2 : ℝ) ^ (-m) * ljD0 n Ω) * (2 + (2 : ℝ) ^ m * 2) =
          ljD0 n Ω * (4 * (2 : ℝ) ^ (-m) + 4 * ((2 : ℝ) ^ (-m) * (2 : ℝ) ^ m)) := by ring
      rw [this, h2mm]
      nlinarith
    calc √(2 * (2 * ((2 : ℝ) ^ (-m) * ljD0 n Ω))) *
          √(2 * ((2 : ℝ) ^ (-m) * ljD0 n Ω) * (2 + (2 : ℝ) ^ m * 2)) * ljGeom (1 / 2)
        ≤ √((2 : ℝ) ^ (-m)) * √(4 * ljD0 n Ω) * √(8 * ljD0 n Ω) * ljGeom (1 / 2) := by
          rw [e1]; gcongr
      _ = (√(4 * ljD0 n Ω) * √(8 * ljD0 n Ω) * ljGeom (1 / 2)) * √((2 : ℝ) ^ (-m)) := by ring
      _ ≤ K * √((2 : ℝ) ^ (-m)) := by gcongr; exact le_max_right _ _

end SquareFunctionsDecay

section OscillatorySquareFunctions

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- **`L²` bound for square functions** from a multiplier bound: if
`∑_{j ∈ s} |𝓕ψ_j(ξ)|² ≤ M` for all `s`, `ξ`, then
`‖(∑_{j ∈ s} |ψ_j * g|²)^{1/2}‖₂ ≤ (2M)^{1/2} ‖g‖₂`. -/
theorem lj_eLpNorm_two_sqFun_le {ψ : Rn n → ℂ} (hψ : Integrable ψ) {M : ℝ} (hM0 : 0 ≤ M)
    (hM : ∀ (s : Finset ℤ) (ξ : Rn n), ∑ j ∈ s, ‖𝓕 (lpDilate n ψ j) ξ‖ ^ 2 ≤ M)
    (s : Finset ℤ) {g : Rn n → ℂ} (hg : MemLp g 2 volume) :
    eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, lpDilate n ψ j (x - y) * g y‖ ^ 2)) 2 volume ≤
      ENNReal.ofReal √(2 * M) * eLpNorm g 2 volume := by
  have hk : ∀ j ∈ s, Integrable (lpDilate n ψ j) := fun j _ => integrable_lpDilate hψ j
  have hconv : ∀ j, (fun x => ∫ y, lpDilate n ψ j (x - y) * g y) =
      lpDilate n ψ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g := fun j =>
    funext fun x => (convolution_eq_integral_sub _ _ x).symm
  have hmeas : ∀ j ∈ s, AEStronglyMeasurable
      (lpDilate n ψ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) volume := fun j hj =>
    (memLp_convolution_of_memLp one_le_two (memLp_one_iff_integrable.2 (hk j hj))
      hg).aestronglyMeasurable
  have hT : AEStronglyMeasurable
      (fun x => √(∑ j ∈ s, ‖∫ y, lpDilate n ψ j (x - y) * g y‖ ^ 2)) volume := by
    have := lj_aestronglyMeasurable_sqFun (k := lpDilate n ψ) s hk (a := 2) one_le_two
      (f := g) (by simpa using hg)
    exact this
  have hsq : eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, lpDilate n ψ j (x - y) * g y‖ ^ 2)) 2 volume ^ 2
      = ∑ j ∈ s,
          eLpNorm (lpDilate n ψ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) 2 volume ^ 2 := by
    rw [lp_eLpNorm_two_sq hT]
    have hpt : ∀ x, ‖√(∑ j ∈ s, ‖∫ y, lpDilate n ψ j (x - y) * g y‖ ^ 2)‖ₑ ^ 2 =
        ∑ j ∈ s, ‖(lpDilate n ψ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x‖ₑ ^ 2 := by
      intro x
      rw [Real.enorm_eq_ofReal (Real.sqrt_nonneg _), ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
        Real.sq_sqrt (by positivity), ENNReal.ofReal_sum_of_nonneg fun j _ => by positivity]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm, ← convolution_eq_integral_sub]
    simp_rw [hpt]
    rw [lintegral_finsetSum' _ fun j hj => (hmeas j hj).enorm.pow_const 2]
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [lp_eLpNorm_two_sq (hmeas j hj)]
  have hbound := lp_sum_eLpNorm_conv_le s hk (hM s) hg
  rw [← hsq] at hbound
  have h2 : (ENNReal.ofReal √(2 * M) * eLpNorm g 2 volume) ^ 2 =
      2 * ENNReal.ofReal M * eLpNorm g 2 volume ^ 2 := by
    rw [mul_pow, ← ENNReal.ofReal_pow (Real.sqrt_nonneg _), Real.sq_sqrt (by positivity),
      ENNReal.ofReal_mul zero_le_two, ENNReal.ofReal_ofNat]
  rw [← h2] at hbound
  rw [← ENNReal.rpow_two, ← ENNReal.rpow_two] at hbound
  exact (ENNReal.rpow_le_rpow_iff two_pos).1 hbound

/-- The interpolation weight `w` with `1/p = w/2 + (1-w)/e`. -/
noncomputable def ljWeight (p e : ℝ) : ℝ := (1 / p - 1 / e) / (1 / 2 - 1 / e)

/-- `1/p = w/2 + (1 - w)/e` for `e ≠ 2`. -/
theorem ljWeight_eq {p e : ℝ} (he : e ≠ 2) (he0 : 0 < e) :
    1 / p = ljWeight p e / 2 + (1 - ljWeight p e) / e := by
  have h : (1 / 2 - 1 / e) ≠ 0 := by
    intro h; apply he; field_simp at h; linarith
  rw [ljWeight]
  field_simp
  ring

/-- **Interpolation between `L²` and `L^e`** for square functions: if `p` lies strictly between
`2` and `e` (`e, p > 1`), `‖T f‖₂ ≤ A₂ ‖f‖₂` and `‖T f‖_e ≤ A_e ‖f‖_e`, then
`‖T f‖_p ≤ C A₂^w A_e^{1-w} ‖f‖_p` with `w = ljWeight p e`. -/
theorem lj_eLpNorm_sqFun_interp_two {k : ℤ → Rn n → ℂ} (s : Finset ℤ)
    (hk : ∀ j ∈ s, Integrable (k j)) {p e : ℝ} (he : 1 < e)
    (hbetw : (p < 2 ∧ e < p) ∨ (2 < p ∧ p < e)) {A₂ Ae : ℝ≥0}
    (h2 : ∀ f : Rn n → ℂ, MemLp f 2 volume →
      eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) 2 volume ≤
        A₂ * eLpNorm f 2 volume)
    (hE : ∀ f : Rn n → ℂ, MemLp f (ENNReal.ofReal e) volume →
      eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) (ENNReal.ofReal e) volume ≤
        Ae * eLpNorm f (ENNReal.ofReal e) volume)
    {f : Rn n → ℂ} (hf2 : MemLp f 2 volume) (hfe : MemLp f (ENNReal.ofReal e) volume) :
    eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) (ENNReal.ofReal p) volume ≤
      (marcinkiewiczConst (min e 2) (max e 2) p : ℝ≥0∞) * (A₂ : ℝ≥0∞) ^ ljWeight p e *
        (Ae : ℝ≥0∞) ^ (1 - ljWeight p e) * eLpNorm f (ENNReal.ofReal p) volume := by
  have e2 : ENNReal.ofReal 2 = 2 := ENNReal.ofReal_ofNat 2
  have h2' : ∀ f : Rn n → ℂ, MemLp f (ENNReal.ofReal 2) volume →
      eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, k j (x - y) * f y‖ ^ 2)) (ENNReal.ofReal 2) volume ≤
        A₂ * eLpNorm f (ENNReal.ofReal 2) volume := by
    rw [e2]; exact h2
  have hf2' : MemLp f (ENNReal.ofReal 2) volume := by rw [e2]; exact hf2
  rcases hbetw with ⟨hp2, hep⟩ | ⟨hp2, hpe⟩
  · have hθ : 1 / p = (1 - ljWeight p e) / e + ljWeight p e / 2 := by
      rw [ljWeight_eq (p := p) (e := e) (by linarith : e < 2).ne (by linarith)]; ring
    have h := lj_eLpNorm_sqFun_interp s hk he.le hep hp2 hθ hE h2' hfe hf2'
    rw [min_eq_left (by linarith), max_eq_right (by linarith)]
    calc _ ≤ _ := h
      _ = _ := by ring
  · have hθ : 1 / p = (1 - (1 - ljWeight p e)) / 2 + (1 - ljWeight p e) / e := by
      rw [ljWeight_eq (p := p) (e := e) (by linarith : 2 < e).ne' (by linarith)]; ring
    have h := lj_eLpNorm_sqFun_interp s hk one_le_two hp2 hpe hθ h2' hE hf2' hfe
    rw [min_eq_right (by linarith), max_eq_left (by linarith)]
    rw [sub_sub_cancel] at h
    exact h


/-- `0 < w ≤ 1` for the interpolation weight when `p` lies strictly between `2` and `e`. -/
theorem ljWeight_mem {p e : ℝ} (he : 1 < e) (hbetw : (p < 2 ∧ e < p) ∨ (2 < p ∧ p < e)) :
    0 < ljWeight p e ∧ ljWeight p e ≤ 1 := by
  rcases hbetw with ⟨hp2, hep⟩ | ⟨hp2, hpe⟩
  · have hp0 : 0 < p := by linarith
    have h1 : 1 / p - 1 / e < 0 := by
      rw [sub_neg]; exact one_div_lt_one_div_of_lt (by linarith) hep
    have h2 : 1 / 2 - 1 / e < 0 := by
      rw [sub_neg]; exact one_div_lt_one_div_of_lt (by linarith) (by linarith)
    refine ⟨div_pos_of_neg_of_neg h1 h2, ?_⟩
    rw [ljWeight, div_le_one_of_neg h2]
    have : 1 / 2 ≤ 1 / p := one_div_le_one_div_of_le hp0 hp2.le
    linarith
  · have h1 : 0 < 1 / p - 1 / e := by
      rw [sub_pos]; exact one_div_lt_one_div_of_lt (by linarith) hpe
    have h2 : 0 < 1 / 2 - 1 / e := by
      rw [sub_pos]; exact one_div_lt_one_div_of_lt (by linarith) (by linarith)
    refine ⟨div_pos h1 h2, ?_⟩
    rw [ljWeight, div_le_one h2]
    have : 1 / p ≤ 1 / 2 := one_div_le_one_div_of_le (by norm_num) hp2.le
    linarith

set_option maxHeartbeats 1000000 in
-- The proof below is long (case analysis, interpolation, real arithmetic).
/-- **Square functions for the oscillatory pieces with decay** (the paper's (3.10)–(3.12) for
`ℓ ≥ 1`, via `L²` decay, Benedek–Calderón–Panzone with polynomial growth, and Marcinkiewicz
interpolation): for `α > 1` and `1 < p < ∞` there are `C ≥ 0`, `γ > 0` with
`‖(∑_j |(q̃_λ)_j * f|²)^{1/2}‖_p ≤ C λ^{-γ} ‖f‖_p` for all `λ ≥ 1` and Schwartz `f`. -/
theorem IsHomogeneousCZKernel.eLpNorm_ljSq_osc_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C γ : ℝ, 0 ≤ C ∧ 0 < γ ∧ ∀ lam : ℝ, 1 ≤ lam → ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (ljSq n (ljOsc n α Ω lam) f) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * lam ^ (-γ)) * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨Cosc, hCosc0, hosc⟩ := hΩ.norm_fourier_ljOsc_sq_le hn hα
  obtain ⟨B, hB0, hsum⟩ := lj_sum_norm_fourier_lpDilate_sq_le (n := n)
  have hA₁ := ljA1_nonneg (n := n) (Ω := Ω)
  have hD₀ := ljD0_nonneg (n := n) (Ω := Ω)
  have hα0 : 0 < α := by linarith
  have hsqrt : ∀ lam : ℝ, 0 < lam →
      √(2 * (2 * (Cosc * lam⁻¹) * B)) = √(4 * Cosc * B) * lam ^ (-(1 / 2 : ℝ)) := by
    intro lam hlam
    rw [show 2 * (2 * (Cosc * lam⁻¹) * B) = 4 * Cosc * B * lam⁻¹ by ring,
      Real.sqrt_mul (by positivity), Real.sqrt_eq_rpow (lam⁻¹), Real.inv_rpow hlam.le,
      Real.rpow_neg hlam.le]
  have hL2 : ∀ lam : ℝ, 1 ≤ lam → ∀ (s : Finset ℤ) (g : Rn n → ℂ), MemLp g 2 volume →
      eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, lpDilate n (ljOsc n α Ω lam) j (x - y) * g y‖ ^ 2))
        2 volume ≤ ENNReal.ofReal (√(4 * Cosc * B) * lam ^ (-(1 / 2 : ℝ))) *
          eLpNorm g 2 volume := by
    intro lam hlam s g hg
    have hlam0 : 0 < lam := by linarith
    rw [← hsqrt lam hlam0]
    exact lj_eLpNorm_two_sqFun_le (hΩ.integrable_ljOsc α lam) (by positivity)
      (fun s ξ => hsum _ (Cosc * lam⁻¹) lam (by positivity) hlam0 (hosc lam hlam) s ξ) s hg
  have hmeas : ∀ (lam : ℝ) (q : ℝ), 1 ≤ q → ∀ f : 𝓢(Rn n, ℂ), ∀ j : ℤ,
      AEMeasurable fun x => ∫ y, lpDilate n (ljOsc n α Ω lam) j (x - y) * f y := by
    intro lam q hq f j
    exact lj_aemeasurable_conv (integrable_lpDilate (hΩ.integrable_ljOsc α lam) j) hq
      (f.memLp _)
  rcases eq_or_ne p 2 with rfl | hp2
  · refine ⟨√(4 * Cosc * B), 1 / 2, by positivity, by norm_num, fun lam hlam f => ?_⟩
    refine lj_eLpNorm_tsum_sq_le (hmeas lam 2 one_le_two f) (by norm_num) fun s => ?_
    rw [ENNReal.ofReal_ofNat]
    exact hL2 lam hlam s f (f.memLp 2)
  -- the endpoint `e` on the other side of `p`
  set e : ℝ := if p < 2 then (1 + p) / 2 else 2 * p with he_def
  have he1 : 1 < e := by
    rw [he_def]; split_ifs <;> linarith
  have hbetw : (p < 2 ∧ e < p) ∨ (2 < p ∧ p < e) := by
    rcases lt_or_gt_of_ne hp2 with h | h
    · left; have : e = (1 + p) / 2 := by rw [he_def]; simp [h]
      rw [this]; constructor <;> linarith
    · right; have : e = 2 * p := by rw [he_def]; simp [not_lt.2 h.le]
      rw [this]; constructor <;> linarith
  set w := ljWeight p e with hw
  obtain ⟨hw0, hw1⟩ := ljWeight_mem he1 hbetw
  set δ := w / 4 with hδ
  have hδ0 : 0 < δ := by positivity
  have hδ1 : δ ≤ 1 := by linarith
  obtain ⟨Ce, hCe0, hBCP⟩ := lj_eLpNorm_sqFun_le (by omega : 0 < n) he1
  set Dq := ljD0 n Ω + α * 3 ^ (α - 1) * ljA1 n Ω + 2 * ljA1 n Ω with hDq
  have hDq0 : 0 ≤ Dq := by positivity
  have hG := ljGeom_nonneg δ
  set Ke := max (√Cosc) ((2 * ljA1 n Ω) ^ (1 - δ) * (2 * Dq) ^ δ * ljGeom δ) with hKe
  have hKe0 : 0 ≤ Ke := le_max_of_le_left (Real.sqrt_nonneg _)
  have hLe : ∀ lam : ℝ, 1 ≤ lam → ∀ (s : Finset ℤ) (g : Rn n → ℂ),
      MemLp g (ENNReal.ofReal e) volume →
      eLpNorm (fun x => √(∑ j ∈ s, ‖∫ y, lpDilate n (ljOsc n α Ω lam) j (x - y) * g y‖ ^ 2))
        (ENNReal.ofReal e) volume ≤ ENNReal.ofReal (Ce * Ke * lam ^ δ) *
          eLpNorm g (ENNReal.ofReal e) volume := by
    intro lam hlam s g hg
    have hlam0 : 0 < lam := by linarith
    have hk := hΩ.ljKernel_ljOsc hα lam
    rw [abs_of_pos hlam0] at hk
    refine (hBCP _ 2 _ _ (Cosc * lam⁻¹) lam δ hk two_pos hA₁ (by positivity) (by positivity)
      hlam0 hδ0 hδ1 (hosc lam hlam) s g hg).trans ?_
    refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) zero_le
    rw [mul_assoc Ce]
    refine mul_le_mul_of_nonneg_left ?_ hCe0
    have hlδ : 1 ≤ lam ^ δ := Real.one_le_rpow hlam hδ0.le
    refine max_le ?_ ?_
    · calc √(Cosc * lam⁻¹) ≤ √Cosc := by
            refine Real.sqrt_le_sqrt ?_
            have : lam⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hlam
            nlinarith
        _ ≤ √Cosc * lam ^ δ := le_mul_of_one_le_right (Real.sqrt_nonneg _) hlδ
        _ ≤ Ke * lam ^ δ := by gcongr; exact le_max_left _ _
    · have hD : (ljD0 n Ω + lam * α * 3 ^ (α - 1) * ljA1 n Ω + 2 * ljA1 n Ω) * 2 ≤
          lam * (2 * Dq) := by
        rw [hDq]; nlinarith [mul_nonneg (mul_nonneg hα0.le (by positivity : (0 : ℝ) ≤
          3 ^ (α - 1))) hA₁]
      calc (2 * ljA1 n Ω) ^ (1 - δ) *
            ((ljD0 n Ω + lam * α * 3 ^ (α - 1) * ljA1 n Ω + 2 * ljA1 n Ω) * 2) ^ δ *
            ljGeom δ
          ≤ (2 * ljA1 n Ω) ^ (1 - δ) * (lam * (2 * Dq)) ^ δ * ljGeom δ := by
            gcongr
      _ = ((2 * ljA1 n Ω) ^ (1 - δ) * (2 * Dq) ^ δ * ljGeom δ) * lam ^ δ := by
            rw [Real.mul_rpow hlam0.le (by positivity)]; ring
      _ ≤ Ke * lam ^ δ := by gcongr; exact le_max_right _ _
  set Mc : ℝ≥0 := marcinkiewiczConst (min e 2) (max e 2) p
  refine ⟨Mc * (√(4 * Cosc * B)) ^ w * (Ce * Ke) ^ (1 - w), w / 4, by positivity,
    by positivity, fun lam hlam f => ?_⟩
  have hlam0 : 0 < lam := by linarith
  refine lj_eLpNorm_tsum_sq_le (hmeas lam p hp.le f) (by linarith) fun s => ?_
  have hint := lj_eLpNorm_sqFun_interp_two s
    (fun j _ => integrable_lpDilate (hΩ.integrable_ljOsc α lam) j) he1 hbetw
    (A₂ := (√(4 * Cosc * B) * lam ^ (-(1 / 2 : ℝ))).toNNReal)
    (Ae := (Ce * Ke * lam ^ δ).toNNReal) (hL2 lam hlam s) (hLe lam hlam s) (f.memLp 2)
    (f.memLp _)
  refine hint.trans (mul_le_mul_of_nonneg_right ?_ zero_le)
  have hA2 : (((√(4 * Cosc * B) * lam ^ (-(1 / 2 : ℝ))).toNNReal : ℝ≥0) : ℝ≥0∞) ^ w =
      ENNReal.ofReal ((√(4 * Cosc * B) * lam ^ (-(1 / 2 : ℝ))) ^ w) :=
    ENNReal.ofReal_rpow_of_nonneg (by positivity) hw0.le
  have hAe : (((Ce * Ke * lam ^ δ).toNNReal : ℝ≥0) : ℝ≥0∞) ^ (1 - w) =
      ENNReal.ofReal ((Ce * Ke * lam ^ δ) ^ (1 - w)) :=
    ENNReal.ofReal_rpow_of_nonneg (by positivity) (by linarith)
  rw [hA2, hAe, ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (by positivity),
    ← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  have hl1 : 0 ≤ lam ^ (-(1 / 2 : ℝ)) := Real.rpow_nonneg hlam0.le _
  have hl2 : 0 ≤ lam ^ δ := Real.rpow_nonneg hlam0.le _
  have hCK : 0 ≤ Ce * Ke := mul_nonneg hCe0 hKe0
  rw [Real.mul_rpow (Real.sqrt_nonneg (4 * Cosc * B)) hl1, Real.mul_rpow hCK hl2,
    ← Real.rpow_mul hlam0.le (-(1 / 2 : ℝ)) w, ← Real.rpow_mul hlam0.le δ (1 - w)]
  have hexp : lam ^ (-(1 / 2 : ℝ) * w) * lam ^ (δ * (1 - w)) ≤ lam ^ (-(w / 4)) := by
    rw [← Real.rpow_add hlam0]
    refine Real.rpow_le_rpow_of_exponent_le hlam ?_
    have := mul_nonneg hδ0.le hw0.le
    linarith
  have key : ∀ M a b x y z : ℝ, 0 ≤ M * a * b → x * y ≤ z →
      M * (a * x) * (b * y) ≤ M * a * b * z := by
    intro M a b x y z h0 h1
    calc M * (a * x) * (b * y) = M * a * b * (x * y) := by ring
      _ ≤ M * a * b * z := mul_le_mul_of_nonneg_left h1 h0
  exact key _ _ _ _ _ _ (mul_nonneg (mul_nonneg (NNReal.coe_nonneg _)
    (Real.rpow_nonneg (Real.sqrt_nonneg _) _)) (Real.rpow_nonneg hCK _)) hexp

end OscillatorySquareFunctions

section PrincipalValueOperator

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- Dilates of differentiable functions are differentiable, with
`|∇ψ_j(x)| ≤ 2^{jn} 2^j |∇ψ(2^j x)|`. -/
theorem lj_hasFDerivAt_lpDilate {ψ : Rn n → ℂ} (hψ : Differentiable ℝ ψ) (j : ℤ) (x : Rn n) :
    DifferentiableAt ℝ (lpDilate n ψ j) x ∧
      ‖fderiv ℝ (lpDilate n ψ j) x‖ ≤
        (2 : ℝ) ^ (j * n) * (2 : ℝ) ^ j * ‖fderiv ℝ ψ ((2 : ℝ) ^ j • x)‖ := by
  have heq : lpDilate n ψ j = fun x => (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) * ψ ((2 : ℝ) ^ j • x) :=
    funext fun x => lpDilate_apply_ofReal ψ j x
  have hg : HasFDerivAt (fun x : Rn n => ψ ((2 : ℝ) ^ j • x))
      ((fderiv ℝ ψ ((2 : ℝ) ^ j • x)).comp ((2 : ℝ) ^ j • ContinuousLinearMap.id ℝ (Rn n))) x :=
    (hψ _).hasFDerivAt.comp x ((hasFDerivAt_id x).const_smul ((2 : ℝ) ^ j))
  have hh := hg.const_mul ((((2 : ℝ) ^ (j * n) : ℝ) : ℂ))
  rw [← heq] at hh
  refine ⟨hh.differentiableAt, ?_⟩
  rw [hh.fderiv, norm_smul, Complex.norm_real, Real.norm_of_nonneg (by positivity), mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  refine (ContinuousLinearMap.opNorm_comp_le _ _).trans ?_
  rw [mul_comm]
  refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
  rw [norm_smul, Real.norm_of_nonneg (by positivity)]
  calc (2 : ℝ) ^ j * ‖ContinuousLinearMap.id ℝ (Rn n)‖ ≤ (2 : ℝ) ^ j * 1 := by
        gcongr; exact ContinuousLinearMap.norm_id_le
    _ = (2 : ℝ) ^ j := mul_one _

/-- The gradient of `k₀` is supported in the annulus and bounded:
`|∇k₀(y)| ≤ c min(|y|, |y|⁻¹)/|y|^{n+1}`. -/
theorem IsHomogeneousCZKernel.exists_norm_fderiv_ljAmp_le (hΩ : IsHomogeneousCZKernel n Ω) :
    ∃ c, 0 ≤ c ∧ ∀ y : Rn n, y ≠ 0 →
      ‖fderiv ℝ (ljAmp n Ω) y‖ ≤ c * min ‖y‖ ‖y‖⁻¹ / ‖y‖ ^ (n + 1) := by
  have hc : Continuous (fderiv ℝ (ljAmp n Ω)) := hΩ.contDiff_ljAmp.continuous_fderiv (by simp)
  obtain ⟨D, hD⟩ := hc.bounded_above_of_compact_support (hasCompactSupport_ljAmp.fderiv (𝕜 := ℝ))
  refine ⟨max D 0 * 2 ^ (n + 2), by positivity, fun y hy => ?_⟩
  have hy0 : 0 < ‖y‖ := norm_pos_iff.2 hy
  by_cases hs : y ∈ tsupport (ljAmp n Ω)
  · have ha := tsupport_ljAmp_subset hs
    have hm : 1 / 2 ≤ min ‖y‖ ‖y‖⁻¹ := le_min (by linarith [ha.1]) (by
      rw [le_inv_comm₀ (by norm_num) hy0]; linarith [ha.2])
    have hp : ‖y‖ ^ (n + 1) ≤ 2 ^ (n + 1) := pow_le_pow_left₀ hy0.le ha.2 _
    have h1 : 1 ≤ 2 ^ (n + 2) * min ‖y‖ ‖y‖⁻¹ / ‖y‖ ^ (n + 1) := by
      rw [le_div_iff₀ (by positivity), one_mul]
      calc ‖y‖ ^ (n + 1) ≤ 2 ^ (n + 1) := hp
        _ = 2 ^ (n + 2) * (1 / 2) := by ring
        _ ≤ 2 ^ (n + 2) * min ‖y‖ ‖y‖⁻¹ := by gcongr
    calc ‖fderiv ℝ (ljAmp n Ω) y‖ ≤ max D 0 := (hD y).trans (le_max_left _ _)
      _ = max D 0 * 1 := (mul_one _).symm
      _ ≤ max D 0 * (2 ^ (n + 2) * min ‖y‖ ‖y‖⁻¹ / ‖y‖ ^ (n + 1)) :=
          mul_le_mul_of_nonneg_left h1 (le_max_right _ _)
      _ = max D 0 * 2 ^ (n + 2) * min ‖y‖ ‖y‖⁻¹ / ‖y‖ ^ (n + 1) := by ring
  · rw [fderiv_of_notMem_tsupport (𝕜 := ℝ) hs, norm_zero]
    have := lj_min_inv_nonneg hy0.le
    positivity


/-- `k_m(t) = φ_m(t) K(t)`. -/
theorem IsHomogeneousCZKernel.ljPiece_apply (hΩ : IsHomogeneousCZKernel n Ω) (m : ℤ)
    (t : Rn n) : ljPiece n Ω m t = ((dyadicPhiScale n m t * czKernel n Ω t : ℝ) : ℂ) := by
  have h := hΩ.lpDilate_ljOsc 1 0 (-m) t
  rw [ljOsc_zero, neg_neg] at h
  rw [ljPiece, h]
  simp

/-- `k_m` is differentiable. -/
theorem IsHomogeneousCZKernel.differentiable_ljPiece (hΩ : IsHomogeneousCZKernel n Ω) (m : ℤ) :
    Differentiable ℝ (ljPiece n Ω m) := fun x =>
  (lj_hasFDerivAt_lpDilate (hΩ.contDiff_ljAmp.differentiable (by simp)) (-m) x).1

/-- Schwartz functions are bounded. -/
theorem lj_schwartz_bounded (f : 𝓢(Rn n, ℂ)) : ∃ C, ∀ x, ‖f x‖ ≤ C := by
  obtain ⟨C, -, hC⟩ := f.decay 0 0
  exact ⟨C, fun x => by simpa using hC x⟩

/-- `𝓕(∑ fᵢ) = ∑ 𝓕 fᵢ` for finitely many integrable functions. -/
theorem lj_fourier_sum {ι : Type*} (s : Finset ι) {f : ι → Rn n → ℂ}
    (hf : ∀ i ∈ s, Integrable (f i)) (ξ : Rn n) :
    𝓕 (fun x => ∑ i ∈ s, f i x) ξ = ∑ i ∈ s, 𝓕 (f i) ξ := by
  simp only [Real.fourier_eq, Finset.smul_sum]
  exact integral_finsetSum s fun i hi =>
    (Real.fourierIntegral_convergent_iff (μ := volume) (w := ξ)).2 (hf i hi)

/-- The smooth truncations `H_L = ∑_{|m| ≤ L} φ_m K` of the Calderón–Zygmund kernel `K`. -/
noncomputable def ljTrunc (n : ℕ) (Ω : Rn n → ℝ) (L : ℕ) (x : Rn n) : ℂ :=
  ∑ m ∈ Finset.Icc (-(L : ℤ)) L, ljPiece n Ω m x

/-- **Uniform Calderón–Zygmund bounds for the smooth truncations**: there is `A` such that
every `H_L` is integrable and differentiable off `0`, with `|∇H_L(x)| ≤ A |x|^{-n-1}` and
`|𝓕 H_L| ≤ A` (by `𝓕(φ_m K)(ξ) = 𝓕(φ₀K)(2^m ξ)`, `|𝓕(φ₀ K)(η)| ≲ min(|η|, |η|⁻¹)`, and
the analogous dyadic bound for the gradients). -/
theorem IsHomogeneousCZKernel.ljTrunc_cz (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) :
    ∃ A, 0 ≤ A ∧ ∀ L : ℕ, Integrable (ljTrunc n Ω L) ∧
      (∀ x, x ≠ 0 → DifferentiableAt ℝ (ljTrunc n Ω L) x) ∧
      (∀ x, x ≠ 0 → ‖fderiv ℝ (ljTrunc n Ω L) x‖ ≤ A / ‖x‖ ^ (n + 1)) ∧
      (∀ ξ, ‖𝓕 (ljTrunc n Ω L) ξ‖ ≤ A) := by
  obtain ⟨c, hc0, hc⟩ := hΩ.exists_norm_fderiv_ljAmp_le
  obtain ⟨B, hB, hsum⟩ := lp_sum_min_le
  have hck := ljCk_nonneg (n := n) (Ω := Ω)
  refine ⟨max (c * B) (ljCk n Ω * B), le_max_of_le_left (by positivity), fun L => ?_⟩
  set s := Finset.Icc (-(L : ℤ)) L
  have hint : ∀ m ∈ s, Integrable (ljPiece n Ω m) := fun m _ =>
    (hΩ.ljKernel_ljPiece m).integrable
  have hdiff : ∀ x, ∀ m ∈ s, DifferentiableAt ℝ (ljPiece n Ω m) x := fun x m _ =>
    hΩ.differentiable_ljPiece m x
  refine ⟨integrable_finsetSum s hint, fun x _ => DifferentiableAt.fun_sum (hdiff x),
    fun x hx => ?_, fun ξ => ?_⟩
  · have hx0 : 0 < ‖x‖ := norm_pos_iff.2 hx
    unfold ljTrunc
    rw [fderiv_fun_sum (hdiff x)]
    refine (norm_sum_le _ _).trans ?_
    have hterm : ∀ m ∈ s, ‖fderiv ℝ (ljPiece n Ω m) x‖ ≤
        c / ‖x‖ ^ (n + 1) * min ((2 : ℝ) ^ (-m) * ‖x‖) ((2 : ℝ) ^ (-m) * ‖x‖)⁻¹ := by
      intro m _
      have h1 := (lj_hasFDerivAt_lpDilate (hΩ.contDiff_ljAmp.differentiable (by simp)) (-m) x).2
      have h2jx : (2 : ℝ) ^ (-m) • x ≠ 0 := smul_ne_zero (zpow_ne_zero _ two_ne_zero) hx
      have h2 := hc _ h2jx
      have hn2 : ‖(2 : ℝ) ^ (-m) • x‖ = (2 : ℝ) ^ (-m) * ‖x‖ := by
        rw [norm_smul, Real.norm_of_nonneg (by positivity)]
      rw [hn2] at h2
      have h2j : (0 : ℝ) < 2 ^ (-m) := zpow_pos two_pos _
      have hid : (2 : ℝ) ^ (-m * n) * (2 : ℝ) ^ (-m) / ((2 : ℝ) ^ (-m) * ‖x‖) ^ (n + 1) =
          1 / ‖x‖ ^ (n + 1) := by
        rw [zpow_mul, zpow_natCast, mul_pow, pow_succ]
        field_simp
      calc ‖fderiv ℝ (ljPiece n Ω m) x‖
          ≤ (2 : ℝ) ^ (-m * n) * (2 : ℝ) ^ (-m) * ‖fderiv ℝ (ljAmp n Ω) ((2 : ℝ) ^ (-m) • x)‖ :=
            h1
        _ ≤ (2 : ℝ) ^ (-m * n) * (2 : ℝ) ^ (-m) *
            (c * min ((2 : ℝ) ^ (-m) * ‖x‖) ((2 : ℝ) ^ (-m) * ‖x‖)⁻¹ /
              ((2 : ℝ) ^ (-m) * ‖x‖) ^ (n + 1)) := by gcongr
        _ = c * min ((2 : ℝ) ^ (-m) * ‖x‖) ((2 : ℝ) ^ (-m) * ‖x‖)⁻¹ *
            ((2 : ℝ) ^ (-m * n) * (2 : ℝ) ^ (-m) / ((2 : ℝ) ^ (-m) * ‖x‖) ^ (n + 1)) := by ring
        _ = c / ‖x‖ ^ (n + 1) * min ((2 : ℝ) ^ (-m) * ‖x‖) ((2 : ℝ) ^ (-m) * ‖x‖)⁻¹ := by
            rw [hid]; ring
    calc ∑ m ∈ s, ‖fderiv ℝ (ljPiece n Ω m) x‖
        ≤ ∑ m ∈ s, c / ‖x‖ ^ (n + 1) * min ((2 : ℝ) ^ (-m) * ‖x‖) ((2 : ℝ) ^ (-m) * ‖x‖)⁻¹ :=
          Finset.sum_le_sum hterm
      _ = c / ‖x‖ ^ (n + 1) * ∑ m ∈ s, min ((2 : ℝ) ^ (-m) * ‖x‖) ((2 : ℝ) ^ (-m) * ‖x‖)⁻¹ := by
          rw [Finset.mul_sum]
      _ ≤ c / ‖x‖ ^ (n + 1) * B := by
          gcongr; exact lp_sum_min_neg_le hsum s (norm_nonneg x)
      _ = c * B / ‖x‖ ^ (n + 1) := by ring
      _ ≤ max (c * B) (ljCk n Ω * B) / ‖x‖ ^ (n + 1) := by gcongr; exact le_max_left _ _
  · unfold ljTrunc
    rw [lj_fourier_sum s hint]
    refine (norm_sum_le _ _).trans ?_
    calc ∑ m ∈ s, ‖𝓕 (ljPiece n Ω m) ξ‖
        ≤ ∑ m ∈ s, ljCk n Ω * min ((2 : ℝ) ^ m * ‖ξ‖) ((2 : ℝ) ^ m * ‖ξ‖)⁻¹ := by
          refine Finset.sum_le_sum fun m _ => ?_
          rw [fourier_ljPiece]
          have h := hΩ.norm_fourier_ljAmp_le hn ((2 : ℝ) ^ m • ξ)
          rwa [norm_smul, Real.norm_of_nonneg (by positivity)] at h
      _ = ljCk n Ω * ∑ m ∈ s, min ((2 : ℝ) ^ m * ‖ξ‖) ((2 : ℝ) ^ m * ‖ξ‖)⁻¹ := by
          rw [Finset.mul_sum]
      _ ≤ ljCk n Ω * B := by gcongr; exact hsum s _ (norm_nonneg ξ)
      _ ≤ max (c * B) (ljCk n Ω * B) := le_max_right _ _

/-- The truncated singular integral is the partial sum of the pieces:
`(H_L * f)(x) = ∑_{|m| ≤ L} 𝓗^{(0)}_m f(x)` (smooth pieces at `u = 0`). -/
theorem IsHomogeneousCZKernel.ljTrunc_conv_eq (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ)
    (L : ℕ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    (ljTrunc n Ω L ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f : Rn n → ℂ)) x =
      ∑ m ∈ Finset.Icc (-(L : ℤ)) L, modulatedPiece n α Ω 0 m f x := by
  obtain ⟨C, hC⟩ := lj_schwartz_bounded f
  rw [convolution_def]
  simp only [ContinuousLinearMap.mul_apply', ljTrunc, Finset.sum_mul]
  rw [integral_finsetSum]
  · refine Finset.sum_congr rfl fun m _ => ?_
    rw [modulatedPiece]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [hΩ.ljPiece_apply, Complex.ofReal_zero, mul_zero, zero_mul, Complex.exp_zero,
      mul_one]
    ring
  · intro m _
    exact (hΩ.ljKernel_ljPiece m).integrable.mul_bdd
      (f.continuous.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
      (Eventually.of_forall fun t => hC _)

/-- **The principal-value operator `T = 𝓗^{(0)}` is bounded on `L^p`** (`1 < p < ∞`; the
Calderón–Zygmund theorem applied to the smooth truncations `H_L`, which have uniform gradient
and Fourier bounds, followed by Fatou's lemma; the partial sums converge pointwise by
`hasSum_modulatedPiece`). -/
theorem IsHomogeneousCZKernel.eLpNorm_modulatedSI_zero_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      MemLp (fun x => modulatedSI n α Ω 0 f x) (ENNReal.ofReal p) volume ∧
      eLpNorm (fun x => modulatedSI n α Ω 0 f x) (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨Ccz, hCcz, hcz⟩ := exists_eLpNorm_convolution_le_of_norm_fourier_le
    (by omega : 0 < n) hp
  obtain ⟨A, hA0, hA⟩ := hΩ.ljTrunc_cz hn
  refine ⟨(Ccz * A).toNNReal, fun f => ?_⟩
  have hp1 : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hfp : MemLp (f : Rn n → ℂ) (ENNReal.ofReal p) volume := f.memLp _
  have hbound : ∀ L : ℕ, eLpNorm (ljTrunc n Ω L ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
      (f : Rn n → ℂ)) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (Ccz * A) * eLpNorm f (ENNReal.ofReal p) volume := fun L =>
    hcz _ A (hA L).1 (hA L).2.1 (hA L).2.2.1 (hA L).2.2.2 f hfp
  have hmeas : ∀ L : ℕ, AEStronglyMeasurable (ljTrunc n Ω L ⋆[ContinuousLinearMap.mul ℂ ℂ,
      volume] (f : Rn n → ℂ)) volume := fun L =>
    (memLp_convolution_of_memLp hp1 (memLp_one_iff_integrable.2 (hA L).1) hfp).aestronglyMeasurable
  have hT : AEStronglyMeasurable (fun x => modulatedSI n α Ω 0 f x) volume :=
    (hΩ.measurable_modulatedSI hn hα 0 f).aestronglyMeasurable
  have hlim : ∀ x, Tendsto (fun L : ℕ => (ljTrunc n Ω L ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
      (f : Rn n → ℂ)) x) atTop (𝓝 (modulatedSI n α Ω 0 f x)) := by
    intro x
    simp_rw [hΩ.ljTrunc_conv_eq α _ f x]
    have hs := hΩ.hasSum_modulatedPiece hn hα 0 f x
    refine hs.comp (tendsto_atTop_finset_of_monotone (fun L L' h => ?_) fun m => ?_)
    · exact Finset.Icc_subset_Icc (by omega) (by omega)
    · exact ⟨m.natAbs, Finset.mem_Icc.2 ⟨by omega, by omega⟩⟩
  have hle : eLpNorm (fun x => modulatedSI n α Ω 0 f x) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (Ccz * A) * eLpNorm f (ENNReal.ofReal p) volume :=
    Lp.eLpNorm_le_of_ae_tendsto (Eventually.of_forall hbound) hmeas hT
      (Eventually.of_forall hlim)
  refine ⟨lt_of_le_of_lt hle (ENNReal.mul_lt_top ENNReal.ofReal_lt_top
    hfp.eLpNorm_lt_top), ?_⟩
  exact hle

end PrincipalValueOperator

section DyadicJumps

variable {n : ℕ}

/-- `dyadicIndex α (2^{kα}) = k` for `α > 0`. -/
theorem dyadicIndex_dyadicPoint {α : ℝ} (hα : 0 < α) (k : ℤ) :
    dyadicIndex α (dyadicPoint α k) = k := by
  rw [dyadicIndex, dyadicPoint, Real.logb_rpow (by norm_num) (by norm_num),
    mul_div_cancel_right₀ _ hα.ne', Int.floor_intCast]

/-- Points of the dyadic set are dyadic points of their index. -/
theorem dyadicPoint_dyadicIndex_of_mem {α : ℝ} (hα : 0 < α) {u : ℝ} (hu : u ∈ dyadicSet α) :
    dyadicPoint α (dyadicIndex α u) = u := by
  obtain ⟨k, rfl⟩ := hu
  rw [dyadicIndex_dyadicPoint hα]

/-- **Jumps over the dyadic set are jumps of a sequence**:
`N_λ{b(u) : u ∈ {2^{jα}}} ≤ N_λ(j ↦ b(2^{jα}))` (`α > 0`). -/
theorem jumpFunction_dyadicSet_le_jswJumpCount {α : ℝ} (hα : 0 < α) (lam : ℝ) (b : ℝ → ℂ) :
    jumpFunction lam (dyadicSet α) b ≤ jswJumpCount lam (fun j => b (dyadicPoint α j)) := by
  refine jumpFunction_le fun N s t hst hord hmem hlam => ?_
  set σ : Fin N → ℤ := fun i => dyadicIndex α (s i)
  set τ : Fin N → ℤ := fun i => dyadicIndex α (t i)
  have hs : ∀ i, dyadicPoint α (σ i) = s i := fun i =>
    dyadicPoint_dyadicIndex_of_mem hα (hmem i).1
  have ht : ∀ i, dyadicPoint α (τ i) = t i := fun i =>
    dyadicPoint_dyadicIndex_of_mem hα (hmem i).2
  have hmono := dyadicPoint_strictMono hα
  have h1 : ∀ i, σ i < τ i := fun i => hmono.lt_iff_lt.1 (by rw [hs, ht]; exact hst i)
  have h2 : ∀ i j, i < j → τ i < σ j := fun i j hij =>
    hmono.lt_iff_lt.1 (by rw [hs, ht]; exact hord i j hij)
  have h3 : ∀ i, lam < ‖b (dyadicPoint α (τ i)) - b (dyadicPoint α (σ i))‖ := fun i => by
    rw [hs, ht]; exact hlam i
  exact le_iSup_of_le N (le_iSup_of_le σ (le_iSup_of_le τ (le_iSup_of_le h1
    (le_iSup_of_le h2 (le_iSup_of_le h3 le_rfl)))))

/-- Jumps over the dyadic set equal jumps of the sequence `j ↦ b(2^{jα})` (`α > 0`). -/
theorem jumpFunction_dyadicSet_eq_jswJumpCount {α : ℝ} (hα : 0 < α) (lam : ℝ) (b : ℝ → ℂ) :
    jumpFunction lam (dyadicSet α) b = jswJumpCount lam (fun j => b (dyadicPoint α j)) := by
  refine le_antisymm (jumpFunction_dyadicSet_le_jswJumpCount hα lam b) ?_
  have hmono := dyadicPoint_strictMono hα
  refine iSup_le fun N => iSup_le fun σ => iSup_le fun τ => iSup_le fun h1 =>
    iSup_le fun h2 => iSup_le fun h3 => ?_
  exact natCast_le_jumpFunction (s := fun i => dyadicPoint α (σ i))
    (t := fun i => dyadicPoint α (τ i)) (fun i => hmono (h1 i))
    (fun i j hij => hmono (h2 i j hij))
    (fun i => ⟨dyadicPoint_mem_dyadicSet α _, dyadicPoint_mem_dyadicSet α _⟩) h3

/-- Jump counts are invariant under `a ↦ c - a`. -/
theorem jswJumpCount_const_sub (lam : ℝ) (c : ℂ) (a : ℤ → ℂ) :
    jswJumpCount lam (fun j => c - a j) = jswJumpCount lam a := by
  have h : ∀ x y : ℤ, ‖(c - a x) - (c - a y)‖ = ‖a x - a y‖ := fun x y => by
    rw [sub_sub_sub_cancel_left, norm_sub_rev]
  unfold jswJumpCount
  simp only [h]

/-- The two dilation conventions agree: `jswDilate n φ j = lpDilate n φ j`. -/
theorem jswDilate_eq_lpDilate (φ : Rn n → ℂ) (j : ℤ) : jswDilate n φ j = lpDilate n φ j := by
  funext x
  rw [jswDilate, lpDilate_apply_ofReal, Complex.real_smul]

/-- **(`eq:Sk_jump`) in the dyadic-set form**: for a Schwartz `φ` with `∫ φ = 1`, `α > 0` and
`1 < p < ∞` there is `C` with
`‖λ N_λ{φ_{j(u)} * g(x) : u ∈ {2^{jα}}}^{1/2}‖_p ≤ C ‖g‖_p` for all `g ∈ L^p`, `λ > 0`, where
`j(u) = dyadicIndex α u` (so that `u = 2^{jα} ↦ φ_j * g`). This is Proposition 2.1 of the paper
for `σ = φ dx` (Jones–Seeger–Wright). -/
theorem eLpNorm_jumpFunction_dyadicSet_conv_le (hn : 1 ≤ n) (φ : 𝓢(Rn n, ℂ))
    (hφ : ∫ x, φ x = 1) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ g : Rn n → ℂ, MemLp g (ENNReal.ofReal p) volume → ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction lam (dyadicSet α)
        (fun u => (jswDilate n φ (dyadicIndex α u) ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x)
          ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) volume ≤ C * eLpNorm g (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC⟩ := jsw_jump_inequality (by omega) φ hφ hp
  refine ⟨C, fun g hg lam hlam => le_of_eq_of_le ?_ (hC g hg lam hlam)⟩
  congr 1
  funext x
  rw [jumpFunction_dyadicSet_eq_jswJumpCount hα]
  simp_rw [dyadicIndex_dyadicPoint hα]

end DyadicJumps

section TsumMinkowski

/-- **Minkowski's inequality in `ℓ²(ℤ)`** for `[0, ∞]`-valued sequences:
`(∑ (aⱼ + bⱼ)²)^{1/2} ≤ (∑ aⱼ²)^{1/2} + (∑ bⱼ²)^{1/2}`. -/
theorem lj_tsum_sq_add_le (a b : ℤ → ℝ≥0∞) :
    (∑' j, (a j + b j) ^ 2) ^ (1 / 2 : ℝ) ≤
      (∑' j, a j ^ 2) ^ (1 / 2 : ℝ) + (∑' j, b j ^ 2) ^ (1 / 2 : ℝ) := by
  rw [ENNReal.tsum_eq_iSup_sum, show (⨆ s : Finset ℤ, ∑ j ∈ s, (a j + b j) ^ 2) ^ (1 / 2 : ℝ) =
    ⨆ s : Finset ℤ, (∑ j ∈ s, (a j + b j) ^ 2) ^ (1 / 2 : ℝ) from
    (ENNReal.orderIsoRpow (1 / 2) (by norm_num)).map_iSup _]
  refine iSup_le fun s => ?_
  have h := ENNReal.Lp_add_le s a b (p := 2) one_le_two
  simp only [ENNReal.rpow_two] at h
  refine h.trans (add_le_add ?_ ?_)
  · exact ENNReal.rpow_le_rpow (ENNReal.sum_le_tsum s) (by norm_num)
  · exact ENNReal.rpow_le_rpow (ENNReal.sum_le_tsum s) (by norm_num)

/-- **Countable Minkowski inequality** for `L^p` norms of `[0, ∞]`-valued functions
(`1 ≤ p < ∞`): `‖∑ₘ Fₘ‖_p ≤ ∑ₘ ‖Fₘ‖_p`. -/
theorem lj_eLpNorm_tsum_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F : ℤ → X → ℝ≥0∞} (hF : ∀ m, AEMeasurable (F m) μ) {p : ℝ} (hp : 1 ≤ p) :
    eLpNorm (fun x => ∑' m, F m x) (ENNReal.ofReal p) μ ≤
      ∑' m, eLpNorm (F m) (ENNReal.ofReal p) μ := by
  have heq : (fun x => ∑' m, F m x) = fun x => ⨆ s : Finset ℤ, ∑ m ∈ s, F m x := by
    funext x; exact ENNReal.tsum_eq_iSup_sum
  rw [heq]
  refine lj_eLpNorm_iSup_le (fun s => Finset.aemeasurable_fun_sum _ fun m _ => hF m)
    (fun s t => ⟨s ∪ t, fun x => Finset.sum_le_sum_of_subset Finset.subset_union_left,
      fun x => Finset.sum_le_sum_of_subset Finset.subset_union_right⟩) (by linarith) fun s => ?_
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using hp
  have h := eLpNorm_sum_le (μ := μ) (s := s) (f := F) hp1
  have heq2 : (∑ m ∈ s, F m) = fun x => ∑ m ∈ s, F m x := by
    funext x; exact Finset.sum_apply x s F
  rw [heq2] at h
  exact h.trans (ENNReal.sum_le_tsum s)

end TsumMinkowski

section Decomposition

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- `∫ κ(x - y) f(y) dy = ∫ κ(t) f(x - t) dt`. -/
theorem lj_integral_sub_mul (κ f : Rn n → ℂ) (x : Rn n) :
    ∫ y, κ (x - y) * f y = ∫ t, κ t * f (x - t) := by
  rw [← convolution_eq_integral_sub, convolution_def]; rfl

/-- The dilates of `k₀`: `2^{kn} k₀(2^k t) = φ_{-k}(t) K(t)`. -/
theorem IsHomogeneousCZKernel.lpDilate_ljAmp_apply (hΩ : IsHomogeneousCZKernel n Ω) (k : ℤ)
    (t : Rn n) :
    lpDilate n (ljAmp n Ω) k t = ((dyadicPhiScale n (-k) t * czKernel n Ω t : ℝ) : ℂ) := by
  have h := hΩ.lpDilate_ljOsc 1 0 k t
  rw [ljOsc_zero] at h
  rw [h]; simp

/-- **The oscillatory pieces sum to `𝓗^{(2^{jα})}`**: with `q_m = (q̃_{2^{mα}})_{-m}`,
`∑_m (q_m)_j * f(x) = 𝓗^{(2^{jα})} f(x)` (reindexing of (`eq:decompl`)). -/
theorem IsHomogeneousCZKernel.hasSum_osc_pieces (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) (x : Rn n) (j : ℤ) :
    HasSum (fun m : ℤ => ∫ y, lpDilate n (lpDilate n (ljOsc n α Ω (dyadicPoint α m)) (-m)) j
      (x - y) * f y) (modulatedSI n α Ω (dyadicPoint α j) f x) := by
  have hterm : ∀ m : ℤ, ∫ y, lpDilate n (lpDilate n (ljOsc n α Ω (dyadicPoint α m)) (-m)) j
      (x - y) * f y = modulatedPiece n α Ω (dyadicPoint α j) (m - j) f x := by
    intro m
    rw [lpDilate_lpDilate, lj_integral_sub_mul, modulatedPiece]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    dsimp only
    rw [hΩ.lpDilate_ljOsc]
    have hu : dyadicPoint α m * (2 : ℝ) ^ (((-m + j : ℤ) : ℝ) * α) = dyadicPoint α j := by
      rw [dyadicPoint, dyadicPoint, ← Real.rpow_add two_pos]
      congr 1; push_cast; ring
    rw [hu, show -(-m + j) = m - j by ring]
    ring
  simp_rw [hterm]
  have h := hΩ.hasSum_modulatedPiece hn hα (dyadicPoint α j) f x
  exact (Equiv.subRight j).hasSum_iff.2 h

/-- **The non-oscillatory pieces sum to `T = 𝓗^{(0)}`**: `∑_m (k_m)_j * f(x) = 𝓗^{(0)} f(x)`. -/
theorem IsHomogeneousCZKernel.hasSum_pieces (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) (x : Rn n) (j : ℤ) :
    HasSum (fun m : ℤ => ∫ y, lpDilate n (ljPiece n Ω m) j (x - y) * f y)
      (modulatedSI n α Ω 0 f x) := by
  have hterm : ∀ m : ℤ, ∫ y, lpDilate n (ljPiece n Ω m) j (x - y) * f y =
      modulatedPiece n α Ω 0 (m - j) f x := by
    intro m
    rw [ljPiece, lpDilate_lpDilate, lj_integral_sub_mul, modulatedPiece]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    dsimp only
    rw [hΩ.lpDilate_ljAmp_apply, show -(-m + j) = m - j by ring]
    simp only [Complex.ofReal_zero, mul_zero, zero_mul, Complex.exp_zero, mul_one]
    ring
  simp_rw [hterm]
  exact (Equiv.subRight j).hasSum_iff.2 (hΩ.hasSum_modulatedPiece hn hα 0 f x)

/-- `|∫ f| ≤ ∫ |f|` for Schwartz `f` as a real number. -/
theorem lj_integral_norm_schwartz (f : 𝓢(Rn n, ℂ)) : 0 ≤ ∫ x, ‖f x‖ :=
  integral_nonneg fun _ => norm_nonneg _

/-- **Uniform bounds for the pieces**: `|(k_ℓ * f)(z)| ≤ c_f 2^{-|ℓ|}` for all `z`, where
`k_ℓ = φ_ℓ K` (mean zero and the Lipschitz bound of `f` for `ℓ ≤ 0`; the sup bound of `k_ℓ`
and `f ∈ L¹` for `ℓ > 0`). -/
theorem IsHomogeneousCZKernel.exists_norm_piece_conv_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) (f : 𝓢(Rn n, ℂ)) :
    ∃ c, 0 ≤ c ∧ ∀ (ℓ : ℤ) (z : Rn n),
      ‖∫ y, lpDilate n (ljAmp n Ω) (-ℓ) (z - y) * f y‖ ≤ c * lpGeom ℓ := by
  obtain ⟨L, hL0, hL⟩ := exists_norm_sub_le_schwartz f
  obtain ⟨M₀, hM₀⟩ := hΩ.contDiff_ljAmp.continuous.bounded_above_of_compact_support
    hasCompactSupport_ljAmp
  have hA := ljA1_nonneg (n := n) (Ω := Ω)
  have hf1 := lj_integral_norm_schwartz f
  set c := max (2 * L * ljA1 n Ω) (max M₀ 0 * ∫ x, ‖f x‖) with hc
  refine ⟨c, le_max_of_le_left (by positivity), fun ℓ z => ?_⟩
  have hk := hΩ.ljKernel_ljPiece ℓ
  rw [ljPiece] at hk
  rw [lj_integral_sub_mul]
  rcases le_or_gt ℓ 0 with hℓ | hℓ
  · -- small scales: mean zero
    have hmean : ∫ t, lpDilate n (ljAmp n Ω) (-ℓ) t = 0 := by
      have := hΩ.integral_ljPiece hn ℓ; rwa [ljPiece] at this
    have heq : ∫ t, lpDilate n (ljAmp n Ω) (-ℓ) t * f (z - t) =
        ∫ t, lpDilate n (ljAmp n Ω) (-ℓ) t * (f (z - t) - f z) := by
      simp_rw [mul_sub]
      obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
      have hi1 : Integrable fun t => lpDilate n (ljAmp n Ω) (-ℓ) t * f (z - t) :=
        hk.integrable.mul_bdd (f.continuous.comp (continuous_const.sub
          continuous_id)).aestronglyMeasurable (Eventually.of_forall fun t => hCf _)
      rw [integral_sub hi1 (hk.integrable.mul_const _), integral_mul_const, hmean, zero_mul,
        sub_zero]
    rw [heq]
    have hR : (2 : ℝ) ^ ℓ * 2 = 2 * lpGeom ℓ := by
      rw [lpGeom, mul_comm]
      congr 1
      obtain ⟨k, rfl⟩ := Int.exists_eq_neg_ofNat hℓ
      rw [Int.natAbs_neg, Int.natAbs_natCast, zpow_neg, zpow_natCast, one_div, inv_pow]
    calc ‖∫ t, lpDilate n (ljAmp n Ω) (-ℓ) t * (f (z - t) - f z)‖
        ≤ ∫ t, ‖lpDilate n (ljAmp n Ω) (-ℓ) t‖ * (L * (2 * lpGeom ℓ)) := by
          refine norm_integral_le_of_norm_le (hk.integrable.norm.mul_const _)
            (Eventually.of_forall fun t => ?_)
          rw [norm_mul]
          by_cases ht : lpDilate n (ljAmp n Ω) (-ℓ) t = 0
          · simp [ht]
          · gcongr
            have hts : ‖t‖ ≤ (2 : ℝ) ^ ℓ * 2 := by
              by_contra h; exact ht (hk.eq_zero t (not_le.1 h))
            calc ‖f (z - t) - f z‖ ≤ L * ‖z - t - z‖ := hL _ _
              _ = L * ‖t‖ := by rw [sub_sub_cancel_left, norm_neg]
              _ ≤ L * (2 * lpGeom ℓ) := by rw [← hR]; gcongr
      _ = (∫ t, ‖lpDilate n (ljAmp n Ω) (-ℓ) t‖) * (L * (2 * lpGeom ℓ)) := integral_mul_const _ _
      _ ≤ ljA1 n Ω * (L * (2 * lpGeom ℓ)) := by
          gcongr
          · exact mul_nonneg hL0 (mul_nonneg zero_le_two (lpGeom_nonneg _))
          · exact hk.integral_norm_le hA
      _ = 2 * L * ljA1 n Ω * lpGeom ℓ := by ring
      _ ≤ c * lpGeom ℓ := mul_le_mul_of_nonneg_right (le_max_left _ _) (lpGeom_nonneg _)
  · -- large scales: sup bound of the kernel
    have hsup : ∀ t, ‖lpDilate n (ljAmp n Ω) (-ℓ) t‖ ≤ max M₀ 0 * lpGeom ℓ := by
      intro t
      rw [lpDilate_apply_ofReal, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      have h1 : (2 : ℝ) ^ (-ℓ * n) ≤ lpGeom ℓ := by
        obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hℓ.le
        rw [lpGeom, Int.natAbs_natCast, one_div, inv_pow, ← zpow_natCast, ← zpow_neg]
        refine zpow_le_zpow_right₀ one_le_two ?_
        have : (1 : ℤ) ≤ n := by exact_mod_cast hn
        nlinarith
      calc (2 : ℝ) ^ (-ℓ * n) * ‖ljAmp n Ω ((2 : ℝ) ^ (-ℓ) • t)‖
          ≤ lpGeom ℓ * max M₀ 0 := by
            gcongr
            · exact lpGeom_nonneg _
            · exact (hM₀ _).trans (le_max_left _ _)
        _ = max M₀ 0 * lpGeom ℓ := mul_comm _ _
    calc ‖∫ t, lpDilate n (ljAmp n Ω) (-ℓ) t * f (z - t)‖
        ≤ ∫ t, max M₀ 0 * lpGeom ℓ * ‖f (z - t)‖ := by
          refine norm_integral_le_of_norm_le ((f.integrable.comp_sub_left z).norm.const_mul _)
            (Eventually.of_forall fun t => ?_)
          rw [norm_mul]
          gcongr
          exact hsup t
      _ = max M₀ 0 * lpGeom ℓ * ∫ t, ‖f t‖ := by
          rw [integral_const_mul]
          congr 1
          exact integral_sub_left_eq_self (fun t => ‖f t‖) volume z
      _ = max M₀ 0 * (∫ t, ‖f t‖) * lpGeom ℓ := by ring
      _ ≤ c * lpGeom ℓ := mul_le_mul_of_nonneg_right (le_max_right _ _) (lpGeom_nonneg _)


/-- **Dilation commutes with convolution**: `(φ * g)_j = φ_j * g_j`. -/
theorem lpDilate_convolution (φ g : Rn n → ℂ) (j : ℤ) :
    lpDilate n (φ ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) j =
      lpDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] lpDilate n g j := by
  funext x
  have h2j : (0 : ℝ) < 2 ^ j := zpow_pos two_pos j
  set c : ℝ := (2 : ℝ) ^ (j * n) with hc
  have hc' : c = ((2 : ℝ) ^ j) ^ n := by rw [hc, zpow_mul, zpow_natCast]
  have hc0 : 0 < c := by positivity
  rw [lpDilate_apply_ofReal, convolution_def, convolution_def]
  simp only [ContinuousLinearMap.mul_apply', lpDilate_apply_ofReal, smul_sub]
  have e1 : (fun t : Rn n => ((c : ℝ) : ℂ) * φ ((2 : ℝ) ^ j • t) *
      (((c : ℝ) : ℂ) * g ((2 : ℝ) ^ j • x - (2 : ℝ) ^ j • t))) =
      fun t => (((c : ℝ) : ℂ) * ((c : ℝ) : ℂ)) *
        (fun s => φ s * g ((2 : ℝ) ^ j • x - s)) ((2 : ℝ) ^ j • t) := by
    funext t; ring
  rw [e1, integral_const_mul,
    Measure.integral_comp_smul volume (fun s => φ s * g ((2 : ℝ) ^ j • x - s)) ((2 : ℝ) ^ j),
    finrank_euclideanSpace_fin, abs_of_pos (by positivity), ← hc', Complex.real_smul]
  have : ((c : ℝ) : ℂ) * ((c : ℝ) : ℂ) * ((c⁻¹ : ℝ) : ℂ) = ((c : ℝ) : ℂ) := by
    rw [mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ hc0.ne', Complex.ofReal_one, mul_one]
  rw [← mul_assoc, this]

/-- **Fubini identity**: `∫ φ_j(t) ((k_m)_j * f)(x - t) dt = ((φ * k_m)_j * f)(x)`. -/
theorem IsHomogeneousCZKernel.integral_bump_mul_conv (hΩ : IsHomogeneousCZKernel n Ω)
    (m j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    ∫ t, lpDilate n (ljBump n) j t * ∫ y, lpDilate n (ljPiece n Ω m) j (x - t - y) * f y =
      ∫ y, lpDilate n (ljConv n Ω m) j (x - y) * f y := by
  set φ' := lpDilate n (ljBump n) j with hφ'
  set κ := lpDilate n (ljPiece n Ω m) j with hκ
  have hφc : Continuous φ' := continuous_lpDilate (contDiff_ljBump n).continuous j
  have hφi : Integrable φ' := integrable_lpDilate (integrable_ljBump n) j
  have hκk := (hΩ.ljKernel_ljPiece m).dilate j
  have hκc : Continuous κ := hκk.continuous
  obtain ⟨Mκ, hMκ⟩ := hκc.bounded_above_of_compact_support hκk.hasCompactSupport
  have hint : Integrable (Function.uncurry fun t y => φ' t * (κ (x - t - y) * f y))
      (volume.prod volume) := by
    have hprod : Integrable (fun p : Rn n × Rn n => ‖φ' p.1‖ * (max Mκ 0 * ‖f p.2‖))
        (volume.prod volume) := by
      have := hφi.norm.mul_prod ((f.integrable (μ := volume)).norm.const_mul (max Mκ 0))
      exact this
    refine hprod.mono' ?_ (Eventually.of_forall fun p => ?_)
    · exact (by fun_prop : Continuous fun p : Rn n × Rn n =>
        φ' p.1 * (κ (x - p.1 - p.2) * f p.2)).aestronglyMeasurable
    · simp only [Function.uncurry, norm_mul]
      gcongr
      exact (hMκ _).trans (le_max_left _ _)
  calc ∫ t, φ' t * ∫ y, κ (x - t - y) * f y
      = ∫ t, ∫ y, φ' t * (κ (x - t - y) * f y) := by
        refine integral_congr_ae (Eventually.of_forall fun t => ?_)
        exact (integral_const_mul _ _).symm
    _ = ∫ y, ∫ t, φ' t * (κ (x - t - y) * f y) := integral_integral_swap hint
    _ = ∫ y, (∫ t, φ' t * κ (x - y - t)) * f y := by
        refine integral_congr_ae (Eventually.of_forall fun y => ?_)
        dsimp only
        rw [← integral_mul_const]
        refine integral_congr_ae (Eventually.of_forall fun t => ?_)
        simp only [sub_right_comm x t y]
        ring
    _ = ∫ y, lpDilate n (ljConv n Ω m) j (x - y) * f y := by
        refine integral_congr_ae (Eventually.of_forall fun y => ?_)
        dsimp only
        rw [ljConv, lpDilate_convolution, convolution_def]
        rfl

/-- **The bump-smoothed pieces sum to `φ_j * T`** (dominated convergence; the pieces are
bounded by `c_f 2^{-|m-j|}` uniformly): `∑_m ((φ * k_m)_j * f)(x) = (φ_j * 𝓗^{(0)} f)(x)`. -/
theorem IsHomogeneousCZKernel.hasSum_conv_pieces (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) (x : Rn n) (j : ℤ) :
    HasSum (fun m : ℤ => ∫ y, lpDilate n (ljConv n Ω m) j (x - y) * f y)
      ((jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (fun z => modulatedSI n α Ω 0 f z)) x) := by
  rw [coe_ljBumpSchwartz, jswDilate_eq_lpDilate, convolution_def]
  simp only [ContinuousLinearMap.mul_apply']
  set φ' := lpDilate n (ljBump n) j with hφ'
  have hφc : Continuous φ' := continuous_lpDilate (contDiff_ljBump n).continuous j
  have hφi : Integrable φ' := integrable_lpDilate (integrable_ljBump n) j
  obtain ⟨c, hc0, hc⟩ := hΩ.exists_norm_piece_conv_le hn f
  have hκ : ∀ m : ℤ, lpDilate n (ljPiece n Ω m) j = lpDilate n (ljAmp n Ω) (-(m - j)) := by
    intro m; rw [ljPiece, lpDilate_lpDilate]; congr 1; ring
  have hP : ∀ (m : ℤ) (z : Rn n),
      ‖∫ y, lpDilate n (ljPiece n Ω m) j (z - y) * f y‖ ≤ c * lpGeom (m - j) := by
    intro m z; rw [hκ]; exact hc _ z
  have hPc : ∀ m : ℤ, Continuous fun z => ∫ y, lpDilate n (ljPiece n Ω m) j (z - y) * f y := by
    intro m
    have hk := (hΩ.ljKernel_ljPiece m).dilate j
    have := hk.hasCompactSupport.continuous_convolution_left (ContinuousLinearMap.mul ℂ ℂ)
      hk.continuous (μ := volume) f.integrable.locallyIntegrable
    refine this.congr fun z => ?_
    exact convolution_eq_integral_sub _ _ z
  have hsum : Summable fun m : ℤ => lpGeom (m - j) :=
    summable_lpGeom.comp_injective (sub_left_injective)
  have key := hasSum_integral_of_dominated_convergence
    (F := fun (m : ℤ) (t : Rn n) =>
      φ' t * ∫ y, lpDilate n (ljPiece n Ω m) j (x - t - y) * f y)
    (f := fun t => φ' t * modulatedSI n α Ω 0 f (x - t))
    (fun m t => ‖φ' t‖ * (c * lpGeom (m - j)))
    (fun m => (hφc.mul ((hPc m).comp (continuous_const.sub continuous_id))).aestronglyMeasurable)
    (fun m => Eventually.of_forall fun t => by
      rw [norm_mul]; gcongr; exact hP m _)
    (Eventually.of_forall fun t => (hsum.mul_left c).mul_left _)
    (by
      simp_rw [tsum_mul_left]
      exact hφi.norm.mul_const _)
    (Eventually.of_forall fun t => (hΩ.hasSum_pieces hn hα f (x - t) j).mul_left (φ' t))
  refine key.congr_fun ?_
  intro m
  exact (hΩ.integral_bump_mul_conv m j f x).symm

/-- The kernels `ψ^m = (q̃_{2^{mα}})_{-m} - k_m + φ * k_m` of the decomposition
`𝓗^{(2^{jα})} f - (T f - φ_j * T f) = ∑_m (ψ^m)_j * f`. -/
noncomputable def ljPsi (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (m : ℤ) (t : Rn n) : ℂ :=
  lpDilate n (ljOsc n α Ω (dyadicPoint α m)) (-m) t - ljPiece n Ω m t + ljConv n Ω m t

/-- **The decomposition** (§3, smooth version, with all `c_ℓ = 0`): for Schwartz `f`,
`𝓗^{(2^{jα})} f(x) - (T f(x) - φ_j * T f(x)) = ∑_{m ∈ ℤ} (ψ^m)_j * f(x)`, `T = 𝓗^{(0)}`. -/
theorem IsHomogeneousCZKernel.hasSum_ljPsi (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) (x : Rn n) (j : ℤ) :
    HasSum (fun m : ℤ => ∫ y, lpDilate n (ljPsi n α Ω m) j (x - y) * f y)
      (modulatedSI n α Ω (dyadicPoint α j) f x - (modulatedSI n α Ω 0 f x -
        (jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
          (fun z => modulatedSI n α Ω 0 f z)) x)) := by
  obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
  have hint : ∀ K : Rn n → ℂ, Integrable K → Integrable fun y => K (x - y) * f y := fun K hK =>
    (hK.comp_sub_left x).mul_bdd f.continuous.aestronglyMeasurable
      (Eventually.of_forall fun y => hCf y)
  have hterm : ∀ m : ℤ, ∫ y, lpDilate n (ljPsi n α Ω m) j (x - y) * f y =
      (∫ y, lpDilate n (lpDilate n (ljOsc n α Ω (dyadicPoint α m)) (-m)) j (x - y) * f y) -
        (∫ y, lpDilate n (ljPiece n Ω m) j (x - y) * f y) +
        ∫ y, lpDilate n (ljConv n Ω m) j (x - y) * f y := by
    intro m
    have h1 : Integrable (lpDilate n (lpDilate n (ljOsc n α Ω (dyadicPoint α m)) (-m)) j) :=
      integrable_lpDilate (integrable_lpDilate (hΩ.integrable_ljOsc α _) _) j
    have h2 : Integrable (lpDilate n (ljPiece n Ω m) j) :=
      integrable_lpDilate (hΩ.ljKernel_ljPiece m).integrable j
    have h3 : Integrable (lpDilate n (ljConv n Ω m) j) :=
      integrable_lpDilate ((hΩ.ljKernel_ljPiece m).conv_meanZero (by positivity) ljA1_nonneg
        (hΩ.integral_ljPiece hn m)).integrable j
    rw [← integral_sub (hint _ h1) (hint _ h2)]
    rw [← integral_add (f := fun y =>
      lpDilate n (lpDilate n (ljOsc n α Ω (dyadicPoint α m)) (-m)) j (x - y) * f y -
        lpDilate n (ljPiece n Ω m) j (x - y) * f y) ((hint _ h1).sub (hint _ h2)) (hint _ h3)]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    simp only [ljPsi, lpDilate]
    ring
  simp_rw [hterm]
  have h := ((hΩ.hasSum_osc_pieces hn hα f x j).sub (hΩ.hasSum_pieces hn hα f x j)).add
    (hΩ.hasSum_conv_pieces hn hα f x j)
  convert h using 1
  ring

end Decomposition

section SquareFunctionAssembly

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- `‖c F‖_p = c ‖F‖_p` for `[0, ∞]`-valued `F` (`0 < p < ∞`). -/
theorem lj_eLpNorm_const_mul {X : Type*} [MeasurableSpace X] {μ : Measure X} (c : ℝ≥0∞)
    {F : X → ℝ≥0∞} (hF : AEMeasurable F μ) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x => c * F x) (ENNReal.ofReal p) μ = c * eLpNorm F (ENNReal.ofReal p) μ := by
  rw [lj_eLpNorm_ennreal_eq (hF.const_mul c) hp, lj_eLpNorm_ennreal_eq hF hp]
  simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le]
  rw [lintegral_const_mul'' _ (hF.pow_const p), ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    rpow_rpow_one_div hp.ne']

/-- **Sublinearity of the square function in the kernel**:
`S(ψ₁ + ψ₂) f ≤ S(ψ₁) f + S(ψ₂) f` pointwise (integrable kernels, bounded continuous `f`). -/
theorem ljSq_add_le {ψ₁ ψ₂ : Rn n → ℂ} (h₁ : Integrable ψ₁) (h₂ : Integrable ψ₂)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    ljSq n (fun t => ψ₁ t + ψ₂ t) f x ≤ ljSq n ψ₁ f x + ljSq n ψ₂ f x := by
  obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
  have hint : ∀ K : Rn n → ℂ, Integrable K → Integrable fun y => K (x - y) * f y := fun K hK =>
    (hK.comp_sub_left x).mul_bdd f.continuous.aestronglyMeasurable
      (Eventually.of_forall fun y => hCf y)
  have hj : ∀ j : ℤ, ∫ y, lpDilate n (fun t => ψ₁ t + ψ₂ t) j (x - y) * f y =
      (∫ y, lpDilate n ψ₁ j (x - y) * f y) + ∫ y, lpDilate n ψ₂ j (x - y) * f y := by
    intro j
    rw [← integral_add (hint _ (integrable_lpDilate h₁ j)) (hint _ (integrable_lpDilate h₂ j)),
      lpDilate_add]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    ring
  unfold ljSq
  simp_rw [hj]
  refine le_trans ?_ (lj_tsum_sq_add_le _ _)
  refine ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun j => ?_) (by norm_num)
  exact pow_le_pow_left₀ zero_le (enorm_add_le _ _) 2

/-- The kernels `ψ^m` are integrable. -/
theorem IsHomogeneousCZKernel.integrable_ljPsi (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    (α : ℝ) (m : ℤ) : Integrable (ljPsi n α Ω m) := by
  have h1 := integrable_lpDilate (hΩ.integrable_ljOsc α (dyadicPoint α m)) (-m)
  have h2 := (hΩ.ljKernel_ljPiece m).integrable
  have h3 := ((hΩ.ljKernel_ljPiece m).conv_meanZero (by positivity) ljA1_nonneg
    (hΩ.integral_ljPiece hn m)).integrable
  exact (h1.sub h2).add h3

/-- **Pointwise square-function bound for the decomposition**:
`(∑_j |∑_m (ψ^m)_j * f(x)|²)^{1/2} ≤ ∑_m (∑_j |(ψ^m)_j * f(x)|²)^{1/2}`. -/
theorem lj_tsum_sq_hasSum_le {c : ℤ → ℤ → ℂ} {D : ℤ → ℂ} (hD : ∀ j, HasSum (fun m => c m j) (D j)) :
    (∑' j, ‖D j‖ₑ ^ 2) ^ (1 / 2 : ℝ) ≤ ∑' m, (∑' j, ‖c m j‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
  rw [ENNReal.tsum_eq_iSup_sum, show (⨆ J : Finset ℤ, ∑ j ∈ J, ‖D j‖ₑ ^ 2) ^ (1 / 2 : ℝ) =
    ⨆ J : Finset ℤ, (∑ j ∈ J, ‖D j‖ₑ ^ 2) ^ (1 / 2 : ℝ) from
    (ENNReal.orderIsoRpow (1 / 2) (by norm_num)).map_iSup _]
  refine iSup_le fun J => ?_
  rw [← lj_ofReal_sqrt_sum_sq]
  -- finite Minkowski for finite sets of `m`
  have hfin : ∀ M : Finset ℤ, √(∑ j ∈ J, ‖∑ m ∈ M, c m j‖ ^ 2) ≤
      ∑ m ∈ M, √(∑ j ∈ J, ‖c m j‖ ^ 2) := by
    intro M
    induction M using Finset.induction_on with
    | empty => simp
    | insert a M ha ih =>
      rw [Finset.sum_insert ha]
      simp_rw [Finset.sum_insert ha]
      exact (lj_sqrt_sum_norm_add_le J _ _).trans (by linarith)
  have hlim : Tendsto (fun M : Finset ℤ => ENNReal.ofReal √(∑ j ∈ J, ‖∑ m ∈ M, c m j‖ ^ 2))
      atTop (𝓝 (ENNReal.ofReal √(∑ j ∈ J, ‖D j‖ ^ 2))) := by
    refine ENNReal.tendsto_ofReal (Real.continuous_sqrt.tendsto _ |>.comp ?_)
    refine tendsto_finsetSum _ fun j _ => ?_
    exact ((continuous_norm.tendsto _).comp (hD j)).pow 2
  refine le_of_tendsto' hlim fun M => ?_
  calc ENNReal.ofReal √(∑ j ∈ J, ‖∑ m ∈ M, c m j‖ ^ 2)
      ≤ ENNReal.ofReal (∑ m ∈ M, √(∑ j ∈ J, ‖c m j‖ ^ 2)) := ENNReal.ofReal_le_ofReal (hfin M)
    _ = ∑ m ∈ M, ENNReal.ofReal √(∑ j ∈ J, ‖c m j‖ ^ 2) :=
        ENNReal.ofReal_sum_of_nonneg fun m _ => Real.sqrt_nonneg _
    _ ≤ ∑ m ∈ M, (∑' j, ‖c m j‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
        refine Finset.sum_le_sum fun m _ => ?_
        rw [lj_ofReal_sqrt_sum_sq]
        exact ENNReal.rpow_le_rpow (ENNReal.sum_le_tsum J) (by norm_num)
    _ ≤ ∑' m, (∑' j, ‖c m j‖ₑ ^ 2) ^ (1 / 2 : ℝ) := ENNReal.sum_le_tsum M


/-- `2^{a} ≤ 2^{b}` for `a ≤ b` (real exponents). -/
theorem lj_two_rpow_le {a b : ℝ} (h : a ≤ b) : (2 : ℝ) ^ a ≤ (2 : ℝ) ^ b :=
  Real.rpow_le_rpow_of_exponent_le one_le_two h

/-- `(2^{-ε})^{|m|} = 2^{-ε |m|}`. -/
theorem lj_geom_eq (ε : ℝ) (m : ℤ) :
    ((2 : ℝ) ^ (-ε)) ^ m.natAbs = (2 : ℝ) ^ (-ε * |(m : ℝ)|) := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), Nat.cast_natAbs, Int.cast_abs]

/-- `√(2^m) = 2^{m/2}`. -/
theorem lj_sqrt_two_zpow (m : ℤ) : √((2 : ℝ) ^ m) = (2 : ℝ) ^ ((m : ℝ) / 2) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]
  ring_nf

set_option maxHeartbeats 1000000 in
-- The proof treats the two ranges of `m` with long computations.
/-- **The square functions of the decomposition are summable in `L^p`**: for `α > 1`,
`1 < p < ∞` there is `K` with `‖∑_m (∑_j |(ψ^m)_j * f|²)^{1/2}‖_p ≤ K ‖f‖_p` for Schwartz `f`
(the bounds `‖·‖_p ≲ 2^{-ε|m|} ‖f‖_p` of the four families, summed over `m ∈ ℤ`). -/
theorem IsHomogeneousCZKernel.exists_eLpNorm_tsum_ljSq_ljPsi_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => ∑' m, ljSq n (ljPsi n α Ω m) f x) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal K * eLpNorm f (ENNReal.ofReal p) volume := by
  have hα0 : 0 < α := by linarith
  obtain ⟨C₁, hC₁, h₁⟩ := hΩ.eLpNorm_ljSq_osc_sub_le hn hα hp
  obtain ⟨C₂, hC₂, h₂⟩ := hΩ.eLpNorm_ljSq_conv_le hn hp
  obtain ⟨C₃, γ, hC₃, hγ, h₃⟩ := hΩ.eLpNorm_ljSq_osc_le hn hα hp
  obtain ⟨C₄, hC₄, h₄⟩ := hΩ.eLpNorm_ljSq_conv_sub_le hn hp
  set ε := min (min α (1 / 2)) (γ * α) with hε
  have hε0 : 0 < ε := lt_min (lt_min hα0 (by norm_num)) (by positivity)
  have hεα : ε ≤ α := (min_le_left _ _).trans (min_le_left _ _)
  have hε2 : ε ≤ 1 / 2 := (min_le_left _ _).trans (min_le_right _ _)
  have hεγ : ε ≤ γ * α := min_le_right _ _
  set Ctot := C₁ + C₂ + C₃ + C₄ with hCtot
  have hCtot0 : 0 ≤ Ctot := by positivity
  have hp0 : 0 < p := by linarith
  have hmeas : ∀ (ψ : Rn n → ℂ), Integrable ψ → ∀ f : 𝓢(Rn n, ℂ),
      AEMeasurable (ljSq n ψ f) := fun ψ hψ f => lj_aemeasurable_ljSq hψ hp.le (f.memLp _)
  have hm : ∀ (m : ℤ) (f : 𝓢(Rn n, ℂ)), eLpNorm (ljSq n (ljPsi n α Ω m) f) (ENNReal.ofReal p)
      volume ≤ ENNReal.ofReal (Ctot * ((2 : ℝ) ^ (-ε)) ^ m.natAbs) *
        eLpNorm f (ENNReal.ofReal p) volume := by
    intro m f
    have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using hp.le
    have hgeom := lj_geom_eq ε m
    rcases lt_or_ge m 0 with hm0 | hm0
    · -- m < 0: `ψ^m = (q̃ - k₀)_{-m} + φ * k_m`
      have habs : |(m : ℝ)| = -m := abs_of_neg (by exact_mod_cast hm0)
      set ψ₁ : Rn n → ℂ := fun t => ljOsc n α Ω (dyadicPoint α m) t - ljAmp n Ω t
      have hψ₁ : Integrable ψ₁ := (hΩ.integrable_ljOsc α _).sub hΩ.integrable_ljAmp
      have hχ : Integrable (ljConv n Ω m) := ((hΩ.ljKernel_ljPiece m).conv_meanZero
        (by positivity) ljA1_nonneg (hΩ.integral_ljPiece hn m)).integrable
      have heq : ljPsi n α Ω m = fun t => lpDilate n ψ₁ (-m) t + ljConv n Ω m t := by
        funext t; simp only [ljPsi, ljPiece, ψ₁, lpDilate]; ring
      have hpt : ∀ x, ljSq n (ljPsi n α Ω m) f x ≤ ljSq n ψ₁ f x + ljSq n (ljConv n Ω m) f x := by
        intro x
        rw [heq, ← ljSq_lpDilate ψ₁ (-m) f]
        exact ljSq_add_le (integrable_lpDilate hψ₁ _) hχ f x
      have hb1 := h₁ (dyadicPoint α m) (dyadicPoint_pos α m).le f (f.memLp _)
      have hb2 := h₂ m hm0.le f (f.memLp _)
      have hlb : dyadicPoint α m ≤ ((2 : ℝ) ^ (-ε)) ^ m.natAbs := by
        rw [hgeom, habs, dyadicPoint]
        refine lj_two_rpow_le ?_
        have : (m : ℝ) ≤ 0 := by exact_mod_cast hm0.le
        nlinarith
      have hs : √((2 : ℝ) ^ m) ≤ ((2 : ℝ) ^ (-ε)) ^ m.natAbs := by
        rw [hgeom, habs, lj_sqrt_two_zpow]
        refine lj_two_rpow_le ?_
        have : (m : ℝ) ≤ 0 := by exact_mod_cast hm0.le
        nlinarith
      calc eLpNorm (ljSq n (ljPsi n α Ω m) f) (ENNReal.ofReal p) volume
          ≤ eLpNorm (fun x => ljSq n ψ₁ f x + ljSq n (ljConv n Ω m) f x)
              (ENNReal.ofReal p) volume :=
            eLpNorm_mono_enorm (hmeas _ (hΩ.integrable_ljPsi hn α m) f).aestronglyMeasurable
              fun x => by simpa using hpt x
        _ ≤ eLpNorm (ljSq n ψ₁ f) (ENNReal.ofReal p) volume +
              eLpNorm (ljSq n (ljConv n Ω m) f) (ENNReal.ofReal p) volume :=
            eLpNorm_add_le hp1
        _ ≤ ENNReal.ofReal (C₁ * dyadicPoint α m) * eLpNorm f (ENNReal.ofReal p) volume +
              ENNReal.ofReal (C₂ * √((2 : ℝ) ^ m)) * eLpNorm f (ENNReal.ofReal p) volume :=
            add_le_add hb1 hb2
        _ = ENNReal.ofReal (C₁ * dyadicPoint α m + C₂ * √((2 : ℝ) ^ m)) *
              eLpNorm f (ENNReal.ofReal p) volume := by
            rw [← add_mul, ENNReal.ofReal_add (mul_nonneg hC₁ (dyadicPoint_pos α m).le)
              (mul_nonneg hC₂ (Real.sqrt_nonneg _))]
        _ ≤ ENNReal.ofReal (Ctot * ((2 : ℝ) ^ (-ε)) ^ m.natAbs) *
              eLpNorm f (ENNReal.ofReal p) volume := by
            refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) zero_le
            have hr : 0 ≤ ((2 : ℝ) ^ (-ε)) ^ m.natAbs := by positivity
            nlinarith [mul_le_mul_of_nonneg_left hlb hC₁, mul_le_mul_of_nonneg_left hs hC₂]
    · -- m ≥ 0: `ψ^m = (q̃)_{-m} + (φ * k_m - k_m)`
      have habs : |(m : ℝ)| = m := abs_of_nonneg (by exact_mod_cast hm0)
      set ψ₂ : Rn n → ℂ := fun t => ljConv n Ω m t - ljPiece n Ω m t
      have hχ : Integrable (ljConv n Ω m) := ((hΩ.ljKernel_ljPiece m).conv_meanZero
        (by positivity) ljA1_nonneg (hΩ.integral_ljPiece hn m)).integrable
      have hψ₂ : Integrable ψ₂ := hχ.sub (hΩ.ljKernel_ljPiece m).integrable
      have hq : Integrable (ljOsc n α Ω (dyadicPoint α m)) := hΩ.integrable_ljOsc α _
      have heq : ljPsi n α Ω m =
          fun t => lpDilate n (ljOsc n α Ω (dyadicPoint α m)) (-m) t + ψ₂ t := by
        funext t; simp only [ljPsi, ψ₂]; ring
      have hpt : ∀ x, ljSq n (ljPsi n α Ω m) f x ≤
          ljSq n (ljOsc n α Ω (dyadicPoint α m)) f x + ljSq n ψ₂ f x := by
        intro x
        rw [heq, ← ljSq_lpDilate (ljOsc n α Ω (dyadicPoint α m)) (-m) f]
        exact ljSq_add_le (integrable_lpDilate hq _) hψ₂ f x
      have hlam1 : 1 ≤ dyadicPoint α m := by
        rw [dyadicPoint]
        exact Real.one_le_rpow one_le_two (by
          have : (0 : ℝ) ≤ m := by exact_mod_cast hm0
          positivity)
      have hb3 := h₃ (dyadicPoint α m) hlam1 f
      have hb4 := h₄ m hm0 f (f.memLp _)
      have hlb : dyadicPoint α m ^ (-γ) ≤ ((2 : ℝ) ^ (-ε)) ^ m.natAbs := by
        rw [hgeom, habs, dyadicPoint, ← Real.rpow_mul (by norm_num)]
        refine lj_two_rpow_le ?_
        have : (0 : ℝ) ≤ m := by exact_mod_cast hm0
        nlinarith
      have hs : √((2 : ℝ) ^ (-m)) ≤ ((2 : ℝ) ^ (-ε)) ^ m.natAbs := by
        rw [hgeom, habs, lj_sqrt_two_zpow]
        refine lj_two_rpow_le ?_
        have : (0 : ℝ) ≤ m := by exact_mod_cast hm0
        push_cast
        nlinarith
      calc eLpNorm (ljSq n (ljPsi n α Ω m) f) (ENNReal.ofReal p) volume
          ≤ eLpNorm (fun x => ljSq n (ljOsc n α Ω (dyadicPoint α m)) f x + ljSq n ψ₂ f x)
              (ENNReal.ofReal p) volume :=
            eLpNorm_mono_enorm (hmeas _ (hΩ.integrable_ljPsi hn α m) f).aestronglyMeasurable
              fun x => by simpa using hpt x
        _ ≤ eLpNorm (ljSq n (ljOsc n α Ω (dyadicPoint α m)) f) (ENNReal.ofReal p) volume +
              eLpNorm (ljSq n ψ₂ f) (ENNReal.ofReal p) volume :=
            eLpNorm_add_le hp1
        _ ≤ ENNReal.ofReal (C₃ * dyadicPoint α m ^ (-γ)) * eLpNorm f (ENNReal.ofReal p) volume +
              ENNReal.ofReal (C₄ * √((2 : ℝ) ^ (-m))) * eLpNorm f (ENNReal.ofReal p) volume :=
            add_le_add hb3 hb4
        _ = ENNReal.ofReal (C₃ * dyadicPoint α m ^ (-γ) + C₄ * √((2 : ℝ) ^ (-m))) *
              eLpNorm f (ENNReal.ofReal p) volume := by
            rw [← add_mul, ENNReal.ofReal_add (mul_nonneg hC₃ (Real.rpow_nonneg
              (dyadicPoint_pos α m).le _)) (mul_nonneg hC₄ (Real.sqrt_nonneg _))]
        _ ≤ ENNReal.ofReal (Ctot * ((2 : ℝ) ^ (-ε)) ^ m.natAbs) *
              eLpNorm f (ENNReal.ofReal p) volume := by
            refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) zero_le
            have hr : 0 ≤ ((2 : ℝ) ^ (-ε)) ^ m.natAbs := by positivity
            nlinarith [mul_le_mul_of_nonneg_left hlb hC₃, mul_le_mul_of_nonneg_left hs hC₄]
  refine ⟨Ctot * ljGeom ε, mul_nonneg hCtot0 (ljGeom_nonneg ε), fun f => ?_⟩
  have hsum := lj_summable_geom hε0
  calc eLpNorm (fun x => ∑' m, ljSq n (ljPsi n α Ω m) f x) (ENNReal.ofReal p) volume
      ≤ ∑' m, eLpNorm (ljSq n (ljPsi n α Ω m) f) (ENNReal.ofReal p) volume :=
        lj_eLpNorm_tsum_le (fun m => hmeas _ (hΩ.integrable_ljPsi hn α m) f) hp.le
    _ ≤ ∑' m : ℤ, ENNReal.ofReal (Ctot * ((2 : ℝ) ^ (-ε)) ^ m.natAbs) *
          eLpNorm f (ENNReal.ofReal p) volume := ENNReal.tsum_le_tsum fun m => hm m f
    _ = ENNReal.ofReal (Ctot * ljGeom ε) * eLpNorm f (ENNReal.ofReal p) volume := by
        rw [ENNReal.tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg (fun m => by positivity)
          (hsum.mul_left Ctot), tsum_mul_left, ljGeom]

end SquareFunctionAssembly

section LongJumps

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- `∫ φ = 1` for the Schwartz bump. -/
theorem integral_ljBumpSchwartz (n : ℕ) : ∫ x, (ljBumpSchwartz n) x = 1 := by
  rw [coe_ljBumpSchwartz]; exact integral_ljBump n

/-- **Pointwise jump comparison for `𝓗^{(2^{jα})}`** (Lemma 1.3 type comparison with
`b_j = T f - φ_j * T f`, whose jumps are those of `φ_j * T f`):
`λ N_λ(𝓗 f(x))^{1/2} ≤ 3 (λ/3) N_{λ/3}(φ_j * Tf(x))^{1/2} + √18 ∑_m S(ψ^m) f(x)`. -/
theorem IsHomogeneousCZKernel.jump_pointwise_le (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) (lam : ℝ) (x : Rn n) :
    ENNReal.ofReal lam * jumpFunction lam (dyadicSet α) (fun u => modulatedSI n α Ω u f x)
        ^ (1 / 2 : ℝ) ≤
      3 * (ENNReal.ofReal (lam / 3) * jswJumpCount (lam / 3)
        (fun j => (jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
          (fun z => modulatedSI n α Ω 0 f z)) x) ^ (1 / 2 : ℝ)) +
      ENNReal.ofReal √18 * ∑' m, ljSq n (ljPsi n α Ω m) f x := by
  set T : Rn n → ℂ := fun z => modulatedSI n α Ω 0 f z with hT
  set a : ℝ → ℂ := fun u => modulatedSI n α Ω u f x with ha
  set b : ℝ → ℂ := fun u => T x - (jswDilate n (ljBumpSchwartz n) (dyadicIndex α u)
    ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] T) x with hb
  have h1 := sq_mul_jumpFunction_dyadicSet_le hα lam a b
  have hbj : ∀ j : ℤ, b (dyadicPoint α j) = T x - (jswDilate n (ljBumpSchwartz n) j
      ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] T) x := fun j => by
    simp only [hb, dyadicIndex_dyadicPoint hα]
  have hNb : jumpFunction (lam / 3) (dyadicSet α) b = jswJumpCount (lam / 3)
      (fun j => (jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] T) x) := by
    rw [jumpFunction_dyadicSet_eq_jswJumpCount hα]
    simp_rw [hbj]
    exact jswJumpCount_const_sub _ _ _
  have hS : (∑' j : ℤ, ‖a (dyadicPoint α j) - b (dyadicPoint α j)‖ₑ ^ 2) ^ (1 / 2 : ℝ) ≤
      ∑' m, ljSq n (ljPsi n α Ω m) f x := by
    refine lj_tsum_sq_hasSum_le (c := fun m j => ∫ y, lpDilate n (ljPsi n α Ω m) j (x - y) * f y)
      fun j => ?_
    rw [hbj]
    exact hΩ.hasSum_ljPsi hn hα f x j
  rw [hNb] at h1
  simp_rw [ENNReal.rpow_two] at h1
  have hL : ENNReal.ofReal lam * jumpFunction lam (dyadicSet α) a ^ (1 / 2 : ℝ) =
      (ENNReal.ofReal lam ^ 2 * jumpFunction lam (dyadicSet α) a) ^ (1 / 2 : ℝ) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_natCast,
      ← ENNReal.rpow_mul]
    norm_num
  rw [hL]
  refine (ENNReal.rpow_le_rpow h1 (by norm_num)).trans ?_
  refine (ENNReal.rpow_add_le_add_rpow _ _ (by norm_num) (by norm_num)).trans
    (add_le_add (le_of_eq ?_) ?_)
  · rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_natCast,
      ← ENNReal.rpow_mul]
    norm_num
    have h3 : ENNReal.ofReal lam = 3 * ENNReal.ofReal (lam / 3) := by
      rw [← ENNReal.ofReal_ofNat 3, ← ENNReal.ofReal_mul (by norm_num)]
      ring_nf
    rw [h3, mul_assoc]
  · rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
    have h18 : (18 : ℝ≥0∞) ^ (1 / 2 : ℝ) = ENNReal.ofReal √18 := by
      rw [Real.sqrt_eq_rpow, ← ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by norm_num),
        ENNReal.ofReal_ofNat]
    rw [h18]
    exact mul_le_mul_of_nonneg_left hS zero_le

/-- **Proposition 3.1 of the paper (`eq:Hk_jump`)**, for `α > 1`: for a homogeneous
Calderón–Zygmund kernel `Ω/|·|ⁿ`, `n ≥ 1` and `1 < p < ∞` there is `C` such that for all
Schwartz `f` and all `λ > 0`,
`‖λ N_λ{𝓗^{(2^{jα})} f : j ∈ ℤ}^{1/2}‖_p ≤ C ‖f‖_p`
(Section 3, "Long jump estimates"; the paper also allows `0 < α < 1`). -/
theorem IsHomogeneousCZKernel.eLpNorm_jumpFunction_dyadicSet_modulatedSI_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ), ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction lam (dyadicSet α)
        (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  have hα0 : 0 < α := by linarith
  have hp0 : 0 < p := by linarith
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using hp.le
  obtain ⟨CT, hCT⟩ := hΩ.eLpNorm_modulatedSI_zero_le hn hα0 hp
  obtain ⟨CJ, hCJ⟩ := jsw_jump_inequality (by omega) (ljBumpSchwartz n)
    (integral_ljBumpSchwartz n) hp
  obtain ⟨K, hK0, hK⟩ := hΩ.exists_eLpNorm_tsum_ljSq_ljPsi_le hn hα hp
  refine ⟨3 * CJ * CT + (√18 * K).toNNReal, fun f lam hlam => ?_⟩
  set T : Rn n → ℂ := fun z => modulatedSI n α Ω 0 f z with hT
  obtain ⟨hTm, hTb⟩ := hCT f
  set G : Rn n → ℝ≥0∞ := fun x => ENNReal.ofReal (lam / 3) * jswJumpCount (lam / 3)
    (fun j => (jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] T) x)
      ^ (1 / 2 : ℝ) with hG
  set S : Rn n → ℝ≥0∞ := fun x => ∑' m, ljSq n (ljPsi n α Ω m) f x with hS
  have hGm : AEMeasurable G := jsw_aemeasurable_jump _ (ljBumpSchwartz n).integrable
    hTm.aestronglyMeasurable (lam / 3)
  have hSm : AEMeasurable S := AEMeasurable.tsum fun m =>
    lj_aemeasurable_ljSq (hΩ.integrable_ljPsi hn α m) hp.le (f.memLp _)
  have hFm : AEStronglyMeasurable (fun x => ENNReal.ofReal lam * jumpFunction lam (dyadicSet α)
      (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ)) volume :=
    ((hΩ.measurable_jumpFunction_dyadicSet_modulatedSI hn hα0 f lam).pow_const _
      |>.const_mul _).aestronglyMeasurable
  have hGb : eLpNorm G (ENNReal.ofReal p) volume ≤ CJ * (CT * eLpNorm f (ENNReal.ofReal p)) :=
    (hCJ T hTm (lam / 3) (by positivity)).trans (by gcongr)
  calc eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction lam (dyadicSet α)
        (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) volume
      ≤ eLpNorm (fun x => 3 * G x + ENNReal.ofReal √18 * S x) (ENNReal.ofReal p) volume :=
        eLpNorm_mono_enorm hFm fun x => by
          rw [enorm_eq_self, enorm_eq_self]; exact hΩ.jump_pointwise_le hn hα0 f lam x
    _ ≤ eLpNorm (fun x => 3 * G x) (ENNReal.ofReal p) volume +
          eLpNorm (fun x => ENNReal.ofReal √18 * S x) (ENNReal.ofReal p) volume :=
        eLpNorm_add_le hp1
    _ = 3 * eLpNorm G (ENNReal.ofReal p) volume +
          ENNReal.ofReal √18 * eLpNorm S (ENNReal.ofReal p) volume := by
        rw [lj_eLpNorm_const_mul _ hGm hp0, lj_eLpNorm_const_mul _ hSm hp0]
    _ ≤ 3 * (CJ * (CT * eLpNorm f (ENNReal.ofReal p))) +
          ENNReal.ofReal √18 * (ENNReal.ofReal K * eLpNorm f (ENNReal.ofReal p)) := by
        gcongr
        exact hK f
    _ = _ := by
        rw [← mul_assoc (ENNReal.ofReal √18), ← ENNReal.ofReal_mul (Real.sqrt_nonneg _),
          ENNReal.coe_add]
        change _ = (_ + ENNReal.ofReal (√18 * K)) * _
        push_cast
        ring


/-- `N^{1/r} ≤ N^{1/2}` for jump counts (which are `0` or `≥ 1`) and `r ≥ 2`. -/
theorem jumpFunction_rpow_le_sqrt {lam : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ} {r : ℝ} (hr : 2 ≤ r) :
    jumpFunction lam 𝒥 a ^ (1 / r) ≤ jumpFunction lam 𝒥 a ^ (1 / 2 : ℝ) := by
  have hr0 : 0 < r := by linarith
  rcases eq_or_ne (jumpFunction lam 𝒥 a) 0 with h | h
  · rw [h, ENNReal.zero_rpow_of_pos (by positivity), ENNReal.zero_rpow_of_pos (by norm_num)]
  · have h1 := one_le_jumpFunction_of_pos (pos_iff_ne_zero.2 h)
    exact ENNReal.rpow_le_rpow_of_exponent_le h1
      (one_div_le_one_div_of_le (by norm_num) hr)

/-- **Proposition 1.4 of the paper (`main1`)**, for `α > 1`: for `1 < p < ∞` there is `C` such
that for all `r ≥ 2`, Schwartz `f` and `λ > 0`,
`‖λ (N^{dyad}_{λ/3}(𝓗 f))^{1/r}‖_p ≤ C ‖f‖_p`, where
`N^{dyad}_{λ}(𝓗 f)(x) = N_λ{𝓗^{(2^{jα})} f(x) : j ∈ ℤ}` (Section 1, Proposition 1.4). -/
theorem IsHomogeneousCZKernel.eLpNorm_jumpFunction_dyadicSet_rpow_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ r : ℝ, 2 ≤ r → ∀ f : 𝓢(Rn n, ℂ), ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction (lam / 3) (dyadicSet α)
        (fun u => modulatedSI n α Ω u f x) ^ (1 / r)) (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  have hα0 : 0 < α := by linarith
  have hp0 : 0 < p := by linarith
  obtain ⟨C, hC⟩ := hΩ.eLpNorm_jumpFunction_dyadicSet_modulatedSI_le hn hα hp
  refine ⟨3 * C, fun r hr f lam hlam => ?_⟩
  have h3 : ENNReal.ofReal lam = 3 * ENNReal.ofReal (lam / 3) := by
    rw [← ENNReal.ofReal_ofNat 3, ← ENNReal.ofReal_mul (by norm_num)]
    ring_nf
  have hm : AEMeasurable fun x => ENNReal.ofReal (lam / 3) * jumpFunction (lam / 3)
      (dyadicSet α) (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ) :=
    ((hΩ.measurable_jumpFunction_dyadicSet_modulatedSI hn hα0 f _).pow_const _
      |>.const_mul _).aemeasurable
  have hFm : AEStronglyMeasurable (fun x => ENNReal.ofReal lam * jumpFunction (lam / 3)
      (dyadicSet α) (fun u => modulatedSI n α Ω u f x) ^ (1 / r)) volume :=
    ((hΩ.measurable_jumpFunction_dyadicSet_modulatedSI hn hα0 f _).pow_const _
      |>.const_mul _).aestronglyMeasurable
  calc eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction (lam / 3) (dyadicSet α)
        (fun u => modulatedSI n α Ω u f x) ^ (1 / r)) (ENNReal.ofReal p) volume
      ≤ eLpNorm (fun x => 3 * (ENNReal.ofReal (lam / 3) * jumpFunction (lam / 3)
          (dyadicSet α) (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ)))
          (ENNReal.ofReal p) volume := by
        refine eLpNorm_mono_enorm hFm fun x => ?_
        rw [enorm_eq_self, enorm_eq_self, h3, mul_assoc]
        exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left
          (jumpFunction_rpow_le_sqrt hr) zero_le) zero_le
    _ = 3 * eLpNorm (fun x => ENNReal.ofReal (lam / 3) * jumpFunction (lam / 3)
          (dyadicSet α) (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ))
          (ENNReal.ofReal p) volume := lj_eLpNorm_const_mul _ hm hp0
    _ ≤ 3 * (C * eLpNorm f (ENNReal.ofReal p) volume) := by
        gcongr; exact hC f (lam / 3) (by positivity)
    _ = _ := by push_cast; ring

/-- **The long variation estimate** (`r > 2`; Bourgain's jump-to-variation argument applied to
Proposition 3.1 at two exponents around `p`): for `α > 1`, `1 < p < ∞`, `r > 2` there is `C`
with `‖V^r{𝓗^{(2^{jα})} f : j ∈ ℤ}‖_p ≤ C ‖f‖_p` for Schwartz `f`. -/
theorem IsHomogeneousCZKernel.eLpNorm_variationNorm_dyadicSet_modulatedSI_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p r : ℝ} (hp : 1 < p)
    (hr : 2 < r) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => variationNorm r (dyadicSet α) (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume := by
  have hα0 : 0 < α := by linarith
  have hp₀ : 1 < (1 + p) / 2 := by linarith
  have hp₁ : 1 < 2 * p := by linarith
  obtain ⟨C₀, h₀⟩ := hΩ.eLpNorm_jumpFunction_dyadicSet_modulatedSI_le hn hα hp₀
  obtain ⟨C₁, h₁⟩ := hΩ.eLpNorm_jumpFunction_dyadicSet_modulatedSI_le hn hα hp₁
  exact hΩ.eLpNorm_variationNorm_modulatedSI_le_of_jumpFunction hn hα0
    (Or.inl (countable_range _)) hp₀ (by linarith) (by linarith) hr h₀ h₁

end LongJumps

section SmoothTruncations

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- **Generic pointwise jump comparison** over the dyadic set: if
`a(2^{jα}) - c_j = ∑_m e_{m,j}` for every `j`, then
`λ N_λ(a)^{1/2} ≤ 3 (λ/3) N_{λ/3}(c)^{1/2} + √18 ∑_m (∑_j |e_{m,j}|²)^{1/2}`. -/
theorem lj_jump_pointwise_le {α : ℝ} (hα : 0 < α) (lam : ℝ) (a : ℝ → ℂ) (c : ℤ → ℂ)
    (e : ℤ → ℤ → ℂ) (he : ∀ j, HasSum (fun m => e m j) (a (dyadicPoint α j) - c j)) :
    ENNReal.ofReal lam * jumpFunction lam (dyadicSet α) a ^ (1 / 2 : ℝ) ≤
      3 * (ENNReal.ofReal (lam / 3) * jswJumpCount (lam / 3) c ^ (1 / 2 : ℝ)) +
      ENNReal.ofReal √18 * ∑' m, (∑' j, ‖e m j‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
  set b : ℝ → ℂ := fun u => c (dyadicIndex α u) with hb
  have h1 := sq_mul_jumpFunction_dyadicSet_le hα lam a b
  have hbj : ∀ j : ℤ, b (dyadicPoint α j) = c j := fun j => by
    simp only [hb, dyadicIndex_dyadicPoint hα]
  have hNb : jumpFunction (lam / 3) (dyadicSet α) b = jswJumpCount (lam / 3) c := by
    rw [jumpFunction_dyadicSet_eq_jswJumpCount hα]
    simp_rw [hbj]
  have hS : (∑' j : ℤ, ‖a (dyadicPoint α j) - b (dyadicPoint α j)‖ₑ ^ 2) ^ (1 / 2 : ℝ) ≤
      ∑' m, (∑' j, ‖e m j‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
    refine lj_tsum_sq_hasSum_le (c := e) fun j => ?_
    rw [hbj]
    exact he j
  rw [hNb] at h1
  simp_rw [ENNReal.rpow_two] at h1
  have hL : ENNReal.ofReal lam * jumpFunction lam (dyadicSet α) a ^ (1 / 2 : ℝ) =
      (ENNReal.ofReal lam ^ 2 * jumpFunction lam (dyadicSet α) a) ^ (1 / 2 : ℝ) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_natCast,
      ← ENNReal.rpow_mul]
    norm_num
  rw [hL]
  refine (ENNReal.rpow_le_rpow h1 (by norm_num)).trans ?_
  refine (ENNReal.rpow_add_le_add_rpow _ _ (by norm_num) (by norm_num)).trans
    (add_le_add (le_of_eq ?_) ?_)
  · rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_natCast,
      ← ENNReal.rpow_mul]
    norm_num
    have h3 : ENNReal.ofReal lam = 3 * ENNReal.ofReal (lam / 3) := by
      rw [← ENNReal.ofReal_ofNat 3, ← ENNReal.ofReal_mul (by norm_num)]
      ring_nf
    rw [h3, mul_assoc]
  · rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
    have h18 : (18 : ℝ≥0∞) ^ (1 / 2 : ℝ) = ENNReal.ofReal √18 := by
      rw [Real.sqrt_eq_rpow, ← ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by norm_num),
        ENNReal.ofReal_ofNat]
    rw [h18]
    exact mul_le_mul_of_nonneg_left hS zero_le

/-- The truncated pieces: `k_m` for `m ≥ 0`, `0` for `m < 0`. -/
noncomputable def ljTruncPiece (n : ℕ) (Ω : Rn n → ℝ) (m : ℤ) : Rn n → ℂ :=
  if 0 ≤ m then ljPiece n Ω m else 0

/-- **The smooth truncations of the principal-value operator** at scale `2^{-j}`:
`T_j f(x) = ∑_{ℓ ≥ -j} 𝓗^{(0)}_ℓ f(x) = ∫ (1 - η(2^{j} ·)) K(t) f(x - t) dt` (in terms of the
dyadic partition `∑_ℓ φ_ℓ = 1`), written as `∑_{m ≥ 0} (k_m)_j * f(x)`. These replace the sharp
truncations `∫_{|t| > 2^{-j}}` of CJRW (Lemma 3.2 of the paper). -/
noncomputable def ljSmoothTrunc (n : ℕ) (Ω : Rn n → ℝ) (j : ℤ) (f : Rn n → ℂ) (x : Rn n) : ℂ :=
  ∑' m : ℤ, ∫ y, lpDilate n (ljTruncPiece n Ω m) j (x - y) * f y

/-- The series defining the smooth truncation converges absolutely. -/
theorem IsHomogeneousCZKernel.hasSum_ljSmoothTrunc (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) (f : 𝓢(Rn n, ℂ)) (j : ℤ) (x : Rn n) :
    HasSum (fun m : ℤ => ∫ y, lpDilate n (ljTruncPiece n Ω m) j (x - y) * f y)
      (ljSmoothTrunc n Ω j f x) := by
  obtain ⟨c, hc0, hc⟩ := hΩ.exists_norm_piece_conv_le hn f
  refine (Summable.of_norm_bounded (g := fun m : ℤ => c * lpGeom (m - j))
    ((summable_lpGeom.comp_injective sub_left_injective).mul_left c) fun m => ?_).hasSum
  by_cases hm : 0 ≤ m
  · have hκ : lpDilate n (ljTruncPiece n Ω m) j = lpDilate n (ljAmp n Ω) (-(m - j)) := by
      rw [ljTruncPiece, ite_eq_left hm, ljPiece, lpDilate_lpDilate]; congr 1; ring
    rw [hκ]; exact hc _ x
  · have : lpDilate n (ljTruncPiece n Ω m) j = 0 := by
      funext t; simp [ljTruncPiece, hm, lpDilate]
    rw [this]
    simp only [Pi.zero_apply, zero_mul, integral_zero, norm_zero]
    exact mul_nonneg hc0 (lpGeom_nonneg _)

/-- **Lemma 3.2 (smooth replacement)**: jumps of the smooth truncations of the principal-value
operator are bounded, `‖λ N_λ{T_j f : j ∈ ℤ}^{1/2}‖_p ≤ C ‖f‖_p` (`1 < p < ∞`, `λ > 0`,
Schwartz `f`), the index set being `u = 2^{jα}` for any `α > 0`. Proof: comparison with
`φ_j * 𝓗^{(0)} f` (Jones–Seeger–Wright) and the square functions of the kernels `φ * k_m`
(`m < 0`) and `φ * k_m - k_m` (`m ≥ 0`). -/
theorem IsHomogeneousCZKernel.eLpNorm_jumpFunction_ljSmoothTrunc_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ), ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction lam (dyadicSet α)
        (fun u => ljSmoothTrunc n Ω (dyadicIndex α u) f x) ^ (1 / 2 : ℝ))
          (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := by linarith
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using hp.le
  obtain ⟨CT, hCT⟩ := hΩ.eLpNorm_modulatedSI_zero_le hn hα hp
  obtain ⟨CJ, hCJ⟩ := jsw_jump_inequality (by omega) (ljBumpSchwartz n)
    (integral_ljBumpSchwartz n) hp
  obtain ⟨C₂, hC₂, h₂⟩ := hΩ.eLpNorm_ljSq_conv_le hn hp
  obtain ⟨C₄, hC₄, h₄⟩ := hΩ.eLpNorm_ljSq_conv_sub_le hn hp
  set D : ℤ → Rn n → ℂ := fun m t => ljConv n Ω m t - ljTruncPiece n Ω m t with hD
  have hχ : ∀ m, Integrable (ljConv n Ω m) := fun m =>
    ((hΩ.ljKernel_ljPiece m).conv_meanZero (by positivity) ljA1_nonneg
      (hΩ.integral_ljPiece hn m)).integrable
  have hDi : ∀ m, Integrable (D m) := by
    intro m
    by_cases hm : 0 ≤ m
    · simp only [hD, ljTruncPiece, ite_eq_left hm]
      exact (hχ m).sub (hΩ.ljKernel_ljPiece m).integrable
    · simp only [hD, ljTruncPiece, ite_eq_right hm, Pi.zero_apply, sub_zero]
      exact hχ m
  set r : ℝ := (2 : ℝ) ^ (-(1 / 2 : ℝ))
  have hDb : ∀ (m : ℤ) (f : 𝓢(Rn n, ℂ)), eLpNorm (ljSq n (D m) f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal ((C₂ + C₄) * r ^ m.natAbs) * eLpNorm f (ENNReal.ofReal p) volume := by
    intro m f
    have hgeom := lj_geom_eq (1 / 2) m
    by_cases hm : 0 ≤ m
    · have heq : D m = fun x => ljConv n Ω m x - ljPiece n Ω m x := by
        funext t; simp [hD, ljTruncPiece, hm]
      rw [heq]
      refine (h₄ m hm f (f.memLp _)).trans (mul_le_mul_of_nonneg_right
        (ENNReal.ofReal_le_ofReal ?_) zero_le)
      have habs : |(m : ℝ)| = m := abs_of_nonneg (by exact_mod_cast hm)
      have hs : √((2 : ℝ) ^ (-m)) = r ^ m.natAbs := by
        rw [hgeom, habs, lj_sqrt_two_zpow]; push_cast; ring_nf
      rw [hs]
      have : 0 ≤ r ^ m.natAbs := by positivity
      nlinarith
    · have heq : D m = ljConv n Ω m := by
        funext t; simp [hD, ljTruncPiece, hm]
      rw [heq]
      refine (h₂ m (by omega) f (f.memLp _)).trans (mul_le_mul_of_nonneg_right
        (ENNReal.ofReal_le_ofReal ?_) zero_le)
      have habs : |(m : ℝ)| = -m := abs_of_neg (by exact_mod_cast (not_le.1 hm))
      have hs : √((2 : ℝ) ^ m) = r ^ m.natAbs := by
        rw [hgeom, habs, lj_sqrt_two_zpow]; ring_nf
      rw [hs]
      have : 0 ≤ r ^ m.natAbs := by positivity
      nlinarith
  have hsum := lj_summable_geom (δ := 1 / 2) (by norm_num)
  set K := (C₂ + C₄) * ljGeom (1 / 2)
  refine ⟨3 * CJ * CT + (√18 * K).toNNReal, fun f lam hlam => ?_⟩
  set T : Rn n → ℂ := fun z => modulatedSI n α Ω 0 f z with hT
  obtain ⟨hTm, hTb⟩ := hCT f
  set G : Rn n → ℝ≥0∞ := fun x => ENNReal.ofReal (lam / 3) * jswJumpCount (lam / 3)
    (fun j => (jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] T) x)
      ^ (1 / 2 : ℝ) with hG
  set S : Rn n → ℝ≥0∞ := fun x => ∑' m, ljSq n (D m) f x with hS
  have hGm : AEMeasurable G := jsw_aemeasurable_jump _ (ljBumpSchwartz n).integrable
    hTm.aestronglyMeasurable (lam / 3)
  have hSm' : ∀ m, AEMeasurable (ljSq n (D m) f) := fun m =>
    lj_aemeasurable_ljSq (hDi m) hp.le (f.memLp _)
  have hSm : AEMeasurable S := AEMeasurable.tsum hSm'
  have hpt : ∀ x, ENNReal.ofReal lam * jumpFunction lam (dyadicSet α)
      (fun u => ljSmoothTrunc n Ω (dyadicIndex α u) f x) ^ (1 / 2 : ℝ) ≤
        3 * G x + ENNReal.ofReal √18 * S x := by
    intro x
    obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
    have hint : ∀ Kf : Rn n → ℂ, Integrable Kf → Integrable fun y => Kf (x - y) * f y :=
      fun Kf hK => (hK.comp_sub_left x).mul_bdd f.continuous.aestronglyMeasurable
        (Eventually.of_forall fun y => hCf y)
    have hTPi : ∀ m, Integrable (ljTruncPiece n Ω m) := by
      intro m
      by_cases hm : 0 ≤ m
      · rw [ljTruncPiece, ite_eq_left hm]; exact (hΩ.ljKernel_ljPiece m).integrable
      · rw [ljTruncPiece, ite_eq_right hm]; exact integrable_zero _ _ _
    have he : ∀ j : ℤ, HasSum (fun m => -∫ y, lpDilate n (D m) j (x - y) * f y)
        (ljSmoothTrunc n Ω (dyadicIndex α (dyadicPoint α j)) f x -
          (jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] T) x) := by
      intro j
      rw [dyadicIndex_dyadicPoint hα]
      have hterm : ∀ m, ∫ y, lpDilate n (D m) j (x - y) * f y =
          (∫ y, lpDilate n (ljConv n Ω m) j (x - y) * f y) -
            ∫ y, lpDilate n (ljTruncPiece n Ω m) j (x - y) * f y := by
        intro m
        rw [← integral_sub (hint _ (integrable_lpDilate (hχ m) j))
          (hint _ (integrable_lpDilate (hTPi m) j))]
        refine integral_congr_ae (Eventually.of_forall fun y => ?_)
        simp only [hD, lpDilate]
        ring
      simp_rw [hterm]
      have h := ((hΩ.hasSum_conv_pieces hn hα f x j).sub
        (hΩ.hasSum_ljSmoothTrunc hn f j x)).neg
      convert h using 1
      ring
    refine (lj_jump_pointwise_le hα lam _ _ _ he).trans (le_of_eq ?_)
    simp only [enorm_neg, hG, hS, ljSq]
  have hFm : AEStronglyMeasurable (fun x => ENNReal.ofReal lam * jumpFunction lam (dyadicSet α)
      (fun u => ljSmoothTrunc n Ω (dyadicIndex α u) f x) ^ (1 / 2 : ℝ)) volume := by
    have hcont : ∀ (m j : ℤ),
        Continuous fun z => ∫ y, lpDilate n (ljTruncPiece n Ω m) j (z - y) * f y := by
      intro m j
      by_cases hm : 0 ≤ m
      · have hk := (hΩ.ljKernel_ljPiece m).dilate j
        rw [ljTruncPiece, ite_eq_left hm]
        have := hk.hasCompactSupport.continuous_convolution_left (ContinuousLinearMap.mul ℂ ℂ)
          hk.continuous (μ := volume) f.integrable.locallyIntegrable
        exact this.congr fun z => convolution_eq_integral_sub _ _ z
      · have : lpDilate n (ljTruncPiece n Ω m) j = 0 := by
          funext t; simp [ljTruncPiece, hm, lpDilate]
        simp only [this, Pi.zero_apply, zero_mul, integral_zero]
        exact continuous_const
    have hmj : ∀ j : ℤ, Measurable fun x => ljSmoothTrunc n Ω j f x := by
      intro j
      refine measurable_of_tendsto_metrizable (f := fun (N : ℕ) x =>
        ∑ m ∈ Finset.Icc (-(N : ℤ)) N, ∫ y, lpDilate n (ljTruncPiece n Ω m) j (x - y) * f y)
        (fun N => (continuous_finsetSum _ fun m _ => hcont m j).measurable) ?_
      refine tendsto_pi_nhds.2 fun x => ?_
      exact (hΩ.hasSum_ljSmoothTrunc hn f j x).comp
        (tendsto_atTop_finset_of_monotone (fun L L' h => Finset.Icc_subset_Icc (by omega)
          (by omega)) fun m => ⟨m.natAbs, Finset.mem_Icc.2 ⟨by omega, by omega⟩⟩)
    exact ((measurable_jumpFunction_of_countable
      (A := fun x u => ljSmoothTrunc n Ω (dyadicIndex α u) f x) (fun u => hmj _) lam
      (countable_range _)).pow_const _ |>.const_mul _).aestronglyMeasurable
  have hGb : eLpNorm G (ENNReal.ofReal p) volume ≤ CJ * (CT * eLpNorm f (ENNReal.ofReal p)) :=
    (hCJ T hTm (lam / 3) (by positivity)).trans (by gcongr)
  have hSb : eLpNorm S (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal K * eLpNorm f (ENNReal.ofReal p) volume := by
    calc eLpNorm S (ENNReal.ofReal p) volume
        ≤ ∑' m, eLpNorm (ljSq n (D m) f) (ENNReal.ofReal p) volume :=
          lj_eLpNorm_tsum_le hSm' hp.le
      _ ≤ ∑' m : ℤ, ENNReal.ofReal ((C₂ + C₄) * r ^ m.natAbs) *
            eLpNorm f (ENNReal.ofReal p) volume := ENNReal.tsum_le_tsum fun m => hDb m f
      _ = ENNReal.ofReal K * eLpNorm f (ENNReal.ofReal p) volume := by
          rw [ENNReal.tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg (fun m => by positivity)
            (hsum.mul_left _), tsum_mul_left]; rfl
  calc eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction lam (dyadicSet α)
        (fun u => ljSmoothTrunc n Ω (dyadicIndex α u) f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) volume
      ≤ eLpNorm (fun x => 3 * G x + ENNReal.ofReal √18 * S x) (ENNReal.ofReal p) volume :=
        eLpNorm_mono_enorm hFm fun x => by
          rw [enorm_eq_self, enorm_eq_self]; exact hpt x
    _ ≤ eLpNorm (fun x => 3 * G x) (ENNReal.ofReal p) volume +
          eLpNorm (fun x => ENNReal.ofReal √18 * S x) (ENNReal.ofReal p) volume :=
        eLpNorm_add_le hp1
    _ = 3 * eLpNorm G (ENNReal.ofReal p) volume +
          ENNReal.ofReal √18 * eLpNorm S (ENNReal.ofReal p) volume := by
        rw [lj_eLpNorm_const_mul _ hGm hp0, lj_eLpNorm_const_mul _ hSm hp0]
    _ ≤ 3 * (CJ * (CT * eLpNorm f (ENNReal.ofReal p))) +
          ENNReal.ofReal √18 * (ENNReal.ofReal K * eLpNorm f (ENNReal.ofReal p)) := by
        gcongr
    _ = _ := by
        rw [← mul_assoc (ENNReal.ofReal √18), ← ENNReal.ofReal_mul (Real.sqrt_nonneg _),
          ENNReal.coe_add]
        change _ = (_ + ENNReal.ofReal (√18 * K)) * _
        push_cast
        ring

end SmoothTruncations

