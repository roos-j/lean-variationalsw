/-- `ℝ≥0`-constant version of `IsHomogeneousCZKernel.eLpNorm_shortVariation_le_n_one`
(paper (`eq:mainest_Sect4`) for `n = 1`, `p, r > 2`). -/
theorem IsHomogeneousCZKernel.eLpNorm_shortVariation_le_n_one_nnreal {Ω : Rn 1 → ℝ}
    (hΩ : IsHomogeneousCZKernel 1 Ω) {α : ℝ} (hα : 1 < α) {r : ℝ} (hr : 2 < r) {p : ℝ}
    (hp : 2 < p) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn 1, ℂ),
      eLpNorm (fun x => shortVariation r α (fun u => modulatedSI 1 α Ω u f x))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) :=
