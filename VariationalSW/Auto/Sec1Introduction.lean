/-!
# Section 1 of Guo–Roos–Yung: definitions and elementary lemmas

This file was automatically generated by Claude.

Part of the formalization of S. Guo, J. Roos, P.-L. Yung, *Sharp variation-norm estimates for
oscillatory integrals related to Carleson's theorem*, Anal. PDE 13 (2020), arXiv:1710.10988v3.

This file contains the objects of Section 1 of the paper: the `r`-variation norm `V^r`, the
`λ`-jump function `N_λ`, homogeneous Calderón–Zygmund kernels `Ω(x)/|x|ⁿ`, and the modulated
singular integrals `𝓗^{(u)}` of (1.1). It also contains the smooth radial dyadic partition of
unity `φ_ℓ`, basic bounds and the radial mean-zero property of the kernels, the existence of the
principal value (`eq:Hu_def`) for Schwartz functions, and the decomposition `𝓗^{(u)} = ∑_ℓ
𝓗^{(u)}_ℓ` of (`eq:decompl`); the elementary results of §1 on jump functions and variation norms
(Lemma 1.3, long/short splitting, splitting at `u = 0`), measurability, the extension of the
operators to `L^p` by difference operators, the Sobolev-type embedding for variation norms
(replacing Prop 2.2), and Bourgain's jump-to-variation argument. The main theorem is assembled in
`VariationalSW/Auto/SharpVariationNorm.lean`.
-/

@[expose] public section

namespace Auto

open MeasureTheory Complex Filter Set
open scoped ENNReal NNReal Topology

/-- The Euclidean space `ℝⁿ`. -/
abbrev Rn (n : ℕ) := EuclideanSpace ℝ (Fin n)

/-- The `r`-variation norm of a family `a : ℝ → ℂ` over an index set `𝒥 ⊆ ℝ`
(Section 1 of the paper, display before (1.3)):
`V^r{a_u : u ∈ 𝒥} = sup_{J ∈ ℕ} sup_{u₀ < ⋯ < u_J in 𝒥}`
`(∑_{j=1}^J |a_{u_j} - a_{u_{j-1}}|^r)^{1/r}`.
It takes values in `[0, ∞]`. -/
noncomputable def variationNorm (r : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) : ℝ≥0∞ :=
  ⨆ (J : ℕ) (u : Fin (J + 1) → ℝ) (_ : StrictMono u) (_ : ∀ i, u i ∈ 𝒥),
    (∑ i : Fin J, (‖a (u i.succ) - a (u i.castSucc)‖ₑ) ^ r) ^ (1 / r)

/-- The `λ`-jump function `N_λ{a_u : u ∈ 𝒥}` (Section 1 of the paper): the supremum of all
`N` for which there is a strictly increasing sequence `s₁ < t₁ < s₂ < t₂ < ⋯ < s_N < t_N` in `𝒥`
with `|a_{t_j} - a_{s_j}| > λ` for all `j`. It takes values in `[0, ∞]`; it is `0` when no
such `N ≥ 1` exists. -/
noncomputable def jumpFunction (lam : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) : ℝ≥0∞ :=
  ⨆ (N : ℕ) (s : Fin N → ℝ) (t : Fin N → ℝ) (_ : ∀ i, s i < t i)
    (_ : ∀ i j, i < j → t i < s j) (_ : ∀ i, s i ∈ 𝒥 ∧ t i ∈ 𝒥)
    (_ : ∀ i, lam < ‖a (t i) - a (s i)‖), (N : ℝ≥0∞)

/-- A homogeneous Calderón–Zygmund kernel `K(x) = Ω(x)/|x|ⁿ` (Section 1, (1.2)): `Ω : ℝⁿ → ℝ`
is smooth on `ℝⁿ ∖ {0}`, homogeneous of degree `0`, and has mean zero on the unit sphere with
respect to surface measure. -/
structure IsHomogeneousCZKernel (n : ℕ) (Ω : Rn n → ℝ) : Prop where
  smooth : ContDiffOn ℝ (⊤ : ℕ∞) Ω {0}ᶜ
  homogeneous : ∀ (c : ℝ), 0 < c → ∀ x : Rn n, Ω (c • x) = Ω x
  mean_zero : ∫ ω, Ω (ω : Rn n) ∂(volume : Measure (Rn n)).toSphere = 0

/-- The truncated modulated singular integral
`∫_{|t| > ε} f(x - t) e^{i u |t|^α} Ω(t)/|t|ⁿ dt`. -/
noncomputable def truncatedModulatedSI (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u ε : ℝ)
    (f : Rn n → ℂ) (x : Rn n) : ℂ :=
  ∫ t in {t : Rn n | ε < ‖t‖},
    f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) * ((Ω t / ‖t‖ ^ n : ℝ) : ℂ)

/-- The modulated singular integral (1.1) of the paper,
`𝓗^{(u)} f(x) = p.v. ∫_{ℝⁿ} f(x - t) e^{i u |t|^α} K(t) dt` with `K(t) = Ω(t)/|t|ⁿ`, defined as
the principal value limit `ε → 0⁺` of the truncated integrals. -/
noncomputable def modulatedSI (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ)
    (f : Rn n → ℂ) (x : Rn n) : ℂ :=
  limUnder (𝓝[>] 0) fun ε => truncatedModulatedSI n α Ω u ε f x


/-! ## A smooth radial dyadic partition of unity

The paper (Section 2 and (`eq:decompl`) in Section 4.1) uses a smooth function `φ` supported in
`1/2 ≤ |t| ≤ 2` with `∑_{ℓ ∈ ℤ} φ(2^{-ℓ} t) = 1` for `t ≠ 0`, and writes `φ_ℓ = φ(2^{-ℓ} ·)`.
We construct it as `φ(t) = η(t) - η(2t)` from a smooth radial bump `η` equal to `1` on the unit
ball and supported in the ball of radius `2`. -/

section DyadicPartition

/-- The smooth radial bump `η(t) = ψ((4 - |t|²)/3)` on `ℝⁿ`, where `ψ` is Mathlib's
`Real.smoothTransition`; it equals `1` for `|t| ≤ 1`, vanishes for `|t| ≥ 2`, takes values in
`[0, 1]`, and is radially non-increasing. -/
noncomputable def dyadicEta (n : ℕ) (t : Rn n) : ℝ :=
  Real.smoothTransition ((4 - ‖t‖ ^ 2) / 3)

/-- The dyadic bump `φ(t) = η(t) - η(2t)`, supported in `1/2 < |t| < 2`
(the function `φ` of the paper, (`eq:decompl`)). -/
noncomputable def dyadicPhi (n : ℕ) (t : Rn n) : ℝ :=
  dyadicEta n t - dyadicEta n ((2 : ℝ) • t)

/-- The rescaled dyadic bump `φ_ℓ(t) = φ(2^{-ℓ} t)`, `ℓ ∈ ℤ`, supported where `|t| ≈ 2^ℓ`
(the functions `φ_ℓ` of (`eq:decompl`)). -/
noncomputable def dyadicPhiScale (n : ℕ) (ℓ : ℤ) (t : Rn n) : ℝ :=
  dyadicPhi n (((2 : ℝ) ^ (-ℓ)) • t)

/-- `η` is smooth. -/
theorem contDiff_dyadicEta (n : ℕ) : ContDiff ℝ (⊤ : ℕ∞) (dyadicEta n) :=
  Real.smoothTransition.contDiff.comp ((contDiff_const.sub (contDiff_norm_sq ℝ)).div_const _)

/-- `φ` is smooth. -/
theorem contDiff_dyadicPhi (n : ℕ) : ContDiff ℝ (⊤ : ℕ∞) (dyadicPhi n) :=
  (contDiff_dyadicEta n).sub ((contDiff_dyadicEta n).comp (contDiff_const_smul _))

/-- `φ_ℓ` is smooth. -/
theorem contDiff_dyadicPhiScale (n : ℕ) (ℓ : ℤ) :
    ContDiff ℝ (⊤ : ℕ∞) (dyadicPhiScale n ℓ) :=
  (contDiff_dyadicPhi n).comp (contDiff_const_smul _)

/-- `η ≥ 0`. -/
theorem dyadicEta_nonneg (n : ℕ) (t : Rn n) : 0 ≤ dyadicEta n t :=
  Real.smoothTransition.nonneg _

/-- `η ≤ 1`. -/
theorem dyadicEta_le_one (n : ℕ) (t : Rn n) : dyadicEta n t ≤ 1 :=
  Real.smoothTransition.le_one _

/-- `η(t) = 1` for `|t| ≤ 1`. -/
theorem dyadicEta_eq_one {n : ℕ} {t : Rn n} (ht : ‖t‖ ≤ 1) : dyadicEta n t = 1 := by
  apply Real.smoothTransition.one_of_one_le
  rw [le_div_iff₀ (by norm_num)]
  nlinarith [norm_nonneg t]

/-- `η(t) = 0` for `|t| ≥ 2`. -/
theorem dyadicEta_eq_zero {n : ℕ} {t : Rn n} (ht : 2 ≤ ‖t‖) : dyadicEta n t = 0 := by
  apply Real.smoothTransition.zero_of_nonpos
  apply div_nonpos_of_nonpos_of_nonneg _ (by norm_num)
  nlinarith

/-- `η` is radially non-increasing: `|s| ≤ |t| → η(t) ≤ η(s)`. -/
theorem dyadicEta_antitone {n : ℕ} {s t : Rn n} (h : ‖s‖ ≤ ‖t‖) :
    dyadicEta n t ≤ dyadicEta n s := by
  apply Real.smoothTransition.monotone
  have : ‖s‖ ^ 2 ≤ ‖t‖ ^ 2 := by gcongr
  linarith [this]

/-- `η` is radial. -/
theorem dyadicEta_congr_norm {n : ℕ} {s t : Rn n} (h : ‖s‖ = ‖t‖) :
    dyadicEta n s = dyadicEta n t := by
  simp only [dyadicEta, h]

/-- `φ ≥ 0` (for our choice of `η`, which is radially non-increasing). -/
theorem dyadicPhi_nonneg (n : ℕ) (t : Rn n) : 0 ≤ dyadicPhi n t := by
  rw [dyadicPhi, sub_nonneg]
  apply dyadicEta_antitone
  rw [norm_smul]; simp only [Real.norm_ofNat]; linarith [norm_nonneg t]

/-- `φ ≤ 1`. -/
theorem dyadicPhi_le_one (n : ℕ) (t : Rn n) : dyadicPhi n t ≤ 1 := by
  rw [dyadicPhi]; linarith [dyadicEta_le_one n t, dyadicEta_nonneg n ((2 : ℝ) • t)]

/-- `φ(t) = 0` for `|t| ≤ 1/2`. -/
theorem dyadicPhi_eq_zero_of_le {n : ℕ} {t : Rn n} (ht : ‖t‖ ≤ 1 / 2) :
    dyadicPhi n t = 0 := by
  rw [dyadicPhi, dyadicEta_eq_one (by linarith), dyadicEta_eq_one, sub_self]
  rw [norm_smul]; simp only [Real.norm_ofNat]; linarith

/-- `φ(t) = 0` for `|t| ≥ 2`. -/
theorem dyadicPhi_eq_zero_of_ge {n : ℕ} {t : Rn n} (ht : 2 ≤ ‖t‖) : dyadicPhi n t = 0 := by
  rw [dyadicPhi, dyadicEta_eq_zero ht, dyadicEta_eq_zero, sub_self]
  rw [norm_smul]; simp only [Real.norm_ofNat]; linarith

/-- Support of `φ`: `φ(t) ≠ 0 → 1/2 < |t| < 2`. -/
theorem dyadicPhi_ne_zero {n : ℕ} {t : Rn n} (ht : dyadicPhi n t ≠ 0) :
    1 / 2 < ‖t‖ ∧ ‖t‖ < 2 := by
  by_contra h
  rw [not_and_or, not_lt, not_lt] at h
  rcases h with h | h
  · exact ht (dyadicPhi_eq_zero_of_le h)
  · exact ht (dyadicPhi_eq_zero_of_ge h)

/-- `|2^ℓ t| = 2^ℓ |t|`. -/
theorem norm_two_zpow_smul (ℓ : ℤ) {n : ℕ} (t : Rn n) :
    ‖((2 : ℝ) ^ ℓ) • t‖ = 2 ^ ℓ * ‖t‖ := by
  rw [norm_smul, Real.norm_of_nonneg (by positivity)]

/-- Support of `φ_ℓ`: `φ_ℓ(t) ≠ 0 → 2^{ℓ-1} < |t| < 2^{ℓ+1}`. -/
theorem dyadicPhiScale_ne_zero {n : ℕ} {ℓ : ℤ} {t : Rn n} (ht : dyadicPhiScale n ℓ t ≠ 0) :
    (2 : ℝ) ^ (ℓ - 1) < ‖t‖ ∧ ‖t‖ < 2 ^ (ℓ + 1) := by
  have h := dyadicPhi_ne_zero ht
  rw [norm_two_zpow_smul] at h
  have h2 : (0 : ℝ) < 2 ^ ℓ := by positivity
  have e1 : (2 : ℝ) ^ (ℓ - 1) = 2 ^ ℓ * (1 / 2) := by
    rw [zpow_sub₀ (by norm_num), zpow_one]; ring
  have e2 : (2 : ℝ) ^ (ℓ + 1) = 2 ^ ℓ * 2 := by rw [zpow_add_one₀ (by norm_num)]
  have e3 : (2 : ℝ) ^ (-ℓ) * 2 ^ ℓ = 1 := by
    rw [← zpow_add₀ (by norm_num)]; simp
  constructor
  · rw [e1]; nlinarith [h.1]
  · rw [e2]; nlinarith [h.2]

/-- `φ_ℓ(t) = 0` for `|t| ≤ 2^{ℓ-1}`. -/
theorem dyadicPhiScale_eq_zero_of_le {n : ℕ} {ℓ : ℤ} {t : Rn n}
    (ht : ‖t‖ ≤ (2 : ℝ) ^ (ℓ - 1)) : dyadicPhiScale n ℓ t = 0 := by
  by_contra h
  exact absurd (dyadicPhiScale_ne_zero h).1 (not_lt.2 ht)

/-- `φ_ℓ` is radial: its value depends only on `|t|`. -/
theorem dyadicPhiScale_congr_norm {n : ℕ} (ℓ : ℤ) {s t : Rn n} (h : ‖s‖ = ‖t‖) :
    dyadicPhiScale n ℓ s = dyadicPhiScale n ℓ t := by
  have h1 : ‖(2 : ℝ) ^ (-ℓ) • s‖ = ‖(2 : ℝ) ^ (-ℓ) • t‖ := by simp only [norm_smul, h]
  have h2 : ‖((2 : ℝ) • (2 : ℝ) ^ (-ℓ) • s)‖ = ‖((2 : ℝ) • (2 : ℝ) ^ (-ℓ) • t)‖ := by
    simp only [norm_smul, h]
  simp only [dyadicPhiScale, dyadicPhi]
  rw [dyadicEta_congr_norm h1, dyadicEta_congr_norm h2]

/-- `φ_ℓ ≥ 0`. -/
theorem dyadicPhiScale_nonneg (n : ℕ) (ℓ : ℤ) (t : Rn n) : 0 ≤ dyadicPhiScale n ℓ t :=
  dyadicPhi_nonneg _ _

/-- `φ_ℓ ≤ 1`. -/
theorem dyadicPhiScale_le_one (n : ℕ) (ℓ : ℤ) (t : Rn n) : dyadicPhiScale n ℓ t ≤ 1 :=
  dyadicPhi_le_one _ _

/-- `φ_ℓ` is measurable. -/
theorem measurable_dyadicPhiScale (n : ℕ) (ℓ : ℤ) : Measurable (dyadicPhiScale n ℓ) :=
  (contDiff_dyadicPhiScale n ℓ).continuous.measurable

/-- Telescoping form: `φ_ℓ(t) = η(2^{-ℓ} t) - η(2^{-(ℓ-1)} t)`. -/
theorem dyadicPhiScale_eq_sub (n : ℕ) (ℓ : ℤ) (t : Rn n) :
    dyadicPhiScale n ℓ t = dyadicEta n ((2 : ℝ) ^ (-ℓ) • t) -
      dyadicEta n ((2 : ℝ) ^ (-(ℓ - 1)) • t) := by
  rw [dyadicPhiScale, dyadicPhi, smul_smul, neg_sub, zpow_sub₀ (by norm_num), zpow_one]
  congr 3
  rw [zpow_neg]; ring

/-- Finite telescoping sums of the dyadic partition: for `a ≤ b + 1`,
`∑_{ℓ=a}^{b} φ_ℓ(t) = η(2^{-b} t) - η(2^{-(a-1)} t)`. -/
theorem sum_Icc_dyadicPhiScale (n : ℕ) {a b : ℤ} (hab : a ≤ b + 1) (t : Rn n) :
    ∑ ℓ ∈ Finset.Icc a b, dyadicPhiScale n ℓ t =
      dyadicEta n ((2 : ℝ) ^ (-b) • t) - dyadicEta n ((2 : ℝ) ^ (-(a - 1)) • t) := by
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, b = a - 1 + k := ⟨(b - (a - 1)).toNat, by omega⟩
  induction k with
  | zero =>
    rw [Finset.Icc_eq_empty (by omega), Finset.sum_empty]
    simp
  | succ k ih =>
    rw [show a - 1 + ((k + 1 : ℕ) : ℤ) = a - 1 + k + 1 by push_cast; ring,
      ← Finset.insert_Icc_right_eq_Icc_add_one (by omega), Finset.sum_insert (by simp),
      ih (by omega), dyadicPhiScale_eq_sub]
    simp only [add_sub_cancel_right]
    ring

/-- For `t ≠ 0`, at most two of the `φ_ℓ(t)` are nonzero: with `m = ⌊log₂ |t|⌋`,
`φ_ℓ(t) = 0` unless `ℓ ∈ {m, m + 1}`. -/
theorem dyadicPhiScale_eq_zero_of_notMem {n : ℕ} {t : Rn n} (ht : t ≠ 0) {ℓ : ℤ}
    (hℓ : ℓ ∉ Finset.Icc (Int.log 2 ‖t‖) (Int.log 2 ‖t‖ + 1)) : dyadicPhiScale n ℓ t = 0 := by
  set m := Int.log 2 ‖t‖
  have hpos : 0 < ‖t‖ := norm_pos_iff.2 ht
  have h1 : (2 : ℝ) ^ m ≤ ‖t‖ := by
    have := Int.zpow_log_le_self (b := 2) (by norm_num) hpos; exact_mod_cast this
  have h2 : ‖t‖ < (2 : ℝ) ^ (m + 1) := by
    have := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) ‖t‖; exact_mod_cast this
  by_contra hne
  obtain ⟨h3, h4⟩ := dyadicPhiScale_ne_zero hne
  rw [Finset.mem_Icc, not_and_or, not_le, not_le] at hℓ
  rcases hℓ with h | h
  · have : (2 : ℝ) ^ (ℓ + 1) ≤ 2 ^ m := zpow_le_zpow_right₀ (by norm_num) (by omega)
    linarith
  · have : (2 : ℝ) ^ (m + 1) ≤ 2 ^ (ℓ - 1) := zpow_le_zpow_right₀ (by norm_num) (by omega)
    linarith

/-- The dyadic partition of unity: `∑_{ℓ ∈ ℤ} φ_ℓ(t) = 1` for every `t ≠ 0`
(used in (`eq:decompl`)). -/
theorem hasSum_dyadicPhiScale {n : ℕ} {t : Rn n} (ht : t ≠ 0) :
    HasSum (fun ℓ : ℤ => dyadicPhiScale n ℓ t) 1 := by
  set m := Int.log 2 ‖t‖
  have hpos : 0 < ‖t‖ := norm_pos_iff.2 ht
  have h1 : (2 : ℝ) ^ m ≤ ‖t‖ := by
    have := Int.zpow_log_le_self (b := 2) (by norm_num) hpos; exact_mod_cast this
  have h2 : ‖t‖ < (2 : ℝ) ^ (m + 1) := by
    have := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) ‖t‖; exact_mod_cast this
  have hs : HasSum (fun ℓ : ℤ => dyadicPhiScale n ℓ t) _ :=
    hasSum_sum_of_ne_finset_zero fun ℓ hℓ => dyadicPhiScale_eq_zero_of_notMem ht hℓ
  rw [sum_Icc_dyadicPhiScale n (by omega), dyadicEta_eq_one, dyadicEta_eq_zero, sub_zero] at hs
  · exact hs
  · rw [norm_two_zpow_smul]
    have : (2 : ℝ) ^ (-(m - 1)) * 2 ^ m = 2 := by
      rw [← zpow_add₀ (by norm_num)]; norm_num
    nlinarith [zpow_pos (by norm_num : (0 : ℝ) < 2) (-(m - 1))]
  · rw [norm_two_zpow_smul]
    have : (2 : ℝ) ^ (-(m + 1)) * 2 ^ (m + 1) = 1 := by
      rw [← zpow_add₀ (by norm_num)]; norm_num
    nlinarith [zpow_pos (by norm_num : (0 : ℝ) < 2) (-(m + 1))]

/-- `∑'_{ℓ ∈ ℤ} φ_ℓ(t) = 1` for `t ≠ 0`. -/
theorem tsum_dyadicPhiScale {n : ℕ} {t : Rn n} (ht : t ≠ 0) :
    ∑' ℓ : ℤ, dyadicPhiScale n ℓ t = 1 :=
  (hasSum_dyadicPhiScale ht).tsum_eq

end DyadicPartition

/-! ## Basic properties of homogeneous Calderón–Zygmund kernels -/

section Kernel

/-- The Calderón–Zygmund kernel `K(t) = Ω(t)/|t|ⁿ` of (1.2) (with `K(0) = 0` when `n ≥ 1`). -/
noncomputable def czKernel (n : ℕ) (Ω : Rn n → ℝ) (t : Rn n) : ℝ := Ω t / ‖t‖ ^ n

/-- `K(0) = 0` for `n ≥ 1` (a convention; `0` is a null set). -/
theorem czKernel_zero {n : ℕ} (hn : 1 ≤ n) (Ω : Rn n → ℝ) : czKernel n Ω 0 = 0 := by
  simp [czKernel, zero_pow (by omega : n ≠ 0)]

/-- `t/|t|` lies on the unit sphere for `t ≠ 0`. -/
theorem norm_inv_smul_mem_sphere {n : ℕ} {t : Rn n} (ht : t ≠ 0) :
    ‖t‖⁻¹ • t ∈ Metric.sphere (0 : Rn n) 1 := by
  rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
    inv_mul_cancel₀ (norm_ne_zero_iff.2 ht)]

/-- Homogeneity of degree `0`: `Ω(t/|t|) = Ω(t)`. -/
theorem IsHomogeneousCZKernel.apply_inv_norm_smul {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (t : Rn n) : Ω (‖t‖⁻¹ • t) = Ω t := by
  rcases eq_or_ne t 0 with rfl | ht
  · simp
  · exact hΩ.homogeneous _ (inv_pos.2 (norm_pos_iff.2 ht)) t

/-- `Ω` is measurable (it is continuous off the origin). -/
theorem IsHomogeneousCZKernel.measurable {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) : Measurable Ω :=
  measurable_of_continuousOn_compl_singleton 0 hΩ.smooth.continuousOn

/-- `K = Ω/|·|ⁿ` is measurable. -/
theorem IsHomogeneousCZKernel.measurable_czKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) : Measurable (czKernel n Ω) :=
  hΩ.measurable.div (by fun_prop)

/-- `Ω` is bounded: `|Ω(t)| ≤ C` for all `t` (compactness of the sphere and homogeneity; the
value at `0` is accounted for separately). -/
theorem IsHomogeneousCZKernel.exists_bound {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) : ∃ C, 0 ≤ C ∧ ∀ t, |Ω t| ≤ C := by
  obtain ⟨C, hC⟩ := (isCompact_sphere (0 : Rn n) 1).exists_bound_of_continuousOn
    (hΩ.smooth.continuousOn.mono fun x hx => by
      rw [mem_compl_singleton_iff]; rintro rfl; simp at hx)
  refine ⟨max (max C |Ω 0|) 0, le_max_right _ _, fun t => ?_⟩
  rcases eq_or_ne t 0 with rfl | ht
  · exact (le_max_right _ _).trans (le_max_left _ _)
  · rw [← hΩ.apply_inv_norm_smul t]
    exact ((hC _ (norm_inv_smul_mem_sphere ht)).trans (le_max_left _ _)).trans
      (le_max_left _ _)

/-- Size bound for the kernel: `|K(t)| ≤ C |t|^{-n}`. -/
theorem IsHomogeneousCZKernel.exists_bound_czKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) :
    ∃ C, 0 ≤ C ∧ ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n := by
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound
  refine ⟨C, hC0, fun t => ?_⟩
  rw [czKernel, abs_div, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ n)]
  exact div_le_div_of_nonneg_right (hC t) (by positivity)

/-- Derivative bounds for homogeneous functions: if `g` is `C¹` off the origin and homogeneous of
degree `-k` (`g(cx) = c^{-k} g(x)` for `c > 0`), then `‖∇g(t)‖ ≤ C |t|^{-k-1}` for `t ≠ 0`. -/
theorem exists_norm_fderiv_le_of_homogeneous {n k : ℕ} {g : Rn n → ℝ}
    (hg : ContDiffOn ℝ 1 g {0}ᶜ)
    (hhom : ∀ c : ℝ, 0 < c → ∀ x, g (c • x) = (c ^ k)⁻¹ * g x) :
    ∃ C, 0 ≤ C ∧ ∀ t ≠ 0, ‖fderiv ℝ g t‖ ≤ C / ‖t‖ ^ (k + 1) := by
  have hcont := hg.continuousOn_fderiv_of_isOpen isOpen_compl_singleton le_rfl
  obtain ⟨C, hC⟩ := (isCompact_sphere (0 : Rn n) 1).exists_bound_of_continuousOn
    (hcont.mono fun x hx => by rw [mem_compl_singleton_iff]; rintro rfl; simp at hx)
  refine ⟨max C 0, le_max_right _ _, fun t ht => ?_⟩
  have hdiff : ∀ y : Rn n, y ≠ 0 → HasFDerivAt g (fderiv ℝ g y) y := fun y hy =>
    ((hg.differentiableOn one_ne_zero).differentiableAt
      (isOpen_compl_singleton.mem_nhds hy)).hasFDerivAt
  set c := ‖t‖ with hc
  have hc0 : 0 < c := norm_pos_iff.2 ht
  set s : Rn n := c⁻¹ • t
  have hs : s ∈ Metric.sphere (0 : Rn n) 1 := norm_inv_smul_mem_sphere ht
  have hs0 : s ≠ 0 := by rintro h; rw [h] at hs; simp at hs
  have hcs : c • s = t := by simp [s, smul_smul, hc0.ne']
  have h1 : HasFDerivAt (fun y => g (c • y)) ((fderiv ℝ g t).comp
      (c • ContinuousLinearMap.id ℝ (Rn n))) s := by
    have := (hdiff t ht)
    rw [← hcs] at this
    rw [← hcs]
    exact this.comp s ((hasFDerivAt_id s).const_smul c)
  have h2 : HasFDerivAt (fun y => g (c • y)) ((c ^ k)⁻¹ • fderiv ℝ g s) s := by
    simp_rw [hhom c hc0]
    exact (hdiff s hs0).const_mul _
  have heq := h1.unique h2
  rw [ContinuousLinearMap.comp_smul, ContinuousLinearMap.comp_id] at heq
  have hn := congrArg norm heq
  rw [norm_smul, norm_smul, Real.norm_of_nonneg hc0.le,
    Real.norm_of_nonneg (by positivity)] at hn
  have hb : ‖fderiv ℝ g s‖ ≤ max C 0 := (hC s hs).trans (le_max_left _ _)
  rw [le_div_iff₀ (by positivity)]
  calc ‖fderiv ℝ g t‖ * c ^ (k + 1) = c ^ k * (c * ‖fderiv ℝ g t‖) := by ring
    _ = c ^ k * ((c ^ k)⁻¹ * ‖fderiv ℝ g s‖) := by rw [hn]
    _ = ‖fderiv ℝ g s‖ := by field_simp
    _ ≤ max C 0 := hb

/-- Gradient bound for `Ω`: `‖∇Ω(t)‖ ≤ C/|t|` for `t ≠ 0`. -/
theorem IsHomogeneousCZKernel.exists_norm_fderiv_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) :
    ∃ C, 0 ≤ C ∧ ∀ t ≠ 0, ‖fderiv ℝ Ω t‖ ≤ C / ‖t‖ := by
  obtain ⟨C, hC0, hC⟩ := exists_norm_fderiv_le_of_homogeneous (k := 0)
    (hΩ.smooth.of_le (by norm_cast)) (fun c hc x => by
      simp [hΩ.homogeneous c hc x])
  exact ⟨C, hC0, fun t ht => by simpa using hC t ht⟩

/-- `K` is smooth off the origin. -/
theorem IsHomogeneousCZKernel.contDiffOn_czKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) : ContDiffOn ℝ (⊤ : ℕ∞) (czKernel n Ω) {0}ᶜ := by
  intro t ht
  have ht' : t ≠ 0 := ht
  refine (hΩ.smooth t ht).div ?_ (by positivity)
  exact ((contDiffAt_norm ℝ ht').pow n).contDiffWithinAt

/-- `K` is homogeneous of degree `-n`: `K(ct) = c^{-n} K(t)` for `c > 0`. -/
theorem IsHomogeneousCZKernel.czKernel_smul {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {c : ℝ} (hc : 0 < c) (x : Rn n) :
    czKernel n Ω (c • x) = (c ^ n)⁻¹ * czKernel n Ω x := by
  rw [czKernel, czKernel, hΩ.homogeneous c hc, norm_smul, Real.norm_of_nonneg hc.le, mul_pow]
  rcases eq_or_ne ‖x‖ 0 with h | h
  · rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp
    · simp [h, zero_pow hn.ne']
  · field_simp

/-- Gradient bound for the kernel: `‖∇K(t)‖ ≤ C |t|^{-n-1}` for `t ≠ 0`. -/
theorem IsHomogeneousCZKernel.exists_norm_fderiv_czKernel_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) :
    ∃ C, 0 ≤ C ∧ ∀ t ≠ 0, ‖fderiv ℝ (czKernel n Ω) t‖ ≤ C / ‖t‖ ^ (n + 1) :=
  exists_norm_fderiv_le_of_homogeneous
    (hΩ.contDiffOn_czKernel.of_le (by norm_cast))
    fun _ hc x => hΩ.czKernel_smul hc x

/-- **Mean zero of `K` against radial functions.** For every `G : ℝ → ℂ`,
`∫_{ℝⁿ} G(|t|) K(t) dt = 0`. This is the cancellation used in the paper to define the
principal value (`eq:Hu_def`) and to see that the constants `c_ℓ` vanish. Proof: polar
coordinates `ℝⁿ ∖ {0} ≅ S^{n-1} × (0, ∞)` and Fubini; the spherical factor is `∫ Ω dσ = 0`.
No integrability hypothesis is needed (if the integrand is not integrable, both sides are `0` by
the Bochner-integral convention, as the polar-coordinate identity holds unconditionally). -/
theorem IsHomogeneousCZKernel.integral_radial_mul_czKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) (G : ℝ → ℂ) :
    ∫ t, G ‖t‖ * (czKernel n Ω t : ℂ) = 0 := by
  have : Nontrivial (Rn n) := ⟨⟨EuclideanSpace.single ⟨0, hn⟩ 1, 0, by simp⟩⟩
  set H : Metric.sphere (0 : Rn n) 1 × Ioi (0 : ℝ) → ℂ :=
    fun p => (Ω p.1 : ℂ) * (G p.2 / (p.2 : ℂ) ^ n)
  calc ∫ t, G ‖t‖ * (czKernel n Ω t : ℂ)
      = ∫ x : ({0}ᶜ : Set (Rn n)), G ‖(x : Rn n)‖ * (czKernel n Ω x : ℂ)
          ∂((volume : Measure (Rn n)).comap (↑)) := by
        rw [integral_subtype_comap (measurableSet_singleton _).compl
          (fun x => G ‖x‖ * (czKernel n Ω x : ℂ)), restrict_compl_singleton]
    _ = ∫ x : ({0}ᶜ : Set (Rn n)), H (homeomorphUnitSphereProd (Rn n) x)
          ∂((volume : Measure (Rn n)).comap (↑)) := by
        congr 1; funext x
        simp only [H, homeomorphUnitSphereProd_apply_fst_coe,
          homeomorphUnitSphereProd_apply_snd_coe, hΩ.apply_inv_norm_smul, czKernel]
        push_cast; ring
    _ = ∫ p, H p ∂((volume : Measure (Rn n)).toSphere.prod
          (Measure.volumeIoiPow (Module.finrank ℝ (Rn n) - 1))) :=
        (volume : Measure (Rn n)).measurePreserving_homeomorphUnitSphereProd.integral_comp
          (Homeomorph.measurableEmbedding _) H
    _ = 0 := by
        rw [integral_prod_mul (L := ℂ) (fun ω : Metric.sphere (0 : Rn n) 1 => (Ω ω : ℂ))
          (fun r : Ioi (0 : ℝ) => G r / (r : ℂ) ^ n), integral_complex_ofReal,
          hΩ.mean_zero]
        simp

/-- Corollary of the mean-zero property: the integral of `K` over any radial measurable set
`{t : |t| ∈ S}` (e.g. an annulus `ε < |t| ≤ 1`) vanishes. -/
theorem IsHomogeneousCZKernel.setIntegral_czKernel_preimage_norm {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {S : Set ℝ} (hS : MeasurableSet S) :
    ∫ t in {t : Rn n | ‖t‖ ∈ S}, czKernel n Ω t = 0 := by
  have h := hΩ.integral_radial_mul_czKernel hn (fun r => ((S.indicator 1 r : ℝ) : ℂ))
  change ∫ t in norm ⁻¹' S, czKernel n Ω t = 0
  rw [← integral_indicator (measurable_norm hS)]
  have : ∫ t, (({t : Rn n | ‖t‖ ∈ S}.indicator (czKernel n Ω) t : ℝ) : ℂ) = 0 := by
    rw [← h]; congr 1; funext t
    by_cases ht : ‖t‖ ∈ S <;> simp [ht, indicator]
  rw [integral_complex_ofReal] at this
  exact_mod_cast this

end Kernel

/-! ## Existence of the principal value and the dyadic decomposition `𝓗^{(u)} = ∑_ℓ 𝓗^{(u)}_ℓ`

For a Schwartz function `f`, we show that the truncations `∫_{|t|>ε}` of (`eq:Hu_def`) converge
as `ε → 0⁺`, and that `𝓗^{(u)} f(x) = ∑_{ℓ ∈ ℤ} 𝓗^{(u)}_ℓ f(x)` (`eq:decompl`), where
`𝓗^{(u)}_ℓ f(x) = ∫ f(x - t) e^{iu|t|^α} φ_ℓ(t) K(t) dt` (`eq:Hul`). The proof subtracts `f(x)`
on the unit ball, which is allowed by the mean-zero property of `K` on radial sets; the
resulting renormalized integrand `pvIntegrand` is absolutely integrable. -/

section PrincipalValue

open scoped SchwartzMap

/-- `|e^{iur}| = 1` for real `u, r`. -/
theorem norm_exp_I_mul_mul (u r : ℝ) : ‖exp (I * u * (r : ℂ))‖ = 1 := by
  rw [show I * (u : ℂ) * (r : ℂ) = ((u * r : ℝ) : ℂ) * I by push_cast; ring]
  exact norm_exp_ofReal_mul_I _

/-- `|e^{iur} - 1| ≤ |u| |r|` for real `u, r`. -/
theorem norm_exp_I_mul_mul_sub_one_le (u r : ℝ) :
    ‖exp (I * u * (r : ℂ)) - 1‖ ≤ |u| * |r| := by
  rw [show I * (u : ℂ) * (r : ℂ) = I * ((u * r : ℝ) : ℂ) by push_cast; ring]
  refine Real.norm_exp_I_mul_ofReal_sub_one_le.trans ?_
  rw [Real.norm_eq_abs, abs_mul]

/-- `t ↦ |t|^{β-n}` is integrable on the closed unit ball of `ℝⁿ` for `β > 0` (polar
coordinates). -/
theorem integrableOn_closedBall_norm_rpow {n : ℕ} (hn : 1 ≤ n) {β : ℝ} (hβ : 0 < β) :
    IntegrableOn (fun t : Rn n => ‖t‖ ^ (β - n)) (Metric.closedBall 0 1) := by
  have : Nontrivial (Rn n) := ⟨⟨EuclideanSpace.single ⟨0, hn⟩ 1, 0, by simp⟩⟩
  refine IntegrableOn.mono_set ?_ (Metric.closedBall_subset_ball (by norm_num : (1 : ℝ) < 2))
  refine (integrableOn_fun_norm_addHaar (volume : Measure (Rn n))
    (f := fun r : ℝ => r ^ (β - n)) (r := 2)).2 ?_
  rw [finrank_euclideanSpace_fin]
  have h : IntegrableOn (fun y : ℝ => y ^ (β - 1)) (Ioo 0 2) :=
    (intervalIntegral.integrableOn_Ioo_rpow_iff (by norm_num)).2 (by linarith)
  refine h.congr_fun (fun y hy => ?_) measurableSet_Ioo
  simp only [smul_eq_mul]
  rw [← Real.rpow_natCast, ← Real.rpow_add hy.1, Nat.cast_sub hn]
  congr 1; push_cast; ring

/-- Schwartz functions are Lipschitz: `|f(y) - f(z)| ≤ L |y - z|`. -/
theorem exists_norm_sub_le_schwartz {n : ℕ} (f : 𝓢(Rn n, ℂ)) :
    ∃ L, 0 ≤ L ∧ ∀ y z, ‖f y - f z‖ ≤ L * ‖y - z‖ := by
  refine ⟨SchwartzMap.seminorm ℝ 0 1 f, apply_nonneg _ _, fun y z => ?_⟩
  refine Convex.norm_image_sub_le_of_norm_fderiv_le (s := univ)
    (fun w _ => f.differentiableAt) (fun w _ => ?_) convex_univ (mem_univ _) (mem_univ _)
  have := SchwartzMap.le_seminorm ℝ 0 1 f w
  rwa [pow_zero, one_mul, norm_iteratedFDeriv_one] at this

/-- The pieces `𝓗^{(u)}_ℓ f(x) = ∫ f(x - t) e^{iu|t|^α} φ_ℓ(t) K(t) dt` of the dyadic
decomposition (`eq:Hul`) (Section 4.1 of the paper). -/
noncomputable def modulatedPiece (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ)
    (f : Rn n → ℂ) (x : Rn n) : ℂ :=
  ∫ t, f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) *
    ((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ)

/-- The renormalized principal-value integrand
`(f(x - t) e^{iu|t|^α} - 𝟙_{|t| ≤ 1} f(x)) K(t)`; it is absolutely integrable for Schwartz `f`
(`integrable_pvIntegrand`) and `𝓗^{(u)} f(x) = ∫ pvIntegrand` (`modulatedSI_eq_integral`). -/
noncomputable def pvIntegrand (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (f : Rn n → ℂ)
    (x t : Rn n) : ℂ :=
  (f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) -
    (Metric.closedBall (0 : Rn n) 1).indicator (fun _ => f x) t) * (czKernel n Ω t : ℂ)

/-- The renormalized integrand vanishes at `t = 0` (where `K(0) = 0`). -/
theorem pvIntegrand_zero {n : ℕ} (hn : 1 ≤ n) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ)
    (f : Rn n → ℂ) (x : Rn n) : pvIntegrand n α Ω u f x 0 = 0 := by
  simp [pvIntegrand, czKernel_zero hn]

/-- Measurability of the renormalized integrand. -/
theorem IsHomogeneousCZKernel.measurable_pvIntegrand {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α u : ℝ) {f : Rn n → ℂ} (hf : Continuous f)
    (x : Rn n) : Measurable (pvIntegrand n α Ω u f x) := by
  unfold pvIntegrand
  refine Measurable.mul (Measurable.sub ?_ ?_)
    (Complex.measurable_ofReal.comp hΩ.measurable_czKernel)
  · exact (hf.measurable.comp (measurable_const.sub measurable_id)).mul
      (Complex.measurable_exp.comp (measurable_const.mul
        (Complex.measurable_ofReal.comp (measurable_norm.pow_const α))))
  · exact measurable_const.indicator measurableSet_closedBall

/-- **Absolute integrability of the renormalized p.v. integrand.** For a Schwartz function `f`,
`t ↦ (f(x - t) e^{iu|t|^α} - 𝟙_{|t| ≤ 1} f(x)) K(t)` is integrable on `ℝⁿ`: on the unit ball it
is `O(|t|^{1-n} + |t|^{α-n})`, and outside it is bounded by `C |f(x - t)|`. -/
theorem IsHomogeneousCZKernel.integrable_pvIntegrand {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) : Integrable (pvIntegrand n α Ω u f x) := by
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound
  obtain ⟨L, hL0, hL⟩ := exists_norm_sub_le_schwartz f
  set g : Rn n → ℝ := fun t => (Metric.closedBall (0 : Rn n) 1).indicator
    (fun t => C * (L * ‖t‖ ^ ((1 : ℝ) - n) + ‖f x‖ * |u| * ‖t‖ ^ (α - n))) t +
      C * ‖f (x - t)‖ with hg_def
  have hg : Integrable g := by
    refine Integrable.add ?_ ?_
    · refine IntegrableOn.integrable_indicator ?_ measurableSet_closedBall
      exact (((integrableOn_closedBall_norm_rpow hn one_pos).const_mul L).add
        ((integrableOn_closedBall_norm_rpow hn hα).const_mul _)).const_mul C
    · exact ((f.integrable.comp_sub_left x).norm).const_mul C
  have hK : ∀ t, ‖(czKernel n Ω t : ℂ)‖ ≤ C / ‖t‖ ^ n := fun t => by
    rw [Complex.norm_real, Real.norm_eq_abs, czKernel, abs_div,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ n)]
    exact div_le_div_of_nonneg_right (hC t) (by positivity)
  refine hg.mono' (hΩ.measurable_pvIntegrand α u f.continuous x).aestronglyMeasurable
    (ae_of_all _ fun t => ?_)
  have hg1 : 0 ≤ (Metric.closedBall (0 : Rn n) 1).indicator
      (fun t => C * (L * ‖t‖ ^ ((1 : ℝ) - n) + ‖f x‖ * |u| * ‖t‖ ^ (α - n))) t :=
    indicator_nonneg (fun _ _ => by positivity) _
  rcases eq_or_ne t 0 with rfl | ht
  · rw [pvIntegrand_zero hn, norm_zero]
    exact add_nonneg hg1 (by positivity)
  have hpos : 0 < ‖t‖ := norm_pos_iff.2 ht
  have he := norm_exp_I_mul_mul u (‖t‖ ^ α)
  by_cases h1 : ‖t‖ ≤ 1
  · have hmem : t ∈ Metric.closedBall (0 : Rn n) 1 := by simpa using h1
    rw [hg_def]
    simp only [pvIntegrand, indicator_of_mem hmem]
    have hA : ‖f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) - f x‖ ≤
        L * ‖t‖ + ‖f x‖ * (|u| * ‖t‖ ^ α) := by
      rw [show f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) - f x =
        (f (x - t) - f x) * exp (I * u * (‖t‖ ^ α : ℝ)) +
          f x * (exp (I * u * (‖t‖ ^ α : ℝ)) - 1) by ring]
      refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
      · rw [norm_mul, he, mul_one]
        simpa using hL (x - t) x
      · rw [norm_mul]
        refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
        have := norm_exp_I_mul_mul_sub_one_le u (‖t‖ ^ α)
        rwa [abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ α)] at this
    calc ‖(f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) - f x) * (czKernel n Ω t : ℂ)‖
        ≤ (L * ‖t‖ + ‖f x‖ * (|u| * ‖t‖ ^ α)) * (C / ‖t‖ ^ n) := by
          rw [norm_mul]; exact mul_le_mul hA (hK t) (norm_nonneg _) (by positivity)
      _ = C * (L * ‖t‖ ^ ((1 : ℝ) - n) + ‖f x‖ * |u| * ‖t‖ ^ (α - n)) := by
          rw [Real.rpow_sub hpos, Real.rpow_sub hpos, Real.rpow_one, Real.rpow_natCast]
          ring
      _ ≤ _ := le_add_of_nonneg_right (by positivity)
  · have hmem : t ∉ Metric.closedBall (0 : Rn n) 1 := by simpa using h1
    rw [hg_def]
    simp only [pvIntegrand, indicator_of_notMem hmem, sub_zero, zero_add]
    have hK1 : C / ‖t‖ ^ n ≤ C :=
      div_le_self hC0 (one_le_pow₀ (le_of_lt (not_le.1 h1)))
    rw [norm_mul, norm_mul, he, mul_one, mul_comm C]
    exact mul_le_mul_of_nonneg_left ((hK t).trans hK1) (norm_nonneg _)

/-- **Subtracting `f(x)` (mean zero).** If `W` is a bounded (`|W| ≤ 1`) measurable radial weight
vanishing on the ball of radius `δ > 0`, then
`∫ W(t) f(x - t) e^{iu|t|^α} K(t) dt = ∫ W(t) (f(x - t) e^{iu|t|^α} - 𝟙_{|t| ≤ 1} f(x)) K(t) dt`,
because `∫ W(t) 𝟙_{|t| ≤ 1} K(t) dt = 0` by the mean-zero property (proof of (`eq:Hu_def`)). -/
theorem IsHomogeneousCZKernel.integral_weight_mul_eq {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) {W : Rn n → ℝ} (hWm : Measurable W)
    (hWr : ∀ s t, ‖s‖ = ‖t‖ → W s = W t) (hWb : ∀ t, |W t| ≤ 1) {δ : ℝ} (hδ : 0 < δ)
    (hW0 : ∀ t, ‖t‖ ≤ δ → W t = 0) :
    ∫ t, (W t : ℂ) * (f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) * (czKernel n Ω t : ℂ)) =
      ∫ t, (W t : ℂ) * pvIntegrand n α Ω u f x t := by
  set ω₀ : Rn n := EuclideanSpace.single ⟨0, hn⟩ 1
  have hω₀ : ‖ω₀‖ = 1 := by simp [ω₀]
  set G : ℝ → ℂ := fun r => (((Iic (1 : ℝ)).indicator (fun r => W (r • ω₀)) r : ℝ) : ℂ)
  have hG : ∀ t : Rn n, G ‖t‖ = (((Metric.closedBall (0 : Rn n) 1).indicator W t : ℝ) : ℂ) := by
    intro t
    have : W (‖t‖ • ω₀) = W t := hWr _ _ (by rw [norm_smul, hω₀, mul_one, norm_norm])
    by_cases h : ‖t‖ ≤ 1
    · have hmem : t ∈ Metric.closedBall (0 : Rn n) 1 := by simpa using h
      simp only [G, indicator_of_mem (show ‖t‖ ∈ Iic (1 : ℝ) from h), this,
        indicator_of_mem hmem]
    · have hmem : t ∉ Metric.closedBall (0 : Rn n) 1 := by simpa using h
      simp only [G, indicator_of_notMem (show ‖t‖ ∉ Iic (1 : ℝ) from h),
        indicator_of_notMem hmem]
  have hpt : ∀ t, (W t : ℂ) * (f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) * (czKernel n Ω t : ℂ)) =
      (W t : ℂ) * pvIntegrand n α Ω u f x t + f x * (G ‖t‖ * (czKernel n Ω t : ℂ)) := by
    intro t
    rw [hG]
    by_cases h : t ∈ Metric.closedBall (0 : Rn n) 1
    · simp only [pvIntegrand, indicator_of_mem h]; ring
    · simp only [pvIntegrand, indicator_of_notMem h]; push_cast; ring
  have hD := hΩ.integrable_pvIntegrand hn hα u f x
  have h1 : Integrable (fun t => (W t : ℂ) * pvIntegrand n α Ω u f x t) :=
    hD.bdd_mul (c := 1) (Complex.measurable_ofReal.comp hWm).aestronglyMeasurable
      (ae_of_all _ fun t => by rw [Complex.norm_real, Real.norm_eq_abs]; exact hWb t)
  have h2 : Integrable (fun t => G ‖t‖ * (czKernel n Ω t : ℂ)) := by
    obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound
    simp_rw [hG]
    have hmeas : Measurable (fun t => (((Metric.closedBall (0 : Rn n) 1).indicator W t : ℝ) : ℂ) *
        (czKernel n Ω t : ℂ)) :=
      (Complex.measurable_ofReal.comp (hWm.indicator measurableSet_closedBall)).mul
        (Complex.measurable_ofReal.comp hΩ.measurable_czKernel)
    rw [← integrableOn_iff_integrable_of_support_subset (s := Metric.closedBall 0 1)]
    · refine Measure.integrableOn_of_bounded (M := C / δ ^ n) measure_closedBall_lt_top.ne
        hmeas.aestronglyMeasurable (ae_of_all _ fun t => ?_)
      rw [norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs]
      have hi : |(Metric.closedBall (0 : Rn n) 1).indicator W t| ≤ |W t| := by
        by_cases h : t ∈ Metric.closedBall (0 : Rn n) 1
        · rw [indicator_of_mem h]
        · rw [indicator_of_notMem h, abs_zero]; exact abs_nonneg _
      by_cases htδ : ‖t‖ ≤ δ
      · rw [hW0 t htδ, abs_zero] at hi
        rw [le_antisymm hi (abs_nonneg _), zero_mul]; positivity
      · have hlt : δ < ‖t‖ := not_le.1 htδ
        rw [czKernel, abs_div, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ n)]
        calc |(Metric.closedBall (0 : Rn n) 1).indicator W t| * (|Ω t| / ‖t‖ ^ n)
            ≤ 1 * (C / ‖t‖ ^ n) := mul_le_mul (hi.trans (hWb t))
              (div_le_div_of_nonneg_right (hC t) (by positivity)) (by positivity) zero_le_one
          _ ≤ C / δ ^ n := by
              rw [one_mul]
              exact div_le_div_of_nonneg_left hC0 (by positivity) (by gcongr)
    · intro t ht
      by_contra h
      exact ht (by simp only [indicator_of_notMem h]; push_cast; ring)
  calc ∫ t, (W t : ℂ) * (f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) * (czKernel n Ω t : ℂ))
      = ∫ t, ((W t : ℂ) * pvIntegrand n α Ω u f x t +
          f x * (G ‖t‖ * (czKernel n Ω t : ℂ))) := by
        congr 1; funext t; exact hpt t
    _ = (∫ t, (W t : ℂ) * pvIntegrand n α Ω u f x t) +
          ∫ t, f x * (G ‖t‖ * (czKernel n Ω t : ℂ)) := integral_add h1 (h2.const_mul _)
    _ = ∫ t, (W t : ℂ) * pvIntegrand n α Ω u f x t := by
        rw [integral_const_mul, hΩ.integral_radial_mul_czKernel hn, mul_zero, add_zero]

/-- The truncated integral (`eq:Hu_def`) in renormalized form: for `ε > 0`,
`∫_{|t|>ε} f(x - t) e^{iu|t|^α} K(t) dt = ∫ 𝟙_{|t|>ε} pvIntegrand(t) dt`. -/
theorem IsHomogeneousCZKernel.truncatedModulatedSI_eq_integral {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) {ε : ℝ} (hε : 0 < ε) :
    truncatedModulatedSI n α Ω u ε f x =
      ∫ t, (({t : Rn n | ε < ‖t‖}.indicator 1 t : ℝ) : ℂ) * pvIntegrand n α Ω u f x t := by
  have hS : MeasurableSet {t : Rn n | ε < ‖t‖} := measurableSet_lt measurable_const measurable_norm
  rw [← hΩ.integral_weight_mul_eq hn hα u f x
    (W := {t : Rn n | ε < ‖t‖}.indicator (1 : Rn n → ℝ)) (measurable_const.indicator hS)
    (fun s t h => by simp [indicator_apply, h])
    (fun t => by
      by_cases h : ε < ‖t‖ <;> simp [h]) hε
    (fun t ht => by simp [not_lt.2 ht]),
    truncatedModulatedSI, ← integral_indicator hS]
  congr 1; funext t
  by_cases h : ε < ‖t‖ <;> simp [h, czKernel]

/-- The truncations converge to the integral of the renormalized integrand. -/
theorem IsHomogeneousCZKernel.tendsto_truncatedModulatedSI_integral {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    Tendsto (fun ε => truncatedModulatedSI n α Ω u ε f x) (𝓝[>] 0)
      (𝓝 (∫ t, pvIntegrand n α Ω u f x t)) := by
  have hD := hΩ.integrable_pvIntegrand hn hα u f x
  have hDm := hΩ.measurable_pvIntegrand α u f.continuous x
  have key : Tendsto (fun ε : ℝ => ∫ t, (({t : Rn n | ε < ‖t‖}.indicator 1 t : ℝ) : ℂ) *
      pvIntegrand n α Ω u f x t) (𝓝[>] 0) (𝓝 (∫ t, pvIntegrand n α Ω u f x t)) := by
    refine tendsto_integral_filter_of_dominated_convergence
      (fun t => ‖pvIntegrand n α Ω u f x t‖)
      (Eventually.of_forall fun ε => ((Complex.measurable_ofReal.comp
        (measurable_const.indicator
          (measurableSet_lt measurable_const measurable_norm))).mul hDm).aestronglyMeasurable)
      (Eventually.of_forall fun ε => ae_of_all _ fun t => ?_) hD.norm
      (ae_of_all _ fun t => ?_)
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      by_cases h : ε < ‖t‖ <;> simp [h]
    · rcases eq_or_ne t 0 with rfl | ht
      · simp only [pvIntegrand_zero hn, mul_zero]
        exact tendsto_const_nhds
      · refine tendsto_const_nhds.congr' ?_
        filter_upwards [Ioo_mem_nhdsGT (norm_pos_iff.2 ht)] with ε hε
        simp [hε.2]
  refine key.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with ε hε
  exact (hΩ.truncatedModulatedSI_eq_integral hn hα u f x hε).symm

/-- The principal value (`eq:Hu_def`) equals the absolutely convergent renormalized integral:
`𝓗^{(u)} f(x) = ∫ (f(x - t) e^{iu|t|^α} - 𝟙_{|t| ≤ 1} f(x)) K(t) dt`. -/
theorem IsHomogeneousCZKernel.modulatedSI_eq_integral {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    modulatedSI n α Ω u f x = ∫ t, pvIntegrand n α Ω u f x t :=
  (hΩ.tendsto_truncatedModulatedSI_integral hn hα u f x).limUnder_eq

/-- **Existence of the principal value** (Section 1, (`eq:Hu_def`)): for a Schwartz function
`f`, `n ≥ 1`, `α > 0` and `u ∈ ℝ`, the truncated integrals `∫_{|t|>ε} f(x - t) e^{iu|t|^α} K(t) dt`
converge as `ε → 0⁺`, and their limit is `𝓗^{(u)} f(x) = modulatedSI n α Ω u f x`. -/
theorem IsHomogeneousCZKernel.tendsto_truncatedModulatedSI {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    Tendsto (fun ε => truncatedModulatedSI n α Ω u ε f x) (𝓝[>] 0)
      (𝓝 (modulatedSI n α Ω u f x)) := by
  rw [hΩ.modulatedSI_eq_integral hn hα u f x]
  exact hΩ.tendsto_truncatedModulatedSI_integral hn hα u f x

/-- The pieces (`eq:Hul`) in renormalized form:
`𝓗^{(u)}_ℓ f(x) = ∫ φ_ℓ(t) (f(x - t) e^{iu|t|^α} - 𝟙_{|t| ≤ 1} f(x)) K(t) dt`. -/
theorem IsHomogeneousCZKernel.modulatedPiece_eq_integral {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) (ℓ : ℤ) :
    modulatedPiece n α Ω u ℓ f x =
      ∫ t, (dyadicPhiScale n ℓ t : ℂ) * pvIntegrand n α Ω u f x t := by
  rw [← hΩ.integral_weight_mul_eq hn hα u f x (measurable_dyadicPhiScale n ℓ)
    (fun s t h => dyadicPhiScale_congr_norm ℓ h)
    (fun t => abs_le.2 ⟨by linarith [dyadicPhiScale_nonneg n ℓ t], dyadicPhiScale_le_one n ℓ t⟩)
    (zpow_pos two_pos _) (fun t ht => dyadicPhiScale_eq_zero_of_le ht), modulatedPiece]
  congr 1; funext t; push_cast; ring

/-- A simple size bound for the pieces:
`|𝓗^{(u)}_ℓ f(x)| ≤ ∫ φ_ℓ(t) |pvIntegrand(t)| dt`. -/
theorem IsHomogeneousCZKernel.norm_modulatedPiece_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) (ℓ : ℤ) :
    ‖modulatedPiece n α Ω u ℓ f x‖ ≤
      ∫ t, dyadicPhiScale n ℓ t * ‖pvIntegrand n α Ω u f x t‖ := by
  rw [hΩ.modulatedPiece_eq_integral hn hα u f x ℓ]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; funext t
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (dyadicPhiScale_nonneg n ℓ t)]

/-- **Dyadic decomposition** (Section 4.1, (`eq:decompl`)): for a Schwartz function `f`,
`𝓗^{(u)} f(x) = ∑_{ℓ ∈ ℤ} 𝓗^{(u)}_ℓ f(x)`, the series converging (absolutely). -/
theorem IsHomogeneousCZKernel.hasSum_modulatedPiece {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    HasSum (fun ℓ : ℤ => modulatedPiece n α Ω u ℓ f x) (modulatedSI n α Ω u f x) := by
  rw [hΩ.modulatedSI_eq_integral hn hα u f x]
  simp_rw [hΩ.modulatedPiece_eq_integral hn hα u f x]
  have hD := hΩ.integrable_pvIntegrand hn hα u f x
  have hDm := hΩ.measurable_pvIntegrand α u f.continuous x
  refine hasSum_integral_of_dominated_convergence
    (fun ℓ t => dyadicPhiScale n ℓ t * ‖pvIntegrand n α Ω u f x t‖)
    (fun ℓ => ((Complex.measurable_ofReal.comp (measurable_dyadicPhiScale n ℓ)).mul
      hDm).aestronglyMeasurable)
    (fun ℓ => ae_of_all _ fun t => le_of_eq (by
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (dyadicPhiScale_nonneg n ℓ t)]))
    (ae_of_all _ fun t => ?_) ?_ (ae_of_all _ fun t => ?_)
  · rcases eq_or_ne t 0 with rfl | ht
    · simp only [pvIntegrand_zero hn, norm_zero, mul_zero]
      exact summable_zero
    · exact ((hasSum_dyadicPhiScale ht).mul_right _).summable
  · refine hD.norm.congr (ae_of_all _ fun t => ?_)
    rcases eq_or_ne t 0 with rfl | ht
    · simp only [pvIntegrand_zero hn, norm_zero, mul_zero, tsum_zero]
    · simp only
      rw [tsum_mul_right, tsum_dyadicPhiScale ht, one_mul]
  · rcases eq_or_ne t 0 with rfl | ht
    · simp only [pvIntegrand_zero hn, mul_zero]
      exact hasSum_zero
    · have := (Complex.hasSum_ofReal.2 (hasSum_dyadicPhiScale ht)).mul_right
        (pvIntegrand n α Ω u f x t)
      simpa using this

end PrincipalValue

/-! ## Short and long variations; elementary properties of `V^r` and `N_λ`

Notation of Section 1.2 of the paper: the `u`-values `2^{jα}`, the short intervals
`J_j = [2^{jα}, 2^{(j+1)α}]`, the short variation `S_r` and the oscillation `V^∞`. We then prove
the elementary real-variable properties of the variation norm and the jump function used
throughout Section 1: monotonicity, Minkowski's inequality, homogeneity, monotonicity in `r`,
the interpolation `V^r ≤ (V^{r₀})^{r₀/r} (V^∞)^{1-r₀/r}`, and `λ^r N_λ ≤ (V^r)^r`.

The basic combinatorial tool is `sum_le_variationNorm_rpow_of_pairs`: for any finite family of
pairs `s_i ≤ t_i` in `𝒥` which is weakly ordered (`t_i ≤ s_j` for `i < j`),
`∑ |a(t_i) - a(s_i)|^r ≤ (V^r_𝒥 a)^r`. -/

section VariationBasics

/-- The dyadic `u`-values `2^{jα}`, `j ∈ ℤ` (Section 1.2 of the paper). -/
noncomputable def dyadicPoint (α : ℝ) (j : ℤ) : ℝ := (2 : ℝ) ^ ((j : ℝ) * α)

/-- The set `{2^{jα} : j ∈ ℤ}` of dyadic `u`-values (Section 1.2): the paper's
`N^{dyad}_λ(𝓗f)(x)` is `jumpFunction λ (dyadicSet α) (fun u => 𝓗^{(u)} f(x))`, and the long
variation is `variationNorm r (dyadicSet α) (fun u => 𝓗^{(u)} f(x))`. -/
def dyadicSet (α : ℝ) : Set ℝ := Set.range (dyadicPoint α)

/-- The short interval `J_j = [2^{jα}, 2^{(j+1)α}]` (Section 1.2 of the paper). -/
def shortInterval (α : ℝ) (j : ℤ) : Set ℝ := Icc (dyadicPoint α j) (dyadicPoint α (j + 1))

/-- The short variation `S_r a = (∑_{j ∈ ℤ} (V^r_{J_j} a)^r)^{1/r}` (Section 1.2 of the paper,
`S_r(𝓗f)(x)` with `a = (𝓗^{(u)} f(x))_u`). -/
noncomputable def shortVariation (r α : ℝ) (a : ℝ → ℂ) : ℝ≥0∞ :=
  (∑' j : ℤ, variationNorm r (shortInterval α j) a ^ r) ^ (1 / r)

/-- The oscillation `V^∞_𝒥 a = sup_{u, v ∈ 𝒥} |a_u - a_v|`. -/
noncomputable def oscillation (𝒥 : Set ℝ) (a : ℝ → ℂ) : ℝ≥0∞ :=
  ⨆ u ∈ 𝒥, ⨆ v ∈ 𝒥, ‖a u - a v‖ₑ

/-- The sum `∑_k g(x_k, x_{k+1})` over consecutive entries of a list `x₀, x₁, …`. -/
noncomputable def chainSum (g : ℝ → ℝ → ℝ≥0∞) : List ℝ → ℝ≥0∞
  | x :: y :: l => g x y + chainSum g (y :: l)
  | _ => 0

/-- Unfolding `chainSum` on a list with two leading entries. -/
theorem chainSum_cons_cons (g : ℝ → ℝ → ℝ≥0∞) (x y : ℝ) (l : List ℝ) :
    chainSum g (x :: y :: l) = g x y + chainSum g (y :: l) := rfl

/-- Adding a point at the front does not decrease `chainSum`. -/
theorem chainSum_le_cons (g : ℝ → ℝ → ℝ≥0∞) (x : ℝ) (l : List ℝ) :
    chainSum g l ≤ chainSum g (x :: l) := by
  cases l with
  | nil => simp [chainSum]
  | cons y l => exact le_add_self

/-- `chainSum` of `List.ofFn u` is the sum over consecutive values of `u`. -/
theorem chainSum_ofFn (g : ℝ → ℝ → ℝ≥0∞) :
    ∀ {J : ℕ} (u : Fin (J + 1) → ℝ),
      chainSum g (List.ofFn u) = ∑ i : Fin J, g (u i.castSucc) (u i.succ)
  | 0, u => by simp [chainSum]
  | J + 1, u => by
    have h := chainSum_ofFn g (fun i : Fin (J + 1) => u i.succ)
    rw [List.ofFn_succ, Fin.sum_univ_succ]
    rw [List.ofFn_succ] at h ⊢
    rw [chainSum_cons_cons, h]
    rfl

/-- A chain in `𝒥` bounds the variation norm from below. -/
theorem le_variationNorm {r : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ} {J : ℕ} {u : Fin (J + 1) → ℝ}
    (hu : StrictMono u) (hu𝒥 : ∀ i, u i ∈ 𝒥) :
    (∑ i : Fin J, ‖a (u i.succ) - a (u i.castSucc)‖ₑ ^ r) ^ (1 / r) ≤ variationNorm r 𝒥 a :=
  le_iSup_of_le J (le_iSup_of_le u (le_iSup_of_le hu (le_iSup_of_le hu𝒥 le_rfl)))

/-- Upper bounds for the variation norm are checked on chains. -/
theorem variationNorm_le {r : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ} {X : ℝ≥0∞}
    (h : ∀ (J : ℕ) (u : Fin (J + 1) → ℝ), StrictMono u → (∀ i, u i ∈ 𝒥) →
      (∑ i : Fin J, ‖a (u i.succ) - a (u i.castSucc)‖ₑ ^ r) ^ (1 / r) ≤ X) :
    variationNorm r 𝒥 a ≤ X :=
  iSup_le fun J => iSup_le fun u => iSup_le fun hu => iSup_le fun hm => h J u hu hm

/-- `(X^{1/r})^r = X` for `r ≠ 0`. -/
theorem rpow_one_div_rpow {r : ℝ} (hr : r ≠ 0) (X : ℝ≥0∞) : (X ^ (1 / r)) ^ r = X := by
  rw [← ENNReal.rpow_mul, one_div_mul_cancel hr, ENNReal.rpow_one]

/-- `(X^r)^{1/r} = X` for `r ≠ 0`. -/
theorem rpow_rpow_one_div {r : ℝ} (hr : r ≠ 0) (X : ℝ≥0∞) : (X ^ r) ^ (1 / r) = X := by
  rw [← ENNReal.rpow_mul, mul_one_div_cancel hr, ENNReal.rpow_one]

/-- If `X ≤ V^r` then `X^{1/r} ≤ V` (`r > 0`). -/
theorem rpow_one_div_le_of_le_rpow {r : ℝ} (hr : 0 < r) {X V : ℝ≥0∞} (h : X ≤ V ^ r) :
    X ^ (1 / r) ≤ V := by
  calc X ^ (1 / r) ≤ (V ^ r) ^ (1 / r) := ENNReal.rpow_le_rpow h (by positivity)
    _ = V := rpow_rpow_one_div hr.ne' V

/-- If `X^{1/r} ≤ V` then `X ≤ V^r` (`r > 0`). -/
theorem le_rpow_of_rpow_one_div_le {r : ℝ} (hr : 0 < r) {X V : ℝ≥0∞} (h : X ^ (1 / r) ≤ V) :
    X ≤ V ^ r := by
  calc X = (X ^ (1 / r)) ^ r := (rpow_one_div_rpow hr.ne' X).symm
    _ ≤ V ^ r := ENNReal.rpow_le_rpow h hr.le

/-- A chain in `𝒥` bounds `(V^r)^r` from below (`r > 0`). -/
theorem sum_le_variationNorm_rpow {r : ℝ} (hr : 0 < r) {𝒥 : Set ℝ} {a : ℝ → ℂ} {J : ℕ}
    {u : Fin (J + 1) → ℝ} (hu : StrictMono u) (hu𝒥 : ∀ i, u i ∈ 𝒥) :
    ∑ i : Fin J, ‖a (u i.succ) - a (u i.castSucc)‖ₑ ^ r ≤ variationNorm r 𝒥 a ^ r :=
  le_rpow_of_rpow_one_div_le hr (le_variationNorm hu hu𝒥)

/-- Upper bounds for `(V^r)^r` are checked on chains (`r > 0`). -/
theorem variationNorm_rpow_le {r : ℝ} (hr : 0 < r) {𝒥 : Set ℝ} {a : ℝ → ℂ} {X : ℝ≥0∞}
    (h : ∀ (J : ℕ) (u : Fin (J + 1) → ℝ), StrictMono u → (∀ i, u i ∈ 𝒥) →
      ∑ i : Fin J, ‖a (u i.succ) - a (u i.castSucc)‖ₑ ^ r ≤ X) :
    variationNorm r 𝒥 a ^ r ≤ X := by
  refine le_trans (ENNReal.rpow_le_rpow (variationNorm_le (X := X ^ (1 / r)) fun J u hu hm =>
    ENNReal.rpow_le_rpow (h J u hu hm) (by positivity)) hr.le) (le_of_eq ?_)
  exact rpow_one_div_rpow hr.ne' X

/-- A strictly increasing list in `𝒥` bounds `(V^r)^r` from below. -/
theorem chainSum_le_variationNorm_rpow_of_lt {r : ℝ} (hr : 0 < r) {𝒥 : Set ℝ} {a : ℝ → ℂ}
    {l : List ℝ} (hl : l.Pairwise (· < ·)) (hl𝒥 : ∀ x ∈ l, x ∈ 𝒥) :
    chainSum (fun x y => ‖a y - a x‖ₑ ^ r) l ≤ variationNorm r 𝒥 a ^ r := by
  rcases Nat.eq_zero_or_eq_succ_pred l.length with h0 | hJ
  · rw [List.length_eq_zero_iff.1 h0]; simp [chainSum]
  set J := l.length.pred
  set u : Fin (J + 1) → ℝ := fun i => l.get (Fin.cast hJ.symm i) with hu_def
  have hl' : List.ofFn u = l := by
    refine List.ext_get (by simpa using hJ.symm) fun i h1 h2 => ?_
    simp only [u, List.get_eq_getElem, Fin.val_cast, List.getElem_ofFn]
  have hmono : StrictMono u := fun i j hij =>
    List.pairwise_iff_get.1 hl _ _ hij
  rw [← hl', chainSum_ofFn]
  exact sum_le_variationNorm_rpow hr hmono fun i => hl𝒥 _ (List.get_mem _ _)

/-- Removing repeated points from a weakly increasing list: there is a strictly increasing list
with the same entries, head and `chainSum` (when `g x x = 0`). -/
theorem exists_pairwise_lt_chainSum_eq (g : ℝ → ℝ → ℝ≥0∞) (hg : ∀ x, g x x = 0) :
    ∀ l : List ℝ, l.Pairwise (· ≤ ·) → ∃ l' : List ℝ, l'.Pairwise (· < ·) ∧
      (∀ x ∈ l', x ∈ l) ∧ l'.head? = l.head? ∧ chainSum g l' = chainSum g l
  | [], _ => ⟨[], by simp⟩
  | [x], _ => ⟨[x], by simp⟩
  | x :: y :: l, h => by
    obtain ⟨l', h1, h2, h3, h4⟩ := exists_pairwise_lt_chainSum_eq g hg (y :: l) h.of_cons
    have hxy : x ≤ y := List.rel_of_pairwise_cons h (by simp)
    rcases hxy.lt_or_eq with hxy | rfl
    · obtain ⟨m, rfl⟩ : ∃ m, l' = y :: m := by
        cases l' with
        | nil => simp at h3
        | cons z m => exact ⟨m, by rw [Option.some.inj h3]⟩
      refine ⟨x :: y :: m, ?_, ?_, by simp, ?_⟩
      · refine List.Pairwise.cons (fun z hz => ?_) h1
        rcases List.mem_cons.1 (h2 z hz) with rfl | hz'
        · exact hxy
        · exact hxy.trans_le (List.rel_of_pairwise_cons h.of_cons hz')
      · intro z hz
        rcases List.mem_cons.1 hz with rfl | hz
        · simp
        · exact List.mem_cons_of_mem _ (h2 z hz)
      · rw [chainSum_cons_cons, h4, chainSum_cons_cons]
    · refine ⟨l', h1, fun z hz => List.mem_cons_of_mem _ (h2 z hz), by simpa using h3, ?_⟩
      rw [h4, chainSum_cons_cons, hg, zero_add]

/-- A weakly increasing list in `𝒥` bounds `(V^r)^r` from below (`r > 0`). -/
theorem chainSum_le_variationNorm_rpow {r : ℝ} (hr : 0 < r) {𝒥 : Set ℝ} {a : ℝ → ℂ}
    {l : List ℝ} (hl : l.Pairwise (· ≤ ·)) (hl𝒥 : ∀ x ∈ l, x ∈ 𝒥) :
    chainSum (fun x y => ‖a y - a x‖ₑ ^ r) l ≤ variationNorm r 𝒥 a ^ r := by
  obtain ⟨l', h1, h2, -, h4⟩ := exists_pairwise_lt_chainSum_eq
    (fun x y => ‖a y - a x‖ₑ ^ r) (fun x => by simp [ENNReal.zero_rpow_of_pos hr]) l hl
  rw [← h4]
  exact chainSum_le_variationNorm_rpow_of_lt hr h1 fun x hx => hl𝒥 x (h2 x hx)

/-- The sum over a list of pairs is bounded by the `chainSum` of the concatenated list. -/
theorem sum_map_le_chainSum {ι : Type*} (g : ℝ → ℝ → ℝ≥0∞) (s t : ι → ℝ) :
    ∀ l : List ι, (l.map fun i => g (s i) (t i)).sum ≤
      chainSum g (l.flatMap fun i => [s i, t i])
  | [] => by simp
  | i :: l => by
    have h := sum_map_le_chainSum g s t l
    simp only [List.map_cons, List.sum_cons, List.flatMap_cons, List.cons_append,
      List.nil_append, chainSum_cons_cons]
    exact add_le_add le_rfl (h.trans (chainSum_le_cons _ _ _))

/-- **Disjoint pairs bound the variation.** For a finite family of pairs `s_i ≤ t_i` in `𝒥`,
weakly ordered (`t_i ≤ s_j` for `i < j`), `∑_i |a(t_i) - a(s_i)|^r ≤ (V^r_𝒥 a)^r` (`r > 0`). -/
theorem sum_le_variationNorm_rpow_of_pairs {ι : Type*} [LinearOrder ι] {r : ℝ} (hr : 0 < r)
    {𝒥 : Set ℝ} {a : ℝ → ℂ} (S : Finset ι) {s t : ι → ℝ} (hst : ∀ i ∈ S, s i ≤ t i)
    (hord : ∀ i ∈ S, ∀ j ∈ S, i < j → t i ≤ s j) (hs : ∀ i ∈ S, s i ∈ 𝒥)
    (ht : ∀ i ∈ S, t i ∈ 𝒥) :
    ∑ i ∈ S, ‖a (t i) - a (s i)‖ₑ ^ r ≤ variationNorm r 𝒥 a ^ r := by
  classical
  have hsum : ∑ i ∈ S, ‖a (t i) - a (s i)‖ₑ ^ r =
      ((S.sort).map fun i => ‖a (t i) - a (s i)‖ₑ ^ r).sum := by
    rw [← List.sum_toFinset _ (Finset.sort_nodup S _), Finset.sort_toFinset]
  have hmem : ∀ i ∈ S.sort, i ∈ S := fun i hi => (Finset.mem_sort _).1 hi
  rw [hsum]
  refine (sum_map_le_chainSum (fun x y => ‖a y - a x‖ₑ ^ r) s t _).trans
    (chainSum_le_variationNorm_rpow hr ?_ ?_)
  · rw [List.pairwise_flatMap]
    refine ⟨fun i hi => by simpa using hst i (hmem i hi), ?_⟩
    refine ((Finset.sortedLT_sort S).pairwise).imp_of_mem fun {i j} hi hj hij => ?_
    have hi' := hmem i hi
    have hj' := hmem j hj
    intro x hx y hy
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx hy
    have h1 := hord i hi' j hj' hij
    have h2 := hst i hi'
    have h3 := hst j hj'
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;> linarith
  · intro x hx
    obtain ⟨i, hi, hx⟩ := List.mem_flatMap.1 hx
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl
    · exact hs i (hmem i hi)
    · exact ht i (hmem i hi)

/-- A single pair `s ≤ t` in `𝒥` bounds `(V^r)^r` from below. -/
theorem rpow_le_variationNorm_rpow {r : ℝ} (hr : 0 < r) {𝒥 : Set ℝ} {a : ℝ → ℂ} {s t : ℝ}
    (hst : s ≤ t) (hs : s ∈ 𝒥) (ht : t ∈ 𝒥) :
    ‖a t - a s‖ₑ ^ r ≤ variationNorm r 𝒥 a ^ r := by
  simpa using sum_le_variationNorm_rpow_of_pairs (ι := ℕ) hr (a := a) {0} (s := fun _ => s)
    (t := fun _ => t) (by simpa using hst) (by simp) (by simpa using hs) (by simpa using ht)

/-- A family of pairs, strictly ordered and with jumps `> λ`, indexed by a finset `S`, bounds the
jump function from below: `#S ≤ N_λ`. -/
theorem card_le_jumpFunction {ι : Type*} [LinearOrder ι] {lam : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ}
    (S : Finset ι) {s t : ι → ℝ} (hst : ∀ i ∈ S, s i < t i)
    (hord : ∀ i ∈ S, ∀ j ∈ S, i < j → t i < s j) (hs : ∀ i ∈ S, s i ∈ 𝒥)
    (ht : ∀ i ∈ S, t i ∈ 𝒥) (hlam : ∀ i ∈ S, lam < ‖a (t i) - a (s i)‖) :
    (S.card : ℝ≥0∞) ≤ jumpFunction lam 𝒥 a := by
  set e := S.orderEmbOfFin rfl
  have he : ∀ k, e k ∈ S := fun k => Finset.orderEmbOfFin_mem S rfl k
  refine le_iSup_of_le S.card (le_iSup_of_le (s ∘ e) (le_iSup_of_le (t ∘ e) ?_))
  refine le_iSup_of_le (fun k => hst _ (he k)) (le_iSup_of_le (fun k l hkl => ?_)
    (le_iSup_of_le (fun k => ⟨hs _ (he k), ht _ (he k)⟩)
      (le_iSup_of_le (fun k => hlam _ (he k)) le_rfl)))
  exact hord _ (he k) _ (he l) (e.strictMono hkl)

/-- Upper bounds for the jump function are checked on jump families. -/
theorem jumpFunction_le {lam : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ} {X : ℝ≥0∞}
    (h : ∀ (N : ℕ) (s t : Fin N → ℝ), (∀ i, s i < t i) → (∀ i j, i < j → t i < s j) →
      (∀ i, s i ∈ 𝒥 ∧ t i ∈ 𝒥) → (∀ i, lam < ‖a (t i) - a (s i)‖) → (N : ℝ≥0∞) ≤ X) :
    jumpFunction lam 𝒥 a ≤ X :=
  iSup_le fun N => iSup_le fun s => iSup_le fun t => iSup_le fun h1 => iSup_le fun h2 =>
    iSup_le fun h3 => iSup_le fun h4 => h N s t h1 h2 h3 h4

/-- Upper bounds for `c · N_λ` are checked on jump families. -/
theorem mul_jumpFunction_le {lam : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ} (c : ℝ≥0∞) {X : ℝ≥0∞}
    (h : ∀ (N : ℕ) (s t : Fin N → ℝ), (∀ i, s i < t i) → (∀ i j, i < j → t i < s j) →
      (∀ i, s i ∈ 𝒥 ∧ t i ∈ 𝒥) → (∀ i, lam < ‖a (t i) - a (s i)‖) → c * N ≤ X) :
    c * jumpFunction lam 𝒥 a ≤ X := by
  simp only [jumpFunction, ENNReal.mul_iSup]
  exact iSup_le fun N => iSup_le fun s => iSup_le fun t => iSup_le fun h1 => iSup_le fun h2 =>
    iSup_le fun h3 => iSup_le fun h4 => h N s t h1 h2 h3 h4

end VariationBasics

section VariationProperties

/-- The variation norm is monotone in the index set. -/
theorem variationNorm_mono {r : ℝ} {𝒥 𝒦 : Set ℝ} (h : 𝒥 ⊆ 𝒦) (a : ℝ → ℂ) :
    variationNorm r 𝒥 a ≤ variationNorm r 𝒦 a :=
  variationNorm_le fun _ _ hu hm => le_variationNorm hu fun i => h (hm i)

/-- A jump family indexed by `Fin N` bounds the jump function from below. -/
theorem natCast_le_jumpFunction {lam : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ} {N : ℕ} {s t : Fin N → ℝ}
    (h1 : ∀ i, s i < t i) (h2 : ∀ i j, i < j → t i < s j) (h3 : ∀ i, s i ∈ 𝒥 ∧ t i ∈ 𝒥)
    (h4 : ∀ i, lam < ‖a (t i) - a (s i)‖) : (N : ℝ≥0∞) ≤ jumpFunction lam 𝒥 a := by
  simpa using card_le_jumpFunction (lam := lam) (a := a) (Finset.univ : Finset (Fin N))
    (s := s) (t := t) (fun i _ => h1 i) (fun i _ j _ hij => h2 i j hij) (fun i _ => (h3 i).1)
    (fun i _ => (h3 i).2) (fun i _ => h4 i)

/-- The jump function is monotone in the index set. -/
theorem jumpFunction_mono {lam : ℝ} {𝒥 𝒦 : Set ℝ} (h : 𝒥 ⊆ 𝒦) (a : ℝ → ℂ) :
    jumpFunction lam 𝒥 a ≤ jumpFunction lam 𝒦 a :=
  jumpFunction_le fun _ _ _ h1 h2 h3 h4 =>
    natCast_le_jumpFunction h1 h2 (fun i => ⟨h (h3 i).1, h (h3 i).2⟩) h4

/-- The jump function is antitone in the threshold `λ`. -/
theorem jumpFunction_anti {lam mu : ℝ} (h : mu ≤ lam) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    jumpFunction lam 𝒥 a ≤ jumpFunction mu 𝒥 a :=
  jumpFunction_le fun _ _ _ h1 h2 h3 h4 =>
    natCast_le_jumpFunction h1 h2 h3 fun i => h.trans_lt (h4 i)

/-- **Minkowski's inequality** for the variation norm: `V^r(a + b) ≤ V^r(a) + V^r(b)`,
`r ≥ 1`. -/
theorem variationNorm_add_le {r : ℝ} (hr : 1 ≤ r) (𝒥 : Set ℝ) (a b : ℝ → ℂ) :
    variationNorm r 𝒥 (a + b) ≤ variationNorm r 𝒥 a + variationNorm r 𝒥 b := by
  have hr0 : 0 < r := by linarith
  refine variationNorm_le fun J u hu hm => ?_
  calc (∑ i : Fin J, ‖(a + b) (u i.succ) - (a + b) (u i.castSucc)‖ₑ ^ r) ^ (1 / r)
      ≤ (∑ i : Fin J, (‖a (u i.succ) - a (u i.castSucc)‖ₑ +
          ‖b (u i.succ) - b (u i.castSucc)‖ₑ) ^ r) ^ (1 / r) := by
        gcongr with i
        rw [Pi.add_apply, Pi.add_apply, add_sub_add_comm]
        exact enorm_add_le _ _
    _ ≤ _ := ENNReal.Lp_add_le _ _ _ hr
    _ ≤ _ := add_le_add (le_variationNorm hu hm) (le_variationNorm hu hm)

/-- Homogeneity of the variation norm: `V^r(c a) = |c| V^r(a)`. -/
theorem variationNorm_const_mul {r : ℝ} (hr : 0 < r) (𝒥 : Set ℝ) (c : ℂ) (a : ℝ → ℂ) :
    variationNorm r 𝒥 (fun u => c * a u) = ‖c‖ₑ * variationNorm r 𝒥 a := by
  simp only [variationNorm, ENNReal.mul_iSup]
  refine iSup_congr fun J => iSup_congr fun u => iSup_congr fun _ => iSup_congr fun _ => ?_
  simp_rw [← mul_sub, enorm_mul, ENNReal.mul_rpow_of_nonneg _ _ hr.le, ← Finset.mul_sum]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), rpow_rpow_one_div hr.ne']

/-- `∑ f_i^r ≤ M^{r-q} ∑ f_i^q` if all `f_i ≤ M` and `0 ≤ q ≤ r`. -/
theorem sum_rpow_le_mul_sum_rpow {ι : Type*} (s : Finset ι) (f : ι → ℝ≥0∞) {M : ℝ≥0∞}
    (hf : ∀ i ∈ s, f i ≤ M) {q r : ℝ} (hq : 0 ≤ q) (hqr : q ≤ r) :
    ∑ i ∈ s, f i ^ r ≤ M ^ (r - q) * ∑ i ∈ s, f i ^ q := by
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun i hi => ?_
  calc f i ^ r = f i ^ q * f i ^ (r - q) := by
        rw [← ENNReal.rpow_add_of_nonneg _ _ hq (sub_nonneg.2 hqr), add_sub_cancel]
    _ ≤ f i ^ q * M ^ (r - q) :=
        mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hf i hi) (sub_nonneg.2 hqr))
    _ = _ := mul_comm _ _

/-- Monotonicity of the variation norm in the exponent: `V^r ≤ V^q` for `0 < q ≤ r`. -/
theorem variationNorm_le_of_le {q r : ℝ} (hq : 0 < q) (hqr : q ≤ r) (𝒥 : Set ℝ)
    (a : ℝ → ℂ) : variationNorm r 𝒥 a ≤ variationNorm q 𝒥 a := by
  have hr : 0 < r := hq.trans_le hqr
  refine variationNorm_le fun J u hu hm => ?_
  set x : Fin J → ℝ≥0∞ := fun i => ‖a (u i.succ) - a (u i.castSucc)‖ₑ with hx_def
  set M := (∑ i, x i ^ q) ^ (1 / q) with hM_def
  have hx : ∀ i ∈ Finset.univ, x i ≤ M := fun i _ => by
    calc x i = (x i ^ q) ^ (1 / q) := (rpow_rpow_one_div hq.ne' _).symm
      _ ≤ M := ENNReal.rpow_le_rpow (Finset.single_le_sum (f := fun i => x i ^ q)
          (fun _ _ => bot_le) (Finset.mem_univ i)) (by positivity)
  have hMq : M ^ q = ∑ i, x i ^ q := by rw [hM_def]; exact rpow_one_div_rpow hq.ne' _
  have h1 : ∑ i, x i ^ r ≤ M ^ r := by
    calc ∑ i, x i ^ r ≤ M ^ (r - q) * ∑ i, x i ^ q := sum_rpow_le_mul_sum_rpow _ _ hx hq.le hqr
      _ = M ^ (r - q) * M ^ q := by rw [hMq]
      _ = M ^ r := by
          rw [← ENNReal.rpow_add_of_nonneg _ _ (sub_nonneg.2 hqr) hq.le, sub_add_cancel]
  exact (rpow_one_div_le_of_le_rpow hr h1).trans (le_variationNorm hu hm)

/-- Each increment is bounded by the oscillation. -/
theorem enorm_sub_le_oscillation {𝒥 : Set ℝ} {a : ℝ → ℂ} {u v : ℝ} (hu : u ∈ 𝒥) (hv : v ∈ 𝒥) :
    ‖a u - a v‖ₑ ≤ oscillation 𝒥 a :=
  le_iSup₂_of_le u hu (le_iSup₂_of_le v hv le_rfl)

/-- Pointwise interpolation, `r`-th power form:
`(V^r a)^r ≤ (V^∞ a)^{r - r₀} (V^{r₀} a)^{r₀}` for `0 < r₀ ≤ r`. -/
theorem variationNorm_rpow_le_oscillation {r₀ r : ℝ} (h0 : 0 < r₀) (h : r₀ ≤ r) (𝒥 : Set ℝ)
    (a : ℝ → ℂ) :
    variationNorm r 𝒥 a ^ r ≤ oscillation 𝒥 a ^ (r - r₀) * variationNorm r₀ 𝒥 a ^ r₀ := by
  refine variationNorm_rpow_le (h0.trans_le h) fun J u hu hm => ?_
  refine (sum_rpow_le_mul_sum_rpow _ _ (fun i _ => enorm_sub_le_oscillation (hm _) (hm _))
    h0.le h).trans ?_
  exact mul_le_mul' le_rfl (sum_le_variationNorm_rpow h0 hu hm)

/-- Taking `r`-th roots in an interpolation inequality. -/
theorem le_of_rpow_le_interp {r₀ r : ℝ} (h0 : 0 < r₀) (h : r₀ ≤ r) {X Y M : ℝ≥0∞}
    (hX : X ^ r ≤ M ^ (r - r₀) * Y ^ r₀) : X ≤ Y ^ (r₀ / r) * M ^ (1 - r₀ / r) := by
  have hr : 0 < r := h0.trans_le h
  have hrr : 0 ≤ r - r₀ := sub_nonneg.2 h
  calc X = (X ^ r) ^ (1 / r) := (rpow_rpow_one_div hr.ne' X).symm
    _ ≤ (M ^ (r - r₀) * Y ^ r₀) ^ (1 / r) := ENNReal.rpow_le_rpow hX (by positivity)
    _ = Y ^ (r₀ / r) * M ^ (1 - r₀ / r) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
        mul_comm]
      congr 2 <;> field_simp

/-- **Pointwise interpolation** `V^r ≤ (V^{r₀})^{r₀/r} (V^∞)^{1 - r₀/r}` for `0 < r₀ ≤ r`
(used for Proposition 1.5 at small `p`, Section 5 of the paper). -/
theorem variationNorm_le_interp {r₀ r : ℝ} (h0 : 0 < r₀) (h : r₀ ≤ r) (𝒥 : Set ℝ)
    (a : ℝ → ℂ) :
    variationNorm r 𝒥 a ≤ variationNorm r₀ 𝒥 a ^ (r₀ / r) * oscillation 𝒥 a ^ (1 - r₀ / r) :=
  le_of_rpow_le_interp h0 h (variationNorm_rpow_le_oscillation h0 h 𝒥 a)

/-- **Pointwise interpolation for the short variation**:
`S_r ≤ S_{r₀}^{r₀/r} (sup_j V^∞_{J_j})^{1 - r₀/r}` for `0 < r₀ ≤ r`. -/
theorem shortVariation_le_interp {r₀ r : ℝ} (h0 : 0 < r₀) (h : r₀ ≤ r) (α : ℝ) (a : ℝ → ℂ) :
    shortVariation r α a ≤ shortVariation r₀ α a ^ (r₀ / r) *
      (⨆ j, oscillation (shortInterval α j) a) ^ (1 - r₀ / r) := by
  have hr := h0.trans_le h
  refine le_of_rpow_le_interp h0 h ?_
  rw [shortVariation, shortVariation, rpow_one_div_rpow hr.ne', rpow_one_div_rpow h0.ne',
    ← ENNReal.tsum_mul_left]
  refine ENNReal.tsum_le_tsum fun j => (variationNorm_rpow_le_oscillation h0 h _ a).trans ?_
  exact mul_le_mul' (ENNReal.rpow_le_rpow
    (le_iSup (fun j => oscillation (shortInterval α j) a) j) (sub_nonneg.2 h)) le_rfl

/-- **Jumps are controlled by the variation**: `λ^r N_λ(a) ≤ (V^r a)^r` (`r > 0`). -/
theorem rpow_mul_jumpFunction_le {r : ℝ} (hr : 0 < r) (lam : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    ENNReal.ofReal lam ^ r * jumpFunction lam 𝒥 a ≤ variationNorm r 𝒥 a ^ r := by
  refine mul_jumpFunction_le _ fun N s t h1 h2 h3 h4 => ?_
  calc ENNReal.ofReal lam ^ r * N = ∑ i : Fin N, ENNReal.ofReal lam ^ r := by simp [mul_comm]
    _ ≤ ∑ i : Fin N, ‖a (t i) - a (s i)‖ₑ ^ r := Finset.sum_le_sum fun i _ => by
        refine ENNReal.rpow_le_rpow ?_ hr.le
        rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (h4 i).le
    _ ≤ _ := sum_le_variationNorm_rpow_of_pairs hr Finset.univ (fun i _ => (h1 i).le)
        (fun i _ j _ hij => (h2 i j hij).le) (fun i _ => (h3 i).1) (fun i _ => (h3 i).2)

/-- **Jumps are controlled by the variation**: `λ N_λ(a)^{1/r} ≤ V^r a` (`r > 0`). -/
theorem mul_jumpFunction_rpow_le {r : ℝ} (hr : 0 < r) (lam : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    ENNReal.ofReal lam * jumpFunction lam 𝒥 a ^ (1 / r) ≤ variationNorm r 𝒥 a := by
  refine le_trans (le_of_eq ?_)
    (rpow_one_div_le_of_le_rpow hr (rpow_mul_jumpFunction_le hr lam 𝒥 a))
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), rpow_rpow_one_div hr.ne']

end VariationProperties

/-! ## Comparison of jump functions (proof of (`eq:clSk_jump`), Section 2.1)

If `|a - b|` is small in `ℓ^r`, then the `λ`-jumps of `a` are controlled by the `λ/3`-jumps of
`b`: in each `λ`-jump `(s, t)` of `a`, either `b` has a `λ/3`-jump on `(s, t)`, or one endpoint
satisfies `|a - b| > λ/3`; distinct jumps have distinct endpoints. -/

section JumpComparison

/-- **Jump comparison**: for `r > 0` and families `a, b` on `𝒥`,
`λ^r N_λ(a) ≤ λ^r N_{λ/3}(b) + 3^r ∑_{u ∈ 𝒥} |a_u - b_u|^r`
(the combinatorial step in the proof of (`eq:clSk_jump`), Section 2.1). -/
theorem rpow_mul_jumpFunction_le_add_tsum {r : ℝ} (hr : 0 < r) (lam : ℝ) (𝒥 : Set ℝ) (a b : ℝ → ℂ) :
    ENNReal.ofReal lam ^ r * jumpFunction lam 𝒥 a ≤
      ENNReal.ofReal lam ^ r * jumpFunction (lam / 3) 𝒥 b +
        3 ^ r * ∑' u : 𝒥, ‖a u - b u‖ₑ ^ r := by
  classical
  refine mul_jumpFunction_le _ fun N s t h1 h2 h3 h4 => ?_
  have hs_mono : StrictMono s := fun i j hij => (h1 i).trans (h2 i j hij)
  have ht_mono : StrictMono t := fun i j hij => (h2 i j hij).trans (h1 j)
  have hne : ∀ i j, s i ≠ t j := by
    intro i j hij
    rcases lt_or_ge j i with h | h
    · exact (h2 j i h).ne' hij
    · exact ((h1 i).trans_le (ht_mono.monotone h)).ne hij
  set d : ℝ → ℝ≥0∞ := fun u => ‖a u - b u‖ₑ ^ r with hd
  set G := Finset.univ.filter (fun i => lam / 3 < ‖b (t i) - b (s i)‖)
  set B := Finset.univ.filter (fun i => ¬ lam / 3 < ‖b (t i) - b (s i)‖)
  have hN : ENNReal.ofReal lam ^ r * N =
      ∑ i ∈ G, ENNReal.ofReal lam ^ r + ∑ i ∈ B, ENNReal.ofReal lam ^ r := by
    rw [Finset.sum_filter_add_sum_filter_not]; simp [mul_comm]
  have hG : ∑ i ∈ G, ENNReal.ofReal lam ^ r ≤
      ENNReal.ofReal lam ^ r * jumpFunction (lam / 3) 𝒥 b := by
    rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
    exact mul_le_mul' le_rfl (card_le_jumpFunction G (fun i _ => h1 i)
      (fun i _ j _ hij => h2 i j hij) (fun i _ => (h3 i).1) (fun i _ => (h3 i).2)
      (fun i hi => (Finset.mem_filter.1 hi).2))
  have h3r : ENNReal.ofReal lam ^ r = 3 ^ r * ENNReal.ofReal (lam / 3) ^ r := by
    rw [← ENNReal.mul_rpow_of_nonneg _ _ hr.le]
    congr 1
    rw [show (3 : ℝ≥0∞) = ENNReal.ofReal 3 by simp, ← ENNReal.ofReal_mul (by norm_num)]
    congr 1; ring
  have hB1 : ∀ i ∈ B, ENNReal.ofReal lam ^ r ≤ 3 ^ r * (d (s i) + d (t i)) := by
    intro i hi
    have hb := not_lt.1 (Finset.mem_filter.1 hi).2
    have htri : ‖a (t i) - a (s i)‖ ≤
        ‖a (t i) - b (t i)‖ + ‖b (t i) - b (s i)‖ + ‖a (s i) - b (s i)‖ := by
      calc ‖a (t i) - a (s i)‖ =
            ‖(a (t i) - b (t i)) + (b (t i) - b (s i)) - (a (s i) - b (s i))‖ := by ring_nf
        _ ≤ _ := (norm_sub_le _ _).trans (by gcongr; exact norm_add_le _ _)
    have h4i := h4 i
    rw [h3r]
    refine mul_le_mul' le_rfl ?_
    by_cases hc : lam / 3 < ‖a (t i) - b (t i)‖
    · refine le_add_left ?_
      exact ENNReal.rpow_le_rpow (by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hc.le)
        hr.le
    · have hc' : lam / 3 < ‖a (s i) - b (s i)‖ := by have := not_lt.1 hc; linarith
      refine le_add_right ?_
      exact ENNReal.rpow_le_rpow (by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hc'.le)
        hr.le
  have hmem : ∀ x ∈ Finset.univ.image s ∪ Finset.univ.image t, x ∈ 𝒥 := by
    intro x hx
    simp only [Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and] at hx
    rcases hx with ⟨i, rfl⟩ | ⟨i, rfl⟩
    · exact (h3 i).1
    · exact (h3 i).2
  have hB2 : ∑ i ∈ B, (d (s i) + d (t i)) ≤ ∑' u : 𝒥, d u := by
    calc ∑ i ∈ B, (d (s i) + d (t i)) ≤ ∑ i, (d (s i) + d (t i)) :=
          Finset.sum_le_sum_of_subset (Finset.subset_univ _)
      _ = ∑ x ∈ Finset.univ.image s ∪ Finset.univ.image t, d x := by
          rw [Finset.sum_union, Finset.sum_image hs_mono.injective.injOn,
            Finset.sum_image ht_mono.injective.injOn, Finset.sum_add_distrib]
          rw [Finset.disjoint_left]
          intro x hx hx'
          simp only [Finset.mem_image, Finset.mem_univ, true_and] at hx hx'
          obtain ⟨i, rfl⟩ := hx
          obtain ⟨j, hj⟩ := hx'
          exact hne i j hj.symm
      _ = ∑ x ∈ Finset.univ.image s ∪ Finset.univ.image t, 𝒥.indicator d x :=
          Finset.sum_congr rfl fun x hx => (Set.indicator_of_mem (hmem x hx) _).symm
      _ ≤ ∑' x, 𝒥.indicator d x := ENNReal.sum_le_tsum _
      _ = ∑' u : 𝒥, d u := (tsum_subtype 𝒥 d).symm
  rw [hN]
  refine add_le_add hG ((Finset.sum_le_sum hB1).trans ?_)
  rw [← Finset.mul_sum]
  exact mul_le_mul' le_rfl hB2

/-- The dyadic points `2^{jα}` are strictly increasing in `j` for `α > 0`. -/
theorem dyadicPoint_strictMono {α : ℝ} (hα : 0 < α) : StrictMono (dyadicPoint α) :=
  fun _ _ hij => Real.rpow_lt_rpow_of_exponent_lt (by norm_num)
    (mul_lt_mul_of_pos_right (Int.cast_lt.2 hij) hα)

/-- The dyadic points are positive. -/
theorem dyadicPoint_pos (α : ℝ) (j : ℤ) : 0 < dyadicPoint α j :=
  Real.rpow_pos_of_pos (by norm_num) _

/-- Sums over the dyadic set are sums over `j ∈ ℤ`. -/
theorem tsum_dyadicSet {α : ℝ} (hα : 0 < α) (f : ℝ → ℝ≥0∞) :
    ∑' u : dyadicSet α, f u = ∑' j : ℤ, f (dyadicPoint α j) :=
  tsum_range f (dyadicPoint_strictMono hα).injective

/-- **Jump comparison on the dyadic set** (proof of (`eq:clSk_jump`), Section 2.1):
`λ^r N^{dyad}_λ(a) ≤ λ^r N^{dyad}_{λ/3}(b) + 3^r ∑_{j ∈ ℤ} |a(2^{jα}) - b(2^{jα})|^r`. -/
theorem rpow_mul_jumpFunction_dyadicSet_le {α : ℝ} (hα : 0 < α) {r : ℝ} (hr : 0 < r) (lam : ℝ)
    (a b : ℝ → ℂ) :
    ENNReal.ofReal lam ^ r * jumpFunction lam (dyadicSet α) a ≤
      ENNReal.ofReal lam ^ r * jumpFunction (lam / 3) (dyadicSet α) b +
        3 ^ r * ∑' j : ℤ, ‖a (dyadicPoint α j) - b (dyadicPoint α j)‖ₑ ^ r := by
  rw [← tsum_dyadicSet hα (fun u => ‖a u - b u‖ₑ ^ r)]
  exact rpow_mul_jumpFunction_le_add_tsum hr lam _ a b

/-- **Jump comparison**, the form `λ² N_λ(a) ≤ λ² N_{λ/3}(b) + 18 ∑_j |a_j - b_j|²` used in the
proof of (`eq:clSk_jump`) (Section 2.1); in fact the constant `9` suffices. -/
theorem sq_mul_jumpFunction_dyadicSet_le {α : ℝ} (hα : 0 < α) (lam : ℝ) (a b : ℝ → ℂ) :
    ENNReal.ofReal lam ^ (2 : ℝ) * jumpFunction lam (dyadicSet α) a ≤
      ENNReal.ofReal lam ^ (2 : ℝ) * jumpFunction (lam / 3) (dyadicSet α) b +
        18 * ∑' j : ℤ, ‖a (dyadicPoint α j) - b (dyadicPoint α j)‖ₑ ^ (2 : ℝ) := by
  refine (rpow_mul_jumpFunction_dyadicSet_le hα two_pos lam a b).trans
    (add_le_add le_rfl (mul_le_mul' ?_ le_rfl))
  rw [ENNReal.rpow_two]; norm_num

end JumpComparison

/-! ## Short and long jumps and variations (Section 1.2)

Every `u > 0` lies in the short interval `J_j`, `j = ⌊log₂ u / α⌋`. A pair `s ≤ t` in `(0, ∞)`
either lies in a single short interval, or it crosses dyadic points; in the latter case
`|a_t - a_s| ≤ |a_t - a_{2^{kα}}| + |a_{2^{kα}} - a_{2^{(i+1)α}}| + |a_{2^{(i+1)α}} - a_s|`
for `s ∈ J_i`, `t ∈ J_k`, `i < k`. For a weakly ordered family of pairs each short interval
is the left (resp. right) end of at most one crossing pair. -/

section LongShort

/-- The index `j = ⌊log₂ u / α⌋` of the short interval `[2^{jα}, 2^{(j+1)α})` containing `u > 0`. -/
noncomputable def dyadicIndex (α u : ℝ) : ℤ := ⌊Real.logb 2 u / α⌋

variable {α : ℝ}

/-- `2^{jα} ≤ u` for `j = dyadicIndex α u`. -/
theorem dyadicPoint_dyadicIndex_le (hα : 0 < α) {u : ℝ} (hu : 0 < u) :
    dyadicPoint α (dyadicIndex α u) ≤ u := by
  unfold dyadicPoint dyadicIndex
  calc (2 : ℝ) ^ ((⌊Real.logb 2 u / α⌋ : ℝ) * α) ≤ 2 ^ (Real.logb 2 u) := by
        apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
        calc _ ≤ Real.logb 2 u / α * α :=
              mul_le_mul_of_nonneg_right (Int.floor_le _) hα.le
          _ = _ := div_mul_cancel₀ _ hα.ne'
    _ = u := Real.rpow_logb (by norm_num) (by norm_num) hu

/-- `u < 2^{(j+1)α}` for `j = dyadicIndex α u`. -/
theorem lt_dyadicPoint_dyadicIndex_add_one (hα : 0 < α) {u : ℝ} (hu : 0 < u) :
    u < dyadicPoint α (dyadicIndex α u + 1) := by
  unfold dyadicPoint dyadicIndex
  calc u = 2 ^ (Real.logb 2 u) := (Real.rpow_logb (by norm_num) (by norm_num) hu).symm
    _ < _ := by
        apply Real.rpow_lt_rpow_of_exponent_lt (by norm_num)
        push_cast
        calc Real.logb 2 u = Real.logb 2 u / α * α := (div_mul_cancel₀ _ hα.ne').symm
          _ < _ := mul_lt_mul_of_pos_right (Int.lt_floor_add_one _) hα

/-- `u ↦ dyadicIndex α u` is monotone on `(0, ∞)`. -/
theorem dyadicIndex_mono (hα : 0 < α) {u v : ℝ} (hu : 0 < u) (huv : u ≤ v) :
    dyadicIndex α u ≤ dyadicIndex α v :=
  Int.floor_mono (div_le_div_of_nonneg_right (Real.logb_le_logb_of_le (by norm_num) hu huv) hα.le)

/-- `u ∈ J_j` for `j = dyadicIndex α u`. -/
theorem mem_shortInterval_dyadicIndex (hα : 0 < α) {u : ℝ} (hu : 0 < u) :
    u ∈ shortInterval α (dyadicIndex α u) :=
  ⟨dyadicPoint_dyadicIndex_le hα hu, (lt_dyadicPoint_dyadicIndex_add_one hα hu).le⟩

/-- The left endpoint of `J_j` lies in `J_j`. -/
theorem dyadicPoint_mem_shortInterval (hα : 0 < α) (j : ℤ) :
    dyadicPoint α j ∈ shortInterval α j :=
  ⟨le_rfl, (dyadicPoint_strictMono hα (lt_add_one j)).le⟩

/-- The right endpoint of `J_j` lies in `J_j`. -/
theorem dyadicPoint_add_one_mem_shortInterval (hα : 0 < α) (j : ℤ) :
    dyadicPoint α (j + 1) ∈ shortInterval α j :=
  ⟨(dyadicPoint_strictMono hα (lt_add_one j)).le, le_rfl⟩

/-- The dyadic points lie in the dyadic set. -/
theorem dyadicPoint_mem_dyadicSet (α : ℝ) (j : ℤ) : dyadicPoint α j ∈ dyadicSet α := ⟨j, rfl⟩

/-- `x + y + z ≤ 3 max(x, y, z)`, hence `(x + y + z)^r ≤ 3^r (x^r + y^r + z^r)` (`r ≥ 0`). -/
theorem add_add_rpow_le {r : ℝ} (hr : 0 ≤ r) (x y z : ℝ≥0∞) :
    (x + y + z) ^ r ≤ 3 ^ r * (x ^ r + y ^ r + z ^ r) := by
  set m := max x (max y z)
  have hm : x + y + z ≤ 3 * m := by
    have h1 : x ≤ m := le_max_left _ _
    have h2 : y ≤ m := (le_max_left _ _).trans (le_max_right _ _)
    have h3 : z ≤ m := (le_max_right _ _).trans (le_max_right _ _)
    calc x + y + z ≤ m + m + m := add_le_add (add_le_add h1 h2) h3
      _ = 3 * m := by ring
  have hm' : m ^ r ≤ x ^ r + y ^ r + z ^ r := by
    rcases max_choice x (max y z) with h | h <;> rw [show m = _ from h]
    · exact le_add_right (le_add_right le_rfl)
    · rcases max_choice y z with h' | h' <;> rw [h']
      · exact le_add_right (le_add_left le_rfl)
      · exact le_add_left le_rfl
  calc (x + y + z) ^ r ≤ (3 * m) ^ r := ENNReal.rpow_le_rpow hm hr
    _ = 3 ^ r * m ^ r := ENNReal.mul_rpow_of_nonneg _ _ hr
    _ ≤ _ := mul_le_mul' le_rfl hm'

/-- The three-term triangle inequality `|a_t - a_s| ≤ |a_t - a_Q| + |a_Q - a_P| + |a_P - a_s|`. -/
theorem norm_sub_le_three (a : ℝ → ℂ) (s P Q t : ℝ) :
    ‖a t - a s‖ ≤ ‖a t - a Q‖ + ‖a Q - a P‖ + ‖a P - a s‖ := by
  calc ‖a t - a s‖ = ‖(a t - a Q) + (a Q - a P) + (a P - a s)‖ := by ring_nf
    _ ≤ _ := (norm_add_le _ _).trans (by gcongr; exact norm_add_le _ _)

/-- The three-term triangle inequality for `‖·‖ₑ`. -/
theorem enorm_sub_le_three (a : ℝ → ℂ) (s P Q t : ℝ) :
    ‖a t - a s‖ₑ ≤ ‖a t - a Q‖ₑ + ‖a Q - a P‖ₑ + ‖a P - a s‖ₑ := by
  calc ‖a t - a s‖ₑ = ‖(a t - a Q) + (a Q - a P) + (a P - a s)‖ₑ := by ring_nf
    _ ≤ _ := (enorm_add_le _ _).trans (add_le_add (enorm_add_le _ _) le_rfl)

variable {ι : Type*} [LinearOrder ι]

/-- For pairs not crossing a dyadic point (`s_i, t_i` in the same `J_j`), weakly ordered:
`∑_i |a_{t_i} - a_{s_i}|^r ≤ ∑_j (V^r_{J_j} a)^r`. -/
theorem sum_le_tsum_of_dyadicIndex_eq (hα : 0 < α) {r : ℝ} (hr : 0 < r) (a : ℝ → ℂ)
    (S : Finset ι) {s t : ι → ℝ} (hst : ∀ i ∈ S, s i ≤ t i)
    (hord : ∀ i ∈ S, ∀ j ∈ S, i < j → t i ≤ s j) (hs : ∀ i ∈ S, 0 < s i)
    (hk : ∀ i ∈ S, dyadicIndex α (s i) = dyadicIndex α (t i)) :
    ∑ i ∈ S, ‖a (t i) - a (s i)‖ₑ ^ r ≤ ∑' j : ℤ, variationNorm r (shortInterval α j) a ^ r := by
  classical
  rw [← Finset.sum_fiberwise_of_maps_to (t := S.image fun i => dyadicIndex α (s i))
    (g := fun i => dyadicIndex α (s i)) (fun i hi => Finset.mem_image_of_mem _ hi)]
  refine (Finset.sum_le_sum fun j _ => ?_).trans (ENNReal.sum_le_tsum _)
  refine sum_le_variationNorm_rpow_of_pairs hr _ (fun i hi => hst i (Finset.mem_filter.1 hi).1)
    (fun i hi i' hi' h => hord i (Finset.mem_filter.1 hi).1 i' (Finset.mem_filter.1 hi').1 h)
    (fun i hi => ?_) (fun i hi => ?_)
  · obtain ⟨hiS, hj⟩ := Finset.mem_filter.1 hi
    rw [← hj]
    exact mem_shortInterval_dyadicIndex hα (hs i hiS)
  · obtain ⟨hiS, hj⟩ := Finset.mem_filter.1 hi
    rw [← hj, hk i hiS]
    exact mem_shortInterval_dyadicIndex hα ((hs i hiS).trans_le (hst i hiS))

/-- Pairs charged injectively to short intervals:
`∑_i |a_{t_i} - a_{s_i}|^r ≤ ∑_j (V^r_{J_j} a)^r` if `s_i ≤ t_i` lie in `J_{κ i}`, `κ` injective. -/
theorem sum_le_tsum_of_injOn {r : ℝ} (hr : 0 < r) (a : ℝ → ℂ) {κ' : Type*} (S : Finset κ')
    {s t : κ' → ℝ} (κ : κ' → ℤ) (hκ : Set.InjOn κ S) (hst : ∀ i ∈ S, s i ≤ t i)
    (hs : ∀ i ∈ S, s i ∈ shortInterval α (κ i)) (ht : ∀ i ∈ S, t i ∈ shortInterval α (κ i)) :
    ∑ i ∈ S, ‖a (t i) - a (s i)‖ₑ ^ r ≤ ∑' j : ℤ, variationNorm r (shortInterval α j) a ^ r := by
  classical
  calc ∑ i ∈ S, ‖a (t i) - a (s i)‖ₑ ^ r
      ≤ ∑ i ∈ S, variationNorm r (shortInterval α (κ i)) a ^ r :=
        Finset.sum_le_sum fun i hi => rpow_le_variationNorm_rpow hr (hst i hi) (hs i hi) (ht i hi)
    _ = ∑ j ∈ S.image κ, variationNorm r (shortInterval α j) a ^ r :=
        (Finset.sum_image (f := fun j => variationNorm r (shortInterval α j) a ^ r) hκ).symm
    _ ≤ _ := ENNReal.sum_le_tsum _

/-- A crossing pair has `dyadicIndex s < dyadicIndex t`. -/
theorem dyadicIndex_lt_of_ne (hα : 0 < α) {s t : ℝ} (hs : 0 < s) (hst : s ≤ t)
    (h : dyadicIndex α s ≠ dyadicIndex α t) : dyadicIndex α s < dyadicIndex α t :=
  lt_of_le_of_ne (dyadicIndex_mono hα hs hst) h

/-- In a weakly ordered family, distinct crossing pairs end in distinct short intervals. -/
theorem injOn_dyadicIndex_right (hα : 0 < α) (S : Finset ι) {s t : ι → ℝ}
    (hst : ∀ i ∈ S, s i ≤ t i) (hord : ∀ i ∈ S, ∀ j ∈ S, i < j → t i ≤ s j)
    (hs : ∀ i ∈ S, 0 < s i) :
    Set.InjOn (fun i => dyadicIndex α (t i))
      (S.filter fun i => dyadicIndex α (s i) ≠ dyadicIndex α (t i) : Finset ι) := by
  intro i hi j hj heq
  simp only [Finset.mem_coe, Finset.mem_filter] at hi hj
  by_contra hne
  have key : ∀ i j, i ∈ S ∧ dyadicIndex α (s i) ≠ dyadicIndex α (t i) →
      j ∈ S ∧ dyadicIndex α (s j) ≠ dyadicIndex α (t j) → i < j →
      dyadicIndex α (t i) < dyadicIndex α (t j) := by
    intro i j hi hj hij
    calc dyadicIndex α (t i) ≤ dyadicIndex α (s j) :=
          dyadicIndex_mono hα ((hs i hi.1).trans_le (hst i hi.1)) (hord i hi.1 j hj.1 hij)
      _ < _ := dyadicIndex_lt_of_ne hα (hs j hj.1) (hst j hj.1) hj.2
  rcases lt_or_gt_of_ne hne with h | h
  · exact (key i j hi hj h).ne heq
  · exact (key j i hj hi h).ne heq.symm

/-- In a weakly ordered family, distinct crossing pairs start in distinct short intervals. -/
theorem injOn_dyadicIndex_left (hα : 0 < α) (S : Finset ι) {s t : ι → ℝ}
    (hst : ∀ i ∈ S, s i ≤ t i) (hord : ∀ i ∈ S, ∀ j ∈ S, i < j → t i ≤ s j)
    (hs : ∀ i ∈ S, 0 < s i) :
    Set.InjOn (fun i => dyadicIndex α (s i))
      (S.filter fun i => dyadicIndex α (s i) ≠ dyadicIndex α (t i) : Finset ι) := by
  intro i hi j hj heq
  simp only [Finset.mem_coe, Finset.mem_filter] at hi hj
  by_contra hne
  have key : ∀ i j, i ∈ S ∧ dyadicIndex α (s i) ≠ dyadicIndex α (t i) →
      j ∈ S → i < j → dyadicIndex α (s i) < dyadicIndex α (s j) := by
    intro i j hi hj hij
    calc dyadicIndex α (s i) < dyadicIndex α (t i) :=
          dyadicIndex_lt_of_ne hα (hs i hi.1) (hst i hi.1) hi.2
      _ ≤ _ := dyadicIndex_mono hα ((hs i hi.1).trans_le (hst i hi.1)) (hord i hi.1 j hj hij)
  rcases lt_or_gt_of_ne hne with h | h
  · exact (key i j hi hj.1 h).ne heq
  · exact (key j i hj hi.1 h).ne heq.symm

/-- Right ends of crossing pairs: `∑_{crossing i} |a_{t_i} - a_{2^{kα}}|^r ≤ ∑_j (V^r_{J_j})^r`,
`k = dyadicIndex α t_i`. -/
theorem sum_cross_right_le (hα : 0 < α) {r : ℝ} (hr : 0 < r) (a : ℝ → ℂ) (S : Finset ι)
    {s t : ι → ℝ} (hst : ∀ i ∈ S, s i ≤ t i) (hord : ∀ i ∈ S, ∀ j ∈ S, i < j → t i ≤ s j)
    (hs : ∀ i ∈ S, 0 < s i) :
    ∑ i ∈ S.filter (fun i => dyadicIndex α (s i) ≠ dyadicIndex α (t i)),
        ‖a (t i) - a (dyadicPoint α (dyadicIndex α (t i)))‖ₑ ^ r ≤
      ∑' j : ℤ, variationNorm r (shortInterval α j) a ^ r := by
  have ht : ∀ i ∈ S, 0 < t i := fun i hi => (hs i hi).trans_le (hst i hi)
  refine sum_le_tsum_of_injOn hr a _ (fun i => dyadicIndex α (t i))
    (injOn_dyadicIndex_right hα S hst hord hs) (fun i hi => ?_) (fun i _ => ?_) (fun i hi => ?_)
  · exact dyadicPoint_dyadicIndex_le hα (ht i (Finset.mem_filter.1 hi).1)
  · exact dyadicPoint_mem_shortInterval hα _
  · exact mem_shortInterval_dyadicIndex hα (ht i (Finset.mem_filter.1 hi).1)

/-- Left ends of crossing pairs: `∑_{crossing i} |a_{2^{(k+1)α}} - a_{s_i}|^r ≤ ∑_j (V^r_{J_j})^r`,
`k = dyadicIndex α s_i`. -/
theorem sum_cross_left_le (hα : 0 < α) {r : ℝ} (hr : 0 < r) (a : ℝ → ℂ) (S : Finset ι)
    {s t : ι → ℝ} (hst : ∀ i ∈ S, s i ≤ t i) (hord : ∀ i ∈ S, ∀ j ∈ S, i < j → t i ≤ s j)
    (hs : ∀ i ∈ S, 0 < s i) :
    ∑ i ∈ S.filter (fun i => dyadicIndex α (s i) ≠ dyadicIndex α (t i)),
        ‖a (dyadicPoint α (dyadicIndex α (s i) + 1)) - a (s i)‖ₑ ^ r ≤
      ∑' j : ℤ, variationNorm r (shortInterval α j) a ^ r := by
  refine sum_le_tsum_of_injOn hr a _ (fun i => dyadicIndex α (s i))
    (injOn_dyadicIndex_left hα S hst hord hs) (fun i hi => ?_) (fun i hi => ?_) (fun i _ => ?_)
  · exact (lt_dyadicPoint_dyadicIndex_add_one hα (hs i (Finset.mem_filter.1 hi).1)).le
  · exact mem_shortInterval_dyadicIndex hα (hs i (Finset.mem_filter.1 hi).1)
  · exact dyadicPoint_add_one_mem_shortInterval hα _

/-- **Long/short splitting**, `r`-th power form: for `α > 0`, `r > 0`,
`(V^r_{(0,∞)} a)^r ≤ (1 + 2·3^r) S_r(a)^r + 3^r (V^r_{dyad} a)^r`
(Section 1.2 of the paper; cf. Jones–Seeger–Wright, Lemma 1.3). -/
theorem variationNorm_Ioi_rpow_le (hα : 0 < α) {r : ℝ} (hr : 0 < r) (a : ℝ → ℂ) :
    variationNorm r (Ioi 0) a ^ r ≤ (1 + 2 * 3 ^ r) * shortVariation r α a ^ r +
      3 ^ r * variationNorm r (dyadicSet α) a ^ r := by
  classical
  rw [shortVariation, rpow_one_div_rpow hr.ne']
  refine variationNorm_rpow_le hr fun J u hu hm => ?_
  set s : Fin J → ℝ := fun i => u i.castSucc
  set t : Fin J → ℝ := fun i => u i.succ
  have hst : ∀ i ∈ (Finset.univ : Finset (Fin J)), s i ≤ t i :=
    fun i _ => (hu Fin.castSucc_lt_succ).le
  have hord : ∀ i ∈ (Finset.univ : Finset (Fin J)), ∀ j ∈ (Finset.univ : Finset (Fin J)),
      i < j → t i ≤ s j := fun i _ j _ hij => hu.monotone (Fin.succ_le_castSucc_iff.2 hij)
  have hs : ∀ i ∈ (Finset.univ : Finset (Fin J)), 0 < s i := fun i _ => hm _
  set SS := ∑' j : ℤ, variationNorm r (shortInterval α j) a ^ r
  set C := Finset.univ.filter (fun i => dyadicIndex α (s i) ≠ dyadicIndex α (t i))
  set P : Fin J → ℝ := fun i => dyadicPoint α (dyadicIndex α (s i) + 1)
  set Q : Fin J → ℝ := fun i => dyadicPoint α (dyadicIndex α (t i))
  have hnc : ∑ i ∈ Finset.univ.filter (fun i => ¬ dyadicIndex α (s i) ≠ dyadicIndex α (t i)),
      ‖a (t i) - a (s i)‖ₑ ^ r ≤ SS :=
    sum_le_tsum_of_dyadicIndex_eq hα hr a _ (fun i hi => hst i (Finset.mem_univ _))
      (fun i _ j _ hij => hord i (Finset.mem_univ _) j (Finset.mem_univ _) hij)
      (fun i _ => hs i (Finset.mem_univ _)) (fun i hi => not_not.1 (Finset.mem_filter.1 hi).2)
  have hR := sum_cross_right_le hα hr a _ hst hord hs
  have hL := sum_cross_left_le hα hr a _ hst hord hs
  have hD : ∑ i ∈ C, ‖a (Q i) - a (P i)‖ₑ ^ r ≤ variationNorm r (dyadicSet α) a ^ r := by
    refine sum_le_variationNorm_rpow_of_pairs hr C (fun i hi => ?_) (fun i hi j hj hij => ?_)
      (fun i _ => dyadicPoint_mem_dyadicSet α _) (fun i _ => dyadicPoint_mem_dyadicSet α _)
    · exact (dyadicPoint_strictMono hα).monotone (Int.add_one_le_of_lt
        (dyadicIndex_lt_of_ne hα (hs i (Finset.mem_univ _)) (hst i (Finset.mem_univ _))
          (Finset.mem_filter.1 hi).2))
    · refine (dyadicPoint_strictMono hα).monotone ((dyadicIndex_mono hα ?_
        (hord i (Finset.mem_univ _) j (Finset.mem_univ _) hij)).trans (Int.le_add_one le_rfl))
      exact (hs i (Finset.mem_univ _)).trans_le (hst i (Finset.mem_univ _))
  have hcross : ∑ i ∈ C, ‖a (t i) - a (s i)‖ₑ ^ r ≤
      3 ^ r * (SS + variationNorm r (dyadicSet α) a ^ r + SS) := by
    calc ∑ i ∈ C, ‖a (t i) - a (s i)‖ₑ ^ r
        ≤ ∑ i ∈ C, 3 ^ r * (‖a (t i) - a (Q i)‖ₑ ^ r + ‖a (Q i) - a (P i)‖ₑ ^ r +
            ‖a (P i) - a (s i)‖ₑ ^ r) := Finset.sum_le_sum fun i _ =>
          (ENNReal.rpow_le_rpow (enorm_sub_le_three a (s i) (P i) (Q i) (t i)) hr.le).trans
            (add_add_rpow_le hr.le _ _ _)
      _ = 3 ^ r * (∑ i ∈ C, ‖a (t i) - a (Q i)‖ₑ ^ r + ∑ i ∈ C, ‖a (Q i) - a (P i)‖ₑ ^ r +
            ∑ i ∈ C, ‖a (P i) - a (s i)‖ₑ ^ r) := by
          rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, Finset.mul_sum]
      _ ≤ _ := mul_le_mul' le_rfl (add_le_add (add_le_add hR hD) hL)
  rw [← Finset.sum_filter_add_sum_filter_not Finset.univ
    (fun i => dyadicIndex α (s i) ≠ dyadicIndex α (t i))]
  calc _ ≤ 3 ^ r * (SS + variationNorm r (dyadicSet α) a ^ r + SS) + SS := add_le_add hcross hnc
    _ = _ := by ring

/-- **Long/short splitting** (Section 1.2; cf. Jones–Seeger–Wright, Lemma 1.3): for `α > 0` and
`r ≥ 1`, `V^r_{(0,∞)} a ≤ 9 (S_r(a) + V^r_{dyad} a)`. -/
theorem variationNorm_Ioi_le (hα : 0 < α) {r : ℝ} (hr : 1 ≤ r) (a : ℝ → ℂ) :
    variationNorm r (Ioi 0) a ≤ 9 * (shortVariation r α a + variationNorm r (dyadicSet α) a) := by
  have hr0 : 0 < r := by linarith
  set S := shortVariation r α a
  set D := variationNorm r (dyadicSet α) a
  have h3 : (1 : ℝ≥0∞) ≤ 3 ^ r := ENNReal.one_le_rpow (by norm_num) hr0
  have h1 : variationNorm r (Ioi 0) a ^ r ≤ (3 * 3 ^ r) * (S + D) ^ r := by
    refine (variationNorm_Ioi_rpow_le hα hr0 a).trans ?_
    calc (1 + 2 * 3 ^ r) * S ^ r + 3 ^ r * D ^ r ≤ (3 * 3 ^ r) * S ^ r + (3 * 3 ^ r) * D ^ r := by
          gcongr
          · calc (1 : ℝ≥0∞) + 2 * 3 ^ r ≤ 3 ^ r + 2 * 3 ^ r := add_le_add h3 le_rfl
              _ = 3 * 3 ^ r := by ring
          · exact le_mul_of_one_le_left (by positivity) (by norm_num)
      _ = (3 * 3 ^ r) * (S ^ r + D ^ r) := by ring
      _ ≤ _ := mul_le_mul' le_rfl (ENNReal.add_rpow_le_rpow_add _ _ hr)
  calc variationNorm r (Ioi 0) a ≤ ((3 * 3 ^ r) * (S + D) ^ r) ^ (1 / r) :=
        (rpow_rpow_one_div hr0.ne' _).symm.trans_le (ENNReal.rpow_le_rpow h1 (by positivity))
    _ = 3 ^ (1 / r) * 3 * (S + D) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity), rpow_rpow_one_div hr0.ne',
          rpow_rpow_one_div hr0.ne']
    _ ≤ 3 ^ (1 : ℝ) * 3 * (S + D) := by
        gcongr
        · norm_num
        · rw [div_le_one hr0]; exact hr
    _ = 9 * (S + D) := by rw [ENNReal.rpow_one]; norm_num

end LongShort

/-! ## Lemma 1.3: long and short jumps (Section 1.2) -/

section JumpLemma

variable {α : ℝ}

/-- **Lemma 1.3** of the paper (Section 1.2, the unnumbered lemma before Proposition 1.4; cf.
Jones–Seeger–Wright), `r`-th power form: for `α > 0`, `r > 0`, `λ ≥ 0`,
`λ^r N_λ{a_u : u > 0} ≤ (1 + 2·3^r) (S_r(a)^r + λ^r N^{dyad}_{λ/3}(a))`.
A `λ`-jump inside a short interval is charged to `V^r_{J_j}`; a crossing `λ`-jump from `J_i` to
`J_k` has a `λ/3`-jump on `[s, 2^{(i+1)α}]`, on `[2^{kα}, t]`, or on the dyadic pair
`(2^{(i+1)α}, 2^{kα})`. -/
theorem rpow_mul_jumpFunction_Ioi_le (hα : 0 < α) {r : ℝ} (hr : 0 < r) {lam : ℝ}
    (hlam : 0 ≤ lam) (a : ℝ → ℂ) :
    ENNReal.ofReal lam ^ r * jumpFunction lam (Ioi 0) a ≤
      (1 + 2 * 3 ^ r) * (shortVariation r α a ^ r +
        ENNReal.ofReal lam ^ r * jumpFunction (lam / 3) (dyadicSet α) a) := by
  classical
  rw [shortVariation, rpow_one_div_rpow hr.ne']
  refine mul_jumpFunction_le _ fun N s t h1 h2 h3 h4 => ?_
  have hst : ∀ i ∈ (Finset.univ : Finset (Fin N)), s i ≤ t i := fun i _ => (h1 i).le
  have hord : ∀ i ∈ (Finset.univ : Finset (Fin N)), ∀ j ∈ (Finset.univ : Finset (Fin N)),
      i < j → t i ≤ s j := fun i _ j _ hij => (h2 i j hij).le
  have hs : ∀ i ∈ (Finset.univ : Finset (Fin N)), 0 < s i := fun i _ => (h3 i).1
  have ht : ∀ i, 0 < t i := fun i => (h3 i).2
  set SS := ∑' j : ℤ, variationNorm r (shortInterval α j) a ^ r
  set c := ENNReal.ofReal lam ^ r with hc_def
  set C := Finset.univ.filter (fun i => dyadicIndex α (s i) ≠ dyadicIndex α (t i))
  set P : Fin N → ℝ := fun i => dyadicPoint α (dyadicIndex α (s i) + 1)
  set Q : Fin N → ℝ := fun i => dyadicPoint α (dyadicIndex α (t i))
  set C₁ := C.filter (fun i => lam / 3 < ‖a (t i) - a (Q i)‖ ∨ lam / 3 < ‖a (P i) - a (s i)‖)
  set C₂ := C.filter
    (fun i => ¬ (lam / 3 < ‖a (t i) - a (Q i)‖ ∨ lam / 3 < ‖a (P i) - a (s i)‖))
  have hc : ∀ i, c ≤ ‖a (t i) - a (s i)‖ₑ ^ r := fun i => ENNReal.rpow_le_rpow
    (by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (h4 i).le) hr.le
  have h3r : c = 3 ^ r * ENNReal.ofReal (lam / 3) ^ r := by
    rw [hc_def, ← ENNReal.mul_rpow_of_nonneg _ _ hr.le]
    congr 1
    rw [show (3 : ℝ≥0∞) = ENNReal.ofReal 3 by simp, ← ENNReal.ofReal_mul (by norm_num)]
    congr 1; ring
  have hle3 : ∀ {x : ℝ} {y : ℝ≥0∞}, lam / 3 < x → ENNReal.ofReal x ≤ y →
      ENNReal.ofReal (lam / 3) ^ r ≤ y ^ r := fun hx hy =>
    ENNReal.rpow_le_rpow ((ENNReal.ofReal_le_ofReal hx.le).trans hy) hr.le
  have hnc : ∑ i ∈ Finset.univ.filter (fun i => ¬ dyadicIndex α (s i) ≠ dyadicIndex α (t i)),
      c ≤ SS :=
    (Finset.sum_le_sum fun i _ => hc i).trans
      (sum_le_tsum_of_dyadicIndex_eq hα hr a _ (fun i _ => hst i (Finset.mem_univ _))
        (fun i _ j _ hij => hord i (Finset.mem_univ _) j (Finset.mem_univ _) hij)
        (fun i _ => hs i (Finset.mem_univ _)) (fun i hi => not_not.1 (Finset.mem_filter.1 hi).2))
  have hR := sum_cross_right_le hα hr a _ hst hord hs
  have hL := sum_cross_left_le hα hr a _ hst hord hs
  have hC₁ : ∑ i ∈ C₁, c ≤ 3 ^ r * (SS + SS) := by
    calc ∑ i ∈ C₁, c
        ≤ ∑ i ∈ C₁, 3 ^ r * (‖a (t i) - a (Q i)‖ₑ ^ r + ‖a (P i) - a (s i)‖ₑ ^ r) :=
          Finset.sum_le_sum fun i hi => by
            rw [h3r]
            refine mul_le_mul' le_rfl ?_
            rcases (Finset.mem_filter.1 hi).2 with h | h
            · exact le_add_right (hle3 h (by rw [ofReal_norm]))
            · exact le_add_left (hle3 h (by rw [ofReal_norm]))
      _ ≤ ∑ i ∈ C, 3 ^ r * (‖a (t i) - a (Q i)‖ₑ ^ r + ‖a (P i) - a (s i)‖ₑ ^ r) :=
          Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)
      _ = 3 ^ r * (∑ i ∈ C, ‖a (t i) - a (Q i)‖ₑ ^ r + ∑ i ∈ C, ‖a (P i) - a (s i)‖ₑ ^ r) := by
          rw [← Finset.sum_add_distrib, Finset.mul_sum]
      _ ≤ _ := mul_le_mul' le_rfl (add_le_add hR hL)
  have hD : ∀ i ∈ C₂, lam / 3 < ‖a (Q i) - a (P i)‖ := by
    intro i hi
    obtain ⟨hR', hL'⟩ := not_or.1 (Finset.mem_filter.1 hi).2
    have := norm_sub_le_three a (s i) (P i) (Q i) (t i)
    have := h4 i
    linarith [not_lt.1 hR', not_lt.1 hL']
  have hC₂ : ∑ i ∈ C₂, c ≤ c * jumpFunction (lam / 3) (dyadicSet α) a := by
    rw [Finset.sum_const, nsmul_eq_mul, mul_comm]
    refine mul_le_mul' le_rfl (card_le_jumpFunction C₂ (s := P) (t := Q) ?_ ?_
      (fun _ _ => dyadicPoint_mem_dyadicSet α _) (fun _ _ => dyadicPoint_mem_dyadicSet α _) hD)
    · intro i hi
      have hiC := (Finset.mem_filter.1 hi).1
      have hlt := dyadicIndex_lt_of_ne hα (hs i (Finset.mem_univ _)) (hst i (Finset.mem_univ _))
        (Finset.mem_filter.1 hiC).2
      rcases (Int.add_one_le_of_lt hlt).lt_or_eq with h | h
      · exact dyadicPoint_strictMono hα h
      · exfalso
        have hPQ : P i = Q i := by simp only [P, Q, h]
        have := hD i hi
        rw [hPQ, sub_self, norm_zero] at this
        linarith
    · intro i _ j _ hij
      exact dyadicPoint_strictMono hα
        (Int.lt_add_one_iff.2 (dyadicIndex_mono hα (ht i) (h2 i j hij).le))
  have hN : c * (N : ℝ≥0∞) = ∑ i ∈ C₁, c + ∑ i ∈ C₂, c +
      ∑ i ∈ Finset.univ.filter (fun i => ¬ dyadicIndex α (s i) ≠ dyadicIndex α (t i)), c := by
    rw [Finset.sum_filter_add_sum_filter_not, Finset.sum_filter_add_sum_filter_not]
    simp [mul_comm]
  rw [hN]
  calc _ ≤ 3 ^ r * (SS + SS) + c * jumpFunction (lam / 3) (dyadicSet α) a + SS :=
        add_le_add (add_le_add hC₁ hC₂) hnc
    _ = (1 + 2 * 3 ^ r) * SS + c * jumpFunction (lam / 3) (dyadicSet α) a := by ring
    _ ≤ (1 + 2 * 3 ^ r) * SS + (1 + 2 * 3 ^ r) * (c * jumpFunction (lam / 3) (dyadicSet α) a) :=
        add_le_add le_rfl (le_mul_of_one_le_left (by positivity) le_self_add)
    _ = _ := by ring

/-- **Lemma 1.3** of the paper (Section 1.2), root form: for `α > 0`, `r ≥ 1`, `λ ≥ 0`,
`λ N_λ{a_u : u > 0}^{1/r} ≤ (1 + 2·3^r)^{1/r} (S_r(a) + λ N^{dyad}_{λ/3}(a)^{1/r})`. -/
theorem mul_jumpFunction_Ioi_rpow_le (hα : 0 < α) {r : ℝ} (hr : 1 ≤ r) {lam : ℝ}
    (hlam : 0 ≤ lam) (a : ℝ → ℂ) :
    ENNReal.ofReal lam * jumpFunction lam (Ioi 0) a ^ (1 / r) ≤
      (1 + 2 * 3 ^ r) ^ (1 / r) * (shortVariation r α a +
        ENNReal.ofReal lam * jumpFunction (lam / 3) (dyadicSet α) a ^ (1 / r)) := by
  have hr0 : 0 < r := by linarith
  have hp : 0 ≤ 1 / r := by positivity
  have h := rpow_mul_jumpFunction_Ioi_le hα hr0 hlam a
  calc ENNReal.ofReal lam * jumpFunction lam (Ioi 0) a ^ (1 / r)
      = (ENNReal.ofReal lam ^ r * jumpFunction lam (Ioi 0) a) ^ (1 / r) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp, rpow_rpow_one_div hr0.ne']
    _ ≤ ((1 + 2 * 3 ^ r) * (shortVariation r α a ^ r +
          ENNReal.ofReal lam ^ r * jumpFunction (lam / 3) (dyadicSet α) a)) ^ (1 / r) :=
        ENNReal.rpow_le_rpow h hp
    _ = (1 + 2 * 3 ^ r) ^ (1 / r) * (shortVariation r α a ^ r +
          ENNReal.ofReal lam ^ r * jumpFunction (lam / 3) (dyadicSet α) a) ^ (1 / r) :=
        ENNReal.mul_rpow_of_nonneg _ _ hp
    _ ≤ (1 + 2 * 3 ^ r) ^ (1 / r) * ((shortVariation r α a ^ r) ^ (1 / r) +
          (ENNReal.ofReal lam ^ r * jumpFunction (lam / 3) (dyadicSet α) a) ^ (1 / r)) :=
        mul_le_mul' le_rfl (ENNReal.rpow_add_le_add_rpow _ _ hp
          (by rw [div_le_one hr0]; exact hr))
    _ = _ := by
        rw [rpow_rpow_one_div hr0.ne', ENNReal.mul_rpow_of_nonneg _ _ hp,
          rpow_rpow_one_div hr0.ne']

/-- **Lemma 1.3** of the paper (Section 1.2) for `r = 2`, the form used for the second part of
Theorem 1.1: `λ √(N_λ{a_u : u > 0}) ≤ 5 (S_2(a) + λ √(N^{dyad}_{λ/3}(a)))`. -/
theorem mul_sqrt_jumpFunction_Ioi_le (hα : 0 < α) {lam : ℝ} (hlam : 0 ≤ lam) (a : ℝ → ℂ) :
    ENNReal.ofReal lam * jumpFunction lam (Ioi 0) a ^ (1 / 2 : ℝ) ≤
      5 * (shortVariation 2 α a +
        ENNReal.ofReal lam * jumpFunction (lam / 3) (dyadicSet α) a ^ (1 / 2 : ℝ)) := by
  refine (mul_jumpFunction_Ioi_rpow_le hα one_le_two hlam a).trans (mul_le_mul' ?_ le_rfl)
  have h : (1 + 2 * 3 ^ (2 : ℝ) : ℝ≥0∞) ≤ 5 ^ (2 : ℝ) := by
    rw [ENNReal.rpow_two, ENNReal.rpow_two]; norm_num
  calc (1 + 2 * 3 ^ (2 : ℝ) : ℝ≥0∞) ^ (1 / 2 : ℝ) ≤ (5 ^ (2 : ℝ)) ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_le_rpow h (by norm_num)
    _ = 5 := rpow_rpow_one_div two_ne_zero _

end JumpLemma

/-! ## Splitting at a point, approximation, reflection and conjugation

To pass from `u > 0` to `u ∈ ℝ` in Theorem 1.1, the paper splits `ℝ` at `0` and uses
`𝓗^{(-u)} f = conj 𝓗^{(u)} (conj f)`. We split a chain at a point `c ∈ 𝒥` via the monotone maps
`u ↦ min(u, c)` and `u ↦ max(u, c)`; the point `c = 0` is then removed by approximation, using
continuity of the family at `0`. -/

section Splitting

/-- `|a_t - a_s| ≤ |a_{min(t,c)} - a_{min(s,c)}| + |a_{max(t,c)} - a_{max(s,c)}|` for `s ≤ t`. -/
theorem norm_sub_le_min_add_max (a : ℝ → ℂ) {s t : ℝ} (hst : s ≤ t) (c : ℝ) :
    ‖a t - a s‖ ≤ ‖a (min t c) - a (min s c)‖ + ‖a (max t c) - a (max s c)‖ := by
  rcases le_total t c with htc | hct
  · have hsc : s ≤ c := hst.trans htc
    simp [min_eq_left htc, min_eq_left hsc, max_eq_right htc, max_eq_right hsc]
  · rcases le_total s c with hsc | hcs
    · rw [min_eq_right hct, min_eq_left hsc, max_eq_left hct, max_eq_right hsc]
      calc ‖a t - a s‖ = ‖(a c - a s) + (a t - a c)‖ := by ring_nf
        _ ≤ _ := norm_add_le _ _
    · simp [min_eq_right hct, min_eq_right hcs, max_eq_left hct, max_eq_left hcs]

/-- The `‖·‖ₑ` version of `norm_sub_le_min_add_max`. -/
theorem enorm_sub_le_min_add_max (a : ℝ → ℂ) {s t : ℝ} (hst : s ≤ t) (c : ℝ) :
    ‖a t - a s‖ₑ ≤ ‖a (min t c) - a (min s c)‖ₑ + ‖a (max t c) - a (max s c)‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm, ← ofReal_norm,
    ← ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
  exact ENNReal.ofReal_le_ofReal (norm_sub_le_min_add_max a hst c)

/-- `min(x, c) ∈ 𝒥 ∩ (-∞, c]` for `x, c ∈ 𝒥`. -/
theorem min_mem_inter_Iic {𝒥 : Set ℝ} {x c : ℝ} (hx : x ∈ 𝒥) (hc : c ∈ 𝒥) :
    min x c ∈ 𝒥 ∩ Iic c := by
  refine ⟨?_, Set.mem_Iic.2 (min_le_right _ _)⟩
  rcases min_choice x c with h | h <;> rw [h] <;> assumption

/-- `max(x, c) ∈ 𝒥 ∩ [c, ∞)` for `x, c ∈ 𝒥`. -/
theorem max_mem_inter_Ici {𝒥 : Set ℝ} {x c : ℝ} (hx : x ∈ 𝒥) (hc : c ∈ 𝒥) :
    max x c ∈ 𝒥 ∩ Ici c := by
  refine ⟨?_, Set.mem_Ici.2 (le_max_right _ _)⟩
  rcases max_choice x c with h | h <;> rw [h] <;> assumption

/-- **Splitting the variation at a point** `c ∈ 𝒥` (`r ≥ 1`):
`V^r_𝒥 a ≤ V^r_{𝒥 ∩ (-∞, c]} a + V^r_{𝒥 ∩ [c, ∞)} a`. -/
theorem variationNorm_le_add_of_mem {r : ℝ} (hr : 1 ≤ r) {𝒥 : Set ℝ} {c : ℝ} (hc : c ∈ 𝒥)
    (a : ℝ → ℂ) :
    variationNorm r 𝒥 a ≤ variationNorm r (𝒥 ∩ Iic c) a + variationNorm r (𝒥 ∩ Ici c) a := by
  have hr0 : 0 < r := by linarith
  refine variationNorm_le fun J u hu hm => ?_
  have hmono := hu.monotone
  have hle : ∀ i : Fin J, u i.castSucc ≤ u i.succ := fun i => hmono Fin.castSucc_lt_succ.le
  have hord : ∀ i j : Fin J, i < j → u i.succ ≤ u j.castSucc :=
    fun i j hij => hmono (Fin.succ_le_castSucc_iff.2 hij)
  calc (∑ i : Fin J, ‖a (u i.succ) - a (u i.castSucc)‖ₑ ^ r) ^ (1 / r)
      ≤ (∑ i : Fin J, (‖a (min (u i.succ) c) - a (min (u i.castSucc) c)‖ₑ +
          ‖a (max (u i.succ) c) - a (max (u i.castSucc) c)‖ₑ) ^ r) ^ (1 / r) := by
        gcongr with i
        exact enorm_sub_le_min_add_max a (hle i) c
    _ ≤ _ := ENNReal.Lp_add_le _ _ _ hr
    _ ≤ _ := by
        refine add_le_add (rpow_one_div_le_of_le_rpow hr0 ?_) (rpow_one_div_le_of_le_rpow hr0 ?_)
        · exact sum_le_variationNorm_rpow_of_pairs hr0 Finset.univ
            (fun i _ => min_le_min_right c (hle i))
            (fun i _ j _ hij => min_le_min_right c (hord i j hij))
            (fun i _ => min_mem_inter_Iic (hm _) hc) (fun i _ => min_mem_inter_Iic (hm _) hc)
        · exact sum_le_variationNorm_rpow_of_pairs hr0 Finset.univ
            (fun i _ => max_le_max_right c (hle i))
            (fun i _ j _ hij => max_le_max_right c (hord i j hij))
            (fun i _ => max_mem_inter_Ici (hm _) hc) (fun i _ => max_mem_inter_Ici (hm _) hc)

/-- **Splitting the jump function at a point** `c ∈ 𝒥` (`λ ≥ 0`): at most one `λ`-jump
crosses `c`, and it gives a `λ/2`-jump on one side:
`N_λ(𝒥) ≤ N_{λ/2}(𝒥 ∩ (-∞, c]) + N_{λ/2}(𝒥 ∩ [c, ∞))`. -/
theorem jumpFunction_le_add_of_mem {lam : ℝ} (hlam : 0 ≤ lam) {𝒥 : Set ℝ} {c : ℝ}
    (hc : c ∈ 𝒥) (a : ℝ → ℂ) :
    jumpFunction lam 𝒥 a ≤
      jumpFunction (lam / 2) (𝒥 ∩ Iic c) a + jumpFunction (lam / 2) (𝒥 ∩ Ici c) a := by
  classical
  refine jumpFunction_le fun N s t h1 h2 h3 h4 => ?_
  set L := Finset.univ.filter fun i => lam / 2 < ‖a (min (t i) c) - a (min (s i) c)‖
  set R := Finset.univ.filter fun i => lam / 2 < ‖a (max (t i) c) - a (max (s i) c)‖
  have hcover : Finset.univ ⊆ L ∪ R := by
    intro i _
    have := norm_sub_le_min_add_max a (h1 i).le c
    have := h4 i
    by_contra hni
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and, not_or,
      not_lt, L, R] at hni
    linarith [hni.1, hni.2]
  have hN : (N : ℝ≥0∞) ≤ L.card + R.card := by
    have := (Finset.card_le_card hcover).trans (Finset.card_union_le L R)
    simp only [Finset.card_univ, Fintype.card_fin] at this
    exact_mod_cast this
  refine hN.trans (add_le_add ?_ ?_)
  · refine card_le_jumpFunction L (s := fun i => min (s i) c) (t := fun i => min (t i) c)
      ?_ ?_ (fun i _ => min_mem_inter_Iic (h3 i).1 hc) (fun i _ => min_mem_inter_Iic (h3 i).2 hc)
      (fun i hi => (Finset.mem_filter.1 hi).2)
    · intro i hi
      have hne := (Finset.mem_filter.1 hi).2
      refine lt_of_le_of_ne (min_le_min_right c (h1 i).le) fun heq => ?_
      rw [heq, sub_self, norm_zero] at hne; linarith
    · intro i _ j hj hij
      have hne := (Finset.mem_filter.1 hj).2
      have hsj : s j < c := by
        by_contra h
        rw [not_lt] at h
        rw [min_eq_right h, min_eq_right (h.trans (h1 j).le), sub_self, norm_zero] at hne
        linarith
      rw [min_eq_left hsj.le]
      exact (min_le_left _ _).trans_lt (h2 i j hij)
  · refine card_le_jumpFunction R (s := fun i => max (s i) c) (t := fun i => max (t i) c)
      ?_ ?_ (fun i _ => max_mem_inter_Ici (h3 i).1 hc) (fun i _ => max_mem_inter_Ici (h3 i).2 hc)
      (fun i hi => (Finset.mem_filter.1 hi).2)
    · intro i hi
      have hne := (Finset.mem_filter.1 hi).2
      refine lt_of_le_of_ne (max_le_max_right c (h1 i).le) fun heq => ?_
      rw [heq, sub_self, norm_zero] at hne; linarith
    · intro i hi j _ hij
      have hne := (Finset.mem_filter.1 hi).2
      have hti : c < t i := by
        by_contra h
        rw [not_lt] at h
        rw [max_eq_right h, max_eq_right ((h1 i).le.trans h), sub_self, norm_zero] at hne
        linarith
      rw [max_eq_left hti.le]
      exact (h2 i j hij).trans_le (le_max_left _ _)

/-- Approximation of a point `u` by a sequence `v_m ∈ 𝒦` with `a(v_m) → a(u)`: possible if
`u ∈ 𝒦`, or if `a` is continuous at `u ∈ closure 𝒦`. -/
theorem exists_seq_tendsto_of_mem_or {𝒦 : Set ℝ} {a : ℝ → ℂ} {u : ℝ}
    (h : u ∈ 𝒦 ∨ (ContinuousAt a u ∧ u ∈ closure 𝒦)) :
    ∃ v : ℕ → ℝ, (∀ m, v m ∈ 𝒦) ∧ Tendsto v atTop (𝓝 u) ∧
      Tendsto (fun m => a (v m)) atTop (𝓝 (a u)) := by
  rcases h with h | ⟨hc, h⟩
  · exact ⟨fun _ => u, fun _ => h, tendsto_const_nhds, tendsto_const_nhds⟩
  · obtain ⟨v, hv, hvu⟩ := mem_closure_iff_seq_limit.1 h
    exact ⟨v, hv, hvu, hc.tendsto.comp hvu⟩

/-- **Approximation for the variation norm**: if every `u ∈ 𝒥` is a limit of points `v_m ∈ 𝒦`
with `a(v_m) → a(u)`, then `V^r_𝒥 a ≤ V^r_𝒦 a`. -/
theorem variationNorm_le_of_approx {r : ℝ} {𝒥 𝒦 : Set ℝ} {a : ℝ → ℂ}
    (h : ∀ u ∈ 𝒥, ∃ v : ℕ → ℝ, (∀ m, v m ∈ 𝒦) ∧ Tendsto v atTop (𝓝 u) ∧
      Tendsto (fun m => a (v m)) atTop (𝓝 (a u))) :
    variationNorm r 𝒥 a ≤ variationNorm r 𝒦 a := by
  refine variationNorm_le fun J u hu hm => ?_
  choose v hv𝒦 hvu hva using fun i => h (u i) (hm i)
  have hev : ∀ᶠ m in atTop, StrictMono fun i => v i m := by
    have : ∀ᶠ m in atTop, ∀ i : Fin J, v i.castSucc m < v i.succ m :=
      Filter.eventually_all.2 fun i =>
        (hvu i.castSucc).eventually_lt (hvu i.succ) (hu Fin.castSucc_lt_succ)
    exact this.mono fun m hm => Fin.strictMono_iff_lt_succ.2 hm
  have h1 : ∀ i : Fin J, Tendsto (fun m => ‖a (v i.succ m) - a (v i.castSucc m)‖ₑ ^ r)
      atTop (𝓝 (‖a (u i.succ) - a (u i.castSucc)‖ₑ ^ r)) := fun i =>
    (ENNReal.continuous_rpow_const.tendsto _).comp
      ((continuous_enorm.tendsto _).comp ((hva i.succ).sub (hva i.castSucc)))
  have h2 := tendsto_finsetSum Finset.univ fun i _ => h1 i
  have hT := ((ENNReal.continuous_rpow_const (y := 1 / r)).tendsto _).comp h2
  refine le_of_tendsto hT (hev.mono fun m hm => ?_)
  have := le_variationNorm (r := r) (a := a) hm fun i => hv𝒦 i m
  simp only [Function.comp_apply]
  exact this

/-- **Approximation for the jump function**: if every `u ∈ 𝒥` is a limit of points `v_m ∈ 𝒦`
with `a(v_m) → a(u)`, then `N_λ(𝒥) ≤ N_λ(𝒦)` (the condition `> λ` is open). -/
theorem jumpFunction_le_of_approx {lam : ℝ} {𝒥 𝒦 : Set ℝ} {a : ℝ → ℂ}
    (h : ∀ u ∈ 𝒥, ∃ v : ℕ → ℝ, (∀ m, v m ∈ 𝒦) ∧ Tendsto v atTop (𝓝 u) ∧
      Tendsto (fun m => a (v m)) atTop (𝓝 (a u))) :
    jumpFunction lam 𝒥 a ≤ jumpFunction lam 𝒦 a := by
  refine jumpFunction_le fun N s t h1 h2 h3 h4 => ?_
  choose vs hvs𝒦 hvsu hvsa using fun i => h (s i) (h3 i).1
  choose vt hvt𝒦 hvtu hvta using fun i => h (t i) (h3 i).2
  have e1 : ∀ᶠ m in atTop, ∀ i, vs i m < vt i m :=
    Filter.eventually_all.2 fun i => (hvsu i).eventually_lt (hvtu i) (h1 i)
  have e2 : ∀ᶠ m in atTop, ∀ i j, i < j → vt i m < vs j m :=
    Filter.eventually_all.2 fun i => Filter.eventually_all.2 fun j => by
      by_cases hij : i < j
      · exact ((hvtu i).eventually_lt (hvsu j) (h2 i j hij)).mono fun m hm _ => hm
      · exact Eventually.of_forall fun m h => absurd h hij
  have e3 : ∀ᶠ m in atTop, ∀ i, lam < ‖a (vt i m) - a (vs i m)‖ :=
    Filter.eventually_all.2 fun i =>
      ((continuous_norm.tendsto _).comp ((hvta i).sub (hvsa i))).eventually_const_lt (h4 i)
  obtain ⟨m, hm1, hm2, hm3⟩ := (e1.and (e2.and e3)).exists
  exact natCast_le_jumpFunction hm1 hm2 (fun i => ⟨hvs𝒦 i m, hvt𝒦 i m⟩) hm3

/-- If `𝒦 ⊆ 𝒥` and each `u ∈ 𝒥 ∖ 𝒦` is a point of continuity of `a` in the closure of `𝒦`,
then `V^r_𝒥 a = V^r_𝒦 a`. -/
theorem variationNorm_eq_of_subset_closure {r : ℝ} {𝒥 𝒦 : Set ℝ} {a : ℝ → ℂ}
    (h𝒦 : 𝒦 ⊆ 𝒥) (h : ∀ u ∈ 𝒥, u ∈ 𝒦 ∨ (ContinuousAt a u ∧ u ∈ closure 𝒦)) :
    variationNorm r 𝒥 a = variationNorm r 𝒦 a :=
  le_antisymm (variationNorm_le_of_approx fun u hu => exists_seq_tendsto_of_mem_or (h u hu))
    (variationNorm_mono h𝒦 a)

/-- If `𝒦 ⊆ 𝒥` and each `u ∈ 𝒥 ∖ 𝒦` is a point of continuity of `a` in the closure of `𝒦`,
then `N_λ(𝒥) = N_λ(𝒦)`. -/
theorem jumpFunction_eq_of_subset_closure {lam : ℝ} {𝒥 𝒦 : Set ℝ} {a : ℝ → ℂ}
    (h𝒦 : 𝒦 ⊆ 𝒥) (h : ∀ u ∈ 𝒥, u ∈ 𝒦 ∨ (ContinuousAt a u ∧ u ∈ closure 𝒦)) :
    jumpFunction lam 𝒥 a = jumpFunction lam 𝒦 a :=
  le_antisymm (jumpFunction_le_of_approx fun u hu => exists_seq_tendsto_of_mem_or (h u hu))
    (jumpFunction_mono h𝒦 a)

/-- Points of `(-∞, 0]` are in `(-∞, 0)` or are the point of continuity `0`. -/
theorem mem_Iio_or_of_mem_Iic {a : ℝ → ℂ} (ha : ContinuousAt a 0) {u : ℝ} (hu : u ∈ Iic 0) :
    u ∈ Iio 0 ∨ (ContinuousAt a u ∧ u ∈ closure (Iio 0)) := by
  rcases (show u ≤ 0 from hu).lt_or_eq with h | rfl
  · exact Or.inl h
  · exact Or.inr ⟨ha, by rw [closure_Iio]; exact Set.mem_Iic.2 le_rfl⟩

/-- Points of `[0, ∞)` are in `(0, ∞)` or are the point of continuity `0`. -/
theorem mem_Ioi_or_of_mem_Ici {a : ℝ → ℂ} (ha : ContinuousAt a 0) {u : ℝ} (hu : u ∈ Ici 0) :
    u ∈ Ioi 0 ∨ (ContinuousAt a u ∧ u ∈ closure (Ioi 0)) := by
  rcases (show 0 ≤ u from hu).lt_or_eq with h | rfl
  · exact Or.inl h
  · exact Or.inr ⟨ha, by rw [closure_Ioi]; exact Set.mem_Ici.2 le_rfl⟩

/-- **Splitting `ℝ` at `0`** for the variation (`r ≥ 1`, `a` continuous at `0`):
`V^r_ℝ a ≤ V^r_{(-∞,0)} a + V^r_{(0,∞)} a`. -/
theorem variationNorm_univ_le {r : ℝ} (hr : 1 ≤ r) {a : ℝ → ℂ} (ha : ContinuousAt a 0) :
    variationNorm r univ a ≤ variationNorm r (Iio 0) a + variationNorm r (Ioi 0) a := by
  have h := variationNorm_le_add_of_mem hr (mem_univ (0 : ℝ)) a
  rw [univ_inter, univ_inter] at h
  rwa [variationNorm_eq_of_subset_closure Iio_subset_Iic_self
      (fun u hu => mem_Iio_or_of_mem_Iic ha hu),
    variationNorm_eq_of_subset_closure Ioi_subset_Ici_self
      (fun u hu => mem_Ioi_or_of_mem_Ici ha hu)] at h

/-- **Splitting `ℝ` at `0`** for the jump function (`λ ≥ 0`, `a` continuous at `0`):
`N_λ{a_u : u ∈ ℝ} ≤ N_{λ/2}{a_u : u < 0} + N_{λ/2}{a_u : u > 0}`. -/
theorem jumpFunction_univ_le {lam : ℝ} (hlam : 0 ≤ lam) {a : ℝ → ℂ} (ha : ContinuousAt a 0) :
    jumpFunction lam univ a ≤
      jumpFunction (lam / 2) (Iio 0) a + jumpFunction (lam / 2) (Ioi 0) a := by
  have h := jumpFunction_le_add_of_mem hlam (mem_univ (0 : ℝ)) a
  rw [univ_inter, univ_inter] at h
  rwa [jumpFunction_eq_of_subset_closure Iio_subset_Iic_self
      (fun u hu => mem_Iio_or_of_mem_Iic ha hu),
    jumpFunction_eq_of_subset_closure Ioi_subset_Ici_self
      (fun u hu => mem_Ioi_or_of_mem_Ici ha hu)] at h

/-- Reflection `u ↦ -u` (inequality). -/
theorem variationNorm_comp_neg_le {r : ℝ} (hr : 0 < r) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    variationNorm r (Neg.neg ⁻¹' 𝒥) (fun u => a (-u)) ≤ variationNorm r 𝒥 a := by
  refine variationNorm_le fun J u hu hm => rpow_one_div_le_of_le_rpow hr ?_
  have := sum_le_variationNorm_rpow_of_pairs hr (a := a) (𝒥 := 𝒥)
    (Finset.univ : Finset (Fin J)ᵒᵈ) (s := fun i => -u (OrderDual.ofDual i).succ)
    (t := fun i => -u (OrderDual.ofDual i).castSucc)
    (fun i _ => neg_le_neg (hu.monotone Fin.castSucc_lt_succ.le))
    (fun i _ j _ hij => neg_le_neg (hu.monotone (Fin.succ_le_castSucc_iff.2 hij)))
    (fun i _ => hm _) (fun i _ => hm _)
  refine le_trans (le_of_eq ?_) this
  refine Fintype.sum_equiv OrderDual.toDual _ _ fun i => ?_
  simp only [OrderDual.ofDual_toDual]
  rw [enorm_sub_rev]

/-- **Reflection** `u ↦ -u`: `V^r{a_{-u} : -u ∈ 𝒥} = V^r{a_u : u ∈ 𝒥}` (`r > 0`). -/
theorem variationNorm_comp_neg {r : ℝ} (hr : 0 < r) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    variationNorm r (Neg.neg ⁻¹' 𝒥) (fun u => a (-u)) = variationNorm r 𝒥 a := by
  refine le_antisymm (variationNorm_comp_neg_le hr 𝒥 a) ?_
  have := variationNorm_comp_neg_le hr (Neg.neg ⁻¹' 𝒥) (fun u => a (-u))
  simpa [Set.preimage_preimage] using this

/-- **Reflection**: `V^r{a_u : u < 0} = V^r{a_{-u} : u > 0}` (`r > 0`). -/
theorem variationNorm_Iio_eq {r : ℝ} (hr : 0 < r) (a : ℝ → ℂ) :
    variationNorm r (Iio 0) a = variationNorm r (Ioi 0) (fun u => a (-u)) := by
  rw [← variationNorm_comp_neg hr (Iio 0) a]
  congr 1
  ext u; simp

/-- Reflection `u ↦ -u` for jumps (inequality). -/
theorem jumpFunction_comp_neg_le (lam : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    jumpFunction lam (Neg.neg ⁻¹' 𝒥) (fun u => a (-u)) ≤ jumpFunction lam 𝒥 a := by
  refine jumpFunction_le fun N s t h1 h2 h3 h4 => ?_
  have := card_le_jumpFunction (lam := lam) (𝒥 := 𝒥) (a := a)
    (Finset.univ : Finset (Fin N)ᵒᵈ) (s := fun i => -t (OrderDual.ofDual i))
    (t := fun i => -s (OrderDual.ofDual i)) (fun i _ => neg_lt_neg (h1 _))
    (fun i _ j _ hij => neg_lt_neg (h2 _ _ hij)) (fun i _ => (h3 _).2) (fun i _ => (h3 _).1)
    (fun i _ => by rw [norm_sub_rev]; exact h4 _)
  simpa using this

/-- **Reflection** `u ↦ -u` for jumps: `N_λ{a_{-u} : -u ∈ 𝒥} = N_λ{a_u : u ∈ 𝒥}`. -/
theorem jumpFunction_comp_neg (lam : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    jumpFunction lam (Neg.neg ⁻¹' 𝒥) (fun u => a (-u)) = jumpFunction lam 𝒥 a := by
  refine le_antisymm (jumpFunction_comp_neg_le lam 𝒥 a) ?_
  have := jumpFunction_comp_neg_le lam (Neg.neg ⁻¹' 𝒥) (fun u => a (-u))
  simpa [Set.preimage_preimage] using this

/-- **Reflection** for jumps: `N_λ{a_u : u < 0} = N_λ{a_{-u} : u > 0}`. -/
theorem jumpFunction_Iio_eq (lam : ℝ) (a : ℝ → ℂ) :
    jumpFunction lam (Iio 0) a = jumpFunction lam (Ioi 0) (fun u => a (-u)) := by
  rw [← jumpFunction_comp_neg lam (Iio 0) a]
  congr 1
  ext u; simp

/-- **Conjugation invariance** of the variation norm: `V^r(conj a) = V^r(a)`. -/
theorem variationNorm_conj (r : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    variationNorm r 𝒥 (fun u => (starRingEnd ℂ) (a u)) = variationNorm r 𝒥 a := by
  simp only [variationNorm, ← map_sub, RCLike.enorm_conj]

/-- **Conjugation invariance** of the jump function: `N_λ(conj a) = N_λ(a)`. -/
theorem jumpFunction_conj (lam : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    jumpFunction lam 𝒥 (fun u => (starRingEnd ℂ) (a u)) = jumpFunction lam 𝒥 a := by
  simp only [jumpFunction, ← map_sub, RCLike.norm_conj]

end Splitting

/-! ## Properties of `u ↦ 𝓗^{(u)} f(x)`: symmetry, continuity, measurability

For a Schwartz function `f` we show `𝓗^{(-u)} f = conj 𝓗^{(u)} (conj f)` (Section 1), that
`u ↦ 𝓗^{(u)} f(x)` is continuous, and that `x ↦ 𝓗^{(u)} f(x)` is measurable. As a consequence,
the variation norms, jump functions and short variations of `(𝓗^{(u)} f(x))_u` are measurable
in `x` (needed to make sense of the `L^p` norms in Theorem 1.1); the proof reduces suprema over
intervals to suprema over countable dense subsets, using continuity in `u`. -/

section OperatorProperties

open scoped SchwartzMap

/-- The complex conjugate `x ↦ conj (f x)` of a Schwartz function. -/
noncomputable def conjSchwartz {n : ℕ} (f : 𝓢(Rn n, ℂ)) : 𝓢(Rn n, ℂ) :=
  SchwartzMap.postcompCLM (𝕜 := ℝ) (Complex.conjCLE : ℂ →L[ℝ] ℂ) f

/-- `conjSchwartz f = conj ∘ f`. -/
theorem coe_conjSchwartz {n : ℕ} (f : 𝓢(Rn n, ℂ)) :
    (conjSchwartz f : Rn n → ℂ) = fun y => (starRingEnd ℂ) (f y) := rfl

/-- Conjugating the truncated integrals: `∫_{|t|>ε}` of `conj f` with modulation `u` is the
conjugate of the one of `f` with modulation `-u` (`Ω` is real). -/
theorem truncatedModulatedSI_conj (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u ε : ℝ) (f : Rn n → ℂ)
    (x : Rn n) :
    truncatedModulatedSI n α Ω u ε (fun y => (starRingEnd ℂ) (f y)) x =
      (starRingEnd ℂ) (truncatedModulatedSI n α Ω (-u) ε f x) := by
  unfold truncatedModulatedSI
  rw [← integral_conj]
  congr 1; funext t
  simp only [map_mul, map_neg, Complex.conj_ofReal, ← Complex.exp_conj, Complex.conj_I,
    Complex.ofReal_neg]
  ring_nf

/-- **Symmetry** `𝓗^{(-u)} f(x) = conj 𝓗^{(u)} (conj f)(x)` for Schwartz `f` (Section 1 of the
paper, used to reduce `u ∈ ℝ` to `u > 0`). -/
theorem IsHomogeneousCZKernel.modulatedSI_neg {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    modulatedSI n α Ω (-u) f x =
      (starRingEnd ℂ) (modulatedSI n α Ω u (fun y => (starRingEnd ℂ) (f y)) x) := by
  have h1 := hΩ.tendsto_truncatedModulatedSI hn hα (-u) f x
  have h2 : Tendsto (fun ε => truncatedModulatedSI n α Ω u ε (fun y => (starRingEnd ℂ) (f y)) x)
      (𝓝[>] 0) (𝓝 ((starRingEnd ℂ) (modulatedSI n α Ω (-u) f x))) :=
    ((Complex.continuous_conj.tendsto _).comp h1).congr fun ε =>
      (truncatedModulatedSI_conj n α Ω u ε f x).symm
  have h3 : modulatedSI n α Ω u (fun y => (starRingEnd ℂ) (f y)) x =
      (starRingEnd ℂ) (modulatedSI n α Ω (-u) f x) := h2.limUnder_eq
  rw [h3, Complex.conj_conj]

/-- **Symmetry** with the conjugate as a Schwartz function:
`𝓗^{(-u)} f(x) = conj 𝓗^{(u)} (conj f)(x)`. -/
theorem IsHomogeneousCZKernel.modulatedSI_neg' {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    modulatedSI n α Ω (-u) f x = (starRingEnd ℂ) (modulatedSI n α Ω u (conjSchwartz f) x) := by
  rw [coe_conjSchwartz]; exact hΩ.modulatedSI_neg hn hα u f x

/-- A bound for the renormalized integrand, uniform for `|u| ≤ U`: it is dominated by the
integrable function `𝟙_{|t| ≤ 1} C (L|t|^{1-n} + |f(x)| U |t|^{α-n}) + C |f(x - t)|`. -/
theorem IsHomogeneousCZKernel.exists_integrable_bound_pvIntegrand {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (x : Rn n) {U : ℝ} (hU : 0 ≤ U) :
    ∃ g : Rn n → ℝ, Integrable g ∧
      ∀ u, |u| ≤ U → ∀ t, ‖pvIntegrand n α Ω u f x t‖ ≤ g t := by
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound
  obtain ⟨L, hL0, hL⟩ := exists_norm_sub_le_schwartz f
  set g : Rn n → ℝ := fun t => (Metric.closedBall (0 : Rn n) 1).indicator
    (fun t => C * (L * ‖t‖ ^ ((1 : ℝ) - n) + ‖f x‖ * U * ‖t‖ ^ (α - n))) t +
      C * ‖f (x - t)‖ with hg_def
  have hg : Integrable g := by
    refine Integrable.add ?_ ?_
    · refine IntegrableOn.integrable_indicator ?_ measurableSet_closedBall
      exact (((integrableOn_closedBall_norm_rpow hn one_pos).const_mul L).add
        ((integrableOn_closedBall_norm_rpow hn hα).const_mul _)).const_mul C
    · exact ((f.integrable.comp_sub_left x).norm).const_mul C
  have hK : ∀ t, ‖(czKernel n Ω t : ℂ)‖ ≤ C / ‖t‖ ^ n := fun t => by
    rw [Complex.norm_real, Real.norm_eq_abs, czKernel, abs_div,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ n)]
    exact div_le_div_of_nonneg_right (hC t) (by positivity)
  refine ⟨g, hg, fun u hu t => ?_⟩
  have hg1 : 0 ≤ (Metric.closedBall (0 : Rn n) 1).indicator
      (fun t => C * (L * ‖t‖ ^ ((1 : ℝ) - n) + ‖f x‖ * U * ‖t‖ ^ (α - n))) t :=
    indicator_nonneg (fun _ _ => by positivity) _
  rcases eq_or_ne t 0 with rfl | ht
  · rw [pvIntegrand_zero hn, norm_zero]
    exact add_nonneg hg1 (by positivity)
  have hpos : 0 < ‖t‖ := norm_pos_iff.2 ht
  have he := norm_exp_I_mul_mul u (‖t‖ ^ α)
  by_cases h1 : ‖t‖ ≤ 1
  · have hmem : t ∈ Metric.closedBall (0 : Rn n) 1 := by simpa using h1
    rw [hg_def]
    simp only [pvIntegrand, indicator_of_mem hmem]
    have hA : ‖f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) - f x‖ ≤
        L * ‖t‖ + ‖f x‖ * (U * ‖t‖ ^ α) := by
      rw [show f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) - f x =
        (f (x - t) - f x) * exp (I * u * (‖t‖ ^ α : ℝ)) +
          f x * (exp (I * u * (‖t‖ ^ α : ℝ)) - 1) by ring]
      refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
      · rw [norm_mul, he, mul_one]
        simpa using hL (x - t) x
      · rw [norm_mul]
        refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
        have := norm_exp_I_mul_mul_sub_one_le u (‖t‖ ^ α)
        rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ α)] at this
        exact this.trans (mul_le_mul_of_nonneg_right hu (by positivity))
    calc ‖(f (x - t) * exp (I * u * (‖t‖ ^ α : ℝ)) - f x) * (czKernel n Ω t : ℂ)‖
        ≤ (L * ‖t‖ + ‖f x‖ * (U * ‖t‖ ^ α)) * (C / ‖t‖ ^ n) := by
          rw [norm_mul]; exact mul_le_mul hA (hK t) (norm_nonneg _) (by positivity)
      _ = C * (L * ‖t‖ ^ ((1 : ℝ) - n) + ‖f x‖ * U * ‖t‖ ^ (α - n)) := by
          rw [Real.rpow_sub hpos, Real.rpow_sub hpos, Real.rpow_one, Real.rpow_natCast]
          field_simp
      _ ≤ _ := le_add_of_nonneg_right (by positivity)
  · have hmem : t ∉ Metric.closedBall (0 : Rn n) 1 := by simpa using h1
    rw [hg_def]
    simp only [pvIntegrand, indicator_of_notMem hmem, sub_zero, zero_add]
    have hK1 : C / ‖t‖ ^ n ≤ C :=
      div_le_self hC0 (one_le_pow₀ (le_of_lt (not_le.1 h1)))
    rw [norm_mul, norm_mul, he, mul_one, mul_comm C]
    exact mul_le_mul_of_nonneg_left ((hK t).trans hK1) (norm_nonneg _)

/-- **Continuity in `u`**: for a Schwartz function `f` and fixed `x`, `u ↦ 𝓗^{(u)} f(x)` is
continuous (dominated convergence for the renormalized integral). -/
theorem IsHomogeneousCZKernel.continuous_modulatedSI {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (x : Rn n) : Continuous fun u => modulatedSI n α Ω u f x := by
  have heq : (fun u => modulatedSI n α Ω u f x) = fun u => ∫ t, pvIntegrand n α Ω u f x t :=
    funext fun u => hΩ.modulatedSI_eq_integral hn hα u f x
  rw [heq, continuous_iff_continuousAt]
  intro u₀
  obtain ⟨g, hg, hbound⟩ :=
    hΩ.exists_integrable_bound_pvIntegrand hn hα f x (U := |u₀| + 1) (by positivity)
  refine continuousAt_of_dominated (bound := g) (Eventually.of_forall fun u =>
    (hΩ.measurable_pvIntegrand α u f.continuous x).aestronglyMeasurable) ?_ hg
    (ae_of_all _ fun t => ?_)
  · filter_upwards [Metric.ball_mem_nhds u₀ one_pos] with u hu
    refine ae_of_all _ fun t => hbound u ?_ t
    have := abs_sub_abs_le_abs_sub u u₀
    rw [Metric.mem_ball, Real.dist_eq] at hu
    linarith
  · unfold pvIntegrand
    fun_prop

/-- **Measurability in `x`**: for a Schwartz function `f`, `x ↦ 𝓗^{(u)} f(x)` is measurable. -/
theorem IsHomogeneousCZKernel.measurable_modulatedSI {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ)
    (f : 𝓢(Rn n, ℂ)) : Measurable fun x => modulatedSI n α Ω u f x := by
  have heq : (fun x => modulatedSI n α Ω u f x) = fun x => ∫ t, pvIntegrand n α Ω u f x t :=
    funext fun x => hΩ.modulatedSI_eq_integral hn hα u f x
  rw [heq]
  have h1 : Measurable fun p : Rn n × Rn n =>
      f (p.1 - p.2) * exp (I * u * (‖p.2‖ ^ α : ℝ)) :=
    (f.continuous.measurable.comp (measurable_fst.sub measurable_snd)).mul
      (Complex.measurable_exp.comp (measurable_const.mul (Complex.measurable_ofReal.comp
        ((measurable_norm.comp measurable_snd).pow_const α))))
  have h2 : Measurable fun p : Rn n × Rn n =>
      (Metric.closedBall (0 : Rn n) 1).indicator (fun _ => f p.1) p.2 := by
    have : (fun p : Rn n × Rn n =>
        (Metric.closedBall (0 : Rn n) 1).indicator (fun _ => f p.1) p.2) =
        (Prod.snd ⁻¹' Metric.closedBall (0 : Rn n) 1).indicator (fun p => f p.1) := by
      funext p
      by_cases hp : p.2 ∈ Metric.closedBall (0 : Rn n) 1
      · rw [indicator_of_mem hp, indicator_of_mem
          (show p ∈ Prod.snd ⁻¹' Metric.closedBall (0 : Rn n) 1 from hp)]
      · rw [indicator_of_notMem hp, indicator_of_notMem
          (show p ∉ Prod.snd ⁻¹' Metric.closedBall (0 : Rn n) 1 from hp)]
    rw [this]
    exact (f.continuous.measurable.comp measurable_fst).indicator
      (measurable_snd measurableSet_closedBall)
  have h3 : Measurable fun p : Rn n × Rn n => (czKernel n Ω p.2 : ℂ) :=
    Complex.measurable_ofReal.comp (hΩ.measurable_czKernel.comp measurable_snd)
  have hF : Measurable fun p : Rn n × Rn n => pvIntegrand n α Ω u f p.1 p.2 := (h1.sub h2).mul h3
  exact (hF.stronglyMeasurable.integral_prod_right').measurable

/-- **Joint measurability**: `(u, x) ↦ 𝓗^{(u)} f(x)` is measurable on `ℝ × ℝⁿ`. -/
theorem IsHomogeneousCZKernel.measurable_modulatedSI_uncurry {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) :
    Measurable fun p : ℝ × Rn n => modulatedSI n α Ω p.1 f p.2 := by
  have hc : ∀ x : Rn n, Continuous fun u => modulatedSI n α Ω u f x :=
    fun x => hΩ.continuous_modulatedSI hn hα f x
  have hm : ∀ u : ℝ, Measurable fun x => modulatedSI n α Ω u f x :=
    fun u => hΩ.measurable_modulatedSI hn hα u f
  exact measurable_uncurry_of_continuous_of_measurable hc hm

/-- The variation norm over `𝒦` as a supremum over chains with values in the subtype `𝒦`. -/
theorem variationNorm_eq_iSup_subtype (r : ℝ) (𝒦 : Set ℝ) (a : ℝ → ℂ) :
    variationNorm r 𝒦 a = ⨆ (J : ℕ) (w : Fin (J + 1) → 𝒦) (_ : StrictMono fun i => (w i : ℝ)),
      (∑ i : Fin J, ‖a (w i.succ) - a (w i.castSucc)‖ₑ ^ r) ^ (1 / r) := by
  refine le_antisymm (variationNorm_le fun J u hu hm => ?_)
    (iSup_le fun J => iSup_le fun w => iSup_le fun hw =>
      le_variationNorm (u := fun i => (w i : ℝ)) hw fun i => (w i).2)
  exact le_iSup_of_le J (le_iSup_of_le (fun i => ⟨u i, hm i⟩) (le_iSup_of_le hu le_rfl))

/-- The jump function over `𝒦` as a supremum over families with values in the subtype `𝒦`. -/
theorem jumpFunction_eq_iSup_subtype (lam : ℝ) (𝒦 : Set ℝ) (a : ℝ → ℂ) :
    jumpFunction lam 𝒦 a = ⨆ (N : ℕ) (s : Fin N → 𝒦) (t : Fin N → 𝒦)
      (_ : (∀ i, (s i : ℝ) < t i) ∧ ∀ i j, i < j → (t i : ℝ) < s j)
      (_ : ∀ i, lam < ‖a (t i) - a (s i)‖), (N : ℝ≥0∞) := by
  refine le_antisymm (jumpFunction_le fun N s t h1 h2 h3 h4 => ?_)
    (iSup_le fun N => iSup_le fun s => iSup_le fun t => iSup_le fun h => iSup_le fun h4 =>
      natCast_le_jumpFunction h.1 h.2 (fun i => ⟨(s i).2, (t i).2⟩) h4)
  exact le_iSup_of_le N (le_iSup_of_le (fun i => ⟨s i, (h3 i).1⟩)
    (le_iSup_of_le (fun i => ⟨t i, (h3 i).2⟩) (le_iSup_of_le ⟨h1, h2⟩ (le_iSup_of_le h4 le_rfl))))

variable {X : Type*} [MeasurableSpace X]

/-- Measurability of `x ↦ V^r_𝒦(A x)` for a countable index set `𝒦`, if each `x ↦ A x u` is
measurable. -/
theorem measurable_variationNorm_of_countable {A : X → ℝ → ℂ}
    (hA : ∀ u, Measurable fun x => A x u) (r : ℝ) {𝒦 : Set ℝ} (h𝒦 : 𝒦.Countable) :
    Measurable fun x => variationNorm r 𝒦 (A x) := by
  have := h𝒦.to_subtype
  simp_rw [variationNorm_eq_iSup_subtype]
  refine Measurable.iSup fun J => Measurable.iSup fun w => Measurable.iSup_Prop _ ?_
  refine (Finset.measurable_sum _ fun i _ => ?_).pow_const _
  exact (((hA _).sub (hA _)).enorm).pow_const _

/-- Measurability of `x ↦ N_λ(𝒦)(A x)` for a countable index set `𝒦`, if each `x ↦ A x u` is
measurable. -/
theorem measurable_jumpFunction_of_countable {A : X → ℝ → ℂ}
    (hA : ∀ u, Measurable fun x => A x u) (lam : ℝ) {𝒦 : Set ℝ} (h𝒦 : 𝒦.Countable) :
    Measurable fun x => jumpFunction lam 𝒦 (A x) := by
  classical
  have := h𝒦.to_subtype
  simp_rw [jumpFunction_eq_iSup_subtype]
  refine Measurable.iSup fun N => Measurable.iSup fun s => Measurable.iSup fun t =>
    Measurable.iSup_Prop _ ?_
  simp_rw [iSup_eq_if]
  refine Measurable.ite ?_ measurable_const measurable_const
  simp only [Set.ofPred_forall]
  exact MeasurableSet.iInter fun i => measurableSet_lt measurable_const ((hA _).sub (hA _)).norm

/-- **Measurability of variation norms** of continuous families: if each `A x` is continuous,
each `x ↦ A x u` is measurable, and `𝒦 ⊆ 𝒥 ⊆ closure 𝒦` with `𝒦` countable, then
`x ↦ V^r_𝒥(A x)` is measurable. -/
theorem measurable_variationNorm {A : X → ℝ → ℂ} (hA : ∀ u, Measurable fun x => A x u)
    (hc : ∀ x, Continuous (A x)) (r : ℝ) {𝒥 𝒦 : Set ℝ} (h𝒦 : 𝒦.Countable) (h𝒦𝒥 : 𝒦 ⊆ 𝒥)
    (h𝒥 : 𝒥 ⊆ closure 𝒦) : Measurable fun x => variationNorm r 𝒥 (A x) := by
  have : (fun x => variationNorm r 𝒥 (A x)) = fun x => variationNorm r 𝒦 (A x) :=
    funext fun x => variationNorm_eq_of_subset_closure h𝒦𝒥 fun u hu =>
      Or.inr ⟨(hc x).continuousAt, h𝒥 hu⟩
  rw [this]
  exact measurable_variationNorm_of_countable hA r h𝒦

/-- **Measurability of jump functions** of continuous families (as in
`measurable_variationNorm`). -/
theorem measurable_jumpFunction {A : X → ℝ → ℂ} (hA : ∀ u, Measurable fun x => A x u)
    (hc : ∀ x, Continuous (A x)) (lam : ℝ) {𝒥 𝒦 : Set ℝ} (h𝒦 : 𝒦.Countable) (h𝒦𝒥 : 𝒦 ⊆ 𝒥)
    (h𝒥 : 𝒥 ⊆ closure 𝒦) : Measurable fun x => jumpFunction lam 𝒥 (A x) := by
  have : (fun x => jumpFunction lam 𝒥 (A x)) = fun x => jumpFunction lam 𝒦 (A x) :=
    funext fun x => jumpFunction_eq_of_subset_closure h𝒦𝒥 fun u hu =>
      Or.inr ⟨(hc x).continuousAt, h𝒥 hu⟩
  rw [this]
  exact measurable_jumpFunction_of_countable hA lam h𝒦

/-- An open set is contained in the closure of its rational points. -/
theorem subset_closure_inter_ratCast_of_isOpen {𝒥 : Set ℝ} (h : IsOpen 𝒥) :
    𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ)) :=
  Dense.open_subset_closure_inter Rat.denseRange_cast h

/-- A nondegenerate closed interval is contained in the closure of its rational points. -/
theorem Icc_subset_closure_inter_ratCast {x y : ℝ} (hxy : x < y) :
    Icc x y ⊆ closure (Icc x y ∩ range ((↑) : ℚ → ℝ)) := by
  calc Icc x y = closure (Ioo x y) := (closure_Ioo hxy.ne).symm
    _ ⊆ closure (closure (Ioo x y ∩ range ((↑) : ℚ → ℝ))) :=
        closure_mono (subset_closure_inter_ratCast_of_isOpen isOpen_Ioo)
    _ = closure (Ioo x y ∩ range ((↑) : ℚ → ℝ)) := closure_closure
    _ ⊆ closure (Icc x y ∩ range ((↑) : ℚ → ℝ)) :=
        closure_mono (inter_subset_inter_left _ Ioo_subset_Icc_self)

/-- Measurability of `x ↦ V^r_𝒥(A x)` for continuous families when `𝒥` is contained in the
closure of its rational points (e.g. `𝒥` open, or a nondegenerate closed interval). -/
theorem measurable_variationNorm_of_ratCast {A : X → ℝ → ℂ}
    (hA : ∀ u, Measurable fun x => A x u) (hc : ∀ x, Continuous (A x)) (r : ℝ) {𝒥 : Set ℝ}
    (h𝒥 : 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) :
    Measurable fun x => variationNorm r 𝒥 (A x) :=
  measurable_variationNorm hA hc r ((countable_range _).mono inter_subset_right)
    inter_subset_left h𝒥

/-- Measurability of `x ↦ N_λ(𝒥)(A x)` for continuous families when `𝒥` is contained in the
closure of its rational points. -/
theorem measurable_jumpFunction_of_ratCast {A : X → ℝ → ℂ}
    (hA : ∀ u, Measurable fun x => A x u) (hc : ∀ x, Continuous (A x)) (lam : ℝ) {𝒥 : Set ℝ}
    (h𝒥 : 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) :
    Measurable fun x => jumpFunction lam 𝒥 (A x) :=
  measurable_jumpFunction hA hc lam ((countable_range _).mono inter_subset_right)
    inter_subset_left h𝒥

/-- The short intervals `J_j` are nondegenerate for `α > 0`. -/
theorem shortInterval_subset_closure {α : ℝ} (hα : 0 < α) (j : ℤ) :
    shortInterval α j ⊆ closure (shortInterval α j ∩ range ((↑) : ℚ → ℝ)) :=
  Icc_subset_closure_inter_ratCast (dyadicPoint_strictMono hα (lt_add_one j))

/-- Measurability of the short variation `x ↦ S_r(A x)` for continuous families (`α > 0`). -/
theorem measurable_shortVariation {A : X → ℝ → ℂ} (hA : ∀ u, Measurable fun x => A x u)
    (hc : ∀ x, Continuous (A x)) (r : ℝ) {α : ℝ} (hα : 0 < α) :
    Measurable fun x => shortVariation r α (A x) := by
  unfold shortVariation
  refine (Measurable.tsum fun j => ?_).pow_const _
  exact (measurable_variationNorm_of_ratCast hA hc r
    (shortInterval_subset_closure hα j)).pow_const r

end OperatorProperties

/-! ## Measurability of the variational functionals of `𝓗^{(u)} f`

Ledger row "§1, Thm 1.1: measurability": for Schwartz `f` all the functionals of
`(𝓗^{(u)} f(x))_u` appearing in Section 1 are measurable in `x`. -/

section MeasurabilityOfFunctionals

open scoped SchwartzMap

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- Measurability of `x ↦ V^r{𝓗^{(u)} f(x) : u ∈ 𝒥}` for `𝒥` contained in the closure of its
rational points (e.g. `𝒥 = ℝ`, `(0, ∞)`, `(-∞, 0)`, or `J_j`). -/
theorem IsHomogeneousCZKernel.measurable_variationNorm_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (r : ℝ) {𝒥 : Set ℝ} (h𝒥 : 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) :
    Measurable fun x => variationNorm r 𝒥 (fun u => modulatedSI n α Ω u f x) :=
  measurable_variationNorm_of_ratCast (A := fun x u => modulatedSI n α Ω u f x)
    (fun u => hΩ.measurable_modulatedSI hn hα u f) (fun x => hΩ.continuous_modulatedSI hn hα f x)
    r h𝒥

/-- Measurability of `x ↦ V^r{𝓗^{(u)} f(x) : u ∈ ℝ}` (Theorem 1.1, first part). -/
theorem IsHomogeneousCZKernel.measurable_variationNorm_univ_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (r : ℝ) : Measurable fun x => variationNorm r univ (fun u => modulatedSI n α Ω u f x) :=
  hΩ.measurable_variationNorm_modulatedSI hn hα f r
    (subset_closure_inter_ratCast_of_isOpen isOpen_univ)

/-- Measurability of the long variation `x ↦ V^r{𝓗^{(2^{jα})} f(x) : j ∈ ℤ}`. -/
theorem IsHomogeneousCZKernel.measurable_variationNorm_dyadicSet_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (r : ℝ) :
    Measurable fun x => variationNorm r (dyadicSet α) (fun u => modulatedSI n α Ω u f x) :=
  measurable_variationNorm_of_countable (A := fun x u => modulatedSI n α Ω u f x)
    (fun u => hΩ.measurable_modulatedSI hn hα u f) r (countable_range _)

/-- Measurability of `x ↦ N_λ{𝓗^{(u)} f(x) : u ∈ 𝒥}` for `𝒥` contained in the closure of its
rational points. -/
theorem IsHomogeneousCZKernel.measurable_jumpFunction_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (lam : ℝ) {𝒥 : Set ℝ} (h𝒥 : 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) :
    Measurable fun x => jumpFunction lam 𝒥 (fun u => modulatedSI n α Ω u f x) :=
  measurable_jumpFunction_of_ratCast (A := fun x u => modulatedSI n α Ω u f x)
    (fun u => hΩ.measurable_modulatedSI hn hα u f) (fun x => hΩ.continuous_modulatedSI hn hα f x)
    lam h𝒥

/-- Measurability of `x ↦ N^{dyad}_λ(𝓗f)(x)`. -/
theorem IsHomogeneousCZKernel.measurable_jumpFunction_dyadicSet_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (lam : ℝ) :
    Measurable fun x => jumpFunction lam (dyadicSet α) (fun u => modulatedSI n α Ω u f x) :=
  measurable_jumpFunction_of_countable (A := fun x u => modulatedSI n α Ω u f x)
    (fun u => hΩ.measurable_modulatedSI hn hα u f) lam (countable_range _)

/-- Measurability of `x ↦ λ √(N_λ{𝓗^{(u)} f(x) : u ∈ ℝ})` (Theorem 1.1, second part). -/
theorem IsHomogeneousCZKernel.measurable_sqrt_jumpFunction_univ_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (lam : ℝ) :
    Measurable fun x => ENNReal.ofReal lam *
      jumpFunction lam univ (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ) :=
  ((hΩ.measurable_jumpFunction_modulatedSI hn hα f lam
    (subset_closure_inter_ratCast_of_isOpen isOpen_univ)).pow_const _).const_mul _

/-- Measurability of the short variation `x ↦ S_r(𝓗f)(x)`. -/
theorem IsHomogeneousCZKernel.measurable_shortVariation_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (r : ℝ) : Measurable fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x) :=
  measurable_shortVariation (A := fun x u => modulatedSI n α Ω u f x)
    (fun u => hΩ.measurable_modulatedSI hn hα u f) (fun x => hΩ.continuous_modulatedSI hn hα f x)
    r hα

/-- **Reduction to `u > 0`** (Section 1): `V^r{𝓗^{(u)} f(x) : u < 0} = V^r{𝓗^{(u)} (conj f)(x) :
u > 0}` (`r > 0`). -/
theorem IsHomogeneousCZKernel.variationNorm_Iio_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    {r : ℝ} (hr : 0 < r) (x : Rn n) :
    variationNorm r (Iio 0) (fun u => modulatedSI n α Ω u f x) =
      variationNorm r (Ioi 0) (fun u => modulatedSI n α Ω u (conjSchwartz f) x) := by
  rw [variationNorm_Iio_eq hr, ← variationNorm_conj r (Ioi 0)]
  congr 1
  funext u
  rw [hΩ.modulatedSI_neg' hn hα u f x, Complex.conj_conj]

/-- **Reduction to `u > 0`** for jumps (Section 1):
`N_λ{𝓗^{(u)} f(x) : u < 0} = N_λ{𝓗^{(u)} (conj f)(x) : u > 0}`. -/
theorem IsHomogeneousCZKernel.jumpFunction_Iio_modulatedSI
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (lam : ℝ) (x : Rn n) :
    jumpFunction lam (Iio 0) (fun u => modulatedSI n α Ω u f x) =
      jumpFunction lam (Ioi 0) (fun u => modulatedSI n α Ω u (conjSchwartz f) x) := by
  rw [jumpFunction_Iio_eq, ← jumpFunction_conj lam (Ioi 0)]
  congr 1
  funext u
  rw [hΩ.modulatedSI_neg' hn hα u f x, Complex.conj_conj]

/-- **Splitting `u ∈ ℝ` into `u < 0` and `u > 0`** for the variation of `𝓗^{(u)} f(x)`
(`r ≥ 1`): `V^r_ℝ ≤ V^r_{u>0}(𝓗 f) + V^r_{u>0}(𝓗 (conj f))`. -/
theorem IsHomogeneousCZKernel.variationNorm_univ_modulatedSI_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    {r : ℝ} (hr : 1 ≤ r) (x : Rn n) :
    variationNorm r univ (fun u => modulatedSI n α Ω u f x) ≤
      variationNorm r (Ioi 0) (fun u => modulatedSI n α Ω u (conjSchwartz f) x) +
        variationNorm r (Ioi 0) (fun u => modulatedSI n α Ω u f x) := by
  rw [← hΩ.variationNorm_Iio_modulatedSI hn hα f (by linarith) x]
  exact variationNorm_univ_le hr (hΩ.continuous_modulatedSI hn hα f x).continuousAt

/-- **Splitting `u ∈ ℝ` into `u < 0` and `u > 0`** for the jumps of `𝓗^{(u)} f(x)` (`λ ≥ 0`):
`N_λ(ℝ) ≤ N_{λ/2}{𝓗^{(u)} (conj f)(x) : u > 0} + N_{λ/2}{𝓗^{(u)} f(x) : u > 0}`. -/
theorem IsHomogeneousCZKernel.jumpFunction_univ_modulatedSI_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    {lam : ℝ} (hlam : 0 ≤ lam) (x : Rn n) :
    jumpFunction lam univ (fun u => modulatedSI n α Ω u f x) ≤
      jumpFunction (lam / 2) (Ioi 0) (fun u => modulatedSI n α Ω u (conjSchwartz f) x) +
        jumpFunction (lam / 2) (Ioi 0) (fun u => modulatedSI n α Ω u f x) := by
  rw [← hΩ.jumpFunction_Iio_modulatedSI hn hα f (lam / 2) x]
  exact jumpFunction_univ_le hlam (hΩ.continuous_modulatedSI hn hα f x).continuousAt

end MeasurabilityOfFunctionals

/-! ## Sobolev-type embeddings for the variation norm

Replacement for Proposition 2.2 (Plancherel–Pólya) and the estimate (`eq:Lplqlq`) of the paper
(proof route, item 1): for `F` with `|F(t) - F(s)| ≤ ∫_s^t |F'|` on `[a, b]` and `q ≥ 1`,
`(V^q_{[a,b]} F)^q ≤ 2 · 4^q ‖F‖_{L^q}^{q-1} ‖F'‖_{L^q}` and
`sup_{[a,b]} |F|^q ≤ 2^q ((b - a)⁻¹ ‖F‖_{L^q}^q + ‖F‖_{L^q}^{q-1} ‖F'‖_{L^q})`. The proof
optimizes over a free length scale `δ`: gaps of length `≤ δ` are estimated by the fundamental
theorem of calculus and Hölder, longer gaps by averaging over windows of length `δ`. -/

section SobolevEmbedding

/-- Jensen's (or Hölder's) inequality `(∫⁻ g)^q ≤ μ(X)^{q-1} ∫⁻ g^q` for `q ≥ 1`. -/
theorem lintegral_rpow_le_measure_univ_mul {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {g : X → ℝ≥0∞} (hg : AEMeasurable g μ) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ x, g x ∂μ) ^ q ≤ μ univ ^ (q - 1) * ∫⁻ x, g x ^ q ∂μ := by
  have hq0 : 0 < q := by linarith
  have h := ENNReal.lintegral_mul_norm_pow_le (hg.pow_const q)
    (aemeasurable_const (b := (1 : ℝ≥0∞))) (p := 1 / q) (q := 1 - 1 / q) (by positivity)
    (by rw [sub_nonneg]; exact (div_le_one hq0).2 hq) (by ring)
  simp only [rpow_rpow_one_div hq0.ne', ENNReal.one_rpow, mul_one, lintegral_const,
    one_mul] at h
  calc (∫⁻ x, g x ∂μ) ^ q ≤ ((∫⁻ x, g x ^ q ∂μ) ^ (1 / q) * μ univ ^ (1 - 1 / q)) ^ q :=
        ENNReal.rpow_le_rpow h hq0.le
    _ = μ univ ^ (q - 1) * ∫⁻ x, g x ^ q ∂μ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, rpow_one_div_rpow hq0.ne', ← ENNReal.rpow_mul,
          mul_comm]
        congr 2; field_simp

/-- Set-integral form of `lintegral_rpow_le_measure_univ_mul`:
`(∫⁻_s g)^q ≤ μ(s)^{q-1} ∫⁻_s g^q` for `q ≥ 1`. -/
theorem setLIntegral_rpow_le_measure_mul {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {s : Set X} {g : X → ℝ≥0∞} (hg : AEMeasurable g (μ.restrict s)) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ x in s, g x ∂μ) ^ q ≤ μ s ^ (q - 1) * ∫⁻ x in s, g x ^ q ∂μ := by
  have := lintegral_rpow_le_measure_univ_mul hg hq
  rwa [Measure.restrict_apply_univ] at this

/-- Consecutive intervals `(u_{i-1}, u_i]` of a chain in `[a, b]` are disjoint, so
`∑_i ∫⁻_{(u_{i-1}, u_i]} g ≤ ∫⁻_{[a, b]} g`. -/
theorem sum_setLIntegral_Ioc_le {J : ℕ} {u : Fin (J + 1) → ℝ} (hu : StrictMono u) {a b : ℝ}
    (hm : ∀ i, u i ∈ Icc a b) (g : ℝ → ℝ≥0∞) :
    ∑ i : Fin J, ∫⁻ x in Ioc (u i.castSucc) (u i.succ), g x ≤ ∫⁻ x in Icc a b, g x := by
  classical
  rw [← lintegral_biUnion_finset (s := Finset.univ) ?_ (fun _ _ => measurableSet_Ioc)]
  · refine lintegral_mono_set ?_
    intro x hx
    simp only [Finset.mem_univ, iUnion_true, mem_iUnion] at hx
    obtain ⟨i, hx1, hx2⟩ := hx
    exact ⟨(hm i.castSucc).1.trans hx1.le, hx2.trans (hm i.succ).2⟩
  · intro i _ j _ hij
    refine Set.disjoint_left.2 fun x hx hx' => ?_
    rcases lt_or_gt_of_ne hij with h | h
    · have := hu.monotone (Fin.succ_le_castSucc_iff.2 h)
      linarith [hx.2, hx'.1]
    · have := hu.monotone (Fin.succ_le_castSucc_iff.2 h)
      linarith [hx'.2, hx.1]

variable {F F' : ℝ → ℂ} {a b q : ℝ}

/-- Short-gap estimate: under the fundamental theorem of calculus bound
`|F(t) - F(s)| ≤ ∫_s^t |F'|`, `|F(t) - F(s)|^q ≤ (t - s)^{q-1} ∫_s^t |F'|^q` (`q ≥ 1`). -/
theorem enorm_sub_rpow_le_of_fTC (hq : 1 ≤ q)
    (hFTC : ∀ s t, a ≤ s → s ≤ t → t ≤ b → ‖F t - F s‖ₑ ≤ ∫⁻ u in Ioc s t, ‖F' u‖ₑ)
    (hF' : AEMeasurable F' (volume.restrict (Icc a b))) {s t : ℝ} (has : a ≤ s) (hst : s ≤ t)
    (htb : t ≤ b) :
    ‖F t - F s‖ₑ ^ q ≤ ENNReal.ofReal (t - s) ^ (q - 1) * ∫⁻ u in Ioc s t, ‖F' u‖ₑ ^ q := by
  have hm : AEMeasurable (fun u => ‖F' u‖ₑ) (volume.restrict (Ioc s t)) :=
    (hF'.mono_measure (Measure.restrict_mono (Ioc_subset_Icc_self.trans (Icc_subset_Icc has htb))
      le_rfl)).enorm
  calc ‖F t - F s‖ₑ ^ q ≤ (∫⁻ u in Ioc s t, ‖F' u‖ₑ) ^ q :=
        ENNReal.rpow_le_rpow (hFTC s t has hst htb) (by linarith)
    _ ≤ _ := by
        have := setLIntegral_rpow_le_measure_mul hm hq
        rwa [Real.volume_Ioc] at this
/-- Window estimate: if `[c, d] ⊆ [a, b]` and `w ∈ {c, d}`, then
`(d - c) |F(w)|^q ≤ 2^{q-1} (∫_c^d |F|^q + (d - c)^q ∫_c^d |F'|^q)` (`q ≥ 1`). -/
theorem mul_enorm_rpow_le_window (hq : 1 ≤ q)
    (hFTC : ∀ s t, a ≤ s → s ≤ t → t ≤ b → ‖F t - F s‖ₑ ≤ ∫⁻ u in Ioc s t, ‖F' u‖ₑ)
    (hF' : AEMeasurable F' (volume.restrict (Icc a b))) {c d : ℝ} (hcd : c < d) (hac : a ≤ c)
    (hdb : d ≤ b) {w : ℝ} (hw : w = c ∨ w = d) :
    ENNReal.ofReal (d - c) * ‖F w‖ₑ ^ q ≤ 2 ^ (q - 1) * ((∫⁻ u in Ioc c d, ‖F u‖ₑ ^ q) +
      ENNReal.ofReal (d - c) ^ q * ∫⁻ u in Ioc c d, ‖F' u‖ₑ ^ q) := by
  have hq0 : 0 < q := by linarith
  set G := ∫⁻ u in Ioc c d, ‖F' u‖ₑ with hG
  have hpt : ∀ v ∈ Ioc c d, ‖F w‖ₑ ≤ ‖F v‖ₑ + G := by
    intro v hv
    have h1 : ‖F w‖ₑ ≤ ‖F v‖ₑ + ‖F w - F v‖ₑ := by
      calc ‖F w‖ₑ = ‖F v + (F w - F v)‖ₑ := by rw [add_sub_cancel]
        _ ≤ _ := enorm_add_le _ _
    refine h1.trans (add_le_add le_rfl ?_)
    rcases hw with rfl | rfl
    · rw [← enorm_neg, neg_sub]
      exact (hFTC w v hac hv.1.le (hv.2.trans hdb)).trans (lintegral_mono_set
        (Ioc_subset_Ioc_right hv.2))
    · exact (hFTC v w (hac.trans hv.1.le) hv.2 hdb).trans (lintegral_mono_set
        (Ioc_subset_Ioc_left hv.1.le))
  have hm : AEMeasurable (fun u => ‖F' u‖ₑ) (volume.restrict (Ioc c d)) :=
    (hF'.mono_measure (Measure.restrict_mono (Ioc_subset_Icc_self.trans (Icc_subset_Icc hac hdb))
      le_rfl)).enorm
  have hJ := setLIntegral_rpow_le_measure_mul hm hq
  rw [Real.volume_Ioc] at hJ
  have h2 : (2 : ℝ≥0∞) ^ (q - 1) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)
  have hδ0 : ENNReal.ofReal (d - c) ≠ 0 := by simpa using hcd
  calc ENNReal.ofReal (d - c) * ‖F w‖ₑ ^ q = ∫⁻ _ in Ioc c d, ‖F w‖ₑ ^ q := by
        rw [setLIntegral_const, Real.volume_Ioc, mul_comm]
    _ ≤ ∫⁻ v in Ioc c d, 2 ^ (q - 1) * (‖F v‖ₑ ^ q + G ^ q) := by
        refine setLIntegral_mono' measurableSet_Ioc fun v hv => ?_
        exact (ENNReal.rpow_le_rpow (hpt v hv) hq0.le).trans
          (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
    _ = 2 ^ (q - 1) * ((∫⁻ u in Ioc c d, ‖F u‖ₑ ^ q) + G ^ q * ENNReal.ofReal (d - c)) := by
        rw [lintegral_const_mul' _ _ h2, lintegral_add_right _ measurable_const,
          setLIntegral_const, Real.volume_Ioc]
    _ ≤ _ := by
        refine mul_le_mul' le_rfl (add_le_add le_rfl ?_)
        calc G ^ q * ENNReal.ofReal (d - c)
            ≤ ENNReal.ofReal (d - c) ^ (q - 1) * (∫⁻ u in Ioc c d, ‖F' u‖ₑ ^ q) *
                ENNReal.ofReal (d - c) := by gcongr
          _ = _ := by
              rw [mul_comm, ← mul_assoc]
              congr 1
              conv_rhs => rw [show q = 1 + (q - 1) by ring]
              rw [ENNReal.rpow_add _ _ hδ0 ENNReal.ofReal_ne_top, ENNReal.rpow_one]
/-- `(2^{q-1})(2^{q-1} Z + 2^{q-1} Z) ≤ 4^q Z`. -/
theorem two_rpow_mul_add_le_four_rpow {q : ℝ} (hq : 1 ≤ q) (Z : ℝ≥0∞) :
    2 ^ (q - 1) * (2 ^ (q - 1) * Z + 2 ^ (q - 1) * Z) ≤ 4 ^ q * Z := by
  have h1 : (2 : ℝ≥0∞) ^ (q - 1) * 2 = 2 ^ q := by
    conv_rhs => rw [show q = (q - 1) + 1 by ring]
    rw [ENNReal.rpow_add _ _ (by simp) (by simp), ENNReal.rpow_one]
  have h4 : (4 : ℝ≥0∞) ^ q = 2 ^ q * 2 ^ q := by
    rw [← ENNReal.mul_rpow_of_nonneg _ _ (by linarith)]; norm_num
  calc 2 ^ (q - 1) * (2 ^ (q - 1) * Z + 2 ^ (q - 1) * Z) = 2 ^ (q - 1) * (2 ^ q * Z) := by
        rw [← two_mul, ← mul_assoc, h1]; ring
    _ ≤ 2 ^ q * (2 ^ q * Z) := by
        gcongr
        · norm_num
        · linarith
    _ = 4 ^ q * Z := by rw [h4, mul_assoc]

/-- **Gap estimate** (proof of the Sobolev-type embedding for `V^q`): for `a ≤ s ≤ t ≤ b` and
every `δ > 0`, `|F(t) - F(s)|^q ≤ 4^q (δ⁻¹ ∫_s^t |F|^q + δ^{q-1} ∫_s^t |F'|^q)`. Short gaps
(`t - s ≤ δ`) use `F(t) - F(s) = ∫_s^t F'` and Hölder; long gaps use windows of length `δ` at
both endpoints. -/
theorem enorm_sub_rpow_le_gap (hq : 1 ≤ q)
    (hFTC : ∀ s t, a ≤ s → s ≤ t → t ≤ b → ‖F t - F s‖ₑ ≤ ∫⁻ u in Ioc s t, ‖F' u‖ₑ)
    (hF' : AEMeasurable F' (volume.restrict (Icc a b))) {s t : ℝ} (has : a ≤ s) (hst : s ≤ t)
    (htb : t ≤ b) {δ : ℝ} (hδ : 0 < δ) :
    ‖F t - F s‖ₑ ^ q ≤ 4 ^ q * (ENNReal.ofReal δ⁻¹ * (∫⁻ u in Ioc s t, ‖F u‖ₑ ^ q) +
      ENNReal.ofReal (δ ^ (q - 1)) * ∫⁻ u in Ioc s t, ‖F' u‖ₑ ^ q) := by
  have hq0 : 0 < q := by linarith
  have h4 : 1 ≤ (4 : ℝ≥0∞) ^ q := ENNReal.one_le_rpow (by norm_num) hq0
  set X := ∫⁻ u in Ioc s t, ‖F u‖ₑ ^ q
  set Y := ∫⁻ u in Ioc s t, ‖F' u‖ₑ ^ q
  rcases le_or_gt (t - s) δ with hshort | hlong
  · calc ‖F t - F s‖ₑ ^ q ≤ ENNReal.ofReal (t - s) ^ (q - 1) * Y :=
          enorm_sub_rpow_le_of_fTC hq hFTC hF' has hst htb
      _ ≤ ENNReal.ofReal (δ ^ (q - 1)) * Y := by
          rw [← ENNReal.ofReal_rpow_of_pos hδ]
          gcongr
      _ ≤ 1 * (ENNReal.ofReal δ⁻¹ * X + ENNReal.ofReal (δ ^ (q - 1)) * Y) := by
          rw [one_mul]; exact le_add_self
      _ ≤ _ := by gcongr
  · set Z := X + ENNReal.ofReal δ ^ q * Y
    have hW1 : ENNReal.ofReal δ * ‖F s‖ₑ ^ q ≤ 2 ^ (q - 1) * Z := by
      have := mul_enorm_rpow_le_window (w := s) hq hFTC hF' (c := s) (d := s + δ) (by linarith)
        has (by linarith) (Or.inl rfl)
      rw [add_sub_cancel_left] at this
      refine this.trans (mul_le_mul' le_rfl (add_le_add (lintegral_mono_set ?_)
        (mul_le_mul' le_rfl (lintegral_mono_set ?_)))) <;>
      exact Ioc_subset_Ioc_right (by linarith)
    have hW2 : ENNReal.ofReal δ * ‖F t‖ₑ ^ q ≤ 2 ^ (q - 1) * Z := by
      have := mul_enorm_rpow_le_window (w := t) hq hFTC hF' (c := t - δ) (d := t) (by linarith)
        (by linarith) htb (Or.inr rfl)
      rw [sub_sub_cancel] at this
      refine this.trans (mul_le_mul' le_rfl (add_le_add (lintegral_mono_set ?_)
        (mul_le_mul' le_rfl (lintegral_mono_set ?_)))) <;>
      exact Ioc_subset_Ioc_left (by linarith)
    have hmain : ENNReal.ofReal δ * ‖F t - F s‖ₑ ^ q ≤ 4 ^ q * Z := by
      calc ENNReal.ofReal δ * ‖F t - F s‖ₑ ^ q
          ≤ ENNReal.ofReal δ * (2 ^ (q - 1) * (‖F t‖ₑ ^ q + ‖F s‖ₑ ^ q)) := by
            gcongr
            exact (ENNReal.rpow_le_rpow (enorm_sub_le) hq0.le).trans
              (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
        _ = 2 ^ (q - 1) * (ENNReal.ofReal δ * ‖F t‖ₑ ^ q + ENNReal.ofReal δ * ‖F s‖ₑ ^ q) := by
            ring
        _ ≤ 2 ^ (q - 1) * (2 ^ (q - 1) * Z + 2 ^ (q - 1) * Z) := by gcongr
        _ ≤ 4 ^ q * Z := two_rpow_mul_add_le_four_rpow hq Z
    have hδ0 : ENNReal.ofReal δ ≠ 0 := by simpa using hδ
    calc ‖F t - F s‖ₑ ^ q = ENNReal.ofReal δ⁻¹ * (ENNReal.ofReal δ * ‖F t - F s‖ₑ ^ q) := by
          rw [← mul_assoc, ENNReal.ofReal_inv_of_pos hδ,
            ENNReal.inv_mul_cancel hδ0 ENNReal.ofReal_ne_top, one_mul]
      _ ≤ ENNReal.ofReal δ⁻¹ * (4 ^ q * Z) := by gcongr
      _ = _ := by
          have : ENNReal.ofReal δ⁻¹ * ENNReal.ofReal δ ^ q = ENNReal.ofReal (δ ^ (q - 1)) := by
            rw [ENNReal.ofReal_rpow_of_pos hδ, ← ENNReal.ofReal_mul (by positivity),
              Real.rpow_sub_one hδ.ne', div_eq_mul_inv, mul_comm]
          rw [← this]; ring
/-- The real identities behind the choice `δ = (A/B)^{1/q}`:
`δ⁻¹ A = A^{(q-1)/q} B^{1/q}` and `δ^{q-1} B = A^{(q-1)/q} B^{1/q}`. -/
theorem rpow_optimal_delta {q A B : ℝ} (hq : 0 < q) (hA : 0 < A) (hB : 0 < B) :
    (A ^ (1 / q) / B ^ (1 / q))⁻¹ * A = A ^ ((q - 1) / q) * B ^ (1 / q) ∧
      (A ^ (1 / q) / B ^ (1 / q)) ^ (q - 1) * B = A ^ ((q - 1) / q) * B ^ (1 / q) := by
  have hqq : (q - 1) / q = 1 - 1 / q := by field_simp
  have hA1 : A ^ ((q - 1) / q) = A / A ^ (1 / q) := by rw [hqq, Real.rpow_sub hA, Real.rpow_one]
  have hB1 : B ^ ((q - 1) / q) = B / B ^ (1 / q) := by rw [hqq, Real.rpow_sub hB, Real.rpow_one]
  have hAq : 0 < A ^ (1 / q) := Real.rpow_pos_of_pos hA _
  have hBq : 0 < B ^ (1 / q) := Real.rpow_pos_of_pos hB _
  refine ⟨?_, ?_⟩
  · rw [hA1]; field_simp
  · rw [Real.div_rpow hAq.le hBq.le, ← Real.rpow_mul hA.le, ← Real.rpow_mul hB.le,
      show 1 / q * (q - 1) = (q - 1) / q by ring, hA1, hB1]
    field_simp

/-- **Optimizing the free parameter `δ`**: if `X ≤ K (δ⁻¹ A + δ^{q-1} B)` for every
`0 < δ ≤ D`, then `X ≤ K (D⁻¹ A + 2 A^{(q-1)/q} B^{1/q})` (`q ≥ 1`; `A, B, K < ∞`; the case
`B = 0` is supplied separately). -/
theorem le_of_forall_delta {q : ℝ} (hq : 1 ≤ q) {X A B K D : ℝ≥0∞} (hD : D ≠ 0) (hA : A ≠ ∞)
    (hB : B ≠ ∞) (hK : K ≠ ∞) (hB0 : B = 0 → X ≤ K * (D⁻¹ * A))
    (h : ∀ δ : ℝ, 0 < δ → ENNReal.ofReal δ ≤ D →
      X ≤ K * (ENNReal.ofReal δ⁻¹ * A + ENNReal.ofReal (δ ^ (q - 1)) * B)) :
    X ≤ K * (D⁻¹ * A + 2 * (A ^ ((q - 1) / q) * B ^ (1 / q))) := by
  have hq0 : 0 < q := by linarith
  obtain ⟨δ₀, hδ₀, hδ₀D⟩ : ∃ δ₀ : ℝ, 0 < δ₀ ∧ ENNReal.ofReal δ₀ ≤ D := by
    rcases eq_or_ne D ∞ with rfl | hDt
    · exact ⟨1, one_pos, le_top⟩
    · exact ⟨D.toReal, ENNReal.toReal_pos hD hDt, (ENNReal.ofReal_toReal hDt).le⟩
  rcases eq_or_ne B 0 with hB' | hB'
  · exact (hB0 hB').trans (mul_le_mul' le_rfl le_self_add)
  rcases eq_or_ne A 0 with rfl | hA'
  · rcases hq.eq_or_lt with rfl | hq1
    · have := h δ₀ hδ₀ hδ₀D
      simp only [mul_zero, zero_add, sub_self, Real.rpow_zero, ENNReal.ofReal_one, one_mul,
        ENNReal.rpow_zero, div_one, ENNReal.rpow_one] at this ⊢
      exact this.trans (mul_le_mul' le_rfl (le_mul_of_one_le_left' (by norm_num)))
    · have ht : Tendsto (fun δ : ℝ => K * (ENNReal.ofReal δ⁻¹ * 0 +
          ENNReal.ofReal (δ ^ (q - 1)) * B)) (𝓝[>] 0) (𝓝 (K * (ENNReal.ofReal 0 * B))) := by
        simp only [mul_zero, zero_add]
        have h1 : Tendsto (fun δ : ℝ => δ ^ (q - 1)) (𝓝[>] 0) (𝓝 0) := by
          have := (Real.continuousAt_rpow_const 0 (q - 1) (Or.inr (by linarith))).tendsto
          rw [Real.zero_rpow (by linarith)] at this
          exact this.mono_left nhdsWithin_le_nhds
        exact ENNReal.Tendsto.const_mul (ENNReal.Tendsto.mul_const (ENNReal.tendsto_ofReal h1)
          (Or.inr hB))
          (Or.inr hK)
      have hev : ∀ᶠ δ in 𝓝[>] (0 : ℝ), X ≤ K * (ENNReal.ofReal δ⁻¹ * 0 +
          ENNReal.ofReal (δ ^ (q - 1)) * B) := by
        filter_upwards [Ioo_mem_nhdsGT hδ₀] with δ hδ
        exact h δ hδ.1 ((ENNReal.ofReal_le_ofReal hδ.2.le).trans hδ₀D)
      have := ge_of_tendsto ht hev
      simp only [ENNReal.ofReal_zero, zero_mul, mul_zero, nonpos_iff_eq_zero] at this
      simp [this]
  · set a' := A.toReal
    set b' := B.toReal
    have ha' : 0 < a' := ENNReal.toReal_pos hA' hA
    have hb' : 0 < b' := ENNReal.toReal_pos hB' hB
    have hA_eq : A = ENNReal.ofReal a' := (ENNReal.ofReal_toReal hA).symm
    have hB_eq : B = ENNReal.ofReal b' := (ENNReal.ofReal_toReal hB).symm
    obtain ⟨e1, e2⟩ := rpow_optimal_delta hq0 ha' hb'
    set M := a' ^ ((q - 1) / q) * b' ^ (1 / q)
    have hM : A ^ ((q - 1) / q) * B ^ (1 / q) = ENNReal.ofReal M := by
      rw [hA_eq, hB_eq, ENNReal.ofReal_rpow_of_pos ha', ENNReal.ofReal_rpow_of_pos hb',
        ← ENNReal.ofReal_mul (by positivity)]
    set δs := a' ^ (1 / q) / b' ^ (1 / q)
    have hδs : 0 < δs := by positivity
    rw [hM]
    by_cases hle : ENNReal.ofReal δs ≤ D
    · calc X ≤ K * (ENNReal.ofReal δs⁻¹ * A + ENNReal.ofReal (δs ^ (q - 1)) * B) :=
            h δs hδs hle
        _ = K * (2 * ENNReal.ofReal M) := by
            rw [hA_eq, hB_eq, ← ENNReal.ofReal_mul (by positivity),
              ← ENNReal.ofReal_mul (by positivity), e1, e2, two_mul]
        _ ≤ _ := mul_le_mul' le_rfl le_add_self
    · replace hle := not_le.1 hle
      have hDt : D ≠ ∞ := ne_top_of_lt hle
      set d := D.toReal
      have hd : 0 < d := ENNReal.toReal_pos hD hDt
      have hD_eq : D = ENNReal.ofReal d := (ENNReal.ofReal_toReal hDt).symm
      have hdδ : d < δs := by
        rw [hD_eq] at hle; exact (ENNReal.ofReal_lt_ofReal_iff hδs).1 hle
      calc X ≤ K * (ENNReal.ofReal d⁻¹ * A + ENNReal.ofReal (d ^ (q - 1)) * B) :=
            h d hd hD_eq.ge
        _ ≤ K * (D⁻¹ * A + ENNReal.ofReal M) := by
            rw [ENNReal.ofReal_inv_of_pos hd, ← hD_eq]
            refine mul_le_mul' le_rfl (add_le_add le_rfl ?_)
            rw [hB_eq, ← ENNReal.ofReal_mul (by positivity), ← e2]
            refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right ?_ hb'.le)
            exact Real.rpow_le_rpow hd.le hdδ.le (by linarith)
        _ ≤ _ := mul_le_mul' le_rfl (add_le_add le_rfl
            (le_mul_of_one_le_left' (by norm_num)))

/-- Dividing by `δ > 0`: from `δ X ≤ K (A + δ^q B)` get `X ≤ K (δ⁻¹ A + δ^{q-1} B)`. -/
theorem le_of_ofReal_mul_le {q δ : ℝ} (hδ : 0 < δ) {X A B K : ℝ≥0∞}
    (h : ENNReal.ofReal δ * X ≤ K * (A + ENNReal.ofReal δ ^ q * B)) :
    X ≤ K * (ENNReal.ofReal δ⁻¹ * A + ENNReal.ofReal (δ ^ (q - 1)) * B) := by
  have hδ0 : ENNReal.ofReal δ ≠ 0 := by simpa using hδ
  calc X = ENNReal.ofReal δ⁻¹ * (ENNReal.ofReal δ * X) := by
        rw [← mul_assoc, ENNReal.ofReal_inv_of_pos hδ,
          ENNReal.inv_mul_cancel hδ0 ENNReal.ofReal_ne_top, one_mul]
    _ ≤ ENNReal.ofReal δ⁻¹ * (K * (A + ENNReal.ofReal δ ^ q * B)) := by gcongr
    _ = _ := by
        have : ENNReal.ofReal δ⁻¹ * ENNReal.ofReal δ ^ q = ENNReal.ofReal (δ ^ (q - 1)) := by
          rw [ENNReal.ofReal_rpow_of_pos hδ, ← ENNReal.ofReal_mul (by positivity),
            Real.rpow_sub_one hδ.ne', div_eq_mul_inv, mul_comm]
        rw [← this]; ring

/-- **Sobolev-type embedding for the `q`-variation** (replaces Proposition 2.2 / (`eq:Lplqlq`)
of the paper): if `|F(t) - F(s)| ≤ ∫_s^t |F'|` for `a ≤ s ≤ t ≤ b` and `F, F' ∈ L^q([a, b])`,
then `V^q_{[a,b]}(F)^q ≤ 2 · 4^q ‖F‖_{L^q}^{q-1} ‖F'‖_{L^q}` (`q ≥ 1`). -/
theorem variationNorm_rpow_le_of_fTC (hq : 1 ≤ q)
    (hFTC : ∀ s t, a ≤ s → s ≤ t → t ≤ b → ‖F t - F s‖ₑ ≤ ∫⁻ u in Ioc s t, ‖F' u‖ₑ)
    (hF' : AEMeasurable F' (volume.restrict (Icc a b)))
    (hA : ∫⁻ u in Icc a b, ‖F u‖ₑ ^ q ≠ ∞) (hB : ∫⁻ u in Icc a b, ‖F' u‖ₑ ^ q ≠ ∞) :
    variationNorm q (Icc a b) F ^ q ≤ 2 * 4 ^ q * (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) ^ ((q - 1) / q) *
      (∫⁻ u in Icc a b, ‖F' u‖ₑ ^ q) ^ (1 / q) := by
  have hq0 : 0 < q := by linarith
  have h4 : (4 : ℝ≥0∞) ^ q ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg hq0.le (by simp)
  have key := le_of_forall_delta hq (X := variationNorm q (Icc a b) F ^ q) (K := 4 ^ q)
    (D := ∞) (by simp) hA hB h4 ?_ ?_
  · rw [ENNReal.inv_top, zero_mul, zero_add] at key
    calc _ ≤ _ := key
      _ = _ := by ring
  · intro hB0
    refine variationNorm_rpow_le hq0 fun J u hu hm => le_trans (le_of_eq ?_) zero_le
    refine Finset.sum_eq_zero fun i _ => ?_
    have := enorm_sub_rpow_le_of_fTC hq hFTC hF' (hm i.castSucc).1
      (hu (Fin.castSucc_lt_succ (i := i))).le (hm i.succ).2
    have hY : ∫⁻ x in Ioc (u i.castSucc) (u i.succ), ‖F' x‖ₑ ^ q = 0 :=
      le_antisymm ((lintegral_mono_set (Ioc_subset_Icc_self.trans
        (Icc_subset_Icc (hm i.castSucc).1 (hm i.succ).2))).trans hB0.le) zero_le
    rw [hY, mul_zero] at this
    exact le_antisymm this zero_le
  · intro δ hδ _
    refine variationNorm_rpow_le hq0 fun J u hu hm => ?_
    calc ∑ i : Fin J, ‖F (u i.succ) - F (u i.castSucc)‖ₑ ^ q
        ≤ ∑ i : Fin J, 4 ^ q * (ENNReal.ofReal δ⁻¹ *
            (∫⁻ x in Ioc (u i.castSucc) (u i.succ), ‖F x‖ₑ ^ q) + ENNReal.ofReal (δ ^ (q - 1)) *
              ∫⁻ x in Ioc (u i.castSucc) (u i.succ), ‖F' x‖ₑ ^ q) :=
          Finset.sum_le_sum fun i _ => enorm_sub_rpow_le_gap hq hFTC hF' (hm i.castSucc).1
            (hu (Fin.castSucc_lt_succ (i := i))).le (hm i.succ).2 hδ
      _ = 4 ^ q * (ENNReal.ofReal δ⁻¹ *
            ∑ i : Fin J, (∫⁻ x in Ioc (u i.castSucc) (u i.succ), ‖F x‖ₑ ^ q) +
            ENNReal.ofReal (δ ^ (q - 1)) *
              ∑ i : Fin J, ∫⁻ x in Ioc (u i.castSucc) (u i.succ), ‖F' x‖ₑ ^ q) := by
          rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, Finset.mul_sum]
      _ ≤ _ := by
          gcongr
          · exact sum_setLIntegral_Ioc_le hu hm _
          · exact sum_setLIntegral_Ioc_le hu hm _

/-- **Sobolev-type embedding, supremum form**: under the hypotheses of
`variationNorm_rpow_le_of_fTC` and `a < b`,
`sup_{u ∈ [a,b]} |F(u)|^q ≤ 2^q ((b - a)⁻¹ ‖F‖_{L^q}^q + ‖F‖_{L^q}^{q-1} ‖F'‖_{L^q})`. -/
theorem iSup_enorm_rpow_le_of_fTC (hq : 1 ≤ q) (hab : a < b)
    (hFTC : ∀ s t, a ≤ s → s ≤ t → t ≤ b → ‖F t - F s‖ₑ ≤ ∫⁻ u in Ioc s t, ‖F' u‖ₑ)
    (hF' : AEMeasurable F' (volume.restrict (Icc a b)))
    (hA : ∫⁻ u in Icc a b, ‖F u‖ₑ ^ q ≠ ∞) (hB : ∫⁻ u in Icc a b, ‖F' u‖ₑ ^ q ≠ ∞) :
    ⨆ u ∈ Icc a b, ‖F u‖ₑ ^ q ≤ 2 ^ q * ((ENNReal.ofReal (b - a))⁻¹ *
      (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) + (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) ^ ((q - 1) / q) *
        (∫⁻ u in Icc a b, ‖F' u‖ₑ ^ q) ^ (1 / q)) := by
  have hq0 : 0 < q := by linarith
  have h2 : (2 : ℝ≥0∞) ^ (q - 1) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)
  set A := ∫⁻ u in Icc a b, ‖F u‖ₑ ^ q
  set B := ∫⁻ u in Icc a b, ‖F' u‖ₑ ^ q
  have hba : 0 < (b - a) / 2 := by linarith
  refine iSup₂_le fun u hu => ?_
  have h : ∀ δ : ℝ, 0 < δ → ENNReal.ofReal δ ≤ ENNReal.ofReal ((b - a) / 2) →
      ‖F u‖ₑ ^ q ≤ 2 ^ (q - 1) * (ENNReal.ofReal δ⁻¹ * A + ENNReal.ofReal (δ ^ (q - 1)) * B) := by
    intro δ hδ hδD
    have hδ' : δ ≤ (b - a) / 2 := (ENNReal.ofReal_le_ofReal_iff hba.le).1 hδD
    refine le_of_ofReal_mul_le hδ ?_
    obtain ⟨c, d, hdc, hac, hdb, hw⟩ :
        ∃ c d : ℝ, d - c = δ ∧ a ≤ c ∧ d ≤ b ∧ (u = c ∨ u = d) := by
      by_cases hub : u + δ ≤ b
      · exact ⟨u, u + δ, by ring, hu.1, hub, Or.inl rfl⟩
      · exact ⟨u - δ, u, by ring, by linarith, hu.2, Or.inr rfl⟩
    have hW := mul_enorm_rpow_le_window hq hFTC hF' (by linarith) hac hdb hw
    rw [hdc] at hW
    refine hW.trans (mul_le_mul' le_rfl (add_le_add (lintegral_mono_set ?_)
      (mul_le_mul' le_rfl (lintegral_mono_set ?_)))) <;>
    exact Ioc_subset_Icc_self.trans (Icc_subset_Icc hac hdb)
  have key := le_of_forall_delta hq (X := ‖F u‖ₑ ^ q) (A := A) (B := B) (K := 2 ^ (q - 1))
    (D := ENNReal.ofReal ((b - a) / 2)) (by simpa using hba) hA hB h2 ?_ h
  · have hD : (ENNReal.ofReal ((b - a) / 2))⁻¹ = 2 * (ENNReal.ofReal (b - a))⁻¹ := by
      rw [ENNReal.ofReal_div_of_pos two_pos, ENNReal.inv_div (by simp) (by simp),
        ENNReal.ofReal_ofNat, div_eq_mul_inv]
    rw [hD] at key
    refine key.trans (le_of_eq ?_)
    have h1 : (2 : ℝ≥0∞) ^ (q - 1) * 2 = 2 ^ q := by
      conv_rhs => rw [show q = (q - 1) + 1 by ring]
      rw [ENNReal.rpow_add _ _ (by simp) (by simp), ENNReal.rpow_one]
    rw [← h1]; ring
  · intro hB0
    have := h ((b - a) / 2) hba le_rfl
    rwa [hB0, mul_zero, add_zero, ENNReal.ofReal_inv_of_pos hba] at this

/-- The fundamental theorem of calculus in the form used by the Sobolev embeddings: if
`F' = dF/du` on `[a, b]` (one-sided at the endpoints) and `F'` is continuous on `[a, b]`, then
`|F(t) - F(s)| ≤ ∫_s^t |F'|` for `a ≤ s ≤ t ≤ b`. -/
theorem enorm_sub_le_of_hasDerivWithinAt
    (hF : ∀ u ∈ Icc a b, HasDerivWithinAt F (F' u) (Icc a b) u)
    (hF' : ContinuousOn F' (Icc a b)) :
    ∀ s t, a ≤ s → s ≤ t → t ≤ b → ‖F t - F s‖ₑ ≤ ∫⁻ u in Ioc s t, ‖F' u‖ₑ := by
  intro s t has hst htb
  have hsub : Icc s t ⊆ Icc a b := Icc_subset_Icc has htb
  have hcont : ContinuousOn F (Icc s t) := fun x hx =>
    (hF x (hsub hx)).continuousWithinAt.mono hsub
  have hderiv : ∀ x ∈ Ioo s t, HasDerivWithinAt F (F' x) (Ioi x) x := fun x hx =>
    ((hF x (hsub (Ioo_subset_Icc_self hx))).hasDerivAt
      (Icc_mem_nhds (has.trans_lt hx.1) (hx.2.trans_le htb))).hasDerivWithinAt
  have hint : IntervalIntegrable F' volume s t := (hF'.mono hsub).intervalIntegrable_of_Icc hst
  rw [← intervalIntegral.integral_eq_sub_of_hasDeriv_right_of_le hst hcont hderiv hint,
    intervalIntegral.integral_of_le hst]
  exact enorm_integral_le_lintegral_enorm _

/-- A function continuous on `[a, b]` has finite `L^q([a, b])` norm (`q ≥ 0`). -/
theorem setLIntegral_enorm_rpow_Icc_ne_top {G : ℝ → ℂ} (hG : ContinuousOn G (Icc a b))
    (hq : 0 ≤ q) : ∫⁻ u in Icc a b, ‖G u‖ₑ ^ q ≠ ∞ := by
  obtain ⟨M, hM⟩ := isCompact_Icc.exists_bound_of_continuousOn hG
  refine ne_top_of_le_ne_top (b := ∫⁻ _ in Icc a b, ENNReal.ofReal M ^ q) ?_
    (setLIntegral_mono' measurableSet_Icc fun u hu => ENNReal.rpow_le_rpow
      (by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hM u hu)) hq)
  rw [setLIntegral_const, Real.volume_Icc]
  exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hq ENNReal.ofReal_ne_top)
    ENNReal.ofReal_ne_top

/-- **Sobolev-type embedding for the `q`-variation, `C¹` form** (replaces Proposition 2.2 /
(`eq:Lplqlq`) of the paper): if `F' = dF/du` on `[a, b]` with `F'` continuous, then for `q ≥ 1`,
`(V^q_{[a,b]} F)^q ≤ 2 · 4^q (∫_a^b |F|^q)^{(q-1)/q} (∫_a^b |F'|^q)^{1/q}`. -/
theorem variationNorm_rpow_le_of_hasDerivWithinAt (hq : 1 ≤ q)
    (hF : ∀ u ∈ Icc a b, HasDerivWithinAt F (F' u) (Icc a b) u)
    (hF' : ContinuousOn F' (Icc a b)) :
    variationNorm q (Icc a b) F ^ q ≤ 2 * 4 ^ q * (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) ^ ((q - 1) / q) *
      (∫⁻ u in Icc a b, ‖F' u‖ₑ ^ q) ^ (1 / q) :=
  variationNorm_rpow_le_of_fTC hq (enorm_sub_le_of_hasDerivWithinAt hF hF')
    (hF'.aemeasurable measurableSet_Icc)
    (setLIntegral_enorm_rpow_Icc_ne_top (fun x hx => (hF x hx).continuousWithinAt) (by linarith))
    (setLIntegral_enorm_rpow_Icc_ne_top hF' (by linarith))

/-- **Sobolev-type embedding, supremum form, `C¹` version**: if `F' = dF/du` on `[a, b]`,
`a < b`, with `F'` continuous, then for `q ≥ 1`,
`sup_{[a,b]} |F|^q ≤ 2^q ((b - a)⁻¹ ∫ |F|^q + (∫ |F|^q)^{(q-1)/q} (∫ |F'|^q)^{1/q})`. -/
theorem iSup_enorm_rpow_le_of_hasDerivWithinAt (hq : 1 ≤ q) (hab : a < b)
    (hF : ∀ u ∈ Icc a b, HasDerivWithinAt F (F' u) (Icc a b) u)
    (hF' : ContinuousOn F' (Icc a b)) :
    ⨆ u ∈ Icc a b, ‖F u‖ₑ ^ q ≤ 2 ^ q * ((ENNReal.ofReal (b - a))⁻¹ *
      (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) + (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) ^ ((q - 1) / q) *
        (∫⁻ u in Icc a b, ‖F' u‖ₑ ^ q) ^ (1 / q)) :=
  iSup_enorm_rpow_le_of_fTC hq hab (enorm_sub_le_of_hasDerivWithinAt hF hF')
    (hF'.aemeasurable measurableSet_Icc)
    (setLIntegral_enorm_rpow_Icc_ne_top (fun x hx => (hF x hx).continuousWithinAt) (by linarith))
    (setLIntegral_enorm_rpow_Icc_ne_top hF' (by linarith))

/-- **Sobolev-type embedding for the `q`-variation, `ContDiffOn` form**: if `F` is `C¹` on
`[a, b]`, `a < b`, then with `F' = derivWithin F [a, b]` and `q ≥ 1`,
`(V^q_{[a,b]} F)^q ≤ 2 · 4^q (∫_a^b |F|^q)^{(q-1)/q} (∫_a^b |F'|^q)^{1/q}`. -/
theorem variationNorm_rpow_le_of_contDiffOn (hq : 1 ≤ q) (hab : a < b)
    (hF : ContDiffOn ℝ 1 F (Icc a b)) :
    variationNorm q (Icc a b) F ^ q ≤ 2 * 4 ^ q * (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) ^ ((q - 1) / q) *
      (∫⁻ u in Icc a b, ‖derivWithin F (Icc a b) u‖ₑ ^ q) ^ (1 / q) :=
  variationNorm_rpow_le_of_hasDerivWithinAt hq
    (fun u hu => ((hF.differentiableOn (by simp)) u hu).hasDerivWithinAt)
    (hF.continuousOn_derivWithin (uniqueDiffOn_Icc hab) le_rfl)

/-- **Sobolev-type embedding, supremum form, `ContDiffOn` version**: if `F` is `C¹` on
`[a, b]`, `a < b`, then with `F' = derivWithin F [a, b]` and `q ≥ 1`,
`sup_{[a,b]} |F|^q ≤ 2^q ((b - a)⁻¹ ∫ |F|^q + (∫ |F|^q)^{(q-1)/q} (∫ |F'|^q)^{1/q})`. -/
theorem iSup_enorm_rpow_le_of_contDiffOn (hq : 1 ≤ q) (hab : a < b)
    (hF : ContDiffOn ℝ 1 F (Icc a b)) :
    ⨆ u ∈ Icc a b, ‖F u‖ₑ ^ q ≤ 2 ^ q * ((ENNReal.ofReal (b - a))⁻¹ *
      (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) + (∫⁻ u in Icc a b, ‖F u‖ₑ ^ q) ^ ((q - 1) / q) *
        (∫⁻ u in Icc a b, ‖derivWithin F (Icc a b) u‖ₑ ^ q) ^ (1 / q)) :=
  iSup_enorm_rpow_le_of_hasDerivWithinAt hq hab
    (fun u hu => ((hF.differentiableOn (by simp)) u hu).hasDerivWithinAt)
    (hF.continuousOn_derivWithin (uniqueDiffOn_Icc hab) le_rfl)

end SobolevEmbedding

/-! ## Difference operators: extension of `𝓗^{(u)} - 𝓗^{(v)}` to `L^p`

The family `𝓗^{(u)}` is only defined on Schwartz functions (principal values), but the
differences `𝓗^{(u)} - 𝓗^{(v)}` have the kernel `(e^{iu|t|^α} - e^{iv|t|^α}) K(t)`, which is
`O(|u - v| |t|^{α-n})` near `0` (integrable) and `O(|t|^{-n})` at infinity (in `L^q`, `q > 1`).
Hence `(𝓗^{(u)} - 𝓗^{(v)}) f(x)` is an absolutely convergent integral for a.e. `x` when
`f ∈ L^p`, `1 < p < ∞`. Since `V^r`, `N_λ` and `S_r` are invariant under subtracting the
`u`-independent function `𝓗^{(v)} f(x)`, this extends all variational functionals of `𝓗^{(u)} f`
to `L^p`; with Young's inequality, lower semicontinuity of the functionals and Fatou's lemma,
`L^p` bounds for Schwartz functions extend to `L^p` (needed for the truncation arguments in the
jump-to-variation interpolation below). -/

section DifferenceOperators

open scoped SchwartzMap

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The difference kernel `(e^{iu|t|^α} - e^{iv|t|^α}) K(t)` of `𝓗^{(u)} - 𝓗^{(v)}`
(used to extend the family `𝓗^{(u)}`, up to a `u`-independent term, to `L^p`). -/
noncomputable def modulatedDiffKernel (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u v : ℝ) (t : Rn n) : ℂ :=
  (exp (I * u * (‖t‖ ^ α : ℝ)) - exp (I * v * (‖t‖ ^ α : ℝ))) * (czKernel n Ω t : ℂ)

/-- The difference operator
`(𝓗^{(u)} - 𝓗^{(v)}) f(x) = ∫ f(x - t) (e^{iu|t|^α} - e^{iv|t|^α}) K(t) dt`. Its kernel is
`O(|u - v| |t|^{α-n})` near `0` and `O(|t|^{-n})` at infinity, so the integral converges absolutely
for almost every `x` when `f ∈ L^p`, `1 < p < ∞` (`ae_integrable_modulatedDiff_integrand`); for
Schwartz `f` it equals `𝓗^{(u)} f(x) - 𝓗^{(v)} f(x)` (`modulatedDiff_eq_sub`). -/
noncomputable def modulatedDiff (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u v : ℝ) (f : Rn n → ℂ)
    (x : Rn n) : ℂ :=
  ∫ t, f (x - t) * modulatedDiffKernel n α Ω u v t

/-- The local majorant `𝟙_{|t| ≤ 1} |t|^{α-n}` of the difference kernel (integrable for
`α > 0`). -/
noncomputable def diffNearMajorant (n : ℕ) (α : ℝ) (t : Rn n) : ℝ≥0∞ :=
  (Metric.closedBall (0 : Rn n) 1).indicator (fun t => ENNReal.ofReal (‖t‖ ^ (α - n))) t

/-- The global majorant `(1 + |t|)^{-n}` of the difference kernel away from the origin (in `L^q`
for every `q > 1`). -/
noncomputable def diffFarMajorant (n : ℕ) (t : Rn n) : ℝ≥0∞ :=
  ENNReal.ofReal ((1 + ‖t‖) ^ (-(n : ℝ)))

/-- `|e^{ius} - e^{ivs}| ≤ |u - v| |s|` for real `u, v, s`. -/
theorem norm_exp_sub_exp_le (u v s : ℝ) :
    ‖exp (I * u * (s : ℂ)) - exp (I * v * (s : ℂ))‖ ≤ |u - v| * |s| := by
  calc ‖exp (I * u * (s : ℂ)) - exp (I * v * (s : ℂ))‖
      = ‖exp (I * v * (s : ℂ)) * (exp (I * ((u - v : ℝ) : ℂ) * (s : ℂ)) - 1)‖ := by
        congr 1
        rw [mul_sub, mul_one, ← Complex.exp_add]
        congr 2; push_cast; ring
    _ = ‖exp (I * ((u - v : ℝ) : ℂ) * (s : ℂ)) - 1‖ := by
        rw [norm_mul, norm_exp_I_mul_mul, one_mul]
    _ ≤ |u - v| * |s| := norm_exp_I_mul_mul_sub_one_le _ _

/-- `|e^{ius} - e^{ivs}| ≤ 2` for real `u, v, s`. -/
theorem norm_exp_sub_exp_le_two (u v s : ℝ) :
    ‖exp (I * u * (s : ℂ)) - exp (I * v * (s : ℂ))‖ ≤ 2 := by
  refine (norm_sub_le _ _).trans ?_
  rw [norm_exp_I_mul_mul, norm_exp_I_mul_mul]; norm_num

/-- Measurability of the difference kernel. -/
theorem IsHomogeneousCZKernel.measurable_modulatedDiffKernel (hΩ : IsHomogeneousCZKernel n Ω)
    (α u v : ℝ) : Measurable (modulatedDiffKernel n α Ω u v) := by
  unfold modulatedDiffKernel
  refine Measurable.mul (Measurable.sub ?_ ?_)
    (Complex.measurable_ofReal.comp hΩ.measurable_czKernel) <;>
  exact Complex.measurable_exp.comp (measurable_const.mul
    (Complex.measurable_ofReal.comp (measurable_norm.pow_const α)))

/-- Measurability of the near majorant. -/
theorem measurable_diffNearMajorant (n : ℕ) (α : ℝ) : Measurable (diffNearMajorant n α) :=
  (ENNReal.measurable_ofReal.comp (measurable_norm.pow_const _)).indicator measurableSet_closedBall

/-- Measurability of the far majorant. -/
theorem measurable_diffFarMajorant (n : ℕ) : Measurable (diffFarMajorant n) :=
  ENNReal.measurable_ofReal.comp ((measurable_const.add measurable_norm).pow_const _)

/-- **Size of the difference kernel**: there is `C < ∞` with
`|(e^{iu|t|^α} - e^{iv|t|^α}) K(t)| ≤ C (|u - v| 𝟙_{|t| ≤ 1} |t|^{α-n} + (1 + |t|)^{-n})`. -/
theorem IsHomogeneousCZKernel.exists_enorm_modulatedDiffKernel_le
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 < α) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ u v t, ‖modulatedDiffKernel n α Ω u v t‖ₑ ≤
      C * (ENNReal.ofReal |u - v| * diffNearMajorant n α t + diffFarMajorant n t) := by
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound_czKernel
  refine ⟨ENNReal.ofReal (2 ^ (n + 1) * C), ENNReal.ofReal_ne_top, fun u v t => ?_⟩
  have hK : ‖(czKernel n Ω t : ℂ)‖ ≤ C / ‖t‖ ^ n := by
    rw [Complex.norm_real, Real.norm_eq_abs]; exact hC t
  rcases eq_or_ne t 0 with rfl | ht
  · simp [modulatedDiffKernel, Real.zero_rpow hα.ne']
  have hpos : 0 < ‖t‖ := norm_pos_iff.2 ht
  have hC' : C ≤ 2 ^ (n + 1) * C := le_mul_of_one_le_left hC0 (one_le_pow₀ (by norm_num))
  rw [← ofReal_norm]
  by_cases h1 : ‖t‖ ≤ 1
  · have hmem : t ∈ Metric.closedBall (0 : Rn n) 1 := by simpa using h1
    have hb : ‖modulatedDiffKernel n α Ω u v t‖ ≤
        2 ^ (n + 1) * C * (|u - v| * ‖t‖ ^ (α - n)) := by
      unfold modulatedDiffKernel
      rw [norm_mul]
      calc ‖exp (I * u * (‖t‖ ^ α : ℝ)) - exp (I * v * (‖t‖ ^ α : ℝ))‖ * ‖(czKernel n Ω t : ℂ)‖
          ≤ (|u - v| * ‖t‖ ^ α) * (C / ‖t‖ ^ n) := by
            refine mul_le_mul ?_ hK (norm_nonneg _) (by positivity)
            have := norm_exp_sub_exp_le u v (‖t‖ ^ α)
            rwa [abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ α)] at this
        _ = C * (|u - v| * ‖t‖ ^ (α - n)) := by
            rw [Real.rpow_sub hpos, Real.rpow_natCast]; ring
        _ ≤ _ := mul_le_mul_of_nonneg_right hC' (by positivity)
    refine (ENNReal.ofReal_le_ofReal hb).trans ?_
    rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (abs_nonneg _), diffNearMajorant,
      indicator_of_mem hmem]
    exact mul_le_mul' le_rfl le_self_add
  · have hlt : 1 < ‖t‖ := not_le.1 h1
    have hb : ‖modulatedDiffKernel n α Ω u v t‖ ≤ 2 ^ (n + 1) * C * (1 + ‖t‖) ^ (-(n : ℝ)) := by
      unfold modulatedDiffKernel
      rw [norm_mul, Real.rpow_neg (by positivity), Real.rpow_natCast]
      calc ‖exp (I * u * (‖t‖ ^ α : ℝ)) - exp (I * v * (‖t‖ ^ α : ℝ))‖ * ‖(czKernel n Ω t : ℂ)‖
          ≤ 2 * (C / ‖t‖ ^ n) :=
            mul_le_mul (norm_exp_sub_exp_le_two _ _ _) hK (norm_nonneg _) (by norm_num)
        _ = 2 ^ (n + 1) * C / (2 * ‖t‖) ^ n := by rw [mul_pow, pow_succ]; field_simp
        _ ≤ 2 ^ (n + 1) * C / (1 + ‖t‖) ^ n :=
            div_le_div_of_nonneg_left (by positivity) (by positivity)
              (pow_le_pow_left₀ (by positivity) (by linarith) n)
        _ = _ := by rw [div_eq_mul_inv]
    refine (ENNReal.ofReal_le_ofReal hb).trans ?_
    rw [ENNReal.ofReal_mul (by positivity)]
    exact mul_le_mul' le_rfl le_add_self

/-- The near majorant is integrable: `∫_{|t| ≤ 1} |t|^{α-n} dt < ∞` (`n ≥ 1`, `α > 0`). -/
theorem lintegral_diffNearMajorant_ne_top (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) :
    ∫⁻ t, diffNearMajorant n α t ≠ ∞ := by
  simp only [diffNearMajorant]
  rw [lintegral_indicator measurableSet_closedBall]
  exact (integrableOn_closedBall_norm_rpow hn hα).lintegral_lt_top.ne

/-- The far majorant is in `L^q` for `q > 1`: `∫ (1 + |t|)^{-nq} dt < ∞` (`n ≥ 1`). -/
theorem lintegral_diffFarMajorant_rpow_ne_top (hn : 1 ≤ n) {q : ℝ} (hq : 1 < q) :
    ∫⁻ t, diffFarMajorant n t ^ q ≠ ∞ := by
  have hpt : ∀ t : Rn n,
      diffFarMajorant n t ^ q = ENNReal.ofReal ((1 + ‖t‖) ^ (-((n : ℝ) * q))) := by
    intro t
    rw [diffFarMajorant, ENNReal.ofReal_rpow_of_nonneg (by positivity) (by linarith),
      ← Real.rpow_mul (by positivity), neg_mul]
  simp_rw [hpt]
  refine (integrable_one_add_norm ?_).lintegral_lt_top.ne
  rw [finrank_euclideanSpace_fin]
  have : (1 : ℝ) ≤ n := by exact_mod_cast hn
  nlinarith

/-- The far majorant is at most `1`. -/
theorem diffFarMajorant_le_one (n : ℕ) (t : Rn n) : diffFarMajorant n t ≤ 1 := by
  rw [diffFarMajorant, ENNReal.ofReal_le_one]
  exact Real.rpow_le_one_of_one_le_of_nonpos (by linarith [norm_nonneg t])
    (by simp)

/-- **The near part of the difference kernel is integrable**:
`𝟙_{|t| ≤ 1} (e^{iu|t|^α} - e^{iv|t|^α}) K(t) ∈ L¹` (`n ≥ 1`, `α > 0`). -/
theorem IsHomogeneousCZKernel.integrableOn_modulatedDiffKernel_closedBall
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u v : ℝ) :
    IntegrableOn (modulatedDiffKernel n α Ω u v) (Metric.closedBall 0 1) := by
  obtain ⟨C, hC, hk⟩ := hΩ.exists_enorm_modulatedDiffKernel_le hα
  refine ⟨(hΩ.measurable_modulatedDiffKernel α u v).aestronglyMeasurable, ?_⟩
  have hnear : ∫⁻ t in Metric.closedBall (0 : Rn n) 1, diffNearMajorant n α t ≠ ∞ :=
    ne_top_of_le_ne_top (lintegral_diffNearMajorant_ne_top hn hα) (setLIntegral_le_lintegral _ _)
  calc ∫⁻ t in Metric.closedBall (0 : Rn n) 1, ‖modulatedDiffKernel n α Ω u v t‖ₑ
      ≤ ∫⁻ t in Metric.closedBall (0 : Rn n) 1,
          C * (ENNReal.ofReal |u - v| * diffNearMajorant n α t + 1) :=
        lintegral_mono fun t => (hk u v t).trans
          (mul_le_mul' le_rfl (add_le_add le_rfl (diffFarMajorant_le_one n t)))
    _ = C * (ENNReal.ofReal |u - v| * (∫⁻ t in Metric.closedBall (0 : Rn n) 1,
          diffNearMajorant n α t) + volume (Metric.closedBall (0 : Rn n) 1)) := by
        rw [lintegral_const_mul' _ _ hC, lintegral_add_right _ measurable_const,
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, setLIntegral_const, one_mul]
    _ < ∞ := ENNReal.mul_lt_top hC.lt_top (ENNReal.add_lt_top.2
        ⟨ENNReal.mul_lt_top ENNReal.ofReal_lt_top hnear.lt_top, measure_closedBall_lt_top⟩)

/-- **The far part of the difference kernel is in `L^q` for every `1 < q ≤ ∞`**:
`𝟙_{|t| > 1} (e^{iu|t|^α} - e^{iv|t|^α}) K(t) ∈ L^q` (`n ≥ 1`, `α > 0`). -/
theorem IsHomogeneousCZKernel.memLp_indicator_compl_modulatedDiffKernel
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u v : ℝ)
    {q : ℝ≥0∞} (hq : 1 < q) :
    MemLp ((Metric.closedBall (0 : Rn n) 1)ᶜ.indicator (modulatedDiffKernel n α Ω u v)) q := by
  obtain ⟨C, hC, hk⟩ := hΩ.exists_enorm_modulatedDiffKernel_le hα
  set g := (Metric.closedBall (0 : Rn n) 1)ᶜ.indicator (modulatedDiffKernel n α Ω u v)
  have hb : ∀ t, ‖g t‖ₑ ≤ C * diffFarMajorant n t := by
    intro t
    by_cases ht : t ∈ (Metric.closedBall (0 : Rn n) 1)ᶜ
    · have h0 : diffNearMajorant n α t = 0 := indicator_of_notMem (by simpa using ht) _
      have := hk u v t
      rw [h0, mul_zero, zero_add] at this
      rwa [show g t = modulatedDiffKernel n α Ω u v t from indicator_of_mem ht _]
    · simp [g, indicator_of_notMem ht]
  have hm : AEStronglyMeasurable g :=
    ((hΩ.measurable_modulatedDiffKernel α u v).indicator
      measurableSet_closedBall.compl).aestronglyMeasurable
  rcases eq_or_ne q ∞ with rfl | hqt
  · refine memLp_top_of_bound hm C.toReal (ae_of_all _ fun t => ?_)
    rw [← toReal_enorm]
    exact ENNReal.toReal_mono hC ((hb t).trans (by
      simpa using mul_le_mul' (le_refl C) (diffFarMajorant_le_one n t)))
  · have hq0 : q ≠ 0 := (zero_lt_one.trans hq).ne'
    have hq1 : 1 < q.toReal := by
      have := ENNReal.toReal_strict_mono hqt hq
      simpa using this
    rw [memLp_iff, eLpNorm_eq_lintegral_rpow_enorm_toReal hq0 hqt hm]
    refine ENNReal.rpow_lt_top_of_nonneg (by positivity) (ne_top_of_le_ne_top ?_
      (lintegral_mono fun t => ENNReal.rpow_le_rpow (hb t) (by linarith)))
    simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by linarith : (0 : ℝ) ≤ q.toReal)]
    rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg (by linarith) hC)]
    exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by linarith) hC)
      (lintegral_diffFarMajorant_rpow_ne_top hn hq1)

/-- An `L^p` function has finite `∫ |f|^p` (`p > 0`). -/
theorem lintegral_enorm_rpow_ne_top_of_memLp {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {f : X → ℂ} {p : ℝ} (hp : 0 < p) (hf : MemLp f (ENNReal.ofReal p) μ) :
    ∫⁻ x, ‖f x‖ₑ ^ p ∂μ ≠ ∞ := by
  rw [← eLpNorm_ofReal_rpow_eq_lintegral hf.aestronglyMeasurable hp]
  exact ENNReal.rpow_ne_top_of_nonneg hp.le hf.eLpNorm_ne_top

/-- Replacing an a.e. strongly measurable function by its measurable modification does not
change the convolution-type integrals `∫ |h(x - t)| m(t) dt`. -/
theorem lintegral_enorm_sub_mul_eq_mk {h : Rn n → ℂ}
    (hh : AEStronglyMeasurable h) (m : Rn n → ℝ≥0∞) (x : Rn n) :
    ∫⁻ t, ‖h (x - t)‖ₑ * m t = ∫⁻ t, ‖hh.mk h (x - t)‖ₑ * m t := by
  refine lintegral_congr_ae ?_
  have := (Measure.measurePreserving_sub_left volume x).quasiMeasurePreserving.ae_eq_comp
    hh.ae_eq_mk
  filter_upwards [this] with t ht
  simp only [Function.comp] at ht
  rw [ht]

/-- Measurability of `x ↦ ∫ |h(x - t)| m(t) dt`. -/
theorem measurable_lintegral_enorm_sub_mul {h : Rn n → ℂ}
    (hh : AEStronglyMeasurable h) {m : Rn n → ℝ≥0∞} (hm : Measurable m) :
    Measurable fun x => ∫⁻ t, ‖h (x - t)‖ₑ * m t := by
  simp_rw [lintegral_enorm_sub_mul_eq_mk hh m]
  exact Measurable.lintegral_prod_right'
    ((hh.stronglyMeasurable_mk.measurable.comp measurable_sub).enorm.mul (hm.comp measurable_snd))

/-- **Young's inequality** `‖g * m‖_p ≤ ‖m‖_1 ‖g‖_p` (`p ≥ 1`) for nonnegative measurable
functions on `ℝⁿ`, in `lintegral` form:
`∫ (∫ g(x - t) m(t) dt)^p dx ≤ (∫ m)^p ∫ g^p`. -/
theorem lintegral_rpow_lintegral_sub_mul_le {g m : Rn n → ℝ≥0∞} (hg : Measurable g)
    (hm : Measurable m) {p : ℝ} (hp : 1 ≤ p) :
    ∫⁻ x, (∫⁻ t, g (x - t) * m t) ^ p ≤ (∫⁻ t, m t) ^ p * ∫⁻ x, g x ^ p := by
  have hp0 : 0 < p := by linarith
  have h1p : 0 ≤ 1 - 1 / p := by rw [sub_nonneg]; exact (div_le_one hp0).2 hp
  have hF : Measurable fun z : Rn n × Rn n => g (z.1 - z.2) ^ p * m z.2 :=
    ((hg.comp measurable_sub).pow_const p).mul (hm.comp measurable_snd)
  have hpt : ∀ x, (∫⁻ t, g (x - t) * m t) ^ p ≤
      (∫⁻ t, m t) ^ (p - 1) * ∫⁻ t, g (x - t) ^ p * m t := by
    intro x
    have hH := ENNReal.lintegral_mul_norm_pow_le (μ := volume)
      (f := fun t => g (x - t) ^ p * m t) (g := m)
      (((hg.comp (measurable_const.sub measurable_id)).pow_const p).mul hm).aemeasurable
      hm.aemeasurable (p := 1 / p) (q := 1 - 1 / p) (by positivity) h1p (by ring)
    have hint : ∀ t, (g (x - t) ^ p * m t) ^ (1 / p) * m t ^ (1 - 1 / p) = g (x - t) * m t := by
      intro t
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), rpow_rpow_one_div hp0.ne', mul_assoc,
        ← ENNReal.rpow_add_of_nonneg _ _ (by positivity) h1p, add_sub_cancel, ENNReal.rpow_one]
    simp_rw [hint] at hH
    calc (∫⁻ t, g (x - t) * m t) ^ p
        ≤ ((∫⁻ t, g (x - t) ^ p * m t) ^ (1 / p) * (∫⁻ t, m t) ^ (1 - 1 / p)) ^ p :=
          ENNReal.rpow_le_rpow hH hp0.le
      _ = (∫⁻ t, m t) ^ (p - 1) * ∫⁻ t, g (x - t) ^ p * m t := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, rpow_one_div_rpow hp0.ne', ← ENNReal.rpow_mul,
            mul_comm]
          congr 2; field_simp
  calc ∫⁻ x, (∫⁻ t, g (x - t) * m t) ^ p
      ≤ ∫⁻ x, (∫⁻ t, m t) ^ (p - 1) * ∫⁻ t, g (x - t) ^ p * m t := lintegral_mono hpt
    _ = (∫⁻ t, m t) ^ (p - 1) * ∫⁻ x, ∫⁻ t, g (x - t) ^ p * m t :=
        lintegral_const_mul _ hF.lintegral_prod_right'
    _ = (∫⁻ t, m t) ^ (p - 1) * ∫⁻ t, ∫⁻ x, g (x - t) ^ p * m t := by
        rw [lintegral_lintegral_swap hF.aemeasurable]
    _ = (∫⁻ t, m t) ^ (p - 1) * ∫⁻ t, (∫⁻ x, g x ^ p) * m t := by
        congr 1
        refine lintegral_congr fun t => ?_
        have hmt : Measurable fun x => g (x - t) ^ p :=
          (hg.comp (measurable_sub_const t)).pow_const p
        rw [lintegral_mul_const _ hmt, lintegral_sub_right_eq_self (fun y => g y ^ p) t]
    _ = (∫⁻ t, m t) ^ (p - 1) * ((∫⁻ t, m t) * ∫⁻ x, g x ^ p) := by
        rw [lintegral_const_mul _ hm, mul_comm (∫⁻ t, m t)]
    _ = (∫⁻ t, m t) ^ p * ∫⁻ x, g x ^ p := by
        rw [← mul_assoc]
        congr 1
        conv_rhs => rw [show p = (p - 1) + 1 by ring]
        rw [ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one, ENNReal.rpow_one]

/-- Young's inequality for `|h|` with `h` a.e. strongly measurable:
`∫ (∫ |h(x - t)| m(t) dt)^p dx ≤ (∫ m)^p ∫ |h|^p` (`p ≥ 1`). -/
theorem lintegral_rpow_lintegral_enorm_sub_mul_le
    {h : Rn n → ℂ} (hh : AEStronglyMeasurable h) {m : Rn n → ℝ≥0∞} (hm : Measurable m) {p : ℝ}
    (hp : 1 ≤ p) :
    ∫⁻ x, (∫⁻ t, ‖h (x - t)‖ₑ * m t) ^ p ≤ (∫⁻ t, m t) ^ p * ∫⁻ x, ‖h x‖ₑ ^ p := by
  simp_rw [lintegral_enorm_sub_mul_eq_mk hh m]
  have hmk : ∫⁻ x, ‖h x‖ₑ ^ p = ∫⁻ x, ‖hh.mk h x‖ₑ ^ p :=
    lintegral_congr_ae (hh.ae_eq_mk.mono fun x hx => by simp only [hx])
  rw [hmk]
  exact lintegral_rpow_lintegral_sub_mul_le hh.stronglyMeasurable_mk.measurable.enorm hm hp

/-- The near part of the convolution is finite almost everywhere: for `f ∈ L^p`, `p ≥ 1`,
`∫ |f(x - t)| 𝟙_{|t| ≤ 1} |t|^{α-n} dt < ∞` for a.e. `x`. -/
theorem ae_lintegral_enorm_sub_mul_diffNearMajorant_ne_top (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α)
    {p : ℝ} (hp : 1 ≤ p) {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) :
    ∀ᵐ x, ∫⁻ t, ‖f (x - t)‖ₑ * diffNearMajorant n α t ≠ ∞ := by
  have hp0 : 0 < p := by linarith
  have hmeas := measurable_lintegral_enorm_sub_mul hf.aestronglyMeasurable
    (measurable_diffNearMajorant n α)
  have hY := lintegral_rpow_lintegral_enorm_sub_mul_le hf.aestronglyMeasurable
    (measurable_diffNearMajorant n α) hp
  have hfin : ∫⁻ x, (∫⁻ t, ‖f (x - t)‖ₑ * diffNearMajorant n α t) ^ p ≠ ∞ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hp0.le
      (lintegral_diffNearMajorant_ne_top hn hα)) (lintegral_enorm_rpow_ne_top_of_memLp hp0 hf)) hY
  filter_upwards [ae_lt_top' (hmeas.pow_const p).aemeasurable hfin] with x hx
  intro htop
  rw [htop, ENNReal.top_rpow_of_pos hp0] at hx
  exact lt_irrefl _ hx

/-- The far part of the convolution is controlled by Hölder's inequality: for every `x`,
`∫ |f(x - t)| (1 + |t|)^{-n} dt ≤ ‖f‖_p ‖(1 + |·|)^{-n}‖_{p'}` (`1 < p`). -/
theorem lintegral_enorm_sub_mul_diffFarMajorant_le {p : ℝ} (hp : 1 < p) {f : Rn n → ℂ}
    (hf : AEStronglyMeasurable f) (x : Rn n) :
    ∫⁻ t, ‖f (x - t)‖ₑ * diffFarMajorant n t ≤ eLpNorm f (ENNReal.ofReal p) *
      (∫⁻ t, diffFarMajorant n t ^ p.conjExponent) ^ (1 / p.conjExponent) := by
  have hpq := Real.HolderConjugate.conjExponent hp
  have h1 : AEMeasurable (fun t => ‖f (x - t)‖ₑ) :=
    (hf.comp_measurePreserving (Measure.measurePreserving_sub_left volume x)).enorm
  have := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq h1
    (measurable_diffFarMajorant n).aemeasurable
  simp only [Pi.mul_apply] at this
  refine this.trans (le_of_eq ?_)
  rw [lintegral_sub_left_eq_self (fun y => ‖f y‖ₑ ^ p) x,
    eLpNorm_ofReal_eq_lintegral_rpow_enorm hf (by linarith)]

/-- The far part of the convolution is finite for every `x` when `f ∈ L^p`, `1 < p`. -/
theorem lintegral_enorm_sub_mul_diffFarMajorant_ne_top (hn : 1 ≤ n) {p : ℝ} (hp : 1 < p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) (x : Rn n) :
    ∫⁻ t, ‖f (x - t)‖ₑ * diffFarMajorant n t ≠ ∞ := by
  have hq : 1 < p.conjExponent := (Real.HolderConjugate.conjExponent hp).symm.lt
  refine ne_top_of_le_ne_top (ENNReal.mul_ne_top hf.eLpNorm_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by positivity)
      (lintegral_diffFarMajorant_rpow_ne_top hn hq))) (lintegral_enorm_sub_mul_diffFarMajorant_le
        hp hf.aestronglyMeasurable x)

/-- `∫ F (C (a N + R)) = C (a ∫ F N + ∫ F R)` for `C < ∞` and measurable `F`, `N`. -/
theorem lintegral_mul_const_mul_add {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F N R : X → ℝ≥0∞} (hF : AEMeasurable F μ) (hN : Measurable N) {C : ℝ≥0∞} (hC : C ≠ ∞)
    (a : ℝ≥0∞) :
    ∫⁻ t, F t * (C * (a * N t + R t)) ∂μ = C * (a * (∫⁻ t, F t * N t ∂μ) + ∫⁻ t, F t * R t ∂μ) := by
  have : ∀ t, F t * (C * (a * N t + R t)) = C * (a * (F t * N t) + F t * R t) := fun t => by ring
  simp_rw [this]
  have hFN : AEMeasurable (fun t => F t * N t) μ := hF.mul hN.aemeasurable
  have haFN : AEMeasurable (fun t => a * (F t * N t)) μ := hFN.const_mul a
  rw [lintegral_const_mul' _ _ hC, lintegral_add_left' haFN, lintegral_const_mul'' _ hFN]

/-- Pointwise majorization of `|f(x - t) k(t)|` by the majorants, integrated. -/
theorem IsHomogeneousCZKernel.lintegral_enorm_modulatedDiff_integrand_le
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 < α) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (u v : ℝ) (f : Rn n → ℂ), AEStronglyMeasurable f → ∀ x,
      ∫⁻ t, ‖f (x - t) * modulatedDiffKernel n α Ω u v t‖ₑ ≤
        C * (ENNReal.ofReal |u - v| * (∫⁻ t, ‖f (x - t)‖ₑ * diffNearMajorant n α t) +
          ∫⁻ t, ‖f (x - t)‖ₑ * diffFarMajorant n t) := by
  obtain ⟨C, hC, hk⟩ := hΩ.exists_enorm_modulatedDiffKernel_le hα
  refine ⟨C, hC, fun u v f hf x => ?_⟩
  have h1 : AEMeasurable (fun t => ‖f (x - t)‖ₑ) :=
    (hf.comp_measurePreserving (Measure.measurePreserving_sub_left volume x)).enorm
  calc ∫⁻ t, ‖f (x - t) * modulatedDiffKernel n α Ω u v t‖ₑ
      ≤ ∫⁻ t, ‖f (x - t)‖ₑ * (C * (ENNReal.ofReal |u - v| * diffNearMajorant n α t +
          diffFarMajorant n t)) :=
        lintegral_mono fun t => by rw [enorm_mul]; exact mul_le_mul' le_rfl (hk u v t)
    _ = _ := lintegral_mul_const_mul_add h1 (measurable_diffNearMajorant n α) hC _

/-- **Absolute convergence of the difference operator**: if `x` is such that the near and far
convolutions of `|f|` with the majorants are finite, then `t ↦ f(x - t) k_{u,v}(t)` is
integrable for all `u, v`. -/
theorem IsHomogeneousCZKernel.integrable_modulatedDiff_integrand (hΩ : IsHomogeneousCZKernel n Ω)
    {α : ℝ} (hα : 0 < α) {f : Rn n → ℂ} (hf : AEStronglyMeasurable f) {x : Rn n}
    (hnear : ∫⁻ t, ‖f (x - t)‖ₑ * diffNearMajorant n α t ≠ ∞)
    (hfar : ∫⁻ t, ‖f (x - t)‖ₑ * diffFarMajorant n t ≠ ∞) (u v : ℝ) :
    Integrable (fun t => f (x - t) * modulatedDiffKernel n α Ω u v t) := by
  obtain ⟨C, hC, hb⟩ := hΩ.lintegral_enorm_modulatedDiff_integrand_le hα
  refine ⟨(hf.comp_measurePreserving (Measure.measurePreserving_sub_left volume x)).mul
    (hΩ.measurable_modulatedDiffKernel α u v).aestronglyMeasurable, ?_⟩
  refine lt_of_le_of_lt (hb u v f hf x) ?_
  exact ENNReal.mul_lt_top hC.lt_top (ENNReal.add_lt_top.2
    ⟨ENNReal.mul_lt_top ENNReal.ofReal_lt_top hnear.lt_top, hfar.lt_top⟩)

/-- For `f ∈ L^p`, `1 < p`, the integral defining `(𝓗^{(u)} - 𝓗^{(v)}) f(x)` converges
absolutely for almost every `x`, simultaneously for all `u, v`. -/
theorem IsHomogeneousCZKernel.ae_integrable_modulatedDiff_integrand
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) :
    ∀ᵐ x, ∀ u v, Integrable (fun t => f (x - t) * modulatedDiffKernel n α Ω u v t) := by
  filter_upwards [ae_lintegral_enorm_sub_mul_diffNearMajorant_ne_top hn hα hp.le hf] with x hx
  exact hΩ.integrable_modulatedDiff_integrand hα hf.aestronglyMeasurable hx
    (lintegral_enorm_sub_mul_diffFarMajorant_ne_top hn hp hf x)

/-- **Size bound for the difference operator**:
`|(𝓗^{(u)} - 𝓗^{(v)}) f(x)| ≤ C (|u - v| ∫ |f(x - t)| 𝟙_{|t|≤1}|t|^{α-n} dt +
∫ |f(x - t)| (1 + |t|)^{-n} dt)`. -/
theorem IsHomogeneousCZKernel.enorm_modulatedDiff_le (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ}
    (hα : 0 < α) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (u v : ℝ) (f : Rn n → ℂ), AEStronglyMeasurable f → ∀ x,
      ‖modulatedDiff n α Ω u v f x‖ₑ ≤
        C * (ENNReal.ofReal |u - v| * (∫⁻ t, ‖f (x - t)‖ₑ * diffNearMajorant n α t) +
          ∫⁻ t, ‖f (x - t)‖ₑ * diffFarMajorant n t) := by
  obtain ⟨C, hC, hb⟩ := hΩ.lintegral_enorm_modulatedDiff_integrand_le hα
  exact ⟨C, hC, fun u v f hf x => (enorm_integral_le_lintegral_enorm _).trans (hb u v f hf x)⟩

/-- Linearity of the difference operator at a point of absolute convergence. -/
theorem modulatedDiff_sub {α : ℝ} {u v : ℝ} {f g : Rn n → ℂ} {x : Rn n}
    (hf : Integrable (fun t => f (x - t) * modulatedDiffKernel n α Ω u v t))
    (hg : Integrable (fun t => g (x - t) * modulatedDiffKernel n α Ω u v t)) :
    modulatedDiff n α Ω u v (f - g) x =
      modulatedDiff n α Ω u v f x - modulatedDiff n α Ω u v g x := by
  unfold modulatedDiff
  rw [← integral_sub hf hg]
  congr 1; funext t; simp only [Pi.sub_apply]; ring

/-- Additivity of the difference operator at a point of absolute convergence. -/
theorem modulatedDiff_add {α : ℝ} {u v : ℝ} {f g : Rn n → ℂ} {x : Rn n}
    (hf : Integrable (fun t => f (x - t) * modulatedDiffKernel n α Ω u v t))
    (hg : Integrable (fun t => g (x - t) * modulatedDiffKernel n α Ω u v t)) :
    modulatedDiff n α Ω u v (f + g) x =
      modulatedDiff n α Ω u v f x + modulatedDiff n α Ω u v g x := by
  unfold modulatedDiff
  rw [← integral_add hf hg]
  congr 1; funext t; simp only [Pi.add_apply]; ring

/-- For Schwartz functions the difference operator is the difference of the principal values:
`(𝓗^{(u)} - 𝓗^{(v)}) f(x) = 𝓗^{(u)} f(x) - 𝓗^{(v)} f(x)`. -/
theorem IsHomogeneousCZKernel.modulatedDiff_eq_sub (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u v : ℝ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    modulatedDiff n α Ω u v f x = modulatedSI n α Ω u f x - modulatedSI n α Ω v f x := by
  rw [hΩ.modulatedSI_eq_integral hn hα, hΩ.modulatedSI_eq_integral hn hα,
    ← integral_sub (hΩ.integrable_pvIntegrand hn hα u f x) (hΩ.integrable_pvIntegrand hn hα v f x)]
  unfold modulatedDiff
  congr 1; funext t
  simp only [pvIntegrand, modulatedDiffKernel]
  ring

/-- **Measurability of the difference operator**: for a.e. strongly measurable `f`,
`x ↦ (𝓗^{(u)} - 𝓗^{(v)}) f(x)` is strongly measurable (it coincides everywhere with the
operator applied to a measurable modification of `f`). -/
theorem IsHomogeneousCZKernel.stronglyMeasurable_modulatedDiff
    (hΩ : IsHomogeneousCZKernel n Ω) (α u v : ℝ) {f : Rn n → ℂ} (hf : AEStronglyMeasurable f) :
    StronglyMeasurable (modulatedDiff n α Ω u v f) := by
  have heq : modulatedDiff n α Ω u v f = modulatedDiff n α Ω u v (hf.mk f) := by
    funext x
    refine integral_congr_ae ?_
    have := (Measure.measurePreserving_sub_left volume x).quasiMeasurePreserving.ae_eq_comp
      hf.ae_eq_mk
    filter_upwards [this] with t ht
    simp only [Function.comp] at ht
    rw [ht]
  rw [heq]
  refine StronglyMeasurable.integral_prod_right (f := fun x t => hf.mk f (x - t) *
    modulatedDiffKernel n α Ω u v t) ?_
  exact (hf.stronglyMeasurable_mk.comp_measurable measurable_sub).mul
    ((hΩ.measurable_modulatedDiffKernel α u v).comp measurable_snd).stronglyMeasurable

end DifferenceOperators

section DifferenceOperatorsLimits

open scoped SchwartzMap

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- **Continuity of the difference operators in `f`**: if `g_m → f` in `L^p`, `1 < p`, then
along a subsequence `(𝓗^{(u)} - 𝓗^{(v)}) g_{φ(k)}(x) → (𝓗^{(u)} - 𝓗^{(v)}) f(x)` for almost every
`x`, simultaneously for all `u, v ∈ ℝ`. (The near part is controlled by Young's inequality and
Borel–Cantelli along a fast subsequence, the far part by Hölder's inequality, uniformly in `x`.) -/
theorem IsHomogeneousCZKernel.exists_subseq_tendsto_modulatedDiff
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) {g : ℕ → Rn n → ℂ}
    (hg : ∀ m, MemLp (g m) (ENNReal.ofReal p))
    (hconv : Tendsto (fun m => eLpNorm (g m - f) (ENNReal.ofReal p)) atTop (𝓝 0)) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ᵐ x, ∀ u v, Tendsto (fun k => modulatedDiff n α Ω u v (g (φ k)) x)
      atTop (𝓝 (modulatedDiff n α Ω u v f x)) := by
  have hp0 : 0 < p := by linarith
  have hh : ∀ m, AEStronglyMeasurable (g m - f) := fun m =>
    (hg m).aestronglyMeasurable.sub hf.aestronglyMeasurable
  set Nn := ∫⁻ t, diffNearMajorant n α t
  have hNn : Nn ^ p ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hp0.le (lintegral_diffNearMajorant_ne_top hn hα)
  set Y : ℕ → Rn n → ℝ≥0∞ := fun m x => ∫⁻ t, ‖(g m - f) (x - t)‖ₑ * diffNearMajorant n α t
  have hYm : ∀ m, Measurable (Y m) := fun m =>
    measurable_lintegral_enorm_sub_mul (hh m) (measurable_diffNearMajorant n α)
  have hY : ∀ m, ∫⁻ x, Y m x ^ p ≤ Nn ^ p * eLpNorm (g m - f) (ENNReal.ofReal p) ^ p := by
    intro m
    rw [eLpNorm_ofReal_rpow_eq_lintegral (hh m) hp0]
    exact lintegral_rpow_lintegral_enorm_sub_mul_le (hh m) (measurable_diffNearMajorant n α) hp.le
  have hB : Tendsto (fun m => Nn ^ p * eLpNorm (g m - f) (ENNReal.ofReal p) ^ p) atTop (𝓝 0) := by
    have h1 := ((ENNReal.continuous_rpow_const (y := p)).tendsto 0).comp hconv
    rw [ENNReal.zero_rpow_of_pos hp0] at h1
    simpa using ENNReal.Tendsto.const_mul h1 (Or.inr hNn)
  have hev : ∀ k : ℕ, ∀ᶠ m in atTop,
      Nn ^ p * eLpNorm (g m - f) (ENNReal.ofReal p) ^ p ≤ (2⁻¹ : ℝ≥0∞) ^ k := fun k =>
    hB.eventually (Iic_mem_nhds (ENNReal.pow_pos (by norm_num) k))
  obtain ⟨φ, hφ, hφk⟩ := Filter.extraction_forall_of_eventually hev
  refine ⟨φ, hφ, ?_⟩
  -- the near parts tend to `0` almost everywhere
  have hsum : ∫⁻ x, ∑' k, Y (φ k) x ^ p ≠ ∞ := by
    rw [lintegral_tsum fun k => ((hYm (φ k)).pow_const p).aemeasurable]
    refine ne_top_of_le_ne_top (b := ∑' k : ℕ, (2⁻¹ : ℝ≥0∞) ^ k) ?_
      (ENNReal.tsum_le_tsum fun k => (hY (φ k)).trans (hφk k))
    rw [ENNReal.tsum_geometric]
    simp
  have hae1 : ∀ᵐ x, Tendsto (fun k => Y (φ k) x) atTop (𝓝 0) := by
    filter_upwards [ae_lt_top' (Measurable.tsum fun k =>
      (hYm (φ k)).pow_const p).aemeasurable hsum] with x hx
    have h1 := ENNReal.tendsto_atTop_zero_of_tsum_ne_top hx.ne
    have h2 := ((ENNReal.continuous_rpow_const (y := 1 / p)).tendsto 0).comp h1
    rw [ENNReal.zero_rpow_of_pos (by positivity)] at h2
    refine h2.congr fun k => ?_
    simp only [Function.comp_apply, rpow_rpow_one_div hp0.ne']
  have hae2 : ∀ᵐ x, ∀ m, ∫⁻ t, ‖g m (x - t)‖ₑ * diffNearMajorant n α t ≠ ∞ :=
    ae_all_iff.2 fun m => ae_lintegral_enorm_sub_mul_diffNearMajorant_ne_top hn hα hp.le (hg m)
  have hae3 := ae_lintegral_enorm_sub_mul_diffNearMajorant_ne_top hn hα hp.le hf
  obtain ⟨C, hC, hbd⟩ := hΩ.enorm_modulatedDiff_le hα
  set W := (∫⁻ t, diffFarMajorant n t ^ p.conjExponent) ^ (1 / p.conjExponent)
  have hW : W ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by
    have := (Real.HolderConjugate.conjExponent hp).symm.lt; positivity)
    (lintegral_diffFarMajorant_rpow_ne_top hn (Real.HolderConjugate.conjExponent hp).symm.lt)
  have hconvφ := hconv.comp hφ.tendsto_atTop
  filter_upwards [hae1, hae2, hae3] with x h1 h2 h3
  intro u v
  have hdiff : ∀ k, modulatedDiff n α Ω u v (g (φ k)) x - modulatedDiff n α Ω u v f x =
      modulatedDiff n α Ω u v (g (φ k) - f) x := fun k =>
    (modulatedDiff_sub (hΩ.integrable_modulatedDiff_integrand hα (hg _).aestronglyMeasurable
      (h2 _) (lintegral_enorm_sub_mul_diffFarMajorant_ne_top hn hp (hg _) x) u v)
      (hΩ.integrable_modulatedDiff_integrand hα hf.aestronglyMeasurable h3
        (lintegral_enorm_sub_mul_diffFarMajorant_ne_top hn hp hf x) u v)).symm
  rw [tendsto_iff_edist_tendsto_0]
  simp_rw [edist_eq_enorm_sub, hdiff]
  have hlim : Tendsto (fun k => C * (ENNReal.ofReal |u - v| * Y (φ k) x +
      eLpNorm (g (φ k) - f) (ENNReal.ofReal p) * W)) atTop
        (𝓝 (C * (ENNReal.ofReal |u - v| * 0 + 0 * W))) := by
    refine ENNReal.Tendsto.const_mul (Tendsto.add (ENNReal.Tendsto.const_mul h1
      (Or.inr ENNReal.ofReal_ne_top)) (ENNReal.Tendsto.mul_const hconvφ (Or.inr hW)))
      (Or.inr hC)
  simp only [mul_zero, zero_mul, add_zero] at hlim
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun k => zero_le)
    fun k => ?_
  refine (hbd u v _ (hh (φ k)) x).trans (mul_le_mul' le_rfl (add_le_add le_rfl ?_))
  exact lintegral_enorm_sub_mul_diffFarMajorant_le hp (hh (φ k)) x

/-- Subtracting a constant does not change the variation norm. -/
theorem variationNorm_sub_const (r : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) (c : ℂ) :
    variationNorm r 𝒥 (fun u => a u - c) = variationNorm r 𝒥 a := by
  simp [variationNorm, sub_sub_sub_cancel_right]

/-- Subtracting a constant does not change the jump function. -/
theorem jumpFunction_sub_const (lam : ℝ) (𝒥 : Set ℝ) (a : ℝ → ℂ) (c : ℂ) :
    jumpFunction lam 𝒥 (fun u => a u - c) = jumpFunction lam 𝒥 a := by
  simp [jumpFunction, sub_sub_sub_cancel_right]

/-- Subtracting a constant does not change the short variation. -/
theorem shortVariation_sub_const (r α : ℝ) (a : ℝ → ℂ) (c : ℂ) :
    shortVariation r α (fun u => a u - c) = shortVariation r α a := by
  simp [shortVariation, variationNorm_sub_const]

/-- **Shift invariance**: for Schwartz `f`, the variation norm of `u ↦ 𝓗^{(u)} f(x)` equals that of
`u ↦ (𝓗^{(u)} - 𝓗^{(v)}) f(x)`, for every fixed `v`. -/
theorem IsHomogeneousCZKernel.variationNorm_modulatedDiff (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (r : ℝ) (𝒥 : Set ℝ) (v : ℝ) (f : 𝓢(Rn n, ℂ))
    (x : Rn n) :
    variationNorm r 𝒥 (fun u => modulatedDiff n α Ω u v f x) =
      variationNorm r 𝒥 (fun u => modulatedSI n α Ω u f x) := by
  simp_rw [hΩ.modulatedDiff_eq_sub hn hα]
  exact variationNorm_sub_const r 𝒥 _ _

/-- **Shift invariance** of the jump function (as in `variationNorm_modulatedDiff`). -/
theorem IsHomogeneousCZKernel.jumpFunction_modulatedDiff (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (lam : ℝ) (𝒥 : Set ℝ) (v : ℝ) (f : 𝓢(Rn n, ℂ))
    (x : Rn n) :
    jumpFunction lam 𝒥 (fun u => modulatedDiff n α Ω u v f x) =
      jumpFunction lam 𝒥 (fun u => modulatedSI n α Ω u f x) := by
  simp_rw [hΩ.modulatedDiff_eq_sub hn hα]
  exact jumpFunction_sub_const lam 𝒥 _ _

/-- **Shift invariance** of the short variation (as in `variationNorm_modulatedDiff`). -/
theorem IsHomogeneousCZKernel.shortVariation_modulatedDiff (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (r : ℝ) (v : ℝ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    shortVariation r α (fun u => modulatedDiff n α Ω u v f x) =
      shortVariation r α (fun u => modulatedSI n α Ω u f x) := by
  simp_rw [hΩ.modulatedDiff_eq_sub hn hα]
  exact shortVariation_sub_const r α _ _

/-- A monotone continuous map `F` of `[0, ∞]` preserves lower bounds by `liminf`. -/
theorem le_liminf_comp_of_le_liminf {F : ℝ≥0∞ → ℝ≥0∞} (hF : Monotone F) (hFc : Continuous F)
    {y : ℝ≥0∞} {x : ℕ → ℝ≥0∞} (h : y ≤ liminf x atTop) :
    F y ≤ liminf (fun m => F (x m)) atTop :=
  (hF h).trans (hF.map_liminf_of_continuousAt x hFc.continuousAt).le

/-- **Lower semicontinuity of the variation norm** under pointwise convergence on `𝒥`. -/
theorem variationNorm_le_liminf {r : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ}
    {b : ℕ → ℝ → ℂ} (h : ∀ u ∈ 𝒥, Tendsto (fun m => b m u) atTop (𝓝 (a u))) :
    variationNorm r 𝒥 a ≤ liminf (fun m => variationNorm r 𝒥 (b m)) atTop := by
  refine variationNorm_le fun J u hu hm => ?_
  have hlim : Tendsto (fun m => (∑ i : Fin J, ‖b m (u i.succ) - b m (u i.castSucc)‖ₑ ^ r) ^ (1 / r))
      atTop (𝓝 ((∑ i : Fin J, ‖a (u i.succ) - a (u i.castSucc)‖ₑ ^ r) ^ (1 / r))) := by
    refine (ENNReal.continuous_rpow_const.tendsto _).comp (tendsto_finsetSum _ fun i _ => ?_)
    exact (ENNReal.continuous_rpow_const.tendsto _).comp ((continuous_enorm.tendsto _).comp
      ((h _ (hm _)).sub (h _ (hm _))))
  rw [← hlim.liminf_eq]
  exact liminf_le_liminf (Eventually.of_forall fun m => le_variationNorm hu hm)

/-- **Lower semicontinuity of the jump function** under pointwise convergence on `𝒥`. -/
theorem jumpFunction_le_liminf {lam : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ} {b : ℕ → ℝ → ℂ}
    (h : ∀ u ∈ 𝒥, Tendsto (fun m => b m u) atTop (𝓝 (a u))) :
    jumpFunction lam 𝒥 a ≤ liminf (fun m => jumpFunction lam 𝒥 (b m)) atTop := by
  refine jumpFunction_le fun N s t h1 h2 h3 h4 => ?_
  have hev : ∀ᶠ m in atTop, ∀ i, lam < ‖b m (t i) - b m (s i)‖ := by
    refine Filter.eventually_all.2 fun i => ?_
    exact ((continuous_norm.tendsto _).comp ((h _ (h3 i).2).sub (h _ (h3 i).1))).eventually
      (lt_mem_nhds (h4 i))
  refine le_liminf_of_le (by isBoundedDefault) ?_
  filter_upwards [hev] with m hm
  exact natCast_le_jumpFunction h1 h2 h3 hm

/-- Fatou's lemma for sums over `ℤ`: `∑_j liminf_m c_{j,m} ≤ liminf_m ∑_j c_{j,m}`. -/
theorem tsum_liminf_le_liminf_tsum (c : ℤ → ℕ → ℝ≥0∞) :
    ∑' j, liminf (fun m => c j m) atTop ≤ liminf (fun m => ∑' j, c j m) atTop := by
  have h := lintegral_liminf_le' (μ := Measure.count) (f := fun m j => c j m) (u := atTop)
    (fun m => (measurable_of_countable _).aemeasurable)
  simpa only [lintegral_count] using h

/-- **Lower semicontinuity of the short variation** under pointwise convergence (`r > 0`). -/
theorem shortVariation_le_liminf {r : ℝ} (hr : 0 < r) (α : ℝ) {a : ℝ → ℂ} {b : ℕ → ℝ → ℂ}
    (h : ∀ u, Tendsto (fun m => b m u) atTop (𝓝 (a u))) :
    shortVariation r α a ≤ liminf (fun m => shortVariation r α (b m)) atTop := by
  have hmono : ∀ {s : ℝ}, 0 ≤ s → Monotone fun y : ℝ≥0∞ => y ^ s := fun hs _ _ hxy =>
    ENNReal.rpow_le_rpow hxy hs
  refine le_liminf_comp_of_le_liminf (F := fun y => y ^ (1 / r)) (hmono (by positivity))
    ENNReal.continuous_rpow_const ?_
  refine le_trans ?_ (tsum_liminf_le_liminf_tsum _)
  refine ENNReal.tsum_le_tsum fun j => ?_
  exact le_liminf_comp_of_le_liminf (F := fun y => y ^ r) (hmono hr.le)
    ENNReal.continuous_rpow_const (variationNorm_le_liminf fun u _ => h u)

/-- **Density extension** (Fatou's lemma and density of Schwartz functions in `L^p`): let
`Φ(f)(x) ∈ [0, ∞]` be a functional such that `‖Φ(g)‖_p ≤ C ‖g‖_p` for Schwartz `g` (with `Φ(g)`
a.e. measurable), and such that whenever Schwartz functions `g_m → f` in `L^p`, along a
subsequence `Φ(f)(x) ≤ liminf_k Φ(g_{φ(k)})(x)` for almost every `x`. Then
`‖Φ(f)‖_p ≤ C ‖f‖_p` (`1 ≤ p < ∞`, `C < ∞`). -/
theorem eLpNorm_le_of_forall_schwartz {p : ℝ} (hp : 1 ≤ p)
    (Φ : (Rn n → ℂ) → Rn n → ℝ≥0∞) {C : ℝ≥0∞} (hC : C ≠ ∞)
    (hmeas : ∀ g : 𝓢(Rn n, ℂ), AEMeasurable (Φ g))
    (hbound : ∀ g : 𝓢(Rn n, ℂ), eLpNorm (Φ g) (ENNReal.ofReal p) ≤ C * eLpNorm g (ENNReal.ofReal p))
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) (hmeasf : AEMeasurable (Φ f))
    (hlsc : ∀ g : ℕ → 𝓢(Rn n, ℂ),
      Tendsto (fun m => eLpNorm (⇑(g m) - f) (ENNReal.ofReal p)) atTop (𝓝 0) →
      ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ᵐ x, Φ f x ≤ liminf (fun k => Φ (g (φ k)) x) atTop) :
    eLpNorm (Φ f) (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  have hp0 : 0 < p := by linarith
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using hp
  -- Schwartz approximations
  have happrox : ∀ m : ℕ, ∃ g : 𝓢(Rn n, ℂ),
      eLpNorm (f - ⇑g) (ENNReal.ofReal p) ≤ ENNReal.ofReal (1 / ((m : ℝ) + 1)) := by
    intro m
    obtain ⟨g, hg₁, hg₂, hg₃⟩ := MemLp.exist_eLpNorm_sub_le ENNReal.ofReal_ne_top hp1 hf
      (ε := 1 / ((m : ℝ) + 1)) (by positivity)
    exact ⟨hg₁.toSchwartzMap hg₂, hg₃⟩
  choose g hg using happrox
  have hconv : Tendsto (fun m => eLpNorm (⇑(g m) - f) (ENNReal.ofReal p)) atTop (𝓝 0) := by
    have h0 : Tendsto (fun m : ℕ => ENNReal.ofReal (1 / ((m : ℝ) + 1))) atTop (𝓝 0) := by
      simpa using ENNReal.tendsto_ofReal tendsto_one_div_add_atTop_nhds_zero_nat
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h0 (fun m => zero_le)
      fun m => ?_
    rw [eLpNorm_sub_comm]; exact hg m
  obtain ⟨φ, hφ, hae⟩ := hlsc g hconv
  have hconvφ : Tendsto (fun k => eLpNorm (⇑(g (φ k)) - f) (ENNReal.ofReal p)) atTop (𝓝 0) :=
    hconv.comp hφ.tendsto_atTop
  have hp0' : ENNReal.ofReal p ≠ 0 := by simpa using hp0
  have hnorm : ∀ h : Rn n → ℝ≥0∞, AEMeasurable h →
      eLpNorm h (ENNReal.ofReal p) = (∫⁻ x, h x ^ p) ^ (1 / p) := by
    intro h hh
    rw [eLpNorm_eq_eLpNorm' hp0' ENNReal.ofReal_ne_top hh.aestronglyMeasurable,
      eLpNorm'_eq_lintegral_enorm, ENNReal.toReal_ofReal hp0.le]
    simp only [enorm_eq_self]
  -- bounds for the approximants
  have hgφ : ∀ k, ∫⁻ x, Φ (g (φ k)) x ^ p ≤
      (C * (eLpNorm f (ENNReal.ofReal p) + eLpNorm (⇑(g (φ k)) - f) (ENNReal.ofReal p))) ^ p := by
    intro k
    have h1 := hbound (g (φ k))
    rw [hnorm _ (hmeas _)] at h1
    have h2 : eLpNorm (⇑(g (φ k))) (ENNReal.ofReal p) ≤
        eLpNorm f (ENNReal.ofReal p) + eLpNorm (⇑(g (φ k)) - f) (ENNReal.ofReal p) := by
      calc eLpNorm (⇑(g (φ k))) (ENNReal.ofReal p)
          = eLpNorm (f + (⇑(g (φ k)) - f)) (ENNReal.ofReal p) := by rw [add_sub_cancel]
        _ ≤ _ := eLpNorm_add_le hp1
    calc ∫⁻ x, Φ (g (φ k)) x ^ p = ((∫⁻ x, Φ (g (φ k)) x ^ p) ^ (1 / p)) ^ p :=
          (rpow_one_div_rpow hp0.ne' _).symm
      _ ≤ _ := ENNReal.rpow_le_rpow (h1.trans (mul_le_mul' le_rfl h2)) hp0.le
  have hlimB : Tendsto (fun k => (C * (eLpNorm f (ENNReal.ofReal p) +
      eLpNorm (⇑(g (φ k)) - f) (ENNReal.ofReal p))) ^ p) atTop
        (𝓝 ((C * (eLpNorm f (ENNReal.ofReal p) + 0)) ^ p)) :=
    (ENNReal.continuous_rpow_const.tendsto _).comp
      (ENNReal.Tendsto.const_mul (tendsto_const_nhds.add hconvφ) (Or.inr hC))
  rw [add_zero] at hlimB
  have hmono : Monotone fun y : ℝ≥0∞ => y ^ p := fun _ _ hxy => ENNReal.rpow_le_rpow hxy hp0.le
  have s1 : ∫⁻ x, Φ f x ^ p ≤ ∫⁻ x, liminf (fun k => Φ (g (φ k)) x ^ p) atTop := by
    refine lintegral_mono_ae ?_
    filter_upwards [hae] with x hx
    exact le_liminf_comp_of_le_liminf (F := fun y => y ^ p) hmono ENNReal.continuous_rpow_const hx
  have s2 : ∫⁻ x, liminf (fun k => Φ (g (φ k)) x ^ p) atTop ≤
      liminf (fun k => ∫⁻ x, Φ (g (φ k)) x ^ p) atTop :=
    lintegral_liminf_le' fun k => (hmeas _).pow_const p
  have s3 : liminf (fun k => ∫⁻ x, Φ (g (φ k)) x ^ p) atTop ≤
      liminf (fun k => (C * (eLpNorm f (ENNReal.ofReal p) +
        eLpNorm (⇑(g (φ k)) - f) (ENNReal.ofReal p))) ^ p) atTop :=
    liminf_le_liminf (Eventually.of_forall hgφ)
  have hmain : ∫⁻ x, Φ f x ^ p ≤ (C * eLpNorm f (ENNReal.ofReal p)) ^ p :=
    s1.trans (s2.trans (s3.trans_eq hlimB.liminf_eq))
  rw [hnorm _ hmeasf]
  have h1 := ENNReal.rpow_le_rpow hmain (z := 1 / p) (by positivity)
  exact h1.trans_eq (rpow_rpow_one_div hp0.ne' _)

/-- **Continuity in `u`**: at a point `x` where the majorant convolutions of `|f|` are finite,
`u ↦ (𝓗^{(u)} - 𝓗^{(v)}) f(x)` is continuous (dominated convergence, locally uniformly in `u`). -/
theorem IsHomogeneousCZKernel.continuous_modulatedDiff (hΩ : IsHomogeneousCZKernel n Ω)
    {α : ℝ} (hα : 0 < α) {f : Rn n → ℂ} (hf : AEStronglyMeasurable f) {x : Rn n}
    (hnear : ∫⁻ t, ‖f (x - t)‖ₑ * diffNearMajorant n α t ≠ ∞)
    (hfar : ∫⁻ t, ‖f (x - t)‖ₑ * diffFarMajorant n t ≠ ∞) (v : ℝ) :
    Continuous fun u => modulatedDiff n α Ω u v f x := by
  obtain ⟨C, hC, hk⟩ := hΩ.exists_enorm_modulatedDiffKernel_le hα
  have hfx := hf.comp_measurePreserving (Measure.measurePreserving_sub_left volume x)
  have h1 : AEMeasurable (fun t => ‖f (x - t)‖ₑ) := hfx.enorm
  rw [continuous_iff_continuousAt]
  intro u₀
  set b : Rn n → ℝ≥0∞ := fun t => ‖f (x - t)‖ₑ * (C * (ENNReal.ofReal (|u₀ - v| + 1) *
    diffNearMajorant n α t + diffFarMajorant n t)) with hb
  have hbm : AEMeasurable b := h1.mul (((measurable_const.mul
    (measurable_diffNearMajorant n α)).add (measurable_diffFarMajorant n)).const_mul C).aemeasurable
  have hbfin : ∫⁻ t, b t ≠ ∞ := by
    rw [hb, lintegral_mul_const_mul_add h1 (measurable_diffNearMajorant n α) hC]
    exact ENNReal.mul_ne_top hC (ENNReal.add_ne_top.2
      ⟨ENNReal.mul_ne_top ENNReal.ofReal_ne_top hnear, hfar⟩)
  refine continuousAt_of_dominated (bound := fun t => (b t).toReal) ?_ ?_
    (integrable_toReal_of_lintegral_ne_top hbm hbfin) ?_
  · exact Eventually.of_forall fun u =>
      hfx.mul (hΩ.measurable_modulatedDiffKernel α u v).aestronglyMeasurable
  · filter_upwards [Metric.ball_mem_nhds u₀ one_pos] with u hu
    filter_upwards [ae_lt_top' hbm hbfin] with t ht
    rw [← toReal_enorm]
    refine ENNReal.toReal_mono ht.ne ?_
    rw [enorm_mul]
    refine mul_le_mul' le_rfl ((hk u v t).trans (mul_le_mul' le_rfl (add_le_add
      (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl) le_rfl)))
    have : |u - u₀| < 1 := by rw [← Real.dist_eq]; exact hu
    calc |u - v| = |(u - u₀) + (u₀ - v)| := by ring_nf
      _ ≤ |u - u₀| + |u₀ - v| := abs_add_le _ _
      _ ≤ _ := by linarith
  · refine Eventually.of_forall fun t => Continuous.continuousAt ?_
    unfold modulatedDiffKernel
    fun_prop

/-- For `f ∈ L^p`, `1 < p`, almost every `x` has `u ↦ (𝓗^{(u)} - 𝓗^{(v)}) f(x)` continuous for
every `v`. -/
theorem IsHomogeneousCZKernel.ae_continuous_modulatedDiff (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p) {f : Rn n → ℂ}
    (hf : MemLp f (ENNReal.ofReal p)) :
    ∀ᵐ x, ∀ v, Continuous fun u => modulatedDiff n α Ω u v f x := by
  filter_upwards [ae_lintegral_enorm_sub_mul_diffNearMajorant_ne_top hn hα hp.le hf] with x hx
  exact hΩ.continuous_modulatedDiff hα hf.aestronglyMeasurable hx
    (lintegral_enorm_sub_mul_diffFarMajorant_ne_top hn hp hf x)

/-- A functional `Ψ` that is measurable on families continuous in `u` (for every `x`) is
a.e. measurable on families continuous in `u` for almost every `x`. -/
theorem aemeasurable_comp_of_ae_continuous {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {A : X → ℝ → ℂ} (hA : ∀ u, Measurable fun x => A x u) (hc : ∀ᵐ x ∂μ, Continuous (A x))
    (Ψ : (ℝ → ℂ) → ℝ≥0∞)
    (hΨ : ∀ B : X → ℝ → ℂ, (∀ u, Measurable fun x => B x u) → (∀ x, Continuous (B x)) →
      Measurable fun x => Ψ (B x)) :
    AEMeasurable (fun x => Ψ (A x)) μ := by
  classical
  set N := toMeasurable μ {x | ¬ Continuous (A x)}
  have hN : μ N = 0 := by rw [measure_toMeasurable]; exact ae_iff.1 hc
  set B : X → ℝ → ℂ := fun x u => if x ∈ N then 0 else A x u
  have hBm : ∀ u, Measurable fun x => B x u := fun u =>
    Measurable.ite (measurableSet_toMeasurable _ _) measurable_const (hA u)
  have hBc : ∀ x, Continuous (B x) := by
    intro x
    by_cases hx : x ∈ N
    · simp only [B, hx, ite_true]; exact continuous_const
    · simp only [B, hx, ite_false]
      by_contra h
      exact hx (subset_toMeasurable _ _ h)
  refine (hΨ B hBm hBc).aemeasurable.congr ?_
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 hN] with x hx
  simp only [B, hx, ite_false]

/-- Measurability of `x ↦ N_λ{(𝓗^{(u)} - 𝓗^{(v)}) f(x) : u ∈ 𝒥}` for `f ∈ L^p`, `1 < p`, when
`𝒥` is countable or contained in the closure of its rational points. -/
theorem IsHomogeneousCZKernel.aemeasurable_jumpFunction_modulatedDiff
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) (lam : ℝ) {𝒥 : Set ℝ}
    (h𝒥 : 𝒥.Countable ∨ 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) (v : ℝ) :
    AEMeasurable fun x => jumpFunction lam 𝒥 (fun u => modulatedDiff n α Ω u v f x) := by
  have hA : ∀ u, Measurable fun x => modulatedDiff n α Ω u v f x := fun u =>
    (hΩ.stronglyMeasurable_modulatedDiff α u v hf.aestronglyMeasurable).measurable
  rcases h𝒥 with h | h
  · exact (measurable_jumpFunction_of_countable (A := fun x u => modulatedDiff n α Ω u v f x)
      hA lam h).aemeasurable
  · exact aemeasurable_comp_of_ae_continuous (A := fun x u => modulatedDiff n α Ω u v f x) hA
      ((hΩ.ae_continuous_modulatedDiff hn hα hp hf).mono fun x hx => hx v) (jumpFunction lam 𝒥)
      fun B hB hBc => measurable_jumpFunction_of_ratCast hB hBc lam h

/-- Measurability of `x ↦ V^r{(𝓗^{(u)} - 𝓗^{(v)}) f(x) : u ∈ 𝒥}` for `f ∈ L^p`, `1 < p`, when
`𝒥` is countable or contained in the closure of its rational points. -/
theorem IsHomogeneousCZKernel.aemeasurable_variationNorm_modulatedDiff
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) (r : ℝ) {𝒥 : Set ℝ}
    (h𝒥 : 𝒥.Countable ∨ 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) (v : ℝ) :
    AEMeasurable fun x => variationNorm r 𝒥 (fun u => modulatedDiff n α Ω u v f x) := by
  have hA : ∀ u, Measurable fun x => modulatedDiff n α Ω u v f x := fun u =>
    (hΩ.stronglyMeasurable_modulatedDiff α u v hf.aestronglyMeasurable).measurable
  rcases h𝒥 with h | h
  · exact (measurable_variationNorm_of_countable (A := fun x u => modulatedDiff n α Ω u v f x)
      hA r h).aemeasurable
  · exact aemeasurable_comp_of_ae_continuous (A := fun x u => modulatedDiff n α Ω u v f x) hA
      ((hΩ.ae_continuous_modulatedDiff hn hα hp hf).mono fun x hx => hx v) (variationNorm r 𝒥)
      fun B hB hBc => measurable_variationNorm_of_ratCast hB hBc r h

/-- Measurability of the short variation `x ↦ S_r{(𝓗^{(u)} - 𝓗^{(v)}) f(x)}` for `f ∈ L^p`,
`1 < p`. -/
theorem IsHomogeneousCZKernel.aemeasurable_shortVariation_modulatedDiff
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) (r v : ℝ) :
    AEMeasurable fun x => shortVariation r α (fun u => modulatedDiff n α Ω u v f x) := by
  have hA : ∀ u, Measurable fun x => modulatedDiff n α Ω u v f x := fun u =>
    (hΩ.stronglyMeasurable_modulatedDiff α u v hf.aestronglyMeasurable).measurable
  exact aemeasurable_comp_of_ae_continuous (A := fun x u => modulatedDiff n α Ω u v f x) hA
    ((hΩ.ae_continuous_modulatedDiff hn hα hp hf).mono fun x hx => hx v) (shortVariation r α)
    fun B hB hBc => measurable_shortVariation hB hBc r hα

/-- **Extension of jump bounds to `L^p`**: if for every Schwartz `g`,
`‖λ √N_λ{𝓗^{(u)} g : u ∈ 𝒥}‖_p ≤ C ‖g‖_p`, then for every `f ∈ L^p` (`1 < p < ∞`) and every
`v`, `‖λ √N_λ{(𝓗^{(u)} - 𝓗^{(v)}) f : u ∈ 𝒥}‖_p ≤ C ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_jumpFunction_modulatedDiff_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    (lam : ℝ) {𝒥 : Set ℝ} (h𝒥 : 𝒥.Countable ∨ 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) (v : ℝ)
    {C : ℝ≥0∞} (hC : C ≠ ∞)
    (hmeas : ∀ g : 𝓢(Rn n, ℂ),
      AEMeasurable fun x => jumpFunction lam 𝒥 (fun u => modulatedSI n α Ω u g x))
    (hbound : ∀ g : 𝓢(Rn n, ℂ), eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (fun u => modulatedSI n α Ω u g x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) ≤
        C * eLpNorm g (ENNReal.ofReal p))
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) :
    eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (fun u => modulatedDiff n α Ω u v f x) ^ (1 / 2 : ℝ))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  have hF : Monotone fun y : ℝ≥0∞ => ENNReal.ofReal lam * y ^ (1 / 2 : ℝ) := fun _ _ hxy =>
    mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hxy (by norm_num))
  have hFc : Continuous fun y : ℝ≥0∞ => ENNReal.ofReal lam * y ^ (1 / 2 : ℝ) :=
    (ENNReal.continuous_const_mul ENNReal.ofReal_ne_top).comp ENNReal.continuous_rpow_const
  refine eLpNorm_le_of_forall_schwartz hp.le (fun h x => ENNReal.ofReal lam *
    jumpFunction lam 𝒥 (fun u => modulatedDiff n α Ω u v h x) ^ (1 / 2 : ℝ)) hC
    (fun g => ?_) (fun g => ?_) hf
    (((hΩ.aemeasurable_jumpFunction_modulatedDiff hn hα hp hf lam h𝒥 v).pow_const _).const_mul _)
    (fun g hg => ?_)
  · simp_rw [hΩ.jumpFunction_modulatedDiff hn hα]
    exact ((hmeas g).pow_const _).const_mul _
  · simp_rw [hΩ.jumpFunction_modulatedDiff hn hα]
    exact hbound g
  · obtain ⟨φ, hφ, hae⟩ := hΩ.exists_subseq_tendsto_modulatedDiff hn hα hp hf
      (fun m => (g m).memLp _) hg
    refine ⟨φ, hφ, ?_⟩
    filter_upwards [hae] with x hx
    exact le_liminf_comp_of_le_liminf hF hFc (jumpFunction_le_liminf fun u _ => hx u v)

/-- **Extension of variation bounds to `L^p`**: if `‖V^r{𝓗^{(u)} g : u ∈ 𝒥}‖_p ≤ C ‖g‖_p` for
Schwartz `g`, then `‖V^r{(𝓗^{(u)} - 𝓗^{(v)}) f : u ∈ 𝒥}‖_p ≤ C ‖f‖_p` for `f ∈ L^p`
(`1 < p < ∞`; `𝒥` countable or contained in the closure of its rational points). -/
theorem IsHomogeneousCZKernel.eLpNorm_variationNorm_modulatedDiff_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    {r : ℝ} {𝒥 : Set ℝ} (h𝒥 : 𝒥.Countable ∨ 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) (v : ℝ)
    {C : ℝ≥0∞} (hC : C ≠ ∞)
    (hmeas : ∀ g : 𝓢(Rn n, ℂ),
      AEMeasurable fun x => variationNorm r 𝒥 (fun u => modulatedSI n α Ω u g x))
    (hbound : ∀ g : 𝓢(Rn n, ℂ), eLpNorm (fun x =>
      variationNorm r 𝒥 (fun u => modulatedSI n α Ω u g x)) (ENNReal.ofReal p) ≤
        C * eLpNorm g (ENNReal.ofReal p))
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) :
    eLpNorm (fun x => variationNorm r 𝒥 (fun u => modulatedDiff n α Ω u v f x))
      (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  refine eLpNorm_le_of_forall_schwartz hp.le (fun h x =>
    variationNorm r 𝒥 (fun u => modulatedDiff n α Ω u v h x)) hC
    (fun g => ?_) (fun g => ?_) hf (hΩ.aemeasurable_variationNorm_modulatedDiff hn hα hp hf r h𝒥 v)
    (fun g hg => ?_)
  · simp_rw [hΩ.variationNorm_modulatedDiff hn hα]
    exact hmeas g
  · simp_rw [hΩ.variationNorm_modulatedDiff hn hα]
    exact hbound g
  · obtain ⟨φ, hφ, hae⟩ := hΩ.exists_subseq_tendsto_modulatedDiff hn hα hp hf
      (fun m => (g m).memLp _) hg
    refine ⟨φ, hφ, ?_⟩
    filter_upwards [hae] with x hx
    exact variationNorm_le_liminf fun u _ => hx u v

/-- **Extension of short-variation bounds to `L^p`**: if `‖S_r(𝓗 g)‖_p ≤ C ‖g‖_p` for Schwartz
`g`, then `‖S_r{(𝓗^{(u)} - 𝓗^{(v)}) f}‖_p ≤ C ‖f‖_p` for `f ∈ L^p` (`1 < p < ∞`, `r > 0`). -/
theorem IsHomogeneousCZKernel.eLpNorm_shortVariation_modulatedDiff_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    {r : ℝ} (hr : 0 < r) (v : ℝ) {C : ℝ≥0∞} (hC : C ≠ ∞)
    (hmeas : ∀ g : 𝓢(Rn n, ℂ),
      AEMeasurable fun x => shortVariation r α (fun u => modulatedSI n α Ω u g x))
    (hbound : ∀ g : 𝓢(Rn n, ℂ), eLpNorm (fun x =>
      shortVariation r α (fun u => modulatedSI n α Ω u g x)) (ENNReal.ofReal p) ≤
        C * eLpNorm g (ENNReal.ofReal p))
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) :
    eLpNorm (fun x => shortVariation r α (fun u => modulatedDiff n α Ω u v f x))
      (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  refine eLpNorm_le_of_forall_schwartz hp.le (fun h x =>
    shortVariation r α (fun u => modulatedDiff n α Ω u v h x)) hC
    (fun g => ?_) (fun g => ?_) hf (hΩ.aemeasurable_shortVariation_modulatedDiff hn hα hp hf r v)
    (fun g hg => ?_)
  · simp_rw [hΩ.shortVariation_modulatedDiff hn hα]
    exact hmeas g
  · simp_rw [hΩ.shortVariation_modulatedDiff hn hα]
    exact hbound g
  · obtain ⟨φ, hφ, hae⟩ := hΩ.exists_subseq_tendsto_modulatedDiff hn hα hp hf
      (fun m => (g m).memLp _) hg
    refine ⟨φ, hφ, ?_⟩
    filter_upwards [hae] with x hx
    exact shortVariation_le_liminf hr α fun u => hx u v

end DifferenceOperatorsLimits

/-! ## Bourgain's jump-to-variation argument

Jones–Seeger–Wright, Lemma 2.1 (cited in Section 1 of the paper after Lemma 1.3): uniform
`L^{p₀}` and `L^{p₁}` jump inequalities `‖λ √N_λ‖_{p_i} ≲ ‖f‖_{p_i}` imply `L^p` bounds for `V^r`
for every `r > 2` and `p₀ < p < p₁`. Pointwise, `(V^r)^r ≤ 2 · 2^r ∑_k 2^{kr} N_{2^k}`; this
gives weak type `(p_i, p_i)` for `V^r` (using `r > 2`), and the Marcinkiewicz interpolation
theorem gives strong type. -/

section JumpToVariation

/-- The jump function takes integer values: if `N_λ > 0` then `N_λ ≥ 1`. -/
theorem one_le_jumpFunction_of_pos {lam : ℝ} {𝒥 : Set ℝ} {a : ℝ → ℂ}
    (h : 0 < jumpFunction lam 𝒥 a) : 1 ≤ jumpFunction lam 𝒥 a := by
  unfold jumpFunction at h
  obtain ⟨N, hN⟩ := lt_iSup_iff.1 h
  obtain ⟨s, hs⟩ := lt_iSup_iff.1 hN
  obtain ⟨t, ht⟩ := lt_iSup_iff.1 hs
  obtain ⟨h1, h1'⟩ := lt_iSup_iff.1 ht
  obtain ⟨h2, h2'⟩ := lt_iSup_iff.1 h1'
  obtain ⟨h3, h3'⟩ := lt_iSup_iff.1 h2'
  obtain ⟨h4, h4'⟩ := lt_iSup_iff.1 h3'
  have hN1 : (1 : ℝ≥0∞) ≤ N := by exact_mod_cast Nat.one_le_iff_ne_zero.2 (by
    rintro rfl; simp at h4')
  exact hN1.trans (natCast_le_jumpFunction h1 h2 h3 h4)

/-- In a chain `u₀ < ⋯ < u_J` in `𝒥`, the number of increments of size `> λ` is at most
`2 N_λ` (the increments with even, resp. odd, index form strictly ordered jump families). -/
theorem card_filter_lt_le_two_mul_jumpFunction {𝒥 : Set ℝ} {b : ℝ → ℂ} {J : ℕ}
    {u : Fin (J + 1) → ℝ} (hu : StrictMono u) (hm : ∀ i, u i ∈ 𝒥) (lam : ℝ) :
    ((Finset.univ.filter fun i : Fin J => lam < ‖b (u i.succ) - b (u i.castSucc)‖).card :
      ℝ≥0∞) ≤ 2 * jumpFunction lam 𝒥 b := by
  classical
  set S := Finset.univ.filter fun i : Fin J => lam < ‖b (u i.succ) - b (u i.castSucc)‖
  have hpar : ∀ e : Prop, ∀ [Decidable e], ∀ i ∈ S.filter (fun i : Fin J => Even (i : ℕ) ↔ e),
      ∀ j ∈ S.filter (fun i : Fin J => Even (i : ℕ) ↔ e), i < j →
        u i.succ < u j.castSucc := by
    intro e _ i hi j hj hij
    simp only [Finset.mem_filter] at hi hj
    refine hu (Fin.lt_def.2 ?_)
    simp only [Fin.val_succ, Fin.val_castSucc]
    have hij' : (i : ℕ) < j := hij
    rcases Nat.lt_or_ge ((i : ℕ) + 1) j with h | h
    · exact h
    · have hj' : (j : ℕ) = i + 1 := by omega
      have := hi.2.trans hj.2.symm
      rw [hj', Nat.even_add_one] at this
      exact absurd this (by tauto)
  have hcard : ∀ e : Prop, ∀ [Decidable e],
      ((S.filter fun i : Fin J => Even (i : ℕ) ↔ e).card : ℝ≥0∞) ≤ jumpFunction lam 𝒥 b := by
    intro e _
    refine card_le_jumpFunction (S.filter fun i : Fin J => Even (i : ℕ) ↔ e)
      (s := fun i => u i.castSucc) (t := fun i => u i.succ)
      (fun i _ => hu (Fin.castSucc_lt_succ (i := i))) (hpar e) (fun i _ => hm _) (fun i _ => hm _)
      fun i hi => ?_
    simp only [Finset.mem_filter, S, Finset.mem_univ, true_and] at hi
    exact hi.1
  have hsplit := Finset.card_filter_add_card_filter_not (s := S) (fun i : Fin J => Even (i : ℕ))
  calc (S.card : ℝ≥0∞) = ((S.filter fun i : Fin J => Even (i : ℕ)).card : ℝ≥0∞) +
        ((S.filter fun i : Fin J => ¬ Even (i : ℕ)).card : ℝ≥0∞) := by
        rw [← hsplit]; push_cast; ring
    _ ≤ jumpFunction lam 𝒥 b + jumpFunction lam 𝒥 b := by
        refine add_le_add ?_ ?_
        · simpa using hcard True
        · simpa using hcard False
    _ = 2 * jumpFunction lam 𝒥 b := by ring

/-- Dyadic localization of a positive real number: `2^k < d ≤ 2 · 2^k` for some `k ∈ ℤ`. -/
theorem exists_two_rpow_lt_le {d : ℝ} (hd : 0 < d) :
    ∃ k : ℤ, (2 : ℝ) ^ (k : ℝ) < d ∧ d ≤ 2 * (2 : ℝ) ^ (k : ℝ) := by
  refine ⟨⌈Real.logb 2 d⌉ - 1, ?_, ?_⟩
  · calc (2 : ℝ) ^ (((⌈Real.logb 2 d⌉ - 1 : ℤ)) : ℝ) < 2 ^ Real.logb 2 d := by
          refine Real.rpow_lt_rpow_of_exponent_lt (by norm_num) ?_
          push_cast
          linarith [Int.ceil_lt_add_one (Real.logb 2 d)]
      _ = d := Real.rpow_logb (by norm_num) (by norm_num) hd
  · calc d = 2 ^ Real.logb 2 d := (Real.rpow_logb (by norm_num) (by norm_num) hd).symm
      _ ≤ 2 ^ ((⌈Real.logb 2 d⌉ : ℤ) : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (Int.le_ceil _)
      _ = 2 * (2 : ℝ) ^ (((⌈Real.logb 2 d⌉ - 1 : ℤ)) : ℝ) := by
          push_cast
          rw [Real.rpow_sub (by norm_num), Real.rpow_one]
          field_simp

/-- A single increment is dominated by the dyadic jump sum:
`|d|^r ≤ 2^r ∑_k 2^{kr} 𝟙_{2^k < |d|}` (`r > 0`). -/
theorem enorm_rpow_le_tsum_indicator {r : ℝ} (hr : 0 < r) (z : ℂ) :
    ‖z‖ₑ ^ r ≤ 2 ^ r * ∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (k : ℝ)) ^ r *
      (if (2 : ℝ) ^ (k : ℝ) < ‖z‖ then 1 else 0) := by
  rcases eq_or_ne z 0 with rfl | hz
  · simp [ENNReal.zero_rpow_of_pos hr]
  obtain ⟨k, hk1, hk2⟩ := exists_two_rpow_lt_le (norm_pos_iff.2 hz)
  calc ‖z‖ₑ ^ r = ENNReal.ofReal ‖z‖ ^ r := by rw [ofReal_norm]
    _ ≤ ENNReal.ofReal (2 * (2 : ℝ) ^ (k : ℝ)) ^ r :=
        ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hk2) hr.le
    _ = 2 ^ r * (ENNReal.ofReal ((2 : ℝ) ^ (k : ℝ)) ^ r *
          (if (2 : ℝ) ^ (k : ℝ) < ‖z‖ then 1 else 0)) := by
        rw [show (if (2 : ℝ) ^ (k : ℝ) < ‖z‖ then (1 : ℝ≥0∞) else 0) = 1 by
            simp only [hk1, ↓reduceIte], mul_one,
          ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_ofNat,
          ENNReal.mul_rpow_of_nonneg _ _ hr.le]
    _ ≤ _ := mul_le_mul' le_rfl (ENNReal.le_tsum (f := fun k : ℤ =>
          ENNReal.ofReal ((2 : ℝ) ^ (k : ℝ)) ^ r *
            (if (2 : ℝ) ^ (k : ℝ) < ‖z‖ then 1 else 0)) k)

/-- **Variation norms are controlled by dyadic jump counts** (Bourgain; Jones–Seeger–Wright,
Lemma 2.1, cited in Section 1 of the paper after Lemma 1.3):
`(V^r b)^r ≤ 2 · 2^r ∑_{k ∈ ℤ} 2^{kr} N_{2^k}(b)` for `r > 0`. Increments of size in
`(2^k, 2^{k+1}]` are counted by `N_{2^k}` (up to a factor `2`). -/
theorem variationNorm_rpow_le_tsum_jumpFunction {r : ℝ} (hr : 0 < r) (𝒥 : Set ℝ) (b : ℝ → ℂ) :
    variationNorm r 𝒥 b ^ r ≤ 2 * 2 ^ r * ∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (k : ℝ)) ^ r *
      jumpFunction ((2 : ℝ) ^ (k : ℝ)) 𝒥 b := by
  classical
  refine variationNorm_rpow_le hr fun J u hu hm => ?_
  set w : ℤ → ℝ≥0∞ := fun k => ENNReal.ofReal ((2 : ℝ) ^ (k : ℝ)) ^ r
  calc ∑ i : Fin J, ‖b (u i.succ) - b (u i.castSucc)‖ₑ ^ r
      ≤ ∑ i : Fin J, 2 ^ r * ∑' k : ℤ, w k *
          (if (2 : ℝ) ^ (k : ℝ) < ‖b (u i.succ) - b (u i.castSucc)‖ then 1 else 0) :=
        Finset.sum_le_sum fun i _ => enorm_rpow_le_tsum_indicator hr _
    _ = 2 ^ r * ∑' k : ℤ, w k * ((Finset.univ.filter fun i : Fin J =>
          (2 : ℝ) ^ (k : ℝ) < ‖b (u i.succ) - b (u i.castSucc)‖).card : ℝ≥0∞) := by
        rw [← Finset.mul_sum, ← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
        congr 1
        refine tsum_congr fun k => ?_
        rw [← Finset.mul_sum, Finset.sum_boole]
    _ ≤ 2 ^ r * ∑' k : ℤ, w k * (2 * jumpFunction ((2 : ℝ) ^ (k : ℝ)) 𝒥 b) := by
        gcongr with k
        exact card_filter_lt_le_two_mul_jumpFunction hu hm _
    _ = _ := by
        rw [← ENNReal.tsum_mul_left, ← ENNReal.tsum_mul_left]
        refine tsum_congr fun k => ?_
        ring

end JumpToVariation

section JumpToVariationWeak

/-- The size parameter `ε_r = ((1 - 2^{-(r-2)/2}) / (2 · 2^r))^{1/2}` of the levels in the proof of
`measure_lt_variationNorm_le`. -/
noncomputable def jumpVariationEps (r : ℝ) : ℝ :=
  Real.sqrt ((1 - (2 : ℝ) ^ (-((r - 2) / 2))) / (2 * 2 ^ r))

/-- The constant `K(r, p) = 2^p (1 + ε_r^{-p} (1 - 2^{-p(r-2)/4})⁻¹)` of the weak-type estimate
`measure_lt_variationNorm_le`. -/
noncomputable def jumpVariationConst (r p : ℝ) : ℝ :=
  2 ^ p * (1 + jumpVariationEps r ^ (-p) * (1 - (2 : ℝ) ^ (-(p * ((r - 2) / 4))))⁻¹)

/-- `ε_r > 0` for `r > 2`. -/
theorem jumpVariationEps_pos {r : ℝ} (hr : 2 < r) : 0 < jumpVariationEps r := by
  unfold jumpVariationEps
  refine Real.sqrt_pos.2 (div_pos ?_ (by positivity))
  have : (2 : ℝ) ^ (-((r - 2) / 2)) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  linarith

/-- `K(r, p) > 0` for `r > 2`, `p > 0`. -/
theorem jumpVariationConst_pos {r p : ℝ} (hr : 2 < r) (hp : 0 < p) :
    0 < jumpVariationConst r p := by
  unfold jumpVariationConst
  have h1 : (2 : ℝ) ^ (-(p * ((r - 2) / 4))) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by nlinarith)
  have h2 : 0 < (1 - (2 : ℝ) ^ (-(p * ((r - 2) / 4))))⁻¹ := inv_pos.2 (by linarith)
  have h3 := jumpVariationEps_pos hr
  positivity

/-- **Weak-type estimate for variation norms from jump estimates** (the real-variable core of
Bourgain's argument, JSW Lemma 2.1): if for every `k ∈ ℤ` and `s > 0` the level sets of
`2^k √N_{2^k}` satisfy `ν{2^k √N_{2^k} ≥ s} ≤ M s^{-p}`, then for `r > 2` and every `t > 0`,
`ν{V^r > t} ≤ M K(r,p) t^{-p}`. The proof splits at the dyadic scale `2^{k₀} ≈ t`: above it a
single jump of size `> 2^{k₀}` must occur; below it a union bound with geometrically growing levels
is used, which is summable exactly because `r > 2`. -/
theorem measure_lt_variationNorm_le {X : Type*} [MeasurableSpace X] {ν : Measure X}
    {𝒥 : Set ℝ} {b : X → ℝ → ℂ} {r p : ℝ} (hr : 2 < r) (hp : 0 < p) {M : ℝ≥0∞}
    (hcheb : ∀ (k : ℤ) (s : ℝ), 0 < s → ν {x | ENNReal.ofReal s ≤
      ENNReal.ofReal ((2 : ℝ) ^ (k : ℝ)) * jumpFunction ((2 : ℝ) ^ (k : ℝ)) 𝒥 (b x) ^ (1 / 2 : ℝ)}
        ≤ M * ENNReal.ofReal (s ^ (-p)))
    {t : ℝ} (ht : 0 < t) :
    ν {x | ENNReal.ofReal t < variationNorm r 𝒥 (b x)} ≤
      M * ENNReal.ofReal (jumpVariationConst r p * t ^ (-p)) := by
  have hr0 : 0 < r := by linarith
  set γ : ℝ := (r - 2) / 4 with hγ
  have hγ0 : 0 < γ := by rw [hγ]; linarith
  set ε := jumpVariationEps r with hεdef
  have hε : 0 < ε := jumpVariationEps_pos hr
  set ρ' : ℝ := (2 : ℝ) ^ (-((r - 2) / 2)) with hρ'
  have hρ'0 : 0 ≤ ρ' := by positivity
  have hρ'1 : ρ' < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hε2 : ε ^ 2 = (1 - ρ') / (2 * 2 ^ r) :=
    Real.sq_sqrt (div_nonneg (by linarith) (by positivity))
  set ρ : ℝ := (2 : ℝ) ^ (-(p * γ)) with hρ
  have hρ0 : 0 ≤ ρ := by positivity
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by nlinarith)
  set lam : ℤ → ℝ := fun k => (2 : ℝ) ^ (k : ℝ) with hlam
  set k₀ : ℤ := ⌊Real.logb 2 t⌋
  set T : ℝ := lam k₀ with hTdef
  have hT : 0 < T := by positivity
  have hTt : T ≤ t := by
    calc T ≤ 2 ^ Real.logb 2 t :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (Int.floor_le _)
      _ = t := Real.rpow_logb (by norm_num) (by norm_num) ht
  have htT : t / 2 ≤ T := by
    have : t < 2 * T := by
      calc t = 2 ^ Real.logb 2 t := (Real.rpow_logb (by norm_num) (by norm_num) ht).symm
        _ < 2 ^ ((k₀ : ℝ) + 1) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (Int.lt_floor_add_one _)
        _ = 2 * T := by rw [Real.rpow_add two_pos, Real.rpow_one, mul_comm]
    linarith
  set kj : ℕ → ℤ := fun j => k₀ - 1 - j with hkj
  set s : ℕ → ℝ := fun j => ε * (2 : ℝ) ^ ((k₀ : ℝ) + γ * j) with hsdef
  have hs : ∀ j, 0 < s j := fun j => by positivity
  set Y : ℤ → X → ℝ≥0∞ := fun k x =>
    ENNReal.ofReal (lam k) * jumpFunction (lam k) 𝒥 (b x) ^ (1 / 2 : ℝ) with hY
  -- the levels: `2^{k_j (r-2)} s_j² ≤ ε² T^r ρ'^j`
  have hlev : ∀ j : ℕ, lam (kj j) ^ (r - 2) * s j ^ 2 ≤ ε ^ 2 * T ^ r * ρ' ^ j := by
    intro j
    have e1 : lam (kj j) ^ (r - 2) * s j ^ 2 =
        ε ^ 2 * (2 : ℝ) ^ (((k₀ : ℝ) - 1 - j) * (r - 2) + ((k₀ : ℝ) + γ * j) * 2) := by
      simp only [hlam, hkj, hsdef]
      push_cast
      rw [mul_pow, ← Real.rpow_natCast ((2 : ℝ) ^ ((k₀ : ℝ) + γ * j)) 2,
        ← Real.rpow_mul (by norm_num), ← Real.rpow_mul (by norm_num), Real.rpow_add two_pos]
      push_cast; ring
    have e2 : ε ^ 2 * T ^ r * ρ' ^ j = ε ^ 2 * (2 : ℝ) ^ ((k₀ : ℝ) * r + (-((r - 2) / 2)) * j) := by
      simp only [hTdef, hlam, hρ']
      rw [← Real.rpow_mul (by norm_num), ← Real.rpow_natCast ((2 : ℝ) ^ (-((r - 2) / 2))) j,
        ← Real.rpow_mul (by norm_num), Real.rpow_add two_pos]
      ring
    rw [e1, e2]
    refine mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_)
      (by positivity)
    have hj : (0 : ℝ) ≤ j := Nat.cast_nonneg j
    have : ((k₀ : ℝ) - 1 - j) * (r - 2) + ((k₀ : ℝ) + γ * j) * 2 =
        (k₀ : ℝ) * r + (-((r - 2) / 2)) * j - (r - 2) := by rw [hγ]; ring
    rw [this]; linarith
  -- the inclusion
  have hsub : {x | ENNReal.ofReal t < variationNorm r 𝒥 (b x)} ⊆
      {x | ENNReal.ofReal T ≤ Y k₀ x} ∪ ⋃ j : ℕ, {x | ENNReal.ofReal (s j) ≤ Y (kj j) x} := by
    intro x hx
    by_contra hcon
    simp only [mem_union, mem_iUnion, mem_ofPred_eq, not_or, not_exists, not_le] at hcon hx
    obtain ⟨h0, hj⟩ := hcon
    set N : ℤ → ℝ≥0∞ := fun k => jumpFunction (lam k) 𝒥 (b x) with hN
    have hN0 : N k₀ = 0 := by
      by_contra hne
      have h1 := one_le_jumpFunction_of_pos (pos_iff_ne_zero.2 hne)
      have : ENNReal.ofReal T ≤ Y k₀ x := by
        calc ENNReal.ofReal T = ENNReal.ofReal T * 1 := (mul_one _).symm
          _ ≤ Y k₀ x := mul_le_mul' le_rfl (ENNReal.one_le_rpow h1 (by norm_num))
      exact absurd h0 (not_lt.2 this)
    have hzero : ∀ k, k₀ ≤ k → N k = 0 := fun k hk =>
      le_antisymm ((jumpFunction_anti (Real.rpow_le_rpow_of_exponent_le (by norm_num)
        (by exact_mod_cast hk)) 𝒥 (b x)).trans hN0.le) zero_le
    have hbd : ∀ j, ENNReal.ofReal (lam (kj j)) ^ r * N (kj j) ≤
        ENNReal.ofReal (lam (kj j) ^ (r - 2) * s j ^ 2) := by
      intro j
      have hl : 0 < lam (kj j) := by positivity
      have hl0 : ENNReal.ofReal (lam (kj j)) ≠ 0 := by simpa using hl
      have hY2 : Y (kj j) x ^ (2 : ℝ) = ENNReal.ofReal (lam (kj j)) ^ (2 : ℝ) * N (kj j) := by
        simp only [hY, hN]
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
        norm_num
      have hlt := ENNReal.rpow_lt_rpow (hj j) (by norm_num : (0 : ℝ) < 2)
      rw [hY2] at hlt
      calc ENNReal.ofReal (lam (kj j)) ^ r * N (kj j)
          = ENNReal.ofReal (lam (kj j)) ^ (r - 2) *
              (ENNReal.ofReal (lam (kj j)) ^ (2 : ℝ) * N (kj j)) := by
            rw [← mul_assoc, ← ENNReal.rpow_add _ _ hl0 ENNReal.ofReal_ne_top, sub_add_cancel]
        _ ≤ ENNReal.ofReal (lam (kj j)) ^ (r - 2) * ENNReal.ofReal (s j) ^ (2 : ℝ) :=
            mul_le_mul' le_rfl hlt.le
        _ = _ := by
            rw [ENNReal.ofReal_rpow_of_pos hl, ENNReal.ofReal_rpow_of_pos (hs j),
              ← ENNReal.ofReal_mul (by positivity), Real.rpow_two]
    have hV := variationNorm_rpow_le_tsum_jumpFunction hr0 𝒥 (b x)
    have hinj : Function.Injective kj := fun i j h => by simp only [hkj] at h; omega
    have hsupp : Function.support (fun k : ℤ => ENNReal.ofReal (lam k) ^ r * N k) ⊆ range kj := by
      intro k hk
      by_cases hkk : k₀ ≤ k
      · exact absurd (by simp [hzero k hkk]) hk
      · exact ⟨(k₀ - 1 - k).toNat, by simp only [hkj]; omega⟩
    rw [← hinj.tsum_eq hsupp] at hV
    have hsum : ∑' j : ℕ, ENNReal.ofReal (lam (kj j) ^ (r - 2) * s j ^ 2) ≤
        ENNReal.ofReal (T ^ r / (2 * 2 ^ r)) := by
      calc ∑' j : ℕ, ENNReal.ofReal (lam (kj j) ^ (r - 2) * s j ^ 2)
          ≤ ∑' j : ℕ, ENNReal.ofReal (ε ^ 2 * T ^ r * ρ' ^ j) :=
            ENNReal.tsum_le_tsum fun j => ENNReal.ofReal_le_ofReal (hlev j)
        _ = ENNReal.ofReal (∑' j : ℕ, ε ^ 2 * T ^ r * ρ' ^ j) :=
            (ENNReal.ofReal_tsum_of_nonneg (fun j => by positivity)
              ((summable_geometric_of_lt_one hρ'0 hρ'1).mul_left _)).symm
        _ = _ := by
            rw [tsum_mul_left, tsum_geometric_of_lt_one hρ'0 hρ'1, hε2]
            have : 1 - ρ' ≠ 0 := by linarith
            field_simp
    have h22 : (2 : ℝ≥0∞) * 2 ^ r = ENNReal.ofReal (2 * 2 ^ r) := by
      rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_ofNat,
        ← ENNReal.ofReal_rpow_of_pos two_pos, ENNReal.ofReal_ofNat]
    have hVr : variationNorm r 𝒥 (b x) ^ r ≤ ENNReal.ofReal t ^ r := by
      calc variationNorm r 𝒥 (b x) ^ r
          ≤ 2 * 2 ^ r * ∑' j : ℕ, ENNReal.ofReal (lam (kj j)) ^ r * N (kj j) := hV
        _ ≤ 2 * 2 ^ r * ENNReal.ofReal (T ^ r / (2 * 2 ^ r)) :=
            mul_le_mul' le_rfl ((ENNReal.tsum_le_tsum hbd).trans hsum)
        _ = ENNReal.ofReal (T ^ r) := by
            rw [h22, ← ENNReal.ofReal_mul (by positivity)]
            congr 1; field_simp
        _ ≤ ENNReal.ofReal t ^ r := by
            rw [ENNReal.ofReal_rpow_of_pos ht]
            exact ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow hT.le hTt hr0.le)
    exact absurd hx (not_lt.2 ((ENNReal.rpow_le_rpow_iff hr0).1 hVr))
  -- the measure estimate
  have hsj : ∀ j : ℕ, s j ^ (-p) = ε ^ (-p) * T ^ (-p) * ρ ^ j := by
    intro j
    simp only [hsdef, hTdef, hlam, hρ]
    rw [Real.mul_rpow hε.le (by positivity), ← Real.rpow_mul (by norm_num),
      ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num),
      mul_assoc, ← Real.rpow_add two_pos]
    congr 2; ring
  have hsumm : Summable fun j : ℕ => s j ^ (-p) := by
    simp_rw [hsj]; exact (summable_geometric_of_lt_one hρ0 hρ1).mul_left _
  have hreal : T ^ (-p) + ∑' j : ℕ, s j ^ (-p) ≤ jumpVariationConst r p * t ^ (-p) := by
    simp_rw [hsj]
    rw [tsum_mul_left, tsum_geometric_of_lt_one hρ0 hρ1]
    have hT2 : T ^ (-p) ≤ 2 ^ p * t ^ (-p) := by
      calc T ^ (-p) ≤ (t / 2) ^ (-p) := Real.rpow_le_rpow_of_nonpos (by positivity) htT
            (by linarith)
        _ = 2 ^ p * t ^ (-p) := by
            rw [Real.div_rpow ht.le (by norm_num), Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2)]
            field_simp
    have hK : 0 ≤ 1 + ε ^ (-p) * (1 - ρ)⁻¹ := by
      have : 0 < 1 - ρ := by linarith
      positivity
    calc T ^ (-p) + ε ^ (-p) * T ^ (-p) * (1 - ρ)⁻¹
        = T ^ (-p) * (1 + ε ^ (-p) * (1 - ρ)⁻¹) := by ring
      _ ≤ (2 ^ p * t ^ (-p)) * (1 + ε ^ (-p) * (1 - ρ)⁻¹) := mul_le_mul_of_nonneg_right hT2 hK
      _ = jumpVariationConst r p * t ^ (-p) := by
          simp only [jumpVariationConst, ← hεdef, hρ, hγ]; ring
  calc ν {x | ENNReal.ofReal t < variationNorm r 𝒥 (b x)}
      ≤ ν ({x | ENNReal.ofReal T ≤ Y k₀ x} ∪
          ⋃ j : ℕ, {x | ENNReal.ofReal (s j) ≤ Y (kj j) x}) := measure_mono hsub
    _ ≤ ν {x | ENNReal.ofReal T ≤ Y k₀ x} +
          ∑' j : ℕ, ν {x | ENNReal.ofReal (s j) ≤ Y (kj j) x} :=
        (measure_union_le _ _).trans (add_le_add le_rfl (measure_iUnion_le _))
    _ ≤ M * ENNReal.ofReal (T ^ (-p)) + ∑' j : ℕ, M * ENNReal.ofReal (s j ^ (-p)) :=
        add_le_add (hcheb k₀ T hT) (ENNReal.tsum_le_tsum fun j => hcheb (kj j) _ (hs j))
    _ = M * ENNReal.ofReal (T ^ (-p) + ∑' j : ℕ, s j ^ (-p)) := by
        rw [ENNReal.tsum_mul_left, ← ENNReal.ofReal_tsum_of_nonneg (fun j => by positivity) hsumm,
          ← mul_add, ← ENNReal.ofReal_add (by positivity)
            (tsum_nonneg fun j => by positivity)]
    _ ≤ _ := mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal hreal)

/-- Chebyshev's inequality for `[0, ∞]`-valued functions:
`ν{F ≥ s} ≤ ‖F‖_p^p s^{-p}` (`p, s > 0`; no measurability needed). -/
theorem measure_ofReal_le_le_of_eLpNorm_le {X : Type*} [MeasurableSpace X] {ν : Measure X}
    {F : X → ℝ≥0∞} {p : ℝ} (hp : 0 < p) {B : ℝ≥0∞} (hF : eLpNorm F (ENNReal.ofReal p) ν ≤ B)
    {s : ℝ} (hs : 0 < s) :
    ν {x | ENNReal.ofReal s ≤ F x} ≤ B ^ p * ENNReal.ofReal (s ^ (-p)) := by
  have h := meas_ge_le_mul_pow_eLpNorm_enorm ν (by simpa using hp) ENNReal.ofReal_ne_top
    (f := F) (ε := ENNReal.ofReal s) (by simpa using hs) (fun h => absurd h ENNReal.ofReal_ne_top)
  simp only [enorm_eq_self, ENNReal.toReal_ofReal hp.le] at h
  refine h.trans (le_of_le_of_eq (mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hF hp.le)) ?_)
  rw [mul_comm, ← ENNReal.ofReal_inv_of_pos hs, ENNReal.ofReal_rpow_of_pos (inv_pos.2 hs),
    Real.inv_rpow hs.le, ← Real.rpow_neg hs.le]

/-- **Weak type `(p, p)` for `V^r` from a uniform `L^p` jump bound** (`r > 2`, `p > 0`): if
`‖λ √N_λ(b)‖_{L^p} ≤ B` for all `λ > 0`, then `ν{V^r(b) > t} ≤ B^p K(r,p) t^{-p}`. -/
theorem measure_lt_variationNorm_le_of_eLpNorm_jumpFunction {X : Type*} [MeasurableSpace X]
    {ν : Measure X} {𝒥 : Set ℝ} {b : X → ℝ → ℂ} {r p : ℝ} (hr : 2 < r) (hp : 0 < p)
    {B : ℝ≥0∞}
    (hjump : ∀ lam : ℝ, 0 < lam → eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (b x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) ν ≤ B)
    {t : ℝ} (ht : 0 < t) :
    ν {x | ENNReal.ofReal t < variationNorm r 𝒥 (b x)} ≤
      B ^ p * ENNReal.ofReal (jumpVariationConst r p * t ^ (-p)) :=
  measure_lt_variationNorm_le hr hp (fun k s hs =>
    measure_ofReal_le_le_of_eLpNorm_le hp (hjump _ (by positivity)) hs) ht

/-- Under a uniform `L^p` jump bound `B < ∞` (`r > 2`, `p > 0`), `V^r(b) < ∞` almost
everywhere. -/
theorem ae_variationNorm_ne_top_of_eLpNorm_jumpFunction {X : Type*} [MeasurableSpace X]
    {ν : Measure X} {𝒥 : Set ℝ} {b : X → ℝ → ℂ} {r p : ℝ} (hr : 2 < r) (hp : 0 < p)
    {B : ℝ≥0∞} (hB : B ≠ ∞)
    (hjump : ∀ lam : ℝ, 0 < lam → eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (b x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) ν ≤ B) :
    ∀ᵐ x ∂ν, variationNorm r 𝒥 (b x) ≠ ∞ := by
  rw [ae_iff]
  simp only [ne_eq, not_not]
  have hlim : Tendsto (fun t : ℝ => B ^ p * ENNReal.ofReal (jumpVariationConst r p * t ^ (-p)))
      atTop (𝓝 (B ^ p * ENNReal.ofReal (jumpVariationConst r p * 0))) := by
    refine ENNReal.Tendsto.const_mul (ENNReal.tendsto_ofReal
      ((tendsto_rpow_neg_atTop hp).const_mul _)) (Or.inr (ENNReal.rpow_ne_top_of_nonneg hp.le hB))
  simp only [mul_zero, ENNReal.ofReal_zero] at hlim
  refine le_antisymm (ge_of_tendsto hlim ?_) zero_le
  filter_upwards [eventually_gt_atTop 0] with t ht
  refine (measure_mono fun x hx => ?_).trans
    (measure_lt_variationNorm_le_of_eLpNorm_jumpFunction hr hp hjump ht)
  simp only [mem_ofPred_eq] at hx ⊢
  rw [hx]; exact ENNReal.ofReal_lt_top

end JumpToVariationWeak

section JumpToVariationStrong

variable {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y] {μ : Measure X} {ν : Measure Y}

/-- The weak-type estimate of `measure_lt_variationNorm_le_of_eLpNorm_jumpFunction`, in the form
`HasWeakTypeOn` used by the Marcinkiewicz interpolation theorem, for the real-valued operator
`f ↦ V^r(a f ·)` (with `∞` replaced by `0`): if `‖λ √N_λ(a f)‖_q ≤ C ‖f‖_q` for `f ∈ D`, `λ > 0`,
then `f ↦ V^r(a f)` is of weak type `(q, q)` on `D` with constant `K(r,q)^{1/q} C`. -/
theorem hasWeakTypeOn_variationNorm_of_jumpFunction {𝒥 : Set ℝ} {a : (X → ℂ) → Y → ℝ → ℂ}
    {D : Set (X → ℂ)} {r q : ℝ} (hr : 2 < r) (hq : 0 < q) {Cq : ℝ≥0}
    (hj : ∀ f ∈ D, ∀ lam : ℝ, 0 < lam → eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (a f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal q) ν ≤
        Cq * eLpNorm f (ENNReal.ofReal q) μ) :
    HasWeakTypeOn (fun f x => (variationNorm r 𝒥 (a f x)).toReal) D q
      (Real.toNNReal (jumpVariationConst r q ^ (1 / q)) * Cq) μ ν := by
  refine hasWeakTypeOn_of_forall_real fun f hf t ht => ?_
  have h1 := measure_lt_variationNorm_le_of_eLpNorm_jumpFunction (b := a f) hr hq (hj f hf) ht
  refine (measure_mono fun x hx => ?_).trans (h1.trans (le_of_eq ?_))
  · simp only [mem_ofPred_eq, Real.norm_of_nonneg ENNReal.toReal_nonneg] at hx ⊢
    have hne : variationNorm r 𝒥 (a f x) ≠ ∞ := by
      intro h; rw [h, ENNReal.toReal_top] at hx; linarith
    rw [← ENNReal.ofReal_toReal hne]
    exact (ENNReal.ofReal_lt_ofReal_iff_of_nonneg ht.le).2 hx
  · have hK := jumpVariationConst_pos hr hq
    set e := eLpNorm f (ENNReal.ofReal q) μ
    set K := jumpVariationConst r q
    have hA : ((Real.toNNReal (K ^ (1 / q)) * Cq : ℝ≥0) : ℝ≥0∞) ^ q =
        ENNReal.ofReal K * (Cq : ℝ≥0∞) ^ q := by
      rw [ENNReal.coe_mul, ENNReal.mul_rpow_of_nonneg _ _ hq.le]
      congr 1
      change ENNReal.ofReal (K ^ (1 / q)) ^ q = _
      rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, ← Real.rpow_mul hK.le,
        one_div_mul_cancel hq.ne', Real.rpow_one]
    have ht' : (ENNReal.ofReal t)⁻¹ ^ q = ENNReal.ofReal (t ^ (-q)) := by
      rw [← ENNReal.ofReal_inv_of_pos ht, ENNReal.ofReal_rpow_of_pos (inv_pos.2 ht),
        Real.inv_rpow ht.le, ← Real.rpow_neg ht.le]
    rw [div_eq_mul_inv, ENNReal.mul_rpow_of_nonneg _ _ hq.le, ENNReal.mul_rpow_of_nonneg _ _ hq.le,
      ENNReal.mul_rpow_of_nonneg (((Real.toNNReal (K ^ (1 / q)) * Cq : ℝ≥0) : ℝ≥0∞)) e hq.le,
      hA, ht', ENNReal.ofReal_mul hK.le]
    ring

/-- **Bourgain's jump-to-variation interpolation** (Jones–Seeger–Wright, *Strong variational and
jump inequalities in harmonic analysis*, Lemma 2.1; cited in Section 1 of the paper after
Lemma 1.3). Let `D` be a truncation-closed class of `L^{p₀}` functions and `a f x : ℝ → ℂ` a family
which is additive in `f` (a.e. in `x`, for all `u` simultaneously). If the jump inequalities
`‖λ √N_λ{a f x(u) : u ∈ 𝒥}‖_{L^{p_i}} ≤ C_i ‖f‖_{L^{p_i}}` hold for `i = 0, 1`, all `f ∈ D` and all
`λ > 0` (`0 < p₀ < p₁`), then for every `r > 2` and `p₀ < p < p₁` there is `C` with
`‖V^r{a f x(u) : u ∈ 𝒥}‖_{L^p} ≤ C ‖f‖_{L^p}` for all `f ∈ D`.

Proof: pointwise `(V^r)^r ≲ ∑_k 2^{kr} N_{2^k}` (`variationNorm_rpow_le_tsum_jumpFunction`) gives
weak type `(p_i, p_i)` for `V^r` (`measure_lt_variationNorm_le`; this uses `r > 2`); `V^r` is
sublinear by Minkowski; then the Marcinkiewicz interpolation theorem. -/
theorem eLpNorm_variationNorm_le_of_jumpFunction [SFinite μ] {𝒥 : Set ℝ}
    {a : (X → ℂ) → Y → ℝ → ℂ} {D : Set (X → ℂ)} (hD : IsTruncationClosed D)
    {p₀ p₁ p r : ℝ} (hp₀ : 0 < p₀) (hp₀p : p₀ < p) (hpp₁ : p < p₁) (hr : 2 < r)
    {C₀ C₁ : ℝ≥0} (hDmem : ∀ f ∈ D, MemLp f (ENNReal.ofReal p₀) μ)
    (hadd : ∀ f ∈ D, ∀ g ∈ D, ∀ᵐ x ∂ν, ∀ u, a (f + g) x u = a f x u + a g x u)
    (hmeas : ∀ f ∈ D, AEMeasurable (fun x => variationNorm r 𝒥 (a f x)) ν)
    (h₀ : ∀ f ∈ D, ∀ lam : ℝ, 0 < lam → eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (a f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p₀) ν ≤
        C₀ * eLpNorm f (ENNReal.ofReal p₀) μ)
    (h₁ : ∀ f ∈ D, ∀ lam : ℝ, 0 < lam → eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (a f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p₁) ν ≤
        C₁ * eLpNorm f (ENNReal.ofReal p₁) μ) :
    ∃ C : ℝ≥0, ∀ f ∈ D, eLpNorm (fun x => variationNorm r 𝒥 (a f x)) (ENNReal.ofReal p) ν ≤
      C * eLpNorm f (ENNReal.ofReal p) μ := by
  set T : (X → ℂ) → Y → ℝ := fun f x => (variationNorm r 𝒥 (a f x)).toReal with hT
  have hfin : ∀ f ∈ D, ∀ᵐ x ∂ν, variationNorm r 𝒥 (a f x) ≠ ∞ := fun f hf =>
    ae_variationNorm_ne_top_of_eLpNorm_jumpFunction hr hp₀
      (ENNReal.mul_ne_top ENNReal.coe_ne_top (hDmem f hf).eLpNorm_ne_top) (h₀ f hf)
  have hsub : IsSublinearOn T D ν := by
    intro f hf g hg
    filter_upwards [hadd f hf g hg, hfin f hf, hfin g hg] with x hx h1 h2
    have heq : a (f + g) x = a f x + a g x := funext hx
    simp only [hT, Real.norm_of_nonneg ENNReal.toReal_nonneg]
    rw [← ENNReal.toReal_add h1 h2]
    refine ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨h1, h2⟩) ?_
    rw [heq]
    exact variationNorm_add_le (by linarith) 𝒥 _ _
  set A₀ := Real.toNNReal (jumpVariationConst r p₀ ^ (1 / p₀)) * C₀
  set A₁ := Real.toNNReal (jumpVariationConst r p₁ ^ (1 / p₁)) * C₁
  have hbd : marcinkiewiczBound p₀ p₁ p A₀ A₁ 1 ^ (1 / p) ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (by have := hp₀.trans hp₀p; positivity)
      (marcinkiewiczBound_ne_top _ _ _ _ _ _)
  refine ⟨(marcinkiewiczBound p₀ p₁ p A₀ A₁ 1 ^ (1 / p)).toNNReal, fun f hf => ?_⟩
  have hfm := (hDmem f hf).aestronglyMeasurable
  have hTm : AEStronglyMeasurable (T f) ν := (hmeas f hf).ennreal_toReal.aestronglyMeasurable
  have key := eLpNorm_le_of_hasWeakTypeOn_of_pos hp₀ hp₀p hpp₁ one_pos
    (hasWeakTypeOn_variationNorm_of_jumpFunction hr hp₀ h₀)
    (hasWeakTypeOn_variationNorm_of_jumpFunction hr (hp₀.trans (hp₀p.trans hpp₁)) h₁)
    hsub hD hf hfm hTm
  rw [ENNReal.coe_toNNReal hbd]
  calc eLpNorm (fun x => variationNorm r 𝒥 (a f x)) (ENNReal.ofReal p) ν
      = eLpNorm (T f) (ENNReal.ofReal p) ν := by
        refine eLpNorm_congr_enorm_ae (hmeas f hf).aestronglyMeasurable hTm ?_
        filter_upwards [hfin f hf] with x hx
        simp only [hT, enorm_eq_self, Real.enorm_eq_ofReal ENNReal.toReal_nonneg,
          ENNReal.ofReal_toReal hx]
    _ ≤ _ := key

end JumpToVariationStrong

section JumpToVariationModulated

open scoped SchwartzMap

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The class `L^{p₀} ∩ L^{p₁}` is truncation closed. -/
theorem isTruncationClosed_memLp_inter {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {E : Type*} [NormedAddCommGroup E] (q₀ q₁ : ℝ≥0∞) :
    IsTruncationClosed {f : X → E | MemLp f q₀ μ ∧ MemLp f q₁ μ} := by
  intro f hf s hs
  obtain ⟨h₀, h₀'⟩ := isTruncationClosed_memLp (μ := μ) f hf.1 s hs
  obtain ⟨h₁, h₁'⟩ := isTruncationClosed_memLp (μ := μ) f hf.2 s hs
  exact ⟨⟨h₀, h₁⟩, ⟨h₀', h₁'⟩⟩

/-- **Jump inequalities imply variation inequalities for `𝓗^{(u)}`** (Bourgain / JSW Lemma 2.1
applied to the family `u ↦ 𝓗^{(u)} f(x)`, Section 1 of the paper): if for Schwartz functions `g`
and all `λ > 0`, `‖λ √N_λ{𝓗^{(u)} g : u ∈ 𝒥}‖_{p_i} ≤ C_i ‖g‖_{p_i}` (`i = 0, 1`,
`1 < p₀ < p₁ < ∞`), then for every `r > 2` and `p₀ < p < p₁` there is `C` with
`‖V^r{𝓗^{(u)} g : u ∈ 𝒥}‖_p ≤ C ‖g‖_p` for Schwartz `g`. Here `𝒥` is countable (e.g. the dyadic
set `{2^{jα}}` of the long variation) or contained in the closure of its rational points. The
proof extends the jump bounds to `L^{p₀} ∩ L^{p₁}` for the difference operators
`𝓗^{(u)} - 𝓗^{(0)}` (density and Fatou), applies `eLpNorm_variationNorm_le_of_jumpFunction`, and
uses that the variation norm is invariant under subtracting `𝓗^{(0)} g(x)`. -/
theorem IsHomogeneousCZKernel.eLpNorm_variationNorm_modulatedSI_le_of_jumpFunction
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {𝒥 : Set ℝ}
    (h𝒥 : 𝒥.Countable ∨ 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) {p₀ p₁ p r : ℝ}
    (hp₀ : 1 < p₀) (hp₀p : p₀ < p) (hpp₁ : p < p₁) (hr : 2 < r) {C₀ C₁ : ℝ≥0}
    (h₀ : ∀ g : 𝓢(Rn n, ℂ), ∀ lam : ℝ, 0 < lam → eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (fun u => modulatedSI n α Ω u g x) ^ (1 / 2 : ℝ))
        (ENNReal.ofReal p₀) ≤ C₀ * eLpNorm g (ENNReal.ofReal p₀))
    (h₁ : ∀ g : 𝓢(Rn n, ℂ), ∀ lam : ℝ, 0 < lam → eLpNorm (fun x => ENNReal.ofReal lam *
      jumpFunction lam 𝒥 (fun u => modulatedSI n α Ω u g x) ^ (1 / 2 : ℝ))
        (ENNReal.ofReal p₁) ≤ C₁ * eLpNorm g (ENNReal.ofReal p₁)) :
    ∃ C : ℝ≥0, ∀ g : 𝓢(Rn n, ℂ), eLpNorm (fun x => variationNorm r 𝒥
      (fun u => modulatedSI n α Ω u g x)) (ENNReal.ofReal p) ≤
        C * eLpNorm g (ENNReal.ofReal p) := by
  have hp₁ : 1 < p₁ := hp₀.trans (hp₀p.trans hpp₁)
  set D : Set (Rn n → ℂ) := {f | MemLp f (ENNReal.ofReal p₀) ∧ MemLp f (ENNReal.ofReal p₁)}
  have hmeasS : ∀ (lam : ℝ) (g : 𝓢(Rn n, ℂ)),
      AEMeasurable fun x => jumpFunction lam 𝒥 (fun u => modulatedSI n α Ω u g x) := by
    intro lam g
    rcases h𝒥 with h | h
    · exact (measurable_jumpFunction_of_countable (A := fun x u => modulatedSI n α Ω u g x)
        (fun u => hΩ.measurable_modulatedSI hn hα u g) lam h).aemeasurable
    · exact (hΩ.measurable_jumpFunction_modulatedSI hn hα g lam h).aemeasurable
  have hjump : ∀ (q : ℝ) (Cq : ℝ≥0), 1 < q → (∀ g : 𝓢(Rn n, ℂ), ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction lam 𝒥
        (fun u => modulatedSI n α Ω u g x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal q) ≤
          Cq * eLpNorm g (ENNReal.ofReal q)) →
      ∀ f, MemLp f (ENNReal.ofReal q) → ∀ lam : ℝ, 0 < lam →
        eLpNorm (fun x => ENNReal.ofReal lam * jumpFunction lam 𝒥
          (fun u => modulatedDiff n α Ω u 0 f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal q) ≤
            Cq * eLpNorm f (ENNReal.ofReal q) :=
    fun q Cq hq hS f hf lam hlam => hΩ.eLpNorm_jumpFunction_modulatedDiff_le hn hα hq lam h𝒥 0
      ENNReal.coe_ne_top (hmeasS lam) (fun g => hS g lam hlam) hf
  obtain ⟨C, hC⟩ := eLpNorm_variationNorm_le_of_jumpFunction (μ := volume) (ν := volume)
    (a := fun f x u => modulatedDiff n α Ω u 0 f x) (D := D)
    (isTruncationClosed_memLp_inter _ _) (by linarith) hp₀p hpp₁ hr (fun f hf => hf.1)
    (fun f hf g hg => by
      filter_upwards [hΩ.ae_integrable_modulatedDiff_integrand hn hα hp₀ hf.1,
        hΩ.ae_integrable_modulatedDiff_integrand hn hα hp₀ hg.1] with x hx hy
      exact fun u => modulatedDiff_add (hx u 0) (hy u 0))
    (fun f hf => hΩ.aemeasurable_variationNorm_modulatedDiff hn hα hp₀ hf.1 r h𝒥 0)
    (fun f hf lam hlam => hjump p₀ C₀ hp₀ h₀ f hf.1 lam hlam)
    (fun f hf lam hlam => hjump p₁ C₁ hp₁ h₁ f hf.2 lam hlam)
  refine ⟨C, fun g => ?_⟩
  have heq : (fun x => variationNorm r 𝒥 (fun u => modulatedSI n α Ω u g x)) =
      fun x => variationNorm r 𝒥 (fun u => modulatedDiff n α Ω u 0 g x) :=
    funext fun x => (hΩ.variationNorm_modulatedDiff hn hα r 𝒥 0 g x).symm
  rw [heq]
  exact hC g ⟨g.memLp _, g.memLp _⟩

end JumpToVariationModulated

end Auto
