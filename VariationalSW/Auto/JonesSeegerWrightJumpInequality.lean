section JswA

/-- The `L¹`-normalized dyadic dilate `φ_j(x) = 2^{jn} φ(2^j x)`. -/
def jswDilate (n : ℕ) (φ : EuclideanSpace ℝ (Fin n) → ℂ) (j : ℤ)
    (x : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ((2 : ℝ) ^ (j * n)) • φ ((2 : ℝ) ^ j • x)

/-- The `λ`-jump counting function of a sequence `a : ℤ → ℂ`. -/
def jswJumpCount (lam : ℝ) (a : ℤ → ℂ) : ℝ≥0∞ :=
  ⨆ (N : ℕ) (s : Fin N → ℤ) (t : Fin N → ℤ) (_ : ∀ i, s i < t i)
    (_ : ∀ i j, i < j → t i < s j)
    (_ : ∀ i, lam < ‖a (t i) - a (s i)‖), (N : ℝ≥0∞)

theorem jswJumpCount_eq_seqJumpCount : jswJumpCount = seqJumpCount := rfl

/-! ### Comparison of jump counts -/

theorem jsw_card_le_jumpCount {lam : ℝ} {b : ℤ → ℂ} {N : ℕ} {s t : Fin N → ℤ}
    (h2 : ∀ i j, i < j → t i < s j) (G : Finset (Fin N)) (h1 : ∀ i, s i < t i)
    (hG : ∀ i ∈ G, lam < ‖b (t i) - b (s i)‖) :
    (G.card : ℝ≥0∞) ≤ jswJumpCount lam b := by
  set e := G.orderEmbOfFin rfl
  refine le_iSup_of_le G.card (le_iSup_of_le (fun k => s (e k)) (le_iSup_of_le
    (fun k => t (e k)) (le_iSup_of_le (fun k => h1 _) (le_iSup_of_le ?_
    (le_iSup_of_le (fun k => hG _ (G.orderEmbOfFin_mem rfl k)) le_rfl)))))
  intro k k' hk
  exact h2 _ _ (e.strictMono hk)

theorem jsw_endpoints_ne {N : ℕ} {s t : Fin N → ℤ} (h1 : ∀ i, s i < t i)
    (h2 : ∀ i j, i < j → t i < s j) {i i' : Fin N} (hii : i ≠ i') :
    s i ≠ s i' ∧ t i ≠ t i' ∧ s i ≠ t i' := by
  rcases lt_or_gt_of_ne hii with h | h
  · have := h2 _ _ h; have := h1 i; have := h1 i'
    refine ⟨by omega, by omega, by omega⟩
  · have := h2 _ _ h; have := h1 i; have := h1 i'
    refine ⟨by omega, by omega, by omega⟩

/-- **Comparison of jump counts**: `N_λ(a) ≤ N_{λ/3}(b) + 9 λ⁻² ∑_j |a_j - b_j|²`. -/
theorem jswJumpCount_le_add {lam : ℝ} (hlam : 0 < lam) (a b : ℤ → ℂ) :
    jswJumpCount lam a ≤ jswJumpCount (lam / 3) b +
      ENNReal.ofReal (9 / lam ^ 2) * ∑' j, ‖a j - b j‖ₑ ^ (2 : ℝ) := by
  classical
  refine iSup_le fun N => iSup_le fun s => iSup_le fun t => iSup_le fun h1 =>
    iSup_le fun h2 => iSup_le fun h3 => ?_
  set G := Finset.univ.filter fun i : Fin N => lam / 3 < ‖b (t i) - b (s i)‖ with hG
  set B := Finset.univ.filter fun i : Fin N => ¬ lam / 3 < ‖b (t i) - b (s i)‖ with hB
  have hcard : (N : ℝ≥0∞) = G.card + B.card := by
    have := Finset.card_filter_add_card_filter_not
      (s := (Finset.univ : Finset (Fin N))) (fun i : Fin N => lam / 3 < ‖b (t i) - b (s i)‖)
    rw [Finset.card_univ, Fintype.card_fin] at this
    exact_mod_cast this.symm
  have hGle : (G.card : ℝ≥0∞) ≤ jswJumpCount (lam / 3) b :=
    jsw_card_le_jumpCount h2 G h1 fun i hi => (Finset.mem_filter.1 hi).2
  -- bad jumps have an endpoint where `|a - b| > λ/3`
  have hbad : ∀ i ∈ B, ∃ e : ℤ, (e = s i ∨ e = t i) ∧ lam / 3 < ‖a e - b e‖ := by
    intro i hi
    have hb := (Finset.mem_filter.1 hi).2
    by_contra hc
    push Not at hc
    have h4 := hc (t i) (Or.inr rfl)
    have h5 := hc (s i) (Or.inl rfl)
    have : ‖a (t i) - a (s i)‖ ≤ ‖a (t i) - b (t i)‖ + ‖b (t i) - b (s i)‖ +
        ‖b (s i) - a (s i)‖ := by
      calc ‖a (t i) - a (s i)‖ = ‖(a (t i) - b (t i)) + (b (t i) - b (s i)) +
            (b (s i) - a (s i))‖ := by congr 1; ring
        _ ≤ _ := norm_add₃_le
    rw [norm_sub_rev (b (s i))] at this
    have := h3 i
    linarith [not_lt.1 hb]
  choose! e he using hbad
  have hinj : Set.InjOn e B := by
    intro i hi i' hi' hee
    by_contra hne
    obtain ⟨d1, d2, d3⟩ := jsw_endpoints_ne h1 h2 hne
    obtain ⟨d4, _, d6⟩ := jsw_endpoints_ne h1 h2 (Ne.symm hne)
    rcases (he i hi).1 with h | h <;> rcases (he i' hi').1 with h' | h' <;>
      rw [h, h'] at hee
    · exact d1 hee
    · exact d3 hee
    · exact d6 hee.symm
    · exact d2 hee
  set c : ℝ≥0∞ := ENNReal.ofReal ((lam / 3) ^ 2) with hc
  have hc0 : c ≠ 0 := by rw [hc]; exact (ENNReal.ofReal_pos.2 (by positivity)).ne'
  have hBle : (B.card : ℝ≥0∞) * c ≤ ∑' j, ‖a j - b j‖ₑ ^ (2 : ℝ) := by
    calc (B.card : ℝ≥0∞) * c = ∑ i ∈ B, c := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ i ∈ B, ‖a (e i) - b (e i)‖ₑ ^ (2 : ℝ) := by
          refine Finset.sum_le_sum fun i hi => ?_
          rw [hc, ← ofReal_norm, ENNReal.rpow_two, ← ENNReal.ofReal_pow (norm_nonneg _)]
          exact ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ (by positivity)
            (he i hi).2.le 2)
      _ = ∑ j ∈ B.image e, ‖a j - b j‖ₑ ^ (2 : ℝ) :=
        (Finset.sum_image (f := fun j => ‖a j - b j‖ₑ ^ (2 : ℝ)) hinj).symm
      _ ≤ _ := ENNReal.sum_le_tsum _
  have hBle' : (B.card : ℝ≥0∞) ≤ ENNReal.ofReal (9 / lam ^ 2) * ∑' j, ‖a j - b j‖ₑ ^ (2 : ℝ) := by
    have h9 : ENNReal.ofReal (9 / lam ^ 2) = c⁻¹ := by
      rw [hc, ← ENNReal.ofReal_inv_of_pos (by positivity)]
      congr 1; field_simp; ring
    rw [h9]
    calc (B.card : ℝ≥0∞) = B.card * c * c⁻¹ := by
          rw [mul_assoc, ENNReal.mul_inv_cancel hc0 ENNReal.ofReal_ne_top, mul_one]
      _ ≤ (∑' j, ‖a j - b j‖ₑ ^ (2 : ℝ)) * c⁻¹ := by gcongr
      _ = _ := mul_comm _ _
  rw [hcard]
  exact add_le_add hGle hBle'

/-- Square-root form of the comparison:
`λ N_λ(a)^{1/2} ≤ 3 (λ/3) N_{λ/3}(b)^{1/2} + 3 (∑_j |a_j - b_j|²)^{1/2}`. -/
theorem jsw_jump_sqrt_le {lam : ℝ} (hlam : 0 < lam) (a b : ℤ → ℂ) :
    ENNReal.ofReal lam * jswJumpCount lam a ^ (1 / 2 : ℝ) ≤
      3 * (ENNReal.ofReal (lam / 3) * jswJumpCount (lam / 3) b ^ (1 / 2 : ℝ)) +
        3 * (∑' j, ‖a j - b j‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
  have h := jswJumpCount_le_add hlam a b
  have h1 : jswJumpCount lam a ^ (1 / 2 : ℝ) ≤ jswJumpCount (lam / 3) b ^ (1 / 2 : ℝ) +
      ENNReal.ofReal (3 / lam) * (∑' j, ‖a j - b j‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
    refine (ENNReal.rpow_le_rpow h (by norm_num)).trans ((ENNReal.rpow_add_le_add_rpow _ _
      (by norm_num) (by norm_num)).trans_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
    congr 3
    rw [show 9 / lam ^ 2 = (3 / lam) ^ 2 by ring, ← Real.sqrt_eq_rpow,
      Real.sqrt_sq (by positivity)]
  calc ENNReal.ofReal lam * jswJumpCount lam a ^ (1 / 2 : ℝ)
      ≤ ENNReal.ofReal lam * (jswJumpCount (lam / 3) b ^ (1 / 2 : ℝ) +
        ENNReal.ofReal (3 / lam) * (∑' j, ‖a j - b j‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) := by gcongr
    _ = _ := by
        have e1 : (3 : ℝ≥0∞) * ENNReal.ofReal (lam / 3) = ENNReal.ofReal lam := by
          rw [← ENNReal.ofReal_ofNat 3, ← ENNReal.ofReal_mul (by norm_num)]; congr 1; ring
        have e2 : ENNReal.ofReal 3 = 3 := by simp
        rw [mul_add, ← mul_assoc, ← mul_assoc, ← ENNReal.ofReal_mul hlam.le,
          mul_div_cancel₀ _ hlam.ne', e1, e2]

end JswA

section JswB

variable {n : ℕ}

/-! ### Admissible kernels -/

/-- The envelope `(1 + |x|)^{-(n+1)}`. -/
def jswEnv (n : ℕ) (x : EuclideanSpace ℝ (Fin n)) : ℝ := ((1 + ‖x‖) ^ (n + 1))⁻¹

/-- Admissible kernels: continuous, `∫ φ = 1`, `|φ(x)| ≤ A (1 + |x|)^{-(n+2)}` and
`|φ(x + h) - φ(x)| ≤ A |h| (1 + |x|)^{-(n+1)}` for `|h| ≤ √n`. -/
structure JswAdm (n : ℕ) (A : ℝ) (φ : EuclideanSpace ℝ (Fin n) → ℂ) : Prop where
  nonneg : 0 ≤ A
  cont : Continuous φ
  integral_eq : ∫ x, φ x = 1
  size : ∀ x, ‖φ x‖ * (1 + ‖x‖) ^ (n + 2) ≤ A
  lip : ∀ x h, ‖h‖ ≤ Real.sqrt n → ‖φ (x + h) - φ x‖ * (1 + ‖x‖) ^ (n + 1) ≤ A * ‖h‖

lemma jswEnv_pos (x : EuclideanSpace ℝ (Fin n)) : 0 < jswEnv n x := by
  unfold jswEnv; positivity

lemma jswEnv_eq_rpow (x : EuclideanSpace ℝ (Fin n)) :
    jswEnv n x = (1 + ‖x‖) ^ (-((n : ℝ) + 1)) := by
  rw [jswEnv, Real.rpow_neg (by positivity), ← Real.rpow_natCast]; push_cast; rfl

lemma jsw_integrable_env : Integrable (jswEnv n) := by
  have h := integrable_one_add_norm (E := EuclideanSpace ℝ (Fin n)) (μ := volume)
    (r := (n : ℝ) + 1) (by rw [finrank_euclideanSpace_fin]; linarith)
  refine h.congr (Eventually.of_forall fun x => ?_)
  exact (jswEnv_eq_rpow x).symm

lemma jsw_measurable_env : Measurable (jswEnv n) := by
  unfold jswEnv; fun_prop

/-- The integral `I_n = ∫ (1 + |x|)^{-(n+1)} dx`. -/
def jswI (n : ℕ) : ℝ≥0∞ := ∫⁻ x, ENNReal.ofReal (jswEnv n x)

lemma jswI_lt_top : jswI n < ∞ := by
  have := (jsw_integrable_env (n := n)).2
  unfold HasFiniteIntegral at this
  refine lt_of_eq_of_lt ?_ this
  unfold jswI
  refine lintegral_congr fun x => ?_
  rw [Real.enorm_eq_ofReal (jswEnv_pos x).le]

lemma jswI_ne_top : jswI n ≠ ∞ := jswI_lt_top.ne

lemma jsw_two_zpow_pos (j : ℤ) : (0 : ℝ) < (2 : ℝ) ^ (j * n) := zpow_pos two_pos _

lemma jsw_pow_finrank (j : ℤ) :
    ((2 : ℝ) ^ j) ^ Module.finrank ℝ (EuclideanSpace ℝ (Fin n)) = (2 : ℝ) ^ (j * n) := by
  rw [finrank_euclideanSpace_fin, ← zpow_natCast, ← zpow_mul]

/-- Scaling: `∫ 2^{jn} g(2^j (x - y)) dx = ∫ g`. -/
lemma jsw_lintegral_dilate {g : EuclideanSpace ℝ (Fin n) → ℝ≥0∞} (hg : Measurable g) (j : ℤ)
    (y : EuclideanSpace ℝ (Fin n)) :
    ∫⁻ x, ENNReal.ofReal ((2 : ℝ) ^ (j * n)) * g ((2 : ℝ) ^ j • (x - y)) = ∫⁻ x, g x := by
  have hR : (2 : ℝ) ^ j ≠ 0 := (zpow_pos two_pos j).ne'
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    lintegral_sub_right_eq_self (fun x => g ((2 : ℝ) ^ j • x)) y]
  have hmap := Measure.map_addHaar_smul (volume : Measure (EuclideanSpace ℝ (Fin n))) hR
  have h1 : ∫⁻ x, g ((2 : ℝ) ^ j • x) =
      ∫⁻ x, g x ∂(Measure.map (fun x => (2 : ℝ) ^ j • x) volume) :=
    (lintegral_map hg (measurable_const_smul _)).symm
  rw [h1, hmap, lintegral_smul_measure, jsw_pow_finrank, smul_eq_mul, ← mul_assoc, abs_inv,
    abs_of_pos (jsw_two_zpow_pos j), ← ENNReal.ofReal_mul (jsw_two_zpow_pos j).le,
    mul_inv_cancel₀ (jsw_two_zpow_pos j).ne', ENNReal.ofReal_one, one_mul]

lemma jsw_lintegral_env_dilate (j : ℤ) (y : EuclideanSpace ℝ (Fin n)) :
    ∫⁻ x, ENNReal.ofReal ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • (x - y))) = jswI n := by
  have := jsw_lintegral_dilate (g := fun x => ENNReal.ofReal (jswEnv n x))
    (ENNReal.measurable_ofReal.comp jsw_measurable_env) j y
  rw [jswI, ← this]
  refine lintegral_congr fun x => ?_
  rw [ENNReal.ofReal_mul (jsw_two_zpow_pos j).le]

/-! ### Properties of the dilates -/

variable {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

lemma jswDilate_eq (φ : EuclideanSpace ℝ (Fin n) → ℂ) (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    jswDilate n φ j x = (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) * φ ((2 : ℝ) ^ j • x) := by
  rw [jswDilate, Complex.real_smul]

lemma jsw_norm_dilate (φ : EuclideanSpace ℝ (Fin n) → ℂ) (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    ‖jswDilate n φ j x‖ = (2 : ℝ) ^ (j * n) * ‖φ ((2 : ℝ) ^ j • x)‖ := by
  rw [jswDilate, norm_smul, Real.norm_of_nonneg (jsw_two_zpow_pos j).le]

lemma jsw_norm_smul (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    ‖(2 : ℝ) ^ j • x‖ = (2 : ℝ) ^ j * ‖x‖ := by
  rw [norm_smul, Real.norm_of_nonneg (zpow_pos two_pos j).le]

lemma jsw_continuous_dilate (hφ : Continuous φ) (j : ℤ) : Continuous (jswDilate n φ j) := by
  unfold jswDilate; fun_prop

lemma JswAdm.size' (h : JswAdm n A φ) (x : EuclideanSpace ℝ (Fin n)) :
    ‖φ x‖ * (1 + ‖x‖) ≤ A * jswEnv n x := by
  have := h.size x
  rw [jswEnv, ← div_eq_mul_inv, le_div_iff₀ (by positivity)]
  calc ‖φ x‖ * (1 + ‖x‖) * (1 + ‖x‖) ^ (n + 1) = ‖φ x‖ * (1 + ‖x‖) ^ (n + 2) := by ring
    _ ≤ A := this

lemma JswAdm.norm_le (h : JswAdm n A φ) (x : EuclideanSpace ℝ (Fin n)) :
    ‖φ x‖ ≤ A * jswEnv n x := by
  have := h.size' x
  nlinarith [norm_nonneg (φ x), norm_nonneg x]

/-- Size of the dilates, with the extra decay factor. -/
lemma JswAdm.dilate_size (h : JswAdm n A φ) (j : ℤ) (z : EuclideanSpace ℝ (Fin n)) :
    ‖jswDilate n φ j z‖ * (1 + (2 : ℝ) ^ j * ‖z‖) ≤
      A * ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • z)) := by
  rw [jsw_norm_dilate]
  have := h.size' ((2 : ℝ) ^ j • z)
  rw [jsw_norm_smul] at this
  have h2 := jsw_two_zpow_pos (n := n) j
  calc (2 : ℝ) ^ (j * n) * ‖φ ((2 : ℝ) ^ j • z)‖ * (1 + (2 : ℝ) ^ j * ‖z‖)
      = (2 : ℝ) ^ (j * n) * (‖φ ((2 : ℝ) ^ j • z)‖ * (1 + (2 : ℝ) ^ j * ‖z‖)) := by ring
    _ ≤ (2 : ℝ) ^ (j * n) * (A * jswEnv n ((2 : ℝ) ^ j • z)) := by gcongr
    _ = _ := by ring

lemma JswAdm.dilate_le (h : JswAdm n A φ) (j : ℤ) (z : EuclideanSpace ℝ (Fin n)) :
    ‖jswDilate n φ j z‖ ≤ A * ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • z)) := by
  have := h.dilate_size j z
  have h0 : 0 ≤ (2 : ℝ) ^ j * ‖z‖ := by positivity
  nlinarith [norm_nonneg (jswDilate n φ j z)]

/-- `∫ |φ_j| ≤ A I_n`. -/
lemma JswAdm.lintegral_dilate_le (h : JswAdm n A φ) (j : ℤ) :
    ∫⁻ z, ‖jswDilate n φ j z‖ₑ ≤ ENNReal.ofReal A * jswI n := by
  calc ∫⁻ z, ‖jswDilate n φ j z‖ₑ
      ≤ ∫⁻ z, ENNReal.ofReal A *
          ENNReal.ofReal ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • (z - 0))) := by
        refine lintegral_mono fun z => ?_
        rw [← ofReal_norm, ← ENNReal.ofReal_mul h.nonneg, sub_zero]
        exact ENNReal.ofReal_le_ofReal (h.dilate_le j z)
    _ = _ := by rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, jsw_lintegral_env_dilate]

lemma JswAdm.integrable_dilate (h : JswAdm n A φ) (j : ℤ) : Integrable (jswDilate n φ j) :=
  ⟨(jsw_continuous_dilate h.cont j).aestronglyMeasurable,
    (h.lintegral_dilate_le j).trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top jswI_lt_top)⟩

lemma JswAdm.integrable (h : JswAdm n A φ) : Integrable φ := by
  have := h.integrable_dilate 0
  refine this.congr (Eventually.of_forall fun x => ?_)
  simp [jswDilate]

lemma JswAdm.integral_dilate (h : JswAdm n A φ) (j : ℤ) : ∫ z, jswDilate n φ j z = 1 := by
  have hR : (0 : ℝ) ≤ (2 : ℝ) ^ j := (zpow_pos two_pos j).le
  simp only [jswDilate]
  rw [integral_smul, Measure.integral_comp_smul_of_nonneg volume φ ((2 : ℝ) ^ j) (hR := hR),
    h.integral_eq, jsw_pow_finrank, smul_smul, mul_inv_cancel₀ (jsw_two_zpow_pos j).ne',
    one_smul]

/-- Tail bound: `∫_{|z| ≥ R} |φ_j| ≤ A I_n / (2^j R)`. -/
lemma JswAdm.lintegral_tail_le (h : JswAdm n A φ) (j : ℤ) {R : ℝ} (hR : 0 < R) :
    ∫⁻ z in {z | R ≤ ‖z‖}, ‖jswDilate n φ j z‖ₑ ≤
      ENNReal.ofReal (A / ((2 : ℝ) ^ j * R)) * jswI n := by
  have h2 : 0 < (2 : ℝ) ^ j := zpow_pos two_pos j
  calc ∫⁻ z in {z | R ≤ ‖z‖}, ‖jswDilate n φ j z‖ₑ
      ≤ ∫⁻ z in {z | R ≤ ‖z‖}, ENNReal.ofReal (A / ((2 : ℝ) ^ j * R)) *
          ENNReal.ofReal ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • (z - 0))) := by
        refine setLIntegral_mono' (measurableSet_le measurable_const measurable_norm)
          fun z hz => ?_
        rw [← ofReal_norm, ← ENNReal.ofReal_mul (by have := h.nonneg; positivity), sub_zero]
        refine ENNReal.ofReal_le_ofReal ?_
        have hz' : R ≤ ‖z‖ := hz
        have h3 := h.dilate_size j z
        have h4 : (2 : ℝ) ^ j * R ≤ 1 + (2 : ℝ) ^ j * ‖z‖ := by nlinarith
        rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
        calc ‖jswDilate n φ j z‖ * ((2 : ℝ) ^ j * R)
            ≤ ‖jswDilate n φ j z‖ * (1 + (2 : ℝ) ^ j * ‖z‖) := by gcongr
          _ ≤ _ := h3
    _ ≤ ∫⁻ z, ENNReal.ofReal (A / ((2 : ℝ) ^ j * R)) *
          ENNReal.ofReal ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • (z - 0))) :=
        setLIntegral_le_lintegral _ _
    _ = _ := by rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, jsw_lintegral_env_dilate]

/-- First moment: `∫ |φ_j(z)| |z| dz ≤ A I_n 2^{-j}`. -/
lemma JswAdm.lintegral_moment_le (h : JswAdm n A φ) (j : ℤ) :
    ∫⁻ z, ‖jswDilate n φ j z‖ₑ * ENNReal.ofReal ‖z‖ ≤
      ENNReal.ofReal (A / (2 : ℝ) ^ j) * jswI n := by
  have h2 : 0 < (2 : ℝ) ^ j := zpow_pos two_pos j
  calc ∫⁻ z, ‖jswDilate n φ j z‖ₑ * ENNReal.ofReal ‖z‖
      ≤ ∫⁻ z, ENNReal.ofReal (A / (2 : ℝ) ^ j) *
          ENNReal.ofReal ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • (z - 0))) := by
        refine lintegral_mono fun z => ?_
        rw [← ofReal_norm, ← ENNReal.ofReal_mul (norm_nonneg _),
          ← ENNReal.ofReal_mul (by have := h.nonneg; positivity), sub_zero]
        refine ENNReal.ofReal_le_ofReal ?_
        have h3 := h.dilate_size j z
        rw [div_mul_eq_mul_div, le_div_iff₀ h2]
        calc ‖jswDilate n φ j z‖ * ‖z‖ * (2 : ℝ) ^ j
            ≤ ‖jswDilate n φ j z‖ * (1 + (2 : ℝ) ^ j * ‖z‖) := by
              have := norm_nonneg (jswDilate n φ j z); nlinarith [norm_nonneg z]
          _ ≤ _ := h3
    _ = _ := by rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, jsw_lintegral_env_dilate]

/-- Smoothness of the dilates: for `2^j |y - c| ≤ √n`,
`|φ_j(x - c) - φ_j(x - y)| ≤ A 2^j |y - c| 2^{jn} (1 + 2^j |x - y|)^{-(n+1)}`. -/
lemma JswAdm.dilate_sub_le (h : JswAdm n A φ) (j : ℤ) {x y c : EuclideanSpace ℝ (Fin n)}
    (hyc : (2 : ℝ) ^ j * ‖y - c‖ ≤ Real.sqrt n) :
    ‖jswDilate n φ j (x - c) - jswDilate n φ j (x - y)‖ ≤
      A * ((2 : ℝ) ^ j * ‖y - c‖) * ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • (x - y))) := by
  set u := (2 : ℝ) ^ j • (x - y)
  set v := (2 : ℝ) ^ j • (y - c)
  have huv : (2 : ℝ) ^ j • (x - c) = u + v := by
    simp only [u, v, ← smul_add]; congr 1; abel
  have hv : ‖v‖ = (2 : ℝ) ^ j * ‖y - c‖ := jsw_norm_smul j _
  have hl := h.lip u v (by rw [hv]; exact hyc)
  rw [jswDilate, jswDilate, huv, ← smul_sub, norm_smul,
    Real.norm_of_nonneg (jsw_two_zpow_pos j).le, ← hv]
  have h1 : ‖φ (u + v) - φ u‖ ≤ A * ‖v‖ * jswEnv n u := by
    rw [jswEnv, ← div_eq_mul_inv, le_div_iff₀ (by positivity)]; exact hl
  have := jsw_two_zpow_pos (n := n) j
  calc (2 : ℝ) ^ (j * n) * ‖φ (u + v) - φ u‖ ≤ (2 : ℝ) ^ (j * n) * (A * ‖v‖ * jswEnv n u) := by
        gcongr
    _ = _ := by ring

/-! ### Schwartz kernels and adjoints are admissible -/

/-- Schwartz functions with integral `1` are admissible. -/
theorem jswAdm_of_schwartz (φ : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ)
    (hφ : ∫ x, φ x = 1) : ∃ A, JswAdm n A φ := by
  set S0 : ℝ := 2 ^ (n + 2) *
    ((Finset.Iic ((n + 2, 1) : ℕ × ℕ)).sup fun m => SchwartzMap.seminorm ℝ m.1 m.2) φ
  have hS0 : 0 ≤ S0 := by positivity
  have hsz : ∀ x, ‖φ x‖ * (1 + ‖x‖) ^ (n + 2) ≤ S0 := by
    intro x
    have := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((n + 2, 1) : ℕ × ℕ))
      (k := n + 2) (n := 0) le_rfl (Nat.zero_le _) φ x
    rw [norm_iteratedFDeriv_zero] at this
    linarith
  have hder : ∀ z, ‖fderiv ℝ φ z‖ * (1 + ‖z‖) ^ (n + 1) ≤ S0 := by
    intro z
    have := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((n + 2, 1) : ℕ × ℕ))
      (k := n + 1) (n := 1) (by simp) le_rfl φ z
    rw [norm_iteratedFDeriv_one] at this
    linarith
  set A : ℝ := S0 * (1 + Real.sqrt n) ^ (n + 1)
  have hA : S0 ≤ A := le_mul_of_one_le_right hS0 (one_le_pow₀ (by
    have := Real.sqrt_nonneg n; linarith))
  refine ⟨A, ⟨hS0.trans hA, φ.continuous, hφ, fun x => (hsz x).trans hA, fun x h hh => ?_⟩⟩
  have hx1 : 0 < (1 + ‖x‖) ^ (n + 1) := by positivity
  set C := S0 * (1 + Real.sqrt n) ^ (n + 1) / (1 + ‖x‖) ^ (n + 1)
  have hbd : ∀ z ∈ segment ℝ x (x + h), ‖fderiv ℝ φ z‖ ≤ C := by
    intro z hz
    have hzx : ‖z - x‖ ≤ ‖h‖ := by
      have := norm_sub_le_of_mem_segment hz
      simpa using this
    have h1 : 1 + ‖x‖ ≤ (1 + ‖z‖) * (1 + Real.sqrt n) := by
      have : ‖x‖ ≤ ‖z‖ + ‖z - x‖ := by
        calc ‖x‖ = ‖z - (z - x)‖ := by rw [sub_sub_cancel]
          _ ≤ ‖z‖ + ‖z - x‖ := norm_sub_le _ _
      have := Real.sqrt_nonneg n
      nlinarith [norm_nonneg z]
    have h2 : (1 + ‖x‖) ^ (n + 1) ≤ (1 + ‖z‖) ^ (n + 1) * (1 + Real.sqrt n) ^ (n + 1) := by
      rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) h1 _
    rw [le_div_iff₀ hx1]
    calc ‖fderiv ℝ φ z‖ * (1 + ‖x‖) ^ (n + 1)
        ≤ ‖fderiv ℝ φ z‖ * ((1 + ‖z‖) ^ (n + 1) * (1 + Real.sqrt n) ^ (n + 1)) := by gcongr
      _ = ‖fderiv ℝ φ z‖ * (1 + ‖z‖) ^ (n + 1) * (1 + Real.sqrt n) ^ (n + 1) := by ring
      _ ≤ S0 * (1 + Real.sqrt n) ^ (n + 1) := by gcongr; exact hder z
  have hmv := (convex_segment x (x + h)).norm_image_sub_le_of_norm_fderiv_le
    (fun z _ => (φ.differentiable z)) hbd (left_mem_segment ℝ x (x + h))
    (right_mem_segment ℝ x (x + h))
  rw [add_sub_cancel_left] at hmv
  calc ‖φ (x + h) - φ x‖ * (1 + ‖x‖) ^ (n + 1) ≤ C * ‖h‖ * (1 + ‖x‖) ^ (n + 1) := by gcongr
    _ = A * ‖h‖ := by simp only [C, A]; field_simp

/-- The adjoint kernel `φ*(x) = conj φ(-x)` is admissible with the same constant. -/
theorem JswAdm.adjoint (h : JswAdm n A φ) : JswAdm n A (czAdjoint φ) := by
  refine ⟨h.nonneg, ?_, ?_, fun x => ?_, fun x v hv => ?_⟩
  · exact Complex.continuous_conj.comp (h.cont.comp continuous_neg)
  · simp only [czAdjoint]
    rw [integral_conj, integral_neg_eq_self, h.integral_eq, map_one]
  · simpa [czAdjoint, norm_neg] using h.size (-x)
  · have := h.lip (-x) (-v) (by rwa [norm_neg])
    simp only [czAdjoint, norm_neg] at this ⊢
    rw [← map_sub, Complex.norm_conj, neg_add]
    exact this

lemma jsw_czAdjoint_dilate (φ : EuclideanSpace ℝ (Fin n) → ℂ) (j : ℤ) :
    czAdjoint (jswDilate n φ j) = jswDilate n (czAdjoint φ) j := by
  funext x
  simp only [czAdjoint, jswDilate_eq, map_mul, Complex.conj_ofReal, smul_neg]

end JswB

section JswC

variable {n : ℕ}

/-! ### Dyadic cubes and dyadic averages -/

lemma jsw_div_zpow_neg (j : ℤ) (a : ℝ) : a / (2 : ℝ) ^ (-j) = (2 : ℝ) ^ j * a := by
  rw [zpow_neg, div_inv_eq_mul, mul_comm]

lemma jsw_dyadicCube_eq_czCube (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    dyadicCube n j x = czCube (-j, czDyIdx (-j) x) := by
  ext y
  change (∀ i, ⌊(2 : ℝ) ^ j * y i⌋ = ⌊(2 : ℝ) ^ j * x i⌋) ↔ czDyIdx (-j) y = czDyIdx (-j) x
  rw [funext_iff]
  simp only [czDyIdx, jsw_div_zpow_neg]

lemma jsw_dyadicAvg_eq (j : ℤ) (f : EuclideanSpace ℝ (Fin n) → ℂ) (x : EuclideanSpace ℝ (Fin n)) :
    dyadicAvg n j f x =
      (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) * ∫ y in czCube (-j, czDyIdx (-j) x), f y := by
  rw [dyadicAvg, jsw_dyadicCube_eq_czCube]

/-- `w` is constant on the dyadic cubes of side `2^{-j}` (measurable w.r.t. the `j`-th dyadic
σ-algebra). -/
def JswMeas {α : Type*} (j : ℤ) (w : EuclideanSpace ℝ (Fin n) → α) : Prop :=
  ∀ x y, czDyIdx (-j) x = czDyIdx (-j) y → w x = w y

lemma JswMeas.mono {α : Type*} {j k : ℤ} {w : EuclideanSpace ℝ (Fin n) → α} (h : JswMeas j w)
    (hjk : j ≤ k) : JswMeas k w := fun x y hxy =>
  h x y (czDyIdx_eq_of_le (k := -k) (k' := -j) (by omega) (x := y) (y := x) hxy)

lemma JswMeas.measurable {α : Type*} [MeasurableSpace α] {j : ℤ}
    {w : EuclideanSpace ℝ (Fin n) → α} (h : JswMeas j w) : Measurable w :=
  lep_measurable_of_factor (measurable_czDyIdx (-j)) h

lemma jswMeas_dyadicAvg (j : ℤ) (f : EuclideanSpace ℝ (Fin n) → ℂ) :
    JswMeas j (dyadicAvg n j f) := fun x y h => by
  rw [jsw_dyadicAvg_eq, jsw_dyadicAvg_eq, h]

lemma jsw_measurable_dyadicAvg (j : ℤ) (f : EuclideanSpace ℝ (Fin n) → ℂ) :
    Measurable (dyadicAvg n j f) :=
  (jswMeas_dyadicAvg j f).measurable

lemma JswMeas.sub {j : ℤ} {u v : EuclideanSpace ℝ (Fin n) → ℂ} (hu : JswMeas j u)
    (hv : JswMeas j v) : JswMeas j (u - v) := fun x y h => by
  simp only [Pi.sub_apply, hu x y h, hv x y h]

lemma jswMeas_indicator (k : ℤ) (i : Fin n → ℤ) (c : ℂ) :
    JswMeas k ((czCube (-k, i)).indicator fun _ => c) := fun x y h => by
  have : x ∈ czCube (-k, i) ↔ y ∈ czCube (-k, i) := by
    change czDyIdx (-k) x = i ↔ czDyIdx (-k) y = i
    rw [h]
  by_cases hx : x ∈ czCube (-k, i)
  · rw [indicator_of_mem hx, indicator_of_mem (this.1 hx)]
  · rw [indicator_of_notMem hx, indicator_of_notMem (fun hy => hx (this.2 hy))]

lemma jsw_iUnion_czCube (k : ℤ) : ⋃ i : Fin n → ℤ, czCube (k, i) = univ :=
  eq_univ_of_forall fun x => mem_iUnion.2 ⟨czDyIdx k x, mem_czCube_self k x⟩

lemma jsw_pairwise_czCube (k : ℤ) :
    Pairwise (Function.onFun Disjoint fun i : Fin n → ℤ => czCube (k, i)) :=
  fun _ _ h => Set.disjoint_left.2 fun _ hx hx' => h (hx.symm.trans hx')

lemma jsw_lintegral_eq_tsum (k : ℤ) (F : EuclideanSpace ℝ (Fin n) → ℝ≥0∞) :
    ∫⁻ x, F x = ∑' i : Fin n → ℤ, ∫⁻ x in czCube (k, i), F x := by
  rw [← lintegral_iUnion (fun i => measurableSet_czCube _) (jsw_pairwise_czCube k),
    jsw_iUnion_czCube, Measure.restrict_univ]

lemma jsw_integral_eq_tsum (k : ℤ) {F : EuclideanSpace ℝ (Fin n) → ℂ} (hF : Integrable F) :
    ∫ x, F x = ∑' i : Fin n → ℤ, ∫ x in czCube (k, i), F x := by
  rw [← integral_iUnion (fun i => measurableSet_czCube _) (jsw_pairwise_czCube k)
    (by rw [jsw_iUnion_czCube]; exact hF.integrableOn), jsw_iUnion_czCube, setIntegral_univ]

lemma jsw_ofReal_mul_volume (j : ℤ) (i : Fin n → ℤ) :
    ENNReal.ofReal ((2 : ℝ) ^ (j * n)) * volume (czCube (-j, i)) = 1 := by
  rw [volume_czCube, ← ENNReal.ofReal_pow (zpow_pos two_pos _).le,
    ← ENNReal.ofReal_mul (jsw_two_zpow_pos j).le, ← zpow_natCast, ← zpow_mul,
    ← zpow_add₀ two_ne_zero]
  simp

lemma jsw_mul_measureReal (j : ℤ) (i : Fin n → ℤ) :
    (2 : ℝ) ^ (j * n) * volume.real (czCube (-j, i)) = 1 := by
  have := congrArg ENNReal.toReal (jsw_ofReal_mul_volume (n := n) j i)
  rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal (jsw_two_zpow_pos j).le,
    ENNReal.toReal_one] at this

lemma jsw_mem_czCube_iff {k : ℤ} {i : Fin n → ℤ} {x : EuclideanSpace ℝ (Fin n)} :
    x ∈ czCube (k, i) ↔ czDyIdx k x = i := Iff.rfl

lemma jsw_dyadicAvg_of_mem {j : ℤ} {i : Fin n → ℤ} {x : EuclideanSpace ℝ (Fin n)}
    (hx : x ∈ czCube (-j, i)) (f : EuclideanSpace ℝ (Fin n) → ℂ) :
    dyadicAvg n j f x = (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) * ∫ y in czCube (-j, i), f y := by
  rw [jsw_dyadicAvg_eq, jsw_mem_czCube_iff.1 hx]

/-- The dyadic averages are contractions on `L^p`, `1 ≤ p < ∞`. -/
theorem jsw_lintegral_dyadicAvg_rpow_le {p : ℝ} (hp : 1 ≤ p) (j : ℤ)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : AEStronglyMeasurable f volume) :
    ∫⁻ x, ‖dyadicAvg n j f x‖ₑ ^ p ≤ ∫⁻ x, ‖f x‖ₑ ^ p := by
  have hp0 : 0 < p := by linarith
  rw [jsw_lintegral_eq_tsum (-j), jsw_lintegral_eq_tsum (-j) (fun x => ‖f x‖ₑ ^ p)]
  refine ENNReal.tsum_le_tsum fun i => ?_
  set Q := czCube (n := n) (-j, i)
  set V := volume Q
  have hV0 : V ≠ 0 := volume_czCube_ne_zero _
  have hVt : V ≠ ∞ := volume_czCube_ne_top _
  have hc : ENNReal.ofReal ((2 : ℝ) ^ (j * n)) = V⁻¹ :=
    ENNReal.eq_inv_of_mul_eq_one_left (jsw_ofReal_mul_volume j i)
  have hconst : ∫⁻ x in Q, ‖dyadicAvg n j f x‖ₑ ^ p =
      (V⁻¹ * ‖∫ y in Q, f y‖ₑ) ^ p * V := by
    rw [setLIntegral_congr_fun (measurableSet_czCube _) (fun x hx => by
      rw [jsw_dyadicAvg_of_mem hx f]), setLIntegral_const, enorm_mul, ← ofReal_norm,
      Complex.norm_real, Real.norm_of_nonneg (jsw_two_zpow_pos j).le, hc]
  rw [hconst, ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
  have hH := lep_holder_set (Q := Q) hp hf
  calc V⁻¹ ^ p * ‖∫ y in Q, f y‖ₑ ^ p * V
      ≤ V⁻¹ ^ p * (V ^ (p - 1) * ∫⁻ y in Q, ‖f y‖ₑ ^ p) * V := by gcongr
    _ = (V⁻¹ ^ p * (V ^ (p - 1) * V)) * ∫⁻ y in Q, ‖f y‖ₑ ^ p := by ring
    _ = ∫⁻ y in Q, ‖f y‖ₑ ^ p := by
        have e : V ^ (p - 1) * V = V ^ p := by
          have := ENNReal.rpow_add (p - 1) 1 hV0 hVt
          rw [sub_add_cancel, ENNReal.rpow_one] at this
          exact this.symm
        rw [e, ENNReal.inv_rpow,
          ENNReal.inv_mul_cancel (ENNReal.rpow_pos (pos_iff_ne_zero.2 hV0) hVt).ne'
            (ENNReal.rpow_ne_top_of_nonneg hp0.le hVt), one_mul]

theorem jsw_eLpNorm_dyadicAvg_le {p : ℝ} (hp : 1 ≤ p) (j : ℤ)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : AEStronglyMeasurable f volume) :
    eLpNorm (dyadicAvg n j f) (ENNReal.ofReal p) volume ≤
      eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := by linarith
  rw [eLpNorm_ofReal_eq_lintegral (jsw_measurable_dyadicAvg j f).aestronglyMeasurable hp0,
    eLpNorm_ofReal_eq_lintegral hf hp0]
  exact ENNReal.rpow_le_rpow (jsw_lintegral_dyadicAvg_rpow_le hp j hf) (by positivity)

theorem jsw_memLp_dyadicAvg {p : ℝ} (hp : 1 ≤ p) (j : ℤ)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (dyadicAvg n j f) (ENNReal.ofReal p) volume :=
  (jsw_eLpNorm_dyadicAvg_le hp j hf.aestronglyMeasurable).trans_lt hf

theorem jsw_eLpNorm_two_dyadicAvg_le (j : ℤ) {f : EuclideanSpace ℝ (Fin n) → ℂ}
    (hf : AEStronglyMeasurable f volume) :
    eLpNorm (dyadicAvg n j f) 2 volume ≤ eLpNorm f 2 volume := by
  have := jsw_eLpNorm_dyadicAvg_le (p := 2) (by norm_num) j hf
  rwa [ENNReal.ofReal_ofNat] at this

theorem jsw_memLp_two_dyadicAvg (j : ℤ) {f : EuclideanSpace ℝ (Fin n) → ℂ}
    (hf : MemLp f 2 volume) : MemLp (dyadicAvg n j f) 2 volume :=
  (jsw_eLpNorm_two_dyadicAvg_le j hf.aestronglyMeasurable).trans_lt hf

lemma jsw_integrableOn_czCube {p : ℝ≥0∞} (hp : 1 ≤ p) {f : EuclideanSpace ℝ (Fin n) → ℂ}
    (hf : MemLp f p volume) (k : ℤ) (i : Fin n → ℤ) : IntegrableOn f (czCube (k, i)) := by
  have : IsFiniteMeasure (volume.restrict (czCube (n := n) (k, i))) :=
    isFiniteMeasure_restrict.2 (volume_czCube_ne_top _)
  exact (hf.restrict _).integrable hp

lemma jsw_dyadicAvg_add {j : ℤ} {f g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hf : ∀ i, IntegrableOn f (czCube (-j, i))) (hg : ∀ i, IntegrableOn g (czCube (-j, i)))
    (x : EuclideanSpace ℝ (Fin n)) :
    dyadicAvg n j (f + g) x = dyadicAvg n j f x + dyadicAvg n j g x := by
  simp only [jsw_dyadicAvg_eq, Pi.add_apply]
  rw [integral_add (hf _) (hg _), mul_add]

lemma jsw_dyadicAvg_sub {j : ℤ} {f g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hf : ∀ i, IntegrableOn f (czCube (-j, i))) (hg : ∀ i, IntegrableOn g (czCube (-j, i)))
    (x : EuclideanSpace ℝ (Fin n)) :
    dyadicAvg n j (f - g) x = dyadicAvg n j f x - dyadicAvg n j g x := by
  simp only [jsw_dyadicAvg_eq, Pi.sub_apply]
  rw [integral_sub (hf _) (hg _), mul_sub]

lemma jsw_dyadicAvg_congr_ae {j : ℤ} {f g : EuclideanSpace ℝ (Fin n) → ℂ}
    (h : f =ᵐ[volume] g) : dyadicAvg n j f = dyadicAvg n j g := by
  funext x
  simp only [dyadicAvg]
  rw [integral_congr_ae (ae_restrict_of_ae h)]

/-- Averages of functions that are constant on the dyadic cubes of side `2^{-j}`. -/
lemma jsw_dyadicAvg_of_jswMeas {j : ℤ} {g : EuclideanSpace ℝ (Fin n) → ℂ} (hg : JswMeas j g)
    (x : EuclideanSpace ℝ (Fin n)) : dyadicAvg n j g x = g x := by
  rw [jsw_dyadicAvg_eq, setIntegral_congr_fun (measurableSet_czCube _)
    (fun y (hy : y ∈ czCube (-j, czDyIdx (-j) x)) => hg y x hy), setIntegral_const,
    Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul, jsw_mul_measureReal,
    Complex.ofReal_one, one_mul]

lemma jsw_integrable_mul_conj {p q : ℝ} (hpq : p.HolderConjugate q)
    {u v : EuclideanSpace ℝ (Fin n) → ℂ} (hu : MemLp u (ENNReal.ofReal p) volume)
    (hv : MemLp v (ENNReal.ofReal q) volume) : Integrable (fun x => u x * conj (v x)) := by
  have := hpq.ennrealOfReal
  exact hu.integrable_mul hv.star

/-- Orthogonality: `∫ w̄ (v - E_j v) = 0` if `w` is constant on the dyadic cubes of side
`2^{-j}`, `w ∈ L^q`, `v ∈ L^p`. -/
theorem jsw_integral_conj_mul_sub_dyadicAvg {p q : ℝ} (hpq : p.HolderConjugate q) {j : ℤ}
    {w v : EuclideanSpace ℝ (Fin n) → ℂ} (hw : JswMeas j w)
    (hwq : MemLp w (ENNReal.ofReal q) volume) (hv : MemLp v (ENNReal.ofReal p) volume) :
    ∫ x, conj (w x) * (v x - dyadicAvg n j v x) = 0 := by
  have hp1 : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hpq.lt.le
  have hEv := jsw_memLp_dyadicAvg hpq.lt.le j hv
  have hI : Integrable fun x => conj (w x) * (v x - dyadicAvg n j v x) := by
    have := jsw_integrable_mul_conj hpq (u := fun x => v x - dyadicAvg n j v x)
      (hv.sub hEv) hwq
    refine this.congr (Eventually.of_forall fun x => ?_)
    ring
  rw [jsw_integral_eq_tsum (-j) hI]
  refine (tsum_congr fun i => ?_).trans tsum_zero
  set Q := czCube (n := n) (-j, i)
  set c := czCorner (n := n) (-j, i)
  have hc : c ∈ Q := czCorner_mem _
  have hvQ : IntegrableOn v Q := jsw_integrableOn_czCube hp1 hv _ _
  rw [setIntegral_congr_fun (measurableSet_czCube _) (fun x (hx : x ∈ Q) => by
    rw [hw x c (hx.trans hc.symm), jsw_dyadicAvg_of_mem hx v])]
  rw [integral_const_mul, integral_sub hvQ (integrableOn_const (volume_czCube_ne_top _)),
    setIntegral_const, Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul,
    mul_comm (volume.real Q),
    jsw_mul_measureReal, Complex.ofReal_one, one_mul, sub_self, mul_zero]

/-- The tower property `E_k E_j f = E_k f` for `k ≤ j`. -/
theorem jsw_dyadicAvg_dyadicAvg {p : ℝ} (hp : 1 < p) {k j : ℤ} (hkj : k ≤ j)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    dyadicAvg n k (dyadicAvg n j f) = dyadicAvg n k f := by
  funext x
  rw [jsw_dyadicAvg_eq, jsw_dyadicAvg_eq]
  congr 1
  set Q := czCube (n := n) (-k, czDyIdx (-k) x)
  have hpq : p.HolderConjugate p.conjExponent := Real.HolderConjugate.conjExponent hp
  have hp1 : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hw := (jswMeas_indicator k (czDyIdx (-k) x) (1 : ℂ)).mono hkj
  have hwq : MemLp (Q.indicator fun _ => (1 : ℂ)) (ENNReal.ofReal p.conjExponent) volume :=
    memLp_indicator_const _ (measurableSet_czCube _) _ (Or.inr (volume_czCube_ne_top _))
  have h0 := jsw_integral_conj_mul_sub_dyadicAvg hpq hw hwq hf
  have heq : (fun y => conj (Q.indicator (fun _ => (1 : ℂ)) y) * (f y - dyadicAvg n j f y)) =
      Q.indicator fun y => f y - dyadicAvg n j f y := by
    funext y
    by_cases hy : y ∈ Q
    · simp [indicator_of_mem hy]
    · simp [indicator_of_notMem hy]
  rw [heq, integral_indicator (measurableSet_czCube _),
    integral_sub (jsw_integrableOn_czCube hp1 hf _ _)
      (jsw_integrableOn_czCube hp1 (jsw_memLp_dyadicAvg hp.le j hf) _ _), sub_eq_zero] at h0
  exact h0.symm

/-- Self-adjointness of the dyadic averages: `∫ (E_j u) v̄ = ∫ u (E_j v)‾`. -/
theorem jsw_integral_dyadicAvg_mul_conj {p q : ℝ} (hpq : p.HolderConjugate q) (j : ℤ)
    {u v : EuclideanSpace ℝ (Fin n) → ℂ} (hu : MemLp u (ENNReal.ofReal p) volume)
    (hv : MemLp v (ENNReal.ofReal q) volume) :
    ∫ x, dyadicAvg n j u x * conj (v x) = ∫ x, u x * conj (dyadicAvg n j v x) := by
  have hEu := jsw_memLp_dyadicAvg hpq.lt.le j hu
  have hEv := jsw_memLp_dyadicAvg hpq.symm.lt.le j hv
  have h1 := jsw_integral_conj_mul_sub_dyadicAvg hpq.symm (jswMeas_dyadicAvg j u) hEu hv
  have h2 := jsw_integral_conj_mul_sub_dyadicAvg hpq (jswMeas_dyadicAvg j v) hEv hu
  have i1 := jsw_integrable_mul_conj hpq hEu hv
  have i2 := jsw_integrable_mul_conj hpq hEu hEv
  have i3 := jsw_integrable_mul_conj hpq hu hEv
  have e1 : ∫ x, dyadicAvg n j u x * conj (v x) = ∫ x, dyadicAvg n j u x *
      conj (dyadicAvg n j v x) := by
    have : ∫ x, (dyadicAvg n j u x * conj (v x) - dyadicAvg n j u x *
        conj (dyadicAvg n j v x)) = 0 := by
      have h1' := congrArg conj h1
      rw [← integral_conj, map_zero] at h1'
      rw [← h1']
      congr 1; funext x; simp only [map_mul, map_sub, Complex.conj_conj]; ring
    rwa [integral_sub i1 i2, sub_eq_zero] at this
  have e2 : ∫ x, u x * conj (dyadicAvg n j v x) = ∫ x, dyadicAvg n j u x *
      conj (dyadicAvg n j v x) := by
    have : ∫ x, (u x * conj (dyadicAvg n j v x) - dyadicAvg n j u x *
        conj (dyadicAvg n j v x)) = 0 := by
      rw [← h2]; congr 1; funext x; ring
    rwa [integral_sub i3 i2, sub_eq_zero] at this
  rw [e1, e2]

end JswC

section JswD

variable {n : ℕ}

/-! ### The difference operators `D_j = φ_j * · - E_j` -/

/-- `D_j f = φ_j * f - E_j f`. -/
def jswDiff (n : ℕ) (φ : EuclideanSpace ℝ (Fin n) → ℂ) (j : ℤ)
    (f : EuclideanSpace ℝ (Fin n) → ℂ) (x : EuclideanSpace ℝ (Fin n)) : ℂ :=
  (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x - dyadicAvg n j f x

variable {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

lemma jsw_convolution_sub {k f g : EuclideanSpace ℝ (Fin n) → ℂ} {x : EuclideanSpace ℝ (Fin n)}
    (hf : ConvolutionExistsAt k f x (ContinuousLinearMap.mul ℂ ℂ) volume)
    (hg : ConvolutionExistsAt k g x (ContinuousLinearMap.mul ℂ ℂ) volume) :
    (k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] (f - g)) x =
      (k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x -
        (k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x := by
  rw [convolution_def, convolution_def, convolution_def, ← integral_sub hf hg]
  congr 1; funext t
  simp only [Pi.sub_apply, map_sub]

lemma JswAdm.ae_convolutionExistsAt (h : JswAdm n A φ) (j : ℤ) {p : ℝ≥0∞} (hp : 1 ≤ p)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f p volume) :
    ∀ᵐ x, ConvolutionExistsAt (jswDilate n φ j) f x (ContinuousLinearMap.mul ℂ ℂ) volume :=
  ae_convolutionExistsAt_of_memLp hp (memLp_one_iff_integrable.2 (h.integrable_dilate j)) hf

lemma JswAdm.jswDiff_add (h : JswAdm n A φ) (j : ℤ) {p : ℝ≥0∞} (hp : 1 ≤ p)
    {f g : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f p volume) (hg : MemLp g p volume) :
    jswDiff n φ j (f + g) =ᵐ[volume] fun x => jswDiff n φ j f x + jswDiff n φ j g x := by
  filter_upwards [h.ae_convolutionExistsAt j hp hf, h.ae_convolutionExistsAt j hp hg]
    with x h1 h2
  rw [jswDiff, h1.distrib_add h2, jsw_dyadicAvg_add (jsw_integrableOn_czCube hp hf _)
    (jsw_integrableOn_czCube hp hg _), jswDiff, jswDiff]
  ring

lemma JswAdm.jswDiff_sub (h : JswAdm n A φ) (j : ℤ) {p : ℝ≥0∞} (hp : 1 ≤ p)
    {f g : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f p volume) (hg : MemLp g p volume) :
    jswDiff n φ j (f - g) =ᵐ[volume] fun x => jswDiff n φ j f x - jswDiff n φ j g x := by
  filter_upwards [h.ae_convolutionExistsAt j hp hf, h.ae_convolutionExistsAt j hp hg]
    with x h1 h2
  rw [jswDiff, jsw_convolution_sub h1 h2, jsw_dyadicAvg_sub (jsw_integrableOn_czCube hp hf _)
    (jsw_integrableOn_czCube hp hg _), jswDiff, jswDiff]
  ring

lemma JswAdm.aestronglyMeasurable_jswDiff (h : JswAdm n A φ) (j : ℤ)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : AEStronglyMeasurable f volume) :
    AEStronglyMeasurable (jswDiff n φ j f) volume :=
  (AEStronglyMeasurable.convolution _ (h.integrable_dilate j).1 hf).sub
    (jsw_measurable_dyadicAvg j f).aestronglyMeasurable

lemma jswDiff_congr_ae (j : ℤ) {f g : EuclideanSpace ℝ (Fin n) → ℂ} (hfg : f =ᵐ[volume] g) :
    jswDiff n φ j f = jswDiff n φ j g := by
  funext x
  have hc := convolution_congr (L := ContinuousLinearMap.mul ℂ ℂ) (μ := volume)
    (EventuallyEq.refl (ae volume) (jswDilate n φ j)) hfg
  rw [jswDiff, jswDiff, hc,
    jsw_dyadicAvg_congr_ae hfg]

/-- Duality: `∫ (D_j u) v̄ = ∫ u (D*_j v)‾` with `D*_j` built from the adjoint kernel. -/
theorem JswAdm.integral_jswDiff_mul_conj (h : JswAdm n A φ) {p q : ℝ}
    (hpq : p.HolderConjugate q) (j : ℤ) {u v : EuclideanSpace ℝ (Fin n) → ℂ}
    (hu : MemLp u (ENNReal.ofReal p) volume) (hv : MemLp v (ENNReal.ofReal q) volume) :
    ∫ x, jswDiff n φ j u x * conj (v x) =
      ∫ x, u x * conj (jswDiff n (czAdjoint φ) j v x) := by
  have hp1 : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hpq.lt.le
  have hq1 : 1 ≤ ENNReal.ofReal q := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hpq.symm.lt.le
  have hK := h.integrable_dilate j
  have hKm : Measurable (jswDilate n φ j) := (jsw_continuous_dilate h.cont j).measurable
  have hK' := h.adjoint.integrable_dilate j
  have hcu := memLp_convolution_of_memLp hp1 (memLp_one_iff_integrable.2 hK) hu
  have hcv := memLp_convolution_of_memLp hq1 (memLp_one_iff_integrable.2 hK') hv
  have hEu := jsw_memLp_dyadicAvg hpq.lt.le j hu
  have hEv := jsw_memLp_dyadicAvg hpq.symm.lt.le j hv
  have e1 := integral_convolution_mul_conj hK hKm hpq hu hv
  rw [jsw_czAdjoint_dilate] at e1
  have e2 := jsw_integral_dyadicAvg_mul_conj hpq j hu hv
  simp only [jswDiff, sub_mul, map_sub, mul_sub]
  rw [integral_sub (jsw_integrable_mul_conj hpq hcu hv) (jsw_integrable_mul_conj hpq hEu hv),
    integral_sub (jsw_integrable_mul_conj hpq hu hcv) (jsw_integrable_mul_conj hpq hu hEv),
    e1, e2]

end JswD

section JswE1

variable {n : ℕ}

/-! ### A translation estimate for functions constant on dyadic cubes -/

/-- `|[a, a + s) ∖ ([a, a + s) + t)| ≤ |t|`. -/
lemma jsw_volume_Ico_shift_le (a s t : ℝ) :
    volume (Ico a (a + s) ∩ {u | u - t ∉ Ico a (a + s)}) ≤ ENNReal.ofReal |t| := by
  rcases le_or_gt 0 t with ht | ht
  · calc _ ≤ volume (Ico a (a + t)) := measure_mono (by
          rintro u ⟨⟨h1, h2⟩, h3⟩
          simp only [mem_ofPred_eq, mem_Ico, not_and, not_lt] at h3
          refine ⟨h1, ?_⟩
          by_contra h4
          push Not at h4
          have := h3 (by linarith)
          linarith)
      _ = _ := by rw [Real.volume_Ico, abs_of_nonneg ht]; congr 1; ring
  · calc _ ≤ volume (Ico (a + s + t) (a + s)) := measure_mono (by
          rintro u ⟨⟨h1, h2⟩, h3⟩
          simp only [mem_ofPred_eq, mem_Ico, not_and, not_lt] at h3
          refine ⟨?_, h2⟩
          have := h3 (by linarith)
          linarith)
      _ = _ := by rw [Real.volume_Ico, abs_of_neg ht]; congr 1; ring

lemma jsw_measurableSet_shift (k : ℤ) (τ : EuclideanSpace ℝ (Fin n)) (i : Fin n → ℤ) :
    MeasurableSet {x : EuclideanSpace ℝ (Fin n) | czDyIdx k (x - τ) ≠ i} :=
  ((measurable_czDyIdx k).comp (measurable_sub_const τ) (measurableSet_singleton i)).compl

/-- The part of a dyadic cube of side `2^k` that leaves the cube under translation by `τ` has
relative measure at most `2^{-k} ∑_l |τ_l|`. -/
theorem jsw_volume_czCube_shift_le (k : ℤ) (i : Fin n → ℤ) (τ : EuclideanSpace ℝ (Fin n)) :
    volume (czCube (k, i) ∩ {x | czDyIdx k (x - τ) ≠ i}) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (-k) * ∑ l, |τ l|) * volume (czCube (k, i)) := by
  classical
  set s : ℝ := (2 : ℝ) ^ k with hs_def
  have hs : 0 < s := zpow_pos two_pos k
  set a : Fin n → ℝ := fun m => (i m : ℝ) * s
  have hmem : ∀ y : EuclideanSpace ℝ (Fin n), czDyIdx k y = i ↔ ∀ m, y m ∈ Ico (a m) (a m + s) := by
    intro y
    have := mem_czCube_iff (p := (k, i)) (y := y)
    simp only [mem_Ico, a]
    rw [show (czDyIdx k y = i) = (y ∈ czCube (k, i)) from rfl, this]
    refine forall_congr' fun m => ?_
    rw [add_mul, one_mul]
  set T : Fin n → Fin n → Set ℝ := fun l m => if m = l then
    Ico (a m) (a m + s) ∩ {u | u - τ l ∉ Ico (a l) (a l + s)} else Ico (a m) (a m + s)
  have hsub : czCube (k, i) ∩ {x | czDyIdx k (x - τ) ≠ i} ⊆
      ⋃ l, euclideanEquivPi n ⁻¹' Set.univ.pi (T l) := by
    rintro x ⟨hx, hx'⟩
    have hx1 := (hmem x).1 hx
    have hx2 : ¬ ∀ m, (x - τ) m ∈ Ico (a m) (a m + s) := fun h => hx' ((hmem _).2 h)
    push Not at hx2
    obtain ⟨l, hl⟩ := hx2
    refine mem_iUnion.2 ⟨l, ?_⟩
    simp only [mem_preimage, Set.mem_pi, mem_univ, true_implies]
    intro m
    simp only [T]
    split_ifs with hml
    · subst hml
      exact ⟨hx1 m, by simpa using hl⟩
    · exact hx1 m
  have hvolT : ∀ l, volume (euclideanEquivPi n ⁻¹' Set.univ.pi (T l)) ≤
      ENNReal.ofReal (|τ l| / s) * volume (czCube (k, i)) := by
    intro l
    have hTm : ∀ m, MeasurableSet (T l m) := by
      intro m
      simp only [T]
      split_ifs
      · exact measurableSet_Ico.inter (measurableSet_Ico.preimage
          (measurable_id.sub_const _)).compl
      · exact measurableSet_Ico
    rw [(measurePreserving_euclideanEquivPi n).measure_preimage
      (MeasurableSet.univ_pi hTm).nullMeasurableSet, volume_pi_pi, volume_czCube]
    calc ∏ m, volume (T l m)
        ≤ ∏ m, (if m = l then ENNReal.ofReal (|τ l| / s) else 1) * ENNReal.ofReal s := by
          refine Finset.prod_le_prod fun m _ => ?_
          simp only [T]
          split_ifs with hml
          · subst hml
            refine (jsw_volume_Ico_shift_le _ _ _).trans_eq ?_
            rw [← ENNReal.ofReal_mul (by positivity), div_mul_cancel₀ _ hs.ne']
          · rw [one_mul, Real.volume_Ico, add_sub_cancel_left]
      _ = ENNReal.ofReal (|τ l| / s) * ENNReal.ofReal s ^ n := by
          rw [Finset.prod_mul_distrib, Finset.prod_ite_eq' Finset.univ l, ite_eq_left
            (Finset.mem_univ _), Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  calc volume (czCube (k, i) ∩ {x | czDyIdx k (x - τ) ≠ i})
      ≤ volume (⋃ l, euclideanEquivPi n ⁻¹' Set.univ.pi (T l)) := measure_mono hsub
    _ ≤ ∑ l, volume (euclideanEquivPi n ⁻¹' Set.univ.pi (T l)) := measure_iUnion_fintype_le _ _
    _ ≤ ∑ l, ENNReal.ofReal (|τ l| / s) * volume (czCube (k, i)) :=
        Finset.sum_le_sum fun l _ => hvolT l
    _ = _ := by
        rw [← Finset.sum_mul, ← ENNReal.ofReal_sum_of_nonneg (fun _ _ => by positivity)]
        congr 2
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [hs_def, zpow_neg, div_eq_inv_mul]

/-- The set of points whose dyadic cube of side `2^{-j}` changes under translation by `τ`. -/
def jswShiftSet (j : ℤ) (τ : EuclideanSpace ℝ (Fin n)) : Set (EuclideanSpace ℝ (Fin n)) :=
  {x | czDyIdx (-j) (x - τ) ≠ czDyIdx (-j) x}

lemma jsw_measurableSet_shiftSet (j : ℤ) (τ : EuclideanSpace ℝ (Fin n)) :
    MeasurableSet (jswShiftSet j τ) := by
  have : jswShiftSet j τ = ⋃ i : Fin n → ℤ, czCube (-j, i) ∩ {x | czDyIdx (-j) (x - τ) ≠ i} := by
    ext x
    simp only [jswShiftSet, mem_ofPred_eq, mem_iUnion, mem_inter_iff]
    constructor
    · intro h; exact ⟨czDyIdx (-j) x, rfl, h⟩
    · rintro ⟨i, hi, h⟩; rw [jsw_mem_czCube_iff.1 hi]; exact h
  rw [this]
  exact MeasurableSet.iUnion fun i => (measurableSet_czCube _).inter
    (jsw_measurableSet_shift _ _ _)

lemma jsw_lintegral_indicator_shift_le {j : ℤ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : JswMeas j g) (τ : EuclideanSpace ℝ (Fin n)) :
    ∫⁻ x, (jswShiftSet j τ).indicator (fun x => ‖g x‖ₑ ^ 2) x ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * ∑ l, |τ l|) * ∫⁻ x, ‖g x‖ₑ ^ 2 := by
  rw [jsw_lintegral_eq_tsum (-j), jsw_lintegral_eq_tsum (-j) (fun x => ‖g x‖ₑ ^ 2),
    ← ENNReal.tsum_mul_left]
  refine ENNReal.tsum_le_tsum fun i => ?_
  set Q := czCube (n := n) (-j, i)
  set c := czCorner (n := n) (-j, i)
  have hc : c ∈ Q := czCorner_mem _
  have hgQ : ∀ x ∈ Q, ‖g x‖ₑ ^ 2 = ‖g c‖ₑ ^ 2 := fun x hx => by
    rw [hg x c (hx.trans hc.symm)]
  have hset : Q ∩ jswShiftSet j τ = Q ∩ {x | czDyIdx (-j) (x - τ) ≠ i} := by
    ext x
    simp only [mem_inter_iff, jswShiftSet, mem_ofPred_eq]
    constructor
    · rintro ⟨hx, h⟩; rw [jsw_mem_czCube_iff.1 hx] at h; exact ⟨hx, h⟩
    · rintro ⟨hx, h⟩; rw [jsw_mem_czCube_iff.1 hx]; exact ⟨hx, h⟩
  have h1 := jsw_volume_czCube_shift_le (-j) i τ
  rw [neg_neg] at h1
  rw [setLIntegral_indicator (jsw_measurableSet_shiftSet j τ), inter_comm,
    setLIntegral_congr_fun ((measurableSet_czCube _).inter (jsw_measurableSet_shiftSet j τ))
      (fun x hx => hgQ x hx.1), setLIntegral_const,
    setLIntegral_congr_fun (measurableSet_czCube _) hgQ, setLIntegral_const, hset]
  calc ‖g c‖ₑ ^ 2 * volume (Q ∩ {x | czDyIdx (-j) (x - τ) ≠ i})
      ≤ ‖g c‖ₑ ^ 2 * (ENNReal.ofReal ((2 : ℝ) ^ j * ∑ l, |τ l|) * volume Q) := by gcongr
    _ = _ := by ring

lemma jsw_enorm_sub_sq_le (a b : ℂ) : ‖a - b‖ₑ ^ 2 ≤ 2 * ‖a‖ₑ ^ 2 + 2 * ‖b‖ₑ ^ 2 := by
  rw [← ofReal_norm, ← ofReal_norm, ← ofReal_norm, ← ENNReal.ofReal_pow (norm_nonneg _),
    ← ENNReal.ofReal_pow (norm_nonneg _), ← ENNReal.ofReal_pow (norm_nonneg _),
    show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp, ← ENNReal.ofReal_mul (by norm_num),
    ← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_add (by positivity) (by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  have h := norm_sub_le a b
  have h0 := norm_nonneg (a - b)
  nlinarith [sq_nonneg (‖a‖ - ‖b‖), norm_nonneg a, norm_nonneg b]

/-- **Translation estimate**: for `g` constant on the dyadic cubes of side `2^{-j}`,
`∫ |g(x - τ) - g(x)|² dx ≤ 4 · 2^j ∑_l |τ_l| ∫ |g|²`. -/
theorem jsw_lintegral_shift_sub_le {j : ℤ} {g : EuclideanSpace ℝ (Fin n) → ℂ}
    (hg : JswMeas j g) (τ : EuclideanSpace ℝ (Fin n)) :
    ∫⁻ x, ‖g (x - τ) - g x‖ₑ ^ 2 ≤
      4 * ENNReal.ofReal ((2 : ℝ) ^ j * ∑ l, |τ l|) * ∫⁻ x, ‖g x‖ₑ ^ 2 := by
  have hgm : Measurable g := hg.measurable
  set S := jswShiftSet j τ
  set S' := jswShiftSet j (-τ)
  have hS := jsw_measurableSet_shiftSet j τ
  have hS' := jsw_measurableSet_shiftSet j (-τ)
  have hpt : ∀ x, ‖g (x - τ) - g x‖ₑ ^ 2 ≤
      2 * S.indicator (fun x => ‖g (x - τ)‖ₑ ^ 2) x + 2 * S.indicator (fun x => ‖g x‖ₑ ^ 2) x := by
    intro x
    by_cases hx : x ∈ S
    · rw [indicator_of_mem hx, indicator_of_mem hx]; exact jsw_enorm_sub_sq_le _ _
    · have : czDyIdx (-j) (x - τ) = czDyIdx (-j) x := by
        by_contra h; exact hx h
      rw [hg _ _ this, sub_self, enorm_zero]; simp
  have hshift : ∫⁻ x, S.indicator (fun x => ‖g (x - τ)‖ₑ ^ 2) x =
      ∫⁻ x, S'.indicator (fun x => ‖g x‖ₑ ^ 2) x := by
    rw [← lintegral_add_right_eq_self (fun x => S.indicator (fun x => ‖g (x - τ)‖ₑ ^ 2) x) τ]
    refine lintegral_congr fun x => ?_
    have hiff : x + τ ∈ S ↔ x ∈ S' := by
      simp only [S, S', jswShiftSet, mem_ofPred_eq, add_sub_cancel_right, sub_neg_eq_add]
      exact ne_comm
    by_cases hx : x ∈ S'
    · rw [indicator_of_mem (hiff.2 hx), indicator_of_mem hx, add_sub_cancel_right]
    · rw [indicator_of_notMem (fun h => hx (hiff.1 h)), indicator_of_notMem hx]
  have hm1 : Measurable fun x => S.indicator (fun x => ‖g (x - τ)‖ₑ ^ 2) x :=
    ((hgm.comp (measurable_sub_const τ)).enorm.pow_const 2).indicator hS
  have hsum : ∑ l, |(-τ) l| = ∑ l, |τ l| := by
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [PiLp.neg_apply, abs_neg]
  calc ∫⁻ x, ‖g (x - τ) - g x‖ₑ ^ 2
      ≤ ∫⁻ x, (2 * S.indicator (fun x => ‖g (x - τ)‖ₑ ^ 2) x +
          2 * S.indicator (fun x => ‖g x‖ₑ ^ 2) x) := lintegral_mono hpt
    _ = 2 * (∫⁻ x, S'.indicator (fun x => ‖g x‖ₑ ^ 2) x) +
          2 * ∫⁻ x, S.indicator (fun x => ‖g x‖ₑ ^ 2) x := by
        rw [lintegral_add_left (hm1.const_mul _), lintegral_const_mul _ hm1,
          lintegral_const_mul' _ _ (by norm_num), hshift]
    _ ≤ 2 * (ENNReal.ofReal ((2 : ℝ) ^ j * ∑ l, |τ l|) * ∫⁻ x, ‖g x‖ₑ ^ 2) +
          2 * (ENNReal.ofReal ((2 : ℝ) ^ j * ∑ l, |τ l|) * ∫⁻ x, ‖g x‖ₑ ^ 2) := by
        gcongr
        · have := jsw_lintegral_indicator_shift_le hg (-τ)
          rwa [hsum] at this
        · exact jsw_lintegral_indicator_shift_le hg τ
    _ = _ := by ring

end JswE1

section JswE2

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-! ### `L²` estimates for `D_j` on coarse and on fine pieces -/

lemma jsw_sum_abs_le (τ : EuclideanSpace ℝ (Fin n)) : ∑ l, |τ l| ≤ n * ‖τ‖ := by
  calc ∑ l, |τ l| ≤ ∑ _l : Fin n, ‖τ‖ := Finset.sum_le_sum fun l _ => by
        have := PiLp.norm_apply_le τ l
        rwa [Real.norm_eq_abs] at this
    _ = n * ‖τ‖ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

lemma jsw_lintegral_sq_eq {F : Type*} [NormedAddCommGroup F] {g : EuclideanSpace ℝ (Fin n) → F}
    (hg : AEStronglyMeasurable g volume) : ∫⁻ x, ‖g x‖ₑ ^ 2 = eLpNorm g 2 volume ^ 2 := by
  have := eLpNorm_two_rpow_two hg
  simp only [ENNReal.rpow_two] at this
  exact this.symm

/-- **Coarse pieces**: if `g ∈ L²` is constant on the dyadic cubes of side `2^{-k}` and
`k ≤ j`, then `‖D_j g‖₂² ≤ 4 n A² 2^{k-j} I_n² ‖g‖₂²`. -/
theorem JswAdm.lintegral_jswDiff_coarse_le (h : JswAdm n A φ) {k j : ℤ} (hkj : k ≤ j)
    {g : EuclideanSpace ℝ (Fin n) → ℂ} (hg : JswMeas k g) (hg2 : MemLp g 2 volume) :
    ∫⁻ x, ‖jswDiff n φ j g x‖ₑ ^ 2 ≤
      ENNReal.ofReal (4 * n * A ^ 2 * (2 : ℝ) ^ (k - j)) * jswI n ^ 2 * ∫⁻ x, ‖g x‖ₑ ^ 2 := by
  have hgm : Measurable g := hg.measurable
  have hK := h.integrable_dilate j
  have hKc := jsw_continuous_dilate h.cont j
  set G := ∫⁻ x, ‖g x‖ₑ ^ 2 with hG
  set M := ∫⁻ t, ‖jswDilate n φ j t‖ₑ
  have hM : M ≤ ENNReal.ofReal A * jswI n := h.lintegral_dilate_le j
  -- pointwise Cauchy–Schwarz
  have hpt : ∀ᵐ x, ‖jswDiff n φ j g x‖ₑ ^ 2 ≤
      M * ∫⁻ t, ‖jswDilate n φ j t‖ₑ * ‖g (x - t) - g x‖ₑ ^ 2 := by
    filter_upwards [h.ae_convolutionExistsAt j (by norm_num : (1 : ℝ≥0∞) ≤ 2) hg2] with x hx
    have e1 : jswDiff n φ j g x = ∫ t, jswDilate n φ j t * (g (x - t) - g x) := by
      have hc : (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x =
          ∫ t, jswDilate n φ j t * g (x - t) := by
        rw [convolution_def]; simp only [ContinuousLinearMap.mul_apply']
      have hgx : g x = ∫ t, jswDilate n φ j t * g x := by
        rw [integral_mul_const, h.integral_dilate, one_mul]
      have hx' : Integrable (fun t => jswDilate n φ j t * g (x - t)) := by
        simpa [ContinuousLinearMap.mul_apply'] using hx.integrable
      rw [jswDiff, jsw_dyadicAvg_of_jswMeas (hg.mono hkj), hc]
      conv_lhs => rw [hgx]
      rw [← integral_sub hx' (hK.mul_const _)]
      congr 1; funext t; ring
    have e2 : ‖jswDiff n φ j g x‖ₑ ≤ ∫⁻ t, ‖jswDilate n φ j t‖ₑ * ‖g (x - t) - g x‖ₑ := by
      rw [e1]
      refine (enorm_integral_le_lintegral_enorm _).trans_eq ?_
      simp only [enorm_mul]
    have hY := lintegral_mul_rpow_le_young volume (p := 2) (by norm_num)
      (K := fun t => ‖jswDilate n φ j t‖ₑ) (v := fun t => ‖g (x - t) - g x‖ₑ)
      hKc.enorm.aemeasurable ((hgm.comp (measurable_const.sub measurable_id)).sub
        measurable_const).enorm.aemeasurable
    simp only [ENNReal.rpow_two, show (2 : ℝ) - 1 = 1 by norm_num, ENNReal.rpow_one] at hY
    calc ‖jswDiff n φ j g x‖ₑ ^ 2
        ≤ (∫⁻ t, ‖jswDilate n φ j t‖ₑ * ‖g (x - t) - g x‖ₑ) ^ 2 := by gcongr
      _ ≤ _ := by
          have : ∀ t, ‖g (x - t) - g x‖ₑ ^ (2 : ℝ) = ‖g (x - t) - g x‖ₑ ^ 2 := fun t =>
            ENNReal.rpow_two _
          simpa [this] using hY
  have hmeas2 : Measurable (Function.uncurry fun (x t : EuclideanSpace ℝ (Fin n)) =>
      ‖jswDilate n φ j t‖ₑ * ‖g (x - t) - g x‖ₑ ^ 2) :=
    (hKc.measurable.comp measurable_snd).enorm.mul
      (((hgm.comp (measurable_fst.sub measurable_snd)).sub
        (hgm.comp measurable_fst)).enorm.pow_const 2)
  have hMne : M ≠ ∞ := (hM.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top jswI_lt_top)).ne
  have hGne : G ≠ ∞ := by
    rw [hG, jsw_lintegral_sq_eq hg2.aestronglyMeasurable]; exact ENNReal.pow_ne_top hg2.ne
  have hcne : 4 * ENNReal.ofReal ((2 : ℝ) ^ k * n) * G ≠ ∞ :=
    ENNReal.mul_ne_top (ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top) hGne
  calc ∫⁻ x, ‖jswDiff n φ j g x‖ₑ ^ 2
      ≤ ∫⁻ x, M * ∫⁻ t, ‖jswDilate n φ j t‖ₑ * ‖g (x - t) - g x‖ₑ ^ 2 := lintegral_mono_ae hpt
    _ = M * ∫⁻ t, ‖jswDilate n φ j t‖ₑ * ∫⁻ x, ‖g (x - t) - g x‖ₑ ^ 2 := by
        rw [lintegral_const_mul' _ _ hMne, lintegral_lintegral_swap hmeas2.aemeasurable]
        congr 1
        refine lintegral_congr fun t => ?_
        exact lintegral_const_mul' _ _ enorm_ne_top
    _ ≤ M * ∫⁻ t, ‖jswDilate n φ j t‖ₑ *
          (4 * ENNReal.ofReal ((2 : ℝ) ^ k * n) * G * ENNReal.ofReal ‖t‖) := by
        gcongr with t
        refine (jsw_lintegral_shift_sub_le hg t).trans ?_
        rw [← hG]
        refine le_of_le_of_eq (b := 4 * ENNReal.ofReal ((2 : ℝ) ^ k * n * ‖t‖) * G) ?_ ?_
        · gcongr 4 * ENNReal.ofReal ?_ * _
          rw [mul_assoc]
          exact mul_le_mul_of_nonneg_left (jsw_sum_abs_le t) (by positivity)
        · rw [ENNReal.ofReal_mul (by positivity)]; ring
    _ = M * (4 * ENNReal.ofReal ((2 : ℝ) ^ k * n) * G) *
          ∫⁻ t, ‖jswDilate n φ j t‖ₑ * ENNReal.ofReal ‖t‖ := by
        rw [mul_assoc M]
        congr 1
        rw [← lintegral_const_mul' _ _ hcne]
        refine lintegral_congr fun t => ?_
        ring
    _ ≤ (ENNReal.ofReal A * jswI n) * (4 * ENNReal.ofReal ((2 : ℝ) ^ k * n) * G) *
          (ENNReal.ofReal (A / (2 : ℝ) ^ j) * jswI n) := by
        gcongr
        exact h.lintegral_moment_le j
    _ = ENNReal.ofReal (4 * n * A ^ 2 * (2 : ℝ) ^ (k - j)) * jswI n ^ 2 * G := by
        have h2j : (0 : ℝ) < (2 : ℝ) ^ j := zpow_pos two_pos j
        have hA := h.nonneg
        have e : 4 * n * A ^ 2 * (2 : ℝ) ^ (k - j) =
            4 * ((2 : ℝ) ^ k * n) * (A * (A / (2 : ℝ) ^ j)) := by
          rw [zpow_sub₀ two_ne_zero]; field_simp
        have e2 : ENNReal.ofReal (4 * n * A ^ 2 * (2 : ℝ) ^ (k - j)) =
            4 * ENNReal.ofReal ((2 : ℝ) ^ k * n) *
              (ENNReal.ofReal A * ENNReal.ofReal (A / (2 : ℝ) ^ j)) := by
          rw [e, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
            ENNReal.ofReal_mul hA, ENNReal.ofReal_ofNat]
        rw [e2]
        ring

end JswE2

section JswE3

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-! ### Fine pieces: smoothing of functions with vanishing cube averages -/

/-- The kernel `β 2^{jn} (1 + 2^j |z|)^{-(n+1)}`. -/
def jswKer (n : ℕ) (β : ℝ) (j : ℤ) (z : EuclideanSpace ℝ (Fin n)) : ℝ :=
  β * ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • z))

lemma jsw_measurable_ker (β : ℝ) (j : ℤ) : Measurable (jswKer n β j) := by
  unfold jswKer
  exact measurable_const.mul (measurable_const.mul (jsw_measurable_env.comp
    (measurable_const_smul _)))

lemma jswKer_nonneg {β : ℝ} (hβ : 0 ≤ β) (j : ℤ) (z : EuclideanSpace ℝ (Fin n)) :
    0 ≤ jswKer n β j z := by
  unfold jswKer
  have := jswEnv_pos (n := n) ((2 : ℝ) ^ j • z)
  have := jsw_two_zpow_pos (n := n) j
  positivity

lemma jsw_lintegral_ker {β : ℝ} (hβ : 0 ≤ β) (j : ℤ) (y : EuclideanSpace ℝ (Fin n)) :
    ∫⁻ x, ENNReal.ofReal (jswKer n β j (x - y)) = ENNReal.ofReal β * jswI n := by
  simp only [jswKer]
  simp_rw [ENNReal.ofReal_mul hβ]
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, jsw_lintegral_env_dilate]

/-- Cancellation on one cube: for `u` with mean zero on the dyadic cube `Q` of side `2^{p.1}`
and `2^{j + p.1} ≤ 1`,
`|∫_Q φ_j(x - y) u(y) dy| ≤ ∫_Q A 2^{j + p.1} √n 2^{jn} (1 + 2^j |x - y|)^{-(n+1)} |u(y)| dy`. -/
lemma JswAdm.enorm_setIntegral_mean_zero_le (h : JswAdm n A φ) (p : ℤ × (Fin n → ℤ)) {j : ℤ}
    (hj : j + p.1 ≤ 0) {u : EuclideanSpace ℝ (Fin n) → ℂ} (hu : IntegrableOn u (czCube p))
    (h0 : ∫ y in czCube p, u y = 0) (x : EuclideanSpace ℝ (Fin n))
    (hx : IntegrableOn (fun y => jswDilate n φ j (x - y) * u y) (czCube p)) :
    ‖∫ y in czCube p, jswDilate n φ j (x - y) * u y‖ₑ ≤
      ∫⁻ y in czCube p, ENNReal.ofReal (jswKer n (A * (2 : ℝ) ^ (j + p.1) * Real.sqrt n) j
        (x - y)) * ‖u y‖ₑ := by
  set c := czCorner p
  have e : ∫ y in czCube p, jswDilate n φ j (x - y) * u y =
      ∫ y in czCube p, (jswDilate n φ j (x - y) - jswDilate n φ j (x - c)) * u y := by
    have h1 : ∫ y in czCube p, jswDilate n φ j (x - c) * u y = 0 := by
      rw [integral_const_mul, h0, mul_zero]
    simp_rw [sub_mul]
    rw [integral_sub hx (hu.const_mul _), h1, sub_zero]
  rw [e]
  refine (enorm_integral_le_lintegral_enorm _).trans
    (setLIntegral_mono' (measurableSet_czCube _) fun y hy => ?_)
  rw [enorm_mul]
  refine mul_le_mul' ?_ le_rfl
  rw [← ofReal_norm, norm_sub_rev]
  refine ENNReal.ofReal_le_ofReal ?_
  have hyc : ‖y - c‖ ≤ Real.sqrt n * (2 : ℝ) ^ p.1 :=
    norm_sub_le_of_mem_czCube hy (czCorner_mem _)
  have h2 : (2 : ℝ) ^ j * ‖y - c‖ ≤ (2 : ℝ) ^ (j + p.1) * Real.sqrt n := by
    rw [zpow_add₀ two_ne_zero]
    calc (2 : ℝ) ^ j * ‖y - c‖ ≤ (2 : ℝ) ^ j * (Real.sqrt n * (2 : ℝ) ^ p.1) := by gcongr
      _ = _ := by ring
  have h3 : (2 : ℝ) ^ (j + p.1) ≤ 1 := zpow_le_one_of_nonpos₀ one_le_two hj
  have hsq := Real.sqrt_nonneg (n : ℝ)
  refine (h.dilate_sub_le j (h2.trans (by nlinarith))).trans ?_
  have := jswEnv_pos (n := n) ((2 : ℝ) ^ j • (x - y))
  have := jsw_two_zpow_pos (n := n) j
  have hA := h.nonneg
  simp only [jswKer]
  calc A * ((2 : ℝ) ^ j * ‖y - c‖) * ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • (x - y)))
      ≤ A * ((2 : ℝ) ^ (j + p.1) * Real.sqrt n) *
          ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • (x - y))) := by gcongr
    _ = _ := by ring

/-- `∫ |∫_Q φ_j(x - y) u(y) dy| dx ≤ A 2^{j + p.1} √n I_n ∫_Q |u|` for `u` with mean zero on
the dyadic cube `Q` of side `2^{p.1}` and `2^{j + p.1} ≤ 1`. -/
lemma JswAdm.lintegral_setIntegral_mean_zero_le (h : JswAdm n A φ) (p : ℤ × (Fin n → ℤ))
    {j : ℤ} (hj : j + p.1 ≤ 0) {u : EuclideanSpace ℝ (Fin n) → ℂ}
    (hu : IntegrableOn u (czCube p)) (h0 : ∫ y in czCube p, u y = 0) :
    ∫⁻ x, ‖∫ y in czCube p, jswDilate n φ j (x - y) * u y‖ₑ ≤
      ENNReal.ofReal (A * (2 : ℝ) ^ (j + p.1) * Real.sqrt n) * jswI n *
        ∫⁻ y in czCube p, ‖u y‖ₑ := by
  set β := A * (2 : ℝ) ^ (j + p.1) * Real.sqrt n
  have hβ : 0 ≤ β := by have := h.nonneg; positivity
  have hKc := jsw_continuous_dilate h.cont j
  have hbdd : ∀ y, ‖jswDilate n φ j y‖ ≤ A * (2 : ℝ) ^ (j * n) := by
    intro y
    refine (h.dilate_le j y).trans ?_
    have h1 : jswEnv n ((2 : ℝ) ^ j • y) ≤ 1 := by
      unfold jswEnv; exact inv_le_one_of_one_le₀ (one_le_pow₀ (by
        have := norm_nonneg ((2 : ℝ) ^ j • y); linarith))
    have := h.nonneg; have := jsw_two_zpow_pos (n := n) j
    calc A * ((2 : ℝ) ^ (j * n) * jswEnv n ((2 : ℝ) ^ j • y)) ≤ A * ((2 : ℝ) ^ (j * n) * 1) := by
          gcongr
      _ = _ := by ring
  have hx : ∀ x, IntegrableOn (fun y => jswDilate n φ j (x - y) * u y) (czCube p) := fun x =>
    hu.bdd_mul (hKc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
      (Eventually.of_forall fun y => hbdd _)
  have hmeas : AEMeasurable (Function.uncurry fun x y =>
      ENNReal.ofReal (jswKer n β j (x - y)) * ‖u y‖ₑ) (volume.prod (volume.restrict (czCube p))) :=
    ((ENNReal.measurable_ofReal.comp ((jsw_measurable_ker β j).comp
      (measurable_fst.sub measurable_snd))).aemeasurable).mul
      (hu.aestronglyMeasurable.enorm.comp_snd)
  calc ∫⁻ x, ‖∫ y in czCube p, jswDilate n φ j (x - y) * u y‖ₑ
      ≤ ∫⁻ x, ∫⁻ y in czCube p, ENNReal.ofReal (jswKer n β j (x - y)) * ‖u y‖ₑ :=
        lintegral_mono fun x => h.enorm_setIntegral_mean_zero_le p hj hu h0 x (hx x)
    _ = ∫⁻ y in czCube p, ∫⁻ x, ENNReal.ofReal (jswKer n β j (x - y)) * ‖u y‖ₑ :=
        lintegral_lintegral_swap hmeas
    _ = ∫⁻ y in czCube p, ENNReal.ofReal β * jswI n * ‖u y‖ₑ := by
        refine lintegral_congr fun y => ?_
        rw [lintegral_mul_const' _ _ enorm_ne_top, jsw_lintegral_ker hβ]
    _ = _ := lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top jswI_ne_top)

/-- **Fine pieces**: if `u ∈ L²` has vanishing averages on the dyadic cubes of side `2^{-k}`
and `j ≤ k`, then `‖D_j u‖₂ ≤ A 2^{j-k} √n I_n ‖u‖₂`. -/
theorem JswAdm.eLpNorm_jswDiff_fine_le (h : JswAdm n A φ) {k j : ℤ} (hjk : j ≤ k)
    {u : EuclideanSpace ℝ (Fin n) → ℂ} (hu : MemLp u 2 volume)
    (hmean : ∀ x, dyadicAvg n k u x = 0) :
    eLpNorm (jswDiff n φ j u) 2 volume ≤
      ENNReal.ofReal (A * (2 : ℝ) ^ (j - k) * Real.sqrt n) * jswI n * eLpNorm u 2 volume := by
  have hu' : MemLp u (ENNReal.ofReal 2) volume := by rwa [ENNReal.ofReal_ofNat]
  have hE : dyadicAvg n j u = 0 := by
    rw [← jsw_dyadicAvg_dyadicAvg one_lt_two hjk hu']
    funext x
    have : dyadicAvg n k u = fun _ => 0 := funext hmean
    rw [this]; simp [dyadicAvg]
  have hint : ∀ i, ∫ y in czCube (-k, i), u y = 0 := by
    intro i
    have := hmean (czCorner (-k, i))
    rw [jsw_dyadicAvg_of_mem (czCorner_mem _)] at this
    rcases mul_eq_zero.1 this with h1 | h1
    · exact absurd h1 (Complex.ofReal_ne_zero.2 (jsw_two_zpow_pos k).ne')
    · exact h1
  have hloc : ∀ i, IntegrableOn u (czCube (-k, i)) :=
    jsw_integrableOn_czCube (by norm_num) hu (-k)
  set β := A * (2 : ℝ) ^ (j - k) * Real.sqrt n
  have hβ : 0 ≤ β := by have := h.nonneg; positivity
  set B := jswKer n β j
  have hBm : AEStronglyMeasurable B volume := (jsw_measurable_ker β j).aestronglyMeasurable
  have hB1 : eLpNorm B 1 volume = ENNReal.ofReal β * jswI n := by
    rw [eLpNorm_one_eq_lintegral_enorm hBm]
    have := jsw_lintegral_ker (n := n) hβ j 0
    simp only [sub_zero] at this
    rw [← this]
    refine lintegral_congr fun z => ?_
    rw [Real.enorm_eq_ofReal (jswKer_nonneg hβ j z)]
  have hpt : ∀ᵐ x, ‖(jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) x‖ₑ ≤
      ‖∫⁻ y, ‖B y‖ₑ * ‖u (x - y)‖ₑ‖ₑ := by
    filter_upwards [h.ae_convolutionExistsAt j (by norm_num : (1 : ℝ≥0∞) ≤ 2) hu] with x hx
    rw [enorm_eq_self, convolution_eq_integral_sub]
    have hxi := integrable_mul_of_convolutionExistsAt hx
    rw [jsw_integral_eq_tsum (-k) hxi]
    refine enorm_tsum_le_tsum_enorm.trans ?_
    rw [← lintegral_sub_left_eq_self (fun y => ‖B y‖ₑ * ‖u (x - y)‖ₑ) x,
      jsw_lintegral_eq_tsum (-k)]
    refine ENNReal.tsum_le_tsum fun i => ?_
    have := h.enorm_setIntegral_mean_zero_le (-k, i) (j := j) (by simp; omega) (hloc i)
      (hint i) x hxi.integrableOn
    refine this.trans (le_of_eq ?_)
    refine lintegral_congr fun y => ?_
    rw [sub_sub_cancel, Real.enorm_eq_ofReal (jswKer_nonneg hβ j _)]
    simp only [β]
    congr 4
  calc eLpNorm (jswDiff n φ j u) 2 volume
      = eLpNorm (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] u) 2 volume := by
        congr 1; funext x; simp [jswDiff, hE]
    _ ≤ eLpNorm (fun x => ∫⁻ y, ‖B y‖ₑ * ‖u (x - y)‖ₑ) 2 volume :=
        eLpNorm_mono_enorm_ae (AEStronglyMeasurable.convolution _ (h.integrable_dilate j).1
          hu.aestronglyMeasurable) hpt
    _ ≤ eLpNorm B 1 volume * eLpNorm u 2 volume :=
        eLpNorm_lintegral_enorm_mul_sub_le (by norm_num) hBm hu.aestronglyMeasurable
    _ = _ := by rw [hB1]

end JswE3

section JswE4

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-! ### Almost orthogonality: the `L²` square function bound -/

/-- `ρ = 2^{-1/2}`. -/
def jswRho : ℝ := (Real.sqrt 2)⁻¹

lemma jswRho_pos : 0 < jswRho := by unfold jswRho; positivity

lemma jswRho_sq : jswRho ^ 2 = 2⁻¹ := by
  rw [jswRho, inv_pow, Real.sq_sqrt (by norm_num)]

lemma jswRho_lt_one : jswRho < 1 := by
  have h := jswRho_sq
  nlinarith [jswRho_pos]

lemma jsw_half_le_rho : (2 : ℝ)⁻¹ ≤ jswRho := by
  have h := jswRho_sq
  nlinarith [jswRho_pos, jswRho_lt_one]

/-- `∑_{d ∈ T} ρ^{|d - a|} ≤ 2 / (1 - ρ)` for every finite `T ⊆ ℤ`. -/
lemma jsw_sum_rho_le (T : Finset ℤ) (a : ℤ) :
    ∑ d ∈ T, jswRho ^ (d - a).natAbs ≤ 2 / (1 - jswRho) := by
  classical
  have hρ0 := jswRho_pos
  have hρ1 := jswRho_lt_one
  have hgeo : ∀ U : Finset ℕ, ∑ m ∈ U, jswRho ^ m ≤ (1 - jswRho)⁻¹ := fun U => by
    rw [← tsum_geometric_of_lt_one hρ0.le hρ1]
    exact Summable.sum_le_tsum _ (fun _ _ => by positivity)
      (summable_geometric_of_lt_one hρ0.le hρ1)
  have hpart : ∀ (P : ℤ → Prop) [DecidablePred P], (∀ d ∈ T.filter P, ∀ d' ∈ T.filter P,
      (d - a).natAbs = (d' - a).natAbs → d = d') →
      ∑ d ∈ T.filter P, jswRho ^ (d - a).natAbs ≤ (1 - jswRho)⁻¹ := by
    intro P _ hinj
    rw [← Finset.sum_image (f := fun m => jswRho ^ m) hinj]
    exact hgeo _
  rw [← Finset.sum_filter_add_sum_filter_not T (fun d => a ≤ d)]
  have h1 := hpart (fun d => a ≤ d) (fun d hd d' hd' he => by
    have := (Finset.mem_filter.1 hd).2; have := (Finset.mem_filter.1 hd').2; omega)
  have h2 := hpart (fun d => ¬ a ≤ d) (fun d hd d' hd' he => by
    have := (Finset.mem_filter.1 hd).2; have := (Finset.mem_filter.1 hd').2; omega)
  calc _ ≤ (1 - jswRho)⁻¹ + (1 - jswRho)⁻¹ := add_le_add h1 h2
    _ = 2 / (1 - jswRho) := by ring

/-- Schur's test for finite matrices. -/
lemma jsw_schur {ι κ : Type*} (s : Finset ι) (t : Finset κ) (c : ι → κ → ℝ)
    (hc : ∀ i k, 0 ≤ c i k) {S : ℝ} (h1 : ∀ i ∈ s, ∑ k ∈ t, c i k ≤ S)
    (h2 : ∀ k ∈ t, ∑ i ∈ s, c i k ≤ S) (x : κ → ℝ) :
    ∑ i ∈ s, (∑ k ∈ t, c i k * x k) ^ 2 ≤ S ^ 2 * ∑ k ∈ t, x k ^ 2 := by
  have hcs : ∀ i ∈ s, (∑ k ∈ t, c i k * x k) ^ 2 ≤ S * ∑ k ∈ t, c i k * x k ^ 2 := by
    intro i hi
    have := Finset.sum_mul_sq_le_sq_mul_sq t (fun k => Real.sqrt (c i k))
      (fun k => Real.sqrt (c i k) * x k)
    have e1 : ∀ k, Real.sqrt (c i k) * (Real.sqrt (c i k) * x k) = c i k * x k := fun k => by
      rw [← mul_assoc, Real.mul_self_sqrt (hc i k)]
    have e2 : ∀ k, Real.sqrt (c i k) ^ 2 = c i k := fun k => Real.sq_sqrt (hc i k)
    have e3 : ∀ k, (Real.sqrt (c i k) * x k) ^ 2 = c i k * x k ^ 2 := fun k => by
      rw [mul_pow, e2]
    simp only [e1, e2, e3] at this
    refine this.trans ?_
    gcongr
    · exact Finset.sum_nonneg fun k _ => by have := hc i k; positivity
    · exact h1 i hi
  have hS : 0 ≤ S ∨ s = ∅ := by
    rcases s.eq_empty_or_nonempty with h | ⟨i, hi⟩
    · exact Or.inr h
    · exact Or.inl ((Finset.sum_nonneg fun k _ => hc i k).trans (h1 i hi))
  rcases hS with hS | hS
  · calc ∑ i ∈ s, (∑ k ∈ t, c i k * x k) ^ 2 ≤ ∑ i ∈ s, S * ∑ k ∈ t, c i k * x k ^ 2 :=
          Finset.sum_le_sum hcs
      _ = S * ∑ k ∈ t, x k ^ 2 * ∑ i ∈ s, c i k := by
          rw [← Finset.mul_sum, Finset.sum_comm]
          congr 1
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun i _ => by ring
      _ ≤ S * ∑ k ∈ t, x k ^ 2 * S := by
          gcongr with k hk
          exact h2 k hk
      _ = S ^ 2 * ∑ k ∈ t, x k ^ 2 := by rw [← Finset.sum_mul]; ring
  · subst hS; rw [Finset.sum_empty]; positivity

lemma jsw_le_of_sq_le {a b : ℝ≥0∞} (h : a ^ 2 ≤ b ^ 2) : a ≤ b := by
  have := ENNReal.rpow_le_rpow h (by norm_num : (0 : ℝ) ≤ 1 / 2)
  have e : ∀ c : ℝ≥0∞, (c ^ 2) ^ (1 / 2 : ℝ) = c := fun c => by
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]; norm_num
  rwa [e, e] at this

/-- The constant `C₀ = 2 A √n I_n`. -/
def jswC0 (n : ℕ) (A : ℝ) : ℝ := 2 * A * Real.sqrt n * (jswI n).toReal

lemma jsw_two_zpow_neg_natAbs (d : ℤ) (hd : d ≤ 0) :
    (2 : ℝ) ^ d ≤ jswRho ^ d.natAbs := by
  have : (2 : ℝ) ^ d = (2⁻¹ : ℝ) ^ d.natAbs := by
    rw [inv_pow, ← zpow_natCast, ← zpow_neg]; congr 1; omega
  rw [this]
  exact pow_le_pow_left₀ (by norm_num) jsw_half_le_rho _

/-- The unified estimate for one piece of the martingale decomposition. -/
theorem JswAdm.eLpNorm_jswDiff_piece_le (h : JswAdm n A φ) {m j : ℤ}
    {g : EuclideanSpace ℝ (Fin n) → ℂ} (hg2 : MemLp g 2 volume)
    (hfine : j < m → ∀ x, dyadicAvg n (m - 1) g x = 0) (hcoarse : m ≤ j → JswMeas m g) :
    eLpNorm (jswDiff n φ j g) 2 volume ≤
      ENNReal.ofReal (jswC0 n A * jswRho ^ (j - m).natAbs) * eLpNorm g 2 volume := by
  have hA := h.nonneg
  have hI : jswI n = ENNReal.ofReal (jswI n).toReal := (ENNReal.ofReal_toReal jswI_ne_top).symm
  have hT : 0 ≤ (jswI n).toReal := ENNReal.toReal_nonneg
  have hρ := jswRho_pos
  rcases lt_or_ge j m with hjm | hmj
  · refine (h.eLpNorm_jswDiff_fine_le (k := m - 1) (by omega) hg2 (hfine hjm)).trans ?_
    rw [hI, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    have h2 : (2 : ℝ) ^ (j - (m - 1)) ≤ 2 * jswRho ^ (j - m).natAbs := by
      rw [show j - (m - 1) = (j - m) + 1 by ring, zpow_add_one₀ two_ne_zero, mul_comm]
      gcongr
      exact jsw_two_zpow_neg_natAbs _ (by omega)
    unfold jswC0
    calc A * (2 : ℝ) ^ (j - (m - 1)) * Real.sqrt n * (jswI n).toReal
        ≤ A * (2 * jswRho ^ (j - m).natAbs) * Real.sqrt n * (jswI n).toReal := by gcongr
      _ = _ := by ring
  · have hc := h.lintegral_jswDiff_coarse_le hmj (hcoarse hmj) hg2
    rw [jsw_lintegral_sq_eq (h.aestronglyMeasurable_jswDiff j hg2.aestronglyMeasurable),
      jsw_lintegral_sq_eq hg2.aestronglyMeasurable] at hc
    refine jsw_le_of_sq_le (hc.trans (le_of_eq ?_))
    rw [mul_pow, ← ENNReal.ofReal_pow (by unfold jswC0; positivity), hI,
      ← ENNReal.ofReal_pow hT, ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    unfold jswC0
    have hd : (2 : ℝ) ^ (m - j) = (jswRho ^ 2) ^ (j - m).natAbs := by
      rw [jswRho_sq, inv_pow, ← zpow_natCast, ← zpow_neg]; congr 1; omega
    rw [hd, mul_pow, mul_pow, mul_pow, Real.sq_sqrt (Nat.cast_nonneg _), ← pow_mul,
      ← pow_mul]
    ring

end JswE4

section JswE5

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-- The constant of the `L²` square function bound. -/
def jswL2Const (n : ℕ) (A : ℝ) : ℝ := jswC0 n A * (2 / (1 - jswRho))

lemma jswL2Const_nonneg (hA : 0 ≤ A) : 0 ≤ jswL2Const n A := by
  have := jswRho_lt_one
  unfold jswL2Const jswC0
  have : 0 < 1 - jswRho := by linarith
  have := (ENNReal.toReal_nonneg (a := jswI n))
  positivity

lemma jsw_sum_range_rho_le (M : ℕ) (j K : ℤ) :
    ∑ i ∈ Finset.range M, jswRho ^ (j - (K + i)).natAbs ≤ 2 / (1 - jswRho) := by
  have hinj : Set.InjOn (fun i : ℕ => K + (i : ℤ)) (Finset.range M) := fun a _ b _ hab => by
    simp only at hab; omega
  have := jsw_sum_rho_le ((Finset.range M).image fun i : ℕ => K + (i : ℤ)) j
  rw [Finset.sum_image hinj] at this
  refine le_trans (le_of_eq ?_) this
  refine Finset.sum_congr rfl fun i _ => ?_
  congr 1
  omega

lemma jsw_memLp_two_ofReal {f : EuclideanSpace ℝ (Fin n) → ℂ} :
    MemLp f (ENNReal.ofReal 2) volume ↔ MemLp f 2 volume := by rw [ENNReal.ofReal_ofNat]

/-- Pythagoras for the martingale decomposition: `‖v‖₂² = ‖w‖₂² + ‖v - w‖₂²` when `w` is
constant on the dyadic cubes of side `2^{-k}` and `E_k v = w`. -/
lemma jsw_pythagoras {k : ℤ} {v w : EuclideanSpace ℝ (Fin n) → ℂ} (hv : MemLp v 2 volume)
    (hw : MemLp w 2 volume) (hwk : JswMeas k w) (hE : dyadicAvg n k v = w) :
    (eLpNorm v 2 volume).toReal ^ 2 =
      (eLpNorm w 2 volume).toReal ^ 2 + (eLpNorm (v - w) 2 volume).toReal ^ 2 := by
  have hd : MemLp (v - w) 2 volume := hv.sub hw
  set U := hw.toLp w
  set V := hd.toLp (v - w)
  have hsum : w + (v - w) = v := by abel
  have hUV : ‖U + V‖ = (eLpNorm v 2 volume).toReal := by
    rw [← MemLp.toLp_add, Lp.norm_toLp, hsum]
  have hinner : inner ℂ U V = 0 := by
    rw [MeasureTheory.L2.inner_def]
    have h0 := jsw_integral_conj_mul_sub_dyadicAvg Real.HolderConjugate.two_two hwk
      (jsw_memLp_two_ofReal.2 hw) (jsw_memLp_two_ofReal.2 hv)
    rw [hE] at h0
    rw [← h0]
    refine integral_congr_ae ?_
    filter_upwards [hw.coeFn_toLp, hd.coeFn_toLp] with x h1 h2
    rw [h1, h2]
    simp [RCLike.inner_apply, mul_comm]
  have := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero U V hinner
  rw [hUV, Lp.norm_toLp, Lp.norm_toLp] at this
  nlinarith [this]

/-- **The `L²` square function bound**: for admissible `φ`, every finite `s ⊆ ℤ` and `f ∈ L²`,
`∑_{j ∈ s} ‖φ_j * f - E_j f‖₂² ≤ C² ‖f‖₂²` with `C = jswL2Const n A`. -/
theorem JswAdm.sum_eLpNorm_jswDiff_sq_le (h : JswAdm n A φ) (s : Finset ℤ)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f 2 volume) :
    ∑ j ∈ s, eLpNorm (jswDiff n φ j f) 2 volume ^ 2 ≤
      ENNReal.ofReal (jswL2Const n A) ^ 2 * eLpNorm f 2 volume ^ 2 := by
  classical
  rcases s.eq_empty_or_nonempty with rfl | hs
  · simp
  have hA := h.nonneg
  have hf' : MemLp f (ENNReal.ofReal 2) volume := jsw_memLp_two_ofReal.2 hf
  set K := s.min' hs
  set N := (s.max' hs - K).toNat
  have hsK : ∀ j ∈ s, K ≤ j ∧ j ≤ K + N := fun j hj =>
    ⟨s.min'_le j hj, by have := s.le_max' j hj; omega⟩
  set a : ℕ → EuclideanSpace ℝ (Fin n) → ℂ :=
    fun i => if i ≤ N then dyadicAvg n (K + i) f else f with ha
  set piece : ℕ → EuclideanSpace ℝ (Fin n) → ℂ :=
    fun i => if i = 0 then a 0 else a i - a (i - 1) with hpiece
  have ha_le : ∀ i ≤ N, a i = dyadicAvg n (K + i) f := fun i hi => ite_eq_left hi
  have ha_top : a (N + 1) = f := ite_eq_right (by omega)
  have hmemA : ∀ i, MemLp (a i) 2 volume := fun i => by
    by_cases hi : i ≤ N
    · rw [ha_le i hi]; exact jsw_memLp_two_dyadicAvg _ hf
    · simp only [ha, ite_eq_right hi]; exact hf
  have hp0 : piece 0 = a 0 := ite_eq_left rfl
  have hps : ∀ i, piece (i + 1) = a (i + 1) - a i := fun i => by
    simp only [hpiece, ite_eq_right (Nat.succ_ne_zero i), Nat.add_sub_cancel]
  have hmemP : ∀ i, MemLp (piece i) 2 volume := fun i => by
    rcases i with _ | i
    · rw [hp0]; exact hmemA 0
    · rw [hps]; exact (hmemA _).sub (hmemA _)
  have hmeasA : ∀ i ≤ N, JswMeas (K + i) (a i) := fun i hi => by
    rw [ha_le i hi]; exact jswMeas_dyadicAvg _ _
  have htower : ∀ i ≤ N, dyadicAvg n (K + i) (a (i + 1)) = a i := by
    intro i hi
    rw [ha_le i hi]
    rcases Nat.lt_or_ge i N with hlt | hge
    · rw [ha_le (i + 1) hlt]
      exact jsw_dyadicAvg_dyadicAvg one_lt_two (by push_cast; omega) hf'
    · have : i = N := le_antisymm hi hge
      subst this
      rw [ha_top]
  have hloc : ∀ i k' i', IntegrableOn (a i) (czCube (k', i')) := fun i =>
    jsw_integrableOn_czCube (by norm_num) (hmemA i)
  -- the estimate for each piece
  have hpiece_le : ∀ j ∈ s, ∀ i ≤ N + 1, eLpNorm (jswDiff n φ j (piece i)) 2 volume ≤
      ENNReal.ofReal (jswC0 n A * jswRho ^ (j - (K + i)).natAbs) *
        eLpNorm (piece i) 2 volume := by
    intro j hj i hi
    obtain ⟨hKj, hjN⟩ := hsK j hj
    refine h.eLpNorm_jswDiff_piece_le (hmemP i) (fun hjm x => ?_) (fun hmj => ?_)
    · rcases i with _ | i
      · exact absurd hjm (by push_cast; omega)
      · rw [hps, jsw_dyadicAvg_sub (hloc _ _) (hloc _ _),
          show K + ((i + 1 : ℕ) : ℤ) - 1 = K + i by push_cast; ring, htower i (by omega),
          jsw_dyadicAvg_of_jswMeas (hmeasA i (by omega)), sub_self]
    · rcases i with _ | i
      · rw [hp0]; simpa using hmeasA 0 (Nat.zero_le _)
      · rw [hps]
        have hiN : i + 1 ≤ N := by push_cast at hmj; omega
        refine JswMeas.sub (hmeasA (i + 1) hiN) ((hmeasA i (by omega)).mono ?_)
        push_cast; omega
  -- sublinearity along the decomposition
  have hsub : ∀ j ∈ s, ∀ m ≤ N + 1, eLpNorm (jswDiff n φ j (a m)) 2 volume ≤
      ∑ i ∈ Finset.range (m + 1), eLpNorm (jswDiff n φ j (piece i)) 2 volume := by
    intro j hj m
    induction m with
    | zero => intro _; rw [Finset.sum_range_one, hp0]
    | succ m ih =>
      intro hm
      have hsplit : a (m + 1) = a m + piece (m + 1) := by rw [hps]; abel
      rw [Finset.sum_range_succ, hsplit,
        eLpNorm_congr_ae (h.jswDiff_add j (by norm_num) (hmemA m) (hmemP (m + 1)))]
      exact (eLpNorm_add_le (f := jswDiff n φ j (a m)) (g := jswDiff n φ j (piece (m + 1)))
        (by norm_num)).trans (add_le_add (ih (by omega)) le_rfl)
  -- orthogonality
  have horth : ∀ m ≤ N + 1, ∑ i ∈ Finset.range (m + 1), (eLpNorm (piece i) 2 volume).toReal ^ 2 =
      (eLpNorm (a m) 2 volume).toReal ^ 2 := by
    intro m
    induction m with
    | zero => intro _; rw [Finset.sum_range_one, hp0]
    | succ m ih =>
      intro hm
      rw [Finset.sum_range_succ, ih (by omega), hps,
        jsw_pythagoras (hmemA (m + 1)) (hmemA m) (hmeasA m (by omega)) (htower m (by omega))]
  -- real-valued Schur argument
  set x : ℕ → ℝ := fun i => (eLpNorm (piece i) 2 volume).toReal
  set c : ℤ → ℕ → ℝ := fun j i => jswC0 n A * jswRho ^ (j - (K + i)).natAbs
  have hc0 : ∀ j i, 0 ≤ c j i := fun j i => by
    have := jswRho_pos; have := (ENNReal.toReal_nonneg (a := jswI n))
    simp only [c, jswC0]; positivity
  have hfinP : ∀ i, eLpNorm (piece i) 2 volume ≠ ∞ := fun i => (hmemP i).eLpNorm_ne_top
  have hy : ∀ j ∈ s, eLpNorm (jswDiff n φ j f) 2 volume ≤
      ENNReal.ofReal (∑ i ∈ Finset.range (N + 2), c j i * x i) := by
    intro j hj
    rw [← ha_top]
    refine (hsub j hj (N + 1) le_rfl).trans ?_
    rw [ENNReal.ofReal_sum_of_nonneg fun i _ => mul_nonneg (hc0 j i) ENNReal.toReal_nonneg]
    refine Finset.sum_le_sum fun i hi => (hpiece_le j hj i (by
      have := Finset.mem_range.1 hi; omega)).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_mul (hc0 j i), ENNReal.ofReal_toReal (hfinP i)]
  have hS : ∀ j ∈ s, ∑ i ∈ Finset.range (N + 2), c j i ≤ jswL2Const n A := by
    intro j _
    simp only [c, ← Finset.mul_sum, jswL2Const]
    exact mul_le_mul_of_nonneg_left (jsw_sum_range_rho_le _ _ _) (by
      have := (ENNReal.toReal_nonneg (a := jswI n)); unfold jswC0; positivity)
  have hS' : ∀ i ∈ Finset.range (N + 2), ∑ j ∈ s, c j i ≤ jswL2Const n A := by
    intro i _
    simp only [c, ← Finset.mul_sum, jswL2Const]
    exact mul_le_mul_of_nonneg_left (jsw_sum_rho_le _ _) (by
      have := (ENNReal.toReal_nonneg (a := jswI n)); unfold jswC0; positivity)
  have hschur := jsw_schur s (Finset.range (N + 2)) c hc0 hS hS' x
  rw [horth (N + 1) le_rfl, ha_top] at hschur
  have hL := jswL2Const_nonneg (n := n) hA
  calc ∑ j ∈ s, eLpNorm (jswDiff n φ j f) 2 volume ^ 2
      ≤ ∑ j ∈ s, ENNReal.ofReal (∑ i ∈ Finset.range (N + 2), c j i * x i) ^ 2 :=
        Finset.sum_le_sum fun j hj => by gcongr; exact hy j hj
    _ = ENNReal.ofReal (∑ j ∈ s, (∑ i ∈ Finset.range (N + 2), c j i * x i) ^ 2) := by
        rw [ENNReal.ofReal_sum_of_nonneg fun j _ => by positivity]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [ENNReal.ofReal_pow (Finset.sum_nonneg fun i _ =>
          mul_nonneg (hc0 j i) ENNReal.toReal_nonneg)]
    _ ≤ ENNReal.ofReal (jswL2Const n A ^ 2 * (eLpNorm f 2 volume).toReal ^ 2) :=
        ENNReal.ofReal_le_ofReal hschur
    _ = _ := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow hL,
          ENNReal.ofReal_pow ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hf.eLpNorm_ne_top]

end JswE5

section JswF1

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-! ### The bad part of the Calderón–Zygmund decomposition -/

lemma jsw_convolution_indicator (k u : EuclideanSpace ℝ (Fin n) → ℂ)
    (Q : Set (EuclideanSpace ℝ (Fin n)))
    (hQ : MeasurableSet Q) (x : EuclideanSpace ℝ (Fin n)) :
    (k ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] Q.indicator u) x = ∫ y in Q, k (x - y) * u y := by
  rw [convolution_eq_integral_sub]
  rw [← integral_indicator hQ]
  congr 1; funext y
  exact (Set.indicator_mul_right Q (fun y => k (x - y)) u).symm

lemma jsw_dyadicAvg_indicator (j : ℤ) (u : EuclideanSpace ℝ (Fin n) → ℂ)
    (Q : Set (EuclideanSpace ℝ (Fin n))) (hQ : MeasurableSet Q) (x : EuclideanSpace ℝ (Fin n)) :
    dyadicAvg n j (Q.indicator u) x = (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) *
      ∫ y in Q, (czCube (-j, czDyIdx (-j) x)).indicator u y := by
  rw [jsw_dyadicAvg_eq, setIntegral_indicator hQ, setIntegral_indicator (measurableSet_czCube _),
    inter_comm]

lemma jsw_one_le_sqrt (hn : 0 < n) : (1 : ℝ) ≤ Real.sqrt n :=
  Real.one_le_sqrt.2 (by exact_mod_cast hn)

/-- **The bad cube lemma**: for `u` with mean zero on the dyadic cube `Q` of side `2^{p.1}`,
`∫_{(Q*)ᶜ} |D_j (u 𝟙_Q)| ≤ A √n 2^{-|j + p.1|} I_n ∫_Q |u|`, where `Q*` is the ball of radius
`2√n 2^{p.1}` around the corner of `Q`. -/
theorem JswAdm.lintegral_jswDiff_indicator_le (hn : 0 < n) (h : JswAdm n A φ)
    (p : ℤ × (Fin n → ℤ)) (j : ℤ) {u : EuclideanSpace ℝ (Fin n) → ℂ}
    (hu : IntegrableOn u (czCube p)) (h0 : ∫ y in czCube p, u y = 0) :
    ∫⁻ x in (closedBall (czCorner p) (2 * (Real.sqrt n * (2 : ℝ) ^ p.1)))ᶜ,
        ‖jswDiff n φ j ((czCube p).indicator u) x‖ₑ ≤
      ENNReal.ofReal (A * Real.sqrt n * (2⁻¹ : ℝ) ^ (j + p.1).natAbs) * jswI n *
        ∫⁻ y in czCube p, ‖u y‖ₑ := by
  set Q := czCube p
  set c := czCorner p
  set B := closedBall c (2 * (Real.sqrt n * (2 : ℝ) ^ p.1))
  have hA := h.nonneg
  have hsq := jsw_one_le_sqrt hn
  have h2p : (0 : ℝ) < (2 : ℝ) ^ p.1 := zpow_pos two_pos _
  have hQm : MeasurableSet Q := measurableSet_czCube _
  have hQB : Q ⊆ B := (czCube_subset_closedBall (czCorner_mem p)).trans
    (closedBall_subset_closedBall (by nlinarith))
  rcases le_or_gt 0 (j + p.1) with hjp | hjp
  · -- fine scales: the averages vanish off `Q`, and the kernel has small tails
    have hE : ∀ x ∉ B, dyadicAvg n j (Q.indicator u) x = 0 := by
      intro x hx
      rw [jsw_dyadicAvg_indicator j u Q hQm x, setIntegral_eq_zero_of_forall_eq_zero, mul_zero]
      intro y hy
      refine indicator_of_notMem (fun hyD => hx (hQB ?_)) _
      have h1 : czDyIdx (-j) x = czDyIdx (-j) y := hyD.symm
      have h2 := czDyIdx_eq_of_le (k := -j) (k' := p.1) (by omega) (x := y) (y := x) h1
      exact h2.trans hy
    set R := {z : EuclideanSpace ℝ (Fin n) | (2 : ℝ) ^ p.1 ≤ ‖z‖}
    have hR : MeasurableSet R := measurableSet_le measurable_const measurable_norm
    have hKc := jsw_continuous_dilate h.cont j
    have hgeo : ∀ x ∉ B, ∀ y ∈ Q, x - y ∈ R := by
      intro x hx y hy
      have hyc : ‖y - c‖ ≤ Real.sqrt n * (2 : ℝ) ^ p.1 := norm_sub_le_of_mem_czCube hy
        (czCorner_mem _)
      have hxc : 2 * (Real.sqrt n * (2 : ℝ) ^ p.1) < ‖x - c‖ := by
        simpa [B, mem_closedBall, dist_eq_norm] using hx
      have : ‖x - c‖ ≤ ‖x - y‖ + ‖y - c‖ := by
        calc ‖x - c‖ = ‖(x - y) + (y - c)‖ := by congr 1; abel
          _ ≤ _ := norm_add_le _ _
      change (2 : ℝ) ^ p.1 ≤ ‖x - y‖
      nlinarith
    have hmeas : AEMeasurable (Function.uncurry fun x y =>
        R.indicator (fun z => ‖jswDilate n φ j z‖ₑ) (x - y) * ‖u y‖ₑ)
        (volume.prod (volume.restrict Q)) :=
      (((hKc.measurable.enorm.indicator hR).comp
        (measurable_fst.sub measurable_snd)).aemeasurable).mul
        hu.aestronglyMeasurable.enorm.comp_snd
    calc ∫⁻ x in Bᶜ, ‖jswDiff n φ j (Q.indicator u) x‖ₑ
        ≤ ∫⁻ x in Bᶜ, ∫⁻ y in Q, R.indicator (fun z => ‖jswDilate n φ j z‖ₑ) (x - y) *
            ‖u y‖ₑ := by
          refine setLIntegral_mono' measurableSet_closedBall.compl fun x hx => ?_
          rw [jswDiff, hE x hx, sub_zero, jsw_convolution_indicator _ _ Q hQm]
          refine (enorm_integral_le_lintegral_enorm _).trans
            (setLIntegral_mono' hQm fun y hy => ?_)
          rw [enorm_mul, indicator_of_mem (hgeo x hx y hy)]
      _ ≤ ∫⁻ x, ∫⁻ y in Q, R.indicator (fun z => ‖jswDilate n φ j z‖ₑ) (x - y) * ‖u y‖ₑ :=
          setLIntegral_le_lintegral _ _
      _ = ∫⁻ y in Q, (∫⁻ z in R, ‖jswDilate n φ j z‖ₑ) * ‖u y‖ₑ := by
          rw [lintegral_lintegral_swap hmeas]
          refine lintegral_congr fun y => ?_
          rw [lintegral_mul_const' _ _ enorm_ne_top, lintegral_sub_right_eq_self
            (fun z => R.indicator (fun z => ‖jswDilate n φ j z‖ₑ) z) y, lintegral_indicator hR]
      _ ≤ ∫⁻ y in Q, ENNReal.ofReal (A / ((2 : ℝ) ^ j * (2 : ℝ) ^ p.1)) * jswI n * ‖u y‖ₑ := by
          gcongr with y
          exact h.lintegral_tail_le j h2p
      _ = ENNReal.ofReal (A / ((2 : ℝ) ^ j * (2 : ℝ) ^ p.1)) * jswI n * ∫⁻ y in Q, ‖u y‖ₑ :=
          lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top jswI_ne_top)
      _ ≤ _ := by
          gcongr
          rw [← zpow_add₀ two_ne_zero, div_eq_mul_inv, ← zpow_neg]
          have : (2 : ℝ) ^ (-(j + p.1)) = (2⁻¹ : ℝ) ^ (j + p.1).natAbs := by
            rw [inv_pow, ← zpow_natCast, ← zpow_neg]; congr 1; omega
          rw [this]
          have := pow_nonneg (by norm_num : (0 : ℝ) ≤ 2⁻¹) (j + p.1).natAbs
          have := mul_nonneg (mul_nonneg hA this) (sub_nonneg.2 hsq)
          nlinarith
  · -- coarse scales: the averages vanish identically, and the kernel is smooth
    have hE : ∀ x, dyadicAvg n j (Q.indicator u) x = 0 := by
      intro x
      rw [jsw_dyadicAvg_indicator j u Q hQm x]
      set D := czCube (n := n) (-j, czDyIdx (-j) x)
      by_cases hx : ∃ y0 ∈ Q, y0 ∈ D
      · obtain ⟨y0, hy0Q, hy0D⟩ := hx
        have hsub : ∀ y ∈ Q, y ∈ D := by
          intro y hy
          have h1 : czDyIdx p.1 y = czDyIdx p.1 y0 := hy.trans hy0Q.symm
          have h2 := czDyIdx_eq_of_le (k := p.1) (k' := -j) (by omega) (x := y0) (y := y) h1
          exact h2.trans hy0D
        rw [setIntegral_congr_fun hQm (fun y hy => indicator_of_mem (hsub y hy) u), h0, mul_zero]
      · push Not at hx
        rw [setIntegral_eq_zero_of_forall_eq_zero (fun y hy => indicator_of_notMem (hx y hy) _),
          mul_zero]
    calc ∫⁻ x in Bᶜ, ‖jswDiff n φ j (Q.indicator u) x‖ₑ
        ≤ ∫⁻ x, ‖jswDiff n φ j (Q.indicator u) x‖ₑ := setLIntegral_le_lintegral _ _
      _ = ∫⁻ x, ‖∫ y in Q, jswDilate n φ j (x - y) * u y‖ₑ := by
          refine lintegral_congr fun x => ?_
          rw [jswDiff, hE x, sub_zero, jsw_convolution_indicator _ _ Q hQm]
      _ ≤ ENNReal.ofReal (A * (2 : ℝ) ^ (j + p.1) * Real.sqrt n) * jswI n *
            ∫⁻ y in Q, ‖u y‖ₑ := h.lintegral_setIntegral_mean_zero_le p (by omega) hu h0
      _ = _ := by
          have : (2 : ℝ) ^ (j + p.1) = (2⁻¹ : ℝ) ^ (j + p.1).natAbs := by
            rw [inv_pow, ← zpow_natCast, ← zpow_neg]; congr 1; omega
          rw [this, mul_right_comm A]

section Vector

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]

omit [NormedSpace ℂ E] [CompleteSpace E] in
/-- Integrals of functions supported in `Ω` split along the selected cubes. -/
lemma jsw_hasSum_czIdx (hn : 0 < n) {f : EuclideanSpace ℝ (Fin n) → E} {σ : ℝ} (hσ : 0 < σ)
    (hfi : Integrable f) {F : EuclideanSpace ℝ (Fin n) → ℂ} (hF : Integrable F)
    (h0 : ∀ y ∉ czBadSet (vczNorm f) σ, F y = 0) :
    HasSum (fun p : czIdx (vczNorm f) σ => ∫ y in czCube (p : ℤ × (Fin n → ℤ)), F y)
      (∫ y, F y) := by
  have hf := lintegral_vczNorm_ne_top hfi
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := czBadSet (vczNorm f) σ) h0,
    czBadSet_eq_biUnion hn hσ hf, biUnion_eq_iUnion]
  exact hasSum_integral_iUnion (fun p => measurableSet_czCube _)
    (fun p q hpq => czIdx_pairwiseDisjoint hn hσ hf p.2 q.2 (Subtype.coe_injective.ne hpq))
    hF.integrableOn

/-- The bad part estimate for one scale and one coordinate functional `ℓ`, `‖ℓ‖ ≤ 1`. -/
theorem JswAdm.lintegral_compl_czStar_jswDiff_le (hn : 0 < n) (h : JswAdm n A φ)
    {f : EuclideanSpace ℝ (Fin n) → E} (hfi : Integrable f) (hfm : StronglyMeasurable f)
    {σ : ℝ} (hσ : 0 < σ) (ℓ : E →L[ℂ] ℂ) (hℓ : ‖ℓ‖ ≤ 1) (j : ℤ) :
    ∫⁻ x in (czStar (vczNorm f) σ)ᶜ,
        ‖jswDiff n φ j (fun y => ℓ ((f - vczGood f σ) y)) x‖ₑ ≤
      ∑' p : czIdx (vczNorm f) σ, ENNReal.ofReal (A * Real.sqrt n *
        (2⁻¹ : ℝ) ^ (j + (p : ℤ × (Fin n → ℤ)).1).natAbs) * jswI n *
          ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ‖(f - vczGood f σ) y‖ₑ := by
  set b := f - vczGood f σ with hb
  set u : EuclideanSpace ℝ (Fin n) → ℂ := fun y => ℓ (b y) with hu_def
  have hbi : Integrable b := hfi.sub (integrable_vczGood hn hσ hfi hfm)
  have hui : Integrable u := ℓ.integrable_comp hbi
  have hu0 : ∀ y ∉ czBadSet (vczNorm f) σ, u y = 0 := fun y hy => by
    simp only [hu_def, hb]; rw [vczBad_eq_zero_of_notMem hy, map_zero]
  have hmean : ∀ p ∈ czIdx (vczNorm f) σ, ∫ y in czCube p, u y = 0 := fun p hp => by
    rw [ℓ.integral_comp_comm hbi.integrableOn, setIntegral_vczBad_eq_zero hn hσ hfi hp, map_zero]
  have hub : ∀ y, ‖u y‖ₑ ≤ ‖b y‖ₑ := fun y => by
    rw [← ofReal_norm, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal ((ℓ.le_opNorm _).trans (by
      have := norm_nonneg (b y); nlinarith))
  set T : czIdx (vczNorm f) σ → EuclideanSpace ℝ (Fin n) → ℂ := fun p =>
    jswDiff n φ j ((czCube (p : ℤ × (Fin n → ℤ))).indicator u)
  -- pointwise decomposition
  have hdec : ∀ᵐ x, ‖jswDiff n φ j u x‖ₑ ≤ ∑' p, ‖T p x‖ₑ := by
    filter_upwards [h.ae_convolutionExistsAt j le_rfl (memLp_one_iff_integrable.2 hui)]
      with x hx
    have h1 := jsw_hasSum_czIdx hn hσ hfi (integrable_mul_of_convolutionExistsAt hx)
      (fun y hy => by simp [hu0 y hy])
    set D := czCube (n := n) (-j, czDyIdx (-j) x)
    have h2 := jsw_hasSum_czIdx hn hσ hfi (hui.indicator (measurableSet_czCube _))
      (F := D.indicator u) (fun y hy => by simp [hu0 y hy])
    have h3 := h1.sub (h2.mul_left (((2 : ℝ) ^ (j * n) : ℝ) : ℂ))
    have e1 : jswDiff n φ j u x = (∫ y, jswDilate n φ j (x - y) * u y) -
        (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) * ∫ y, D.indicator u y := by
      rw [jswDiff, convolution_eq_integral_sub, jsw_dyadicAvg_eq,
        integral_indicator (measurableSet_czCube _)]
    have e2 : ∀ p : czIdx (vczNorm f) σ, T p x =
        (∫ y in czCube (p : ℤ × (Fin n → ℤ)), jswDilate n φ j (x - y) * u y) -
          (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) * ∫ y in czCube (p : ℤ × (Fin n → ℤ)), D.indicator u y :=
      fun p => by
        simp only [T, jswDiff, jsw_convolution_indicator _ _ _ (measurableSet_czCube _),
          jsw_dyadicAvg_indicator j u _ (measurableSet_czCube _)]
        rfl
    have e : jswDiff n φ j u x = ∑' p, T p x := by
      rw [e1, ← h3.tsum_eq]
      exact tsum_congr fun p => (e2 p).symm
    rw [e]
    exact enorm_tsum_le_tsum_enorm
  have hTm : ∀ p, AEMeasurable (fun x => ‖T p x‖ₑ) (volume.restrict (czStar (vczNorm f) σ)ᶜ) :=
    fun p => (h.aestronglyMeasurable_jswDiff j
      (hui.indicator (measurableSet_czCube _)).aestronglyMeasurable).enorm.restrict
  calc ∫⁻ x in (czStar (vczNorm f) σ)ᶜ, ‖jswDiff n φ j u x‖ₑ
      ≤ ∫⁻ x in (czStar (vczNorm f) σ)ᶜ, ∑' p, ‖T p x‖ₑ :=
        lintegral_mono_ae (ae_restrict_of_ae hdec)
    _ = ∑' p, ∫⁻ x in (czStar (vczNorm f) σ)ᶜ, ‖T p x‖ₑ := lintegral_tsum hTm
    _ ≤ _ := by
        refine ENNReal.tsum_le_tsum fun p => ?_
        have hsub : (czStar (vczNorm f) σ)ᶜ ⊆ (closedBall (czCorner (p : ℤ × (Fin n → ℤ)))
            (2 * (Real.sqrt n * (2 : ℝ) ^ (p : ℤ × (Fin n → ℤ)).1)))ᶜ :=
          compl_subset_compl.2 (subset_biUnion_of_mem (u := fun p : ℤ × (Fin n → ℤ) =>
            closedBall (czCorner p) (2 * (Real.sqrt n * (2 : ℝ) ^ p.1))) p.2)
        refine (lintegral_mono_set hsub).trans ?_
        refine (h.lintegral_jswDiff_indicator_le hn p j hui.integrableOn (hmean p p.2)).trans ?_
        gcongr with y
        exact hub y

end Vector

end JswF1

section JswF2

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-! ### The weak type `(1,1)` estimate -/

section Vector

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]

/-- The constant `A √n I_n · 2/(1 - ρ)` of the bad part estimate. -/
def jswBadConst (n : ℕ) (A : ℝ) : ℝ := A * Real.sqrt n * (jswI n).toReal * (2 / (1 - jswRho))

lemma jswBadConst_nonneg (hA : 0 ≤ A) : 0 ≤ jswBadConst n A := by
  have := jswRho_lt_one
  have : 0 < 1 - jswRho := by linarith
  have := (ENNReal.toReal_nonneg (a := jswI n))
  unfold jswBadConst; positivity

/-- The bad part estimate, summed over the scales `j ∈ s`, for coordinate functionals
`ℓ_j` of norm at most `1`. -/
theorem JswAdm.lintegral_compl_czStar_sum_le (hn : 0 < n) (h : JswAdm n A φ) (s : Finset ℤ)
    {f : EuclideanSpace ℝ (Fin n) → E} (hfi : Integrable f) (hfm : StronglyMeasurable f)
    {σ : ℝ} (hσ : 0 < σ) (ℓ : ℤ → E →L[ℂ] ℂ) (hℓ : ∀ j, ‖ℓ j‖ ≤ 1) :
    ∫⁻ x in (czStar (vczNorm f) σ)ᶜ,
        ∑ j ∈ s, ‖jswDiff n φ j (fun y => ℓ j ((f - vczGood f σ) y)) x‖ₑ ≤
      ENNReal.ofReal (jswBadConst n A) * ∫⁻ y, ‖(f - vczGood f σ) y‖ₑ := by
  set b := f - vczGood f σ with hb
  have hbi : Integrable b := hfi.sub (integrable_vczGood hn hσ hfi hfm)
  have hf := lintegral_vczNorm_ne_top hfi
  have hA := h.nonneg
  have hI : jswI n = ENNReal.ofReal (jswI n).toReal := (ENNReal.ofReal_toReal jswI_ne_top).symm
  set c := A * Real.sqrt n
  have hc : 0 ≤ c := by positivity
  have hgeo : ∀ p : ℤ × (Fin n → ℤ), ∑ j ∈ s, ENNReal.ofReal (c * (2⁻¹ : ℝ) ^ (j + p.1).natAbs) ≤
      ENNReal.ofReal (c * (2 / (1 - jswRho))) := by
    intro p
    rw [← ENNReal.ofReal_sum_of_nonneg (fun j _ => by positivity), ← Finset.mul_sum]
    refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left ?_ hc)
    refine le_trans (Finset.sum_le_sum fun j _ => pow_le_pow_left₀ (by norm_num)
      jsw_half_le_rho _) ?_
    have := jsw_sum_rho_le s (-p.1)
    simpa [sub_neg_eq_add] using this
  calc ∫⁻ x in (czStar (vczNorm f) σ)ᶜ, ∑ j ∈ s, ‖jswDiff n φ j (fun y => ℓ j (b y)) x‖ₑ
      = ∑ j ∈ s, ∫⁻ x in (czStar (vczNorm f) σ)ᶜ, ‖jswDiff n φ j (fun y => ℓ j (b y)) x‖ₑ :=
        lintegral_finsetSum' _ fun j _ => (h.aestronglyMeasurable_jswDiff j
          ((ℓ j).integrable_comp hbi).aestronglyMeasurable).enorm.restrict
    _ ≤ ∑ j ∈ s, ∑' p : czIdx (vczNorm f) σ, ENNReal.ofReal (c *
          (2⁻¹ : ℝ) ^ (j + (p : ℤ × (Fin n → ℤ)).1).natAbs) * jswI n *
            ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ‖b y‖ₑ :=
        Finset.sum_le_sum fun j _ =>
          h.lintegral_compl_czStar_jswDiff_le hn hfi hfm hσ (ℓ j) (hℓ j) j
    _ = ∑' p : czIdx (vczNorm f) σ, (∑ j ∈ s, ENNReal.ofReal (c *
          (2⁻¹ : ℝ) ^ (j + (p : ℤ × (Fin n → ℤ)).1).natAbs)) * (jswI n *
            ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ‖b y‖ₑ) := by
        rw [← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
        refine tsum_congr fun p => ?_
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun j _ => by ring
    _ ≤ ∑' p : czIdx (vczNorm f) σ, ENNReal.ofReal (c * (2 / (1 - jswRho))) * (jswI n *
            ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ‖b y‖ₑ) :=
        ENNReal.tsum_le_tsum fun p => mul_le_mul' (hgeo p) le_rfl
    _ = ENNReal.ofReal (c * (2 / (1 - jswRho))) * jswI n *
          ∫⁻ y in ⋃ p ∈ czIdx (vczNorm f) σ, czCube p, ‖b y‖ₑ := by
        rw [ENNReal.tsum_mul_left, ENNReal.tsum_mul_left, lintegral_biUnion czIdx_countable
          (fun p _ => measurableSet_czCube p) (czIdx_pairwiseDisjoint hn hσ hf)]
        ring
    _ ≤ ENNReal.ofReal (c * (2 / (1 - jswRho))) * jswI n * ∫⁻ y, ‖b y‖ₑ :=
        mul_le_mul' le_rfl (setLIntegral_le_lintegral _ _)
    _ = _ := by
        rw [hI, ← ENNReal.ofReal_mul (by
          have := jswRho_lt_one; have : 0 < 1 - jswRho := by linarith
          positivity)]
        congr 2
        unfold jswBadConst; ring

omit [CompleteSpace E] in
/-- Assembly of the weak type `(1,1)` estimate from the Calderón–Zygmund decomposition at
height `t / B`. -/
theorem jsw_volume_lt_le_of_split (hn : 0 < n) {f : EuclideanSpace ℝ (Fin n) → E}
    (hfi : Integrable f) {B t : ℝ} (hB : 0 < B) (ht : 0 < t)
    {Tf Tg Tb : EuclideanSpace ℝ (Fin n) → ℝ≥0∞} (hTg : AEMeasurable Tg volume)
    (hTb : AEMeasurable Tb volume) (hsplit : ∀ᵐ x, Tf x ≤ Tg x + Tb x)
    (hgood : ∫⁻ x, Tg x ^ 2 ≤ ENNReal.ofReal B ^ 2 * ∫⁻ x, ‖vczGood f (t / B) x‖ₑ ^ 2)
    (hbad : ∫⁻ x in (czStar (vczNorm f) (t / B))ᶜ, Tb x ≤
      ENNReal.ofReal B * ∫⁻ x, ‖(f - vczGood f (t / B)) x‖ₑ) :
    volume {x | ENNReal.ofReal t < Tf x} ≤
      ENNReal.ofReal (vczWeakConst n * B / t) * ∫⁻ x, ‖f x‖ₑ := by
  set σ := t / B with hσ_def
  have hσ : 0 < σ := div_pos ht hB
  have hf := lintegral_vczNorm_ne_top hfi
  set g := vczGood f σ
  set Fn := ∫⁻ y, ‖f y‖ₑ
  set τ := ENNReal.ofReal (t / 2)
  have hτ0 : τ ≠ 0 := (ENNReal.ofReal_pos.2 (half_pos ht)).ne'
  have hτt : τ ≠ ∞ := ENNReal.ofReal_ne_top
  have hincl : {x | ENNReal.ofReal t < Tf x} ≤ᵐ[volume]
      (({x | τ ≤ Tg x} ∪ ({x | τ ≤ Tb x} ∩ (czStar (vczNorm f) σ)ᶜ)) ∪
        czStar (vczNorm f) σ : Set _) := by
    filter_upwards [hsplit] with x hx
    intro hxt
    have hxt' : ENNReal.ofReal t < Tg x + Tb x := lt_of_lt_of_le hxt hx
    by_cases hstar : x ∈ czStar (vczNorm f) σ
    · exact Or.inr hstar
    · left
      by_contra hc
      simp only [mem_union, mem_inter_iff, mem_compl_iff, mem_ofPred_eq, not_or, not_and,
        not_le] at hc
      have h1 := hc.1
      have h2 : Tb x < τ := not_le.1 fun hle => hc.2 hle hstar
      have : Tg x + Tb x < τ + τ := ENNReal.add_lt_add h1 h2
      rw [← ENNReal.ofReal_add (half_pos ht).le (half_pos ht).le, add_halves] at this
      exact absurd hxt' (not_lt.2 this.le)
  -- the exceptional set
  have hstar : volume (czStar (vczNorm f) σ) ≤
      ENNReal.ofReal ((4 * Real.sqrt n) ^ n * B / t) * Fn := by
    refine (volume_czStar_le hn hσ hf).trans
      ((mul_le_mul' le_rfl (volume_czBadSet_le hn hσ hf)).trans_eq ?_)
    simp only [enorm_vczNorm]
    rw [← ENNReal.ofReal_inv_of_pos hσ, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    rw [hσ_def]
    field_simp
  -- the good part
  have hgsq := lintegral_vczGood_sq_le hn hσ hfi
  simp only [ENNReal.rpow_two] at hgsq
  have hgood' : volume {x | τ ≤ Tg x} ≤ ENNReal.ofReal (4 * 2 ^ n * B / t) * Fn := by
    have hτ2 : {x | τ ≤ Tg x} ⊆ {x | τ ^ 2 ≤ Tg x ^ 2} := fun x hx => by
      simp only [mem_ofPred_eq] at hx ⊢; gcongr
    refine (measure_mono hτ2).trans ((meas_ge_le_lintegral_div (hTg.pow_const 2)
      (pow_ne_zero 2 hτ0) (ENNReal.pow_ne_top hτt)).trans ?_)
    calc (∫⁻ x, Tg x ^ 2) / τ ^ 2
        ≤ (ENNReal.ofReal B ^ 2 * (2 ^ n * ENNReal.ofReal σ * Fn)) / τ ^ 2 := by
          gcongr; exact hgood.trans (mul_le_mul' le_rfl hgsq)
      _ = ENNReal.ofReal (4 * 2 ^ n * B / t) * Fn := by
          rw [div_eq_mul_inv, ← ENNReal.ofReal_pow (half_pos ht).le,
            ← ENNReal.ofReal_inv_of_pos (by positivity), ← ENNReal.ofReal_pow hB.le,
            show (2 : ℝ≥0∞) ^ n = ENNReal.ofReal (2 ^ n) by
              rw [ENNReal.ofReal_pow (by norm_num), ENNReal.ofReal_ofNat]]
          rw [show ENNReal.ofReal (B ^ 2) * (ENNReal.ofReal (2 ^ n) * ENNReal.ofReal σ * Fn) *
              ENNReal.ofReal (((t / 2) ^ 2)⁻¹) = ENNReal.ofReal (B ^ 2 * (2 ^ n * σ) *
                ((t / 2) ^ 2)⁻¹) * Fn by
            rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
              ENNReal.ofReal_mul (by positivity)]; ring]
          congr 2
          rw [hσ_def]; field_simp; ring
  -- the bad part
  have hb1 : ∫⁻ y, ‖(f - g) y‖ₑ ≤ 2 * Fn := by
    calc ∫⁻ y, ‖(f - g) y‖ₑ ≤ ∫⁻ y, (‖f y‖ₑ + ‖g y‖ₑ) :=
          lintegral_mono fun y => by simp only [Pi.sub_apply]; exact enorm_sub_le
      _ = Fn + ∫⁻ y, ‖g y‖ₑ := lintegral_add_left' hfi.1.enorm _
      _ ≤ Fn + Fn := add_le_add le_rfl (lintegral_vczGood_le hn hσ hfi)
      _ = 2 * Fn := (two_mul Fn).symm
  have hbad' : volume ({x | τ ≤ Tb x} ∩ (czStar (vczNorm f) σ)ᶜ) ≤
      ENNReal.ofReal (4 * B / t) * Fn := by
    rw [← Measure.restrict_apply' measurableSet_czStar.compl]
    refine (meas_ge_le_lintegral_div hTb.restrict hτ0 hτt).trans ?_
    calc (∫⁻ x in (czStar (vczNorm f) σ)ᶜ, Tb x) / τ
        ≤ (ENNReal.ofReal B * (2 * Fn)) / τ := by gcongr; exact hbad.trans (by gcongr)
      _ = ENNReal.ofReal (4 * B / t) * Fn := by
          rw [div_eq_mul_inv, ← ENNReal.ofReal_inv_of_pos (half_pos ht),
            show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp,
            show ENNReal.ofReal B * (ENNReal.ofReal 2 * Fn) * ENNReal.ofReal (t / 2)⁻¹ =
              ENNReal.ofReal (B * 2 * (t / 2)⁻¹) * Fn by
                rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity)]; ring]
          congr 2
          field_simp; ring
  calc volume {x | ENNReal.ofReal t < Tf x}
      ≤ volume (({x | τ ≤ Tg x} ∪ ({x | τ ≤ Tb x} ∩ (czStar (vczNorm f) σ)ᶜ)) ∪
          czStar (vczNorm f) σ : Set _) := measure_mono_ae hincl
    _ ≤ volume {x | τ ≤ Tg x} + volume ({x | τ ≤ Tb x} ∩ (czStar (vczNorm f) σ)ᶜ) +
          volume (czStar (vczNorm f) σ) :=
        (measure_union_le _ _).trans (add_le_add_left (measure_union_le _ _) _)
    _ ≤ ENNReal.ofReal (4 * 2 ^ n * B / t) * Fn + ENNReal.ofReal (4 * B / t) * Fn +
          ENNReal.ofReal ((4 * Real.sqrt n) ^ n * B / t) * Fn :=
        add_le_add (add_le_add hgood' hbad') hstar
    _ = ENNReal.ofReal (vczWeakConst n * B / t) * Fn := by
        rw [← add_mul, ← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        unfold vczWeakConst
        ring

end Vector

end JswF2

section JswF3

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-! ### The vector-valued square function operator and its adjoint -/

/-- The `ℓ²(s)`-valued vector `(D_j f(x))_{j ∈ s}`. -/
def jswSqVec (n : ℕ) (φ : EuclideanSpace ℝ (Fin n) → ℂ) (s : Finset ℤ)
    (f : EuclideanSpace ℝ (Fin n) → ℂ) (x : EuclideanSpace ℝ (Fin n)) : EuclideanSpace ℂ s :=
  WithLp.toLp 2 fun j : s => jswDiff n φ j f x

/-- The adjoint operator `(g_j)_{j ∈ s} ↦ ∑_{j ∈ s} D_j g_j`. -/
def jswAdjOp (n : ℕ) (φ : EuclideanSpace ℝ (Fin n) → ℂ) (s : Finset ℤ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s) (x : EuclideanSpace ℝ (Fin n)) : ℂ :=
  ∑ j : s, jswDiff n φ j (fun y => g y j) x

variable (s : Finset ℤ)

lemma jswSqVec_apply (f : EuclideanSpace ℝ (Fin n) → ℂ) (x : EuclideanSpace ℝ (Fin n)) (j : s) :
    jswSqVec n φ s f x j = jswDiff n φ j f x := rfl

lemma jsw_enorm_sqVec_sq (f : EuclideanSpace ℝ (Fin n) → ℂ) (x : EuclideanSpace ℝ (Fin n)) :
    ‖jswSqVec n φ s f x‖ₑ ^ 2 = ∑ j ∈ s, ‖jswDiff n φ j f x‖ₑ ^ 2 := by
  rw [← ofReal_norm, EuclideanSpace.norm_eq, ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
    Real.sq_sqrt (Finset.sum_nonneg fun _ _ => by positivity),
    ENNReal.ofReal_sum_of_nonneg fun _ _ => by positivity]
  rw [← Finset.sum_coe_sort s]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
  rfl

lemma jsw_enorm_sqVec_le (f : EuclideanSpace ℝ (Fin n) → ℂ) (x : EuclideanSpace ℝ (Fin n)) :
    ‖jswSqVec n φ s f x‖ₑ ≤ ∑ j ∈ s, ‖jswDiff n φ j f x‖ₑ := by
  refine jsw_le_of_sq_le ?_
  rw [jsw_enorm_sqVec_sq]
  simp only [← ofReal_norm]
  rw [← ENNReal.ofReal_sum_of_nonneg fun _ _ => norm_nonneg _,
    ← ENNReal.ofReal_pow (Finset.sum_nonneg fun _ _ => norm_nonneg _)]
  simp_rw [← ENNReal.ofReal_pow (norm_nonneg _)]
  rw [← ENNReal.ofReal_sum_of_nonneg fun _ _ => by positivity]
  exact ENNReal.ofReal_le_ofReal (Finset.sum_sq_le_sq_sum_of_nonneg fun _ _ => norm_nonneg _)

lemma jswSqVec_eq_sum (f : EuclideanSpace ℝ (Fin n) → ℂ) :
    jswSqVec n φ s f = fun x => ∑ j : s, jswDiff n φ j f x • EuclideanSpace.single j (1 : ℂ) := by
  classical
  funext x
  ext i
  simp [jswSqVec, Pi.single_apply, mul_ite]

lemma JswAdm.aestronglyMeasurable_jswSqVec (h : JswAdm n A φ)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : AEStronglyMeasurable f volume) :
    AEStronglyMeasurable (jswSqVec n φ s f) volume := by
  rw [jswSqVec_eq_sum]
  refine Finset.aestronglyMeasurable_fun_sum _ fun j _ => ?_
  exact (h.aestronglyMeasurable_jswDiff j hf).smul_const _

lemma JswAdm.jswSqVec_add (h : JswAdm n A φ) {p : ℝ≥0∞} (hp : 1 ≤ p)
    {f g : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f p volume) (hg : MemLp g p volume) :
    jswSqVec n φ s (f + g) =ᵐ[volume] jswSqVec n φ s f + jswSqVec n φ s g := by
  have : ∀ᵐ x, ∀ j : s, jswDiff n φ j (f + g) x = jswDiff n φ j f x + jswDiff n φ j g x :=
    ae_all_iff.2 fun j => h.jswDiff_add j hp hf hg
  filter_upwards [this] with x hx
  ext j
  simp [jswSqVec, hx j]

lemma jswSqVec_congr_ae {f g : EuclideanSpace ℝ (Fin n) → ℂ} (hfg : f =ᵐ[volume] g) :
    jswSqVec n φ s f = jswSqVec n φ s g := by
  funext x
  simp only [jswSqVec, jswDiff_congr_ae _ hfg]

/-- The `L²` bound of the square function operator. -/
theorem JswAdm.eLpNorm_jswSqVec_two_le (h : JswAdm n A φ) {f : EuclideanSpace ℝ (Fin n) → ℂ}
    (hf : MemLp f 2 volume) :
    eLpNorm (jswSqVec n φ s f) 2 volume ≤
      ENNReal.ofReal (jswL2Const n A) * eLpNorm f 2 volume := by
  refine jsw_le_of_sq_le ?_
  rw [← jsw_lintegral_sq_eq (h.aestronglyMeasurable_jswSqVec s hf.aestronglyMeasurable)]
  simp_rw [jsw_enorm_sqVec_sq]
  rw [lintegral_finsetSum' _ fun j _ => ((h.aestronglyMeasurable_jswDiff j
    hf.aestronglyMeasurable).enorm.pow_const 2), mul_pow]
  simp_rw [jsw_lintegral_sq_eq (h.aestronglyMeasurable_jswDiff _ hf.aestronglyMeasurable)]
  exact h.sum_eLpNorm_jswDiff_sq_le s hf

lemma jsw_memLp_coord {p : ℝ≥0∞} {g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s}
    (hg : MemLp g p volume) (j : s) : MemLp (fun y => g y j) p volume :=
  (EuclideanSpace.proj (𝕜 := ℂ) j).comp_memLp' hg

lemma JswAdm.aestronglyMeasurable_jswAdjOp (h : JswAdm n A φ)
    {g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s} (hg : AEStronglyMeasurable g volume) :
    AEStronglyMeasurable (jswAdjOp n φ s g) volume := by
  have : jswAdjOp n φ s g = ∑ j : s, jswDiff n φ j (fun y => g y j) := by
    funext x; simp [jswAdjOp]
  rw [this]
  refine Finset.aestronglyMeasurable_sum _ fun j _ => h.aestronglyMeasurable_jswDiff j ?_
  exact (EuclideanSpace.proj j).continuous.comp_aestronglyMeasurable hg

lemma JswAdm.jswAdjOp_add (h : JswAdm n A φ) {p : ℝ≥0∞} (hp : 1 ≤ p)
    {f g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s} (hf : MemLp f p volume)
    (hg : MemLp g p volume) :
    jswAdjOp n φ s (f + g) =ᵐ[volume] jswAdjOp n φ s f + jswAdjOp n φ s g := by
  have : ∀ᵐ x, ∀ j : s, jswDiff n φ j (fun y => (f + g) y j) x =
      jswDiff n φ j (fun y => f y j) x + jswDiff n φ j (fun y => g y j) x :=
    ae_all_iff.2 fun j => h.jswDiff_add j hp (jsw_memLp_coord s hf j) (jsw_memLp_coord s hg j)
  filter_upwards [this] with x hx
  simp only [jswAdjOp, Pi.add_apply, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun j _ => hx j

lemma jswAdjOp_congr_ae {f g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s}
    (hfg : f =ᵐ[volume] g) : jswAdjOp n φ s f = jswAdjOp n φ s g := by
  funext x
  simp only [jswAdjOp]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [jswDiff_congr_ae (g := fun y => g y j) _ (hfg.mono fun y hy => by simp only [hy])]

lemma jsw_enorm_adjOp_le (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s)
    (x : EuclideanSpace ℝ (Fin n)) :
    ‖jswAdjOp n φ s g x‖ₑ ≤ ∑ j : s, ‖jswDiff n φ j (fun y => g y j) x‖ₑ :=
  enorm_sum_le _ _

end JswF3

section JswF4

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-! ### Weak type `(1,1)` of the square function operator and of its adjoint -/

lemma jsw_memLp_two_vczGood {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (hn : 0 < n) {f : EuclideanSpace ℝ (Fin n) → E} (hfi : Integrable f)
    (hfm : StronglyMeasurable f) {σ : ℝ} (hσ : 0 < σ) : MemLp (vczGood f σ) 2 volume := by
  have hgm := (stronglyMeasurable_vczGood hn hσ hfi hfm).aestronglyMeasurable (μ := volume)
  have h1 := lintegral_vczGood_sq_le hn hσ hfi
  simp only [ENNReal.rpow_two] at h1
  rw [jsw_lintegral_sq_eq hgm] at h1
  refine lt_of_pow_lt_pow_left' 2 (h1.trans_lt ?_)
  exact ENNReal.mul_lt_top (ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.ofNat_lt_top)
    ENNReal.ofReal_lt_top) hfi.2

lemma jsw_setOf_lt_norm_eq {α F : Type*} [NormedAddCommGroup F] (u : α → F) {t : ℝ}
    (ht : 0 ≤ t) : {x | t < ‖u x‖} = {x | ENNReal.ofReal t < ‖u x‖ₑ} := by
  ext x
  simp only [mem_ofPred_eq, ← ofReal_norm, ENNReal.ofReal_lt_ofReal_iff_of_nonneg ht]

/-- The constant of the weak type estimates. -/
def jswWeakB (n : ℕ) (A L : ℝ) : ℝ := L + jswBadConst n A + 1

lemma jswWeakB_pos (hA : 0 ≤ A) {L : ℝ} (hL : 0 ≤ L) : 0 < jswWeakB n A L := by
  have := jswBadConst_nonneg (n := n) hA
  unfold jswWeakB; linarith

/-- **Weak type `(1,1)` of the square function operator** `f ↦ (D_j f)_{j ∈ s}`. -/
theorem JswAdm.volume_lt_jswSqVec_le (hn : 0 < n) (h : JswAdm n A φ) (s : Finset ℤ)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hfi : Integrable f) {t : ℝ} (ht : 0 < t) :
    volume {x | t < ‖jswSqVec n φ s f x‖} ≤
      ENNReal.ofReal (vczWeakConst n * jswWeakB n A (jswL2Const n A) / t) *
        ∫⁻ x, ‖f x‖ₑ := by
  have hA := h.nonneg
  have hL := jswL2Const_nonneg (n := n) hA
  set f' := hfi.1.mk f
  have hff' : f =ᵐ[volume] f' := hfi.1.ae_eq_mk
  have hfm : StronglyMeasurable f' := hfi.1.stronglyMeasurable_mk
  have hfi' : Integrable f' := hfi.congr hff'
  rw [jswSqVec_congr_ae s hff', lintegral_congr_ae (hff'.mono fun x hx => by rw [hx]),
    jsw_setOf_lt_norm_eq _ ht.le]
  set B := jswWeakB n A (jswL2Const n A)
  have hB : 0 < B := jswWeakB_pos hA hL
  set σ := t / B
  have hσ : 0 < σ := div_pos ht hB
  set g := vczGood f' σ
  set b := f' - g
  have hgi : Integrable g := integrable_vczGood hn hσ hfi' hfm
  have hbi : Integrable b := hfi'.sub hgi
  have hg2 : MemLp g 2 volume := jsw_memLp_two_vczGood hn hfi' hfm hσ
  have hid : (fun y => (ContinuousLinearMap.id ℂ ℂ) (b y)) = b := rfl
  refine jsw_volume_lt_le_of_split hn hfi' hB ht
    (Tg := fun x => ‖jswSqVec n φ s g x‖ₑ)
    (Tb := fun x => ∑ j ∈ s, ‖jswDiff n φ j (fun y => (ContinuousLinearMap.id ℂ ℂ) (b y)) x‖ₑ)
    (h.aestronglyMeasurable_jswSqVec s hgi.1).enorm
    (Finset.aemeasurable_fun_sum _ fun j _ => (h.aestronglyMeasurable_jswDiff j
      hbi.1).enorm) ?_ ?_ ?_
  · have hfgb : f' = g + b := by simp [b]
    filter_upwards [h.jswSqVec_add s le_rfl (memLp_one_iff_integrable.2 hgi)
      (memLp_one_iff_integrable.2 hbi)] with x hx
    rw [hfgb, hx, Pi.add_apply]
    refine (ESeminormedAddMonoid.enorm_add_le _ _).trans (add_le_add le_rfl ?_)
    simpa only [hid] using jsw_enorm_sqVec_le s b x
  · rw [jsw_lintegral_sq_eq (h.aestronglyMeasurable_jswSqVec s hgi.1),
      jsw_lintegral_sq_eq hgi.1, ← mul_pow]
    gcongr
    refine (h.eLpNorm_jswSqVec_two_le s hg2).trans ?_
    gcongr
    unfold B jswWeakB; have := jswBadConst_nonneg (n := n) hA; linarith
  · refine (h.lintegral_compl_czStar_sum_le hn s hfi' hfm hσ (fun _ => ContinuousLinearMap.id ℂ ℂ)
      (fun _ => ContinuousLinearMap.norm_id_le)).trans ?_
    gcongr
    unfold B jswWeakB; linarith

lemma jsw_norm_proj_le (s : Finset ℤ) (j : s) : ‖EuclideanSpace.proj (𝕜 := ℂ) j‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun v => by
    rw [one_mul]; exact PiLp.norm_apply_le v j

/-- The coordinate functionals extended by `0` outside `s`. -/
def jswCoord (s : Finset ℤ) (j : ℤ) : EuclideanSpace ℂ s →L[ℂ] ℂ :=
  if hj : j ∈ s then EuclideanSpace.proj (⟨j, hj⟩ : s) else 0

lemma jsw_norm_coord_le (s : Finset ℤ) (j : ℤ) : ‖jswCoord s j‖ ≤ 1 := by
  unfold jswCoord
  split_ifs
  · exact jsw_norm_proj_le s _
  · simp

lemma jswCoord_apply (s : Finset ℤ) (j : s) (v : EuclideanSpace ℂ s) :
    jswCoord s j v = v j := by
  simp [jswCoord, j.2]

/-- **Weak type `(1,1)` of the adjoint operator** `(g_j) ↦ ∑_{j ∈ s} D_j g_j`, given its `L²`
bound with constant `L`. -/
theorem JswAdm.volume_lt_jswAdjOp_le (hn : 0 < n) (h : JswAdm n A φ) (s : Finset ℤ) {L : ℝ}
    (hL : 0 ≤ L) (hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s, MemLp g 2 volume →
      eLpNorm (jswAdjOp n φ s g) 2 volume ≤ ENNReal.ofReal L * eLpNorm g 2 volume)
    {f : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s} (hfi : Integrable f) {t : ℝ}
    (ht : 0 < t) :
    volume {x | t < ‖jswAdjOp n φ s f x‖} ≤
      ENNReal.ofReal (vczWeakConst n * jswWeakB n A L / t) * ∫⁻ x, ‖f x‖ₑ := by
  have hA := h.nonneg
  set f' := hfi.1.mk f
  have hff' : f =ᵐ[volume] f' := hfi.1.ae_eq_mk
  have hfm : StronglyMeasurable f' := hfi.1.stronglyMeasurable_mk
  have hfi' : Integrable f' := hfi.congr hff'
  rw [jswAdjOp_congr_ae s hff', lintegral_congr_ae (hff'.mono fun x hx => by rw [hx]),
    jsw_setOf_lt_norm_eq _ ht.le]
  set B := jswWeakB n A L
  have hB : 0 < B := jswWeakB_pos hA hL
  set σ := t / B
  have hσ : 0 < σ := div_pos ht hB
  set g := vczGood f' σ
  set b := f' - g
  have hgi : Integrable g := integrable_vczGood hn hσ hfi' hfm
  have hbi : Integrable b := hfi'.sub hgi
  have hg2 : MemLp g 2 volume := jsw_memLp_two_vczGood hn hfi' hfm hσ
  refine jsw_volume_lt_le_of_split hn hfi' hB ht
    (Tg := fun x => ‖jswAdjOp n φ s g x‖ₑ)
    (Tb := fun x => ∑ j ∈ s, ‖jswDiff n φ j (fun y => jswCoord s j (b y)) x‖ₑ)
    (h.aestronglyMeasurable_jswAdjOp s hgi.1).enorm
    (Finset.aemeasurable_fun_sum _ fun j _ => (h.aestronglyMeasurable_jswDiff j
      ((jswCoord s j).integrable_comp hbi).1).enorm) ?_ ?_ ?_
  · have hfgb : f' = g + b := by simp [b]
    filter_upwards [h.jswAdjOp_add s le_rfl (memLp_one_iff_integrable.2 hgi)
      (memLp_one_iff_integrable.2 hbi)] with x hx
    rw [hfgb, hx, Pi.add_apply]
    refine (ESeminormedAddMonoid.enorm_add_le _ _).trans (add_le_add le_rfl
      ((jsw_enorm_adjOp_le s b x).trans_eq ?_))
    rw [← Finset.sum_coe_sort s]
    refine Finset.sum_congr rfl fun j _ => ?_
    congr 3
    funext y
    rw [jswCoord_apply]
  · rw [jsw_lintegral_sq_eq (h.aestronglyMeasurable_jswAdjOp s hgi.1),
      jsw_lintegral_sq_eq hgi.1, ← mul_pow]
    gcongr
    refine (hL2 g hg2).trans ?_
    gcongr
    unfold B jswWeakB; have := jswBadConst_nonneg (n := n) hA; linarith
  · refine (h.lintegral_compl_czStar_sum_le hn s hfi' hfm hσ (jswCoord s)
      (jsw_norm_coord_le s)).trans ?_
    gcongr
    unfold B jswWeakB; linarith

end JswF4

section JswF5

variable {n : ℕ} {A : ℝ} {φ : EuclideanSpace ℝ (Fin n) → ℂ}

/-! ### `L^p` bounds: interpolation and duality -/

lemma jsw_memLp_of_test {α E : Type*} [MeasurableSpace α] {μ : Measure α} [NormedAddCommGroup E]
    {g : α → E} (hg : AEStronglyMeasurable g μ) (hb : ∃ C, ∀ x, ‖g x‖ ≤ C)
    (hs : μ (Function.support g) < ∞) (q : ℝ≥0∞) : MemLp g q μ := by
  obtain ⟨C, hC⟩ := hb
  exact (memLp_top_of_bound hg C (ae_of_all _ hC)).mono_exponent_of_measure_support_ne_top
    (fun x hx => Function.notMem_support.1 hx) hs.ne le_top

lemma JswAdm.memLp_jswDiff (h : JswAdm n A φ) (j : ℤ) {p : ℝ} (hp : 1 ≤ p)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (jswDiff n φ j f) (ENNReal.ofReal p) volume := by
  have hp1 : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp
  exact (memLp_convolution_of_memLp hp1 (memLp_one_iff_integrable.2 (h.integrable_dilate j))
    hf).sub (jsw_memLp_dyadicAvg hp j hf)

lemma jsw_inner_jswSqVec (s : Finset ℤ) (v : EuclideanSpace ℂ s)
    (f : EuclideanSpace ℝ (Fin n) → ℂ) (x : EuclideanSpace ℝ (Fin n)) :
    inner ℂ v (jswSqVec n φ s f x) = ∑ j : s, jswDiff n φ j f x * conj (v j) := by
  rw [PiLp.inner_apply]
  simp only [RCLike.inner_apply, jswSqVec_apply]

/-- The `L²` bound of the adjoint operator, by duality from the `L²` bound of the square
function operator of `φ`. -/
theorem JswAdm.eLpNorm_jswAdjOp_two_le (h : JswAdm n A φ) (s : Finset ℤ)
    {g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s} (hg : MemLp g 2 volume) :
    eLpNorm (jswAdjOp n (czAdjoint φ) s g) 2 volume ≤
      ENNReal.ofReal (jswL2Const n A) * eLpNorm g 2 volume := by
  have h22 := Real.HolderConjugate.two_two
  have ha := h.adjoint
  have hg' : MemLp g (ENNReal.ofReal 2) volume := by rwa [ENNReal.ofReal_ofNat]
  have hcoord : ∀ j : s, MemLp (fun y => g y j) (ENNReal.ofReal 2) volume :=
    fun j => jsw_memLp_coord s hg' j
  have key := eLpNorm_le_of_dual_test h22
    (ha.aestronglyMeasurable_jswAdjOp s hg.aestronglyMeasurable)
    (A := ENNReal.ofReal (jswL2Const n A) * eLpNorm g 2 volume) ?_
  · rwa [ENNReal.ofReal_ofNat] at key
  intro v hvm hvb hvs hv2 _
  have hv : MemLp v (ENNReal.ofReal 2) volume :=
    jsw_memLp_of_test hvm.aestronglyMeasurable hvb hvs _
  have hv2' : MemLp v 2 volume := by rwa [ENNReal.ofReal_ofNat] at hv
  have e1 : ∫ x, jswAdjOp n (czAdjoint φ) s g x * conj (v x) =
      ∫ x, inner ℂ (jswSqVec n φ s v x) (g x) := by
    simp only [jswAdjOp, Finset.sum_mul]
    rw [integral_finsetSum _ fun (j : s) _ => jsw_integrable_mul_conj h22
      (ha.memLp_jswDiff j (by norm_num) (hcoord j)) hv]
    simp_rw [ha.integral_jswDiff_mul_conj h22 _ (hcoord _) hv, czAdjoint_czAdjoint]
    rw [← integral_finsetSum _ fun (j : s) _ => jsw_integrable_mul_conj h22 (hcoord j)
      (h.memLp_jswDiff j (by norm_num) hv)]
    congr 1
  rw [e1]
  calc ‖∫ x, inner ℂ (jswSqVec n φ s v x) (g x)‖ₑ
      ≤ eLpNorm (jswSqVec n φ s v) (ENNReal.ofReal 2) volume *
          eLpNorm g (ENNReal.ofReal 2) volume :=
        vcz_enorm_integral_inner_le h22 (h.aestronglyMeasurable_jswSqVec s hv.aestronglyMeasurable)
          hg.aestronglyMeasurable
    _ ≤ (ENNReal.ofReal (jswL2Const n A) * eLpNorm v 2 volume) * eLpNorm g 2 volume := by
        rw [ENNReal.ofReal_ofNat]
        exact mul_le_mul' (h.eLpNorm_jswSqVec_two_le s hv2') le_rfl
    _ ≤ (ENNReal.ofReal (jswL2Const n A) * 1) * eLpNorm g 2 volume := by
        rw [ENNReal.ofReal_ofNat] at hv2
        gcongr
    _ = _ := by rw [mul_one]

/-- The Marcinkiewicz constant for interpolation between weak `(1,1)` and `(2,2)`. -/
def jswMarcConst (p : ℝ) (A₁ A₂ : ℝ≥0) : ℝ≥0∞ :=
  (marcinkiewiczConst 1 2 p : ℝ≥0∞) * (A₁ : ℝ≥0∞) ^ (1 - (2 - 2 / p)) *
    (A₂ : ℝ≥0∞) ^ (2 - 2 / p)

lemma jswMarcConst_ne_top {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2) (A₁ A₂ : ℝ≥0) :
    jswMarcConst p A₁ A₂ ≠ ∞ := by
  have hp0 : 0 < p := by linarith
  have h1 : 0 ≤ 1 - (2 - 2 / p) := by
    rw [show 1 - (2 - 2 / p) = 2 / p - 1 by ring, sub_nonneg, le_div_iff₀ hp0]; linarith
  have h2 : 0 ≤ 2 - 2 / p := by
    rw [sub_nonneg, div_le_iff₀ hp0]; linarith
  unfold jswMarcConst
  exact ENNReal.mul_ne_top (ENNReal.mul_ne_top (marcinkiewiczConst_ne_top _ _ _)
    (ENNReal.rpow_ne_top_of_nonneg h1 ENNReal.coe_ne_top))
    (ENNReal.rpow_ne_top_of_nonneg h2 ENNReal.coe_ne_top)

/-- Marcinkiewicz interpolation between a weak `(1,1)` and a strong `(2,2)` bound. -/
theorem jsw_marcinkiewicz {E F : Type*} [NormedAddCommGroup E] [NormedAddCommGroup F]
    {T : (EuclideanSpace ℝ (Fin n) → E) → EuclideanSpace ℝ (Fin n) → F} {p : ℝ}
    (hp1 : 1 < p) (hp2 : p < 2) {c L : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hweak : ∀ f, Integrable f → ∀ t : ℝ, 0 < t →
      volume {x | t < ‖T f x‖} ≤ ENNReal.ofReal (c / t) * ∫⁻ x, ‖f x‖ₑ)
    (hL2 : ∀ f, MemLp f 2 volume → eLpNorm (T f) 2 volume ≤ ENNReal.ofReal L * eLpNorm f 2 volume)
    (hsub : ∀ f g, MemLp f (ENNReal.ofReal p) volume → MemLp g (ENNReal.ofReal p) volume →
      ∀ᵐ x, ‖T (f + g) x‖ ≤ ‖T f x‖ + ‖T g x‖)
    (hmeas : ∀ f, MemLp f (ENNReal.ofReal p) volume → AEStronglyMeasurable (T f) volume)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (T f) (ENNReal.ofReal p) volume ≤
      jswMarcConst p c.toNNReal L.toNNReal * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := by linarith
  set A₁ := c.toNNReal
  set A₂ := L.toNNReal
  have hA₁ : (A₁ : ℝ≥0∞) = ENNReal.ofReal c := rfl
  have hA₂ : (A₂ : ℝ≥0∞) = ENNReal.ofReal L := rfl
  have hA₁0 : (A₁ : ℝ≥0∞) ≠ 0 := by rw [hA₁]; exact (ENNReal.ofReal_pos.2 hc).ne'
  have hA₂0 : (A₂ : ℝ≥0∞) ≠ 0 := by rw [hA₂]; exact (ENNReal.ofReal_pos.2 hL).ne'
  set D : Set (EuclideanSpace ℝ (Fin n) → E) := {g | MemLp g (ENNReal.ofReal p) volume}
  have hT1 : HasWeakTypeOn T D 1 A₁ volume volume := by
    refine hasWeakTypeOn_of_forall_real fun g _ t ht => ?_
    rw [ENNReal.rpow_one, ENNReal.ofReal_one]
    by_cases hg1 : MemLp g 1 volume
    · refine (hweak g (memLp_one_iff_integrable.1 hg1) t ht).trans_eq ?_
      rw [eLpNorm_one_eq_lintegral_enorm hg1.aestronglyMeasurable, ENNReal.ofReal_div_of_pos ht,
        hA₁, div_eq_mul_inv,
        div_eq_mul_inv]
      ring
    · rw [not_lt_top_iff.1 hg1, ENNReal.mul_top hA₁0, ENNReal.top_div_of_ne_top
        ENNReal.ofReal_ne_top]
      exact le_top
  have hT2 : HasWeakTypeOn T D 2 A₂ volume volume := by
    refine HasStrongTypeOn.hasWeakTypeOn two_pos fun g _ => ?_
    rw [ENNReal.ofReal_ofNat]
    by_cases hg2 : MemLp g 2 volume
    · rw [hA₂]; exact hL2 g hg2
    · rw [not_lt_top_iff.1 hg2, ENNReal.mul_top hA₂0]; exact le_top
  have hsub' : IsSublinearOn T D volume := fun g hg g' hg' => hsub g g' hg hg'
  exact eLpNorm_le_of_hasWeakTypeOn (a := 1) (b := 2) (p := p) (θ := 2 - 2 / p) one_pos hp1 hp2
    (by field_simp; ring) hT1 hT2 hsub' isTruncationClosed_memLp (f := f) hf
    hf.aestronglyMeasurable (hmeas f hf)

/-- The constant of the square function bound for `1 < p < 2`. -/
def jswSqConstLt (n : ℕ) (A p : ℝ) : ℝ≥0∞ :=
  jswMarcConst p (vczWeakConst n * jswWeakB n A (jswL2Const n A)).toNNReal
    (jswL2Const n A + 1).toNNReal

/-- The constant of the adjoint bound for `1 < p < 2`. -/
def jswAdjConstLt (n : ℕ) (A p : ℝ) : ℝ≥0∞ :=
  jswMarcConst p (vczWeakConst n * jswWeakB n A (jswL2Const n A + 1)).toNNReal
    (jswL2Const n A + 1).toNNReal

/-- `L^p` bounds of the square function operator for `1 < p < 2`. -/
theorem JswAdm.eLpNorm_jswSqVec_le_of_lt_two (hn : 0 < n) (h : JswAdm n A φ) (s : Finset ℤ)
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2) {f : EuclideanSpace ℝ (Fin n) → ℂ}
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (jswSqVec n φ s f) (ENNReal.ofReal p) volume ≤
      jswSqConstLt n A p * eLpNorm f (ENNReal.ofReal p) volume := by
  have hA := h.nonneg
  have hL := jswL2Const_nonneg (n := n) hA
  have hp1' : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp1.le
  refine jsw_marcinkiewicz (T := jswSqVec n φ s) hp1 hp2
    (mul_pos (vczWeakConst_pos n) (jswWeakB_pos hA hL)) (by linarith)
    (fun g hg t ht => by
      have := h.volume_lt_jswSqVec_le hn s hg ht
      rw [mul_div_assoc] at this ⊢; exact this)
    (fun g hg => (h.eLpNorm_jswSqVec_two_le s hg).trans (by gcongr; linarith))
    (fun g g' hg hg' => by
      filter_upwards [h.jswSqVec_add s hp1' hg hg'] with x hx
      rw [hx]; exact norm_add_le _ _)
    (fun g hg => h.aestronglyMeasurable_jswSqVec s hg.aestronglyMeasurable) hf

/-- `L^p` bounds of the adjoint operator for `1 < p < 2`. -/
theorem JswAdm.eLpNorm_jswAdjOp_le_of_lt_two (hn : 0 < n) (h : JswAdm n A φ) (s : Finset ℤ)
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2) {g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s}
    (hg : MemLp g (ENNReal.ofReal p) volume) :
    eLpNorm (jswAdjOp n (czAdjoint φ) s g) (ENNReal.ofReal p) volume ≤
      jswAdjConstLt n A p * eLpNorm g (ENNReal.ofReal p) volume := by
  have hA := h.nonneg
  have hL := jswL2Const_nonneg (n := n) hA
  have ha := h.adjoint
  have hp1' : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp1.le
  have hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℂ s, MemLp g 2 volume →
      eLpNorm (jswAdjOp n (czAdjoint φ) s g) 2 volume ≤
        ENNReal.ofReal (jswL2Const n A + 1) * eLpNorm g 2 volume :=
    fun g hg => (h.eLpNorm_jswAdjOp_two_le s hg).trans (by gcongr; linarith)
  refine jsw_marcinkiewicz (T := jswAdjOp n (czAdjoint φ) s) hp1 hp2
    (mul_pos (vczWeakConst_pos n) (jswWeakB_pos hA (by linarith))) (by linarith)
    (fun g hg t ht => by
      have := ha.volume_lt_jswAdjOp_le hn s (by linarith) hL2 hg ht
      rw [mul_div_assoc] at this ⊢; exact this)
    hL2
    (fun g g' hg hg' => by
      filter_upwards [ha.jswAdjOp_add s hp1' hg hg'] with x hx
      rw [hx]; exact norm_add_le _ _)
    (fun g hg => ha.aestronglyMeasurable_jswAdjOp s hg.aestronglyMeasurable) hg

/-- `L^p` bounds of the square function operator for `2 < p < ∞`, by duality. -/
theorem JswAdm.eLpNorm_jswSqVec_le_of_two_lt (hn : 0 < n) (h : JswAdm n A φ) (s : Finset ℤ)
    {p : ℝ} (hp : 2 < p) {f : EuclideanSpace ℝ (Fin n) → ℂ}
    (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (jswSqVec n φ s f) (ENNReal.ofReal p) volume ≤
      jswAdjConstLt n A p.conjExponent * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp1 : 1 < p := by linarith
  set q := p.conjExponent
  have hpq : p.HolderConjugate q := Real.HolderConjugate.conjExponent hp1
  have hq1 : 1 < q := hpq.symm.lt
  have hq2 : q < 2 := by
    simp only [q, Real.conjExponent]
    rw [div_lt_iff₀ (by linarith)]; linarith
  refine vcz_eLpNorm_le_of_dual_test hpq (h.aestronglyMeasurable_jswSqVec s hf.aestronglyMeasurable)
    fun g hgt hgq _ => ?_
  obtain ⟨hgm, hgb, hgs⟩ := hgt
  have hg : MemLp g (ENNReal.ofReal q) volume :=
    jsw_memLp_of_test hgm.aestronglyMeasurable hgb hgs _
  have hcoord : ∀ j : s, MemLp (fun y => g y j) (ENNReal.ofReal q) volume :=
    fun j => jsw_memLp_coord s hg j
  have e1 : ∫ x, inner ℂ (g x) (jswSqVec n φ s f x) =
      ∫ x, f x * conj (jswAdjOp n (czAdjoint φ) s g x) := by
    simp_rw [jsw_inner_jswSqVec]
    rw [integral_finsetSum _ fun (j : s) _ => jsw_integrable_mul_conj hpq
      (h.memLp_jswDiff j hp1.le hf) (hcoord j)]
    simp_rw [h.integral_jswDiff_mul_conj hpq _ hf (hcoord _)]
    rw [← integral_finsetSum _ fun (j : s) _ => jsw_integrable_mul_conj hpq hf
      (h.adjoint.memLp_jswDiff j hq1.le (hcoord j))]
    congr 1; funext x
    simp only [jswAdjOp, map_sum, Finset.mul_sum]
  rw [e1]
  calc ‖∫ x, f x * conj (jswAdjOp n (czAdjoint φ) s g x)‖ₑ
      ≤ eLpNorm f (ENNReal.ofReal p) volume *
          eLpNorm (jswAdjOp n (czAdjoint φ) s g) (ENNReal.ofReal q) volume :=
        enorm_integral_mul_conj_le hpq hf.aestronglyMeasurable
          (h.adjoint.aestronglyMeasurable_jswAdjOp s hg.aestronglyMeasurable)
    _ ≤ eLpNorm f (ENNReal.ofReal p) volume *
          (jswAdjConstLt n A q * eLpNorm g (ENNReal.ofReal q) volume) :=
        mul_le_mul' le_rfl (h.eLpNorm_jswAdjOp_le_of_lt_two hn s hq1 hq2 hg)
    _ ≤ eLpNorm f (ENNReal.ofReal p) volume * (jswAdjConstLt n A q * 1) := by gcongr
    _ = _ := by rw [mul_one, mul_comm]

/-- The constant of the square function bound, for all `1 < p < ∞`. -/
def jswSqConst (n : ℕ) (A p : ℝ) : ℝ≥0∞ :=
  if p < 2 then jswSqConstLt n A p else if p = 2 then ENNReal.ofReal (jswL2Const n A)
  else jswAdjConstLt n A p.conjExponent

lemma jswSqConst_ne_top {p : ℝ} (hp : 1 < p) : jswSqConst n A p ≠ ∞ := by
  unfold jswSqConst
  split_ifs with h1 h2
  · exact jswMarcConst_ne_top hp h1 _ _
  · exact ENNReal.ofReal_ne_top
  · have hp2 : 2 < p := lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2)
    have hpq : p.HolderConjugate p.conjExponent := Real.HolderConjugate.conjExponent hp
    refine jswMarcConst_ne_top hpq.symm.lt ?_ _ _
    simp only [Real.conjExponent]
    rw [div_lt_iff₀ (by linarith)]; linarith

/-- `L^p` bounds of the square function operator for all `1 < p < ∞`, uniformly in `s`. -/
theorem JswAdm.eLpNorm_jswSqVec_le (hn : 0 < n) (h : JswAdm n A φ) (s : Finset ℤ) {p : ℝ}
    (hp : 1 < p) {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (jswSqVec n φ s f) (ENNReal.ofReal p) volume ≤
      jswSqConst n A p * eLpNorm f (ENNReal.ofReal p) volume := by
  unfold jswSqConst
  split_ifs with h1 h2
  · exact h.eLpNorm_jswSqVec_le_of_lt_two hn s hp h1 hf
  · subst h2
    rw [ENNReal.ofReal_ofNat] at hf ⊢
    exact h.eLpNorm_jswSqVec_two_le s hf
  · exact h.eLpNorm_jswSqVec_le_of_two_lt hn s (lt_of_le_of_ne (not_lt.1 h1) (Ne.symm h2)) hf

end JswF5

section JswG

variable {n : ℕ}

/-! ### The square function estimate and the jump inequality -/

lemma jsw_eLpNorm_ennreal_eq {F : EuclideanSpace ℝ (Fin n) → ℝ≥0∞}
    (hF : AEMeasurable F volume) {p : ℝ} (hp : 0 < p) :
    eLpNorm F (ENNReal.ofReal p) volume = (∫⁻ x, F x ^ p) ^ (1 / p) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top
    hF.aestronglyMeasurable, ENNReal.toReal_ofReal hp.le]
  simp only [enorm_eq_self]

lemma jsw_eLpNorm_const_mul {c : ℝ≥0∞} (hc : c ≠ ∞) {F : EuclideanSpace ℝ (Fin n) → ℝ≥0∞}
    (hF : AEMeasurable F volume) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x => c * F x) (ENNReal.ofReal p) volume =
      c * eLpNorm F (ENNReal.ofReal p) volume := by
  rw [jsw_eLpNorm_ennreal_eq (hF.const_mul c) hp, jsw_eLpNorm_ennreal_eq hF hp]
  simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le]
  rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hp.le hc),
    ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul, mul_one_div_cancel hp.ne',
    ENNReal.rpow_one]

lemma jsw_rpow_iSup {ι : Sort*} (w : ι → ℝ≥0∞) {y : ℝ} (hy : 0 < y) :
    (⨆ i, w i) ^ y = ⨆ i, w i ^ y := by
  have := (ENNReal.orderIsoRpow y hy).map_iSup w
  simpa only [ENNReal.orderIsoRpow_apply] using this

/-- **Square function estimate** (finite families): for a Schwartz function `φ` with `∫ φ = 1`
and `1 < p < ∞` there is `C` such that for all finite `s ⊆ ℤ` and `f ∈ L^p`,
`‖(∑_{j ∈ s} |φ_j * f - E_j f|²)^{1/2}‖_p ≤ C ‖f‖_p`. -/
theorem jsw_square_function_finset {n : ℕ} (hn : 0 < n)
    (φ : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ) (hφ : ∫ x, φ x = 1) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ (s : Finset ℤ) (f : EuclideanSpace ℝ (Fin n) → ℂ),
      MemLp f (ENNReal.ofReal p) volume →
      eLpNorm (fun x => (∑ j ∈ s, ‖(jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x -
          dyadicAvg n j f x‖ₑ ^ 2) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨A, h⟩ := jswAdm_of_schwartz φ hφ
  refine ⟨(jswSqConst n A p).toNNReal, fun s f hf => ?_⟩
  rw [ENNReal.coe_toNNReal (jswSqConst_ne_top hp)]
  have e : (fun x => (∑ j ∈ s, ‖(jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x -
      dyadicAvg n j f x‖ₑ ^ 2) ^ (1 / 2 : ℝ)) = fun x => ‖jswSqVec n φ s f x‖ₑ := by
    funext x
    change (∑ j ∈ s, ‖jswDiff n φ j f x‖ₑ ^ 2) ^ (1 / 2 : ℝ) = _
    rw [← jsw_enorm_sqVec_sq, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
    norm_num
  rw [e, eLpNorm_enorm]
  · exact h.eLpNorm_jswSqVec_le hn s hp hf
  · exact h.aestronglyMeasurable_jswSqVec s hf.aestronglyMeasurable

/-- **Square function estimate**: for a Schwartz function `φ` with `∫ φ = 1` and `1 < p < ∞`
there is `C` such that for all `f ∈ L^p`,
`‖(∑_{j ∈ ℤ} |φ_j * f - E_j f|²)^{1/2}‖_p ≤ C ‖f‖_p`. -/
theorem jsw_square_function {n : ℕ} (hn : 0 < n)
    (φ : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ) (hφ : ∫ x, φ x = 1) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : EuclideanSpace ℝ (Fin n) → ℂ, MemLp f (ENNReal.ofReal p) volume →
      eLpNorm (fun x => (∑' j : ℤ, ‖(jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x -
          dyadicAvg n j f x‖ₑ ^ 2) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨A, h⟩ := jswAdm_of_schwartz φ hφ
  obtain ⟨C, hC⟩ := jsw_square_function_finset hn φ hφ hp
  refine ⟨C, fun f hf => ?_⟩
  have hp0 : 0 < p := by linarith
  set a : ℤ → EuclideanSpace ℝ (Fin n) → ℝ≥0∞ := fun j x =>
    ‖(jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x - dyadicAvg n j f x‖ₑ ^ 2
  have ham : ∀ j, AEMeasurable (a j) volume := fun j =>
    ((h.aestronglyMeasurable_jswDiff j hf.aestronglyMeasurable).enorm.pow_const 2)
  set I : ℕ → Finset ℤ := fun N => Finset.Icc (-(N : ℤ)) N
  have hI : ∀ t : Finset ℤ, ∃ N, t ⊆ I N := by
    intro t
    refine ⟨∑ j ∈ t, j.natAbs, fun j hj => ?_⟩
    have : j.natAbs ≤ ∑ j ∈ t, j.natAbs :=
      Finset.single_le_sum (s := t) (f := fun j : ℤ => j.natAbs) (fun _ _ => Nat.zero_le _) hj
    simp only [I, Finset.mem_Icc]
    omega
  have hImono : Monotone I := fun N M hNM => by
    intro j hj
    simp only [I, Finset.mem_Icc] at hj ⊢
    have : (N : ℤ) ≤ M := by exact_mod_cast hNM
    omega
  set G : ℕ → EuclideanSpace ℝ (Fin n) → ℝ≥0∞ := fun N x =>
    (∑ j ∈ I N, a j x) ^ (1 / 2 : ℝ)
  have hGm : ∀ N, AEMeasurable (G N) volume := fun N =>
    (Finset.aemeasurable_fun_sum _ fun j _ => ham j).pow_const _
  have hsup : ∀ x, (∑' j, a j x) ^ (1 / 2 : ℝ) = ⨆ N, G N x := by
    intro x
    rw [ENNReal.tsum_eq_iSup_sum' I hI, jsw_rpow_iSup _ (by norm_num)]
  have hGmono : ∀ x, Monotone fun N => G N x ^ p := by
    intro x N M hNM
    simp only [G]
    gcongr
    exact hImono hNM
  have hF : AEMeasurable (fun x => ⨆ N, G N x) volume := AEMeasurable.iSup hGm
  simp_rw [show (fun x => (∑' j, ‖(jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x -
      dyadicAvg n j f x‖ₑ ^ 2) ^ (1 / 2 : ℝ)) = fun x => ⨆ N, G N x from funext hsup]
  rw [jsw_eLpNorm_ennreal_eq hF hp0]
  simp_rw [jsw_rpow_iSup _ hp0]
  rw [lintegral_iSup' (fun N => (hGm N).pow_const p) (ae_of_all _ hGmono)]
  have hbound : ∀ N, ∫⁻ x, G N x ^ p ≤ ((C : ℝ≥0∞) * eLpNorm f (ENNReal.ofReal p) volume) ^ p := by
    intro N
    have := hC (I N) f hf
    rw [jsw_eLpNorm_ennreal_eq (hGm N) hp0] at this
    have h2 := ENNReal.rpow_le_rpow this hp0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hp0.ne', ENNReal.rpow_one] at h2
  calc (⨆ N, ∫⁻ x, G N x ^ p) ^ (1 / p)
      ≤ (((C : ℝ≥0∞) * eLpNorm f (ENNReal.ofReal p) volume) ^ p) ^ (1 / p) :=
        ENNReal.rpow_le_rpow (iSup_le hbound) (by positivity)
    _ = _ := by rw [← ENNReal.rpow_mul, mul_one_div_cancel hp0.ne', ENNReal.rpow_one]

/-- The jump counting function of measurable sequences of functions is measurable. -/
theorem jsw_measurable_jumpCount {α : Type*} [MeasurableSpace α] {b : ℤ → α → ℂ}
    (hb : ∀ j, Measurable (b j)) (lam : ℝ) :
    Measurable fun x => jswJumpCount lam (fun j => b j x) := by
  classical
  unfold jswJumpCount
  refine Measurable.iSup fun N => Measurable.iSup fun s => Measurable.iSup fun t =>
    Measurable.iSup fun _ => Measurable.iSup fun _ => ?_
  have hS : MeasurableSet {x | ∀ i, lam < ‖b (t i) x - b (s i) x‖} := by
    simp only [ofPred_forall]
    exact MeasurableSet.iInter fun i => measurableSet_lt measurable_const
      ((hb _).sub (hb _)).norm
  have : (fun x => ⨆ (_ : ∀ i, lam < ‖b (t i) x - b (s i) x‖), (N : ℝ≥0∞)) =
      {x | ∀ i, lam < ‖b (t i) x - b (s i) x‖}.indicator fun _ => (N : ℝ≥0∞) := by
    funext x
    rw [iSup_eq_if]
    by_cases hx : ∀ i, lam < ‖b (t i) x - b (s i) x‖
    · rw [ite_eq_left hx,
        indicator_of_mem (show x ∈ {x | ∀ i, lam < ‖b (t i) x - b (s i) x‖} from hx)]
    · rw [ite_eq_right hx, indicator_of_notMem (show x ∉ {x | ∀ i, lam < ‖b (t i) x - b (s i) x‖}
        from hx)]
      rfl
  rw [this]
  exact measurable_const.indicator hS

/-- A.e. measurability of the jump function `x ↦ λ N_λ(φ_j * f(x) : j ∈ ℤ)^{1/2}`. -/
theorem jsw_aemeasurable_jump {n : ℕ} (φ : EuclideanSpace ℝ (Fin n) → ℂ)
    (hφ : Integrable φ) {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : AEStronglyMeasurable f volume)
    (lam : ℝ) :
    AEMeasurable (fun x => ENNReal.ofReal lam * jswJumpCount lam
      (fun j => (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x) ^ (1 / 2 : ℝ))
      volume := by
  have hK : ∀ j : ℤ, AEStronglyMeasurable
      (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) volume := by
    intro j
    have hd : AEStronglyMeasurable (jswDilate n φ j) volume := by
      have := (hφ.comp_smul (zpow_pos two_pos j).ne').aestronglyMeasurable
      exact (this.const_smul ((2 : ℝ) ^ (j * n))).congr (ae_of_all _ fun x => rfl)
    exact AEStronglyMeasurable.convolution _ hd hf
  set b : ℤ → EuclideanSpace ℝ (Fin n) → ℂ := fun j => (hK j).mk _
  have hbm : ∀ j, Measurable (b j) := fun j => (hK j).stronglyMeasurable_mk.measurable
  have hae : ∀ᵐ x, ∀ j, (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x = b j x :=
    ae_all_iff.2 fun j => (hK j).ae_eq_mk
  refine (((jsw_measurable_jumpCount hbm lam).pow_const (1 / 2 : ℝ)).const_mul
    (ENNReal.ofReal lam)).aemeasurable.congr ?_
  filter_upwards [hae] with x hx
  simp only [hx]

/-- **The jump inequality for dyadic dilates of a Schwartz approximate identity**
(Jones–Seeger–Wright): for `φ ∈ 𝓢(ℝⁿ)` with `∫ φ = 1`, `n ≥ 1` and `1 < p < ∞` there is `C`
such that for all `f ∈ L^p(ℝⁿ)` and all `λ > 0`,
`‖λ N_λ(φ_j * f : j ∈ ℤ)^{1/2}‖_p ≤ C ‖f‖_p`, where `φ_j(x) = 2^{jn} φ(2^j x)`. -/
theorem jsw_jump_inequality {n : ℕ} (hn : 0 < n)
    (φ : SchwartzMap (EuclideanSpace ℝ (Fin n)) ℂ) (hφ : ∫ x, φ x = 1) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : EuclideanSpace ℝ (Fin n) → ℂ, MemLp f (ENNReal.ofReal p) volume →
      ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam * jswJumpCount lam
          (fun j => (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x) ^ (1 / 2 : ℝ))
          (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨A, h⟩ := jswAdm_of_schwartz φ hφ
  obtain ⟨CL, hCL⟩ := lepingle_jump_inequality n hp
  obtain ⟨CS, hCS⟩ := jsw_square_function hn φ hφ hp
  refine ⟨3 * CL + 3 * CS, fun f hf lam hlam => ?_⟩
  have hp0 : 0 < p := by linarith
  have hp1 : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  set J : EuclideanSpace ℝ (Fin n) → ℝ≥0∞ := fun x => ENNReal.ofReal (lam / 3) *
    seqJumpCount (lam / 3) (fun j => dyadicAvg n j f x) ^ (1 / 2 : ℝ)
  set S : EuclideanSpace ℝ (Fin n) → ℝ≥0∞ := fun x =>
    (∑' j : ℤ, ‖(jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x -
      dyadicAvg n j f x‖ₑ ^ 2) ^ (1 / 2 : ℝ)
  have hJm : AEMeasurable J volume := aemeasurable_lepingle f (lam / 3)
  have hSm : AEMeasurable S volume := by
    refine (AEMeasurable.tsum fun j => ?_).pow_const _
    exact (h.aestronglyMeasurable_jswDiff j hf.aestronglyMeasurable).enorm.pow_const 2
  have hpt : ∀ x, ENNReal.ofReal lam * jswJumpCount lam
      (fun j => (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x) ^ (1 / 2 : ℝ) ≤
      3 * J x + 3 * S x := by
    intro x
    have := jsw_jump_sqrt_le hlam
      (fun j => (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x)
      (fun j => dyadicAvg n j f x)
    simpa only [J, S, jswJumpCount_eq_seqJumpCount, ENNReal.rpow_two] using this
  calc eLpNorm (fun x => ENNReal.ofReal lam * jswJumpCount lam
          (fun j => (jswDilate n φ j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) x) ^ (1 / 2 : ℝ))
          (ENNReal.ofReal p) volume
      ≤ eLpNorm (fun x => 3 * J x + 3 * S x) (ENNReal.ofReal p) volume :=
        eLpNorm_mono_enorm (jsw_aemeasurable_jump φ h.integrable hf.aestronglyMeasurable
          lam).aestronglyMeasurable fun x => by simpa only [enorm_eq_self] using hpt x
    _ ≤ eLpNorm (fun x => 3 * J x) (ENNReal.ofReal p) volume +
          eLpNorm (fun x => 3 * S x) (ENNReal.ofReal p) volume :=
        eLpNorm_add_le (f := fun x => 3 * J x) (g := fun x => 3 * S x) hp1
    _ = 3 * eLpNorm J (ENNReal.ofReal p) volume + 3 * eLpNorm S (ENNReal.ofReal p) volume := by
        rw [jsw_eLpNorm_const_mul (by norm_num) hJm hp0,
          jsw_eLpNorm_const_mul (by norm_num) hSm hp0]
    _ ≤ 3 * (CL * eLpNorm f (ENNReal.ofReal p) volume) +
          3 * (CS * eLpNorm f (ENNReal.ofReal p) volume) := by
        gcongr
        · exact hCL f hf (lam / 3) (by positivity)
        · exact hCS f hf
    _ = ((3 * CL + 3 * CS : ℝ≥0) : ℝ≥0∞) * eLpNorm f (ENNReal.ofReal p) volume := by
        push_cast; ring

end JswG

