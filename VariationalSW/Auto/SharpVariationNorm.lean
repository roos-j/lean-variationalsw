namespace Auto

open MeasureTheory Complex Filter Set
open scoped ENNReal NNReal Topology Convolution SchwartzMap

section SteinWaingerSmall

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The geometric weights `w_ℓ = 2^{(ℓ+2)α}` for `ℓ < 0` and `w_ℓ = 0` for `ℓ ≥ 0`; they bound
the error terms `𝓗^{(u)}_{ℓ-j} - 𝓗^{(0)}_{ℓ-j}` for `u ∈ J_j` (proof of (`170712e1.5`),
§1 of the paper). -/
noncomputable def swGeom (α : ℝ) (ℓ : ℤ) : ℝ :=
  if ℓ < 0 then (2 : ℝ) ^ (((ℓ : ℝ) + 2) * α) else 0

/-- `w_ℓ ≥ 0`. -/
theorem swGeom_nonneg (α : ℝ) (ℓ : ℤ) : 0 ≤ swGeom α ℓ := by
  unfold swGeom; split_ifs <;> positivity

/-- The weights `w_ℓ` are summable for `α > 0`. -/
theorem summable_swGeom {α : ℝ} (hα : 0 < α) : Summable (swGeom α) := by
  have hr0 : 0 ≤ (2 : ℝ) ^ (-α) := by positivity
  have hr1 : (2 : ℝ) ^ (-α) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  refine Summable.of_nat_of_neg ?_ ?_
  · have : (fun k : ℕ => swGeom α k) = fun _ => 0 := by
      funext k
      have hk : ¬ ((k : ℤ) < 0) := not_lt.2 (Int.natCast_nonneg k)
      simp only [swGeom, hk, ↓reduceIte]
    rw [this]; exact summable_zero
  · refine Summable.of_nonneg_of_le (fun k => swGeom_nonneg α _) (fun k => ?_)
      ((summable_geometric_of_lt_one hr0 hr1).mul_left ((2 : ℝ) ^ (2 * α)))
    unfold swGeom
    split_ifs with h
    · rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add two_pos]
      apply le_of_eq; congr 1; push_cast; ring
    · positivity

/-- The maximal function of a bounded function is bounded: `|f| ≤ c ⇒ M f ≤ c`. -/
theorem lpMaximal_le_of_norm_le {f : Rn n → ℂ} {c : ℝ} (hf : ∀ y, ‖f y‖ ≤ c) (x : Rn n) :
    lpMaximal f x ≤ ENNReal.ofReal c := by
  refine iSup₂_le fun r hr => ?_
  have h0 : volume (Metric.closedBall x r) ≠ 0 := (Metric.measure_closedBall_pos volume x hr).ne'
  have ht : volume (Metric.closedBall x r) ≠ ∞ := measure_closedBall_lt_top.ne
  calc (volume (Metric.closedBall x r))⁻¹ * ∫⁻ y in Metric.closedBall x r, ‖f y‖ₑ
      ≤ (volume (Metric.closedBall x r))⁻¹ *
          ∫⁻ _ in Metric.closedBall x r, ENNReal.ofReal c := by
        gcongr with y
        rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hf y)
    _ = ENNReal.ofReal c := by
        rw [setLIntegral_const, mul_comm (ENNReal.ofReal c), ← mul_assoc,
          ENNReal.inv_mul_cancel h0 ht, one_mul]

/-- The pieces at `u = 0` as convolutions with the dilates of `k₀ = φ K` (§3 notation):
`∫ (k₀)_{-ℓ}(x - y) f(y) dy = 𝓗^{(0)}_ℓ f(x)` (`eq:Hul`). -/
theorem IsHomogeneousCZKernel.sw_integral_ljAmp_eq (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ)
    (ℓ : ℤ) (f : Rn n → ℂ) (x : Rn n) :
    ∫ y, lpDilate n (ljAmp n Ω) (-ℓ) (x - y) * f y = modulatedPiece n α Ω 0 ℓ f x := by
  rw [lj_integral_sub_mul, modulatedPiece]
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  dsimp only
  rw [hΩ.lpDilate_ljAmp_apply, neg_neg]
  simp only [Complex.ofReal_zero, mul_zero, zero_mul, Complex.exp_zero, mul_one]
  ring

/-- The terms of the smooth truncation `T_j` of §3 are the pieces `𝓗^{(0)}_{m-j}`, `m ≥ 0`. -/
theorem IsHomogeneousCZKernel.sw_integral_ljTruncPiece_eq (hΩ : IsHomogeneousCZKernel n Ω)
    (α : ℝ) (m j : ℤ) (f : Rn n → ℂ) (x : Rn n) :
    ∫ y, lpDilate n (ljTruncPiece n Ω m) j (x - y) * f y =
      if 0 ≤ m then modulatedPiece n α Ω 0 (m - j) f x else 0 := by
  by_cases hm : 0 ≤ m
  · rw [ite_eq_left hm, ljTruncPiece, ite_eq_left hm, ljPiece, lpDilate_lpDilate,
      show -m + j = -(m - j) by ring]
    exact hΩ.sw_integral_ljAmp_eq α (m - j) f x
  · have : lpDilate n (ljTruncPiece n Ω m) j = 0 := by
      funext t; simp [ljTruncPiece, hm, lpDilate]
    rw [ite_eq_right hm, this]
    simp

/-- **The non-oscillatory small-scale part** (proof of (`170712e1.5`)):
`∑_{ℓ < 0} 𝓗^{(0)}_{ℓ-j} f(x) = T f(x) - T_j f(x)`, where `T = 𝓗^{(0)}` and `T_j` is the smooth
truncation `ljSmoothTrunc` (the part of `T` at scales `≥ 2^{-j}`). -/
theorem IsHomogeneousCZKernel.sw_hasSum_sub_ljSmoothTrunc (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) (j : ℤ) (x : Rn n) :
    HasSum (fun ℓ : ℤ => if ℓ < 0 then modulatedPiece n α Ω 0 (ℓ - j) f x else 0)
      (modulatedSI n α Ω 0 f x - ljSmoothTrunc n Ω j f x) := by
  have hall : HasSum (fun ℓ : ℤ => modulatedPiece n α Ω 0 (ℓ - j) f x)
      (modulatedSI n α Ω 0 f x) :=
    (Equiv.subRight j).hasSum_iff.2 (hΩ.hasSum_modulatedPiece hn hα 0 f x)
  have htr : HasSum (fun ℓ : ℤ => if 0 ≤ ℓ then modulatedPiece n α Ω 0 (ℓ - j) f x else 0)
      (ljSmoothTrunc n Ω j f x) :=
    (hΩ.hasSum_ljSmoothTrunc hn f j x).congr_fun fun m =>
      (hΩ.sw_integral_ljTruncPiece_eq α m j f x).symm
  refine (hall.sub htr).congr_fun fun ℓ => ?_
  by_cases h : ℓ < 0
  · simp [h, not_le.2 h]
  · simp [h, not_lt.1 h]

/-- The kernels `D_m = φ * k_m - k_m 𝟙_{m ≥ 0}` of §3 comparing the smooth truncations `T_j`
with `φ_j * T` (`T_j f = φ_j * T f - ∑_m (D_m)_j * f`). -/
noncomputable def swD (n : ℕ) (Ω : Rn n → ℝ) (m : ℤ) (t : Rn n) : ℂ :=
  ljConv n Ω m t - ljTruncPiece n Ω m t

/-- `φ * k_m` is integrable. -/
theorem IsHomogeneousCZKernel.sw_integrable_ljConv (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) (m : ℤ) : Integrable (ljConv n Ω m) :=
  ((hΩ.ljKernel_ljPiece m).conv_meanZero (by positivity) ljA1_nonneg
    (hΩ.integral_ljPiece hn m)).integrable

/-- The truncated pieces are integrable. -/
theorem IsHomogeneousCZKernel.sw_integrable_ljTruncPiece (hΩ : IsHomogeneousCZKernel n Ω)
    (m : ℤ) : Integrable (ljTruncPiece n Ω m) := by
  by_cases hm : 0 ≤ m
  · rw [ljTruncPiece, ite_eq_left hm]; exact (hΩ.ljKernel_ljPiece m).integrable
  · rw [ljTruncPiece, ite_eq_right hm]; exact integrable_zero _ _ _

/-- `D_m` is integrable. -/
theorem IsHomogeneousCZKernel.sw_integrable_swD (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    (m : ℤ) : Integrable (swD n Ω m) :=
  (hΩ.sw_integrable_ljConv hn m).sub (hΩ.sw_integrable_ljTruncPiece m)

/-- **The square functions of the `D_m` are summable in `L^p`** (§3, (3.8)–(3.12), as in the
proof of `eLpNorm_jumpFunction_ljSmoothTrunc_le`):
`‖∑_m (∑_j |(D_m)_j * f|²)^{1/2}‖_p ≤ K ‖f‖_p`, by the decay `2^{-|m|/2}` of the two families. -/
theorem IsHomogeneousCZKernel.sw_eLpNorm_tsum_ljSq_swD_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {p : ℝ} (hp : 1 < p) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => ∑' m, ljSq n (swD n Ω m) f x) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal K * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C₂, hC₂, h₂⟩ := hΩ.eLpNorm_ljSq_conv_le hn hp
  obtain ⟨C₄, hC₄, h₄⟩ := hΩ.eLpNorm_ljSq_conv_sub_le hn hp
  set r : ℝ := (2 : ℝ) ^ (-(1 / 2 : ℝ))
  have hDb : ∀ (m : ℤ) (f : 𝓢(Rn n, ℂ)),
      eLpNorm (ljSq n (swD n Ω m) f) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal ((C₂ + C₄) * r ^ m.natAbs) * eLpNorm f (ENNReal.ofReal p) volume := by
    intro m f
    have hgeom := lj_geom_eq (1 / 2) m
    by_cases hm : 0 ≤ m
    · have heq : swD n Ω m = fun x => ljConv n Ω m x - ljPiece n Ω m x := by
        funext t; simp [swD, ljTruncPiece, hm]
      rw [heq]
      refine (h₄ m hm f (f.memLp _)).trans (mul_le_mul_of_nonneg_right
        (ENNReal.ofReal_le_ofReal ?_) zero_le)
      have habs : |(m : ℝ)| = m := abs_of_nonneg (by exact_mod_cast hm)
      have hs : √((2 : ℝ) ^ (-m)) = r ^ m.natAbs := by
        rw [hgeom, habs, lj_sqrt_two_zpow]; push_cast; ring_nf
      rw [hs]
      have : 0 ≤ r ^ m.natAbs := by positivity
      nlinarith
    · have heq : swD n Ω m = ljConv n Ω m := by
        funext t; simp [swD, ljTruncPiece, hm]
      rw [heq]
      refine (h₂ m (by omega) f (f.memLp _)).trans (mul_le_mul_of_nonneg_right
        (ENNReal.ofReal_le_ofReal ?_) zero_le)
      have habs : |(m : ℝ)| = -m := abs_of_neg (by exact_mod_cast (not_le.1 hm))
      have hs : √((2 : ℝ) ^ m) = r ^ m.natAbs := by
        rw [hgeom, habs, lj_sqrt_two_zpow]; ring_nf
      rw [hs]
      have : 0 ≤ r ^ m.natAbs := by positivity
      nlinarith
  have hsum := lj_summable_geom (δ := 1 / 2) (by norm_num)
  refine ⟨(C₂ + C₄) * ljGeom (1 / 2), mul_nonneg (by positivity) (ljGeom_nonneg _),
    fun f => ?_⟩
  have hSm' : ∀ m, AEMeasurable (ljSq n (swD n Ω m) f) := fun m =>
    lj_aemeasurable_ljSq (hΩ.sw_integrable_swD hn m) hp.le (f.memLp _)
  calc eLpNorm (fun x => ∑' m, ljSq n (swD n Ω m) f x) (ENNReal.ofReal p) volume
      ≤ ∑' m, eLpNorm (ljSq n (swD n Ω m) f) (ENNReal.ofReal p) volume :=
        lj_eLpNorm_tsum_le hSm' hp.le
    _ ≤ ∑' m : ℤ, ENNReal.ofReal ((C₂ + C₄) * r ^ m.natAbs) *
          eLpNorm f (ENNReal.ofReal p) volume := ENNReal.tsum_le_tsum fun m => hDb m f
    _ = ENNReal.ofReal ((C₂ + C₄) * ljGeom (1 / 2)) * eLpNorm f (ENNReal.ofReal p) volume := by
        rw [ENNReal.tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg (fun m => by positivity)
          (hsum.mul_left _), tsum_mul_left]; rfl

/-- **Comparison of `T_j` with `φ_j * T`** (pointwise): with `T = 𝓗^{(0)}`,
`|φ_j * T f(x) - T_j f(x)| ≤ ∑_m (∑_i |(D_m)_i * f(x)|²)^{1/2}` for every `j` (from the
decomposition of §3, `hasSum_conv_pieces` and `hasSum_ljSmoothTrunc`). -/
theorem IsHomogeneousCZKernel.sw_enorm_conv_sub_ljSmoothTrunc_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ))
    (j : ℤ) (x : Rn n) :
    ‖(jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        (fun z => modulatedSI n α Ω 0 f z)) x - ljSmoothTrunc n Ω j f x‖ₑ ≤
      ∑' m, ljSq n (swD n Ω m) f x := by
  obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
  have hint : ∀ K : Rn n → ℂ, Integrable K → Integrable fun y => K (x - y) * f y := fun K hK =>
    (hK.comp_sub_left x).mul_bdd f.continuous.aestronglyMeasurable
      (Eventually.of_forall fun y => hCf y)
  have hterm : ∀ m, ∫ y, lpDilate n (swD n Ω m) j (x - y) * f y =
      (∫ y, lpDilate n (ljConv n Ω m) j (x - y) * f y) -
        ∫ y, lpDilate n (ljTruncPiece n Ω m) j (x - y) * f y := by
    intro m
    rw [← integral_sub (hint _ (integrable_lpDilate (hΩ.sw_integrable_ljConv hn m) j))
      (hint _ (integrable_lpDilate (hΩ.sw_integrable_ljTruncPiece m) j))]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    simp only [swD, lpDilate]
    ring
  have h := ((hΩ.hasSum_conv_pieces hn hα f x j).sub
    (hΩ.hasSum_ljSmoothTrunc hn f j x)).congr_fun hterm
  rw [← h.tsum_eq]
  refine enorm_tsum_le_tsum_enorm.trans (ENNReal.tsum_le_tsum fun m => ?_)
  unfold ljSq
  calc ‖∫ y, lpDilate n (swD n Ω m) j (x - y) * f y‖ₑ
      = (‖∫ y, lpDilate n (swD n Ω m) j (x - y) * f y‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) :=
        (rpow_rpow_one_div two_ne_zero _).symm
    _ ≤ _ := by
        rw [ENNReal.rpow_two]
        gcongr
        exact ENNReal.le_tsum (f := fun i => ‖∫ y, lpDilate n (swD n Ω m) i (x - y) * f y‖ₑ ^ 2) j

/-- **The smoothing operators `φ_j *` are dominated by the maximal function**:
`|φ_j * g(x)| ≤ M g(x)` (Stein's lemma `norm_conv_le_maximal` for the radially decreasing bump
`φ = ljBump` with `∫ φ = 1`). -/
theorem sw_enorm_bump_conv_le (hn : 1 ≤ n) (j : ℤ) {g : Rn n → ℂ}
    (hg : AEStronglyMeasurable g volume) (x : Rn n) :
    ‖(jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) x‖ₑ ≤
      lpMaximal g x := by
  rw [coe_ljBumpSchwartz, jswDilate_eq_lpDilate, convolution_mul_swap]
  set ω₀ : Rn n := EuclideanSpace.single ⟨0, hn⟩ 1
  have hω₀ : ‖ω₀‖ = 1 := by simp [ω₀]
  have hc0 : 0 ≤ (ljEtaInt n)⁻¹ := inv_nonneg.2 (ljEtaInt_pos n).le
  have hnorm : ∀ z : Rn n, ‖lpDilate n (ljBump n) j z‖ =
      (2 : ℝ) ^ (j * n) * ((ljEtaInt n)⁻¹ * dyadicEta n ((2 : ℝ) ^ j • z)) := by
    intro z
    rw [lpDilate_apply_ofReal, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity),
      norm_ljBump]
  have hsm : ∀ (r : ℝ), 0 ≤ r → ‖(2 : ℝ) ^ j • (r • ω₀)‖ = (2 : ℝ) ^ j * r := by
    intro r hr
    rw [norm_smul, norm_smul, hω₀, mul_one, Real.norm_of_nonneg hr,
      Real.norm_of_nonneg (by positivity)]
  set Φ : ℝ → ℝ := fun r => ‖lpDilate n (ljBump n) j (r • ω₀)‖ with hΦ
  have hrad : ∀ z : Rn n, ‖lpDilate n (ljBump n) j z‖ = Φ ‖z‖ := by
    intro z
    simp only [hΦ, hnorm]
    rw [dyadicEta_congr_norm (n := n) (s := (2 : ℝ) ^ j • z) (t := (2 : ℝ) ^ j • (‖z‖ • ω₀))
      (by rw [hsm _ (norm_nonneg z), norm_smul, Real.norm_of_nonneg (by positivity)])]
  have hanti : AntitoneOn Φ (Ici 0) := by
    intro a ha b hb hab
    simp only [hΦ, hnorm]
    refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (dyadicEta_antitone ?_) hc0)
      (by positivity)
    rw [hsm a ha, hsm b hb]
    gcongr
  have hle := norm_conv_le_maximal (by omega) hanti (fun r _ => norm_nonneg _)
    (fun z => (hrad z).le) hg x
  refine hle.trans (le_of_eq ?_)
  have hint : ∫⁻ z : Rn n, ENNReal.ofReal (Φ ‖z‖) = 1 := by
    simp_rw [← hrad, ofReal_norm, lpDilate_apply_ofReal, enorm_mul]
    rw [lintegral_const_mul' _ _ enorm_ne_top,
      lj_lintegral_comp_smul (fun t => ‖ljBump n t‖ₑ) (zpow_ne_zero j two_ne_zero),
      lintegral_ljBump, mul_one, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (by positivity), ← ENNReal.ofReal_mul (by positivity),
      abs_of_pos (by positivity), zpow_mul, zpow_natCast,
      mul_inv_cancel₀ (by positivity), ENNReal.ofReal_one]
  rw [hint, one_mul]

/-- The kernels `φ_ℓ K` of the pieces are integrable. -/
theorem IsHomogeneousCZKernel.sw_integrable_kernel (hΩ : IsHomogeneousCZKernel n Ω) (ℓ : ℤ) :
    Integrable fun t : Rn n => ((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ) :=
  (hΩ.ljKernel_ljPiece ℓ).integrable.congr
    (Eventually.of_forall fun t => by simp only [ljPiece, hΩ.lpDilate_ljAmp_apply, neg_neg])

/-- Measurability of the phase `t ↦ e^{iv|t|^α}`. -/
theorem sw_measurable_phase (α v : ℝ) :
    Measurable fun t : Rn n => exp (I * v * (‖t‖ ^ α : ℝ)) :=
  Complex.measurable_exp.comp (measurable_const.mul
    (Complex.measurable_ofReal.comp (measurable_norm.pow_const α)))

/-- The pieces `𝓗^{(u)}_ℓ f` (`eq:Hul`) are continuous functions of `x` (dominated convergence;
the kernel `e^{iu|t|^α} φ_ℓ K` is integrable and `f` is bounded and continuous). -/
theorem IsHomogeneousCZKernel.sw_continuous_modulatedPiece (hΩ : IsHomogeneousCZKernel n Ω)
    (α u : ℝ) (ℓ : ℤ) (f : 𝓢(Rn n, ℂ)) : Continuous fun x => modulatedPiece n α Ω u ℓ f x := by
  obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
  have hki := hΩ.sw_integrable_kernel ℓ
  unfold modulatedPiece
  refine continuous_of_dominated
    (bound := fun t => Cf * ‖((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ)‖)
    (fun x => ?_) (fun x => Eventually.of_forall fun t => ?_) (hki.norm.const_mul Cf)
    (Eventually.of_forall fun t => ?_)
  · exact (((f.continuous.comp (continuous_const.sub continuous_id)).aestronglyMeasurable.mul
      (sw_measurable_phase α u).aestronglyMeasurable).mul
      (Complex.measurable_ofReal.comp ((measurable_dyadicPhiScale n ℓ).mul
        hΩ.measurable_czKernel)).aestronglyMeasurable)
  · rw [norm_mul, norm_mul, norm_exp_I_mul_mul, mul_one]
    exact mul_le_mul_of_nonneg_right (hCf _) (norm_nonneg _)
  · exact ((f.continuous.comp (continuous_id.sub continuous_const)).mul continuous_const).mul
      continuous_const

/-- **The oscillatory error at small scales** (proof of (`170712e1.5`)): for `u ∈ J_j`
(so `0 ≤ u ≤ 2^{(j+1)α}`) and `|K(t)| ≤ C |t|^{-n}`,
`|𝓗^{(u)}_ℓ f(x) - 𝓗^{(0)}_ℓ f(x)| ≤ C 4ⁿ 2^{(j+ℓ+2)α} |B(0,1)| M f(x)`: the kernel
`(e^{iu|t|^α} - 1) φ_ℓ(t) K(t)` is bounded by `u|t|^α · C 4ⁿ 2^{-(ℓ+1)n}` and supported in
`|t| ≤ 2^{ℓ+1}` (`norm_conv_le_maximal` with a constant radial majorant on that ball). -/
theorem IsHomogeneousCZKernel.sw_enorm_modulatedPiece_sub_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {C : ℝ} (hC0 : 0 ≤ C) (hC : ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n)
    {α : ℝ} (hα : 0 < α) {u : ℝ} {j : ℤ} (hu : u ∈ shortInterval α j) (ℓ : ℤ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    ‖modulatedPiece n α Ω u ℓ f x - modulatedPiece n α Ω 0 ℓ f x‖ₑ ≤
      ENNReal.ofReal (C * 4 ^ n * (2 : ℝ) ^ (((j : ℝ) + ℓ + 2) * α)) *
        volume (Metric.closedBall (0 : Rn n) 1) * lpMaximal f x := by
  have hu0 : 0 ≤ u := (dyadicPoint_pos α j).le.trans hu.1
  have hu1 : u ≤ dyadicPoint α (j + 1) := hu.2
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = (2 : ℝ) ^ (ℓ + 1) := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = (2 : ℝ) ^ (ℓ - 1) := ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : ℝ, P = (2 : ℝ) ^ (((j : ℝ) + ℓ + 2) * α) := ⟨_, rfl⟩
  have hR0 : 0 < R := hR ▸ zpow_pos two_pos _
  have hs0 : 0 < s := hs ▸ zpow_pos two_pos _
  have hP0 : 0 < P := hP ▸ Real.rpow_pos_of_pos two_pos _
  have hRs : R = 4 * s := by
    rw [hR, hs, show ℓ + 1 = (ℓ - 1) + 2 by ring, zpow_add₀ two_ne_zero]; norm_num; ring
  have hpow : dyadicPoint α (j + 1) * R ^ α = P := by
    rw [dyadicPoint, hR, hP, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num),
      ← Real.rpow_add two_pos]
    congr 1; push_cast; ring
  set B : ℝ := P * (C / s ^ n) with hB
  have hB0 : 0 ≤ B := by positivity
  have hBR : B * R ^ n = C * 4 ^ n * P := by
    rw [hB, hRs, mul_pow]; field_simp
  -- the kernels
  set k : ℝ → Rn n → ℂ := fun v t =>
    exp (I * v * (‖t‖ ^ α : ℝ)) * ((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ) with hk
  have hki : ∀ v, Integrable (k v) := fun v =>
    (hΩ.sw_integrable_kernel ℓ).bdd_mul (c := 1) (sw_measurable_phase α v).aestronglyMeasurable
      (Eventually.of_forall fun t => (norm_exp_I_mul_mul v _).le)
  obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
  have hint : ∀ v, Integrable fun t => k v t * f (x - t) := fun v =>
    (hki v).mul_bdd (f.continuous.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
      (Eventually.of_forall fun t => hCf _)
  have hpiece : ∀ v, modulatedPiece n α Ω v ℓ f x = ∫ t, k v t * f (x - t) := by
    intro v
    rw [modulatedPiece]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [hk]; ring
  set h : Rn n → ℂ := fun t => k u t - k 0 t with hh
  have heq : modulatedPiece n α Ω u ℓ f x - modulatedPiece n α Ω 0 ℓ f x =
      ∫ y, h (x - y) * f y := by
    rw [hpiece, hpiece, ← integral_sub (hint u) (hint 0), lj_integral_sub_mul]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [hh]; ring
  -- the radial majorant
  set Φ : ℝ → ℝ := fun r => if r ≤ R then B else 0 with hΦ
  have hΦ0 : ∀ r, 0 ≤ r → 0 ≤ Φ r := fun r _ => by
    simp only [hΦ]; split_ifs <;> linarith
  have hanti : AntitoneOn Φ (Ici 0) := by
    intro a _ b _ hab
    simp only [hΦ]
    split_ifs <;> linarith
  have hbound : ∀ z, ‖h z‖ ≤ Φ ‖z‖ := by
    intro z
    have hhz : h z = (exp (I * u * (‖z‖ ^ α : ℝ)) - 1) *
        ((dyadicPhiScale n ℓ z * czKernel n Ω z : ℝ) : ℂ) := by
      simp only [hh, hk, Complex.ofReal_zero, mul_zero, zero_mul, Complex.exp_zero]; ring
    rw [hhz]
    by_cases hφ : dyadicPhiScale n ℓ z = 0
    · simp only [hφ, zero_mul, Complex.ofReal_zero, mul_zero, norm_zero]
      exact hΦ0 _ (norm_nonneg _)
    have hsupp := dyadicPhiScale_ne_zero hφ
    rw [← hs] at hsupp
    rw [← hR] at hsupp
    have hΦz : Φ ‖z‖ = B := by simp only [hΦ, ite_eq_left hsupp.2.le]
    rw [hΦz, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_mul,
      abs_of_nonneg (dyadicPhiScale_nonneg n ℓ z)]
    have he : ‖exp (I * u * (‖z‖ ^ α : ℝ)) - 1‖ ≤ dyadicPoint α (j + 1) * R ^ α := by
      refine (norm_exp_I_mul_mul_sub_one_le u _).trans ?_
      rw [abs_of_nonneg hu0, abs_of_nonneg (by positivity)]
      exact mul_le_mul hu1 (Real.rpow_le_rpow (norm_nonneg _) hsupp.2.le hα.le) (by positivity)
        ((dyadicPoint_pos α _).le)
    have hK : dyadicPhiScale n ℓ z * |czKernel n Ω z| ≤ C / s ^ n := by
      calc dyadicPhiScale n ℓ z * |czKernel n Ω z| ≤ 1 * (C / ‖z‖ ^ n) :=
            mul_le_mul (dyadicPhiScale_le_one n ℓ z) (hC z) (abs_nonneg _) zero_le_one
        _ ≤ C / s ^ n := by
            rw [one_mul]
            exact div_le_div_of_nonneg_left hC0 (pow_pos hs0 n)
              (pow_le_pow_left₀ hs0.le hsupp.1.le n)
    calc ‖exp (I * u * (‖z‖ ^ α : ℝ)) - 1‖ * (dyadicPhiScale n ℓ z * |czKernel n Ω z|)
        ≤ (dyadicPoint α (j + 1) * R ^ α) * (C / s ^ n) :=
          mul_le_mul he hK (mul_nonneg (dyadicPhiScale_nonneg n ℓ z) (abs_nonneg _))
            (mul_nonneg (dyadicPoint_pos α _).le (Real.rpow_nonneg hR0.le _))
      _ = B := by rw [hpow]
  have hle := norm_conv_le_maximal (by omega) hanti hΦ0 hbound f.continuous.aestronglyMeasurable x
  rw [heq]
  refine hle.trans (le_of_eq ?_)
  have hlint : ∫⁻ z : Rn n, ENNReal.ofReal (Φ ‖z‖) =
      ENNReal.ofReal B * volume (Metric.closedBall (0 : Rn n) R) := by
    have : (fun z : Rn n => ENNReal.ofReal (Φ ‖z‖)) =
        (Metric.closedBall (0 : Rn n) R).indicator (fun _ => ENNReal.ofReal B) := by
      funext z
      by_cases hz : ‖z‖ ≤ R
      · simp [hΦ, hz]
      · simp [hΦ, hz]
    rw [this, lintegral_indicator_const measurableSet_closedBall]
  have : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
  rw [hlint, Measure.addHaar_closedBall _ _ hR0.le, finrank_euclideanSpace_fin, ← mul_assoc,
    ← ENNReal.ofReal_mul hB0, hBR, hP, EuclideanSpace.volume_closedBall,
    EuclideanSpace.volume_ball]

/-- The small-scale part `∑_{ℓ < 0} 𝓗^{(u)}_{ℓ-j} f(x)` (the part of `𝓗^{(u)} f` with
`|t| ≲ 2^{-j}`) is an absolutely convergent series. -/
theorem IsHomogeneousCZKernel.sw_summable_small (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) (u : ℝ) (j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    Summable fun ℓ : ℤ => if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0 := by
  have h : Summable fun ℓ : ℤ => modulatedPiece n α Ω u (ℓ - j) f x :=
    ((Equiv.subRight j).hasSum_iff.2 (hΩ.hasSum_modulatedPiece hn hα u f x)).summable
  refine (h.indicator {ℓ : ℤ | ℓ < 0}).congr fun ℓ => ?_
  simp [Set.indicator_apply]

/-- The large-scale part `∑_{ℓ ≥ 0} 𝓗^{(u)}_{ℓ-j} f(x)` is a convergent series. -/
theorem IsHomogeneousCZKernel.sw_summable_large (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) (u : ℝ) (j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    Summable fun ℓ : ℤ => if 0 ≤ ℓ then modulatedPiece n α Ω u (ℓ - j) f x else 0 := by
  have h : Summable fun ℓ : ℤ => modulatedPiece n α Ω u (ℓ - j) f x :=
    ((Equiv.subRight j).hasSum_iff.2 (hΩ.hasSum_modulatedPiece hn hα u f x)).summable
  refine (h.indicator {ℓ : ℤ | 0 ≤ ℓ}).congr fun ℓ => ?_
  simp [Set.indicator_apply]

/-- **Splitting into small and large scales** (Section 4.1, (`eq:decompl`), reindexed by
`ℓ ↦ ℓ - j`): `𝓗^{(u)} f(x) = ∑_{ℓ < 0} 𝓗^{(u)}_{ℓ-j} f(x) + ∑_{ℓ ≥ 0} 𝓗^{(u)}_{ℓ-j} f(x)`. -/
theorem IsHomogeneousCZKernel.modulatedSI_eq_small_add_large (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (u : ℝ) (j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    modulatedSI n α Ω u f x =
      (∑' ℓ : ℤ, if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0) +
        ∑' ℓ : ℤ, if 0 ≤ ℓ then modulatedPiece n α Ω u (ℓ - j) f x else 0 := by
  have hall : HasSum (fun ℓ : ℤ => modulatedPiece n α Ω u (ℓ - j) f x)
      (modulatedSI n α Ω u f x) :=
    (Equiv.subRight j).hasSum_iff.2 (hΩ.hasSum_modulatedPiece hn hα u f x)
  refine hall.unique (((hΩ.sw_summable_small hn hα u j f x).hasSum.add
    (hΩ.sw_summable_large hn hα u j f x).hasSum).congr_fun fun ℓ => ?_)
  by_cases h : ℓ < 0
  · simp [h, not_le.2 h]
  · simp [h, not_lt.1 h]

/-- **Continuity of the small-scale part** in `x` for `u ∈ J_j` (Weierstrass M-test: the pieces
are bounded by `c 2^{-|ℓ-j|} + C' 2^{(ℓ+2)α}` uniformly in `x`). -/
theorem IsHomogeneousCZKernel.sw_continuous_small (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) {u : ℝ} {j : ℤ} (hu : u ∈ shortInterval α j) (f : 𝓢(Rn n, ℂ)) :
    Continuous fun x => ∑' ℓ : ℤ, if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0 := by
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound_czKernel
  obtain ⟨c, hc0, hc⟩ := hΩ.exists_norm_piece_conv_le hn f
  obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
  have hCf0 : 0 ≤ Cf := (norm_nonneg _).trans (hCf 0)
  obtain ⟨V, hV⟩ : ∃ V : ℝ, V = (volume (Metric.closedBall (0 : Rn n) 1)).toReal := ⟨_, rfl⟩
  have hV0 : 0 ≤ V := hV ▸ ENNReal.toReal_nonneg
  refine continuous_tsum
    (u := fun ℓ => c * lpGeom (ℓ - j) + C * 4 ^ n * swGeom α ℓ * V * Cf) (fun ℓ => ?_) ?_
    (fun ℓ x => ?_)
  · by_cases h : ℓ < 0
    · simp only [h, ↓reduceIte]; exact hΩ.sw_continuous_modulatedPiece α u _ f
    · simp only [h, ↓reduceIte]; exact continuous_const
  · exact ((summable_lpGeom.comp_injective sub_left_injective).mul_left c).add
      ((((summable_swGeom hα).mul_left (C * 4 ^ n)).mul_right V).mul_right Cf)
  · have hsw0 := swGeom_nonneg α ℓ
    by_cases h : ℓ < 0
    · simp only [h, ↓reduceIte]
      have h0 : ‖modulatedPiece n α Ω 0 (ℓ - j) f x‖ ≤ c * lpGeom (ℓ - j) := by
        rw [← hΩ.sw_integral_ljAmp_eq α]; exact hc _ x
      have h1 := hΩ.sw_enorm_modulatedPiece_sub_le hn hC0 hC hα hu (ℓ - j) f x
      have hexp : ((j : ℝ) + ((ℓ - j : ℤ) : ℝ) + 2) * α = ((ℓ : ℝ) + 2) * α := by
        push_cast; ring
      have hsw : swGeom α ℓ = (2 : ℝ) ^ (((ℓ : ℝ) + 2) * α) := by simp [swGeom, h]
      rw [hexp, ← hsw] at h1
      have hM := lpMaximal_le_of_norm_le hCf x
      have h2 : ‖modulatedPiece n α Ω u (ℓ - j) f x - modulatedPiece n α Ω 0 (ℓ - j) f x‖ ≤
          C * 4 ^ n * swGeom α ℓ * V * Cf := by
        rw [← ENNReal.ofReal_le_ofReal_iff (by positivity), ofReal_norm]
        refine h1.trans ?_
        calc ENNReal.ofReal (C * 4 ^ n * swGeom α ℓ) *
              volume (Metric.closedBall (0 : Rn n) 1) * lpMaximal f x
            ≤ ENNReal.ofReal (C * 4 ^ n * swGeom α ℓ) * ENNReal.ofReal V * ENNReal.ofReal Cf := by
              rw [hV, ENNReal.ofReal_toReal measure_closedBall_lt_top.ne]
              gcongr
          _ = ENNReal.ofReal (C * 4 ^ n * swGeom α ℓ * V * Cf) := by
              rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
      calc ‖modulatedPiece n α Ω u (ℓ - j) f x‖
          = ‖modulatedPiece n α Ω 0 (ℓ - j) f x + (modulatedPiece n α Ω u (ℓ - j) f x -
              modulatedPiece n α Ω 0 (ℓ - j) f x)‖ := by congr 1; ring
        _ ≤ _ := (norm_add_le _ _).trans (add_le_add h0 h2)
    · simp only [h, ↓reduceIte, norm_zero]
      exact add_nonneg (mul_nonneg hc0 (lpGeom_nonneg _)) (by positivity)

/-- **Pointwise Cotlar-type bound** (proof of (`170712e1.5`), `ℓ < 0`): for `u ∈ J_j`, with
`T = 𝓗^{(0)}`, `|∑_{ℓ < 0} 𝓗^{(u)}_{ℓ-j} f(x)| ≤ |T f(x)| + M(T f)(x) + ∑_m S(D_m) f(x) +
C 4ⁿ (∑_ℓ w_ℓ) |B(0,1)| M f(x)`. -/
theorem IsHomogeneousCZKernel.sw_enorm_small_le (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {C : ℝ} (hC0 : 0 ≤ C) (hC : ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n) {α : ℝ} (hα : 0 < α)
    {u : ℝ} {j : ℤ} (hu : u ∈ shortInterval α j) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    ‖∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0)‖ₑ ≤
      ‖modulatedSI n α Ω 0 f x‖ₑ + lpMaximal (fun z => modulatedSI n α Ω 0 f z) x +
        ∑' m, ljSq n (swD n Ω m) f x +
        ENNReal.ofReal (C * 4 ^ n * ∑' ℓ, swGeom α ℓ) *
          volume (Metric.closedBall (0 : Rn n) 1) * lpMaximal f x := by
  have hU := (hΩ.sw_summable_small hn hα u j f x).hasSum
  have hA := hΩ.sw_hasSum_sub_ljSmoothTrunc hn hα f j x
  have hB := hU.sub hA
  have hdec : (∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0)) =
      (modulatedSI n α Ω 0 f x - ljSmoothTrunc n Ω j f x) +
        ∑' ℓ : ℤ, ((if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0) -
          (if ℓ < 0 then modulatedPiece n α Ω 0 (ℓ - j) f x else 0)) := by
    rw [hB.tsum_eq]; ring
  rw [hdec]
  refine (enorm_add_le _ _).trans ?_
  have hTm : AEStronglyMeasurable (fun z => modulatedSI n α Ω 0 f z) volume :=
    (hΩ.measurable_modulatedSI hn hα 0 f).aestronglyMeasurable
  set φT := (jswDilate n (ljBumpSchwartz n) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
    (fun z => modulatedSI n α Ω 0 f z)) x with hφT
  have h1 : ‖modulatedSI n α Ω 0 f x - ljSmoothTrunc n Ω j f x‖ₑ ≤
      ‖modulatedSI n α Ω 0 f x‖ₑ + lpMaximal (fun z => modulatedSI n α Ω 0 f z) x +
        ∑' m, ljSq n (swD n Ω m) f x := by
    have hφ : ‖φT‖ₑ ≤ lpMaximal (fun z => modulatedSI n α Ω 0 f z) x :=
      sw_enorm_bump_conv_le hn j hTm x
    have hS := hΩ.sw_enorm_conv_sub_ljSmoothTrunc_le hn hα f j x
    rw [← hφT] at hS
    calc ‖modulatedSI n α Ω 0 f x - ljSmoothTrunc n Ω j f x‖ₑ
        = ‖(modulatedSI n α Ω 0 f x - φT) + (φT - ljSmoothTrunc n Ω j f x)‖ₑ := by
          congr 1; ring
      _ ≤ ‖modulatedSI n α Ω 0 f x - φT‖ₑ + ‖φT - ljSmoothTrunc n Ω j f x‖ₑ := enorm_add_le _ _
      _ ≤ ‖modulatedSI n α Ω 0 f x‖ₑ + ‖φT‖ₑ + ‖φT - ljSmoothTrunc n Ω j f x‖ₑ := by
          gcongr; exact enorm_sub_le
      _ ≤ _ := by gcongr
  have h2 : ‖∑' ℓ : ℤ, ((if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0) -
      (if ℓ < 0 then modulatedPiece n α Ω 0 (ℓ - j) f x else 0))‖ₑ ≤
        ENNReal.ofReal (C * 4 ^ n * ∑' ℓ, swGeom α ℓ) *
          volume (Metric.closedBall (0 : Rn n) 1) * lpMaximal f x := by
    refine enorm_tsum_le_tsum_enorm.trans ?_
    calc ∑' ℓ : ℤ, ‖(if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0) -
          (if ℓ < 0 then modulatedPiece n α Ω 0 (ℓ - j) f x else 0)‖ₑ
        ≤ ∑' ℓ : ℤ, ENNReal.ofReal (C * 4 ^ n * swGeom α ℓ) *
            volume (Metric.closedBall (0 : Rn n) 1) * lpMaximal f x := by
          refine ENNReal.tsum_le_tsum fun ℓ => ?_
          by_cases h : ℓ < 0
          · simp only [h, ↓reduceIte]
            have h1 := hΩ.sw_enorm_modulatedPiece_sub_le hn hC0 hC hα hu (ℓ - j) f x
            have hexp : ((j : ℝ) + ((ℓ - j : ℤ) : ℝ) + 2) * α = ((ℓ : ℝ) + 2) * α := by
              push_cast; ring
            have hsw : swGeom α ℓ = (2 : ℝ) ^ (((ℓ : ℝ) + 2) * α) := by simp [swGeom, h]
            rwa [hexp, ← hsw] at h1
          · simp only [h, ↓reduceIte, sub_self, enorm_zero]
            exact zero_le
      _ = _ := by
          rw [ENNReal.tsum_mul_right, ENNReal.tsum_mul_right,
            ← ENNReal.ofReal_tsum_of_nonneg
              (fun ℓ => mul_nonneg (by positivity) (swGeom_nonneg α ℓ))
              ((summable_swGeom hα).mul_left _), tsum_mul_left]
  calc _ ≤ (‖modulatedSI n α Ω 0 f x‖ₑ + lpMaximal (fun z => modulatedSI n α Ω 0 f z) x +
        ∑' m, ljSq n (swD n Ω m) f x) +
        ENNReal.ofReal (C * 4 ^ n * ∑' ℓ, swGeom α ℓ) *
          volume (Metric.closedBall (0 : Rn n) 1) * lpMaximal f x := add_le_add h1 h2
    _ = _ := rfl

/-- The maximal function `lpMaximal` is measurable (it is `hlMaximal volume`). -/
theorem sw_measurable_lpMaximal {g : Rn n → ℂ} (hg : AEStronglyMeasurable g volume) :
    Measurable (lpMaximal g) := by
  have h := fs_measurable_maximal hg
  rwa [← fsMaximal_eq_hlMaximal] at h

/-- The Hardy–Littlewood maximal theorem for `lpMaximal` (`1 < p < ∞`). -/
theorem sw_eLpNorm_lpMaximal_le {p : ℝ} (hp : 1 < p) {g : Rn n → ℂ}
    (hg : AEStronglyMeasurable g volume) :
    eLpNorm (lpMaximal g) (ENNReal.ofReal p) volume ≤
      hlMaximalConst (3 ^ n) p * eLpNorm g (ENNReal.ofReal p) volume := by
  have h := eLpNorm_hlMaximal_le fs_hfin (C := 3 ^ n) fs_doubling hp hg
  rwa [← fsMaximal_eq_hlMaximal] at h

/-- **Stein–Wainger maximal estimate (`170712e1.5`), part `ℓ < 0`** (§1, display (1.5), cited
from Stein–Wainger; Cotlar-type smooth truncation argument, see the module docstring): for
`n ≥ 1`, `α > 0` and `1 < p < ∞` there is `C` such that for all Schwartz functions `f`,
`‖sup_{j ∈ ℤ} sup_{u ∈ J_j} |∑_{ℓ < 0} 𝓗^{(u)}_{ℓ-j} f|‖_p ≤ C ‖f‖_p`, where
`J_j = [2^{jα}, 2^{(j+1)α}]` and `𝓗^{(u)}_ℓ` are the pieces (`eq:Hul`). Together with
`modulatedSI_eq_small_add_large`, this reduces (`170712e1.5`) to the pieces at scales
`ℓ - j ≥ -j`. -/
theorem IsHomogeneousCZKernel.eLpNorm_iSup_shortInterval_small_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => ⨆ (j : ℤ) (u ∈ shortInterval α j),
        ‖∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0)‖ₑ)
        (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound_czKernel
  obtain ⟨CT, hCT⟩ := hΩ.eLpNorm_modulatedSI_zero_le hn hα hp
  obtain ⟨K, -, hK⟩ := hΩ.sw_eLpNorm_tsum_ljSq_swD_le hn hp
  have hp0 : 0 < p := by linarith
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using hp.le
  obtain ⟨H, hHdef⟩ : ∃ H, H = hlMaximalConst (3 ^ n) p := ⟨_, rfl⟩
  have hH : H ≠ ∞ := hHdef ▸ hlMaximalConst_ne_top _ hp0
  obtain ⟨C₁, hC₁def⟩ : ∃ C₁ : ℝ≥0∞, C₁ = ENNReal.ofReal (C * 4 ^ n * ∑' ℓ, swGeom α ℓ) *
      volume (Metric.closedBall (0 : Rn n) 1) := ⟨_, rfl⟩
  have hC₁ : C₁ ≠ ∞ := hC₁def ▸ ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    measure_closedBall_lt_top.ne
  obtain ⟨Ctot, hCtotdef⟩ : ∃ Ctot : ℝ≥0∞,
      Ctot = (CT : ℝ≥0∞) + H * CT + ENNReal.ofReal K + C₁ * H := ⟨_, rfl⟩
  have hCtot : Ctot ≠ ∞ := by
    rw [hCtotdef]
    exact ENNReal.add_ne_top.2 ⟨ENNReal.add_ne_top.2 ⟨ENNReal.add_ne_top.2
      ⟨ENNReal.coe_ne_top, ENNReal.mul_ne_top hH ENNReal.coe_ne_top⟩, ENNReal.ofReal_ne_top⟩,
      ENNReal.mul_ne_top hC₁ hH⟩
  refine ⟨Ctot.toNNReal, fun f => ?_⟩
  rw [ENNReal.coe_toNNReal hCtot]
  obtain ⟨hTm, hTb⟩ := hCT f
  have hFm : AEStronglyMeasurable (fun x => ⨆ (j : ℤ) (u ∈ shortInterval α j),
      ‖∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0)‖ₑ) volume := by
    refine (LowerSemicontinuous.measurable ?_).aestronglyMeasurable
    exact lowerSemicontinuous_iSup fun j => lowerSemicontinuous_biSup fun u hu =>
      (continuous_enorm.comp (hΩ.sw_continuous_small hn hα hu f)).lowerSemicontinuous
  have hpt : ∀ x, (⨆ (j : ℤ) (u ∈ shortInterval α j),
      ‖∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0)‖ₑ) ≤
        ‖modulatedSI n α Ω 0 f x‖ₑ + lpMaximal (fun z => modulatedSI n α Ω 0 f z) x +
          ∑' m, ljSq n (swD n Ω m) f x + C₁ * lpMaximal f x := by
    intro x
    refine iSup_le fun j => iSup₂_le fun u hu => ?_
    rw [hC₁def]
    exact hΩ.sw_enorm_small_le hn hC0 hC hα hu f x
  have hMf : AEMeasurable (lpMaximal (f : Rn n → ℂ)) :=
    (sw_measurable_lpMaximal f.continuous.aestronglyMeasurable).aemeasurable
  calc eLpNorm (fun x => ⨆ (j : ℤ) (u ∈ shortInterval α j),
        ‖∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0)‖ₑ)
        (ENNReal.ofReal p) volume
      ≤ eLpNorm (fun x => ‖modulatedSI n α Ω 0 f x‖ₑ +
          lpMaximal (fun z => modulatedSI n α Ω 0 f z) x +
          ∑' m, ljSq n (swD n Ω m) f x + C₁ * lpMaximal f x) (ENNReal.ofReal p) volume :=
        eLpNorm_mono_enorm hFm fun x => by rw [enorm_eq_self, enorm_eq_self]; exact hpt x
    _ ≤ eLpNorm (fun x => ‖modulatedSI n α Ω 0 f x‖ₑ +
          lpMaximal (fun z => modulatedSI n α Ω 0 f z) x +
          ∑' m, ljSq n (swD n Ω m) f x) (ENNReal.ofReal p) volume +
        eLpNorm (fun x => C₁ * lpMaximal f x) (ENNReal.ofReal p) volume := eLpNorm_add_le hp1
    _ ≤ eLpNorm (fun x => ‖modulatedSI n α Ω 0 f x‖ₑ) (ENNReal.ofReal p) volume +
        eLpNorm (lpMaximal (fun z => modulatedSI n α Ω 0 f z)) (ENNReal.ofReal p) volume +
        eLpNorm (fun x => ∑' m, ljSq n (swD n Ω m) f x) (ENNReal.ofReal p) volume +
        eLpNorm (fun x => C₁ * lpMaximal f x) (ENNReal.ofReal p) volume := by
      gcongr
      exact (eLpNorm_add_le (f := fun x : Rn n => ‖modulatedSI n α Ω 0 f x‖ₑ +
        lpMaximal (fun z => modulatedSI n α Ω 0 f z) x)
        (g := fun x => ∑' m, ljSq n (swD n Ω m) f x) hp1).trans
        (add_le_add_left (eLpNorm_add_le (f := fun x : Rn n => ‖modulatedSI n α Ω 0 f x‖ₑ)
          (g := lpMaximal (fun z => modulatedSI n α Ω 0 f z)) hp1) _)
    _ ≤ CT * eLpNorm f (ENNReal.ofReal p) volume +
        H * (CT * eLpNorm f (ENNReal.ofReal p) volume) +
        ENNReal.ofReal K * eLpNorm f (ENNReal.ofReal p) volume +
        C₁ * (H * eLpNorm f (ENNReal.ofReal p) volume) := by
      gcongr
      · rw [eLpNorm_enorm _ hTm.aestronglyMeasurable]; exact hTb
      · rw [hHdef]
        exact (sw_eLpNorm_lpMaximal_le hp hTm.aestronglyMeasurable).trans (by gcongr)
      · exact hK f
      · rw [lj_eLpNorm_const_mul _ hMf hp0, hHdef]
        gcongr
        exact sw_eLpNorm_lpMaximal_le hp f.continuous.aestronglyMeasurable
    _ = Ctot * eLpNorm f (ENNReal.ofReal p) volume := by
      rw [hCtotdef]; ring

end SteinWaingerSmall

/-! ## Proposition 1.5 at small `p`: interpolation with the oscillation bound

Section 1.2 of the paper (Outline of the proof, sentence after Proposition 1.5 (`main2`)):
"By interpolation with the inequality (1.5) of Stein and Wainger, it suffices to consider the case
`p ∈ (2n/(2n-1), ∞)`". Following the route of `automation/instructions.md` (item 5), the complex
interpolation of `ℓ^r(V^r)`-valued operators is replaced by the pointwise bound
`S_r ≤ S_{r₀}^{r₀/r} (sup_j V^∞_{J_j})^{1-r₀/r}`, Hölder's inequality (restricted strong type) and
the restricted-type Marcinkiewicz theorem `eLpNorm_le_of_restrictedType`. -/

/-- Subtracting a constant does not change the oscillation `V^∞_𝒥`. -/
theorem oscillation_sub_const (𝒥 : Set ℝ) (a : ℝ → ℂ) (c : ℂ) :
    oscillation 𝒥 (fun u => a u - c) = oscillation 𝒥 a := by
  simp [oscillation, sub_sub_sub_cancel_right]

/-- **Lower semicontinuity of the oscillation** under pointwise convergence on `𝒥`. -/
theorem oscillation_le_liminf {𝒥 : Set ℝ} {a : ℝ → ℂ} {b : ℕ → ℝ → ℂ}
    (h : ∀ u ∈ 𝒥, Tendsto (fun m => b m u) atTop (𝓝 (a u))) :
    oscillation 𝒥 a ≤ liminf (fun m => oscillation 𝒥 (b m)) atTop := by
  refine iSup₂_le fun u hu => iSup₂_le fun v hv => ?_
  have hlim : Tendsto (fun m => ‖b m u - b m v‖ₑ) atTop (𝓝 ‖a u - a v‖ₑ) :=
    (continuous_enorm.tendsto _).comp ((h u hu).sub (h v hv))
  rw [← hlim.liminf_eq]
  exact liminf_le_liminf (Eventually.of_forall fun m => enorm_sub_le_oscillation hu hv)

/-- Lower semicontinuity of the short oscillation `sup_j V^∞_{J_j}` under pointwise
convergence. -/
theorem iSup_oscillation_le_liminf {α : ℝ} {a : ℝ → ℂ} {b : ℕ → ℝ → ℂ}
    (h : ∀ u, Tendsto (fun m => b m u) atTop (𝓝 (a u))) :
    ⨆ j, oscillation (shortInterval α j) a ≤
      liminf (fun m => ⨆ j, oscillation (shortInterval α j) (b m)) atTop := by
  refine iSup_le fun j => (oscillation_le_liminf fun u _ => h u).trans ?_
  exact liminf_le_liminf (Eventually.of_forall fun m => le_iSup
    (fun j => oscillation (shortInterval α j) (b m)) j)

/-- For continuous `a` and `𝒥` contained in the closure of its rational points, the
oscillation is a supremum over rational points. -/
theorem oscillation_eq_iSup_ratCast {𝒥 : Set ℝ} {a : ℝ → ℂ} (ha : Continuous a)
    (h𝒥 : 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) :
    oscillation 𝒥 a = ⨆ (u : ℚ) (_ : (u : ℝ) ∈ 𝒥) (v : ℚ) (_ : (v : ℝ) ∈ 𝒥),
      ‖a u - a v‖ₑ := by
  set M := ⨆ (u : ℚ) (_ : (u : ℝ) ∈ 𝒥) (v : ℚ) (_ : (v : ℝ) ∈ 𝒥), ‖a u - a v‖ₑ
  refine le_antisymm ?_ (iSup₂_le fun u hu => iSup₂_le fun v hv =>
    enorm_sub_le_oscillation hu hv)
  have hcl : ∀ w : ℝ, IsClosed {u : ℝ | ‖a u - a w‖ₑ ≤ M} := fun w =>
    isClosed_le (continuous_enorm.comp (ha.sub continuous_const)) continuous_const
  have hcl' : ∀ u : ℝ, IsClosed {v : ℝ | ‖a u - a v‖ₑ ≤ M} := fun u =>
    isClosed_le (continuous_enorm.comp (continuous_const.sub ha)) continuous_const
  have step1 : ∀ v : ℚ, (v : ℝ) ∈ 𝒥 → ∀ u ∈ 𝒥, ‖a u - a v‖ₑ ≤ M := by
    intro v hv
    have : 𝒥 ∩ range ((↑) : ℚ → ℝ) ⊆ {u : ℝ | ‖a u - a v‖ₑ ≤ M} := by
      rintro _ ⟨hu, q, rfl⟩
      change ‖a q - a v‖ₑ ≤ M
      exact le_iSup₂_of_le (f := fun (u : ℚ) (_ : (u : ℝ) ∈ 𝒥) =>
        ⨆ (v : ℚ) (_ : (v : ℝ) ∈ 𝒥), ‖a u - a v‖ₑ) q hu
        (le_iSup₂_of_le (f := fun (v : ℚ) (_ : (v : ℝ) ∈ 𝒥) => ‖a q - a v‖ₑ) v hv le_rfl)
    exact fun u hu => (hcl v).closure_subset_iff.2 this (h𝒥 hu)
  refine iSup₂_le fun u hu => iSup₂_le fun v hv => ?_
  have : 𝒥 ∩ range ((↑) : ℚ → ℝ) ⊆ {v : ℝ | ‖a u - a v‖ₑ ≤ M} := by
    rintro _ ⟨hv, q, rfl⟩
    exact step1 q hv u hu
  exact (hcl' u).closure_subset_iff.2 this (h𝒥 hv)

/-- Measurability of `x ↦ sup_j V^∞_{J_j}(A x)` for families continuous in `u` (`α > 0`). -/
theorem measurable_iSup_oscillation {X : Type*} [MeasurableSpace X] {A : X → ℝ → ℂ}
    (hA : ∀ u, Measurable fun x => A x u) (hc : ∀ x, Continuous (A x)) {α : ℝ} (hα : 0 < α) :
    Measurable fun x => ⨆ j, oscillation (shortInterval α j) (A x) := by
  refine Measurable.iSup fun j => ?_
  simp_rw [oscillation_eq_iSup_ratCast (hc _) (shortInterval_subset_closure hα j)]
  refine Measurable.iSup fun u => Measurable.iSup fun _ => Measurable.iSup fun v =>
    Measurable.iSup fun _ => ?_
  exact ((hA u).sub (hA v)).enorm

/-- The short variation of the zero family vanishes. -/
theorem shortVariation_zero {r : ℝ} (hr : 0 < r) (α : ℝ) :
    shortVariation r α (fun _ => 0) = 0 := by
  have h0 : ∀ 𝒥, variationNorm r 𝒥 (fun _ => (0 : ℂ)) = 0 := fun 𝒥 =>
    le_antisymm (variationNorm_le fun J u _ _ => by
      simp [ENNReal.zero_rpow_of_pos hr, hr]) bot_le
  simp [shortVariation, h0, ENNReal.zero_rpow_of_pos hr, hr]

/-- **Minkowski's inequality** for the short variation: `S_r(a + b) ≤ S_r a + S_r b`,
`r ≥ 1`. -/
theorem shortVariation_add_le {r : ℝ} (hr : 1 ≤ r) (α : ℝ) (a b : ℝ → ℂ) :
    shortVariation r α (a + b) ≤ shortVariation r α a + shortVariation r α b := by
  have hr0 : 0 < r := by linarith
  unfold shortVariation
  calc (∑' j : ℤ, variationNorm r (shortInterval α j) (a + b) ^ r) ^ (1 / r)
      ≤ (∑' j : ℤ, (variationNorm r (shortInterval α j) a +
          variationNorm r (shortInterval α j) b) ^ r) ^ (1 / r) := by
        gcongr with j
        exact variationNorm_add_le hr _ a b
    _ ≤ _ := by
        have := ENNReal.lintegral_Lp_add_le (μ := Measure.count)
          (f := fun j : ℤ => variationNorm r (shortInterval α j) a)
          (g := fun j : ℤ => variationNorm r (shortInterval α j) b)
          (measurable_of_countable _).aemeasurable (measurable_of_countable _).aemeasurable hr
        simpa only [lintegral_count, Pi.add_apply] using this

/-- Finite Minkowski inequality for the short variation (`r ≥ 1`). -/
theorem shortVariation_sum_le {r : ℝ} (hr : 1 ≤ r) (α : ℝ) {ι : Type*} (s : Finset ι)
    (a : ι → ℝ → ℂ) :
    shortVariation r α (fun u => ∑ k ∈ s, a k u) ≤ ∑ k ∈ s, shortVariation r α (a k) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [shortVariation_zero (by linarith : (0 : ℝ) < r)]
  | insert k s hk ih =>
    simp_rw [Finset.sum_insert hk]
    exact (shortVariation_add_le hr α (a k) (fun u => ∑ k ∈ s, a k u)).trans
      (add_le_add le_rfl ih)

/-- **Countable Minkowski inequality** for the short variation: if `b_u = ∑_k a_{k,u}` for
every `u`, then `S_r b ≤ ∑_k S_r a_k` (`r ≥ 1`; finite Minkowski and lower semicontinuity). -/
theorem shortVariation_le_tsum_of_hasSum {r : ℝ} (hr : 1 ≤ r) (α : ℝ) {a : ℤ → ℝ → ℂ}
    {b : ℝ → ℂ} (h : ∀ u, HasSum (fun k => a k u) (b u)) :
    shortVariation r α b ≤ ∑' k, shortVariation r α (a k) := by
  set s : ℕ → Finset ℤ := fun N => Finset.Icc (-(N : ℤ)) N
  have hs : Tendsto s atTop atTop := by
    refine Filter.tendsto_atTop_finset_of_monotone (fun N M hNM => ?_) fun k => ?_
    · exact Finset.Icc_subset_Icc (by simp [hNM]) (by simp [hNM])
    · refine ⟨k.natAbs, ?_⟩
      simp only [s, Finset.mem_Icc]
      omega
  refine (shortVariation_le_liminf (by linarith) α (b := fun N u => ∑ k ∈ s N, a k u)
    fun u => (h u).comp hs).trans ?_
  refine liminf_le_of_le (by isBoundedDefault) fun y hy => ?_
  obtain ⟨N, hN⟩ := hy.exists
  exact hN.trans ((shortVariation_sum_le hr α _ a).trans (ENNReal.sum_le_tsum _))

/-- **Hölder's inequality** in the form
`‖F^θ G^{1-θ}‖_q ≤ ‖F‖_{q₀}^θ ‖G‖_{q₁}^{1-θ}` for `1/q = θ/q₀ + (1-θ)/q₁`, `0 < θ < 1`. -/
theorem eLpNorm_rpow_mul_rpow_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F G : X → ℝ≥0∞} (hF : AEMeasurable F μ) (hG : AEMeasurable G μ) {q q₀ q₁ θ : ℝ}
    (hq : 0 < q) (hq₀ : 0 < q₀) (hq₁ : 0 < q₁) (hθ0 : 0 < θ) (hθ1 : θ < 1)
    (hθ : 1 / q = θ / q₀ + (1 - θ) / q₁) :
    eLpNorm (fun x => F x ^ θ * G x ^ (1 - θ)) (ENNReal.ofReal q) μ ≤
      eLpNorm F (ENNReal.ofReal q₀) μ ^ θ * eLpNorm G (ENNReal.ofReal q₁) μ ^ (1 - θ) := by
  have hne : ∀ s : ℝ, 0 < s → ENNReal.ofReal s ≠ 0 := fun s hs => by simpa using hs
  have hθ1' : 0 < 1 - θ := by linarith
  have hFG : AEMeasurable (fun x => F x ^ θ * G x ^ (1 - θ)) μ :=
    (hF.pow_const θ).mul (hG.pow_const (1 - θ))
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (hne q hq) ENNReal.ofReal_ne_top
      hFG.aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (hne q₀ hq₀) ENNReal.ofReal_ne_top
      hF.aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (hne q₁ hq₁) ENNReal.ofReal_ne_top
      hG.aestronglyMeasurable, ENNReal.toReal_ofReal hq.le, ENNReal.toReal_ofReal hq₀.le,
    ENNReal.toReal_ofReal hq₁.le]
  simp only [enorm_eq_self]
  set a := q₀ / (θ * q)
  set b := q₁ / ((1 - θ) * q)
  have hsplit : θ * q / q₀ + (1 - θ) * q / q₁ = 1 := by
    have : θ * q / q₀ + (1 - θ) * q / q₁ = q * (θ / q₀ + (1 - θ) / q₁) := by ring
    rw [this, ← hθ]; field_simp
  have h1 : (1 - θ) * q / q₁ > 0 := by positivity
  have hab : a.HolderConjugate b := by
    rw [Real.holderConjugate_iff]
    refine ⟨?_, ?_⟩
    · rw [show a = (θ * q / q₀)⁻¹ by simp [a]]
      exact one_lt_inv₀ (by positivity) |>.2 (by linarith)
    · simp only [a, b, inv_div]; exact hsplit
  have hpt : ∀ x, (F x ^ θ * G x ^ (1 - θ)) ^ q = F x ^ (θ * q) * G x ^ ((1 - θ) * q) := by
    intro x
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
  simp_rw [hpt]
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hab (hF.pow_const (θ * q))
    (hG.pow_const ((1 - θ) * q))
  simp only [Pi.mul_apply, ← ENNReal.rpow_mul] at hH
  have ha : θ * q * a = q₀ := by simp only [a]; field_simp
  have hb : (1 - θ) * q * b = q₁ := by simp only [b]; field_simp
  rw [ha, hb] at hH
  calc (∫⁻ x, F x ^ (θ * q) * G x ^ ((1 - θ) * q) ∂μ) ^ (1 / q)
      ≤ ((∫⁻ x, F x ^ q₀ ∂μ) ^ (1 / a) * (∫⁻ x, G x ^ q₁ ∂μ) ^ (1 / b)) ^ (1 / q) := by
        gcongr
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
        congr 2
        · simp only [a]; field_simp
        · simp only [b]; field_simp

/-- The arithmetic identity
`(C₀ c m^{1/q₀})^θ (C₁ c m^{1/q₁})^{1-θ} = C₀^θ C₁^{1-θ} c m^{1/q}` for
`1/q = θ/q₀ + (1-θ)/q₁`. -/
theorem ennreal_interp_identity {C₀ C₁ c m : ℝ≥0∞} {θ q q₀ q₁ : ℝ} (hθ0 : 0 < θ) (hθ1 : θ < 1)
    (hq₀ : 0 < q₀) (hq₁ : 0 < q₁) (hθ : 1 / q = θ / q₀ + (1 - θ) / q₁) :
    (C₀ * (c * m ^ (1 / q₀))) ^ θ * (C₁ * (c * m ^ (1 / q₁))) ^ (1 - θ) =
      C₀ ^ θ * C₁ ^ (1 - θ) * c * m ^ (1 / q) := by
  have h1 : 0 ≤ 1 - θ := by linarith
  have hc : c ^ θ * c ^ (1 - θ) = c := by
    rw [← ENNReal.rpow_add_of_nonneg _ _ hθ0.le h1]; simp
  have hm : m ^ (1 / q) = m ^ (1 / q₀ * θ) * m ^ (1 / q₁ * (1 - θ)) := by
    rw [show 1 / q = 1 / q₀ * θ + 1 / q₁ * (1 - θ) by rw [hθ]; ring,
      ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity)]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hθ0.le, ENNReal.mul_rpow_of_nonneg _ _ hθ0.le,
    ENNReal.mul_rpow_of_nonneg _ _ h1, ENNReal.mul_rpow_of_nonneg _ _ h1, ← ENNReal.rpow_mul,
    ← ENNReal.rpow_mul, hm]
  calc _ = C₀ ^ θ * C₁ ^ (1 - θ) * (c ^ θ * c ^ (1 - θ)) *
        (m ^ (1 / q₀ * θ) * m ^ (1 / q₁ * (1 - θ))) := by ring
    _ = _ := by rw [hc]

section ModulatedDiffOsc

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- **Shift invariance** of the short oscillation: for Schwartz `f`, the oscillations of
`u ↦ (𝓗^{(u)} - 𝓗^{(v)}) f(x)` and of `u ↦ 𝓗^{(u)} f(x)` agree. -/
theorem IsHomogeneousCZKernel.iSup_oscillation_modulatedDiff (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (v : ℝ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    ⨆ j, oscillation (shortInterval α j) (fun u => modulatedDiff n α Ω u v f x) =
      ⨆ j, oscillation (shortInterval α j) (fun u => modulatedSI n α Ω u f x) := by
  simp_rw [hΩ.modulatedDiff_eq_sub hn hα]
  exact iSup_congr fun j => oscillation_sub_const _ _ _

/-- Measurability of `x ↦ sup_j V^∞_{J_j}{(𝓗^{(u)} - 𝓗^{(v)}) f(x)}` for `f ∈ L^p`, `1 < p`. -/
theorem IsHomogeneousCZKernel.aemeasurable_iSup_oscillation_modulatedDiff
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) (v : ℝ) :
    AEMeasurable fun x =>
      ⨆ j, oscillation (shortInterval α j) (fun u => modulatedDiff n α Ω u v f x) := by
  have hA : ∀ u, Measurable fun x => modulatedDiff n α Ω u v f x := fun u =>
    (hΩ.stronglyMeasurable_modulatedDiff α u v hf.aestronglyMeasurable).measurable
  exact aemeasurable_comp_of_ae_continuous (A := fun x u => modulatedDiff n α Ω u v f x) hA
    ((hΩ.ae_continuous_modulatedDiff hn hα hp hf).mono fun x hx => hx v)
    (fun a => ⨆ j, oscillation (shortInterval α j) a)
    fun B hB hBc => measurable_iSup_oscillation hB hBc hα

/-- **Extension of oscillation bounds to `L^p`**: if
`‖sup_j V^∞_{J_j}(𝓗 g)‖_p ≤ C ‖g‖_p` for Schwartz `g`, then the same bound holds for the
difference operators `𝓗^{(u)} - 𝓗^{(v)}` applied to any `f ∈ L^p` (`1 < p < ∞`). -/
theorem IsHomogeneousCZKernel.eLpNorm_iSup_oscillation_modulatedDiff_le
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p)
    (v : ℝ) {C : ℝ≥0∞} (hC : C ≠ ∞)
    (hbound : ∀ g : 𝓢(Rn n, ℂ), eLpNorm (fun x =>
      ⨆ j, oscillation (shortInterval α j) (fun u => modulatedSI n α Ω u g x))
        (ENNReal.ofReal p) ≤ C * eLpNorm g (ENNReal.ofReal p))
    {f : Rn n → ℂ} (hf : MemLp f (ENNReal.ofReal p)) :
    eLpNorm (fun x => ⨆ j, oscillation (shortInterval α j)
      (fun u => modulatedDiff n α Ω u v f x)) (ENNReal.ofReal p) ≤
        C * eLpNorm f (ENNReal.ofReal p) := by
  refine eLpNorm_le_of_forall_schwartz hp.le (fun h x =>
    ⨆ j, oscillation (shortInterval α j) (fun u => modulatedDiff n α Ω u v h x)) hC
    (fun g => hΩ.aemeasurable_iSup_oscillation_modulatedDiff hn hα hp (g.memLp _) v)
    (fun g => ?_) hf (hΩ.aemeasurable_iSup_oscillation_modulatedDiff hn hα hp hf v)
    (fun g hg => ?_)
  · simp_rw [hΩ.iSup_oscillation_modulatedDiff hn hα]
    exact hbound g
  · obtain ⟨φ, hφ, hae⟩ := hΩ.exists_subseq_tendsto_modulatedDiff hn hα hp hf
      (fun m => (g m).memLp _) hg
    refine ⟨φ, hφ, ?_⟩
    filter_upwards [hae] with x hx
    exact iSup_oscillation_le_liminf fun u => hx u v

/-- For disjointly supported `F_k`, `∑_k |F_k(y)| = |∑_k F_k(y)|`. -/
theorem tsum_enorm_eq_of_disjoint {X : Type*} {F : ℤ → X → ℂ}
    (hd : Pairwise fun i j => Disjoint (Function.support (F i)) (Function.support (F j)))
    (y : X) : ∑' k, ‖F k y‖ₑ = ‖∑' k, F k y‖ₑ := by
  by_cases h : ∃ k₀, F k₀ y ≠ 0
  · obtain ⟨k₀, hk₀⟩ := h
    have hz : ∀ k, k ≠ k₀ → F k y = 0 := fun k hk => by
      by_contra hne
      exact Set.disjoint_left.1 (hd hk) hne hk₀
    rw [tsum_eq_single k₀ fun k hk => by simp [hz k hk], tsum_eq_single k₀ hz]
  · push Not at h
    simp [h]

/-- **Countable additivity** of the difference operators on disjointly supported
decompositions `f = ∑_k F_k` in `L^p` (`1 < p`): for a.e. `x`, simultaneously for all `u, v`,
`(𝓗^{(u)} - 𝓗^{(v)}) f(x) = ∑_k (𝓗^{(u)} - 𝓗^{(v)}) F_k(x)` (absolutely convergent). -/
theorem IsHomogeneousCZKernel.ae_hasSum_modulatedDiff (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {p : ℝ} (hp : 1 < p) {f : Rn n → ℂ}
    (hf : MemLp f (ENNReal.ofReal p)) {F : ℤ → Rn n → ℂ} (hF : ∀ k, MemLp (F k) (ENNReal.ofReal p))
    (hd : Pairwise fun i j => Disjoint (Function.support (F i)) (Function.support (F j)))
    (hsum : ∀ x, f x = ∑' k, F k x) :
    ∀ᵐ x, ∀ u v, HasSum (fun k => modulatedDiff n α Ω u v (F k) x)
      (modulatedDiff n α Ω u v f x) := by
  filter_upwards [hΩ.ae_integrable_modulatedDiff_integrand hn hα hp hf,
    ae_all_iff.2 fun k => hΩ.ae_integrable_modulatedDiff_integrand hn hα hp (hF k)]
    with x hx hxk u v
  set K := modulatedDiffKernel n α Ω u v
  have hint : ∀ k, Integrable (fun t => F k (x - t) * K t) := fun k => hxk k u v
  have hpt : ∀ t, ∑' k, ‖F k (x - t) * K t‖ₑ = ‖f (x - t) * K t‖ₑ := by
    intro t
    simp_rw [enorm_mul]
    rw [ENNReal.tsum_mul_right, tsum_enorm_eq_of_disjoint hd, ← hsum]
  have hfin : ∑' k, ∫⁻ t, ‖F k (x - t) * K t‖ₑ ≠ ∞ := by
    rw [← lintegral_tsum fun k => (hint k).aestronglyMeasurable.enorm]
    simp_rw [hpt]
    exact (hx u v).2.ne
  have hsumm : Summable fun k => ∫ t, ‖F k (x - t) * K t‖ := by
    simp_rw [integral_norm_eq_lintegral_enorm (hint _).aestronglyMeasurable]
    exact ENNReal.summable_toReal hfin
  have := hasSum_integral_of_summable_integral_norm hint hsumm
  unfold modulatedDiff
  convert this using 2
  funext t
  rw [tsum_mul_right, ← hsum]

end ModulatedDiffOsc
section RestrictedType

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- **Restricted strong type via Hölder** (Prop 1.5 at small `p`, route item 5): if
`S_{r₀}` is bounded on `L^{q₀}` and `sup_j V^∞_{J_j}` on `L^{q₁}` (for the difference operators
`𝓗^{(u)} - 𝓗^{(0)}`), `θ = r₀/r < 1` and `1/q = θ/q₀ + (1-θ)/q₁`, then `g ↦ S_r(𝓗 g)` is of
restricted strong type `(q, q)` with constant `C₀^θ C₁^{1-θ}`: by the pointwise bound
`S_r ≤ S_{r₀}^θ (sup_j V^∞_{J_j})^{1-θ}` (`shortVariation_le_interp`) and Hölder's inequality,
`‖S_r g‖_q ≤ (C₀ ‖g‖_{q₀})^θ (C₁ ‖g‖_{q₁})^{1-θ} ≤ C₀^θ C₁^{1-θ} c |S|^{1/q}` if `|g| ≤ c 𝟙_S`. -/
theorem IsHomogeneousCZKernel.hasRestrictedStrongTypeOn_shortVariation
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {D : Set (Rn n → ℂ)}
    (hDm : ∀ g ∈ D, AEStronglyMeasurable g) {q q₀ q₁ r₀ r θ : ℝ} (hq : 0 < q) (hq₀ : 1 < q₀)
    (hq₁ : 1 < q₁) (hr₀ : 0 < r₀) (hr₀r : r₀ < r)
    (hθr : θ = r₀ / r) (hθ : 1 / q = θ / q₀ + (1 - θ) / q₁) {C₀ C₁ : ℝ≥0}
    (h₀ : ∀ g, MemLp g (ENNReal.ofReal q₀) → eLpNorm (fun x =>
      shortVariation r₀ α (fun u => modulatedDiff n α Ω u 0 g x)) (ENNReal.ofReal q₀) ≤
        C₀ * eLpNorm g (ENNReal.ofReal q₀))
    (h₁ : ∀ g, MemLp g (ENNReal.ofReal q₁) → eLpNorm (fun x => ⨆ j,
      oscillation (shortInterval α j) (fun u => modulatedDiff n α Ω u 0 g x))
        (ENNReal.ofReal q₁) ≤ C₁ * eLpNorm g (ENNReal.ofReal q₁)) :
    HasRestrictedStrongTypeOn
      (fun g x => shortVariation r α (fun u => modulatedDiff n α Ω u 0 g x)) D q
      ((C₀ : ℝ) ^ θ * (C₁ : ℝ) ^ (1 - θ)) volume volume := by
  intro S hS hμS c hc g hgD hgle
  have hr : 0 < r := hr₀.trans hr₀r
  have hθ0 : 0 < θ := hθr ▸ div_pos hr₀ hr
  have hθ1 : θ < 1 := hθr ▸ (div_lt_one hr).2 hr₀r
  have hgm := hDm g hgD
  have hdom : ∀ x, ‖g x‖ ≤ ‖S.indicator (fun _ => c) x‖ := by
    intro x
    refine (hgle x).trans_eq ?_
    by_cases hx : x ∈ S
    · rw [indicator_of_mem hx, indicator_of_mem hx, Real.norm_of_nonneg hc]; simp
    · rw [indicator_of_notMem hx, indicator_of_notMem hx]; simp
  have hmem : ∀ s, MemLp g (ENNReal.ofReal s) := fun s =>
    (memLp_indicator_const _ hS c (Or.inr hμS.ne)).mono hgm (ae_of_all _ hdom)
  have hnorm : ∀ s, 0 < s →
      eLpNorm g (ENNReal.ofReal s) ≤ ENNReal.ofReal c * volume S ^ (1 / s) := by
    intro s hs
    refine (eLpNorm_mono hgm hdom).trans_eq ?_
    rw [eLpNorm_indicator_const hS.nullMeasurableSet (by simpa using hs) ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal hs.le, Real.enorm_eq_ofReal hc]
  have hT := hΩ.aemeasurable_shortVariation_modulatedDiff hn hα (by norm_num : (1 : ℝ) < 2)
    (hmem 2) r 0
  have hS0 := hΩ.aemeasurable_shortVariation_modulatedDiff hn hα hq₀ (hmem q₀) r₀ 0
  have hO := hΩ.aemeasurable_iSup_oscillation_modulatedDiff hn hα hq₁ (hmem q₁) 0
  have hq0' : 0 < q₀ := by linarith
  have hq1' : 0 < q₁ := by linarith
  have key := eLpNorm_rpow_mul_rpow_le hS0 hO hq hq0' hq1' hθ0 hθ1 hθ
  calc eLpNorm (fun x => shortVariation r α (fun u => modulatedDiff n α Ω u 0 g x))
        (ENNReal.ofReal q)
      ≤ eLpNorm (fun x => shortVariation r₀ α (fun u => modulatedDiff n α Ω u 0 g x) ^ θ *
          (⨆ j, oscillation (shortInterval α j) (fun u => modulatedDiff n α Ω u 0 g x)) ^
            (1 - θ)) (ENNReal.ofReal q) := by
        refine eLpNorm_mono_enorm hT.aestronglyMeasurable fun x => ?_
        simp only [enorm_eq_self]
        rw [hθr]
        exact shortVariation_le_interp hr₀ hr₀r.le α _
    _ ≤ eLpNorm (fun x => shortVariation r₀ α (fun u => modulatedDiff n α Ω u 0 g x))
          (ENNReal.ofReal q₀) ^ θ * eLpNorm (fun x => ⨆ j, oscillation (shortInterval α j)
            (fun u => modulatedDiff n α Ω u 0 g x)) (ENNReal.ofReal q₁) ^ (1 - θ) :=
        key
    _ ≤ (C₀ * (ENNReal.ofReal c * volume S ^ (1 / q₀))) ^ θ *
          (C₁ * (ENNReal.ofReal c * volume S ^ (1 / q₁))) ^ (1 - θ) := by
        gcongr
        · exact (h₀ g (hmem _)).trans (by gcongr; exact hnorm q₀ hq0')
        · exact (h₁ g (hmem _)).trans (by gcongr; exact hnorm q₁ hq1')
    _ = (C₀ : ℝ≥0∞) ^ θ * (C₁ : ℝ≥0∞) ^ (1 - θ) * ENNReal.ofReal c * volume S ^ (1 / q) :=
        ennreal_interp_identity hθ0 hθ1 hq0' hq1' hθ
    _ = ENNReal.ofReal ((C₀ : ℝ) ^ θ * (C₁ : ℝ) ^ (1 - θ) * c) * volume S ^ (1 / q) := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_rpow_of_nonneg (by positivity) hθ0.le,
          ← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by linarith),
          ENNReal.ofReal_coe_nnreal, ENNReal.ofReal_coe_nnreal]

end RestrictedType
section Interpolation

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The class `L^{q₀} ∩ L^{q₁}` is closed under level truncations. -/
theorem isLevelTruncationClosed_memLp_inter (q₀ q₁ : ℝ≥0∞) :
    IsLevelTruncationClosed {f : Rn n → ℂ | MemLp f q₀ ∧ MemLp f q₁} := by
  intro f hf s t _ _
  have heq : (fun x => if s < ‖f x‖ ∧ ‖f x‖ ≤ t then f x else 0) =
      {x | s < ‖f x‖ ∧ ‖f x‖ ≤ t}.indicator f := by
    funext x; simp only [indicator_apply, mem_ofPred_eq]
  have hm : AEStronglyMeasurable (fun x => if s < ‖f x‖ ∧ ‖f x‖ ≤ t then f x else 0) := by
    rw [heq]
    exact hf.1.aestronglyMeasurable.indicator₀
      ((nullMeasurableSet_lt aemeasurable_const hf.1.aestronglyMeasurable.norm.aemeasurable).inter
        (nullMeasurableSet_le hf.1.aestronglyMeasurable.norm.aemeasurable aemeasurable_const))
  have hle : ∀ x, ‖(if s < ‖f x‖ ∧ ‖f x‖ ≤ t then f x else 0)‖ ≤ ‖f x‖ := fun x => by
    split_ifs <;> simp
  exact ⟨hf.1.mono hm (ae_of_all _ hle), hf.2.mono hm (ae_of_all _ hle)⟩


/-- **Proposition 1.5 (`main2`) at small `p`, by interpolation** (Section 1.2, sentence after
Proposition 1.5: "By interpolation with the inequality (1.5) of Stein and Wainger, it suffices to
consider the case `p ∈ (2n/(2n-1), ∞)`"). Let `1 < p_A`, `1 ≤ r_A` (the corner point). Assume
`‖S_{r₀}(𝓗f)‖_{p₀} ≲ ‖f‖_{p₀}` for all `p₀ > p_A`, `r₀ > r_A` (`h0`), and
`‖sup_j V^∞_{J_j}(𝓗f)‖_{p₁} ≲ ‖f‖_{p₁}` for all `p₁ ∈ (1, ∞)` (`h1`, a consequence of the
Stein–Wainger estimate (1.5)), for Schwartz `f`. Then `‖S_r(𝓗f)‖_p ≲ ‖f‖_p` for all
`1 < p < ∞` and `r > r_A` with `(1 - 1/p_A) r_A < (1 - 1/p) r`, i.e. `r > max(r_A, r_A p'/p_A')`
(the open region spanned by the points `(1/p₀, 1/r₀)` and `(1/p₁, 0)`). For `p > p_A` this is
`h0`. For `p ≤ p_A` choose `r₀ = r_A + ε`, `1/p₀ = 1/p_A - ε`, `θ = r₀/r` with
`r₀ (1 - 1/p₀) < r (1 - 1/p)`; then `1/p ∈ (θ/p₀, 1 - θ(1 - 1/p₀))`, so restricted strong type
holds at two exponents `p_a < p < p_b` (`hasRestrictedStrongTypeOn_shortVariation`), and
`eLpNorm_le_of_restrictedType` applies on the class `L^{p_a} ∩ L^{p_b}`, using countable
additivity of the difference operators and the countable Minkowski inequality for `S_r`.
Application: `n ≥ 2`, `p_A = 2n/(2n-1)`, `r_A = 2` gives `r > max(2, p'/n)`; `n = 1`,
`p_A = r_A = 2` gives `r > max(2, p')`. -/
theorem IsHomogeneousCZKernel.shortVariation_bound_of_interpolation
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {pA rA : ℝ}
    (hpA : 1 < pA) (hrA : 1 ≤ rA)
    (h0 : ∀ p₀ r₀ : ℝ, pA < p₀ → rA < r₀ → ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => shortVariation r₀ α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p₀) ≤ C * eLpNorm f (ENNReal.ofReal p₀))
    (h1 : ∀ p₁ : ℝ, 1 < p₁ → ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => ⨆ j, oscillation (shortInterval α j)
        (fun u => modulatedSI n α Ω u f x)) (ENNReal.ofReal p₁) ≤
          C * eLpNorm f (ENNReal.ofReal p₁))
    {p r : ℝ} (hp : 1 < p) (hr : rA < r) (hpr : (1 - 1 / pA) * rA < (1 - 1 / p) * r) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  have hα0 : 0 < α := by linarith
  rcases lt_or_ge pA p with hpp | hpp
  · exact h0 p r hpp hr
  set s := 1 / p with hsdef
  set sA := 1 / pA with hsAdef
  have hs0 : 0 < s := by positivity
  have hs1 : s < 1 := by rw [hsdef, div_lt_one (by linarith)]; exact hp
  have hsA0 : 0 < sA := by positivity
  have hsAs : sA ≤ s := one_div_le_one_div_of_le (by linarith) hpp
  -- choice of the corner point `(1/p₀, 1/r₀)`
  obtain ⟨e, he1, he2, he3, he4⟩ : ∃ e : ℝ, (rA + e) * (1 - sA + e) < (1 - s) * r ∧
      e < r - rA ∧ e < sA ∧ 0 < e := by
    have hlim : Tendsto (fun e : ℝ => (rA + e) * (1 - sA + e)) (𝓝[>] 0)
        (𝓝 ((rA + 0) * (1 - sA + 0))) :=
      (((continuous_const.add continuous_id).mul
        (continuous_const.add continuous_id)).tendsto 0).mono_left nhdsWithin_le_nhds
    have h1' : (rA + 0) * (1 - sA + 0) < (1 - s) * r := by
      simp only [add_zero]; linarith
    have ev1 := hlim.eventually (eventually_lt_nhds h1')
    have ev2 : ∀ᶠ e in 𝓝[>] (0 : ℝ), e < r - rA :=
      (eventually_lt_nhds (sub_pos.2 hr)).filter_mono nhdsWithin_le_nhds
    have ev3 : ∀ᶠ e in 𝓝[>] (0 : ℝ), e < sA :=
      (eventually_lt_nhds hsA0).filter_mono nhdsWithin_le_nhds
    have ev4 : ∀ᶠ e in 𝓝[>] (0 : ℝ), 0 < e := self_mem_nhdsWithin
    exact (ev1.and (ev2.and (ev3.and ev4))).exists
  set r₀ := rA + e with hr₀def
  set s₀ := sA - e with hs₀def
  set θ := r₀ / r with hθdef
  have hr0 : 0 < r := by linarith
  have hr₀pos : 0 < r₀ := by linarith
  have hr₀r : r₀ < r := by linarith
  have hs₀0 : 0 < s₀ := by linarith
  have hθ0 : 0 < θ := div_pos hr₀pos hr0
  have hθ1 : θ < 1 := (div_lt_one hr0).2 hr₀r
  have hL : θ * s₀ < s := by nlinarith
  have hU : s < 1 - θ * (1 - s₀) := by
    have : θ * (1 - s₀) = r₀ * (1 - sA + e) / r := by rw [hθdef, hs₀def]; ring
    rw [this, lt_sub_iff_add_lt, ← lt_sub_iff_add_lt', div_lt_iff₀ hr0]
    linarith
  have hp₀ : pA < 1 / s₀ := by
    rw [hsAdef] at hs₀def
    rw [lt_one_div (by linarith) hs₀0]
    linarith
  obtain ⟨C₀, hC₀⟩ := h0 (1 / s₀) r₀ hp₀ (by linarith)
  have H0 : ∀ g, MemLp g (ENNReal.ofReal (1 / s₀)) → eLpNorm (fun x =>
      shortVariation r₀ α (fun u => modulatedDiff n α Ω u 0 g x)) (ENNReal.ofReal (1 / s₀)) ≤
        ((C₀ + 1 : ℝ≥0) : ℝ≥0∞) * eLpNorm g (ENNReal.ofReal (1 / s₀)) := fun g hg =>
    hΩ.eLpNorm_shortVariation_modulatedDiff_le hn hα0 (hpA.trans hp₀) hr₀pos 0
      ENNReal.coe_ne_top
      (fun g => (hΩ.measurable_shortVariation_modulatedSI hn hα0 g r₀).aemeasurable)
      (fun g => (hC₀ g).trans (by gcongr; exact le_self_add)) hg
  -- the two auxiliary exponents `1/sa < p < 1/sb`
  set sa := (s + (1 - θ * (1 - s₀))) / 2 with hsadef
  set sb := (θ * s₀ + s) / 2 with hsbdef
  have hsa1 : sa < 1 := by nlinarith
  have hsb0 : 0 < sb := by positivity
  set D : Set (Rn n → ℂ) :=
    {g | MemLp g (ENNReal.ofReal (1 / sa)) ∧ MemLp g (ENNReal.ofReal (1 / sb))}
  have hDm : ∀ g ∈ D, AEStronglyMeasurable g := fun g hg => hg.1.aestronglyMeasurable
  have hRT : ∀ s', θ * s₀ < s' → s' < 1 - θ * (1 - s₀) → ∃ M : ℝ, 0 < M ∧
      HasRestrictedStrongTypeOn
        (fun g x => shortVariation r α (fun u => modulatedDiff n α Ω u 0 g x)) D (1 / s') M
        volume volume := by
    intro s' hL' hU'
    set s₁ := (s' - θ * s₀) / (1 - θ) with hs₁def
    have h1θ : 0 < 1 - θ := by linarith
    have hs₁0 : 0 < s₁ := div_pos (by linarith) h1θ
    have hs₁1 : s₁ < 1 := by rw [hs₁def, div_lt_one h1θ]; linarith
    have hq₁ : 1 < 1 / s₁ := by rw [lt_one_div one_pos hs₁0]; simpa using hs₁1
    obtain ⟨C₁, hC₁⟩ := h1 (1 / s₁) hq₁
    have H1 : ∀ g, MemLp g (ENNReal.ofReal (1 / s₁)) → eLpNorm (fun x => ⨆ j,
        oscillation (shortInterval α j) (fun u => modulatedDiff n α Ω u 0 g x))
          (ENNReal.ofReal (1 / s₁)) ≤
            ((C₁ + 1 : ℝ≥0) : ℝ≥0∞) * eLpNorm g (ENNReal.ofReal (1 / s₁)) := fun g hg =>
      hΩ.eLpNorm_iSup_oscillation_modulatedDiff_le hn hα0 hq₁ 0 ENNReal.coe_ne_top
        (fun g => (hC₁ g).trans (by gcongr; exact le_self_add)) hg
    refine ⟨((C₀ + 1 : ℝ≥0) : ℝ) ^ θ * ((C₁ + 1 : ℝ≥0) : ℝ) ^ (1 - θ), by positivity, ?_⟩
    refine hΩ.hasRestrictedStrongTypeOn_shortVariation hn hα0 hDm
      (one_div_pos.2 (lt_trans (by positivity) hL')) (hpA.trans hp₀) hq₁ hr₀pos hr₀r hθdef ?_ H0 H1
    rw [hs₁def]
    field_simp
    ring
  have hssa : s < sa := by linarith
  have hsbs : sb < s := by linarith
  obtain ⟨Ma, hMa, hRa⟩ := hRT sa (by linarith) (by linarith)
  obtain ⟨Mb, hMb, hRb⟩ := hRT sb (by linarith) (by linarith)
  have hqa : 1 < 1 / sa := by rw [lt_one_div one_pos (by linarith)]; simpa using hsa1
  have hsub : IsDisjointSublinearOn
      (fun g x => shortVariation r α (fun u => modulatedDiff n α Ω u 0 g x)) D volume := by
    intro f hf F hF hd hsum
    filter_upwards [hΩ.ae_hasSum_modulatedDiff hn hα0 hqa hf.1 (fun k => (hF k).1) hd hsum]
      with x hx
    exact shortVariation_le_tsum_of_hasSum (by linarith) α fun u => hx u 0
  set θ' := (sa - s) / (sa - sb) with hθ'def
  have hθ' : 1 / p = (1 - θ') / (1 / sa) + θ' / (1 / sb) := by
    have hne : sa - sb ≠ 0 := by linarith
    rw [show 1 / p = s from rfl, hθ'def]
    field_simp
    ring
  refine ⟨(rtiConst (1 / sa) (1 / sb) p * Ma ^ (1 - θ') * Mb ^ θ').toNNReal, fun f => ?_⟩
  have hfD : (⇑f : Rn n → ℂ) ∈ D := ⟨f.memLp _, f.memLp _⟩
  have hplt : 1 / sa < p := by
    rw [one_div_lt (by linarith) (by linarith)]; exact hssa
  have hpgt : p < 1 / sb := by
    rw [lt_one_div (by linarith) hsb0]; exact hsbs
  have key := eLpNorm_le_of_restrictedType (by linarith) hplt hpgt hθ' hMa hMb hDm
    (isLevelTruncationClosed_memLp_inter _ _) hsub hRa hRb hfD
    (hΩ.aemeasurable_shortVariation_modulatedDiff hn hα0 hp (f.memLp _) r 0).aestronglyMeasurable
  have heq : (fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x)) =
      fun x => shortVariation r α (fun u => modulatedDiff n α Ω u 0 f x) :=
    funext fun x => (hΩ.shortVariation_modulatedDiff hn hα0 r 0 f x).symm
  rw [heq]
  exact key

end Interpolation

section Theorem11

/-! ## Theorem 1.1 from the short variation estimates

Theorem 1.1 (`\label{main}`, §1 of arXiv:1710.10988v3) in conditional form: the estimates for
the short variation `S_r(𝓗f)` (Prop 1.5) are assumed, and combined with the reduction to
`u > 0` (conjugation), the long/short splitting (Lemma 1.3, §1.2) and the long variation and
long jump estimates (Prop 1.4, proved in §3). -/

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- Conjugation preserves `L^p` norms: `‖conj f‖_p = ‖f‖_p` (used in §1 of the paper, where
`u < 0` is reduced to `u > 0` via `𝓗^{(-u)} f = conj 𝓗^{(u)} (conj f)`). -/
theorem eLpNorm_conjSchwartz (f : 𝓢(Rn n, ℂ)) (p : ℝ≥0∞) :
    eLpNorm (conjSchwartz f) p volume = eLpNorm f p volume := by
  refine eLpNorm_congr_enorm_ae (conjSchwartz f).continuous.aestronglyMeasurable
    f.continuous.aestronglyMeasurable (Filter.Eventually.of_forall fun x => ?_)
  rw [coe_conjSchwartz]
  exact RCLike.enorm_conj _

/-- Minkowski bookkeeping for Theorem 1.1 (§1.2): if `G ≤ K (a + b) + K (c + d)` pointwise
(`K < ∞`, all functions `[0,∞]`-valued and a.e.-measurable), then
`‖G‖_p ≤ K (‖a‖_p + ‖b‖_p) + K (‖c‖_p + ‖d‖_p)` for `1 < p`. -/
theorem eLpNorm_le_of_le_mul_add_mul {G a b c d : Rn n → ℝ≥0∞} (hG : AEMeasurable G volume)
    (ha : AEMeasurable a volume) (hb : AEMeasurable b volume) (hc : AEMeasurable c volume)
    (hd : AEMeasurable d volume) {K : ℝ≥0∞} (hK : K ≠ ∞) {p : ℝ} (hp : 1 < p)
    (h : ∀ x, G x ≤ K * (a x + b x) + K * (c x + d x)) :
    eLpNorm G (ENNReal.ofReal p) volume ≤
      K * (eLpNorm a (ENNReal.ofReal p) volume + eLpNorm b (ENNReal.ofReal p) volume) +
        K * (eLpNorm c (ENNReal.ofReal p) volume + eLpNorm d (ENNReal.ofReal p) volume) := by
  have hp0 : 0 < p := by linarith
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using hp.le
  calc eLpNorm G (ENNReal.ofReal p) volume
      ≤ eLpNorm (fun x => K * (a x + b x) + K * (c x + d x)) (ENNReal.ofReal p) volume :=
        eLpNorm_mono_enorm hG.aestronglyMeasurable fun x => by simpa [enorm_eq_self] using h x
    _ ≤ eLpNorm (fun x => K * (a x + b x)) (ENNReal.ofReal p) volume +
          eLpNorm (fun x => K * (c x + d x)) (ENNReal.ofReal p) volume := eLpNorm_add_le hp1
    _ = K * eLpNorm (fun x => a x + b x) (ENNReal.ofReal p) volume +
          K * eLpNorm (fun x => c x + d x) (ENNReal.ofReal p) volume := by
        rw [jsw_eLpNorm_const_mul (F := fun x => a x + b x) hK (ha.add hb) hp0,
          jsw_eLpNorm_const_mul (F := fun x => c x + d x) hK (hc.add hd) hp0]
    _ ≤ _ := by
        gcongr
        · exact eLpNorm_add_le hp1
        · exact eLpNorm_add_le hp1

/-- **Theorem 1.1, first part** (§1, `\label{main}`), conditional on the short variation
estimate: for `α > 1`, `1 < p < ∞`, `r > 2`, if `‖S_r(𝓗f)‖_p ≲ ‖f‖_p` for Schwartz `f`
(Prop 1.5, (1.7)), then `‖V^r{𝓗^{(u)} f : u ∈ ℝ}‖_p ≲ ‖f‖_p`. Proof (§1.2): reduce to
`u > 0` by conjugation, split `V^r_{(0,∞)} ≤ 9 (S_r + V^r_{dyad})` (Lemma 1.3) and use the
long variation estimate (Prop 1.4). -/
theorem IsHomogeneousCZKernel.thm_1_1_variation_of_short (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p r : ℝ} (hp : 1 < p) (hr : 2 < r)
    (hS : ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => variationNorm r univ (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume := by
  have hα0 : 0 < α := by linarith
  have hr1 : 1 ≤ r := by linarith
  obtain ⟨CS, hCS⟩ := hS
  obtain ⟨CD, hCD⟩ := hΩ.eLpNorm_variationNorm_dyadicSet_modulatedSI_le hn hα hp hr
  refine ⟨18 * (CS + CD), fun f => ?_⟩
  set g := conjSchwartz f
  have key := eLpNorm_le_of_le_mul_add_mul
    (hΩ.measurable_variationNorm_univ_modulatedSI hn hα0 f r).aemeasurable
    (hΩ.measurable_shortVariation_modulatedSI hn hα0 g r).aemeasurable
    (hΩ.measurable_variationNorm_dyadicSet_modulatedSI hn hα0 g r).aemeasurable
    (hΩ.measurable_shortVariation_modulatedSI hn hα0 f r).aemeasurable
    (hΩ.measurable_variationNorm_dyadicSet_modulatedSI hn hα0 f r).aemeasurable
    (K := 9) (by norm_num) hp fun x =>
      (hΩ.variationNorm_univ_modulatedSI_le hn hα0 f hr1 x).trans
        (add_le_add (variationNorm_Ioi_le hα0 hr1 _) (variationNorm_Ioi_le hα0 hr1 _))
  refine key.trans ?_
  have hg := eLpNorm_conjSchwartz f (ENNReal.ofReal p)
  calc _ ≤ 9 * (CS * eLpNorm g (ENNReal.ofReal p) volume +
          CD * eLpNorm g (ENNReal.ofReal p) volume) +
        9 * (CS * eLpNorm f (ENNReal.ofReal p) volume +
          CD * eLpNorm f (ENNReal.ofReal p) volume) := by
        gcongr
        exacts [hCS g, hCD g, hCS f, hCD f]
    _ = _ := by
        rw [hg]; push_cast; ring

/-- **Theorem 1.1, second part** (§1, `\label{main}`), conditional on the short variation
estimate for `r = 2`: for `α > 1`, `1 < p < ∞`, if `‖S_2(𝓗f)‖_p ≲ ‖f‖_p` for Schwartz `f`
(Prop 1.5), then `‖λ √(N_λ{𝓗^{(u)} f : u ∈ ℝ})‖_p ≲ ‖f‖_p` uniformly in `λ > 0`. Proof
(§1.2): `N_λ(ℝ) ≤ N_{λ/2}(u > 0, conj f) + N_{λ/2}(u > 0, f)`, then Lemma 1.3 at level `λ/2`
and the long jump estimate (Prop 1.4, §3) at level `λ/6`. -/
theorem IsHomogeneousCZKernel.thm_1_1_jump_of_short (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p)
    (hS2 : ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => shortVariation 2 α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ), ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam *
        jumpFunction lam univ (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ))
        (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume := by
  have hα0 : 0 < α := by linarith
  obtain ⟨CS, hCS⟩ := hS2
  obtain ⟨CJ, hCJ⟩ := hΩ.eLpNorm_jumpFunction_dyadicSet_rpow_le hn hα hp
  refine ⟨20 * (CS + CJ), fun f lam hlam => ?_⟩
  set g := conjSchwartz f
  have hl2 : 0 < lam / 2 := by linarith
  have hlam2 : ENNReal.ofReal lam = 2 * ENNReal.ofReal (lam / 2) := by
    rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by norm_num)]; congr 1; ring
  have hpt : ∀ x, ENNReal.ofReal lam *
      jumpFunction lam univ (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ) ≤
      10 * (shortVariation 2 α (fun u => modulatedSI n α Ω u g x) +
        ENNReal.ofReal (lam / 2) * jumpFunction (lam / 2 / 3) (dyadicSet α)
          (fun u => modulatedSI n α Ω u g x) ^ (1 / 2 : ℝ)) +
      10 * (shortVariation 2 α (fun u => modulatedSI n α Ω u f x) +
        ENNReal.ofReal (lam / 2) * jumpFunction (lam / 2 / 3) (dyadicSet α)
          (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ)) := by
    intro x
    have h1 := hΩ.jumpFunction_univ_modulatedSI_le hn hα0 f hlam.le x
    calc ENNReal.ofReal lam *
          jumpFunction lam univ (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ)
        ≤ ENNReal.ofReal lam *
          (jumpFunction (lam / 2) (Ioi 0) (fun u => modulatedSI n α Ω u g x) ^ (1 / 2 : ℝ) +
            jumpFunction (lam / 2) (Ioi 0) (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ)) := by
          gcongr
          exact (ENNReal.rpow_le_rpow h1 (by norm_num)).trans
            (ENNReal.rpow_add_le_add_rpow _ _ (by norm_num) (by norm_num))
      _ = 2 * (ENNReal.ofReal (lam / 2) * jumpFunction (lam / 2) (Ioi 0)
            (fun u => modulatedSI n α Ω u g x) ^ (1 / 2 : ℝ)) +
          2 * (ENNReal.ofReal (lam / 2) * jumpFunction (lam / 2) (Ioi 0)
            (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ)) := by
          rw [hlam2]; ring
      _ ≤ 2 * (5 * (shortVariation 2 α (fun u => modulatedSI n α Ω u g x) +
            ENNReal.ofReal (lam / 2) * jumpFunction (lam / 2 / 3) (dyadicSet α)
              (fun u => modulatedSI n α Ω u g x) ^ (1 / 2 : ℝ))) +
          2 * (5 * (shortVariation 2 α (fun u => modulatedSI n α Ω u f x) +
            ENNReal.ofReal (lam / 2) * jumpFunction (lam / 2 / 3) (dyadicSet α)
              (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ))) := by
          gcongr 2 * ?_ + 2 * ?_ <;> exact mul_sqrt_jumpFunction_Ioi_le hα0 hl2.le _
      _ = _ := by ring
  have hJm : ∀ h : 𝓢(Rn n, ℂ), AEMeasurable (fun x => ENNReal.ofReal (lam / 2) *
      jumpFunction (lam / 2 / 3) (dyadicSet α)
        (fun u => modulatedSI n α Ω u h x) ^ (1 / 2 : ℝ)) volume := fun h =>
    (((hΩ.measurable_jumpFunction_dyadicSet_modulatedSI hn hα0 h _).pow_const _).const_mul
      _).aemeasurable
  have key := eLpNorm_le_of_le_mul_add_mul
    (hΩ.measurable_sqrt_jumpFunction_univ_modulatedSI hn hα0 f lam).aemeasurable
    (hΩ.measurable_shortVariation_modulatedSI hn hα0 g 2).aemeasurable (hJm g)
    (hΩ.measurable_shortVariation_modulatedSI hn hα0 f 2).aemeasurable (hJm f)
    (K := 10) (by norm_num) hp hpt
  refine key.trans ?_
  have hg := eLpNorm_conjSchwartz f (ENNReal.ofReal p)
  calc _ ≤ 10 * (CS * eLpNorm g (ENNReal.ofReal p) volume +
          CJ * eLpNorm g (ENNReal.ofReal p) volume) +
        10 * (CS * eLpNorm f (ENNReal.ofReal p) volume +
          CJ * eLpNorm f (ENNReal.ofReal p) volume) := by
        gcongr
        exacts [hCS g, hCJ 2 le_rfl g _ hl2, hCS f, hCJ 2 le_rfl f _ hl2]
    _ = _ := by
        rw [hg]; push_cast; ring

end Theorem11

/-! ## Stein–Wainger maximal estimate (`170712e1.5`), part `ℓ ≥ 0`, and assembly

§1 of the paper, display (1.5) (cited there from Stein–Wainger). Route item 4 of
`automation/instructions.md`: for `ℓ ≥ 0` the maximal function
`M_ℓ f = sup_j sup_{u ∈ J_j} |𝓗^{(u)}_{ℓ-j} f|` is trivially bounded by the Hardy–Littlewood
maximal function, and decays like `2^{-cℓ}` at `p₀ = 2` (`n ≥ 2`) resp. `p₀ = 4` (`n = 1`): for
`u ∈ J_j`, `|F(u)| ≤ |F(2^{jα})| + V^{p₀}_{J_j}(F)`, the dyadic points are controlled by the §3
square function with decay and the variation by the §4 bounds. Marcinkiewicz interpolation on
bounded functions in `L^a ∩ L^b` gives decay in every `L^p`; summing over `ℓ` and adding the part
`ℓ < 0` proves (`170712e1.5`). -/

section SteinWaingerLarge

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The maximal function of the `ℓ`-th large-scale piece in the proof of (`170712e1.5`):
`M_ℓ f(x) = sup_{j ∈ ℤ} sup_{u ∈ J_j} |𝓗^{(u)}_{ℓ-j} f(x)|` (route item 4 of
`automation/instructions.md`; `𝓗^{(u)}_ℓ` are the pieces (`eq:Hul`)). -/
noncomputable def swMax (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (ℓ : ℤ) (f : Rn n → ℂ) (x : Rn n) :
    ℝ≥0∞ :=
  ⨆ (j : ℤ) (u ∈ shortInterval α j), ‖modulatedPiece n α Ω u (ℓ - j) f x‖ₑ

/-- The radial majorant `C 2^{-(ℓ-1)n} 𝟙_{r ≤ 2^{ℓ+1}}` of the piece kernels at scale `2^ℓ`. -/
noncomputable def swPhi (n : ℕ) (C : ℝ) (ℓ : ℤ) (r : ℝ) : ℝ :=
  if r ≤ (2 : ℝ) ^ (ℓ + 1) then C / ((2 : ℝ) ^ (ℓ - 1)) ^ n else 0

/-- The piece kernel `e^{iu|t|^α} φ_ℓ(t) K(t)` is dominated by the radial majorant `swPhi`
(`|K(t)| ≤ C |t|^{-n}`, support of `φ_ℓ` in `2^{ℓ-1} ≤ |t| ≤ 2^{ℓ+1}`). -/
theorem norm_pieceKernel_le_swPhi {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n) (α u : ℝ) (ℓ : ℤ) (t : Rn n) :
    ‖pieceKernel n α Ω u ℓ t‖ ≤ swPhi n C ℓ ‖t‖ := by
  have hs0 : (0 : ℝ) < 2 ^ (ℓ - 1) := zpow_pos two_pos _
  unfold pieceKernel swPhi
  rw [norm_mul, norm_exp_I_mul_mul, one_mul, Complex.norm_real, Real.norm_eq_abs, abs_mul,
    abs_of_nonneg (dyadicPhiScale_nonneg n ℓ t)]
  by_cases hφ : dyadicPhiScale n ℓ t = 0
  · rw [hφ, zero_mul]; split_ifs <;> positivity
  have hsupp := dyadicPhiScale_ne_zero hφ
  simp only [hsupp.2.le, ↓reduceIte]
  calc dyadicPhiScale n ℓ t * |czKernel n Ω t| ≤ 1 * (C / ‖t‖ ^ n) :=
        mul_le_mul (dyadicPhiScale_le_one n ℓ t) (hC t) (abs_nonneg _) zero_le_one
    _ ≤ C / ((2 : ℝ) ^ (ℓ - 1)) ^ n := by
        rw [one_mul]
        exact div_le_div_of_nonneg_left hC0 (pow_pos hs0 n) (pow_le_pow_left₀ hs0.le hsupp.1.le n)

/-- `swPhi` is nonnegative. -/
theorem swPhi_nonneg {C : ℝ} (hC0 : 0 ≤ C) (ℓ : ℤ) (r : ℝ) : 0 ≤ swPhi n C ℓ r := by
  unfold swPhi; split_ifs <;> positivity

/-- `swPhi` is antitone. -/
theorem swPhi_antitoneOn {C : ℝ} (hC0 : 0 ≤ C) (ℓ : ℤ) : AntitoneOn (swPhi n C ℓ) (Ici 0) := by
  intro a _ b _ hab
  unfold swPhi
  split_ifs with h1 h2 <;> first | exact le_rfl | (exfalso; linarith) | positivity

/-- `∫ swPhi(|z|) dz = C 4ⁿ |B(0,1)|`, independently of the scale `ℓ`. -/
theorem lintegral_swPhi (hn : 1 ≤ n) {C : ℝ} (hC0 : 0 ≤ C) (ℓ : ℤ) :
    ∫⁻ z : Rn n, ENNReal.ofReal (swPhi n C ℓ ‖z‖) =
      ENNReal.ofReal (C * 4 ^ n) * volume (Metric.closedBall (0 : Rn n) 1) := by
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = (2 : ℝ) ^ (ℓ + 1) := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = (2 : ℝ) ^ (ℓ - 1) := ⟨_, rfl⟩
  have hR0 : 0 < R := hR ▸ zpow_pos two_pos _
  have hs0 : 0 < s := hs ▸ zpow_pos two_pos _
  have hRs : R = 4 * s := by
    rw [hR, hs, show ℓ + 1 = (ℓ - 1) + 2 by ring, zpow_add₀ two_ne_zero]; norm_num; ring
  have hB0 : 0 ≤ C / s ^ n := by positivity
  have hBR : C / s ^ n * R ^ n = C * 4 ^ n := by rw [hRs, mul_pow]; field_simp
  have : (fun z : Rn n => ENNReal.ofReal (swPhi n C ℓ ‖z‖)) =
      (Metric.closedBall (0 : Rn n) R).indicator (fun _ => ENNReal.ofReal (C / s ^ n)) := by
    funext z
    by_cases hz : ‖z‖ ≤ R
    · simp [swPhi, ← hR, hs, hz]
    · simp [swPhi, ← hR, hz]
  rw [this, lintegral_indicator_const measurableSet_closedBall]
  have : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
  rw [Measure.addHaar_closedBall _ _ hR0.le, finrank_euclideanSpace_fin, ← mul_assoc,
    ← ENNReal.ofReal_mul hB0, hBR, EuclideanSpace.volume_closedBall,
    EuclideanSpace.volume_ball]

/-- The pieces as convolutions with the piece kernel: `𝓗^{(u)}_ℓ f(x) = ∫ k(x - y) f(y) dy`. -/
theorem modulatedPiece_eq_conv (α u : ℝ) (ℓ : ℤ) (f : Rn n → ℂ) (x : Rn n) :
    modulatedPiece n α Ω u ℓ f x = ∫ y, pieceKernel n α Ω u ℓ (x - y) * f y := by
  rw [modulatedPiece_eq_pieceKernel, lj_integral_sub_mul]
  simp_rw [mul_comm]

/-- **The trivial bound** (proof of (`170712e1.5`), route item 4): uniformly in `u` and `ℓ`,
`|𝓗^{(u)}_ℓ h(x)| ≤ C 4ⁿ |B(0,1)| M h(x)` (`norm_conv_le_maximal` with the majorant `swPhi`). -/
theorem enorm_modulatedPiece_le_maximal (hn : 1 ≤ n) {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n) (α u : ℝ) (ℓ : ℤ) {h : Rn n → ℂ}
    (hh : AEStronglyMeasurable h volume) (x : Rn n) :
    ‖modulatedPiece n α Ω u ℓ h x‖ₑ ≤
      ENNReal.ofReal (C * 4 ^ n) * volume (Metric.closedBall (0 : Rn n) 1) * lpMaximal h x := by
  rw [modulatedPiece_eq_conv, ← lintegral_swPhi hn hC0 ℓ]
  exact norm_conv_le_maximal (by omega) (swPhi_antitoneOn hC0 ℓ) (fun r _ => swPhi_nonneg hC0 ℓ r)
    (norm_pieceKernel_le_swPhi hC0 hC α u ℓ) hh x

/-- The trivial bound for `M_ℓ`: `M_ℓ h ≤ C 4ⁿ |B(0,1)| M h`. -/
theorem swMax_le_maximal (hn : 1 ≤ n) {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n) (α : ℝ) (ℓ : ℤ) {h : Rn n → ℂ}
    (hh : AEStronglyMeasurable h volume) (x : Rn n) :
    swMax n α Ω ℓ h x ≤
      ENNReal.ofReal (C * 4 ^ n) * volume (Metric.closedBall (0 : Rn n) 1) * lpMaximal h x :=
  iSup_le fun _ => iSup₂_le fun u _ => enorm_modulatedPiece_le_maximal hn hC0 hC α u _ hh x

/-- **A pointwise Hölder bound** for a single piece: for `1 ≤ p`,
`|𝓗^{(u)}_ℓ h(x)| ≤ C 2^{-(ℓ-1)n} |B(0, 2^{ℓ+1})|^{1-1/p} ‖h‖_p`. -/
theorem enorm_modulatedPiece_le_eLpNorm {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n) (α u : ℝ) (ℓ : ℤ) {p : ℝ} (hp : 1 ≤ p)
    {h : Rn n → ℂ} (hh : AEStronglyMeasurable h volume) (x : Rn n) :
    ‖modulatedPiece n α Ω u ℓ h x‖ₑ ≤
      ENNReal.ofReal (C / ((2 : ℝ) ^ (ℓ - 1)) ^ n) *
        volume (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (ℓ + 1))) ^ (1 - 1 / p) *
          eLpNorm h (ENNReal.ofReal p) volume := by
  set R : ℝ := (2 : ℝ) ^ (ℓ + 1)
  set B : ℝ := C / ((2 : ℝ) ^ (ℓ - 1)) ^ n
  set g : Rn n → ℂ := fun t => h (x - t)
  have hmp := Measure.measurePreserving_sub_left (volume : Measure (Rn n)) x
  have hg : AEStronglyMeasurable g volume := hh.comp_measurePreserving hmp
  have hgn : eLpNorm g (ENNReal.ofReal p) volume = eLpNorm h (ENNReal.ofReal p) volume :=
    eLpNorm_comp_measurePreserving hh hmp
  have h1 : ‖modulatedPiece n α Ω u ℓ h x‖ₑ ≤
      ∫⁻ t, (Metric.closedBall (0 : Rn n) R).indicator (fun _ => ENNReal.ofReal B) t * ‖g t‖ₑ := by
    rw [modulatedPiece_eq_pieceKernel]
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun t => ?_)
    rw [enorm_mul, mul_comm]
    gcongr
    have := norm_pieceKernel_le_swPhi hC0 hC α u ℓ t
    by_cases ht : ‖t‖ ≤ R
    · rw [indicator_of_mem (by simpa using ht), ← ofReal_norm]
      refine ENNReal.ofReal_le_ofReal (this.trans ?_)
      simp [swPhi, R, ht, B]
    · rw [indicator_of_notMem (by simpa using ht), ← ofReal_norm]
      have h0 : swPhi n C ℓ ‖t‖ = 0 := by
        simp only [swPhi, ite_eq_right_iff]; exact fun h => absurd h ht
      rw [h0] at this
      simp [norm_le_zero_iff.1 this]
  have h2 : ∫⁻ t, (Metric.closedBall (0 : Rn n) R).indicator (fun _ => ENNReal.ofReal B) t *
      ‖g t‖ₑ = ENNReal.ofReal B * eLpNorm g 1 (volume.restrict (Metric.closedBall 0 R)) := by
    rw [eLpNorm_one_eq_lintegral_enorm hg.restrict,
      ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
      ← lintegral_indicator measurableSet_closedBall]
    congr 1; funext t
    by_cases ht : t ∈ Metric.closedBall (0 : Rn n) R <;> simp [ht]
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by simpa using hp
  have h3 := eLpNorm_le_eLpNorm_mul_rpow_measure_univ (f := g) hp1
    (hg.restrict (s := Metric.closedBall (0 : Rn n) R))
  rw [Measure.restrict_apply_univ, ENNReal.toReal_one, ENNReal.toReal_ofReal (by linarith)] at h3
  rw [div_one] at h3
  refine h1.trans (h2.le.trans ?_)
  rw [mul_assoc]
  gcongr
  refine h3.trans ?_
  rw [mul_comm, ← hgn]
  exact mul_le_mul' le_rfl (eLpNorm_restrict_le g _ _ _)

end SteinWaingerLarge

section SteinWaingerLarge

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- For bounded a.e. strongly measurable `h`, the integrand of `𝓗^{(u)}_ℓ h(x)` is integrable. -/
theorem IsHomogeneousCZKernel.integrable_piece_integrand (hΩ : IsHomogeneousCZKernel n Ω)
    (α u : ℝ) (ℓ : ℤ) {h : Rn n → ℂ} (hh : AEStronglyMeasurable h volume) {c : ℝ}
    (hc : ∀ y, ‖h y‖ ≤ c) (x : Rn n) :
    Integrable fun t => h (x - t) * pieceKernel n α Ω u ℓ t :=
  (hΩ.integrable_pieceKernel α u ℓ).bdd_mul
    (hh.comp_measurePreserving (Measure.measurePreserving_sub_left volume x))
    (Eventually.of_forall fun _ => hc _)

/-- Linearity of the pieces on bounded functions:
`𝓗^{(u)}_ℓ (g - h) = 𝓗^{(u)}_ℓ g - 𝓗^{(u)}_ℓ h`. -/
theorem IsHomogeneousCZKernel.modulatedPiece_sub (hΩ : IsHomogeneousCZKernel n Ω)
    (α u : ℝ) (ℓ : ℤ) {g h : Rn n → ℂ} (hg : AEStronglyMeasurable g volume)
    (hh : AEStronglyMeasurable h volume) {c d : ℝ} (hgc : ∀ y, ‖g y‖ ≤ c)
    (hhd : ∀ y, ‖h y‖ ≤ d) (x : Rn n) :
    modulatedPiece n α Ω u ℓ (g - h) x =
      modulatedPiece n α Ω u ℓ g x - modulatedPiece n α Ω u ℓ h x := by
  simp only [modulatedPiece_eq_pieceKernel]
  rw [← integral_sub (hΩ.integrable_piece_integrand α u ℓ hg hgc x)
    (hΩ.integrable_piece_integrand α u ℓ hh hhd x)]
  congr 1; funext t; simp only [Pi.sub_apply]; ring

/-- Additivity of the pieces on bounded functions. -/
theorem IsHomogeneousCZKernel.modulatedPiece_add (hΩ : IsHomogeneousCZKernel n Ω)
    (α u : ℝ) (ℓ : ℤ) {g h : Rn n → ℂ} (hg : AEStronglyMeasurable g volume)
    (hh : AEStronglyMeasurable h volume) {c d : ℝ} (hgc : ∀ y, ‖g y‖ ≤ c)
    (hhd : ∀ y, ‖h y‖ ≤ d) (x : Rn n) :
    modulatedPiece n α Ω u ℓ (g + h) x =
      modulatedPiece n α Ω u ℓ g x + modulatedPiece n α Ω u ℓ h x := by
  simp only [modulatedPiece_eq_pieceKernel]
  rw [← integral_add (hΩ.integrable_piece_integrand α u ℓ hg hgc x)
    (hΩ.integrable_piece_integrand α u ℓ hh hhd x)]
  congr 1; funext t; simp only [Pi.add_apply]; ring

/-- **Continuity in `u`** of `𝓗^{(u)}_ℓ h(x)` for bounded `h` (dominated convergence). -/
theorem IsHomogeneousCZKernel.continuous_modulatedPiece_of_bdd (hΩ : IsHomogeneousCZKernel n Ω)
    (α : ℝ) (ℓ : ℤ) {h : Rn n → ℂ} (hh : AEStronglyMeasurable h volume) {c : ℝ}
    (hc : ∀ y, ‖h y‖ ≤ c) (x : Rn n) : Continuous fun u => modulatedPiece n α Ω u ℓ h x := by
  simp only [modulatedPiece_eq_pieceKernel]
  have hm : AEStronglyMeasurable (fun t => h (x - t)) volume :=
    hh.comp_measurePreserving (Measure.measurePreserving_sub_left volume x)
  refine continuous_of_dominated
    (bound := fun t => c * ‖((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ)‖)
    (fun u => hm.mul (hΩ.integrable_pieceKernel α u ℓ).aestronglyMeasurable)
    (fun u => Eventually.of_forall fun t => ?_) ((hΩ.sw_integrable_kernel ℓ).norm.const_mul c)
    (Eventually.of_forall fun t => ?_)
  · rw [norm_mul, pieceKernel, norm_mul, norm_exp_I_mul_mul, one_mul]
    exact mul_le_mul_of_nonneg_right (hc _) (norm_nonneg _)
  · unfold pieceKernel; fun_prop

/-- A.e. measurability of `x ↦ 𝓗^{(u)}_ℓ h(x)` for `h ∈ L^p`, `p ≥ 1`. -/
theorem IsHomogeneousCZKernel.aemeasurable_modulatedPiece (hΩ : IsHomogeneousCZKernel n Ω)
    (α u : ℝ) (ℓ : ℤ) {p : ℝ} (hp : 1 ≤ p) {h : Rn n → ℂ} (hh : MemLp h (ENNReal.ofReal p)) :
    AEMeasurable fun x => modulatedPiece n α Ω u ℓ h x := by
  simp_rw [modulatedPiece_eq_conv]
  exact lj_aemeasurable_conv (hΩ.integrable_pieceKernel α u ℓ) hp hh

/-- For continuous `a` and `𝒥` contained in the closure of its rational points,
`sup_{u ∈ 𝒥} |a(u)|` is a supremum over rational points. -/
theorem iSup_enorm_eq_iSup_ratCast {𝒥 : Set ℝ} {a : ℝ → ℂ} (ha : Continuous a)
    (h𝒥 : 𝒥 ⊆ closure (𝒥 ∩ range ((↑) : ℚ → ℝ))) :
    ⨆ u ∈ 𝒥, ‖a u‖ₑ = ⨆ (q : ℚ) (_ : (q : ℝ) ∈ 𝒥), ‖a q‖ₑ := by
  set M := ⨆ (q : ℚ) (_ : (q : ℝ) ∈ 𝒥), ‖a q‖ₑ
  refine le_antisymm (iSup₂_le fun u hu => ?_) (iSup₂_le fun q hq => le_iSup₂_of_le (q : ℝ) hq
    le_rfl)
  have hcl : IsClosed {u : ℝ | ‖a u‖ₑ ≤ M} := isClosed_le (continuous_enorm.comp ha)
    continuous_const
  have : 𝒥 ∩ range ((↑) : ℚ → ℝ) ⊆ {u : ℝ | ‖a u‖ₑ ≤ M} := by
    rintro _ ⟨hu, q, rfl⟩
    exact le_iSup₂_of_le (f := fun (q : ℚ) (_ : (q : ℝ) ∈ 𝒥) => ‖a q‖ₑ) q hu le_rfl
  exact hcl.closure_subset_iff.2 this (h𝒥 hu)

/-- **Measurability of `M_ℓ h`** for bounded `h ∈ L^p` (`p ≥ 1`, `α > 0`): by continuity in `u`
the supremum over `u ∈ J_j` is a supremum over rational points. -/
theorem IsHomogeneousCZKernel.aemeasurable_swMax (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ}
    (hα : 0 < α) (ℓ : ℤ) {p : ℝ} (hp : 1 ≤ p) {h : Rn n → ℂ} (hh : MemLp h (ENNReal.ofReal p))
    {c : ℝ} (hc : ∀ y, ‖h y‖ ≤ c) : AEMeasurable (swMax n α Ω ℓ h) := by
  have heq : swMax n α Ω ℓ h = fun x => ⨆ (j : ℤ) (q : ℚ) (_ : (q : ℝ) ∈ shortInterval α j),
      ‖modulatedPiece n α Ω q (ℓ - j) h x‖ₑ := by
    funext x
    refine iSup_congr fun j => ?_
    exact iSup_enorm_eq_iSup_ratCast
      (hΩ.continuous_modulatedPiece_of_bdd α (ℓ - j) hh.aestronglyMeasurable hc x)
      (shortInterval_subset_closure hα j)
  rw [heq]
  exact AEMeasurable.iSup fun j => AEMeasurable.iSup fun q => AEMeasurable.iSup fun _ =>
    (hΩ.aemeasurable_modulatedPiece α q (ℓ - j) hp hh).enorm

/-- The constant `C 4ⁿ |B(0,1)|` of the trivial bound. -/
noncomputable def swConst (n : ℕ) (C : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (C * 4 ^ n) * volume (Metric.closedBall (0 : Rn n) 1)

/-- `swConst` is finite. -/
theorem swConst_ne_top (n : ℕ) (C : ℝ) : swConst n C ≠ ∞ :=
  ENNReal.mul_ne_top ENNReal.ofReal_ne_top measure_closedBall_lt_top.ne

/-- `M_ℓ h` is finite everywhere for bounded `h`. -/
theorem swMax_ne_top (hn : 1 ≤ n) {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n) (α : ℝ) (ℓ : ℤ) {h : Rn n → ℂ}
    (hh : AEStronglyMeasurable h volume) {c : ℝ} (hc : ∀ y, ‖h y‖ ≤ c) (x : Rn n) :
    swMax n α Ω ℓ h x ≠ ∞ := by
  refine ne_top_of_le_ne_top ?_ ((swMax_le_maximal hn hC0 hC α ℓ hh x).trans
    (mul_le_mul' le_rfl (lpMaximal_le_of_norm_le hc x)))
  exact ENNReal.mul_ne_top (swConst_ne_top n C) ENNReal.ofReal_ne_top

/-- **The trivial `L^p` bound for `M_ℓ`** (`1 < p < ∞`, uniformly in `ℓ`):
`‖M_ℓ h‖_p ≤ C 4ⁿ |B(0,1)| C_{HL}(p) ‖h‖_p`, by the Hardy–Littlewood maximal theorem. -/
theorem eLpNorm_swMax_le_trivial (hn : 1 ≤ n) {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |czKernel n Ω t| ≤ C / ‖t‖ ^ n) (α : ℝ) (ℓ : ℤ) {p : ℝ} (hp : 1 < p)
    {h : Rn n → ℂ} (hh : AEStronglyMeasurable h volume) (hm : AEMeasurable (swMax n α Ω ℓ h)) :
    eLpNorm (swMax n α Ω ℓ h) (ENNReal.ofReal p) ≤
      swConst n C * hlMaximalConst (3 ^ n) p * eLpNorm h (ENNReal.ofReal p) := by
  have hMm : AEMeasurable (lpMaximal h) := (sw_measurable_lpMaximal hh).aemeasurable
  have h1 : eLpNorm (swMax n α Ω ℓ h) (ENNReal.ofReal p) ≤
      eLpNorm (fun x => swConst n C * lpMaximal h x) (ENNReal.ofReal p) := by
    refine eLpNorm_mono_enorm hm.aestronglyMeasurable fun x => ?_
    simp only [enorm_eq_self]
    exact swMax_le_maximal hn hC0 hC α ℓ hh x
  have h2 : eLpNorm (fun x => swConst n C * lpMaximal h x) (ENNReal.ofReal p) =
      swConst n C * eLpNorm (lpMaximal h) (ENNReal.ofReal p) :=
    lj_eLpNorm_const_mul _ hMm (by linarith)
  rw [h2] at h1
  refine h1.trans ?_
  rw [mul_assoc]
  exact mul_le_mul' le_rfl (sw_eLpNorm_lpMaximal_le hp hh)

end SteinWaingerLarge

section SteinWaingerDecay

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The exponent `p₀` at which the large-scale pieces of (`170712e1.5`) are shown to decay:
`p₀ = 2` for `n ≥ 2` (Seeger's theorem with `A₂`) and `p₀ = 4` for `n = 1` (the
Carleson–Sjölin `L⁴` estimate), route item 4 of `automation/instructions.md`. -/
noncomputable def swExp (n : ℕ) : ℝ := if n = 1 then 4 else 2

/-- `p₀ ≥ 2`. -/
theorem two_le_swExp (n : ℕ) : 2 ≤ swExp n := by
  unfold swExp; split_ifs <;> norm_num

/-- `2^{-c' x} ≤ 2^{-c x}` for `c ≤ c'`, `x ≥ 0`. -/
theorem two_rpow_neg_mul_le {c c' x : ℝ} (hcc : c ≤ c') (hx : 0 ≤ x) :
    (2 : ℝ) ^ (-(c' * x)) ≤ (2 : ℝ) ^ (-(c * x)) :=
  Real.rpow_le_rpow_of_exponent_le (by norm_num) (by nlinarith)

/-- `(1 + log λ) λ^{-1/4} ≤ 9 λ^{-1/8}` for `λ ≥ 1`. -/
theorem one_add_log_mul_rpow_le {lam : ℝ} (hlam : 1 ≤ lam) :
    lam ^ (1 / 4 - 1 / 2 : ℝ) * (1 + Real.log lam) ≤ 9 * lam ^ (-(1 / 8 : ℝ)) := by
  have hl0 : 0 < lam := by linarith
  have hlog : Real.log lam ≤ lam ^ (1 / 8 : ℝ) / (1 / 8) :=
    Real.log_le_rpow_div hl0.le (by norm_num)
  have h1 : 1 ≤ lam ^ (1 / 8 : ℝ) := Real.one_le_rpow hlam (by norm_num)
  have h2 : 1 + Real.log lam ≤ 9 * lam ^ (1 / 8 : ℝ) := by linarith
  have h3 : lam ^ (1 / 4 - 1 / 2 : ℝ) * lam ^ (1 / 8 : ℝ) = lam ^ (-(1 / 8 : ℝ)) := by
    rw [← Real.rpow_add hl0]; norm_num
  calc lam ^ (1 / 4 - 1 / 2 : ℝ) * (1 + Real.log lam)
      ≤ lam ^ (1 / 4 - 1 / 2 : ℝ) * (9 * lam ^ (1 / 8 : ℝ)) :=
        mul_le_mul_of_nonneg_left h2 (by positivity)
    _ = 9 * lam ^ (-(1 / 8 : ℝ)) := by rw [← h3]; ring

/-- `L + 1 ≥ 1` for the logarithmic factor `L = log(2 + S λ^{1/2})` of Case 1. -/
theorem one_le_case1_log_add_one (α : ℝ) (ℓ k : ℤ) :
    1 ≤ Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1 := by
  have : 0 ≤ case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ) :=
    mul_nonneg (case1Scale_pos ℓ k).le (Real.rpow_nonneg (dyadicPoint_pos α ℓ).le _)
  have := Real.log_nonneg (by linarith : (1 : ℝ) ≤ 2 + case1Scale ℓ k *
    dyadicPoint α ℓ ^ (1 / 2 : ℝ))
  linarith

/-- **Case 1 pieces at `p₀` with decay** (paper §4.4; `n ≥ 2`: `eLpNorm_shortPieceVar_le_of_ge_two`
at `p = r = 2`, decay `λ^{-(n-1)/2}`; `n = 1`: the `(4,4)` estimate `eLpNorm_shortPieceVar_pp`,
decay `λ^{-1/4} log λ`): `‖(∑_j V^{p₀}_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^{p₀})^{1/p₀}‖_{p₀} ≤
G 2^{-c(|ℓ| + |k|)} ‖f‖_{p₀}` for `ℓ ≥ 1` in Case 1. -/
theorem IsHomogeneousCZKernel.sw_case1_le (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 1 < α) :
    ∃ G : ℝ≥0∞, G ≠ ∞ ∧ ∃ c : ℝ, 0 < c ∧ ∀ ℓ k : ℤ, 1 ≤ ℓ → case1Region α ℓ k →
      ∀ f : 𝓢(Rn n, ℂ), eLpNorm (shortPieceVar (swExp n) n α Ω ℓ k f) (ENNReal.ofReal (swExp n)) ≤
        G * ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) *
          eLpNorm f (ENNReal.ofReal (swExp n)) := by
  rcases eq_or_lt_of_le hn with h1 | h2
  · subst h1
    have hq : swExp 1 = 4 := by simp [swExp]
    rw [hq]
    obtain ⟨C, hC0, hC⟩ := hΩ.eLpNorm_shortPieceVar_pp hα (p := 4) (by norm_num)
    obtain ⟨G, c, hG, hc, hdec⟩ := case1_decay_le hα (δ := 1 / 8) (by norm_num)
    have hcs : csExp 4 = 1 / 2 := by norm_num [csExp]
    refine ⟨ENNReal.ofReal (9 * C * G), ENNReal.ofReal_ne_top, c, hc, fun ℓ k hℓ h1 f => ?_⟩
    refine (hC ℓ k hℓ f).trans (mul_le_mul' ?_ le_rfl)
    rw [← ENNReal.ofReal_mul (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    set lam := dyadicPoint α ℓ
    have hlam : 1 ≤ lam := by have := two_le_dyadicPoint hα hℓ; linarith
    have e1 := one_add_log_mul_rpow_le hlam
    have e2 := hdec ℓ k h1
    have e3 := one_le_case1_log_add_one α ℓ k
    rw [hcs, mul_assoc]
    have hr0 : 0 ≤ lam ^ (-(1 / 8 : ℝ)) := Real.rpow_nonneg (by linarith) _
    calc C * (lam ^ (1 / 4 - 1 / 2 : ℝ) * (1 + Real.log lam))
        ≤ C * (9 * lam ^ (-(1 / 8 : ℝ))) := mul_le_mul_of_nonneg_left e1 hC0
      _ ≤ C * (9 * ((Real.log (2 + case1Scale ℓ k * lam ^ (1 / 2 : ℝ)) + 1) *
            lam ^ (-(1 / 8 : ℝ)))) := by
          gcongr; nlinarith
      _ ≤ C * (9 * (G * (2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|))))) := by gcongr
      _ = _ := by ring
  · have hn1 : n ≠ 1 := by omega
    have hq : swExp n = 2 := by simp [swExp, hn1]
    rw [hq]
    obtain ⟨C, hC0, hC⟩ := hΩ.eLpNorm_shortPieceVar_le_of_ge_two hn hα (r := 2) le_rfl
      (p := 2) le_rfl
    have hδ : 0 < ((n : ℝ) - 1) / 2 := by
      have : (2 : ℝ) ≤ n := by exact_mod_cast h2
      linarith
    obtain ⟨G, c, hG, hc, hdec⟩ := case1_decay_le hα hδ
    refine ⟨ENNReal.ofReal (C * G), ENNReal.ofReal_ne_top, c, hc, fun ℓ k hℓ h1 f => ?_⟩
    refine (hC ℓ k (by omega) f).trans (mul_le_mul' ?_ le_rfl)
    rw [← ENNReal.ofReal_mul (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [neg_div, mul_assoc, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hdec ℓ k h1) hC0.le

/-- **All pieces `ℓ ≥ 1` at `p₀` with decay** (paper §4.2–4.5 per pair `(ℓ, k)`: (`est2`) in the
small region, Cases 2/3 by `eLpNorm_shortPieceVar_restRegion_le`, Case 1 by `sw_case1_le`):
`‖(∑_j V^{p₀}_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^{p₀})^{1/p₀}‖_{p₀} ≤ G 2^{-c(|ℓ| + |k|)} ‖f‖_{p₀}`. -/
theorem IsHomogeneousCZKernel.sw_eLpNorm_shortPieceVar_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) :
    ∃ G : ℝ≥0∞, G ≠ ∞ ∧ ∃ c : ℝ, 0 < c ∧ ∀ ℓ k : ℤ, 1 ≤ ℓ →
      ∀ f : 𝓢(Rn n, ℂ), eLpNorm (shortPieceVar (swExp n) n α Ω ℓ k f) (ENNReal.ofReal (swExp n)) ≤
        G * ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) *
          eLpNorm f (ENNReal.ofReal (swExp n)) := by
  have hα0 : 0 < α := by linarith
  have hq2 := two_le_swExp n
  have hq1 : 1 < swExp n := by linarith
  obtain ⟨C₂, hC₂, h₂⟩ := hΩ.est2 hn hα0 hq2 hq1
  obtain ⟨Gr, hGr, hr⟩ := hΩ.eLpNorm_shortPieceVar_restRegion_le hn hα hq2 hq1
  obtain ⟨G₁, hG₁, c₁, hc₁, h₁⟩ := hΩ.sw_case1_le hn hα
  set c₀ := α / (4 * (α + 1))
  have hc₀ : 0 < c₀ := by positivity
  refine ⟨C₂ + Gr + G₁, by finiteness, min c₀ (min 1 c₁), lt_min hc₀ (lt_min one_pos hc₁),
    fun ℓ k hℓ f => ?_⟩
  set x : ℝ := |(ℓ : ℝ)| + |(k : ℝ)|
  have hx : 0 ≤ x := by positivity
  set F := eLpNorm (⇑f) (ENNReal.ofReal (swExp n))
  have hmono : ∀ c', min c₀ (min 1 c₁) ≤ c' →
      ENNReal.ofReal ((2 : ℝ) ^ (-(c' * x))) ≤
        ENNReal.ofReal ((2 : ℝ) ^ (-(min c₀ (min 1 c₁) * x))) := fun c' h =>
    ENNReal.ofReal_le_ofReal (two_rpow_neg_mul_le h hx)
  by_cases hs : smallRegion α ℓ k
  · have hk : k ≤ 0 := by
      unfold smallRegion at hs
      have : (1 : ℝ) ≤ ℓ := by exact_mod_cast hℓ
      have : (k : ℝ) ≤ 0 := by nlinarith
      exact_mod_cast this
    refine (h₂ ℓ k f (add_le_one_of_smallRegion hα0 hs hk)).trans ?_
    refine mul_le_mul' (mul_le_mul' (le_self_add.trans le_self_add) ?_) le_rfl
    exact (ENNReal.ofReal_le_ofReal (two_rpow_le_of_smallRegion_of_nonpos hα0 hs hk)).trans
      (hmono _ (min_le_left _ _))
  by_cases h1 : case1Region α ℓ k
  · refine (h₁ ℓ k hℓ h1 f).trans (mul_le_mul' (mul_le_mul' le_add_self ?_) le_rfl)
    exact hmono _ ((min_le_right _ _).trans (min_le_right _ _))
  · refine (hr ℓ k f ⟨hs, h1⟩).trans ?_
    rw [mul_right_comm]
    refine mul_le_mul' (mul_le_mul' (le_add_self.trans le_self_add) ?_) le_rfl
    exact hmono 1 ((min_le_right _ _).trans (min_le_left _ _))

end SteinWaingerDecay
section SteinWaingerDecaySchwartz

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The dyadic-point values of the `ℓ`-th piece are the terms of the §3 square function of
`q_ℓ = (q̃_{2^{ℓα}})_{-ℓ}`: `∫ (q_ℓ)_j(x - y) f(y) dy = 𝓗^{(2^{jα})}_{ℓ-j} f(x)` (as in
`hasSum_osc_pieces`). -/
theorem IsHomogeneousCZKernel.sw_integral_osc_eq (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ)
    (ℓ j : ℤ) (f : Rn n → ℂ) (x : Rn n) :
    ∫ y, lpDilate n (lpDilate n (ljOsc n α Ω (dyadicPoint α ℓ)) (-ℓ)) j (x - y) * f y =
      modulatedPiece n α Ω (dyadicPoint α j) (ℓ - j) f x := by
  rw [lpDilate_lpDilate, lj_integral_sub_mul, modulatedPiece]
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  dsimp only
  rw [hΩ.lpDilate_ljOsc]
  have hu : dyadicPoint α ℓ * (2 : ℝ) ^ (((-ℓ + j : ℤ) : ℝ) * α) = dyadicPoint α j := by
    rw [dyadicPoint, dyadicPoint, ← Real.rpow_add two_pos]
    congr 1; push_cast; ring
  rw [hu, show -(-ℓ + j) = ℓ - j by ring]
  ring

/-- `|𝓗^{(2^{jα})}_{ℓ-j} f(x)| ≤ (∑_i |(q_ℓ)_i * f(x)|²)^{1/2}`, the §3 square function of the
oscillatory unit-scale piece `q̃_{2^{ℓα}}`. -/
theorem IsHomogeneousCZKernel.sw_enorm_dyadic_le_ljSq (hΩ : IsHomogeneousCZKernel n Ω)
    (α : ℝ) (ℓ j : ℤ) (f : Rn n → ℂ) (x : Rn n) :
    ‖modulatedPiece n α Ω (dyadicPoint α j) (ℓ - j) f x‖ₑ ≤
      ljSq n (ljOsc n α Ω (dyadicPoint α ℓ)) f x := by
  rw [← ljSq_lpDilate _ (-ℓ), ljSq, ← hΩ.sw_integral_osc_eq α ℓ j f x]
  set ψ := lpDilate n (ljOsc n α Ω (dyadicPoint α ℓ)) (-ℓ)
  calc ‖∫ y, lpDilate n ψ j (x - y) * f y‖ₑ
      = (‖∫ y, lpDilate n ψ j (x - y) * f y‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) :=
        (rpow_rpow_one_div two_ne_zero _).symm
    _ ≤ _ := by
        rw [ENNReal.rpow_two]
        gcongr
        exact ENNReal.le_tsum (f := fun i => ‖∫ y, lpDilate n ψ i (x - y) * f y‖ₑ ^ 2) j

/-- **Pointwise bound for `M_ℓ`** on Schwartz functions (route item 4): for `u ∈ J_j`,
`|F(u)| ≤ |F(2^{jα})| + V^q_{J_j}(F)` with `F(u) = 𝓗^{(u)}_{ℓ-j} f(x) = ∑_k 𝓗^{(u)}_{ℓ-j} P_{j+k}
f(x)`, hence `M_ℓ f ≤ (∑_j |𝓗^{(2^{jα})}_{ℓ-j} f|²)^{1/2} + ∑_k ‖V^q_j 𝓗^{(u)}_{ℓ-j} P_{j+k}
f‖_{ℓ^q_j}` (`q ≥ 1`). -/
theorem IsHomogeneousCZKernel.swMax_le_schwartz (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) {q : ℝ} (hq : 1 ≤ q) (ℓ : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    swMax n α Ω ℓ f x ≤ ljSq n (ljOsc n α Ω (dyadicPoint α ℓ)) f x +
      ∑' k, shortPieceVar q n α Ω ℓ k f x := by
  have hq0 : 0 < q := by linarith
  refine iSup_le fun j => iSup₂_le fun u hu => ?_
  set a : ℝ → ℂ := fun v => modulatedPiece n α Ω v (ℓ - j) f x
  have hd : dyadicPoint α j ∈ shortInterval α j := dyadicPoint_mem_shortInterval hα j
  have h1 : ‖a u‖ₑ ≤ ‖a (dyadicPoint α j)‖ₑ + ‖a u - a (dyadicPoint α j)‖ₑ := by
    calc ‖a u‖ₑ = ‖a (dyadicPoint α j) + (a u - a (dyadicPoint α j))‖ₑ := by congr 1; ring
      _ ≤ _ := enorm_add_le _ _
  have h2 : ‖a u - a (dyadicPoint α j)‖ₑ ≤ variationNorm q (shortInterval α j) a :=
    (ENNReal.rpow_le_rpow_iff hq0).1 (rpow_le_variationNorm_rpow hq0 (a := a) hu.1 hd hu)
  have h3 : variationNorm q (shortInterval α j) a ≤
      ∑' k, variationNorm q (shortInterval α j) (shortPiece n α Ω ℓ k f j x) :=
    variationNorm_le_tsum_of_hasSum hq fun v _ =>
      (Equiv.addLeft j).hasSum_iff
        (f := fun m => modulatedPiece n α Ω v (ℓ - j) (lpProj n m f) x) |>.2
        (hΩ.hasSum_modulatedPiece_lpProj hn α v (ℓ - j) f x)
  have h4 : ∀ k, variationNorm q (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ≤
      shortPieceVar q n α Ω ℓ k f x := by
    intro k
    unfold shortPieceVar
    calc variationNorm q (shortInterval α j) (shortPiece n α Ω ℓ k f j x)
        = (variationNorm q (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ^ q) ^ (1 / q) :=
          (rpow_rpow_one_div hq0.ne' _).symm
      _ ≤ _ := ENNReal.rpow_le_rpow (ENNReal.le_tsum (f := fun j' =>
          variationNorm q (shortInterval α j') (shortPiece n α Ω ℓ k f j' x) ^ q) j)
          (by positivity)
  exact h1.trans (add_le_add (hΩ.sw_enorm_dyadic_le_ljSq α ℓ j f x)
    (h2.trans (h3.trans (ENNReal.tsum_le_tsum h4))))

/-- `2^{-c(a+b)} = 2^{-ca} 2^{-cb}` in `[0, ∞]`. -/
theorem ofReal_two_rpow_neg_mul_add (c a b : ℝ) :
    ENNReal.ofReal ((2 : ℝ) ^ (-(c * (a + b)))) =
      ENNReal.ofReal ((2 : ℝ) ^ (-(c * a))) * ENNReal.ofReal ((2 : ℝ) ^ (-(c * b))) := by
  rw [← ENNReal.ofReal_mul (by positivity), ← Real.rpow_add two_pos]
  congr 2; ring

/-- **Decay of `M_ℓ` at `p₀` on Schwartz functions** (route item 4): for `α > 1` there are
`G < ∞`, `c > 0` with `‖M_ℓ f‖_{p₀} ≤ G 2^{-cℓ} ‖f‖_{p₀}` for all `ℓ ≥ 0` (§3 square function
estimate with decay `eLpNorm_ljSq_osc_le` for the dyadic points, and the §4 bounds
`sw_eLpNorm_shortPieceVar_le` for the variation; `ℓ = 0` by the trivial bound). -/
theorem IsHomogeneousCZKernel.sw_decay_schwartz (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 1 < α) :
    ∃ G : ℝ≥0∞, G ≠ ∞ ∧ ∃ c : ℝ, 0 < c ∧ ∀ ℓ : ℤ, 0 ≤ ℓ → ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (swMax n α Ω ℓ f) (ENNReal.ofReal (swExp n)) ≤
        G * ENNReal.ofReal ((2 : ℝ) ^ (-(c * ℓ))) * eLpNorm f (ENNReal.ofReal (swExp n)) := by
  have hα0 : 0 < α := by linarith
  have hq2 := two_le_swExp n
  have hq1 : 1 < swExp n := by linarith
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound_czKernel
  obtain ⟨Cs, γ, hCs, hγ, hsq⟩ := hΩ.eLpNorm_ljSq_osc_le hn hα hq1
  obtain ⟨G, hG, c, hc, hpv⟩ := hΩ.sw_eLpNorm_shortPieceVar_le hn hα
  obtain ⟨S, hSd⟩ : ∃ S, S = ∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(k : ℝ)|))) := ⟨_, rfl⟩
  have hS : S ≠ ∞ := hSd ▸ tsum_two_rpow_neg_abs_ne_top hc
  obtain ⟨T, hTd⟩ : ∃ T, T = swConst n C * hlMaximalConst (3 ^ n) (swExp n) := ⟨_, rfl⟩
  have hT : T ≠ ∞ := hTd ▸ ENNReal.mul_ne_top (swConst_ne_top n C)
    (hlMaximalConst_ne_top _ (by linarith))
  refine ⟨T + (ENNReal.ofReal Cs + G * S), by finiteness, min (γ * α) c,
    lt_min (by positivity) hc, fun ℓ hℓ f => ?_⟩
  obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
  have hm : AEMeasurable (swMax n α Ω ℓ f) :=
    hΩ.aemeasurable_swMax hα0 ℓ hq1.le (f.memLp _) hCf
  have hl : (ℓ : ℝ) = |(ℓ : ℝ)| := (abs_of_nonneg (by exact_mod_cast hℓ)).symm
  rcases eq_or_lt_of_le hℓ with h0 | h1
  · subst h0
    refine (eLpNorm_swMax_le_trivial hn hC0 hC α 0 hq1 f.continuous.aestronglyMeasurable
      hm).trans ?_
    simp only [Int.cast_zero, mul_zero, neg_zero, Real.rpow_zero, ENNReal.ofReal_one, mul_one]
    rw [← hTd]
    exact mul_le_mul' le_self_add le_rfl
  have hℓ1 : 1 ≤ ℓ := h1
  have hlam : 1 ≤ dyadicPoint α ℓ := Real.one_le_rpow (by norm_num) (by positivity)
  have hdp : dyadicPoint α ℓ ^ (-γ) = (2 : ℝ) ^ (-(γ * α * ℓ)) := by
    rw [dyadicPoint, ← Real.rpow_mul (by norm_num)]; congr 1; ring
  have hsqm : AEMeasurable (ljSq n (ljOsc n α Ω (dyadicPoint α ℓ)) (⇑f)) :=
    lj_aemeasurable_ljSq (hΩ.integrable_ljOsc α _) hq1.le (f.memLp _)
  have hpvm : ∀ k, AEMeasurable (shortPieceVar (swExp n) n α Ω ℓ k f) := fun k =>
    (hΩ.measurable_shortPieceVar hα0 _ ℓ k f).aemeasurable
  have hq1' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (swExp n) := by simpa using hq1.le
  have hA : eLpNorm (swMax n α Ω ℓ f) (ENNReal.ofReal (swExp n)) ≤
      eLpNorm (ljSq n (ljOsc n α Ω (dyadicPoint α ℓ)) (⇑f)) (ENNReal.ofReal (swExp n)) +
        ∑' k, eLpNorm (shortPieceVar (swExp n) n α Ω ℓ k f) (ENNReal.ofReal (swExp n)) := by
    refine (eLpNorm_mono_enorm hm.aestronglyMeasurable (g := fun x =>
      ljSq n (ljOsc n α Ω (dyadicPoint α ℓ)) f x + ∑' k, shortPieceVar (swExp n) n α Ω ℓ k f x)
      fun x => ?_).trans ((eLpNorm_add_le hq1').trans
        (add_le_add le_rfl (lj_eLpNorm_tsum_le hpvm hq1.le)))
    simp only [enorm_eq_self]
    exact hΩ.swMax_le_schwartz hn hα0 hq1.le ℓ f x
  have hB : eLpNorm (ljSq n (ljOsc n α Ω (dyadicPoint α ℓ)) (⇑f)) (ENNReal.ofReal (swExp n)) ≤
      ENNReal.ofReal Cs * ENNReal.ofReal ((2 : ℝ) ^ (-(min (γ * α) c * ℓ))) *
        eLpNorm (⇑f) (ENNReal.ofReal (swExp n)) := by
    refine (hsq _ hlam f).trans (mul_le_mul' ?_ le_rfl)
    rw [← ENNReal.ofReal_mul hCs, hdp]
    refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left ?_ hCs)
    have := two_rpow_neg_mul_le (c := min (γ * α) c) (c' := γ * α) (x := ℓ) (min_le_left _ _)
      (by exact_mod_cast hℓ)
    simpa [mul_assoc] using this
  have hC' : ∑' k, eLpNorm (shortPieceVar (swExp n) n α Ω ℓ k f) (ENNReal.ofReal (swExp n)) ≤
      G * S * ENNReal.ofReal ((2 : ℝ) ^ (-(min (γ * α) c * ℓ))) *
        eLpNorm (⇑f) (ENNReal.ofReal (swExp n)) := by
    have e1 := ENNReal.tsum_le_tsum fun k => hpv ℓ k hℓ1 f
    refine e1.trans ?_
    have e2 : ∀ k : ℤ, G * ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) *
        eLpNorm (⇑f) (ENNReal.ofReal (swExp n)) =
        G * ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(ℓ : ℝ)|))) *
          eLpNorm (⇑f) (ENNReal.ofReal (swExp n)) *
          ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(k : ℝ)|))) := fun k => by
      rw [ofReal_two_rpow_neg_mul_add]; ring
    rw [tsum_congr e2, ENNReal.tsum_mul_left, ← hSd]
    have e3 : ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(ℓ : ℝ)|))) ≤
        ENNReal.ofReal ((2 : ℝ) ^ (-(min (γ * α) c * ℓ))) := by
      rw [← hl]
      exact ENNReal.ofReal_le_ofReal (two_rpow_neg_mul_le (min_le_right _ _) (by exact_mod_cast hℓ))
    refine (mul_le_mul' (mul_le_mul' (mul_le_mul' le_rfl e3) le_rfl) le_rfl).trans (le_of_eq ?_)
    rw [mul_right_comm _ _ S, mul_right_comm G _ S]
  refine hA.trans ((add_le_add hB hC').trans ?_)
  rw [← add_mul, ← add_mul]
  exact mul_le_mul' (mul_le_mul' le_add_self le_rfl) le_rfl

end SteinWaingerDecaySchwartz
section SteinWaingerInterpolation

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- A single piece is bounded by `M_ℓ`: `|𝓗^{(u)}_{ℓ-j} f(x)| ≤ M_ℓ f(x)` for `u ∈ J_j`. -/
theorem enorm_le_swMax {α : ℝ} {u : ℝ} {j : ℤ} (hu : u ∈ shortInterval α j) (ℓ : ℤ)
    (f : Rn n → ℂ) (x : Rn n) :
    ‖modulatedPiece n α Ω u (ℓ - j) f x‖ₑ ≤ swMax n α Ω ℓ f x :=
  (le_iSup₂ (f := fun v (_ : v ∈ shortInterval α j) =>
    ‖modulatedPiece n α Ω v (ℓ - j) f x‖ₑ) u hu).trans
    (le_iSup (fun j => ⨆ v ∈ shortInterval α j, ‖modulatedPiece n α Ω v (ℓ - j) f x‖ₑ) j)

/-- Subadditivity of `M_ℓ` on bounded functions. -/
theorem IsHomogeneousCZKernel.swMax_add_le (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ : ℤ)
    {g h : Rn n → ℂ} (hg : AEStronglyMeasurable g volume) (hh : AEStronglyMeasurable h volume)
    {c d : ℝ} (hgc : ∀ y, ‖g y‖ ≤ c) (hhd : ∀ y, ‖h y‖ ≤ d) (x : Rn n) :
    swMax n α Ω ℓ (g + h) x ≤ swMax n α Ω ℓ g x + swMax n α Ω ℓ h x := by
  refine iSup_le fun j => iSup₂_le fun u hu => ?_
  rw [hΩ.modulatedPiece_add α u _ hg hh hgc hhd x]
  exact (enorm_add_le _ _).trans (add_le_add (enorm_le_swMax hu ℓ g x) (enorm_le_swMax hu ℓ h x))

/-- **Extension of the decay at `p₀` to bounded `L^{p₀}` functions** (density of Schwartz
functions and lower semicontinuity, `eLpNorm_le_of_forall_schwartz`; the pieces converge
pointwise by the Hölder bound `enorm_modulatedPiece_le_eLpNorm`). -/
theorem IsHomogeneousCZKernel.sw_decay_bdd (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 1 < α) :
    ∃ G : ℝ≥0∞, G ≠ ∞ ∧ ∃ c : ℝ, 0 < c ∧ ∀ ℓ : ℤ, 0 ≤ ℓ → ∀ h : Rn n → ℂ,
      MemLp h (ENNReal.ofReal (swExp n)) → (∃ c', ∀ y, ‖h y‖ ≤ c') →
      eLpNorm (swMax n α Ω ℓ h) (ENNReal.ofReal (swExp n)) ≤
        G * ENNReal.ofReal ((2 : ℝ) ^ (-(c * ℓ))) * eLpNorm h (ENNReal.ofReal (swExp n)) := by
  have hα0 : 0 < α := by linarith
  have hq1 : 1 < swExp n := by linarith [two_le_swExp n]
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound_czKernel
  obtain ⟨G, hG, c, hc, hdec⟩ := hΩ.sw_decay_schwartz hn hα
  refine ⟨G, hG, c, hc, fun ℓ hℓ h hh ⟨ch, hch⟩ => ?_⟩
  refine eLpNorm_le_of_forall_schwartz hq1.le (swMax n α Ω ℓ)
    (ENNReal.mul_ne_top hG ENNReal.ofReal_ne_top)
    (fun g => hΩ.aemeasurable_swMax hα0 ℓ hq1.le (g.memLp _) (lj_schwartz_bounded g).choose_spec)
    (fun g => hdec ℓ hℓ g) hh (hΩ.aemeasurable_swMax hα0 ℓ hq1.le hh hch)
    fun g hconv => ⟨id, strictMono_id, ae_of_all _ fun x => ?_⟩
  refine iSup_le fun j => iSup₂_le fun u hu => ?_
  set K : ℝ≥0∞ := ENNReal.ofReal (C / ((2 : ℝ) ^ (ℓ - j - 1)) ^ n) *
    volume (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (ℓ - j + 1))) ^ (1 - 1 / swExp n)
  have hK : K ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by
      have : 1 / swExp n ≤ 1 := by rw [div_le_one (by linarith)]; linarith
      linarith) measure_closedBall_lt_top.ne)
  have hb : ∀ k, edist (modulatedPiece n α Ω u (ℓ - j) (g k) x)
      (modulatedPiece n α Ω u (ℓ - j) h x) ≤
        K * eLpNorm (⇑(g k) - h) (ENNReal.ofReal (swExp n)) := by
    intro k
    obtain ⟨cg, hcg⟩ := lj_schwartz_bounded (g k)
    rw [edist_eq_enorm_sub, ← hΩ.modulatedPiece_sub α u _ (g k).continuous.aestronglyMeasurable
      hh.aestronglyMeasurable hcg hch x]
    exact enorm_modulatedPiece_le_eLpNorm hC0 hC α u (ℓ - j) hq1.le
      ((g k).continuous.aestronglyMeasurable.sub hh.aestronglyMeasurable) x
  have hK0 : Tendsto (fun k => K * eLpNorm (⇑(g k) - h) (ENNReal.ofReal (swExp n))) atTop
      (𝓝 0) := by
    simpa using ENNReal.Tendsto.const_mul hconv (Or.inr hK)
  have hT : Tendsto (fun k => modulatedPiece n α Ω u (ℓ - j) (g k) x) atTop
      (𝓝 (modulatedPiece n α Ω u (ℓ - j) h x)) :=
    tendsto_iff_edist_tendsto_0.2 (tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
      hK0 (fun _ => zero_le) hb)
  rw [← ((continuous_enorm.tendsto _).comp hT).liminf_eq]
  exact liminf_le_liminf (Eventually.of_forall fun k => enorm_le_swMax hu ℓ _ x)

/-- The class of bounded functions in `L^a ∩ L^b`. -/
def swClass (n : ℕ) (a b : ℝ) : Set (Rn n → ℂ) :=
  {h | (∃ c, ∀ y, ‖h y‖ ≤ c) ∧ MemLp h (ENNReal.ofReal a) ∧ MemLp h (ENNReal.ofReal b)}

/-- `swClass` is closed under truncations. -/
theorem isTruncationClosed_swClass (n : ℕ) (a b : ℝ) : IsTruncationClosed (swClass n a b) := by
  intro f ⟨⟨c, hc⟩, ha, hb⟩ s hs
  obtain ⟨ha1, ha2⟩ := isTruncationClosed_memLp f ha s hs
  obtain ⟨hb1, hb2⟩ := isTruncationClosed_memLp f hb s hs
  exact ⟨⟨⟨c, fun y => (norm_indicator_le_norm_self _ _).trans (hc y)⟩, ha1, hb1⟩,
    ⟨⟨c, fun y => (norm_indicator_le_norm_self _ _).trans (hc y)⟩, ha2, hb2⟩⟩

/-- **Marcinkiewicz interpolation for `M_ℓ`** (route item 4): strong type `(a, a)` and `(b, b)`
of `M_ℓ` on bounded functions in `L^a ∩ L^b` (`1 < a < p < b < ∞`) give
`‖M_ℓ f‖_p ≤ C(a,b,p) A^{1-θ} B^θ ‖f‖_p` for Schwartz `f`, `1/p = (1-θ)/a + θ/b`
(`eLpNorm_le_of_hasWeakTypeOn` applied to the real-valued `(M_ℓ f)^{toReal}`; `M_ℓ` is
subadditive on bounded functions). -/
theorem IsHomogeneousCZKernel.sw_interp (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 0 < α) {a b p θ : ℝ} (ha : 1 < a) (hap : a < p) (hpb : p < b)
    (hθ : 1 / p = (1 - θ) / a + θ / b) {ℓ : ℤ} {A B : ℝ≥0}
    (hA : ∀ h ∈ swClass n a b, eLpNorm (swMax n α Ω ℓ h) (ENNReal.ofReal a) ≤
      A * eLpNorm h (ENNReal.ofReal a))
    (hB : ∀ h ∈ swClass n a b, eLpNorm (swMax n α Ω ℓ h) (ENNReal.ofReal b) ≤
      B * eLpNorm h (ENNReal.ofReal b))
    (f : 𝓢(Rn n, ℂ)) :
    eLpNorm (swMax n α Ω ℓ f) (ENNReal.ofReal p) ≤
      (marcinkiewiczConst a b p : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - θ) * (B : ℝ≥0∞) ^ θ *
        eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound_czKernel
  set T : (Rn n → ℂ) → Rn n → ℝ := fun h x => (swMax n α Ω ℓ h x).toReal
  have hmeas : ∀ h ∈ swClass n a b, AEMeasurable (swMax n α Ω ℓ h) := fun h ⟨⟨c, hc⟩, hha, _⟩ =>
    hΩ.aemeasurable_swMax hα ℓ ha.le hha hc
  have hTe : ∀ h ∈ swClass n a b, ∀ q, eLpNorm (T h) q = eLpNorm (swMax n α Ω ℓ h) q := by
    intro h hD q
    obtain ⟨⟨c, hc⟩, hha, _⟩ := id hD
    refine eLpNorm_congr_enorm_ae (hmeas h hD).ennreal_toReal.aestronglyMeasurable
      (hmeas h hD).aestronglyMeasurable (ae_of_all _ fun x => ?_)
    rw [Real.enorm_eq_ofReal ENNReal.toReal_nonneg, enorm_eq_self,
      ENNReal.ofReal_toReal (swMax_ne_top hn hC0 hC α ℓ hha.aestronglyMeasurable hc x)]
  have hTA : HasWeakTypeOn T (swClass n a b) a A volume volume :=
    HasStrongTypeOn.hasWeakTypeOn (by linarith) fun h hD => by rw [hTe h hD]; exact hA h hD
  have hTB : HasWeakTypeOn T (swClass n a b) b B volume volume :=
    HasStrongTypeOn.hasWeakTypeOn (by linarith) fun h hD => by rw [hTe h hD]; exact hB h hD
  have hsub : IsSublinearOn T (swClass n a b) volume := by
    intro g ⟨⟨c, hc⟩, hga, _⟩ h ⟨⟨d, hd⟩, hha, _⟩
    refine ae_of_all _ fun x => ?_
    have hgt := swMax_ne_top hn hC0 hC α ℓ hga.aestronglyMeasurable hc x
    have hht := swMax_ne_top hn hC0 hC α ℓ hha.aestronglyMeasurable hd x
    simp only [T, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
    rw [← ENNReal.toReal_add hgt hht]
    exact ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨hgt, hht⟩)
      (hΩ.swMax_add_le α ℓ hga.aestronglyMeasurable hha.aestronglyMeasurable hc hd x)
  have hfD : (⇑f : Rn n → ℂ) ∈ swClass n a b := ⟨lj_schwartz_bounded f, f.memLp _, f.memLp _⟩
  have key := eLpNorm_le_of_hasWeakTypeOn (by linarith) hap hpb hθ hTA hTB hsub
    (isTruncationClosed_swClass n a b) hfD f.continuous.aestronglyMeasurable
    (hmeas _ hfD).ennreal_toReal.aestronglyMeasurable
  rwa [hTe _ hfD] at key

end SteinWaingerInterpolation
section SteinWaingerTheorem

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- The interpolation parameter: for `0 < a < p < b` there is `θ ∈ (0, 1)` with
`1/p = (1-θ)/a + θ/b`. -/
theorem exists_interp_theta {a p b : ℝ} (ha : 0 < a) (hap : a < p) (hpb : p < b) :
    ∃ θ : ℝ, 0 < θ ∧ θ < 1 ∧ 1 / p = (1 - θ) / a + θ / b := by
  have hp : 0 < p := ha.trans hap
  have hb : 0 < b := hp.trans hpb
  have hba : 0 < b - a := by linarith
  refine ⟨b * (p - a) / (p * (b - a)), div_pos (mul_pos hb (by linarith)) (by positivity),
    (div_lt_one (by positivity)).2 (by nlinarith), ?_⟩
  field_simp
  ring

/-- `(G 2^{-cx})^t = G^t 2^{-(ct)x}` in `[0, ∞]` for `t ≥ 0`. -/
theorem mul_ofReal_two_rpow_rpow (G : ℝ≥0∞) {c x t : ℝ} (ht : 0 ≤ t) :
    (G * ENNReal.ofReal ((2 : ℝ) ^ (-(c * x)))) ^ t =
      G ^ t * ENNReal.ofReal ((2 : ℝ) ^ (-(c * t * x))) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ ht, ENNReal.ofReal_rpow_of_nonneg (by positivity) ht,
    ← Real.rpow_mul (by norm_num)]
  congr 3; ring

/-- **Decay of `M_ℓ` in every `L^p`, `1 < p < ∞`** (route item 4): there are `G < ∞`, `c > 0`
with `‖M_ℓ f‖_p ≤ G 2^{-cℓ} ‖f‖_p` for all `ℓ ≥ 0` and Schwartz `f`, by Marcinkiewicz
interpolation (`sw_interp`) between the decay at `p₀` (`sw_decay_bdd`) and the trivial bound
(`eLpNorm_swMax_le_trivial`) at an exponent on the other side of `p`. -/
theorem IsHomogeneousCZKernel.sw_decay (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ G : ℝ≥0∞, G ≠ ∞ ∧ ∃ c : ℝ, 0 < c ∧ ∀ ℓ : ℤ, 0 ≤ ℓ → ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (swMax n α Ω ℓ f) (ENNReal.ofReal p) ≤
        G * ENNReal.ofReal ((2 : ℝ) ^ (-(c * ℓ))) * eLpNorm f (ENNReal.ofReal p) := by
  have hα0 : 0 < α := by linarith
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound_czKernel
  obtain ⟨G₀, hG₀, c₀, hc₀, h₀⟩ := hΩ.sw_decay_bdd hn hα
  have hq1 : 1 < swExp n := by linarith [two_le_swExp n]
  -- the trivial bound at an exponent `e > 1`
  have htr : ∀ e : ℝ, 1 < e → ∀ (ℓ : ℤ) (h : Rn n → ℂ), MemLp h (ENNReal.ofReal e) →
      (∃ c', ∀ y, ‖h y‖ ≤ c') → eLpNorm (swMax n α Ω ℓ h) (ENNReal.ofReal e) ≤
        ((swConst n C * hlMaximalConst (3 ^ n) e).toNNReal : ℝ≥0∞) *
          eLpNorm h (ENNReal.ofReal e) := by
    intro e he ℓ h hh ⟨c', hc'⟩
    rw [ENNReal.coe_toNNReal (ENNReal.mul_ne_top (swConst_ne_top n C)
      (hlMaximalConst_ne_top _ (by linarith)))]
    exact eLpNorm_swMax_le_trivial hn hC0 hC α ℓ he hh.aestronglyMeasurable
      (hΩ.aemeasurable_swMax hα0 ℓ he.le hh hc')
  have hdec : ∀ ℓ : ℤ, 0 ≤ ℓ → G₀ * ENNReal.ofReal ((2 : ℝ) ^ (-(c₀ * ℓ))) =
      (((G₀ * ENNReal.ofReal ((2 : ℝ) ^ (-(c₀ * ℓ)))).toNNReal : ℝ≥0) : ℝ≥0∞) := fun ℓ _ =>
    (ENNReal.coe_toNNReal (ENNReal.mul_ne_top hG₀ ENNReal.ofReal_ne_top)).symm
  rcases lt_trichotomy p (swExp n) with hlt | heq | hgt
  · -- `p < p₀`: interpolate between `a = (1+p)/2` (trivial) and `b = p₀` (decay)
    obtain ⟨θ, hθ0, hθ1, hθ⟩ := exists_interp_theta (a := (1 + p) / 2) (by linarith)
      (by linarith) hlt
    set Ta := swConst n C * hlMaximalConst (3 ^ n) ((1 + p) / 2)
    refine ⟨(marcinkiewiczConst ((1 + p) / 2) (swExp n) p : ℝ≥0∞) *
      ((Ta.toNNReal : ℝ≥0) : ℝ≥0∞) ^ (1 - θ) * G₀ ^ θ, by finiteness, c₀ * θ,
      mul_pos hc₀ hθ0, fun ℓ hℓ f => ?_⟩
    have key := hΩ.sw_interp hn hα0 (by linarith) (by linarith) hlt hθ (ℓ := ℓ)
      (fun h hD => htr _ (by linarith) ℓ h hD.2.1 hD.1)
      (fun h hD => (h₀ ℓ hℓ h hD.2.2 hD.1).trans_eq (by rw [hdec ℓ hℓ])) f
    refine key.trans_eq ?_
    rw [← hdec ℓ hℓ, mul_ofReal_two_rpow_rpow _ hθ0.le]
    ring
  · -- `p = p₀`
    subst heq
    exact ⟨G₀, hG₀, c₀, hc₀, fun ℓ hℓ f => h₀ ℓ hℓ f (f.memLp _) (lj_schwartz_bounded f)⟩
  · -- `p > p₀`: interpolate between `a = p₀` (decay) and `b = p + 1` (trivial)
    obtain ⟨θ, hθ0, hθ1, hθ⟩ := exists_interp_theta (b := p + 1) (by linarith) hgt
      (by linarith)
    set Tb := swConst n C * hlMaximalConst (3 ^ n) (p + 1)
    refine ⟨(marcinkiewiczConst (swExp n) (p + 1) p : ℝ≥0∞) * G₀ ^ (1 - θ) *
      ((Tb.toNNReal : ℝ≥0) : ℝ≥0∞) ^ θ, by finiteness, c₀ * (1 - θ),
      mul_pos hc₀ (by linarith), fun ℓ hℓ f => ?_⟩
    have key := hΩ.sw_interp hn hα0 hq1 hgt (by linarith) hθ (ℓ := ℓ)
      (fun h hD => (h₀ ℓ hℓ h hD.2.1 hD.1).trans_eq (by rw [hdec ℓ hℓ]))
      (fun h hD => htr _ (by linarith) ℓ h hD.2.2 hD.1) f
    refine key.trans_eq ?_
    rw [← hdec ℓ hℓ, mul_ofReal_two_rpow_rpow _ (by linarith : (0 : ℝ) ≤ 1 - θ)]
    ring

end SteinWaingerTheorem
section SteinWaingerMain

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- Measurability of the small-scale supremum `sup_j sup_{u ∈ J_j} |∑_{ℓ<0} 𝓗^{(u)}_{ℓ-j} f|`
(lower semicontinuity, as in `eLpNorm_iSup_shortInterval_small_le`). -/
theorem IsHomogeneousCZKernel.measurable_iSup_small (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) :
    Measurable fun x => ⨆ (j : ℤ) (u ∈ shortInterval α j),
      ‖∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω u (ℓ - j) f x else 0)‖ₑ :=
  LowerSemicontinuous.measurable (lowerSemicontinuous_iSup fun _ =>
    lowerSemicontinuous_biSup fun _ hu =>
      (continuous_enorm.comp (hΩ.sw_continuous_small hn hα hu f)).lowerSemicontinuous)

/-- Measurability of `x ↦ sup_{u ∈ ℝ} |𝓗^{(u)} f(x)|` (continuity in `u`). -/
theorem IsHomogeneousCZKernel.measurable_iSup_modulatedSI (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) :
    Measurable fun x => ⨆ u : ℝ, ‖modulatedSI n α Ω u f x‖ₑ := by
  have heq : (fun x => ⨆ u : ℝ, ‖modulatedSI n α Ω u f x‖ₑ) = fun x =>
      ⨆ (q : ℚ) (_ : (q : ℝ) ∈ (univ : Set ℝ)), ‖modulatedSI n α Ω q f x‖ₑ := by
    funext x
    rw [← iSup_enorm_eq_iSup_ratCast (hΩ.continuous_modulatedSI hn hα f x)
      (subset_closure_inter_ratCast_of_isOpen isOpen_univ), iSup_univ]
  rw [heq]
  exact Measurable.iSup fun q => Measurable.iSup fun _ =>
    (hΩ.measurable_modulatedSI hn hα q f).enorm

/-- **The pointwise reduction of (`170712e1.5`)** for `u > 0`: with `j` such that `u ∈ J_j`,
`|𝓗^{(u)} f(x)| ≤ sup_j sup_{u ∈ J_j} |∑_{ℓ<0} 𝓗^{(u)}_{ℓ-j} f(x)| + ∑_{ℓ ≥ 0} M_ℓ f(x)`
(`modulatedSI_eq_small_add_large`). -/
theorem IsHomogeneousCZKernel.enorm_modulatedSI_le_of_pos (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) (f : 𝓢(Rn n, ℂ)) (x : Rn n) {u : ℝ} (hu : 0 < u) :
    ‖modulatedSI n α Ω u f x‖ₑ ≤ (⨆ (j : ℤ) (v ∈ shortInterval α j),
      ‖∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω v (ℓ - j) f x else 0)‖ₑ) +
        ∑' ℓ : ℤ, if 0 ≤ ℓ then swMax n α Ω ℓ f x else 0 := by
  have hj := mem_shortInterval_dyadicIndex hα hu
  rw [hΩ.modulatedSI_eq_small_add_large hn hα u (dyadicIndex α u) f x]
  refine (enorm_add_le _ _).trans (add_le_add ?_ ?_)
  · exact le_iSup_of_le (dyadicIndex α u) (le_iSup₂_of_le (f := fun (v : ℝ)
      (_ : v ∈ shortInterval α (dyadicIndex α u)) => ‖∑' ℓ : ℤ, (if ℓ < 0 then
        modulatedPiece n α Ω v (ℓ - dyadicIndex α u) f x else 0)‖ₑ) u hj le_rfl)
  · refine enorm_tsum_le_tsum_enorm.trans (ENNReal.tsum_le_tsum fun ℓ => ?_)
    split_ifs
    · exact enorm_le_swMax hj ℓ f x
    · simp

/-- **The large-scale part of (`170712e1.5`)**: `‖∑_{ℓ ≥ 0} M_ℓ f‖_p ≤ C ‖f‖_p`
(`1 < p < ∞`, `α > 1`), by the decay `sw_decay`. -/
theorem IsHomogeneousCZKernel.eLpNorm_tsum_swMax_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ K : ℝ≥0∞, K ≠ ∞ ∧ ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => ∑' ℓ : ℤ, if 0 ≤ ℓ then swMax n α Ω ℓ f x else 0) (ENNReal.ofReal p) ≤
        K * eLpNorm f (ENNReal.ofReal p) := by
  have hα0 : 0 < α := by linarith
  obtain ⟨G, hG, c, hc, hdec⟩ := hΩ.sw_decay hn hα hp
  obtain ⟨S, hSd⟩ : ∃ S, S = ∑' ℓ : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(ℓ : ℝ)|))) :=
    ⟨_, rfl⟩
  have hS : S ≠ ∞ := hSd ▸ tsum_two_rpow_neg_abs_ne_top hc
  refine ⟨G * S, ENNReal.mul_ne_top hG hS, fun f => ?_⟩
  obtain ⟨Cf, hCf⟩ := lj_schwartz_bounded f
  have hm : ∀ ℓ : ℤ, AEMeasurable (fun x => if 0 ≤ ℓ then swMax n α Ω ℓ f x else 0) := by
    intro ℓ
    split_ifs
    · exact hΩ.aemeasurable_swMax hα0 ℓ hp.le (f.memLp _) hCf
    · exact aemeasurable_const
  have hb : ∀ ℓ : ℤ, eLpNorm (fun x => if 0 ≤ ℓ then swMax n α Ω ℓ f x else 0)
      (ENNReal.ofReal p) ≤ G * eLpNorm f (ENNReal.ofReal p) *
        ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(ℓ : ℝ)|))) := by
    intro ℓ
    split_ifs with h
    · rw [abs_of_nonneg (by exact_mod_cast h : (0 : ℝ) ≤ ℓ), mul_right_comm]
      exact hdec ℓ h f
    · simp
  refine (lj_eLpNorm_tsum_le hm hp.le).trans ((ENNReal.tsum_le_tsum hb).trans (le_of_eq ?_))
  rw [ENNReal.tsum_mul_left, ← hSd]
  ring

/-- **The Stein–Wainger maximal estimate (`170712e1.5`)** (§1 of the paper, display (1.5),
cited there from Stein–Wainger; proved along route item 4 of `automation/instructions.md`):
for a homogeneous Calderón–Zygmund kernel `K = Ω(t)/|t|^n` (`n ≥ 1`), `α > 1` and
`1 < p < ∞` there is `C` such that for all Schwartz functions `f`,
`‖sup_{u ∈ ℝ} |𝓗^{(u)} f|‖_p ≤ C ‖f‖_p`. For `u > 0` split
`𝓗^{(u)} = ∑_{ℓ<0} 𝓗^{(u)}_{ℓ-j} + ∑_{ℓ≥0} 𝓗^{(u)}_{ℓ-j}` with `u ∈ J_j`
(`eLpNorm_iSup_shortInterval_small_le`, `eLpNorm_tsum_swMax_le`); `u < 0` by conjugation
(`modulatedSI_neg'`), `u = 0` by `eLpNorm_modulatedSI_zero_le`. -/
theorem IsHomogeneousCZKernel.stein_wainger (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => ⨆ u : ℝ, ‖modulatedSI n α Ω u f x‖ₑ) (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  have hα0 : 0 < α := by linarith
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by simpa using hp.le
  obtain ⟨C₀, hC₀⟩ := hΩ.eLpNorm_modulatedSI_zero_le hn hα0 hp
  obtain ⟨Cs, hCs⟩ := hΩ.eLpNorm_iSup_shortInterval_small_le hn hα0 hp
  obtain ⟨K, hK, hL⟩ := hΩ.eLpNorm_tsum_swMax_le hn hα hp
  set Sm : (Rn n → ℂ) → Rn n → ℝ≥0∞ := fun g x => ⨆ (j : ℤ) (v ∈ shortInterval α j),
    ‖∑' ℓ : ℤ, (if ℓ < 0 then modulatedPiece n α Ω v (ℓ - j) g x else 0)‖ₑ
  set Lg : (Rn n → ℂ) → Rn n → ℝ≥0∞ := fun g x =>
    ∑' ℓ : ℤ, if 0 ≤ ℓ then swMax n α Ω ℓ g x else 0
  have hP : ∀ g : 𝓢(Rn n, ℂ), eLpNorm (fun x => Sm g x + Lg g x) (ENNReal.ofReal p) ≤
      (Cs + K) * eLpNorm g (ENNReal.ofReal p) := fun g =>
    (eLpNorm_add_le (f := Sm g) (g := Lg g) hp1).trans
      ((add_le_add (hCs g) (hL g)).trans_eq (add_mul _ _ _).symm)
  refine ⟨(C₀ + (Cs + K) + (Cs + K)).toNNReal, fun f => ?_⟩
  rw [ENNReal.coe_toNNReal (by finiteness)]
  have hpt : ∀ x, ⨆ u : ℝ, ‖modulatedSI n α Ω u f x‖ₑ ≤ ‖modulatedSI n α Ω 0 f x‖ₑ +
      (Sm f x + Lg f x) + (Sm (conjSchwartz f) x + Lg (conjSchwartz f) x) := by
    intro x
    refine iSup_le fun u => ?_
    rcases lt_trichotomy u 0 with h | h | h
    · have e := hΩ.modulatedSI_neg' hn hα0 (-u) f x
      rw [neg_neg] at e
      rw [e, RCLike.enorm_conj]
      exact (hΩ.enorm_modulatedSI_le_of_pos hn hα0 (conjSchwartz f) x
        (by linarith : 0 < -u)).trans le_add_self
    · subst h; exact le_self_add.trans le_self_add
    · exact (hΩ.enorm_modulatedSI_le_of_pos hn hα0 f x h).trans (le_add_self.trans le_self_add)
  obtain ⟨hTm, hTb⟩ := hC₀ f
  calc eLpNorm (fun x => ⨆ u : ℝ, ‖modulatedSI n α Ω u f x‖ₑ) (ENNReal.ofReal p) volume
      ≤ eLpNorm (fun x => ‖modulatedSI n α Ω 0 f x‖ₑ + (Sm f x + Lg f x) +
          (Sm (conjSchwartz f) x + Lg (conjSchwartz f) x)) (ENNReal.ofReal p) volume :=
        eLpNorm_mono_enorm (hΩ.measurable_iSup_modulatedSI hn hα0 f).aestronglyMeasurable
          fun x => (hpt x).trans_eq' (enorm_eq_self _) |>.trans_eq (enorm_eq_self _).symm
    _ ≤ eLpNorm (fun x => ‖modulatedSI n α Ω 0 f x‖ₑ) (ENNReal.ofReal p) volume +
          eLpNorm (fun x => Sm f x + Lg f x) (ENNReal.ofReal p) volume +
          eLpNorm (fun x => Sm (conjSchwartz f) x + Lg (conjSchwartz f) x)
            (ENNReal.ofReal p) volume :=
        (eLpNorm_add_le (f := fun x => ‖modulatedSI n α Ω 0 f x‖ₑ + (Sm f x + Lg f x))
          (g := fun x => Sm (conjSchwartz f) x + Lg (conjSchwartz f) x) hp1).trans
          (add_le_add (eLpNorm_add_le (f := fun x => ‖modulatedSI n α Ω 0 f x‖ₑ)
            (g := fun x => Sm f x + Lg f x) hp1) le_rfl)
    _ ≤ C₀ * eLpNorm f (ENNReal.ofReal p) volume + (Cs + K) * eLpNorm f (ENNReal.ofReal p) +
          (Cs + K) * eLpNorm f (ENNReal.ofReal p) := by
        refine add_le_add (add_le_add ?_ (hP f)) ((hP _).trans_eq ?_)
        · rw [eLpNorm_enorm _ hTm.aestronglyMeasurable]; exact hTb
        · rw [eLpNorm_conjSchwartz]
    _ = ((C₀ : ℝ≥0∞) + (Cs + K) + (Cs + K)) * eLpNorm f (ENNReal.ofReal p) volume := by ring

/-- **The oscillation hypothesis of Prop 1.5 from (`170712e1.5`)** (§1.2: "by interpolation with
the inequality (1.5) of Stein and Wainger"): `‖sup_j V^∞_{J_j}(𝓗 f)‖_p ≤ 2C ‖f‖_p`, since
`V^∞_{J_j}(a) ≤ 2 sup_u |a(u)|`. This is hypothesis (`h1`) of
`shortVariation_bound_of_interpolation`. -/
theorem IsHomogeneousCZKernel.eLpNorm_iSup_oscillation_le (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => ⨆ j, oscillation (shortInterval α j)
        (fun u => modulatedSI n α Ω u f x)) (ENNReal.ofReal p) ≤
          C * eLpNorm f (ENNReal.ofReal p) := by
  have hα0 : 0 < α := by linarith
  obtain ⟨C, hC⟩ := hΩ.stein_wainger hn hα hp
  refine ⟨2 * C, fun f => ?_⟩
  have hm := hΩ.measurable_iSup_modulatedSI hn hα0 f
  have hpt : ∀ x, ⨆ j, oscillation (shortInterval α j) (fun u => modulatedSI n α Ω u f x) ≤
      2 * ⨆ u : ℝ, ‖modulatedSI n α Ω u f x‖ₑ := by
    intro x
    refine iSup_le fun j => iSup₂_le fun u _ => iSup₂_le fun v _ => ?_
    rw [two_mul]
    exact (enorm_sub_le).trans (add_le_add (le_iSup (fun u => ‖modulatedSI n α Ω u f x‖ₑ) u)
      (le_iSup (fun u => ‖modulatedSI n α Ω u f x‖ₑ) v))
  calc eLpNorm (fun x => ⨆ j, oscillation (shortInterval α j)
        (fun u => modulatedSI n α Ω u f x)) (ENNReal.ofReal p)
      ≤ eLpNorm (fun x => 2 * ⨆ u : ℝ, ‖modulatedSI n α Ω u f x‖ₑ) (ENNReal.ofReal p) :=
        eLpNorm_mono_enorm ((measurable_iSup_oscillation
          (A := fun x u => modulatedSI n α Ω u f x) (fun u => hΩ.measurable_modulatedSI hn hα0 u f)
          (fun x => hΩ.continuous_modulatedSI hn hα0 f x) hα0).aestronglyMeasurable)
          fun x => (hpt x).trans_eq' (enorm_eq_self _) |>.trans_eq (enorm_eq_self _).symm
    _ = 2 * eLpNorm (fun x => ⨆ u : ℝ, ‖modulatedSI n α Ω u f x‖ₑ) (ENNReal.ofReal p) :=
        lj_eLpNorm_const_mul _ hm.aemeasurable (by linarith)
    _ ≤ 2 * (C * eLpNorm f (ENNReal.ofReal p)) := by gcongr; exact hC f
    _ = ((2 * C : ℝ≥0) : ℝ≥0∞) * eLpNorm f (ENNReal.ofReal p) := by push_cast; ring

/-- **Proposition 1.5 (`main2`) at small `p`, conditional only on the large-`p` estimate**:
`shortVariation_bound_of_interpolation` with its hypothesis (`h1`) discharged by the
Stein–Wainger estimate (`eLpNorm_iSup_oscillation_le`). -/
theorem IsHomogeneousCZKernel.shortVariation_bound_of_large_p
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {pA rA : ℝ}
    (hpA : 1 < pA) (hrA : 1 ≤ rA)
    (h0 : ∀ p₀ r₀ : ℝ, pA < p₀ → rA < r₀ → ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => shortVariation r₀ α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p₀) ≤ C * eLpNorm f (ENNReal.ofReal p₀))
    {p r : ℝ} (hp : 1 < p) (hr : rA < r) (hpr : (1 - 1 / pA) * rA < (1 - 1 / p) * r) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) :=
  hΩ.shortVariation_bound_of_interpolation hn hα hpA hrA h0
    (fun _ hp₁ => hΩ.eLpNorm_iSup_oscillation_le hn hα hp₁) hp hr hpr

end SteinWaingerMain

section MainTheorem

/-! ### Theorem 1.1

Prop 1.5 (`main2`) in full (all `r > max(2, p'/n)`; for `n ≥ 2` also `r = 2` when
`p > 2n/(2n-1)`), and Theorem 1.1 (`main`). -/

variable {n : ℕ} {Ω : Rn n → ℝ}

/-- Arithmetic of the interpolation region for Prop 1.5: with `p_A = 2n/(2n-1)` and `r_A = 2`
the condition `(1 - 1/p_A) r_A < (1 - 1/p) r` is `p'/n < r`. -/
lemma main2_region_iff {n : ℕ} (hn : 1 ≤ n) {p r : ℝ} (hp : 1 < p)
    (hrp : p / (p - 1) / n < r) :
    (1 - 1 / (2 * (n : ℝ) / (2 * n - 1))) * 2 < (1 - 1 / p) * r := by
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hp1 : 0 < p - 1 := by linarith
  have h2n : 0 < 2 * (n : ℝ) - 1 := by linarith
  have hlhs : (1 - 1 / (2 * (n : ℝ) / (2 * n - 1))) * 2 = 1 / n := by
    field_simp
    ring
  have hrhs : (1 - 1 / p) * r = (p - 1) / p * r := by
    field_simp
  rw [hlhs, hrhs]
  have hpos : 0 < (p - 1) / p := div_pos hp1 (by linarith)
  have : p / (p - 1) / n * ((p - 1) / p) = 1 / n := by
    field_simp
  calc (1 : ℝ) / n = p / (p - 1) / n * ((p - 1) / p) := this.symm
    _ < r * ((p - 1) / p) := by gcongr
    _ = (p - 1) / p * r := by ring

/-- **Proposition 1.5** (`main2`, §1.2 of the paper). Let `n ≥ 1`, `α > 1`, `p ∈ (1, ∞)` and
`r ∈ (2, ∞)` with `r > p'/n`. Then `‖S_r(𝓗f)‖_p ≲ ‖f‖_p` for Schwartz `f`, where
`S_r(𝓗f) = (∑_j V^r{𝓗^{(u)}f : u ∈ [2^{jα}, 2^{(j+1)α}]}^r)^{1/r}` (`shortVariation`). -/
theorem IsHomogeneousCZKernel.main2 (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ}
    (hα : 1 < α) {p r : ℝ} (hp : 1 < p) (hr : 2 < r) (hrp : p / (p - 1) / n < r) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hpA : 1 < 2 * (n : ℝ) / (2 * n - 1) := by
    rw [lt_div_iff₀ (by linarith)]; linarith
  refine hΩ.shortVariation_bound_of_large_p hn hα hpA (by norm_num) ?_ hp hr
    (main2_region_iff hn hp hrp)
  intro p₀ r₀ hp₀ hr₀
  rcases Nat.lt_or_ge n 2 with h1 | h2
  · obtain rfl : n = 1 := by omega
    have hp₀' : 2 < p₀ := by norm_num at hp₀; exact hp₀
    exact hΩ.eLpNorm_shortVariation_le_n_one_nnreal hα hr₀ hp₀'
  · exact hΩ.eLpNorm_shortVariation_le_of_two_le_n_all_nnreal h2 hα hr₀.le hp₀

/-- **Theorem 1.1** (`main`), first part, estimate (`170614e1.2`). Let `n ≥ 1`, `α ∈ (1, ∞)`,
let `K = Ω(x)/|x|ⁿ` be a homogeneous Calderón–Zygmund kernel (`IsHomogeneousCZKernel`), and
`𝓗^{(u)} f(x) = p.v. ∫ f(x-t) e^{iu|t|^α} K(t) dt`. If `r ∈ (2, ∞)`, `p ∈ (1, ∞)` and
`r > p'/n`, then `‖V^r{𝓗^{(u)}f : u ∈ ℝ}‖_p ≤ C ‖f‖_p` for all Schwartz functions `f`, with `C`
independent of `f`. -/
theorem IsHomogeneousCZKernel.thm_1_1_variation (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n)
    {α : ℝ} (hα : 1 < α) {p r : ℝ} (hr : 2 < r) (hp : 1 < p) (hrp : p / (p - 1) / n < r) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => variationNorm r Set.univ (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume :=
  hΩ.thm_1_1_variation_of_short hn hα hp hr (hΩ.main2 hn hα hp hr hrp)

/-- **Theorem 1.1** (`main`), second part. If `n ≥ 2` and `p ∈ (2n/(2n-1), ∞)`, then
`‖λ √(N_λ{𝓗^{(u)} f : u ∈ ℝ})‖_p ≤ C ‖f‖_p` for all Schwartz `f` and all `λ > 0`, with `C`
independent of `f` and `λ`. -/
theorem IsHomogeneousCZKernel.thm_1_1_jump (hΩ : IsHomogeneousCZKernel n Ω) (hn : 2 ≤ n)
    {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 2 * (n : ℝ) / (2 * n - 1) < p) :
    ∃ C : ℝ≥0, ∀ f : 𝓢(Rn n, ℂ), ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam *
          jumpFunction lam Set.univ (fun u => modulatedSI n α Ω u f x) ^ (1 / 2 : ℝ))
        (ENNReal.ofReal p) volume ≤ C * eLpNorm f (ENNReal.ofReal p) volume := by
  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
  have hp1 : 1 < p := by
    have : 1 < 2 * (n : ℝ) / (2 * n - 1) := by
      rw [lt_div_iff₀ (by linarith)]; linarith
    linarith
  exact hΩ.thm_1_1_jump_of_short (by omega) hα hp1
    (hΩ.eLpNorm_shortVariation_le_of_two_le_n_all_nnreal hn hα le_rfl hp)

end MainTheorem

