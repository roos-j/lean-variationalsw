noncomputable section

/-! ## The convolution operator with an operator-valued kernel -/

section Operator

variable {n : ℕ} {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]

/-- The evaluation pairing `(L, v) ↦ L v`, as a continuous bilinear map; convolution with
respect to it is the convolution of an operator-valued kernel with a vector-valued function. -/
def vczPair (E F : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E] [NormedAddCommGroup F]
    [NormedSpace ℂ F] : (E →L[ℂ] F) →L[ℂ] E →L[ℂ] F :=
  ContinuousLinearMap.id ℂ (E →L[ℂ] F)

omit [CompleteSpace E] [CompleteSpace F] in
@[simp]
lemma vczPair_apply (L : E →L[ℂ] F) (v : E) : vczPair E F L v = L v := rfl

omit [CompleteSpace E] [CompleteSpace F] in
/-- The convolution in the form `K * f(x) = ∫ K(x - y) f(y) dy`. -/
lemma vcz_convolution_eq (K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F)
    (f : EuclideanSpace ℝ (Fin n) → E) (x : EuclideanSpace ℝ (Fin n)) :
    (K ⋆[vczPair E F, volume] f) x = ∫ y, K (x - y) (f y) := by
  rw [convolution_def]
  rw [← integral_sub_left_eq_self (fun y => K (x - y) (f y)) (μ := volume) x]
  simp only [sub_sub_cancel, vczPair_apply]

omit [CompleteSpace E] [CompleteSpace F] in
/-- The convolution integrand is integrable as soon as its `lintegral` majorant is finite. -/
lemma vcz_convolutionExistsAt_of_lintegral_lt_top {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F}
    {f : EuclideanSpace ℝ (Fin n) → E} (hK : AEStronglyMeasurable K)
    (hf : AEStronglyMeasurable f) {x : EuclideanSpace ℝ (Fin n)}
    (h : ∫⁻ y, ‖K y‖ₑ * ‖f (x - y)‖ₑ < ∞) :
    ConvolutionExistsAt K f x (vczPair E F) volume := by
  refine ⟨hK.convolution_integrand_snd (vczPair E F) hf x, ?_⟩
  refine lt_of_le_of_lt (lintegral_mono fun y => ?_) h
  simp only [vczPair_apply]
  exact ContinuousLinearMap.le_opENorm _ _

omit [CompleteSpace E] [CompleteSpace F] in
/-- Young: for `K ∈ L¹` and `f ∈ L^p` (`1 ≤ p ≤ ∞`) the convolution integral converges
absolutely almost everywhere. -/
theorem vcz_ae_convolutionExistsAt {p : ℝ≥0∞} (hp : 1 ≤ p)
    {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {f : EuclideanSpace ℝ (Fin n) → E}
    (hK : Integrable K) (hf : MemLp f p volume) :
    ∀ᵐ x, ConvolutionExistsAt K f x (vczPair E F) volume := by
  have hK1 : MemLp K 1 volume := memLp_one_iff_integrable.2 hK
  have hfin : eLpNorm K 1 volume * eLpNorm f p volume < ∞ := ENNReal.mul_lt_top hK1 hf
  rcases eq_or_ne p ∞ with rfl | hpt
  · exact Eventually.of_forall fun x =>
      vcz_convolutionExistsAt_of_lintegral_lt_top hK.1 hf.aestronglyMeasurable
        ((lintegral_enorm_mul_sub_le_top hK.1 hf.aestronglyMeasurable x).trans_lt hfin)
  have hp0 : p ≠ 0 := (lt_of_lt_of_le zero_lt_one hp).ne'
  have hr : 0 < p.toReal := ENNReal.toReal_pos hp0 hpt
  have hI := (eLpNorm_lintegral_enorm_mul_sub_le hp hK.1 hf.aestronglyMeasurable).trans_lt hfin
  have hint := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top hp0 hpt hI
  simp only [enorm_eq_self] at hint
  have hae := ae_lt_top' ((aemeasurable_lintegral_mul_sub hK.1.enorm
    hf.aestronglyMeasurable.enorm).pow_const p.toReal) hint.ne
  filter_upwards [hae] with x hx
  exact vcz_convolutionExistsAt_of_lintegral_lt_top hK.1 hf.aestronglyMeasurable
    ((ENNReal.rpow_lt_top_iff_of_pos hr).1 hx)

omit [CompleteSpace E] [CompleteSpace F] in
lemma vcz_integrable_of_convolutionExistsAt {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F}
    {f : EuclideanSpace ℝ (Fin n) → E} {x : EuclideanSpace ℝ (Fin n)}
    (h : ConvolutionExistsAt K f x (vczPair E F) volume) :
    Integrable (fun y => K (x - y) (f y)) := by
  have := (show Integrable (fun t => vczPair E F (K t) (f (x - t))) volume from h).comp_sub_left x
  simpa [sub_sub_cancel] using this


end Operator

/-! ## The vector-valued Calderón–Zygmund decomposition -/

section Decomposition

variable {n : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- The scalar function `y ↦ ‖f y‖` (as a complex function); the dyadic Calderón–Zygmund
selection of the scalar development is performed on it. -/
def vczNorm (f : EuclideanSpace ℝ (Fin n) → E) : EuclideanSpace ℝ (Fin n) → ℂ :=
  fun y => ((‖f y‖ : ℝ) : ℂ)

omit [NormedSpace ℂ E] in
@[simp]
lemma vcz_enorm_ofReal_norm (v : E) : ‖((‖v‖ : ℝ) : ℂ)‖ₑ = ‖v‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm, Complex.norm_real, norm_norm]

omit [NormedSpace ℂ E] in
@[simp]
lemma enorm_vczNorm (f : EuclideanSpace ℝ (Fin n) → E) (y : EuclideanSpace ℝ (Fin n)) :
    ‖vczNorm f y‖ₑ = ‖f y‖ₑ := by
  rw [vczNorm, ← ofReal_norm, ← ofReal_norm, Complex.norm_real, norm_norm]

omit [NormedSpace ℂ E] in
lemma integrable_vczNorm {f : EuclideanSpace ℝ (Fin n) → E} (hf : Integrable f) :
    Integrable (vczNorm f) :=
  hf.norm.ofReal

omit [NormedSpace ℂ E] in
lemma lintegral_vczNorm_ne_top {f : EuclideanSpace ℝ (Fin n) → E} (hf : Integrable f) :
    ∫⁻ y, ‖vczNorm f y‖ₑ ≠ ∞ := by
  simp only [enorm_vczNorm]; exact hf.2.ne

/-- The average `f_Q = |Q|⁻¹ ∫_Q f` of a vector-valued `f` over the dyadic cube `p`. -/
def vczAvg (f : EuclideanSpace ℝ (Fin n) → E) (p : ℤ × (Fin n → ℤ)) : E :=
  (volume (czCube p)).toReal⁻¹ • ∫ y in czCube p, f y

open Classical in
/-- The vector-valued Calderón–Zygmund good part at height `s`: `g = f` off the exceptional set
`Ω = czBadSet ‖f‖ s`, and `g = f_Q` on each selected (maximal bad) dyadic cube `Q`. -/
def vczGood (f : EuclideanSpace ℝ (Fin n) → E) (s : ℝ) : EuclideanSpace ℝ (Fin n) → E :=
  (czBadSet (vczNorm f) s).piecewise (fun x => vczAvg f (czSel (vczNorm f) s x)) f

variable {f : EuclideanSpace ℝ (Fin n) → E} {s : ℝ}


lemma vczGood_of_notMem {x : EuclideanSpace ℝ (Fin n)} (hx : x ∉ czBadSet (vczNorm f) s) :
    vczGood f s x = f x := by
  classical
  simp [vczGood, Set.piecewise_eq_of_notMem _ _ _ hx]


lemma vczGood_of_mem {x : EuclideanSpace ℝ (Fin n)} (hx : x ∈ czBadSet (vczNorm f) s) :
    vczGood f s x = vczAvg f (czSel (vczNorm f) s x) := by
  classical
  simp [vczGood, Set.piecewise_eq_of_mem _ _ _ hx]


/-- `‖f_Q‖ |Q| ≤ ∫_Q ‖f‖`. -/
lemma enorm_vczAvg_mul_le (p : ℤ × (Fin n → ℤ)) :
    ‖vczAvg f p‖ₑ * volume (czCube p) ≤ ∫⁻ y in czCube p, ‖f y‖ₑ := by
  have h0 := volume_czCube_ne_zero p
  have ht := volume_czCube_ne_top p
  have hpos : 0 < (volume (czCube p)).toReal := ENNReal.toReal_pos h0 ht
  rw [vczAvg, enorm_smul, Real.enorm_eq_ofReal (inv_pos.2 hpos).le,
    ENNReal.ofReal_inv_of_pos hpos, ENNReal.ofReal_toReal ht]
  calc (volume (czCube p))⁻¹ * ‖∫ y in czCube p, f y‖ₑ * volume (czCube p)
      = ‖∫ y in czCube p, f y‖ₑ * ((volume (czCube p))⁻¹ * volume (czCube p)) := by ring
    _ = ‖∫ y in czCube p, f y‖ₑ := by rw [ENNReal.inv_mul_cancel h0 ht, mul_one]
    _ ≤ ∫⁻ y in czCube p, ‖f y‖ₑ := enorm_integral_le_lintegral_enorm _

/-- `∫_Q f_Q = ∫_Q f`. -/
lemma setIntegral_vczAvg [CompleteSpace E] (p : ℤ × (Fin n → ℤ)) :
    ∫ _ in czCube p, vczAvg f p = ∫ y in czCube p, f y := by
  have hpos : 0 < (volume (czCube p)).toReal :=
    ENNReal.toReal_pos (volume_czCube_ne_zero p) (volume_czCube_ne_top p)
  rw [setIntegral_const, vczAvg, smul_smul, Measure.real, mul_inv_cancel₀ hpos.ne', one_smul]

variable (hn : 0 < n) (hs : 0 < s) (hfi : Integrable f)
include hn hs hfi

omit [NormedSpace ℂ E] in
lemma measurableSet_vczBadSet : MeasurableSet (czBadSet (vczNorm f) s) :=
  measurableSet_czBadSet hn hs (lintegral_vczNorm_ne_top hfi)


lemma vczGood_of_mem_czCube {p : ℤ × (Fin n → ℤ)} (hp : p ∈ czIdx (vczNorm f) s)
    {y : EuclideanSpace ℝ (Fin n)} (hy : y ∈ czCube p) : vczGood f s y = vczAvg f p := by
  obtain ⟨hyΩ, hsel⟩ := czSel_eq_of_mem_czIdx hn hs (lintegral_vczNorm_ne_top hfi) hp hy
  rw [vczGood_of_mem hyΩ, hsel]


/-- On a selected cube, `‖f_Q‖ ≤ 2^n s`. -/
lemma enorm_vczAvg_le {p : ℤ × (Fin n → ℤ)} (hp : p ∈ czIdx (vczNorm f) s) :
    ‖vczAvg f p‖ₑ ≤ 2 ^ n * ENNReal.ofReal s := by
  have h1 := setLIntegral_czCube_le hn hs (lintegral_vczNorm_ne_top hfi) hp
  simp only [enorm_vczNorm] at h1
  have h := (enorm_vczAvg_mul_le (f := f) p).trans h1
  exact (ENNReal.mul_le_mul_iff_left (volume_czCube_ne_zero p) (volume_czCube_ne_top p)).1 h


/-- The good part is strongly measurable (for strongly measurable `f`). -/
lemma stronglyMeasurable_vczGood (hfm : StronglyMeasurable f) :
    StronglyMeasurable (vczGood f s) := by
  classical
  set Ω := czBadSet (vczNorm f) s with hΩ_def
  have hΩ : MeasurableSet Ω := measurableSet_vczBadSet hn hs hfi
  set h : EuclideanSpace ℝ (Fin n) → E := Ω.indicator fun x => vczAvg f (czSel (vczNorm f) s x)
  have hh : StronglyMeasurable h := by
    let _ : MeasurableSpace E := borel E
    have _ : BorelSpace E := ⟨rfl⟩
    refine stronglyMeasurable_iff_measurable_separable.2 ⟨fun U _ => ?_, ?_⟩
    · have hA : h ⁻¹' U ∩ Ω = ⋃ p ∈ czIdx (vczNorm f) s ∩ {p | vczAvg f p ∈ U}, czCube p := by
        ext x
        simp only [mem_inter_iff, mem_preimage, mem_iUnion, exists_prop, mem_ofPred_eq]
        constructor
        · rintro ⟨hxU, hx⟩
          rw [show h x = _ from indicator_of_mem hx _] at hxU
          exact ⟨czSel (vczNorm f) s x, ⟨⟨x, hx, rfl⟩, hxU⟩, mem_czCube_self _ x⟩
        · rintro ⟨p, ⟨hp, hpU⟩, hx⟩
          obtain ⟨hxΩ, hsel⟩ :=
            czSel_eq_of_mem_czIdx hn hs (lintegral_vczNorm_ne_top hfi) hp hx
          refine ⟨?_, hxΩ⟩
          rw [show h x = _ from indicator_of_mem hxΩ _, hsel]; exact hpU
      have hB : h ⁻¹' U ∩ Ωᶜ = Ωᶜ ∩ {_x | (0 : E) ∈ U} := by
        ext x
        simp only [mem_inter_iff, mem_preimage, mem_compl_iff, mem_ofPred_eq]
        constructor
        · rintro ⟨hxU, hx⟩
          rw [show h x = 0 from indicator_of_notMem hx _] at hxU
          exact ⟨hx, hxU⟩
        · rintro ⟨hx, hxU⟩
          rw [show h x = 0 from indicator_of_notMem hx _]
          exact ⟨hxU, hx⟩
      rw [← inter_union_compl (h ⁻¹' U) Ω, hA, hB]
      exact (measurableSet_biUnion_czCube _).union (hΩ.compl.inter (MeasurableSet.const _))
    · refine ((Set.Countable.insert 0
        ((czIdx_countable (f := vczNorm f) (s := s)).image (vczAvg f))).isSeparable).mono ?_
      rintro _ ⟨x, rfl⟩
      by_cases hx : x ∈ Ω
      · right
        exact ⟨_, ⟨x, hx, rfl⟩,
          (indicator_of_mem hx (fun x => vczAvg f (czSel (vczNorm f) s x))).symm⟩
      · left
        exact indicator_of_notMem hx _
  have heq : vczGood f s = Ω.piecewise h f := by
    funext x
    by_cases hx : x ∈ Ω
    · rw [Set.piecewise_eq_of_mem _ _ _ hx, vczGood_of_mem hx]
      exact (indicator_of_mem hx (fun x => vczAvg f (czSel (vczNorm f) s x))).symm
    · rw [Set.piecewise_eq_of_notMem _ _ _ hx, vczGood_of_notMem hx]
  rw [heq]
  exact hh.piecewise hΩ hfm

omit [NormedSpace ℂ E] hs in
/-- `‖f‖ ≤ s` almost everywhere off the exceptional set (Lebesgue differentiation). -/
lemma ae_enorm_le_of_notMem_vczBadSet :
    ∀ᵐ x, x ∉ czBadSet (vczNorm f) s → ‖f x‖ₑ ≤ ENNReal.ofReal s := by
  filter_upwards [ae_enorm_le_of_notMem_czBadSet hn (s := s) (integrable_vczNorm hfi)]
    with x hx hxΩ
  simpa using hx hxΩ

/-- `‖g‖ ≤ 2^n s` almost everywhere. -/
lemma ae_enorm_vczGood_le : ∀ᵐ x, ‖vczGood f s x‖ₑ ≤ 2 ^ n * ENNReal.ofReal s := by
  filter_upwards [ae_enorm_le_of_notMem_vczBadSet (s := s) hn hfi] with x hx
  by_cases hxΩ : x ∈ czBadSet (vczNorm f) s
  · rw [vczGood_of_mem hxΩ]
    exact enorm_vczAvg_le hn hs hfi ⟨x, hxΩ, rfl⟩
  · rw [vczGood_of_notMem hxΩ]
    exact (hx hxΩ).trans (le_mul_of_one_le_left zero_le (one_le_pow₀ one_le_two))

/-- `∫_Ω ‖g‖ ≤ ∫_Ω ‖f‖`. -/
lemma setLIntegral_vczGood_le :
    ∫⁻ y in czBadSet (vczNorm f) s, ‖vczGood f s y‖ₑ ≤
      ∫⁻ y in czBadSet (vczNorm f) s, ‖f y‖ₑ := by
  have hf := lintegral_vczNorm_ne_top hfi
  rw [czBadSet_eq_biUnion hn hs hf, lintegral_biUnion czIdx_countable
    (fun p _ => measurableSet_czCube p) (czIdx_pairwiseDisjoint hn hs hf),
    lintegral_biUnion czIdx_countable
    (fun p _ => measurableSet_czCube p) (czIdx_pairwiseDisjoint hn hs hf)]
  refine ENNReal.tsum_le_tsum fun p => ?_
  calc ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ‖vczGood f s y‖ₑ
      = ∫⁻ _ in czCube (p : ℤ × (Fin n → ℤ)), ‖vczAvg f p‖ₑ :=
        setLIntegral_congr_fun (measurableSet_czCube _) fun y hy => by
          rw [vczGood_of_mem_czCube hn hs hfi p.2 hy]
    _ = ‖vczAvg f p‖ₑ * volume (czCube (p : ℤ × (Fin n → ℤ))) := setLIntegral_const _ _
    _ ≤ _ := enorm_vczAvg_mul_le _

/-- `∫ ‖g‖ ≤ ∫ ‖f‖`. -/
lemma lintegral_vczGood_le : ∫⁻ y, ‖vczGood f s y‖ₑ ≤ ∫⁻ y, ‖f y‖ₑ := by
  have hΩ := measurableSet_vczBadSet hn hs hfi
  rw [← lintegral_add_compl _ hΩ, ← lintegral_add_compl (fun y => ‖f y‖ₑ) hΩ]
  refine add_le_add (setLIntegral_vczGood_le hn hs hfi) (le_of_eq ?_)
  exact setLIntegral_congr_fun hΩ.compl fun y hy => by rw [vczGood_of_notMem hy]

/-- `∫ ‖g‖² ≤ 2^n s ∫ ‖f‖`. -/
lemma lintegral_vczGood_sq_le :
    ∫⁻ y, ‖vczGood f s y‖ₑ ^ (2 : ℝ) ≤ 2 ^ n * ENNReal.ofReal s * ∫⁻ y, ‖f y‖ₑ := by
  calc ∫⁻ y, ‖vczGood f s y‖ₑ ^ (2 : ℝ)
      ≤ ∫⁻ y, 2 ^ n * ENNReal.ofReal s * ‖vczGood f s y‖ₑ := by
        refine lintegral_mono_ae ((ae_enorm_vczGood_le hn hs hfi).mono fun y hy => ?_)
        rw [ENNReal.rpow_two, sq]
        exact mul_le_mul_left hy _
    _ = 2 ^ n * ENNReal.ofReal s * ∫⁻ y, ‖vczGood f s y‖ₑ :=
        lintegral_const_mul' _ _ (by simp [ENNReal.mul_eq_top])
    _ ≤ 2 ^ n * ENNReal.ofReal s * ∫⁻ y, ‖f y‖ₑ :=
        mul_le_mul_right (lintegral_vczGood_le hn hs hfi) _

/-- The good part is integrable (for strongly measurable `f`). -/
lemma integrable_vczGood (hfm : StronglyMeasurable f) : Integrable (vczGood f s) :=
  ⟨(stronglyMeasurable_vczGood hn hs hfi hfm).aestronglyMeasurable,
    (lintegral_vczGood_le hn hs hfi).trans_lt hfi.2⟩

/-- The mean-zero property of the bad part: `∫_Q (f - g) = 0` on every selected cube. -/
lemma setIntegral_vczBad_eq_zero [CompleteSpace E] {p : ℤ × (Fin n → ℤ)}
    (hp : p ∈ czIdx (vczNorm f) s) :
    ∫ y in czCube p, (f - vczGood f s) y = 0 := by
  have hg : ∫ y in czCube p, vczGood f s y = ∫ y in czCube p, f y := by
    rw [← setIntegral_vczAvg (f := f) p]
    exact setIntegral_congr_fun (measurableSet_czCube p) fun y hy =>
      vczGood_of_mem_czCube hn hs hfi hp hy
  have hgi : IntegrableOn (vczGood f s) (czCube p) := by
    refine (integrableOn_congr_fun (fun y hy => (vczGood_of_mem_czCube hn hs hfi hp hy).symm)
      (measurableSet_czCube p)).1 ?_
    exact integrableOn_const (volume_czCube_ne_top p)
  simp only [Pi.sub_apply]
  rw [integral_sub hfi.integrableOn hgi, hg, sub_self]

omit hn hs hfi in
/-- The bad part vanishes off `Ω`. -/
lemma vczBad_eq_zero_of_notMem {x : EuclideanSpace ℝ (Fin n)}
    (hx : x ∉ czBadSet (vczNorm f) s) : (f - vczGood f s) x = 0 := by
  simp [vczGood_of_notMem hx]

end Decomposition

/-! ## The weak type `(1,1)` estimate -/

section WeakOne

variable {n : ℕ} {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]

/-- The Hörmander condition `∫_{|x| > 2|y|} ‖K(x - y) - K(x)‖ dx ≤ A` (for all `y`), with
constant `A`, for an operator-valued kernel `K`. -/
def VczHormander (K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F) (A : ℝ) : Prop :=
  ∀ y : EuclideanSpace ℝ (Fin n),
    ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖}, ‖K (x - y) - K x‖ₑ ≤ ENNReal.ofReal A

omit [CompleteSpace E] [CompleteSpace F] in
/-- The Hörmander condition, centered at `c`: for `|y - c| ≤ δ`,
`∫_{|x - c| > 2δ} ‖K(x - y) - K(x - c)‖ dx ≤ A`. -/
lemma vcz_lintegral_compl_closedBall_le {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ}
    (hH : VczHormander K A) {y c : EuclideanSpace ℝ (Fin n)} {δ : ℝ} (hy : ‖y - c‖ ≤ δ) :
    ∫⁻ x in (closedBall c (2 * δ))ᶜ, ‖K (x - y) - K (x - c)‖ₑ ≤ ENNReal.ofReal A := by
  rw [← lintegral_indicator measurableSet_closedBall.compl,
    ← lintegral_add_right_eq_self _ c]
  refine le_trans ?_ (hH (y - c))
  rw [← lintegral_indicator (measurableSet_lt measurable_const continuous_norm.measurable)]
  refine lintegral_mono fun x => ?_
  by_cases hx : x + c ∈ (closedBall c (2 * δ))ᶜ
  · have h2 : 2 * δ < ‖x‖ := by
      simpa [mem_closedBall, dist_eq_norm] using hx
    have hx' : x ∈ {x : EuclideanSpace ℝ (Fin n) | 2 * ‖y - c‖ < ‖x‖} := by
      change 2 * ‖y - c‖ < ‖x‖
      linarith
    rw [indicator_of_mem hx, indicator_of_mem hx', add_sub_cancel_right,
      show x + c - y = x - (y - c) by abel]
  · rw [indicator_of_notMem hx]; exact zero_le

/-- Chebyshev: `μ{τ < ‖u‖} ≤ τ⁻¹ ∫ ‖u‖`. -/
lemma vcz_measure_lt_norm_le_lintegral {α G : Type*} [MeasurableSpace α] {μ : Measure α}
    [NormedAddCommGroup G] {u : α → G} (hu : AEStronglyMeasurable u μ) {τ : ℝ} (hτ : 0 < τ) :
    μ {x | τ < ‖u x‖} ≤ ENNReal.ofReal τ⁻¹ * ∫⁻ x, ‖u x‖ₑ ∂μ := by
  refine (measure_mono fun x (hx : τ < ‖u x‖) => (show ENNReal.ofReal τ ≤ ‖u x‖ₑ by
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hx.le)).trans
    ((meas_ge_le_lintegral_div hu.enorm (ENNReal.ofReal_pos.2 hτ).ne'
      ENNReal.ofReal_ne_top).trans_eq ?_)
  rw [div_eq_mul_inv, mul_comm, ENNReal.ofReal_inv_of_pos hτ]

/-- Chebyshev: `μ{τ < ‖u‖} ≤ τ⁻² ∫ ‖u‖²`. -/
lemma vcz_measure_lt_norm_le_lintegral_sq {α G : Type*} [MeasurableSpace α] {μ : Measure α}
    [NormedAddCommGroup G] {u : α → G} (hu : AEStronglyMeasurable u μ) {τ : ℝ} (hτ : 0 < τ) :
    μ {x | τ < ‖u x‖} ≤ ENNReal.ofReal (τ ^ 2)⁻¹ * ∫⁻ x, ‖u x‖ₑ ^ (2 : ℝ) ∂μ := by
  have hτ2 : 0 < τ ^ 2 := by positivity
  refine (measure_mono fun x (hx : τ < ‖u x‖) =>
    (show ENNReal.ofReal (τ ^ 2) ≤ ‖u x‖ₑ ^ (2 : ℝ) by
      rw [← ofReal_norm, ENNReal.rpow_two, ← ENNReal.ofReal_pow (norm_nonneg _)]
      exact ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ hτ.le hx.le 2))).trans
    ((meas_ge_le_lintegral_div (hu.enorm.pow_const _) (ENNReal.ofReal_pos.2 hτ2).ne'
      ENNReal.ofReal_ne_top).trans_eq ?_)
  rw [div_eq_mul_inv, mul_comm, ENNReal.ofReal_inv_of_pos hτ2]

section Bad

variable {f : EuclideanSpace ℝ (Fin n) → E} {s : ℝ}
variable (hn : 0 < n) (hs : 0 < s) (hfi : Integrable f) (hfm : StronglyMeasurable f)
include hn hs hfi hfm

/-- Cancellation: `‖K * b(x)‖ ≤ ∑_Q ∫_Q ‖K(x - y) - K(x - c_Q)‖ ‖b(y)‖ dy` wherever the
convolution integral converges. -/
lemma vcz_enorm_convolution_bad_le {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F}
    {x : EuclideanSpace ℝ (Fin n)}
    (hconv : ConvolutionExistsAt K (f - vczGood f s) x (vczPair E F) volume) :
    ‖(K ⋆[vczPair E F, volume] (f - vczGood f s)) x‖ₑ ≤
      ∑' p : czIdx (vczNorm f) s, ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)),
        ‖K (x - y) - K (x - czCorner p)‖ₑ * ‖(f - vczGood f s) y‖ₑ := by
  have hf := lintegral_vczNorm_ne_top hfi
  set b := f - vczGood f s with hb_def
  have hbi : Integrable b := hfi.sub (integrable_vczGood hn hs hfi hfm)
  have hint := vcz_integrable_of_convolutionExistsAt hconv
  rw [vcz_convolution_eq,
    ← setIntegral_eq_integral_of_forall_compl_eq_zero (s := czBadSet (vczNorm f) s)
      (fun y hy => by simp only [hb_def]; rw [vczBad_eq_zero_of_notMem hy, map_zero]),
    czBadSet_eq_biUnion hn hs hf, biUnion_eq_iUnion,
    integral_iUnion (fun p => measurableSet_czCube _)
      (fun (p q : czIdx (vczNorm f) s) hpq => czIdx_pairwiseDisjoint hn hs hf p.2 q.2
        (Subtype.coe_injective.ne hpq)) hint.integrableOn]
  refine enorm_tsum_le_tsum_enorm.trans (ENNReal.tsum_le_tsum fun p => ?_)
  have hzero := setIntegral_vczBad_eq_zero hn hs hfi p.2
  set c := czCorner (p : ℤ × (Fin n → ℤ))
  have h2 : Integrable (fun y => K (x - c) (b y))
      (volume.restrict (czCube (p : ℤ × (Fin n → ℤ)))) :=
    (K (x - c)).integrable_comp hbi.integrableOn
  have heq' : ∫ y in czCube (p : ℤ × (Fin n → ℤ)), (K (x - y) - K (x - c)) (b y) =
      (∫ y in czCube (p : ℤ × (Fin n → ℤ)), K (x - y) (b y)) -
        ∫ y in czCube (p : ℤ × (Fin n → ℤ)), K (x - c) (b y) := by
    simp_rw [sub_apply]
    exact integral_sub hint.integrableOn h2
  have heq : ∫ y in czCube (p : ℤ × (Fin n → ℤ)), K (x - y) (b y) =
      ∫ y in czCube (p : ℤ × (Fin n → ℤ)), (K (x - y) - K (x - c)) (b y) := by
    rw [heq', (K (x - c)).integral_comp_comm hbi.integrableOn, hzero, map_zero, sub_zero]
  rw [heq]
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun y => ?_)
  exact ContinuousLinearMap.le_opENorm _ _

/-- The bad part estimate off the enlarged exceptional set:
`∫_{E ∖ Ω*} ‖K * b‖ ≤ A ∫ ‖b‖`. -/
theorem vcz_lintegral_compl_czStar_le {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ}
    (hKm : StronglyMeasurable K) (hK : Integrable K) (hH : VczHormander K A) :
    ∫⁻ x in (czStar (vczNorm f) s)ᶜ, ‖(K ⋆[vczPair E F, volume] (f - vczGood f s)) x‖ₑ ≤
      ENNReal.ofReal A * ∫⁻ y, ‖(f - vczGood f s) y‖ₑ := by
  have hf := lintegral_vczNorm_ne_top hfi
  set b := f - vczGood f s with hb_def
  have hbm : StronglyMeasurable b := hfm.sub (stronglyMeasurable_vczGood hn hs hfi hfm)
  have hbi : Integrable b := hfi.sub (integrable_vczGood hn hs hfi hfm)
  have hG : ∀ c : EuclideanSpace ℝ (Fin n), Measurable fun z : EuclideanSpace ℝ (Fin n) ×
      EuclideanSpace ℝ (Fin n) => ‖K (z.1 - z.2) - K (z.1 - c)‖ₑ * ‖b z.2‖ₑ := fun c =>
    ((hKm.comp_measurable (measurable_fst.sub measurable_snd)).sub
      (hKm.comp_measurable (measurable_fst.sub_const c))).enorm.mul
      (hbm.comp_measurable measurable_snd).enorm
  set G : czIdx (vczNorm f) s → EuclideanSpace ℝ (Fin n) → ℝ≥0∞ := fun p x =>
    ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ‖K (x - y) - K (x - czCorner p)‖ₑ * ‖b y‖ₑ
  have hGm : ∀ p, Measurable (G p) := fun p => (hG (czCorner p)).lintegral_prod_right'
  have hae : ∀ᵐ x, ‖(K ⋆[vczPair E F, volume] b) x‖ₑ ≤ ∑' p, G p x := by
    filter_upwards [vcz_ae_convolutionExistsAt le_rfl hK (memLp_one_iff_integrable.2 hbi)]
      with x hx
    exact vcz_enorm_convolution_bad_le hn hs hfi hfm hx
  set C := ENNReal.ofReal A
  calc ∫⁻ x in (czStar (vczNorm f) s)ᶜ, ‖(K ⋆[vczPair E F, volume] b) x‖ₑ
      ≤ ∫⁻ x in (czStar (vczNorm f) s)ᶜ, ∑' p, G p x := lintegral_mono_ae (ae_restrict_of_ae hae)
    _ = ∑' p, ∫⁻ x in (czStar (vczNorm f) s)ᶜ, G p x :=
        lintegral_tsum fun p => (hGm p).aemeasurable
    _ ≤ ∑' p : czIdx (vczNorm f) s, C * ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ‖b y‖ₑ := by
        refine ENNReal.tsum_le_tsum fun p => ?_
        set c := czCorner (p : ℤ × (Fin n → ℤ))
        set δ := Real.sqrt n * (2 : ℝ) ^ (p : ℤ × (Fin n → ℤ)).1
        have hsub : (czStar (vczNorm f) s)ᶜ ⊆ (closedBall c (2 * δ))ᶜ :=
          compl_subset_compl.2 (subset_biUnion_of_mem (u := fun p : ℤ × (Fin n → ℤ) =>
            closedBall (czCorner p) (2 * (Real.sqrt n * (2 : ℝ) ^ p.1))) p.2)
        calc ∫⁻ x in (czStar (vczNorm f) s)ᶜ, G p x
            ≤ ∫⁻ x in (closedBall c (2 * δ))ᶜ, G p x := lintegral_mono_set hsub
          _ = ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ∫⁻ x in (closedBall c (2 * δ))ᶜ,
                ‖K (x - y) - K (x - c)‖ₑ * ‖b y‖ₑ :=
              lintegral_lintegral_swap (hG c).aemeasurable
          _ = ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)),
                (∫⁻ x in (closedBall c (2 * δ))ᶜ, ‖K (x - y) - K (x - c)‖ₑ) * ‖b y‖ₑ := by
              refine lintegral_congr fun y => ?_
              exact lintegral_mul_const _ (((hKm.comp_measurable
                (measurable_id.sub_const y)).sub (hKm.comp_measurable
                (measurable_id.sub_const c))).enorm)
          _ ≤ ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), C * ‖b y‖ₑ := by
              refine setLIntegral_mono' (measurableSet_czCube _) fun y hy => ?_
              exact mul_le_mul_left (vcz_lintegral_compl_closedBall_le hH
                (norm_sub_le_of_mem_czCube hy (czCorner_mem _))) _
          _ = C * ∫⁻ y in czCube (p : ℤ × (Fin n → ℤ)), ‖b y‖ₑ :=
              lintegral_const_mul _ hbm.enorm
    _ = C * ∫⁻ y in ⋃ p ∈ czIdx (vczNorm f) s, czCube p, ‖b y‖ₑ := by
        rw [ENNReal.tsum_mul_left, lintegral_biUnion czIdx_countable
          (fun p _ => measurableSet_czCube p) (czIdx_pairwiseDisjoint hn hs hf)]
    _ ≤ C * ∫⁻ y, ‖b y‖ₑ := mul_le_mul_right (setLIntegral_le_lintegral _ _) _

end Bad

/-- The constant `C_n = (4√n)^n + 4·2^n + 4` of the weak type `(1,1)` bound. -/
def vczWeakConst (n : ℕ) : ℝ := (4 * Real.sqrt n) ^ n + 4 * 2 ^ n + 4

lemma vczWeakConst_pos (n : ℕ) : 0 < vczWeakConst n := by
  unfold vczWeakConst; positivity

/-- The `L²` hypothesis with constant `A` for the kernel `K`, in convolution form. -/
def VczL2 (K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F) (A : ℝ) : Prop :=
  ∀ g : EuclideanSpace ℝ (Fin n) → E, MemLp g 2 volume →
    eLpNorm (K ⋆[vczPair E F, volume] g) 2 volume ≤ ENNReal.ofReal A * eLpNorm g 2 volume

/-- The weak type `(1,1)` estimate for `A > 0` and strongly measurable `K`, `f`. -/
theorem vcz_volume_lt_le_of_pos (hn : 0 < n) {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F}
    {A : ℝ} (hA : 0 < A) (hKm : StronglyMeasurable K) (hK : Integrable K) (hL2 : VczL2 K A)
    (hH : VczHormander K A) {f : EuclideanSpace ℝ (Fin n) → E} (hfi : Integrable f)
    (hfm : StronglyMeasurable f) {t : ℝ} (ht : 0 < t) :
    volume {x | t < ‖(K ⋆[vczPair E F, volume] f) x‖} ≤
      ENNReal.ofReal (vczWeakConst n * A / t) * ∫⁻ y, ‖f y‖ₑ := by
  set s := t / A with hs_def
  have hs : 0 < s := div_pos ht hA
  have hf := lintegral_vczNorm_ne_top hfi
  set g := vczGood f s with hg_def
  set b := f - g with hb_def
  set Fn := ∫⁻ y, ‖f y‖ₑ with hF_def
  have hgi : Integrable g := integrable_vczGood hn hs hfi hfm
  have hbi : Integrable b := hfi.sub hgi
  have hsplit : ∀ᵐ x, (K ⋆[vczPair E F, volume] f) x =
      (K ⋆[vczPair E F, volume] g) x + (K ⋆[vczPair E F, volume] b) x := by
    filter_upwards [vcz_ae_convolutionExistsAt le_rfl hK (memLp_one_iff_integrable.2 hgi),
      vcz_ae_convolutionExistsAt le_rfl hK (memLp_one_iff_integrable.2 hbi)] with x h1 h2
    rw [← h1.distrib_add h2]
    congr 2
    simp [hb_def]
  have hincl : {x | t < ‖(K ⋆[vczPair E F, volume] f) x‖} ≤ᵐ[volume]
      (({x | t / 2 < ‖(K ⋆[vczPair E F, volume] g) x‖} ∪
        ({x | t / 2 < ‖(K ⋆[vczPair E F, volume] b) x‖} ∩ (czStar (vczNorm f) s)ᶜ)) ∪
          czStar (vczNorm f) s : Set _) := by
    filter_upwards [hsplit] with x hx
    intro hxt
    have hxt' : t < ‖(K ⋆[vczPair E F, volume] g) x + (K ⋆[vczPair E F, volume] b) x‖ := by
      rw [← hx]; exact hxt
    by_cases hstar : x ∈ czStar (vczNorm f) s
    · exact Or.inr hstar
    · left
      by_contra hc
      simp only [mem_union, mem_inter_iff, mem_compl_iff, mem_ofPred_eq, not_or, not_and,
        not_lt] at hc
      have := norm_add_le ((K ⋆[vczPair E F, volume] g) x) ((K ⋆[vczPair E F, volume] b) x)
      have hb' : ‖(K ⋆[vczPair E F, volume] b) x‖ ≤ t / 2 :=
        not_lt.1 fun h => hc.2 h hstar
      linarith [hc.1]
  -- the exceptional set
  have hstar : volume (czStar (vczNorm f) s) ≤
      ENNReal.ofReal ((4 * Real.sqrt n) ^ n * A / t) * Fn := by
    refine (volume_czStar_le hn hs hf).trans
      ((mul_le_mul_right (volume_czBadSet_le hn hs hf) _).trans_eq ?_)
    simp only [enorm_vczNorm]
    rw [← ENNReal.ofReal_inv_of_pos hs, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    rw [hs_def]
    field_simp
  -- the good part
  have hconvg : AEStronglyMeasurable (K ⋆[vczPair E F, volume] g) volume :=
    AEStronglyMeasurable.convolution (vczPair E F) hK.1 hgi.1
  have hgsq := lintegral_vczGood_sq_le hn hs hfi
  have hg2 : MemLp g 2 volume := by
    have h :=(eLpNorm_two_rpow_two hgi.1).trans_le hgsq
    have hlt : eLpNorm g 2 volume ^ (2 : ℝ) < ∞ := h.trans_lt (by
      refine ENNReal.mul_lt_top (ENNReal.mul_lt_top ?_ ENNReal.ofReal_lt_top) hfi.2
      exact ENNReal.pow_lt_top ENNReal.ofNat_lt_top)
    exact (ENNReal.rpow_lt_top_iff_of_pos (by norm_num)).1 hlt
  have hgood : volume {x | t / 2 < ‖(K ⋆[vczPair E F, volume] g) x‖} ≤
      ENNReal.ofReal (4 * 2 ^ n * A / t) * Fn := by
    refine (vcz_measure_lt_norm_le_lintegral_sq hconvg (half_pos ht)).trans ?_
    rw [← eLpNorm_two_rpow_two hconvg]
    calc ENNReal.ofReal ((t / 2) ^ 2)⁻¹ *
          eLpNorm (K ⋆[vczPair E F, volume] g) 2 volume ^ (2 : ℝ)
        ≤ ENNReal.ofReal ((t / 2) ^ 2)⁻¹ *
            (ENNReal.ofReal A * eLpNorm g 2 volume) ^ (2 : ℝ) :=
          mul_le_mul_right (ENNReal.rpow_le_rpow (hL2 g hg2) (by norm_num)) _
      _ = ENNReal.ofReal ((t / 2) ^ 2)⁻¹ *
            (ENNReal.ofReal (A ^ 2) * ∫⁻ y, ‖g y‖ₑ ^ (2 : ℝ)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), eLpNorm_two_rpow_two hgi.1,
            ENNReal.rpow_two (ENNReal.ofReal A), ← ENNReal.ofReal_pow hA.le]
      _ ≤ ENNReal.ofReal ((t / 2) ^ 2)⁻¹ *
            (ENNReal.ofReal (A ^ 2) * (2 ^ n * ENNReal.ofReal s * Fn)) :=
          mul_le_mul_right (mul_le_mul_right hgsq _) _
      _ = ENNReal.ofReal (4 * 2 ^ n * A / t) * Fn := by
          rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_pow (by norm_num),
            ← ENNReal.ofReal_mul (by positivity), ← mul_assoc, ← mul_assoc,
            ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
          congr 2
          rw [hs_def]
          field_simp
          ring
  -- the bad part
  have hb1 : ∫⁻ y, ‖b y‖ₑ ≤ 2 * Fn := by
    calc ∫⁻ y, ‖b y‖ₑ ≤ ∫⁻ y, (‖f y‖ₑ + ‖g y‖ₑ) :=
          lintegral_mono fun y => by simp only [hb_def, Pi.sub_apply]; exact enorm_sub_le
      _ = Fn + ∫⁻ y, ‖g y‖ₑ := lintegral_add_left' hfi.1.enorm _
      _ ≤ Fn + Fn := add_le_add le_rfl (lintegral_vczGood_le hn hs hfi)
      _ = 2 * Fn := (two_mul Fn).symm
  have hconvb : AEStronglyMeasurable (K ⋆[vczPair E F, volume] b) volume :=
    AEStronglyMeasurable.convolution (vczPair E F) hK.1 hbi.1
  have hbad : volume ({x | t / 2 < ‖(K ⋆[vczPair E F, volume] b) x‖} ∩
      (czStar (vczNorm f) s)ᶜ) ≤ ENNReal.ofReal (4 * A / t) * Fn := by
    rw [← Measure.restrict_apply' measurableSet_czStar.compl]
    refine (vcz_measure_lt_norm_le_lintegral hconvb.restrict (half_pos ht)).trans ?_
    calc ENNReal.ofReal (t / 2)⁻¹ *
          ∫⁻ x in (czStar (vczNorm f) s)ᶜ, ‖(K ⋆[vczPair E F, volume] b) x‖ₑ
        ≤ ENNReal.ofReal (t / 2)⁻¹ * (ENNReal.ofReal A * ∫⁻ y, ‖b y‖ₑ) :=
          mul_le_mul_right (vcz_lintegral_compl_czStar_le hn hs hfi hfm hKm hK hH) _
      _ ≤ ENNReal.ofReal (t / 2)⁻¹ * (ENNReal.ofReal A * (2 * Fn)) :=
          mul_le_mul_right (mul_le_mul_right hb1 _) _
      _ = ENNReal.ofReal (4 * A / t) * Fn := by
          rw [← ENNReal.ofReal_ofNat 2, ← mul_assoc, ← mul_assoc,
            ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
          congr 2
          field_simp
          ring
  calc volume {x | t < ‖(K ⋆[vczPair E F, volume] f) x‖}
      ≤ volume ((({x | t / 2 < ‖(K ⋆[vczPair E F, volume] g) x‖} ∪
        ({x | t / 2 < ‖(K ⋆[vczPair E F, volume] b) x‖} ∩ (czStar (vczNorm f) s)ᶜ)) ∪
          czStar (vczNorm f) s : Set _)) := measure_mono_ae hincl
    _ ≤ volume {x | t / 2 < ‖(K ⋆[vczPair E F, volume] g) x‖} +
        volume ({x | t / 2 < ‖(K ⋆[vczPair E F, volume] b) x‖} ∩
          (czStar (vczNorm f) s)ᶜ) + volume (czStar (vczNorm f) s) :=
        (measure_union_le _ _).trans (add_le_add_left (measure_union_le _ _) _)
    _ ≤ ENNReal.ofReal (4 * 2 ^ n * A / t) * Fn + ENNReal.ofReal (4 * A / t) * Fn +
        ENNReal.ofReal ((4 * Real.sqrt n) ^ n * A / t) * Fn :=
        add_le_add (add_le_add hgood hbad) hstar
    _ = ENNReal.ofReal (vczWeakConst n * A / t) * Fn := by
        rw [← add_mul, ← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        unfold vczWeakConst
        ring

omit [CompleteSpace E] [CompleteSpace F] in
lemma VczL2.mono {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A A' : ℝ} (hAA : A ≤ A')
    (h : VczL2 K A) : VczL2 K A' := fun g hg =>
  (h g hg).trans (mul_le_mul_left (ENNReal.ofReal_le_ofReal hAA) _)

omit [CompleteSpace E] [CompleteSpace F] in
lemma VczHormander.mono {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A A' : ℝ} (hAA : A ≤ A')
    (h : VczHormander K A) : VczHormander K A' := fun y =>
  (h y).trans (ENNReal.ofReal_le_ofReal hAA)

omit [CompleteSpace E] [CompleteSpace F] in
/-- The hypotheses only depend on the a.e. class of the kernel. -/
lemma VczL2.congr {K K' : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hKK : K =ᵐ[volume] K')
    (h : VczL2 K A) : VczL2 K' A := fun g hg => by
  rw [← convolution_congr (vczPair E F) hKK EventuallyEq.rfl]; exact h g hg

omit [CompleteSpace E] [CompleteSpace F] in
lemma VczHormander.congr {K K' : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ}
    (hKK : K =ᵐ[volume] K') (h : VczHormander K A) : VczHormander K' A := fun y => by
  refine le_of_eq_of_le (lintegral_congr_ae (ae_restrict_of_ae ?_)) (h y)
  have h1 : (fun x => K (x - y)) =ᵐ[volume] fun x => K' (x - y) :=
    (measurePreserving_sub_right volume y).quasiMeasurePreserving.ae_eq_comp hKK
  filter_upwards [h1, hKK] with x hx1 hx2
  rw [hx1, hx2]

/-- **Weak type `(1,1)`, convolution form.** For an integrable operator-valued kernel `K`
satisfying the `L²` bound and Hörmander's condition with constant `A ≥ 0`, and every
`f ∈ L¹`, `t > 0`: `|{‖K * f‖ > t}| ≤ C_n A t⁻¹ ‖f‖₁`. -/
theorem vcz_volume_lt_norm_convolution_le (hn : 0 < n)
    {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hA : 0 ≤ A) (hK : Integrable K)
    (hL2 : VczL2 K A) (hH : VczHormander K A) {f : EuclideanSpace ℝ (Fin n) → E}
    (hf : Integrable f) {t : ℝ} (ht : 0 < t) :
    volume {x | t < ‖(K ⋆[vczPair E F, volume] f) x‖} ≤
      ENNReal.ofReal (vczWeakConst n * A / t) * eLpNorm f 1 volume := by
  set K' := hK.1.mk K
  have hKK' : K =ᵐ[volume] K' := hK.1.ae_eq_mk
  have hK'm : StronglyMeasurable K' := hK.1.stronglyMeasurable_mk
  have hK'i : Integrable K' := hK.congr hKK'
  set f' := hf.1.mk f
  have hff' : f =ᵐ[volume] f' := hf.1.ae_eq_mk
  have hf'i : Integrable f' := hf.congr hff'
  have hf'm : StronglyMeasurable f' := hf.1.stronglyMeasurable_mk
  have hconv : K ⋆[vczPair E F, volume] f = K' ⋆[vczPair E F, volume] f' :=
    convolution_congr _ hKK' hff'
  rw [hconv, eLpNorm_congr_ae hff', eLpNorm_one_eq_lintegral_enorm hf'i.1]
  have key := le_ofReal_mul_of_forall_pos hf'i.2.ne
    (φ := fun ε => vczWeakConst n * (A + ε) / t) (by fun_prop) fun ε hε =>
      vcz_volume_lt_le_of_pos hn (by linarith) hK'm hK'i
        ((hL2.congr hKK').mono (by linarith)) ((hH.congr hKK').mono (by linarith)) hf'i
        hf'm ht
  simpa using key

end WeakOne

/-! ## Strong type `(p,p)` bounds for `1 < p ≤ 2` -/

section Strong

variable {n : ℕ} {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]

/-- The constant `C_{n,p} = M(1,2,p) C_n^{2/p - 1}` of the strong type bound for `1 < p < 2`
(`M` the Marcinkiewicz constant, `C_n = vczWeakConst n`). -/
def vczConstLtTwo (n : ℕ) (p : ℝ) : ℝ :=
  (marcinkiewiczConst 1 2 p : ℝ) * vczWeakConst n ^ (2 / p - 1)

lemma vczConstLtTwo_nonneg (n : ℕ) (p : ℝ) : 0 ≤ vczConstLtTwo n p := by
  have := vczWeakConst_pos n
  unfold vczConstLtTwo; positivity

/-- The constant `C_{n,p}` of the Benedek–Calderón–Panzone theorem: `vczConstLtTwo n p` for
`p < 2`, `1` for `p = 2`, and `vczConstLtTwo n p'` (`p'` the conjugate exponent) for `p > 2`. -/
def vczConst (n : ℕ) (p : ℝ) : ℝ :=
  if p < 2 then vczConstLtTwo n p else if p = 2 then 1 else vczConstLtTwo n p.conjExponent

lemma vczConst_nonneg (n : ℕ) (p : ℝ) : 0 ≤ vczConst n p := by
  unfold vczConst
  split_ifs
  · exact vczConstLtTwo_nonneg n p
  · exact zero_le_one
  · exact vczConstLtTwo_nonneg n _

omit [CompleteSpace E] [CompleteSpace F] in
/-- Sublinearity (in fact additivity) of the convolution operator on `L^p`. -/
lemma vcz_isSublinearOn {p : ℝ≥0∞} (hp : 1 ≤ p) {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F}
    (hK : Integrable K) :
    IsSublinearOn (fun g => K ⋆[vczPair E F, volume] g) {g | MemLp g p volume} volume := by
  intro g hg g' hg'
  filter_upwards [vcz_ae_convolutionExistsAt hp hK hg, vcz_ae_convolutionExistsAt hp hK hg']
    with x h1 h2
  rw [h1.distrib_add h2]
  exact norm_add_le _ _

/-- `L^p` bounds for `1 < p < 2` and `A > 0`, by Marcinkiewicz interpolation between the weak
type `(1,1)` estimate and the `L²` hypothesis. -/
theorem vcz_eLpNorm_convolution_le_of_lt_two_of_pos (hn : 0 < n) {p : ℝ} (hp1 : 1 < p)
    (hp2 : p < 2) {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hA : 0 < A)
    (hK : Integrable K) (hL2 : VczL2 K A) (hH : VczHormander K A)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (K ⋆[vczPair E F, volume] f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (vczConstLtTwo n p * A) * eLpNorm f (ENNReal.ofReal p) volume := by
  set θ : ℝ := 2 - 2 / p with hθ_def
  have hp0 : 0 < p := by linarith
  have hθ0 : 0 ≤ θ := by
    rw [hθ_def, sub_nonneg, div_le_iff₀ hp0]; linarith
  have hθ1 : 0 ≤ 1 - θ := by
    rw [hθ_def, show 1 - (2 - 2 / p) = 2 / p - 1 by ring, sub_nonneg, le_div_iff₀ hp0]; linarith
  set M : ℝ := (marcinkiewiczConst 1 2 p : ℝ)
  have hM : 0 ≤ M := NNReal.coe_nonneg _
  set Cw := vczWeakConst n
  have hCw := vczWeakConst_pos n
  have hp1' : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp1.le
  set T : (EuclideanSpace ℝ (Fin n) → E) → EuclideanSpace ℝ (Fin n) → F :=
    fun g => K ⋆[vczPair E F, volume] g
  set D : Set (EuclideanSpace ℝ (Fin n) → E) := {g | MemLp g (ENNReal.ofReal p) volume}
  set A₁ : ℝ≥0 := Real.toNNReal (Cw * A)
  set A₂ : ℝ≥0 := Real.toNNReal A
  have hA₁ : (A₁ : ℝ≥0∞) = ENNReal.ofReal (Cw * A) := rfl
  have hA₂ : (A₂ : ℝ≥0∞) = ENNReal.ofReal A := rfl
  have hA₁0 : (A₁ : ℝ≥0∞) ≠ 0 := by
    rw [hA₁]; exact (ENNReal.ofReal_pos.2 (mul_pos hCw hA)).ne'
  have hA₂0 : (A₂ : ℝ≥0∞) ≠ 0 := by rw [hA₂]; exact (ENNReal.ofReal_pos.2 hA).ne'
  have hT1 : HasWeakTypeOn T D 1 A₁ volume volume := by
    refine hasWeakTypeOn_of_forall_real fun g _ t ht => ?_
    rw [ENNReal.rpow_one, ENNReal.ofReal_one]
    by_cases hg1 : MemLp g 1 volume
    · refine (vcz_volume_lt_norm_convolution_le hn hA.le hK hL2 hH
        (memLp_one_iff_integrable.1 hg1) ht).trans_eq ?_
      rw [ENNReal.ofReal_div_of_pos ht, hA₁, div_eq_mul_inv, div_eq_mul_inv]
      ring
    · rw [not_lt_top_iff.1 hg1, ENNReal.mul_top hA₁0, ENNReal.top_div_of_ne_top
        ENNReal.ofReal_ne_top]
      exact le_top
  have hT2 : HasWeakTypeOn T D 2 A₂ volume volume := by
    refine HasStrongTypeOn.hasWeakTypeOn two_pos fun g _ => ?_
    rw [ENNReal.ofReal_ofNat]
    by_cases hg2 : MemLp g 2 volume
    · rw [hA₂]; exact hL2 g hg2
    · rw [not_lt_top_iff.1 hg2, ENNReal.mul_top hA₂0]; exact le_top
  have hmain := eLpNorm_le_of_hasWeakTypeOn (a := 1) (b := 2) (p := p) (θ := θ) one_pos hp1 hp2
    (by rw [hθ_def]; field_simp; ring) hT1 hT2 (vcz_isSublinearOn hp1' hK)
    isTruncationClosed_memLp (f := f) hf hf.aestronglyMeasurable
    (AEStronglyMeasurable.convolution _ hK.1 hf.aestronglyMeasurable)
  refine hmain.trans (mul_le_mul_left ?_ _)
  rw [hA₁, hA₂, ENNReal.ofReal_rpow_of_nonneg (by positivity) hθ1,
    ENNReal.ofReal_rpow_of_nonneg hA.le hθ0, show (marcinkiewiczConst 1 2 p : ℝ≥0∞) =
      ENNReal.ofReal M from (ENNReal.ofReal_coe_nnreal).symm,
    ← ENNReal.ofReal_mul hM, ← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal (le_of_eq ?_)
  rw [vczConstLtTwo, Real.mul_rpow hCw.le hA.le, mul_assoc, mul_assoc, ← Real.rpow_add hA,
    show 1 - θ + θ = 1 by ring, Real.rpow_one, show 1 - θ = 2 / p - 1 by rw [hθ_def]; ring]
  ring

/-- `L^p` bounds for `1 < p < 2`, `A ≥ 0`. -/
theorem vcz_eLpNorm_convolution_le_of_lt_two (hn : 0 < n) {p : ℝ} (hp1 : 1 < p)
    (hp2 : p < 2) {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hA : 0 ≤ A)
    (hK : Integrable K) (hL2 : VczL2 K A) (hH : VczHormander K A)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (K ⋆[vczPair E F, volume] f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (vczConstLtTwo n p * A) * eLpNorm f (ENNReal.ofReal p) volume := by
  have key := le_ofReal_mul_of_forall_pos hf.ne (φ := fun ε => vczConstLtTwo n p * (A + ε))
    (by fun_prop) fun ε hε => vcz_eLpNorm_convolution_le_of_lt_two_of_pos hn hp1 hp2
      (by linarith) hK (hL2.mono (by linarith)) (hH.mono (by linarith)) hf
  simpa using key

/-- `L^p` bounds for `1 < p ≤ 2`, `A ≥ 0`, with the constant `vczConst n p`. -/
theorem vcz_eLpNorm_convolution_le_of_le_two (hn : 0 < n) {p : ℝ} (hp1 : 1 < p)
    (hp2 : p ≤ 2) {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hA : 0 ≤ A)
    (hK : Integrable K) (hL2 : VczL2 K A) (hH : VczHormander K A)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (K ⋆[vczPair E F, volume] f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (vczConst n p * A) * eLpNorm f (ENNReal.ofReal p) volume := by
  rcases hp2.lt_or_eq with hp2 | rfl
  · rw [vczConst, ite_eq_left hp2]
    exact vcz_eLpNorm_convolution_le_of_lt_two hn hp1 hp2 hA hK hL2 hH hf
  · rw [vczConst, ite_eq_right (lt_irrefl 2), ite_eq_left rfl, one_mul]
    rw [ENNReal.ofReal_ofNat] at hf ⊢
    exact hL2 f hf

end Strong

/-! ## Dual testing for Hilbert-space-valued functions -/

section HilbertDuality

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}
  {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- `‖⟪u, v⟫‖ₑ ≤ ‖u‖ₑ ‖v‖ₑ`. -/
lemma vcz_enorm_inner_le (u v : H) : ‖inner ℂ u v‖ₑ ≤ ‖u‖ₑ * ‖v‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm, ← ofReal_norm, ← ENNReal.ofReal_mul (norm_nonneg _)]
  exact ENNReal.ofReal_le_ofReal (norm_inner_le_norm _ _)

/-- Hölder for the inner product: `|∫ ⟪u, v⟫| ≤ ‖u‖_p ‖v‖_q`. -/
theorem vcz_enorm_integral_inner_le {p q : ℝ} (hpq : p.HolderConjugate q) {u v : α → H}
    (hu : AEStronglyMeasurable u μ) (hv : AEStronglyMeasurable v μ) :
    ‖∫ x, inner ℂ (u x) (v x) ∂μ‖ₑ ≤
      eLpNorm u (ENNReal.ofReal p) μ * eLpNorm v (ENNReal.ofReal q) μ := by
  calc ‖∫ x, inner ℂ (u x) (v x) ∂μ‖ₑ ≤ ∫⁻ x, ‖inner ℂ (u x) (v x)‖ₑ ∂μ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ x, ((fun x => ‖u x‖ₑ) * fun x => ‖v x‖ₑ) x ∂μ :=
        lintegral_mono fun x => vcz_enorm_inner_le _ _
    _ ≤ (∫⁻ x, ‖u x‖ₑ ^ p ∂μ) ^ (1 / p) * (∫⁻ x, ‖v x‖ₑ ^ q ∂μ) ^ (1 / q) :=
        ENNReal.lintegral_mul_le_Lp_mul_Lq μ hpq hu.enorm hv.enorm
    _ = _ := by
        rw [eLpNorm_ofReal_eq_lintegral hu hpq.pos, eLpNorm_ofReal_eq_lintegral hv hpq.symm.pos]

/-- The class of test functions for dual testing: bounded, strongly measurable, with support of
finite measure. -/
def VczTest (μ : Measure α) (g : α → H) : Prop :=
  StronglyMeasurable g ∧ (∃ C, ∀ x, ‖g x‖ ≤ C) ∧ μ (Function.support g) < ∞

/-- Scaling the dual-testing hypothesis. -/
lemma vcz_enorm_integral_le_of_dual_test {q : ℝ} (hq : 0 < q) {h : α → H} {A : ℝ≥0∞}
    (hA : ∀ g : α → H, VczTest μ g → eLpNorm g (ENNReal.ofReal q) μ ≤ 1 →
      Integrable (fun x => inner ℂ (g x) (h x)) μ → ‖∫ x, inner ℂ (g x) (h x) ∂μ‖ₑ ≤ A)
    {g : α → H} (hg : VczTest μ g) (hgi : Integrable (fun x => inner ℂ (g x) (h x)) μ)
    (hfin : eLpNorm g (ENNReal.ofReal q) μ < ∞) :
    ‖∫ x, inner ℂ (g x) (h x) ∂μ‖ₑ ≤ A * eLpNorm g (ENNReal.ofReal q) μ := by
  obtain ⟨hgm, ⟨C, hC⟩, hgs⟩ := hg
  set s := eLpNorm g (ENNReal.ofReal q) μ with hs
  by_cases hs0 : s = 0
  · have hg0 : g =ᵐ[μ] 0 := (eLpNorm_eq_zero_iff
      (by simpa using hq)).1 hs0
    have : ∫ x, inner ℂ (g x) (h x) ∂μ = 0 := by
      rw [integral_eq_zero_of_ae]
      filter_upwards [hg0] with x hx
      simp [hx]
    simp [this]
  set c : ℝ := (s.toReal)⁻¹
  have hspos : 0 < s.toReal := ENNReal.toReal_pos hs0 hfin.ne
  have hc : 0 < c := inv_pos.2 hspos
  have hcs : ENNReal.ofReal c = s⁻¹ := by
    rw [ENNReal.ofReal_inv_of_pos hspos, ENNReal.ofReal_toReal hfin.ne]
  have hinner : ∀ x, inner ℂ (((c : ℂ) • g) x) (h x) = (c : ℂ) * inner ℂ (g x) (h x) := by
    intro x
    simp [Pi.smul_apply]
  have key := hA ((c : ℂ) • g)
    ⟨stronglyMeasurable_const.smul hgm, ⟨c * C, fun x => by
      rw [Pi.smul_apply, norm_smul, Complex.norm_real, Real.norm_of_nonneg hc.le]
      exact mul_le_mul_of_nonneg_left (hC x) hc.le⟩,
      (measure_mono (Function.support_const_smul_subset _ _)).trans_lt hgs⟩
    (by
      rw [eLpNorm_const_smul, ← hs, ← ofReal_norm, Complex.norm_real,
        Real.norm_of_nonneg hc.le, hcs, ENNReal.inv_mul_cancel hs0 hfin.ne])
    (by simp_rw [hinner]; exact hgi.const_mul _)
  have e : ∫ x, inner ℂ (((c : ℂ) • g) x) (h x) ∂μ = (c : ℂ) * ∫ x, inner ℂ (g x) (h x) ∂μ := by
    simp_rw [hinner]
    exact integral_const_mul _ _
  rw [e, enorm_mul, ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hc.le,
    hcs] at key
  calc ‖∫ x, inner ℂ (g x) (h x) ∂μ‖ₑ = s * (s⁻¹ * ‖∫ x, inner ℂ (g x) (h x) ∂μ‖ₑ) := by
        rw [← mul_assoc, ENNReal.mul_inv_cancel hs0 hfin.ne, one_mul]
    _ ≤ s * A := mul_le_mul_right key _
    _ = A * s := mul_comm _ _

/-- Dual testing on a truncation (Hilbert-valued version of
`eLpNorm_indicator_le_of_dual_test`); the test function is `g = |u|^{p-2} u`, `u = h 𝟙_S`. -/
lemma vcz_eLpNorm_indicator_le_of_dual_test {p q : ℝ} (hpq : p.HolderConjugate q) {h : α → H}
    (hh : StronglyMeasurable h) {S : Set α} (hS : MeasurableSet S) (hμS : μ S < ∞) {N : ℝ}
    (hN : ∀ x ∈ S, ‖h x‖ ≤ N) {A : ℝ≥0∞}
    (hA : ∀ g : α → H, VczTest μ g → eLpNorm g (ENNReal.ofReal q) μ ≤ 1 →
      Integrable (fun x => inner ℂ (g x) (h x)) μ → ‖∫ x, inner ℂ (g x) (h x) ∂μ‖ₑ ≤ A) :
    eLpNorm (S.indicator h) (ENNReal.ofReal p) μ ≤ A := by
  have hp := hpq.pos
  have hq := hpq.symm.pos
  have hp1 : 0 < p - 1 := hpq.sub_one_pos
  set u := S.indicator h with hu_def
  have hu : StronglyMeasurable u := hh.indicator hS
  have huN : ∀ x, ‖u x‖ ≤ max N 0 := by
    intro x
    by_cases hx : x ∈ S
    · rw [hu_def, indicator_of_mem hx]; exact (hN x hx).trans (le_max_left _ _)
    · rw [hu_def, indicator_of_notMem hx, norm_zero]; exact le_max_right _ _
  set L := ∫⁻ x, ‖u x‖ₑ ^ p ∂μ with hL_def
  have hLfin : L < ∞ := by
    calc L ≤ ∫⁻ x, S.indicator (fun _ => ENNReal.ofReal (max N 0) ^ p) x ∂μ := by
          refine lintegral_mono fun x => ?_
          by_cases hx : x ∈ S
          · rw [indicator_of_mem hx, ← ofReal_norm]
            exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal (huN x)) hp.le
          · rw [indicator_of_notMem hx, hu_def, indicator_of_notMem hx, enorm_zero,
              ENNReal.zero_rpow_of_pos hp]
      _ < ∞ := by
          rw [lintegral_indicator_const hS]
          exact ENNReal.mul_lt_top (ENNReal.rpow_lt_top_of_nonneg hp.le ENNReal.ofReal_ne_top) hμS
  set g : α → H := fun x => ((‖u x‖ ^ (p - 2) : ℝ) : ℂ) • u x with hg_def
  have hgn : ∀ x, ‖g x‖ = ‖u x‖ ^ (p - 1) := by
    intro x
    by_cases hux : u x = 0
    · simp [hg_def, hux, Real.zero_rpow hp1.ne']
    · have hpos : 0 < ‖u x‖ := norm_pos_iff.2 hux
      rw [hg_def, norm_smul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      rw [show p - 1 = (p - 2) + 1 by ring, Real.rpow_add hpos, Real.rpow_one]
  have hge : ∀ x, ‖g x‖ₑ = ‖u x‖ₑ ^ (p - 1) := by
    intro x
    rw [← ofReal_norm, hgn, ← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp1.le]
  have hpair : ∀ x, inner ℂ (g x) (h x) = ((‖u x‖ ^ p : ℝ) : ℂ) := by
    intro x
    by_cases hx : x ∈ S
    · have hux' : u x = h x := by rw [hu_def, indicator_of_mem hx]
      rw [← hux']
      by_cases hux : u x = 0
      · simp [hg_def, hux, Real.zero_rpow hp.ne']
      · have hpos : 0 < ‖u x‖ := norm_pos_iff.2 hux
        rw [hg_def, inner_smul_left, inner_self_eq_norm_sq_to_K, Complex.conj_ofReal]
        have h3 : ‖u x‖ ^ (p - 2) * ‖u x‖ ^ 2 = ‖u x‖ ^ p := by
          rw [← Real.rpow_two, ← Real.rpow_add hpos]; ring_nf
        rw [← h3, Complex.ofReal_mul, Complex.ofReal_pow]; rfl
    · have hux : u x = 0 := by rw [hu_def, indicator_of_notMem hx]
      simp [hg_def, hux, Real.zero_rpow hp.ne']
  have hfun : ∀ x, ‖(‖u x‖ ^ p : ℝ)‖ₑ = ‖u x‖ₑ ^ p := by
    intro x
    rw [Real.enorm_eq_ofReal (by positivity), ← ofReal_norm,
      ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le]
  have hIr : Integrable (fun x => ‖u x‖ ^ p) μ :=
    ⟨(hu.norm.measurable.pow_const p).aestronglyMeasurable, by
      simpa [HasFiniteIntegral, hfun] using hLfin⟩
  have hint : ∫ x, inner ℂ (g x) (h x) ∂μ = ((∫ x, ‖u x‖ ^ p ∂μ : ℝ) : ℂ) := by
    simp_rw [hpair]; exact integral_complex_ofReal
  have hval : ‖∫ x, inner ℂ (g x) (h x) ∂μ‖ₑ = L := by
    rw [hint, ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (integral_nonneg
      fun x => by positivity), ofReal_integral_eq_lintegral_ofReal hIr
      (Eventually.of_forall fun x => by positivity)]
    refine lintegral_congr fun x => ?_
    rw [← hfun, Real.enorm_eq_ofReal (by positivity)]
  have hgm : StronglyMeasurable g :=
    (Complex.measurable_ofReal.comp (hu.norm.measurable.pow_const _)).stronglyMeasurable.smul hu
  have hgq : eLpNorm g (ENNReal.ofReal q) μ = L ^ (1 / q) := by
    rw [eLpNorm_ofReal_eq_lintegral hgm.aestronglyMeasurable hq]
    congr 1
    refine lintegral_congr fun x => ?_
    rw [hge, ← ENNReal.rpow_mul, hpq.sub_one_mul_conj]
  have hbound := vcz_enorm_integral_le_of_dual_test hq hA
    ⟨hgm, ⟨max N 0 ^ (p - 1), fun x => by
      rw [hgn]; exact Real.rpow_le_rpow (norm_nonneg _) (huN x) hp1.le⟩,
    (measure_mono (s := Function.support g) (t := S) (fun x hx => by
      by_contra hxS
      apply hx
      simp [hg_def, hu_def, indicator_of_notMem hxS])).trans_lt hμS⟩
    ((integrable_congr (Eventually.of_forall hpair)).2 hIr.ofReal)
    (by rw [hgq]; exact ENNReal.rpow_lt_top_of_nonneg (by positivity) hLfin.ne)
  rw [hval, hgq] at hbound
  rw [eLpNorm_ofReal_eq_lintegral hu.aestronglyMeasurable hp]
  exact rpow_le_of_le_mul_rpow hpq hLfin.ne hbound

/-- **Dual testing for Hilbert-space-valued functions**: on a σ-finite measure space, for Hölder
conjugate `1 < p < ∞`, `q = p'`, and any a.e. strongly measurable `h : α → H`, if
`|∫ ⟪g, h⟫| ≤ A` for every bounded strongly measurable `g` with `μ(supp g) < ∞`, `‖g‖_q ≤ 1`
and `⟪g, h⟫` integrable, then `‖h‖_p ≤ A`. -/
theorem vcz_eLpNorm_le_of_dual_test [SigmaFinite μ] {p q : ℝ} (hpq : p.HolderConjugate q)
    {h : α → H} (hh : AEStronglyMeasurable h μ) {A : ℝ≥0∞}
    (hA : ∀ g : α → H, VczTest μ g → eLpNorm g (ENNReal.ofReal q) μ ≤ 1 →
      Integrable (fun x => inner ℂ (g x) (h x)) μ → ‖∫ x, inner ℂ (g x) (h x) ∂μ‖ₑ ≤ A) :
    eLpNorm h (ENNReal.ofReal p) μ ≤ A := by
  set h' := hh.mk h
  have hh' : StronglyMeasurable h' := hh.stronglyMeasurable_mk
  have heq : h =ᵐ[μ] h' := hh.ae_eq_mk
  have hA' : ∀ g : α → H, VczTest μ g → eLpNorm g (ENNReal.ofReal q) μ ≤ 1 →
      Integrable (fun x => inner ℂ (g x) (h' x)) μ →
        ‖∫ x, inner ℂ (g x) (h' x) ∂μ‖ₑ ≤ A := by
    intro g hg hgq hgi
    have hae : (fun x => inner ℂ (g x) (h x)) =ᵐ[μ] fun x => inner ℂ (g x) (h' x) :=
      heq.mono fun x hx => by simp only [hx]
    rw [← integral_congr_ae hae]
    exact hA g hg hgq ((integrable_congr hae).2 hgi)
  set S : ℕ → Set α := fun N => spanningSets μ N ∩ {x | ‖h' x‖ ≤ N}
  have hS : ∀ N, MeasurableSet (S N) := fun N =>
    (measurableSet_spanningSets μ N).inter (measurableSet_le hh'.norm.measurable measurable_const)
  have hμS : ∀ N, μ (S N) < ∞ := fun N =>
    (measure_mono inter_subset_left).trans_lt (measure_spanningSets_lt_top μ N)
  have hbd : ∀ N, eLpNorm ((S N).indicator h') (ENNReal.ofReal p) μ ≤ A := fun N =>
    vcz_eLpNorm_indicator_le_of_dual_test hpq hh' (hS N) (hμS N) (fun x hx => hx.2) hA'
  rw [eLpNorm_congr_ae heq]
  refine eLpNorm_le_of_tendsto_of_eLpNorm_le
    (fun N => (hh'.indicator (hS N)).aestronglyMeasurable) (Eventually.of_forall fun x => ?_) hbd
  refine tendsto_const_nhds.congr' ?_
  rw [EventuallyEq, eventually_atTop]
  refine ⟨max (spanningSetsIndex μ x) ⌈‖h' x‖⌉₊, fun N hN => ?_⟩
  have hx : x ∈ S N := ⟨monotone_spanningSets μ (le_of_max_le_left hN) (mem_spanningSetsIndex μ x),
    show ‖h' x‖ ≤ (N : ℝ) from (Nat.le_ceil (‖h' x‖)).trans
      (by exact_mod_cast le_of_max_le_right hN)⟩
  rw [indicator_of_mem hx]

end HilbertDuality

/-! ## The adjoint kernel and the range `p > 2` for Hilbert spaces -/

section Adjoint

variable {n : ℕ} {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]

/-- The adjoint kernel `K*(x) = K(-x)†`. -/
def vczAdjoint (K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F) :
    EuclideanSpace ℝ (Fin n) → F →L[ℂ] E :=
  fun x => ContinuousLinearMap.adjoint (K (-x))

@[simp]
lemma vczAdjoint_vczAdjoint (K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F) :
    vczAdjoint (vczAdjoint K) = K := by
  funext x; simp [vczAdjoint]

lemma integrable_vczAdjoint {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} (hK : Integrable K) :
    Integrable (vczAdjoint K) := by
  have h1 : Integrable (fun x => K (-x)) := hK.comp_neg
  refine h1.norm.mono' ?_ (Eventually.of_forall fun x => ?_)
  · exact (ContinuousLinearMap.adjoint (𝕜 := ℂ) (E := E) (F := F)).continuous
      |>.comp_aestronglyMeasurable
      h1.1
  · simp [vczAdjoint]

/-- The adjoint kernel satisfies the Hörmander condition with the same constant. -/
lemma VczHormander.adjoint {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ}
    (hH : VczHormander K A) : VczHormander (vczAdjoint K) A := by
  intro y
  have hS : ∀ y : EuclideanSpace ℝ (Fin n),
      MeasurableSet {x : EuclideanSpace ℝ (Fin n) | 2 * ‖y‖ < ‖x‖} := fun y =>
    measurableSet_lt measurable_const continuous_norm.measurable
  refine le_trans (le_of_eq ?_) (hH (-y))
  rw [← lintegral_indicator (hS y), ← lintegral_indicator (hS (-y)),
    ← lintegral_neg_eq_self (fun x => {x : EuclideanSpace ℝ (Fin n) | 2 * ‖-y‖ < ‖x‖}.indicator
      (fun x => ‖K (x - -y) - K x‖ₑ) x)]
  refine lintegral_congr fun x => ?_
  by_cases hx : 2 * ‖y‖ < ‖x‖
  · rw [indicator_of_mem (show x ∈ {x : EuclideanSpace ℝ (Fin n) | 2 * ‖y‖ < ‖x‖} from hx),
      indicator_of_mem (show -x ∈ {x : EuclideanSpace ℝ (Fin n) | 2 * ‖-y‖ < ‖x‖} by
        simpa [norm_neg] using hx)]
    simp only [vczAdjoint]
    rw [← map_sub, LinearIsometryEquiv.enorm_map, show -(x - y) = -x - -y by abel]
  · rw [indicator_of_notMem (show x ∉ {x : EuclideanSpace ℝ (Fin n) | 2 * ‖y‖ < ‖x‖} from hx),
      indicator_of_notMem (show -x ∉ {x : EuclideanSpace ℝ (Fin n) | 2 * ‖-y‖ < ‖x‖} by
        simpa [norm_neg] using hx)]

/-- **Duality for operator-valued convolutions**: `∫ ⟪φ, K * f⟫ = ∫ ⟪K* * φ, f⟫` for `K ∈ L¹`,
`f ∈ L^p`, `φ ∈ L^q` (Hölder conjugate exponents). -/
theorem vcz_integral_inner_convolution {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F}
    (hK : Integrable K) {p q : ℝ} (hpq : p.HolderConjugate q)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume)
    {φ : EuclideanSpace ℝ (Fin n) → F} (hφ : MemLp φ (ENNReal.ofReal q) volume) :
    ∫ x, inner ℂ (φ x) ((K ⋆[vczPair E F, volume] f) x) =
      ∫ y, inner ℂ ((vczAdjoint K ⋆[vczPair F E, volume] φ) y) (f y) := by
  have hp1 : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hpq.lt.le
  have hq1 : 1 ≤ ENNReal.ofReal q := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hpq.symm.lt.le
  set Ψ : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) → ℂ :=
    fun x y => inner ℂ (φ x) (K (x - y) (f y))
  have hKm : AEStronglyMeasurable (fun z : EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin n) =>
      K (z.1 - z.2)) (volume.prod volume) :=
    hK.1.comp_quasiMeasurePreserving (quasiMeasurePreserving_sub_of_right_invariant volume volume)
  have hΨm : AEStronglyMeasurable (Function.uncurry Ψ) (volume.prod volume) :=
    hφ.aestronglyMeasurable.comp_fst.inner
      ((vczPair E F).aestronglyMeasurable_comp₂ hKm hf.aestronglyMeasurable.comp_snd)
  have htriple := lintegral_triple_lt_top (integrable_vczNorm hK) hpq
    (f := vczNorm f) (φ := vczNorm φ) hf.norm.ofReal hφ.norm.ofReal
  simp only [enorm_vczNorm] at htriple
  have hΨi : Integrable (Function.uncurry Ψ) (volume.prod volume) := by
    refine ⟨hΨm, ?_⟩
    rw [HasFiniteIntegral, lintegral_prod _ hΨm.enorm]
    refine lt_of_le_of_lt (lintegral_mono fun x => ?_) htriple
    have hm : AEMeasurable (fun y => ‖K (x - y)‖ₑ * ‖f y‖ₑ) volume :=
      (hK.1.comp_quasiMeasurePreserving (quasiMeasurePreserving_sub_left volume x)).enorm.mul
        hf.aestronglyMeasurable.enorm
    calc ∫⁻ y, ‖Function.uncurry Ψ (x, y)‖ₑ ≤ ∫⁻ y, ‖φ x‖ₑ * (‖K (x - y)‖ₑ * ‖f y‖ₑ) := by
          refine lintegral_mono fun y => ?_
          refine (vcz_enorm_inner_le _ _).trans (mul_le_mul_right ?_ _)
          exact ContinuousLinearMap.le_opENorm _ _
      _ = ‖φ x‖ₑ * ∫⁻ y, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
          rw [lintegral_const_mul'' _ hm,
            ← lintegral_sub_left_eq_self (fun y => ‖K y‖ₑ * ‖f (x - y)‖ₑ) x]
          simp only [sub_sub_cancel]
  have hL : ∀ᵐ x, inner ℂ (φ x) ((K ⋆[vczPair E F, volume] f) x) = ∫ y, Ψ x y := by
    filter_upwards [vcz_ae_convolutionExistsAt hp1 hK hf] with x hx
    rw [vcz_convolution_eq]
    exact (integral_inner (vcz_integrable_of_convolutionExistsAt hx) (φ x)).symm
  have hR : ∀ᵐ y, inner ℂ ((vczAdjoint K ⋆[vczPair F E, volume] φ) y) (f y) = ∫ x, Ψ x y := by
    filter_upwards [vcz_ae_convolutionExistsAt hq1 (integrable_vczAdjoint hK) hφ] with y hy
    have hi := vcz_integrable_of_convolutionExistsAt hy
    rw [vcz_convolution_eq]
    calc inner ℂ (∫ x, vczAdjoint K (y - x) (φ x)) (f y)
        = conj (inner ℂ (f y) (∫ x, vczAdjoint K (y - x) (φ x))) := (inner_conj_symm _ _).symm
      _ = conj (∫ x, inner ℂ (f y) (vczAdjoint K (y - x) (φ x))) := by
          rw [integral_inner hi]
      _ = ∫ x, conj (inner ℂ (f y) (vczAdjoint K (y - x) (φ x))) := integral_conj.symm
      _ = ∫ x, Ψ x y := by
          refine integral_congr_ae (Eventually.of_forall fun x => ?_)
          simp only [Ψ, vczAdjoint]
          rw [inner_conj_symm, ContinuousLinearMap.adjoint_inner_left, neg_sub]
  rw [integral_congr_ae hL, integral_congr_ae hR]
  exact integral_integral_swap hΨi

/-- The adjoint kernel inherits the `L²` bound, by duality. -/
lemma VczL2.adjoint {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hK : Integrable K)
    (hL2 : VczL2 K A) : VczL2 (vczAdjoint K) A := by
  intro g hg
  have h22 : (2 : ℝ).HolderConjugate 2 := Real.HolderConjugate.two_two
  have e2 : ENNReal.ofReal 2 = 2 := ENNReal.ofReal_ofNat 2
  have hg' : MemLp g (ENNReal.ofReal 2) volume := by rwa [e2]
  have hKa := integrable_vczAdjoint hK
  have key := vcz_eLpNorm_le_of_dual_test h22
    (h := vczAdjoint K ⋆[vczPair F E, volume] g)
    (AEStronglyMeasurable.convolution _ hKa.1 hg.aestronglyMeasurable)
    (A := ENNReal.ofReal A * eLpNorm g 2 volume) ?_
  · rwa [e2] at key
  intro φ _ hφ2 _
  have hφ2' : MemLp φ (ENNReal.ofReal 2) volume := hφ2.trans_lt ENNReal.one_lt_top
  rw [vcz_integral_inner_convolution hKa h22 hg' hφ2', vczAdjoint_vczAdjoint]
  rw [e2] at hφ2 hφ2'
  calc ‖∫ y, inner ℂ ((K ⋆[vczPair E F, volume] φ) y) (g y)‖ₑ
      ≤ eLpNorm (K ⋆[vczPair E F, volume] φ) (ENNReal.ofReal 2) volume *
          eLpNorm g (ENNReal.ofReal 2) volume :=
        vcz_enorm_integral_inner_le h22
          (AEStronglyMeasurable.convolution _ hK.1 hφ2'.aestronglyMeasurable)
          hg.aestronglyMeasurable
    _ ≤ (ENNReal.ofReal A * eLpNorm φ 2 volume) * eLpNorm g 2 volume := by
        rw [e2]; exact mul_le_mul_left (hL2 φ hφ2') _
    _ ≤ (ENNReal.ofReal A * 1) * eLpNorm g 2 volume :=
        mul_le_mul_left (mul_le_mul_right hφ2 _) _
    _ = ENNReal.ofReal A * eLpNorm g 2 volume := by rw [mul_one]

/-- `L^p` bounds for `2 < p < ∞` (Hilbert spaces), by duality with the adjoint kernel at the
conjugate exponent `p' < 2`. -/
theorem vcz_eLpNorm_convolution_le_of_two_lt (hn : 0 < n) {p : ℝ} (hp : 2 < p)
    {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hA : 0 ≤ A)
    (hK : Integrable K) (hL2 : VczL2 K A) (hH : VczHormander K A)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (K ⋆[vczPair E F, volume] f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (vczConstLtTwo n p.conjExponent * A) *
        eLpNorm f (ENNReal.ofReal p) volume := by
  have hp1 : 1 < p := by linarith
  set q := p.conjExponent
  have hpq : p.HolderConjugate q := Real.HolderConjugate.conjExponent hp1
  have hq1 : 1 < q := hpq.symm.lt
  have hq2 : q < 2 := by
    simp only [q, Real.conjExponent]
    rw [div_lt_iff₀ (by linarith)]; linarith
  have hKa := integrable_vczAdjoint hK
  refine vcz_eLpNorm_le_of_dual_test hpq
    (AEStronglyMeasurable.convolution _ hK.1 hf.aestronglyMeasurable) fun φ _ hφq _ => ?_
  have hφ : MemLp φ (ENNReal.ofReal q) volume := hφq.trans_lt ENNReal.one_lt_top
  rw [vcz_integral_inner_convolution hK hpq hf hφ]
  calc ‖∫ y, inner ℂ ((vczAdjoint K ⋆[vczPair F E, volume] φ) y) (f y)‖ₑ
      ≤ eLpNorm (vczAdjoint K ⋆[vczPair F E, volume] φ) (ENNReal.ofReal q) volume *
          eLpNorm f (ENNReal.ofReal p) volume :=
        vcz_enorm_integral_inner_le hpq.symm
          (AEStronglyMeasurable.convolution _ hKa.1 hφ.aestronglyMeasurable)
          hf.aestronglyMeasurable
    _ ≤ (ENNReal.ofReal (vczConstLtTwo n q * A) * eLpNorm φ (ENNReal.ofReal q) volume) *
          eLpNorm f (ENNReal.ofReal p) volume :=
        mul_le_mul_left (vcz_eLpNorm_convolution_le_of_lt_two hn hq1 hq2 hA hKa
          (hL2.adjoint hK) hH.adjoint hφ) _
    _ ≤ (ENNReal.ofReal (vczConstLtTwo n q * A) * 1) * eLpNorm f (ENNReal.ofReal p) volume :=
        mul_le_mul_left (mul_le_mul_right hφq _) _
    _ = ENNReal.ofReal (vczConstLtTwo n q * A) * eLpNorm f (ENNReal.ofReal p) volume := by
        rw [mul_one]

/-- `L^p` bounds for all `1 < p < ∞` (Hilbert spaces), with the constant `vczConst n p`. -/
theorem vcz_eLpNorm_convolution_le_hilbert (hn : 0 < n) {p : ℝ} (hp : 1 < p)
    {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hA : 0 ≤ A)
    (hK : Integrable K) (hL2 : VczL2 K A) (hH : VczHormander K A)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (K ⋆[vczPair E F, volume] f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (vczConst n p * A) * eLpNorm f (ENNReal.ofReal p) volume := by
  rcases le_or_gt p 2 with hp2 | hp2
  · exact vcz_eLpNorm_convolution_le_of_le_two hn hp hp2 hA hK hL2 hH hf
  · rw [vczConst, ite_eq_right (not_lt.2 hp2.le), ite_eq_right hp2.ne']
    exact vcz_eLpNorm_convolution_le_of_two_lt hn hp2 hA hK hL2 hH hf

end Adjoint

/-! ## Main results in integral form -/

section Main

variable {n : ℕ}

section Banach

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]

omit [CompleteSpace E] [CompleteSpace F] in
lemma vcz_fun_eq_convolution (K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F)
    (f : EuclideanSpace ℝ (Fin n) → E) :
    (fun x => ∫ y, K (x - y) (f y)) = K ⋆[vczPair E F, volume] f :=
  funext fun x => (vcz_convolution_eq K f x).symm

omit [CompleteSpace E] [CompleteSpace F] in
lemma vczL2_of_integral {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ}
    (hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → E, MemLp g 2 volume →
      eLpNorm (fun x => ∫ y, K (x - y) (g y)) 2 volume ≤ ENNReal.ofReal A * eLpNorm g 2 volume) :
    VczL2 K A := fun g hg => by
  rw [← vcz_fun_eq_convolution]; exact hL2 g hg

/-- **Benedek–Calderón–Panzone theorem, weak type `(1,1)`.** Let `n ≥ 1`, `E`, `F` complex
Banach spaces and `K : ℝⁿ → (E →L[ℂ] F)` Bochner integrable such that, for some `A ≥ 0`,
`f ↦ ∫ K(· - y) f(y) dy` is bounded on `L²(ℝⁿ; E) → L²(ℝⁿ; F)` with norm at most `A`, and `K`
satisfies Hörmander's condition `∫_{|x| > 2|y|} ‖K(x - y) - K(x)‖ dx ≤ A` for all `y`. Then
for all `f ∈ L¹(ℝⁿ; E)` and `t > 0`,
`|{x : ‖∫ K(x - y) f(y) dy‖ > t}| ≤ C_n A t⁻¹ ‖f‖₁` with `C_n = vczWeakConst n` (independent
of `‖K‖₁`). -/
theorem vcz_weakType_one_one (hn : 0 < n) {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ}
    (hA : 0 ≤ A) (hK : Integrable K)
    (hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → E, MemLp g 2 volume →
      eLpNorm (fun x => ∫ y, K (x - y) (g y)) 2 volume ≤ ENNReal.ofReal A * eLpNorm g 2 volume)
    (hH : ∀ y : EuclideanSpace ℝ (Fin n),
      ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖}, ‖K (x - y) - K x‖ₑ ≤ ENNReal.ofReal A)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : Integrable f) {t : ℝ} (ht : 0 < t) :
    volume {x | t < ‖∫ y, K (x - y) (f y)‖} ≤
      ENNReal.ofReal (vczWeakConst n * A / t) * eLpNorm f 1 volume := by
  have h := vcz_volume_lt_norm_convolution_le hn hA hK (vczL2_of_integral hL2) hH hf ht
  simpa only [vcz_convolution_eq] using h

/-- **Benedek–Calderón–Panzone theorem, strong type `(p,p)` for `1 < p ≤ 2`.** Under the
hypotheses of `vcz_weakType_one_one`, for `1 < p ≤ 2` and `f ∈ L^p(ℝⁿ; E)`:
`‖∫ K(· - y) f(y) dy‖_p ≤ C_{n,p} A ‖f‖_p`, with `C_{n,p} = vczConst n p`. -/
theorem vcz_eLpNorm_le (hn : 0 < n) {p : ℝ} (hp1 : 1 < p) (hp2 : p ≤ 2)
    {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hA : 0 ≤ A) (hK : Integrable K)
    (hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → E, MemLp g 2 volume →
      eLpNorm (fun x => ∫ y, K (x - y) (g y)) 2 volume ≤ ENNReal.ofReal A * eLpNorm g 2 volume)
    (hH : ∀ y : EuclideanSpace ℝ (Fin n),
      ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖}, ‖K (x - y) - K x‖ₑ ≤ ENNReal.ofReal A)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (fun x => ∫ y, K (x - y) (f y)) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (vczConst n p * A) * eLpNorm f (ENNReal.ofReal p) volume := by
  rw [vcz_fun_eq_convolution]
  exact vcz_eLpNorm_convolution_le_of_le_two hn hp1 hp2 hA hK (vczL2_of_integral hL2) hH hf

end Banach

/-- **Benedek–Calderón–Panzone theorem for Hilbert spaces, `1 < p < ∞`.** If `E`, `F` are
complex Hilbert spaces, the conclusion of `vcz_eLpNorm_le` holds for all `1 < p < ∞` (for
`p > 2` by duality, using the adjoint kernel `x ↦ K(-x)†`, see `vczAdjoint`). -/
theorem vcz_eLpNorm_le_of_innerProductSpace {E F : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    [CompleteSpace F] (hn : 0 < n) {p : ℝ} (hp : 1 < p)
    {K : EuclideanSpace ℝ (Fin n) → E →L[ℂ] F} {A : ℝ} (hA : 0 ≤ A) (hK : Integrable K)
    (hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → E, MemLp g 2 volume →
      eLpNorm (fun x => ∫ y, K (x - y) (g y)) 2 volume ≤ ENNReal.ofReal A * eLpNorm g 2 volume)
    (hH : ∀ y : EuclideanSpace ℝ (Fin n),
      ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖}, ‖K (x - y) - K x‖ₑ ≤ ENNReal.ofReal A)
    {f : EuclideanSpace ℝ (Fin n) → E} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (fun x => ∫ y, K (x - y) (f y)) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (vczConst n p * A) * eLpNorm f (ENNReal.ofReal p) volume := by
  rw [vcz_fun_eq_convolution]
  exact vcz_eLpNorm_convolution_le_hilbert hn hp hA hK (vczL2_of_integral hL2) hH hf

end Main

/-! ## `ℓ²`-valued square functions -/

section SquareFunction

variable {n : ℕ} {ι : Type*} (s : Finset ι) (k : ι → EuclideanSpace ℝ (Fin n) → ℂ)

/-- The vector `(k_i(x))_{i ∈ s} ∈ ℓ²(s)`. -/
def vczSqVec (x : EuclideanSpace ℝ (Fin n)) : EuclideanSpace ℂ s :=
  WithLp.toLp 2 fun i : s => k i x

open Classical in
/-- The `ℓ²(s)`-valued kernel `x ↦ (z ↦ z (k_i(x))_{i ∈ s})` of the square function. -/
def vczSqKernel : EuclideanSpace ℝ (Fin n) → ℂ →L[ℂ] EuclideanSpace ℂ s :=
  fun x => ∑ i : s, k i x • ContinuousLinearMap.toSpanSingleton ℂ (EuclideanSpace.single i 1)

/-- The square function `(∑_{i ∈ s} |k_i * f(x)|²)^{1/2}`. -/
def vczSqFun (f : EuclideanSpace ℝ (Fin n) → ℂ) (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  √(∑ i ∈ s, ‖∫ y, k i (x - y) * f y‖ ^ 2)

variable {s k}

lemma vczSqKernel_eq (x : EuclideanSpace ℝ (Fin n)) :
    vczSqKernel s k x = ContinuousLinearMap.toSpanSingleton ℂ (vczSqVec s k x) := by
  classical
  refine ContinuousLinearMap.ext_ring ?_
  ext j
  simp [vczSqKernel, vczSqVec, Pi.single_apply, Finset.sum_ite_eq]

lemma vczSqKernel_apply (x : EuclideanSpace ℝ (Fin n)) (z : ℂ) :
    vczSqKernel s k x z = z • vczSqVec s k x := by
  rw [vczSqKernel_eq, ContinuousLinearMap.toSpanSingleton_apply]

lemma integrable_vczSqKernel (hk : ∀ i ∈ s, Integrable (k i)) :
    Integrable (vczSqKernel s k) := by
  classical
  have : vczSqKernel s k = fun x => ∑ i : s,
      k i x • ContinuousLinearMap.toSpanSingleton ℂ (EuclideanSpace.single i (1 : ℂ)) := by
    funext x
    simp only [vczSqKernel]
  rw [this]
  exact integrable_finsetSum (f := fun (i : s) x =>
    k i x • ContinuousLinearMap.toSpanSingleton ℂ (EuclideanSpace.single i (1 : ℂ))) _
    fun i _ => (hk i i.2).smul_const _

lemma enorm_vczSqKernel_sub (x y : EuclideanSpace ℝ (Fin n)) :
    ‖vczSqKernel s k x - vczSqKernel s k y‖ₑ =
      ENNReal.ofReal √(∑ i ∈ s, ‖k i x - k i y‖ ^ 2) := by
  have h : vczSqKernel s k x - vczSqKernel s k y =
      ContinuousLinearMap.toSpanSingleton ℂ (vczSqVec s k x - vczSqVec s k y) := by
    refine ContinuousLinearMap.ext_ring ?_
    simp [vczSqKernel_eq]
  rw [h, ← ofReal_norm, ContinuousLinearMap.norm_toSpanSingleton, EuclideanSpace.norm_eq]
  congr 2
  rw [← Finset.sum_coe_sort s]
  rfl

/-- For `f ∈ L^p`, the norm of the `ℓ²(s)`-valued convolution is the square function, a.e. -/
lemma ae_norm_convolution_vczSqKernel {p : ℝ≥0∞} (hp : 1 ≤ p) (hk : ∀ i ∈ s, Integrable (k i))
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f p volume) :
    ∀ᵐ x, ‖(vczSqKernel s k ⋆[vczPair ℂ (EuclideanSpace ℂ s), volume] f) x‖ =
      vczSqFun s k f x := by
  filter_upwards [vcz_ae_convolutionExistsAt hp (integrable_vczSqKernel hk) hf] with x hx
  have hG := vcz_integrable_of_convolutionExistsAt hx
  rw [vcz_convolution_eq, EuclideanSpace.norm_eq, vczSqFun, ← Finset.sum_coe_sort s]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  congr 2
  change EuclideanSpace.proj j (∫ y, vczSqKernel s k (x - y) (f y)) = _
  rw [← (EuclideanSpace.proj j).integral_comp_comm hG]
  congr 1
  funext y
  rw [vczSqKernel_apply, mul_comm]
  rfl

lemma eLpNorm_vczSqFun_eq {p : ℝ≥0∞} (hp : 1 ≤ p) (hk : ∀ i ∈ s, Integrable (k i))
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f p volume) :
    eLpNorm (vczSqFun s k f) p volume =
      eLpNorm (vczSqKernel s k ⋆[vczPair ℂ (EuclideanSpace ℂ s), volume] f) p volume := by
  rw [← eLpNorm_norm (vczSqKernel s k ⋆[vczPair ℂ (EuclideanSpace ℂ s), volume] f)
    (AEStronglyMeasurable.convolution _ (integrable_vczSqKernel hk).1 hf.aestronglyMeasurable)]
  refine eLpNorm_congr_ae ?_
  filter_upwards [ae_norm_convolution_vczSqKernel hp hk hf] with x hx
  exact hx.symm

/-- The square-function `L²` hypothesis gives the `L²` bound of the vector-valued kernel. -/
lemma vczL2_vczSqKernel (hk : ∀ i ∈ s, Integrable (k i)) {A : ℝ}
    (hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → ℂ, MemLp g 2 volume →
      ∑ i ∈ s, eLpNorm (fun x => ∫ y, k i (x - y) * g y) 2 volume ^ 2 ≤
        ENNReal.ofReal A ^ 2 * eLpNorm g 2 volume ^ 2) :
    VczL2 (vczSqKernel s k) A := by
  intro g hg
  have h12 : (1 : ℝ≥0∞) ≤ 2 := by norm_num
  have hT : ∀ i ∈ s, AEStronglyMeasurable (fun x => ∫ y, k i (x - y) * g y) volume := by
    intro i hi
    rw [show (fun x => ∫ y, k i (x - y) * g y) = k i ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g
      from funext fun x => (convolution_eq_integral_sub _ _ x).symm]
    exact AEStronglyMeasurable.convolution _ (hk i hi).1 hg.aestronglyMeasurable
  have hconv : AEStronglyMeasurable
      (vczSqKernel s k ⋆[vczPair ℂ (EuclideanSpace ℂ s), volume] g) volume :=
    AEStronglyMeasurable.convolution _ (integrable_vczSqKernel hk).1 hg.aestronglyMeasurable
  have hSm : AEStronglyMeasurable (vczSqFun s k g) volume :=
    hconv.norm.congr (ae_norm_convolution_vczSqKernel h12 hk hg)
  have hsq : eLpNorm (vczSqFun s k g) 2 volume ^ (2 : ℝ) =
      ∑ i ∈ s, eLpNorm (fun x => ∫ y, k i (x - y) * g y) 2 volume ^ (2 : ℝ) := by
    rw [eLpNorm_two_rpow_two hSm]
    have hpt : ∀ x, ‖vczSqFun s k g x‖ₑ ^ (2 : ℝ) =
        ∑ i ∈ s, ‖∫ y, k i (x - y) * g y‖ₑ ^ (2 : ℝ) := by
      intro x
      rw [vczSqFun, Real.enorm_eq_ofReal (Real.sqrt_nonneg _), ENNReal.rpow_two,
        ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
        Real.sq_sqrt (Finset.sum_nonneg fun i _ => by positivity),
        ENNReal.ofReal_sum_of_nonneg fun i _ => by positivity]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [ENNReal.rpow_two, ← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _)]
    simp_rw [hpt]
    rw [lintegral_finsetSum' _ fun i hi => ((hT i hi).enorm.pow_const _)]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [eLpNorm_two_rpow_two (hT i hi)]
  rw [← eLpNorm_vczSqFun_eq h12 hk hg]
  rw [← ENNReal.rpow_le_rpow_iff (two_pos : (0 : ℝ) < 2), hsq,
    ENNReal.mul_rpow_of_nonneg _ _ zero_le_two]
  simp only [ENNReal.rpow_two]
  exact hL2 g hg

lemma vczHormander_vczSqKernel {A : ℝ}
    (hH : ∀ y : EuclideanSpace ℝ (Fin n), ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖},
      ENNReal.ofReal √(∑ i ∈ s, ‖k i (x - y) - k i x‖ ^ 2) ≤ ENNReal.ofReal A) :
    VczHormander (vczSqKernel s k) A := fun y => by
  simp_rw [enorm_vczSqKernel_sub]; exact hH y

/-- **`L^p` bounds for `ℓ²`-valued square functions** (vector-valued Calderón–Zygmund theory
with `ℓ²` values, finite families). Let `n ≥ 1`, `1 < p < ∞`, `A ≥ 0`, and let `(k_i)_{i ∈ s}`
be a finite family of integrable kernels on `ℝⁿ` with
* the `L²` bound `∑_{i ∈ s} ‖k_i * g‖₂² ≤ A² ‖g‖₂²` for all `g ∈ L²`, and
* the Hörmander condition `∫_{|x| > 2|y|} (∑_{i ∈ s} |k_i(x - y) - k_i(x)|²)^{1/2} dx ≤ A` for
  all `y`.
Then `‖(∑_{i ∈ s} |k_i * f|²)^{1/2}‖_p ≤ C_{n,p} A ‖f‖_p` for all `f ∈ L^p`, with
`C_{n,p} = vczConst n p`, independent of `s`, of the `k_i` and of `A`. -/
theorem vcz_eLpNorm_sqFun_le (hn : 0 < n) {p : ℝ} (hp : 1 < p) (s : Finset ι)
    (k : ι → EuclideanSpace ℝ (Fin n) → ℂ) {A : ℝ} (hA : 0 ≤ A)
    (hk : ∀ i ∈ s, Integrable (k i))
    (hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → ℂ, MemLp g 2 volume →
      ∑ i ∈ s, eLpNorm (fun x => ∫ y, k i (x - y) * g y) 2 volume ^ 2 ≤
        ENNReal.ofReal A ^ 2 * eLpNorm g 2 volume ^ 2)
    (hH : ∀ y : EuclideanSpace ℝ (Fin n), ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖},
      ENNReal.ofReal √(∑ i ∈ s, ‖k i (x - y) - k i x‖ ^ 2) ≤ ENNReal.ofReal A)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : MemLp f (ENNReal.ofReal p) volume) :
    eLpNorm (fun x => √(∑ i ∈ s, ‖∫ y, k i (x - y) * f y‖ ^ 2)) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (vczConst n p * A) * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp1 : 1 ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  change eLpNorm (vczSqFun s k f) (ENNReal.ofReal p) volume ≤ _
  rw [eLpNorm_vczSqFun_eq hp1 hk hf]
  exact vcz_eLpNorm_convolution_le_hilbert hn hp hA (integrable_vczSqKernel hk)
    (vczL2_vczSqKernel hk hL2) (vczHormander_vczSqKernel hH) hf

/-- **Weak type `(1,1)` for `ℓ²`-valued square functions**, under the hypotheses of
`vcz_eLpNorm_sqFun_le`: `|{(∑_{i ∈ s} |k_i * f|²)^{1/2} > t}| ≤ C_n A t⁻¹ ‖f‖₁`. -/
theorem vcz_volume_lt_sqFun_le (hn : 0 < n) (s : Finset ι)
    (k : ι → EuclideanSpace ℝ (Fin n) → ℂ) {A : ℝ} (hA : 0 ≤ A)
    (hk : ∀ i ∈ s, Integrable (k i))
    (hL2 : ∀ g : EuclideanSpace ℝ (Fin n) → ℂ, MemLp g 2 volume →
      ∑ i ∈ s, eLpNorm (fun x => ∫ y, k i (x - y) * g y) 2 volume ^ 2 ≤
        ENNReal.ofReal A ^ 2 * eLpNorm g 2 volume ^ 2)
    (hH : ∀ y : EuclideanSpace ℝ (Fin n), ∫⁻ x in {x | 2 * ‖y‖ < ‖x‖},
      ENNReal.ofReal √(∑ i ∈ s, ‖k i (x - y) - k i x‖ ^ 2) ≤ ENNReal.ofReal A)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : Integrable f) {t : ℝ} (ht : 0 < t) :
    volume {x | t < √(∑ i ∈ s, ‖∫ y, k i (x - y) * f y‖ ^ 2)} ≤
      ENNReal.ofReal (vczWeakConst n * A / t) * eLpNorm f 1 volume := by
  have hae := ae_norm_convolution_vczSqKernel le_rfl hk (memLp_one_iff_integrable.2 hf)
  refine le_trans (measure_mono_ae ?_) (vcz_volume_lt_norm_convolution_le hn hA
    (integrable_vczSqKernel hk) (vczL2_vczSqKernel hk hL2) (vczHormander_vczSqKernel hH) hf ht)
  filter_upwards [hae] with x hx
  intro hxt
  change t < ‖(vczSqKernel s k ⋆[vczPair ℂ (EuclideanSpace ℂ s), volume] f) x‖
  rw [hx]
  exact hxt

end SquareFunction

end

