/-!
# Lépingle's jump inequality for the dyadic martingale

This file was automatically generated by Claude.

## Statement

For `x ∈ ℝⁿ` (`EuclideanSpace ℝ (Fin n)`) and `j ∈ ℤ` let
`Q_j(x) = {y | ∀ i, ⌊2^j y_i⌋ = ⌊2^j x_i⌋}` be the half-open dyadic cube of side `2^{-j}`
containing `x` (`Auto.dyadicCube`) and `E_j f(x) = 2^{jn} ∫_{Q_j(x)} f` the dyadic martingale
(`Auto.dyadicAvg`). For a sequence `a : ℤ → ℂ` and `λ > 0`, the `λ`-jump counting function
`N_λ(a) ∈ [0, ∞]` (`Auto.seqJumpCount`) is the supremum of all `N` such that there are
`s₁ < t₁ < s₂ < t₂ < ⋯ < s_N < t_N` with `|a_{t_i} - a_{s_i}| > λ`.

* `Auto.lepingle_jump_inequality` (**Lépingle's jump inequality**): for every `n` and
  `1 < p < ∞` there is `C` such that for all `f ∈ L^p(ℝⁿ)` and all `λ > 0`,
  `‖λ N_λ(E_j f : j ∈ ℤ)^{1/2}‖_{L^p} ≤ C ‖f‖_{L^p}`; `C` does not depend on `λ` or `f`.
* `Auto.measurable_lepingle`, `Auto.aemeasurable_lepingle`: the function
  `x ↦ λ N_λ(E_j f(x) : j ∈ ℤ)^{1/2}` is measurable (for every `f`).

The statements depend only on Mathlib and the definitions of this file.

## Results of independent interest (finite filtrations)

A finite filtration is encoded by labels `lab : ℕ → Ω → L` on a finite set `Ω` (atoms of level
`k` are the fibres of `lab k`, `Auto.lepAtom`), refining in `k`, with singletons at level `M`
and with regularity constant `K` (an atom has at most `K` times as many points as each of its
sub-atoms). `Auto.lepAvg` is the conditional expectation (uniform counting measure) and
`Auto.lepMT` the martingale transform `∑_{k<M} v_k (E_{k+1} F - E_k F)` with predictable
(`Auto.LepMeas`) real coefficients `|v_k| ≤ 1`.

* `Auto.lepMT_L2`: `L²` bound with constant `1` (orthogonality of martingale differences);
* `Auto.lepMT_weak`: weak type `(1,1)` with constant `K + 1` (Calderón–Zygmund/Gundy
  decomposition at the first time the averages of `|F|` exceed the height);
* `Auto.lepMTBound_exists`: `L^p` bounds for `1 < p < ∞`, uniform over all such filtrations
  (Marcinkiewicz interpolation for `p < 2`, self-adjointness and duality for `p > 2`);
* `Auto.lep_tree_jump`: the jump inequality on finite regular filtrations.

## Proof

1. *Finite windows*: `N_λ(a) = sup_J N_λ^{[-J,J]}(a)` (`Auto.seqJumpCount_eq_iSup`), so by
   monotone convergence it suffices to bound the windowed jump counts uniformly in `J`.
2. *Stopping times* (`Auto.lepGreedy`): greedy stopping times for oscillations `> λ/2`; every
   `λ`-jump interval `(s, t]` contains one of them, so `N ≤` their number `N'`
   (`Auto.lepGreedy_config`), and each completed increment of the sampled martingale exceeds
   `λ/2`, so `(λ/2)² N' ≤ ∑_k |g_k - g_{k-1}|²` (`Auto.lepIncr_sq_sum`).
3. *Khintchine*: by the lower Khintchine inequality (`Auto.khintchine_lower_rpow`) the square
   function of the sampled martingale is controlled by the average over signs of
   `|∑_k ε_k (g_k - g_{k-1})|^p`, and each signed sum is a martingale transform with predictable
   coefficients `±1` in the original filtration (`Auto.lepIncr_rademacher`).
4. *Martingale transforms* are bounded on `L^p` uniformly (results above).
5. *Discretization*: on the window `[-J, J]` the averages `E_j f(x)` only depend on the averages
   of `f` over the cubes of generation `J`; these are grouped into blocks of `2^{2nJ}` cubes
   inside the cubes of generation `-J`, each block carrying the finite dyadic filtration
   (`Auto.LepFib`, `Auto.lepDLab`, regularity constant `2^n`), and Hölder's inequality on the
   cubes of generation `J` (`Auto.lep_holder_set`) returns to `‖f‖_{L^p}` (`Auto.lep_window_bound`).

## References

* D. Lépingle, *La variation d'ordre p des semi-martingales*, Z. Wahrsch. Verw. Gebiete 36
  (1976).
* G. Pisier, Q. Xu, *The strong p-variation of martingales and orthogonal series*, Probab.
  Theory Related Fields 77 (1988).
* R. Jones, A. Seeger, J. Wright, *Strong variational and jump inequalities in harmonic
  analysis*, Trans. Amer. Math. Soc. 360 (2008); see §2 for the jump inequality for
  martingales.
-/

@[expose] public section

namespace Auto

open scoped BigOperators ENNReal NNReal
open MeasureTheory Finset

/-! ### Finite filtrations of partitions -/

section Tree

variable {Ω : Type*} [Fintype Ω] {L : Type*} [DecidableEq L]

/-- The atom of level `k` containing `ω` of the partition defined by the labels `lab k`. -/
def lepAtom (lab : ℕ → Ω → L) (k : ℕ) (ω : Ω) : Finset Ω :=
  univ.filter fun ω' => lab k ω' = lab k ω

/-- The average of `F` over the level-`k` atom containing `ω` (conditional expectation). -/
noncomputable def lepAvg {E : Type*} [AddCommGroup E] [Module ℝ E] (lab : ℕ → Ω → L) (k : ℕ)
    (F : Ω → E) (ω : Ω) : E :=
  ((lepAtom lab k ω).card : ℝ)⁻¹ • ∑ ω' ∈ lepAtom lab k ω, F ω'

/-- `G` is measurable with respect to the level-`k` partition (constant on its atoms). -/
def LepMeas {β : Type*} (lab : ℕ → Ω → L) (k : ℕ) (G : Ω → β) : Prop :=
  ∀ ω ω', lab k ω = lab k ω' → G ω = G ω'

variable (lab : ℕ → Ω → L)

theorem mem_lepAtom {k : ℕ} {ω ω' : Ω} : ω' ∈ lepAtom lab k ω ↔ lab k ω' = lab k ω := by
  simp [lepAtom]

theorem lepAtom_congr {k : ℕ} {ω ω' : Ω} (h : lab k ω = lab k ω') :
    lepAtom lab k ω = lepAtom lab k ω' := by
  ext x; simp [mem_lepAtom, h]

theorem lepAtom_card_pos (k : ℕ) (ω : Ω) : 0 < (lepAtom lab k ω).card :=
  Finset.card_pos.mpr ⟨ω, (mem_lepAtom lab).mpr rfl⟩

theorem lepAvg_meas {E : Type*} [AddCommGroup E] [Module ℝ E] (k : ℕ) (F : Ω → E) :
    LepMeas lab k (lepAvg lab k F) := by
  intro ω ω' h
  simp only [lepAvg, lepAtom_congr lab h]

omit [Fintype Ω] [DecidableEq L] in
theorem LepMeas.mono {β : Type*} {lab : ℕ → Ω → L}
    (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω') {k l : ℕ}
    (hkl : k ≤ l) {G : Ω → β} (hG : LepMeas lab k G) : LepMeas lab l G := by
  induction hkl with
  | refl => exact hG
  | step _ ih => exact fun ω ω' h => ih ω ω' (hr _ ω ω' h)

omit [Fintype Ω] [DecidableEq L] in
theorem lepLab_mono {lab : ℕ → Ω → L}
    (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω') {k l : ℕ}
    (hkl : k ≤ l) {ω ω' : Ω} (h : lab l ω = lab l ω') : lab k ω = lab k ω' :=
  LepMeas.mono hr hkl (G := lab k) (fun _ _ h => h) ω ω' h

omit [Fintype Ω] [DecidableEq L] in
theorem LepMeas.add {β : Type*} [Add β] {k : ℕ} {G H : Ω → β} (hG : LepMeas lab k G)
    (hH : LepMeas lab k H) : LepMeas lab k (fun ω => G ω + H ω) :=
  fun ω ω' h => by simp only [hG ω ω' h, hH ω ω' h]

omit [Fintype Ω] [DecidableEq L] in
theorem LepMeas.comp {β γ : Type*} {k : ℕ} {G : Ω → β} (hG : LepMeas lab k G) (φ : β → γ) :
    LepMeas lab k (fun ω => φ (G ω)) :=
  fun ω ω' h => by simp only [hG ω ω' h]

section Avg

variable {E : Type*} [AddCommGroup E] [Module ℝ E]

theorem lepAvg_of_meas {k : ℕ} {G : Ω → E} (hG : LepMeas lab k G) : lepAvg lab k G = G := by
  funext ω
  have hc := lepAtom_card_pos lab k ω
  have : ∑ ω' ∈ lepAtom lab k ω, G ω' = ∑ ω' ∈ lepAtom lab k ω, G ω :=
    Finset.sum_congr rfl fun ω' h' => hG ω' ω ((mem_lepAtom lab).mp h')
  rw [lepAvg, this, Finset.sum_const, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul,
    inv_mul_cancel₀ (by exact_mod_cast hc.ne'), one_smul]

theorem lepAvg_add (k : ℕ) (F G : Ω → E) :
    lepAvg lab k (fun ω => F ω + G ω) = fun ω => lepAvg lab k F ω + lepAvg lab k G ω := by
  funext ω; simp [lepAvg, Finset.sum_add_distrib, smul_add]

theorem lepAvg_sub {E : Type*} [AddCommGroup E] [Module ℝ E] (k : ℕ) (F G : Ω → E) :
    lepAvg lab k (fun ω => F ω - G ω) = fun ω => lepAvg lab k F ω - lepAvg lab k G ω := by
  funext ω; simp [lepAvg, Finset.sum_sub_distrib, smul_sub]

theorem lepAvg_smul_meas {k : ℕ} {X : Ω → ℝ} (hX : LepMeas lab k X) (F : Ω → E) :
    lepAvg lab k (fun ω => X ω • F ω) = fun ω => X ω • lepAvg lab k F ω := by
  funext ω
  have : ∑ ω' ∈ lepAtom lab k ω, X ω' • F ω' = ∑ ω' ∈ lepAtom lab k ω, X ω • F ω' :=
    Finset.sum_congr rfl fun ω' h' => by rw [hX ω' ω ((mem_lepAtom lab).mp h')]
  rw [lepAvg, lepAvg, this, ← Finset.smul_sum, smul_comm]

/-- Averaging preserves the total sum. -/
theorem sum_lepAvg (k : ℕ) (F : Ω → E) : ∑ ω, lepAvg lab k F ω = ∑ ω, F ω := by
  classical
  have h1 : ∀ ω, lepAvg lab k F ω = ∑ ω', if lab k ω' = lab k ω then
      ((lepAtom lab k ω').card : ℝ)⁻¹ • F ω' else 0 := by
    intro ω
    rw [lepAvg, Finset.smul_sum, lepAtom, Finset.sum_filter]
    refine Finset.sum_congr rfl fun ω' _ => ?_
    split_ifs with h
    · rw [lepAtom_congr lab h]; rfl
    · rfl
  simp_rw [h1]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ω' _ => ?_
  rw [← Finset.sum_filter, Finset.sum_const]
  have : (univ.filter fun ω => lab k ω' = lab k ω) = lepAtom lab k ω' := by
    ext x; simp [mem_lepAtom, eq_comm]
  rw [this, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul,
    mul_inv_cancel₀ (by exact_mod_cast (lepAtom_card_pos lab k ω').ne'), one_smul]

theorem sum_smul_lepAvg {k : ℕ} {X : Ω → ℝ} (hX : LepMeas lab k X) (F : Ω → E) :
    ∑ ω, X ω • lepAvg lab k F ω = ∑ ω, X ω • F ω := by
  have := sum_lepAvg lab k (fun ω => X ω • F ω)
  rw [lepAvg_smul_meas lab hX] at this
  exact this

/-- Sum over a level-`k` atom of an average of level `l ≥ k`. -/
theorem lepAvg_lepAvg (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    {k l : ℕ} (hkl : k ≤ l) (F : Ω → E) : lepAvg lab k (lepAvg lab l F) = lepAvg lab k F := by
  classical
  funext ω
  let X : Ω → ℝ := fun ω' => if lab k ω' = lab k ω then 1 else 0
  have hX : LepMeas lab l X := LepMeas.mono hr hkl (fun a b h => by simp only [X, h])
  have key : ∀ G : Ω → E, ∑ ω' ∈ lepAtom lab k ω, G ω' = ∑ ω', X ω' • G ω' := by
    intro G
    rw [lepAtom, Finset.sum_filter]
    refine Finset.sum_congr rfl fun ω' _ => ?_
    simp only [X]; split_ifs <;> simp
  rw [lepAvg, lepAvg, key, key, sum_smul_lepAvg lab hX]

theorem lepAvg_lepAvg' (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    {k l : ℕ} (hkl : k ≤ l) (F : Ω → E) : lepAvg lab l (lepAvg lab k F) = lepAvg lab k F :=
  lepAvg_of_meas lab (LepMeas.mono hr hkl (lepAvg_meas lab k F))

end Avg

/-- Pulling a measurable factor through the average, for the real inner product. -/
theorem sum_inner_lepAvg {k : ℕ} {X : Ω → ℂ} (hX : LepMeas lab k X) (Y : Ω → ℂ) :
    ∑ ω, inner ℝ (X ω) (lepAvg lab k Y ω) = ∑ ω, inner ℝ (X ω) (Y ω) := by
  have h : ∀ ω, inner ℝ (X ω) (lepAvg lab k Y ω) =
      lepAvg lab k (fun ω' => inner ℝ (X ω') (Y ω')) ω := by
    intro ω
    rw [lepAvg, lepAvg, inner_smul_right, inner_sum, smul_eq_mul]
    congr 1
    refine Finset.sum_congr rfl fun ω' h' => ?_
    rw [hX ω' ω ((mem_lepAtom lab).mp h')]
  simp_rw [h]
  exact sum_lepAvg lab k _

/-- Self-adjointness of the averages. -/
theorem sum_inner_lepAvg_symm (k : ℕ) (F Y : Ω → ℂ) :
    ∑ ω, inner ℝ (lepAvg lab k F ω) (Y ω) = ∑ ω, inner ℝ (F ω) (lepAvg lab k Y ω) := by
  rw [← sum_inner_lepAvg lab (lepAvg_meas lab k F) Y]
  have h1 := sum_inner_lepAvg lab (lepAvg_meas lab k Y) F
  calc ∑ ω, inner ℝ (lepAvg lab k F ω) (lepAvg lab k Y ω)
      = ∑ ω, inner ℝ (lepAvg lab k Y ω) (lepAvg lab k F ω) :=
        Finset.sum_congr rfl fun ω _ => real_inner_comm _ _
    _ = ∑ ω, inner ℝ (lepAvg lab k Y ω) (F ω) := h1
    _ = _ := Finset.sum_congr rfl fun ω _ => real_inner_comm _ _

theorem norm_lepAvg_le (k : ℕ) (F : Ω → ℂ) (ω : Ω) :
    ‖lepAvg lab k F ω‖ ≤ lepAvg lab k (fun ω' => ‖F ω'‖) ω := by
  rw [lepAvg, lepAvg, norm_smul, smul_eq_mul, Real.norm_eq_abs,
    abs_of_nonneg (by positivity)]
  exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)

theorem lepAvg_nonneg {k : ℕ} {F : Ω → ℝ} (hF : ∀ ω, 0 ≤ F ω) (ω : Ω) : 0 ≤ lepAvg lab k F ω := by
  rw [lepAvg, smul_eq_mul]
  exact mul_nonneg (by positivity) (Finset.sum_nonneg fun _ _ => hF _)

theorem lepAvg_succ_le {K : ℕ} (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    (hreg : ∀ k ω, (lepAtom lab k ω).card ≤ K * (lepAtom lab (k + 1) ω).card)
    {F : Ω → ℝ} (hF : ∀ ω, 0 ≤ F ω) (k : ℕ) (ω : Ω) :
    lepAvg lab (k + 1) F ω ≤ K * lepAvg lab k F ω := by
  have hsub : lepAtom lab (k + 1) ω ⊆ lepAtom lab k ω := fun x hx =>
    (mem_lepAtom lab).mpr (hr k x ω ((mem_lepAtom lab).mp hx))
  have hc1 : (0 : ℝ) < (lepAtom lab (k + 1) ω).card := by exact_mod_cast lepAtom_card_pos lab _ ω
  have hc0 : (0 : ℝ) < (lepAtom lab k ω).card := by exact_mod_cast lepAtom_card_pos lab _ ω
  have hS : ∑ x ∈ lepAtom lab (k + 1) ω, F x ≤ ∑ x ∈ lepAtom lab k ω, F x :=
    Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => hF _
  have hS0 : 0 ≤ ∑ x ∈ lepAtom lab (k + 1) ω, F x := Finset.sum_nonneg fun _ _ => hF _
  have hreg' : ((lepAtom lab k ω).card : ℝ) ≤ K * (lepAtom lab (k + 1) ω).card := by
    exact_mod_cast hreg k ω
  rw [lepAvg, lepAvg, smul_eq_mul, smul_eq_mul]
  rw [inv_mul_le_iff₀ hc1]
  set A := ∑ x ∈ lepAtom lab k ω, F x
  set a : ℝ := ((lepAtom lab k ω).card : ℝ)
  set b : ℝ := ((lepAtom lab (k + 1) ω).card : ℝ)
  have hA : 0 ≤ A := le_trans hS0 hS
  calc ∑ x ∈ lepAtom lab (k + 1) ω, F x ≤ A := hS
    _ = a * (a⁻¹ * A) := by field_simp
    _ ≤ (K * b) * (a⁻¹ * A) :=
        mul_le_mul_of_nonneg_right hreg' (mul_nonneg (inv_nonneg.mpr hc0.le) hA)
    _ = b * (K * (a⁻¹ * A)) := by ring

theorem lepAvg_of_leaf {M : ℕ} (hleaf : ∀ ω ω', lab M ω = lab M ω' → ω = ω')
    {E : Type*} [AddCommGroup E] [Module ℝ E] (F : Ω → E) : lepAvg lab M F = F :=
  lepAvg_of_meas lab fun ω ω' h => by rw [hleaf ω ω' h]

end Tree

/-! ### Martingale transforms on a finite filtration -/

section Transform

variable {Ω : Type*} [Fintype Ω] {L : Type*} [DecidableEq L] (lab : ℕ → Ω → L)

/-- The martingale transform `∑_{k < M} v_k (E_{k+1} F - E_k F)` of `F` by `v`. -/
noncomputable def lepMT (M : ℕ) (v : ℕ → Ω → ℝ) (F : Ω → ℂ) (ω : Ω) : ℂ :=
  ∑ k ∈ range M, v k ω • (lepAvg lab (k + 1) F ω - lepAvg lab k F ω)

theorem lepMT_add (M : ℕ) (v : ℕ → Ω → ℝ) (F G : Ω → ℂ) :
    lepMT lab M v (fun ω => F ω + G ω) = fun ω => lepMT lab M v F ω + lepMT lab M v G ω := by
  funext ω
  simp only [lepMT, lepAvg_add, ← Finset.sum_add_distrib, ← smul_add]
  refine Finset.sum_congr rfl fun k _ => ?_
  congr 1; ring

theorem lepMT_sub (M : ℕ) (v : ℕ → Ω → ℝ) (F G : Ω → ℂ) :
    lepMT lab M v (fun ω => F ω - G ω) = fun ω => lepMT lab M v F ω - lepMT lab M v G ω := by
  funext ω
  simp only [lepMT, lepAvg_sub, ← Finset.sum_sub_distrib, ← smul_sub]
  refine Finset.sum_congr rfl fun k _ => ?_
  congr 1; ring

theorem lepMT_succ (m : ℕ) (v : ℕ → Ω → ℝ) (F : Ω → ℂ) :
    lepMT lab (m + 1) v F =
      fun ω => lepMT lab m v F ω + v m ω • (lepAvg lab (m + 1) F ω - lepAvg lab m F ω) := by
  funext ω; simp [lepMT, Finset.sum_range_succ]

variable {lab}

theorem lepMT_meas (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    {v : ℕ → Ω → ℝ} (hv : ∀ k, LepMeas lab k (v k)) (F : Ω → ℂ) :
    ∀ m, LepMeas lab m (lepMT lab m v F)
  | 0 => fun ω ω' _ => by simp [lepMT]
  | m + 1 => by
    intro ω ω' h
    have h' := hr m ω ω' h
    rw [lepMT_succ]
    simp only [lepMT_meas hr hv F m ω ω' h', hv m ω ω' h', lepAvg_meas lab (m + 1) F ω ω' h,
      lepAvg_meas lab m F ω ω' h']

theorem lep_sum_norm_add_sq (X Y : Ω → ℂ) :
    ∑ ω, ‖X ω + Y ω‖ ^ 2 =
      ∑ ω, ‖X ω‖ ^ 2 + 2 * ∑ ω, inner ℝ (X ω) (Y ω) + ∑ ω, ‖Y ω‖ ^ 2 := by
  simp_rw [norm_add_sq_real]
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.mul_sum]

theorem lep_orth {k : ℕ} {X : Ω → ℂ} (hX : LepMeas lab k X) {Y : Ω → ℂ}
    (hY : lepAvg lab k Y = 0) : ∑ ω, inner ℝ (X ω) (Y ω) = 0 := by
  rw [← sum_inner_lepAvg lab hX Y, hY]; simp

theorem lepAvg_diff_eq_zero (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    (m : ℕ) (F : Ω → ℂ) :
    lepAvg lab m (fun ω => lepAvg lab (m + 1) F ω - lepAvg lab m F ω) = 0 := by
  rw [lepAvg_sub, lepAvg_lepAvg lab hr (Nat.le_succ m), lepAvg_of_meas lab (lepAvg_meas lab m F)]
  funext ω; simp

theorem lepMT_L2_aux (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    {v : ℕ → Ω → ℝ} (hv : ∀ k, LepMeas lab k (v k)) (hv1 : ∀ k ω, |v k ω| ≤ 1)
    (F : Ω → ℂ) (m : ℕ) :
    ∑ ω, ‖lepMT lab m v F ω‖ ^ 2 + ∑ ω, ‖lepAvg lab 0 F ω‖ ^ 2 ≤
      ∑ ω, ‖lepAvg lab m F ω‖ ^ 2 := by
  induction m with
  | zero => simp [lepMT]
  | succ m ih =>
    set D : Ω → ℂ := fun ω => lepAvg lab (m + 1) F ω - lepAvg lab m F ω with hD
    have hD0 : lepAvg lab m D = 0 := lepAvg_diff_eq_zero hr m F
    have hmeas : LepMeas lab m (fun ω => v m ω • lepMT lab m v F ω) := fun a b h => by
      simp only [hv m a b h, lepMT_meas hr hv F m a b h]
    have h1 : ∑ ω, inner ℝ (lepMT lab m v F ω) (v m ω • D ω) = 0 := by
      have : ∀ ω, inner ℝ (lepMT lab m v F ω) (v m ω • D ω) =
          inner ℝ (v m ω • lepMT lab m v F ω) (D ω) := by
        intro ω; rw [real_inner_smul_left, real_inner_smul_right]
      simp_rw [this]
      exact lep_orth hmeas hD0
    have h2 : ∑ ω, inner ℝ (lepAvg lab m F ω) (D ω) = 0 := lep_orth (lepAvg_meas lab m F) hD0
    have e1 : ∑ ω, ‖lepMT lab (m + 1) v F ω‖ ^ 2 =
        ∑ ω, ‖lepMT lab m v F ω‖ ^ 2 + 2 * 0 + ∑ ω, ‖v m ω • D ω‖ ^ 2 := by
      rw [lepMT_succ, ← h1]
      exact lep_sum_norm_add_sq _ (fun ω => v m ω • D ω)
    have e2 : ∑ ω, ‖lepAvg lab (m + 1) F ω‖ ^ 2 =
        ∑ ω, ‖lepAvg lab m F ω‖ ^ 2 + 2 * 0 + ∑ ω, ‖D ω‖ ^ 2 := by
      rw [← h2, ← lep_sum_norm_add_sq]
      refine Finset.sum_congr rfl fun ω _ => ?_
      simp [hD]
    have h3 : ∑ ω, ‖v m ω • D ω‖ ^ 2 ≤ ∑ ω, ‖D ω‖ ^ 2 := by
      refine Finset.sum_le_sum fun ω _ => ?_
      rw [norm_smul, mul_pow, Real.norm_eq_abs]
      have h4 : |v m ω| ^ 2 ≤ 1 := by
        have := hv1 m ω; nlinarith [abs_nonneg (v m ω)]
      nlinarith [sq_nonneg ‖D ω‖]
    rw [e1, e2]
    linarith

/-- **`L²` bound for martingale transforms** with predictable coefficients `|v_k| ≤ 1`. -/
theorem lepMT_L2 (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    {M : ℕ} (hleaf : ∀ ω ω', lab M ω = lab M ω' → ω = ω')
    {v : ℕ → Ω → ℝ} (hv : ∀ k, LepMeas lab k (v k)) (hv1 : ∀ k ω, |v k ω| ≤ 1)
    (F : Ω → ℂ) : ∑ ω, ‖lepMT lab M v F ω‖ ^ 2 ≤ ∑ ω, ‖F ω‖ ^ 2 := by
  have := lepMT_L2_aux hr hv hv1 F M
  rw [lepAvg_of_leaf lab hleaf] at this
  have h0 : 0 ≤ ∑ ω, ‖lepAvg lab 0 F ω‖ ^ 2 := Finset.sum_nonneg fun _ _ => by positivity
  linarith

/-- **Weak type `(1,1)` of martingale transforms** on a regular filtration (atoms of level `k`
have at most `K` times as many points as their sub-atoms of level `k + 1`), via the
Calderón–Zygmund (Gundy) decomposition at the stopping time of the dyadic maximal function. -/
theorem lepMT_weak (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    {K : ℕ} (hK : 1 ≤ K) (hreg : ∀ k ω, (lepAtom lab k ω).card ≤ K * (lepAtom lab (k + 1) ω).card)
    {M : ℕ} (hleaf : ∀ ω ω', lab M ω = lab M ω' → ω = ω')
    {v : ℕ → Ω → ℝ} (hv : ∀ k, LepMeas lab k (v k)) (hv1 : ∀ k ω, |v k ω| ≤ 1)
    (F : Ω → ℂ) {α : ℝ} (hα : 0 < α) :
    ((univ.filter fun ω => α < ‖lepMT lab M v F ω‖).card : ℝ) * α ≤
      (K + 1) * ∑ ω, ‖F ω‖ := by
  classical
  set Fa : Ω → ℝ := fun ω => ‖F ω‖ with hFa
  have hFa0 : ∀ ω, 0 ≤ Fa ω := fun ω => norm_nonneg _
  set P : ℕ → Ω → Prop := fun k ω => α < lepAvg lab k Fa ω with hPdef
  set ind : ℕ → Ω → ℝ := fun k ω => if P k ω ∧ ∀ i < k, ¬ P i ω then 1 else 0 with hind
  set w : Ω → ℝ := fun ω => ∑ k ∈ range (M + 1), ind k ω with hwdef
  set Gk : ℕ → Ω → ℂ := fun k ω => if k = 0 then 0 else lepAvg lab k F ω with hGk
  set G : Ω → ℂ := fun ω => ∑ k ∈ range (M + 1), ind k ω • Gk k ω + (1 - w ω) • F ω with hG
  have hP_meas : ∀ i k, i ≤ k → ∀ ω ω', lab k ω = lab k ω' → (P i ω ↔ P i ω') := by
    intro i k hik ω ω' h
    simp only [hPdef, lepAvg_meas lab i Fa ω ω' (lepLab_mono hr hik h)]
  have hind_meas : ∀ k, LepMeas lab k (ind k) := by
    intro k ω ω' h
    simp only [hind]
    rw [if_congr (and_congr (hP_meas k k le_rfl ω ω' h)
      (forall₂_congr fun i hi => not_congr (hP_meas i k hi.le ω ω' h))) rfl rfl]
  have hind01 : ∀ k ω, ind k ω = 0 ∨ ind k ω = 1 := by
    intro k ω; simp only [hind]; split_ifs <;> simp
  have hind_nonneg : ∀ k ω, 0 ≤ ind k ω := fun k ω => by
    rcases hind01 k ω with h | h <;> simp [h]
  have hind_P : ∀ k ω, ind k ω = 1 → P k ω ∧ ∀ i < k, ¬ P i ω := by
    intro k ω h
    by_contra hc
    simp only [hind, ite_eq_right hc] at h
    norm_num at h
  have hw : ∀ ω, w ω = if ∃ k, k ≤ M ∧ P k ω then 1 else 0 := by
    intro ω
    split_ifs with hex
    · have hk₀ := Nat.find_spec hex
      have hmin : ∀ i < Nat.find hex, ¬ (i ≤ M ∧ P i ω) := fun i hi => Nat.find_min hex hi
      have hind0 : ind (Nat.find hex) ω = 1 := by
        simp only [hind]
        rw [ite_eq_left]
        exact ⟨hk₀.2, fun i hi hPi => hmin i hi ⟨by omega, hPi⟩⟩
      simp only [hwdef]
      rw [Finset.sum_eq_single (Nat.find hex)]
      · exact hind0
      · intro l _ hl
        simp only [hind]
        rw [ite_eq_right]
        rintro ⟨hPl, hlt⟩
        rcases lt_or_gt_of_ne hl with h | h
        · exact hmin l h ⟨by omega, hPl⟩
        · exact hlt _ h hk₀.2
      · intro h; exact absurd (Finset.mem_range.mpr (by omega)) h
    · simp only [hwdef]
      refine Finset.sum_eq_zero fun k hk => ?_
      simp only [hind]
      rw [ite_eq_right]
      rintro ⟨hPk, _⟩
      exact hex ⟨k, by simp at hk; omega, hPk⟩
  have hw01 : ∀ ω, w ω = 0 ∨ w ω = 1 := fun ω => by
    rw [hw ω]; split_ifs <;> simp
  have hw_le : ∀ ω, w ω ≤ 1 := fun ω => by rcases hw01 ω with h | h <;> simp [h]
  have hw_nonneg : ∀ ω, 0 ≤ w ω := fun ω => by rcases hw01 ω with h | h <;> simp [h]
  have hw0 : ∀ ω, w ω = 0 → ∀ k ≤ M, ¬ P k ω := by
    intro ω h k hk hP
    rw [hw ω, ite_eq_left ⟨k, hk, hP⟩] at h
    norm_num at h
  have hKα : α ≤ K * α := by
    have : (1 : ℝ) ≤ K := by exact_mod_cast hK
    nlinarith
  have hGk_bound : ∀ k ω, ind k ω * ‖Gk k ω‖ ≤ ind k ω * (K * α) := by
    intro k ω
    rcases hind01 k ω with h | h
    · simp [h]
    rw [h, one_mul, one_mul]
    obtain ⟨_, hlt⟩ := hind_P k ω h
    simp only [hGk]
    split_ifs with hk0
    · rw [norm_zero]; positivity
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    calc ‖lepAvg lab (j + 1) F ω‖ ≤ lepAvg lab (j + 1) Fa ω := norm_lepAvg_le lab _ F ω
      _ ≤ K * lepAvg lab j Fa ω := lepAvg_succ_le lab hr hreg hFa0 j ω
      _ ≤ K * α := mul_le_mul_of_nonneg_left (not_lt.mp (hlt j (by omega))) (by positivity)
  have hGk_bound' : ∀ k ω, ind k ω * ‖Gk k ω‖ ≤ ind k ω * lepAvg lab k Fa ω := by
    intro k ω
    refine mul_le_mul_of_nonneg_left ?_ (hind_nonneg k ω)
    simp only [hGk]
    split_ifs
    · simpa using lepAvg_nonneg lab hFa0 ω
    · exact norm_lepAvg_le lab _ F ω
  have hF_bound : ∀ ω, (1 - w ω) * ‖F ω‖ ≤ (1 - w ω) * (K * α) := by
    intro ω
    rcases hw01 ω with h | h
    · rw [h, sub_zero, one_mul, one_mul]
      have h' := hw0 ω h M le_rfl
      simp only [hPdef, lepAvg_of_leaf lab hleaf] at h'
      exact (not_lt.mp h').trans hKα
    · rw [h]; simp
  have hG_norm : ∀ ω, ‖G ω‖ ≤
      ∑ k ∈ range (M + 1), ind k ω * ‖Gk k ω‖ + (1 - w ω) * ‖F ω‖ := by
    intro ω
    refine (norm_add_le _ _).trans (add_le_add ((norm_sum_le _ _).trans
      (le_of_eq (Finset.sum_congr rfl fun k _ => ?_))) (le_of_eq ?_))
    · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hind_nonneg k ω)]
    · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by linarith [hw_le ω])]
  have hG_inf : ∀ ω, ‖G ω‖ ≤ K * α := by
    intro ω
    calc ‖G ω‖ ≤ _ := hG_norm ω
      _ ≤ ∑ k ∈ range (M + 1), ind k ω * (K * α) + (1 - w ω) * (K * α) :=
          add_le_add (Finset.sum_le_sum fun k _ => hGk_bound k ω) (hF_bound ω)
      _ = K * α := by rw [← Finset.sum_mul, hwdef]; ring
  have hswap : ∀ k, ∑ ω, ind k ω * lepAvg lab k Fa ω = ∑ ω, ind k ω * Fa ω :=
    fun k => sum_smul_lepAvg lab (hind_meas k) Fa
  have hG_one : ∑ ω, ‖G ω‖ ≤ ∑ ω, ‖F ω‖ := by
    calc ∑ ω, ‖G ω‖ ≤ ∑ ω, (∑ k ∈ range (M + 1), ind k ω * lepAvg lab k Fa ω +
          (1 - w ω) * Fa ω) :=
          Finset.sum_le_sum fun ω _ => (hG_norm ω).trans
            (add_le_add (Finset.sum_le_sum fun k _ => hGk_bound' k ω) le_rfl)
      _ = ∑ k ∈ range (M + 1), ∑ ω, ind k ω * lepAvg lab k Fa ω +
          ∑ ω, (1 - w ω) * Fa ω := by rw [Finset.sum_add_distrib, Finset.sum_comm]
      _ = ∑ k ∈ range (M + 1), ∑ ω, ind k ω * Fa ω + ∑ ω, (1 - w ω) * Fa ω := by
          rw [Finset.sum_congr rfl fun k _ => hswap k]
      _ = ∑ ω, Fa ω := by
          rw [Finset.sum_comm, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun ω _ => ?_
          rw [← Finset.sum_mul, hwdef]; ring
  have hW5 : ∀ ω, w ω = 0 → ∀ k ≤ M, lepAvg lab k G ω = lepAvg lab k F ω := by
    intro ω hω k hk
    have hnP : ∀ i ≤ M, ¬ P i ω := hw0 ω hω
    set X : Ω → ℝ := fun ω' => if lab k ω' = lab k ω then 1 else 0 with hXdef
    have hX : LepMeas lab k X := fun a b h => by simp only [hXdef, h]
    have key : ∀ H : Ω → ℂ, ∑ ω' ∈ lepAtom lab k ω, H ω' = ∑ ω', X ω' • H ω' := by
      intro H
      rw [lepAtom, Finset.sum_filter]
      refine Finset.sum_congr rfl fun ω' _ => ?_
      simp only [hXdef]; split_ifs <;> simp
    have hterm : ∀ i ∈ range (M + 1), ∑ ω', (X ω' * ind i ω') • Gk i ω' =
        ∑ ω', (X ω' * ind i ω') • F ω' := by
      intro i hi
      by_cases hik : i ≤ k
      · have hz : ∀ ω', X ω' * ind i ω' = 0 := by
          intro ω'
          simp only [hXdef]
          split_ifs with h
          · rcases hind01 i ω' with h0 | h1
            · simp [h0]
            · exfalso
              exact hnP i (by simp at hi; omega)
                ((hP_meas i k hik ω' ω h).mp (hind_P i ω' h1).1)
          · simp
        simp [hz]
      · have hi0 : i ≠ 0 := by omega
        have hmeas : LepMeas lab i (fun ω' => X ω' * ind i ω') := fun a b h => by
          simp only [LepMeas.mono hr (by omega : k ≤ i) hX a b h, hind_meas i a b h]
        have := sum_smul_lepAvg lab hmeas F
        simpa [hGk, hi0] using this
    rw [lepAvg, lepAvg, key, key]
    congr 1
    calc ∑ ω', X ω' • G ω' = ∑ i ∈ range (M + 1), ∑ ω', (X ω' * ind i ω') • Gk i ω' +
          ∑ ω', (X ω' * (1 - w ω')) • F ω' := by
          simp only [hG, smul_add, Finset.smul_sum, smul_smul, Finset.sum_add_distrib]
          rw [Finset.sum_comm]
      _ = ∑ i ∈ range (M + 1), ∑ ω', (X ω' * ind i ω') • F ω' +
          ∑ ω', (X ω' * (1 - w ω')) • F ω' := by rw [Finset.sum_congr rfl hterm]
      _ = ∑ ω', X ω' • F ω' := by
          rw [Finset.sum_comm, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun ω' _ => ?_
          rw [← Finset.sum_smul, ← add_smul, ← Finset.mul_sum, hwdef]
          congr 1; ring
  have hT : ∀ ω, w ω = 0 → lepMT lab M v F ω = lepMT lab M v G ω := by
    intro ω hω
    simp only [lepMT]
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    rw [hW5 ω hω (k + 1) (by omega), hW5 ω hω k (by omega)]
  have hcount : ∀ ω, (if α < ‖lepMT lab M v F ω‖ then (1 : ℝ) else 0) ≤
      w ω + (if α < ‖lepMT lab M v G ω‖ then 1 else 0) := by
    intro ω
    rcases hw01 ω with h | h
    · rw [h, zero_add, hT ω h]
    · rw [h]; split_ifs <;> norm_num
  have hcard : ((univ.filter fun ω => α < ‖lepMT lab M v F ω‖).card : ℝ) =
      ∑ ω, if α < ‖lepMT lab M v F ω‖ then (1 : ℝ) else 0 := by
    rw [Finset.sum_boole]
  have hbad : (∑ ω, w ω) * α ≤ ∑ ω, ‖F ω‖ := by
    calc (∑ ω, w ω) * α = ∑ k ∈ range (M + 1), ∑ ω, ind k ω * α := by
          rw [Finset.sum_mul, hwdef]
          simp only [Finset.sum_mul]
          rw [Finset.sum_comm]
      _ ≤ ∑ k ∈ range (M + 1), ∑ ω, ind k ω * lepAvg lab k Fa ω := by
          refine Finset.sum_le_sum fun k _ => Finset.sum_le_sum fun ω _ => ?_
          rcases hind01 k ω with h | h
          · simp [h]
          · rw [h]; simpa using (hind_P k ω h).1.le
      _ = ∑ k ∈ range (M + 1), ∑ ω, ind k ω * Fa ω := Finset.sum_congr rfl fun k _ => hswap k
      _ = ∑ ω, w ω * Fa ω := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun ω _ => ?_
          rw [hwdef, Finset.sum_mul]
      _ ≤ ∑ ω, ‖F ω‖ := Finset.sum_le_sum fun ω _ => by
          have := hFa0 ω
          have := hw_le ω
          simp only [hFa] at *
          nlinarith
  have hgood : (∑ ω, if α < ‖lepMT lab M v G ω‖ then (1 : ℝ) else 0) * α ^ 2 ≤
      K * α * ∑ ω, ‖F ω‖ := by
    calc _ ≤ ∑ ω, ‖lepMT lab M v G ω‖ ^ 2 := by
          rw [Finset.sum_mul]
          refine Finset.sum_le_sum fun ω _ => ?_
          split_ifs with h
          · nlinarith
          · simp
      _ ≤ ∑ ω, ‖G ω‖ ^ 2 := lepMT_L2 hr hleaf hv hv1 G
      _ ≤ ∑ ω, (K * α) * ‖G ω‖ := Finset.sum_le_sum fun ω _ => by
          rw [sq]; exact mul_le_mul_of_nonneg_right (hG_inf ω) (norm_nonneg _)
      _ ≤ K * α * ∑ ω, ‖F ω‖ := by
          rw [← Finset.mul_sum]; exact mul_le_mul_of_nonneg_left hG_one (by positivity)
  have hgood' : (∑ ω, if α < ‖lepMT lab M v G ω‖ then (1 : ℝ) else 0) * α ≤
      K * ∑ ω, ‖F ω‖ := by
    refine le_of_mul_le_mul_right ?_ hα
    calc _ = (∑ ω, if α < ‖lepMT lab M v G ω‖ then (1 : ℝ) else 0) * α ^ 2 := by ring
      _ ≤ _ := hgood
      _ = _ := by ring
  rw [hcard]
  calc (∑ ω, if α < ‖lepMT lab M v F ω‖ then (1 : ℝ) else 0) * α ≤
        (∑ ω, (w ω + if α < ‖lepMT lab M v G ω‖ then (1 : ℝ) else 0)) * α :=
        mul_le_mul_of_nonneg_right (Finset.sum_le_sum fun ω _ => hcount ω) hα.le
    _ = (∑ ω, w ω) * α + (∑ ω, if α < ‖lepMT lab M v G ω‖ then (1 : ℝ) else 0) * α := by
        rw [Finset.sum_add_distrib, add_mul]
    _ ≤ ∑ ω, ‖F ω‖ + K * ∑ ω, ‖F ω‖ := add_le_add hbad hgood'
    _ = (K + 1) * ∑ ω, ‖F ω‖ := by ring

end Transform


/-! ### `L^p` bounds for martingale transforms, `1 < p < ∞` -/

section TransformLp

/-- Uniform `L^p` bound `‖T_v F‖_p ≤ C ‖F‖_p` (in the form of `p`-th powers) for all
martingale transforms with predictable coefficients `|v_k| ≤ 1` on all finite filtrations
whose atoms of level `k` contain at most `K` times as many points as those of level `k + 1`. -/
def LepMTBound (K : ℕ) (p C : ℝ) : Prop :=
  ∀ (Ω : Type) [Fintype Ω] (L : Type) [DecidableEq L] (lab : ℕ → Ω → L) (M : ℕ),
    (∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω') →
    (∀ k ω, (lepAtom lab k ω).card ≤ K * (lepAtom lab (k + 1) ω).card) →
    (∀ ω ω', lab M ω = lab M ω' → ω = ω') →
    ∀ v : ℕ → Ω → ℝ, (∀ k, LepMeas lab k (v k)) → (∀ k ω, |v k ω| ≤ 1) →
    ∀ F : Ω → ℂ, ∑ ω, ‖lepMT lab M v F ω‖ ^ p ≤ C ^ p * ∑ ω, ‖F ω‖ ^ p

theorem lep_eLpNorm_count {Ω : Type*} [Fintype Ω] [MeasurableSpace Ω]
    [MeasurableSingletonClass Ω] (X : Ω → ℂ) {p : ℝ} (hp : 0 < p) :
    eLpNorm X (ENNReal.ofReal p) Measure.count =
      ENNReal.ofReal ((∑ ω, ‖X ω‖ ^ p) ^ (1 / p)) := by
  rw [eLpNorm_ofReal_eq_lintegral_rpow_enorm (measurable_of_countable X).aestronglyMeasurable hp,
    lintegral_count, tsum_fintype]
  have : ∀ ω, ‖X ω‖ₑ ^ p = ENNReal.ofReal (‖X ω‖ ^ p) := fun ω => by
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le]
  simp_rw [this]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun _ _ => by positivity),
    ENNReal.ofReal_rpow_of_nonneg (Finset.sum_nonneg fun _ _ => by positivity) (by positivity)]

/-- The case `p = 2`. -/
theorem lepMTBound_two (K : ℕ) : LepMTBound K 2 1 := by
  intro Ω _ L _ lab M hr _ hleaf v hv hv1 F
  have := lepMT_L2 hr hleaf hv hv1 F
  simp only [Real.one_rpow, one_mul]
  have e : ∀ x : ℝ, x ^ (2 : ℝ) = x ^ (2 : ℕ) := fun x => by
    rw [← Real.rpow_natCast]; norm_num
  simp_rw [e]
  exact this

/-- The case `1 < p < 2`, by Marcinkiewicz interpolation between weak `(1,1)` and `L²`. -/
theorem lepMTBound_lt_two {K : ℕ} (hK : 1 ≤ K) {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2) :
    ∃ C, 0 ≤ C ∧ LepMTBound K p C := by
  set θ : ℝ := 2 - 2 / p with hθ
  have hp0 : 0 < p := by linarith
  have hθ1 : 0 < 1 - θ := by
    rw [hθ]
    have : 1 < 2 / p := by rw [lt_div_iff₀ hp0]; linarith
    linarith
  have hθ0 : 0 ≤ θ := by
    rw [hθ]
    have : 2 / p ≤ 2 := by rw [div_le_iff₀ hp0]; linarith
    linarith
  set A : ℝ≥0 := (K + 1 : ℝ≥0) with hA
  set Cm : ℝ≥0∞ := (marcinkiewiczConst 1 2 p : ℝ≥0∞) * (A : ℝ≥0∞) ^ (1 - θ) *
    ((1 : ℝ≥0) : ℝ≥0∞) ^ θ with hCm
  have hCm_top : Cm ≠ ∞ := by
    refine ENNReal.mul_ne_top (ENNReal.mul_ne_top (marcinkiewiczConst_ne_top 1 2 p) ?_) ?_
    · exact ENNReal.rpow_ne_top_of_nonneg hθ1.le ENNReal.coe_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg hθ0 ENNReal.coe_ne_top
  refine ⟨Cm.toReal, ENNReal.toReal_nonneg, ?_⟩
  intro Ω _ L _ lab M hr hreg hleaf v hv hv1 F
  let : MeasurableSpace Ω := ⊤
  have : MeasurableSingletonClass Ω := ⟨fun _ => MeasurableSpace.measurableSet_top⟩
  have hmeas : ∀ X : Ω → ℂ, AEStronglyMeasurable X Measure.count :=
    fun X => (measurable_of_countable X).aestronglyMeasurable
  set T : (Ω → ℂ) → Ω → ℂ := fun G => lepMT lab M v G with hT
  have hweak : HasWeakTypeOn T Set.univ 1 A Measure.count Measure.count := by
    intro G _ t ht
    rcases eq_or_ne t ∞ with rfl | htop
    · simp [distributionFunction]
    have ht' : t = ENNReal.ofReal t.toReal := (ENNReal.ofReal_toReal htop).symm
    have hα : 0 < t.toReal := ENNReal.toReal_pos ht.ne' htop
    rw [ht', distributionFunction_ofReal _ hα.le]
    have hset : {x | t.toReal < ‖T G x‖} =
        ↑(univ.filter fun ω => t.toReal < ‖lepMT lab M v G ω‖) := by
      ext; simp [hT]
    rw [hset, Measure.count_apply_finset, ENNReal.rpow_one, ENNReal.ofReal_one,
      eLpNorm_one_eq_lintegral_enorm (hmeas G), lintegral_count, tsum_fintype]
    have hw := lepMT_weak hr hK hreg hleaf hv hv1 G hα
    rw [ENNReal.le_div_iff_mul_le (Or.inl (by simpa using hα)) (Or.inl ENNReal.ofReal_ne_top)]
    have e1 : ∑ ω, ‖G ω‖ₑ = ENNReal.ofReal (∑ ω, ‖G ω‖) := by
      rw [ENNReal.ofReal_sum_of_nonneg (fun _ _ => norm_nonneg _)]
      simp [ofReal_norm]
    have e2 : (A : ℝ≥0∞) = ENNReal.ofReal (K + 1) := by
      rw [hA]; rw [← ENNReal.ofReal_coe_nnreal]; congr 1
    have e3 : ((univ.filter fun ω => t.toReal < ‖lepMT lab M v G ω‖).card : ℝ≥0∞) =
        ENNReal.ofReal ((univ.filter fun ω => t.toReal < ‖lepMT lab M v G ω‖).card : ℝ) := by
      rw [ENNReal.ofReal_natCast]
    rw [e1, e2, e3, ← ENNReal.ofReal_mul (Nat.cast_nonneg _),
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ K + 1)]
    exact ENNReal.ofReal_le_ofReal hw
  have hstrong : HasStrongTypeOn T Set.univ 2 1 Measure.count Measure.count := by
    intro G _
    rw [lep_eLpNorm_count _ two_pos, lep_eLpNorm_count _ two_pos, ENNReal.coe_one, one_mul]
    refine ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow
      (Finset.sum_nonneg fun _ _ => by positivity) ?_ (by norm_num))
    have := lepMTBound_two K Ω L lab M hr hreg hleaf v hv hv1 G
    simpa using this
  have hsub : IsSublinearOn T Set.univ Measure.count := by
    intro G _ H _
    refine ae_of_all _ fun x => ?_
    simp only [hT]
    rw [show G + H = fun ω => G ω + H ω from rfl, lepMT_add]
    exact norm_add_le _ _
  have hmain := eLpNorm_le_of_hasWeakTypeOn (θ := θ) (by norm_num : (0 : ℝ) < 1) hp1 hp2
    (by rw [hθ]; field_simp; ring) hweak (hstrong.hasWeakTypeOn two_pos) hsub
    isTruncationClosed_univ (Set.mem_univ F) (hmeas F) (hmeas _)
  rw [lep_eLpNorm_count _ hp0, lep_eLpNorm_count _ hp0, ← hCm,
    ← ENNReal.ofReal_toReal hCm_top, ← ENNReal.ofReal_mul ENNReal.toReal_nonneg,
    ENNReal.ofReal_le_ofReal_iff (by positivity)] at hmain
  set SF := ∑ ω, ‖F ω‖ ^ p
  set ST := ∑ ω, ‖lepMT lab M v F ω‖ ^ p
  have hSF : 0 ≤ SF := Finset.sum_nonneg fun _ _ => by positivity
  have hST : 0 ≤ ST := Finset.sum_nonneg fun _ _ => by positivity
  calc ST = (ST ^ (1 / p)) ^ p := by
        rw [← Real.rpow_mul hST, one_div, inv_mul_cancel₀ hp0.ne', Real.rpow_one]
    _ ≤ (Cm.toReal * SF ^ (1 / p)) ^ p := Real.rpow_le_rpow (by positivity) hmain hp0.le
    _ = Cm.toReal ^ p * SF := by
        rw [Real.mul_rpow ENNReal.toReal_nonneg (by positivity), ← Real.rpow_mul hSF, one_div,
          inv_mul_cancel₀ hp0.ne', Real.rpow_one]

variable {Ω : Type*} [Fintype Ω] {L : Type*} [DecidableEq L] {lab : ℕ → Ω → L}

/-- Martingale transforms with real coefficients are self-adjoint. -/
theorem lepMT_inner_symm (hr : ∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω')
    {v : ℕ → Ω → ℝ} (hv : ∀ k, LepMeas lab k (v k)) (M : ℕ) (F H : Ω → ℂ) :
    ∑ ω, inner ℝ (lepMT lab M v F ω) (H ω) = ∑ ω, inner ℝ (F ω) (lepMT lab M v H ω) := by
  simp only [lepMT, sum_inner, inner_sum]
  rw [Finset.sum_comm, Finset.sum_comm (s := univ)]
  refine Finset.sum_congr rfl fun k _ => ?_
  have e : ∀ l, k ≤ l → ∑ ω, inner ℝ (v k ω • lepAvg lab l F ω) (H ω) =
      ∑ ω, inner ℝ (F ω) (v k ω • lepAvg lab l H ω) := by
    intro l hl
    calc ∑ ω, inner ℝ (v k ω • lepAvg lab l F ω) (H ω) =
          ∑ ω, inner ℝ (lepAvg lab l F ω) (v k ω • H ω) := by
          refine Finset.sum_congr rfl fun ω _ => ?_
          rw [real_inner_smul_left, real_inner_smul_right]
      _ = ∑ ω, inner ℝ (F ω) (lepAvg lab l (fun ω => v k ω • H ω) ω) :=
          sum_inner_lepAvg_symm lab l F _
      _ = _ := by rw [lepAvg_smul_meas lab (LepMeas.mono hr hl (hv k))]
  simp only [smul_sub, inner_sub_left, inner_sub_right, Finset.sum_sub_distrib]
  rw [e (k + 1) (Nat.le_succ k), e k le_rfl]

/-- Duality: a uniform bound at `q` gives the same bound at the conjugate exponent `p`. -/
theorem LepMTBound.dual {K : ℕ} {p q C : ℝ} (hpq : p.HolderConjugate q) (hC : 0 ≤ C)
    (h : LepMTBound K q C) : LepMTBound K p C := by
  intro Ω _ L _ lab M hr hreg hleaf v hv hv1 F
  have hp : 1 < p := hpq.lt
  have hq : 1 < q := hpq.symm.lt
  have hp0 : 0 < p := by linarith
  have hq0 : 0 < q := by linarith
  set X := lepMT lab M v F with hX
  set H : Ω → ℂ := fun ω => (‖X ω‖ ^ (p - 2)) • X ω with hH
  have hnormH : ∀ ω, ‖H ω‖ = ‖X ω‖ ^ (p - 1) := by
    intro ω
    rw [hH, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rcases eq_or_ne (X ω) 0 with h0 | h0
    · rw [h0, norm_zero, mul_zero, Real.zero_rpow (by linarith)]
    · have : 0 < ‖X ω‖ := norm_pos_iff.mpr h0
      conv_rhs => rw [show p - 1 = (p - 2) + 1 by ring, Real.rpow_add this, Real.rpow_one]
  have hXH : ∀ ω, inner ℝ (X ω) (H ω) = ‖X ω‖ ^ p := by
    intro ω
    rw [hH, real_inner_smul_right, real_inner_self_eq_norm_sq]
    rcases eq_or_ne (X ω) 0 with h0 | h0
    · rw [h0, norm_zero, Real.zero_rpow hp0.ne']; ring
    · have : 0 < ‖X ω‖ := norm_pos_iff.mpr h0
      conv_rhs => rw [show p = (p - 2) + 2 by ring, Real.rpow_add this]
      rw [Real.rpow_two]
  have hHq : ∀ ω, ‖H ω‖ ^ q = ‖X ω‖ ^ p := by
    intro ω
    rw [hnormH, ← Real.rpow_mul (norm_nonneg _), hpq.sub_one_mul_conj]
  set S := ∑ ω, ‖X ω‖ ^ p with hS
  set SF := ∑ ω, ‖F ω‖ ^ p with hSF
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun _ _ => by positivity
  have hSF0 : 0 ≤ SF := Finset.sum_nonneg fun _ _ => by positivity
  have hTH := h Ω L lab M hr hreg hleaf v hv hv1 H
  simp_rw [hHq] at hTH
  have key : S ≤ SF ^ (1 / p) * (C * S ^ (1 / q)) := by
    calc S = ∑ ω, inner ℝ (X ω) (H ω) := by
          rw [hS]; exact (Finset.sum_congr rfl fun ω _ => hXH ω).symm
      _ = ∑ ω, inner ℝ (F ω) (lepMT lab M v H ω) := lepMT_inner_symm hr hv M F H
      _ ≤ ∑ ω, ‖F ω‖ * ‖lepMT lab M v H ω‖ :=
          Finset.sum_le_sum fun ω _ => real_inner_le_norm _ _
      _ ≤ (∑ ω, |‖F ω‖| ^ p) ^ (1 / p) * (∑ ω, |‖lepMT lab M v H ω‖| ^ q) ^ (1 / q) :=
          Real.inner_le_Lp_mul_Lq _ _ _ hpq
      _ = SF ^ (1 / p) * (∑ ω, ‖lepMT lab M v H ω‖ ^ q) ^ (1 / q) := by
          simp only [abs_norm, hSF]
      _ ≤ SF ^ (1 / p) * (C ^ q * S) ^ (1 / q) := by
          refine mul_le_mul_of_nonneg_left (Real.rpow_le_rpow
            (Finset.sum_nonneg fun _ _ => by positivity) hTH (by positivity)) (by positivity)
      _ = SF ^ (1 / p) * (C * S ^ (1 / q)) := by
          rw [Real.mul_rpow (by positivity) hS0, ← Real.rpow_mul hC,
            mul_one_div_cancel hq0.ne', Real.rpow_one]
  rcases eq_or_lt_of_le hS0 with hS00 | hSpos
  · rw [← hS00]; positivity
  · have hsplit : S = S ^ (1 / p) * S ^ (1 / q) := by
      rw [← Real.rpow_add hSpos, one_div, one_div, hpq.inv_add_inv_eq_one, Real.rpow_one]
    have hSq : 0 < S ^ (1 / q) := Real.rpow_pos_of_pos hSpos _
    have h1 : S ^ (1 / p) ≤ C * SF ^ (1 / p) := by
      have : S ^ (1 / p) * S ^ (1 / q) ≤ (C * SF ^ (1 / p)) * S ^ (1 / q) := by
        rw [← hsplit]; linarith [key]
      exact le_of_mul_le_mul_right this hSq
    calc S = (S ^ (1 / p)) ^ p := by
          rw [← Real.rpow_mul hS0, one_div, inv_mul_cancel₀ hp0.ne', Real.rpow_one]
      _ ≤ (C * SF ^ (1 / p)) ^ p := Real.rpow_le_rpow (by positivity) h1 hp0.le
      _ = C ^ p * SF := by
          rw [Real.mul_rpow hC (by positivity), ← Real.rpow_mul hSF0, one_div,
            inv_mul_cancel₀ hp0.ne', Real.rpow_one]

/-- **`L^p` boundedness of martingale transforms**, `1 < p < ∞`, uniformly over all regular
finite filtrations with regularity constant `K` and all predictable `|v_k| ≤ 1`. -/
theorem lepMTBound_exists {K : ℕ} (hK : 1 ≤ K) {p : ℝ} (hp : 1 < p) :
    ∃ C, 0 ≤ C ∧ LepMTBound K p C := by
  rcases lt_trichotomy p 2 with h | rfl | h
  · exact lepMTBound_lt_two hK hp h
  · exact ⟨1, zero_le_one, lepMTBound_two K⟩
  · have hpq := Real.HolderConjugate.conjExponent hp
    have hq2 : p.conjExponent < 2 := by
      rw [Real.conjExponent, div_lt_iff₀ (by linarith)]; linarith
    obtain ⟨C, hC, hb⟩ := lepMTBound_lt_two hK hpq.symm.lt hq2
    exact ⟨C, hC, hb.dual hpq hC⟩

end TransformLp


/-! ### Greedy stopping times and the sampled square function -/

section Greedy

/-- The greedy stopping times for oscillations of size `> η` of a sequence `b`: the pair
(`anchor`, `count`) after processing the indices `0, …, j`. The anchor is the last stopping
time `≤ j` and the count is the number of stopping times in `[1, j]`; a new stopping time
occurs at `j + 1` iff `‖b (j + 1) - b anchor‖ > η`. -/
noncomputable def lepGreedy (b : ℕ → ℂ) (η : ℝ) : ℕ → ℕ × ℕ
  | 0 => (0, 0)
  | j + 1 => if η < ‖b (j + 1) - b (lepGreedy b η j).1‖ then
      (j + 1, (lepGreedy b η j).2 + 1) else lepGreedy b η j

variable (b : ℕ → ℂ) (η : ℝ)

theorem lepGreedy_zero : lepGreedy b η 0 = (0, 0) := rfl

theorem lepGreedy_succ (j : ℕ) : lepGreedy b η (j + 1) =
    if η < ‖b (j + 1) - b (lepGreedy b η j).1‖ then
      (j + 1, (lepGreedy b η j).2 + 1) else lepGreedy b η j := rfl

theorem lepGreedy_fst_le : ∀ j, (lepGreedy b η j).1 ≤ j
  | 0 => le_rfl
  | j + 1 => by
    rw [lepGreedy_succ]
    split_ifs
    · exact le_rfl
    · exact (lepGreedy_fst_le j).trans (Nat.le_succ j)

theorem lepGreedy_snd_le : ∀ j, (lepGreedy b η j).2 ≤ j
  | 0 => le_rfl
  | j + 1 => by
    rw [lepGreedy_succ]
    split_ifs
    · exact Nat.succ_le_succ (lepGreedy_snd_le j)
    · exact (lepGreedy_snd_le j).trans (Nat.le_succ j)

theorem lepGreedy_snd_mono : Monotone fun j => (lepGreedy b η j).2 := by
  refine monotone_nat_of_le_succ fun j => ?_
  simp only [lepGreedy_succ]
  split_ifs
  · exact Nat.le_succ _
  · exact le_rfl

theorem lepGreedy_near (hη : 0 ≤ η) : ∀ j, ‖b j - b (lepGreedy b η j).1‖ ≤ η
  | 0 => by simp [lepGreedy_zero, hη]
  | j + 1 => by
    rw [lepGreedy_succ]
    split_ifs with h
    · simp [hη]
    · exact not_lt.mp h

theorem lepGreedy_fst_eq_of_snd_eq (s : ℕ) : ∀ d, (lepGreedy b η s).2 = (lepGreedy b η (s + d)).2 →
    (lepGreedy b η s).1 = (lepGreedy b η (s + d)).1
  | 0 => fun _ => rfl
  | d + 1 => by
    intro h
    have hm1 := lepGreedy_snd_mono b η (Nat.le_add_right s d)
    have hm2 := lepGreedy_snd_mono b η (Nat.le_add_right (s + d) 1)
    simp only at hm1 hm2
    rw [← add_assoc] at h ⊢
    have h' : (lepGreedy b η s).2 = (lepGreedy b η (s + d)).2 := by omega
    rw [lepGreedy_fst_eq_of_snd_eq s d h', lepGreedy_succ]
    split_ifs with hj
    · exfalso
      rw [lepGreedy_succ, ite_eq_left hj] at h
      simp only at h
      omega
    · rfl

/-- An oscillation of size `> 2η` between `s ≤ t` forces a stopping time in `(s, t]`. -/
theorem lepGreedy_snd_lt (hη : 0 ≤ η) {s t : ℕ} (hst : s ≤ t)
    (hj : 2 * η < ‖b t - b s‖) : (lepGreedy b η s).2 < (lepGreedy b η t).2 := by
  by_contra hc
  have hm := lepGreedy_snd_mono b η hst
  simp only at hm
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hst
  have heq := lepGreedy_fst_eq_of_snd_eq b η s d (by omega)
  have h1 := lepGreedy_near b η hη s
  have h2 := lepGreedy_near b η hη (s + d)
  rw [← heq] at h2
  have : ‖b (s + d) - b s‖ ≤ 2 * η := by
    calc ‖b (s + d) - b s‖ = ‖(b (s + d) - b (lepGreedy b η s).1) -
          (b s - b (lepGreedy b η s).1)‖ := by congr 1; ring
      _ ≤ ‖b (s + d) - b (lepGreedy b η s).1‖ + ‖b s - b (lepGreedy b η s).1‖ := norm_sub_le _ _
      _ ≤ 2 * η := by linarith
  linarith

/-- The number of disjoint oscillations of size `> 2η` within `[0, m]` is at most the number of
greedy stopping times in `[1, m]`. -/
theorem lepGreedy_config (hη : 0 ≤ η) {N : ℕ} {s t : Fin N → ℕ} (hst : ∀ i, s i < t i)
    (hts : ∀ i j, i < j → t i < s j) (hjump : ∀ i, 2 * η < ‖b (t i) - b (s i)‖) {m : ℕ}
    (htm : ∀ i, t i ≤ m) : N ≤ (lepGreedy b η m).2 := by
  rcases Nat.eq_zero_or_pos N with rfl | hN
  · exact Nat.zero_le _
  have key : ∀ i (hi : i < N), i + 1 ≤ (lepGreedy b η (t ⟨i, hi⟩)).2 := by
    intro i
    induction i with
    | zero =>
      intro hi
      have := lepGreedy_snd_lt b η hη (hst ⟨0, hi⟩).le (hjump ⟨0, hi⟩)
      omega
    | succ i ih =>
      intro hi
      have h1 := ih (by omega)
      have h2 := lepGreedy_snd_mono b η
        (hts ⟨i, by omega⟩ ⟨i + 1, hi⟩ (by simp [Fin.lt_def])).le
      have h3 := lepGreedy_snd_lt b η hη (hst ⟨i + 1, hi⟩).le (hjump ⟨i + 1, hi⟩)
      simp only at h2
      omega
  have h1 := key (N - 1) (by omega)
  have h2 := lepGreedy_snd_mono b η (htm ⟨N - 1, by omega⟩)
  simp only at h2
  omega

/-- The greedy procedure up to `j` only depends on `b 0, …, b j`. -/
theorem lepGreedy_congr {b b' : ℕ → ℂ} : ∀ j, (∀ i ≤ j, b i = b' i) →
    lepGreedy b η j = lepGreedy b' η j
  | 0 => fun _ => rfl
  | j + 1 => by
    intro h
    have ih := lepGreedy_congr j fun i hi => h i (hi.trans (Nat.le_succ j))
    rw [lepGreedy_succ, lepGreedy_succ, ih, h (j + 1) le_rfl,
      h _ ((lepGreedy_fst_le b' η j).trans (Nat.le_succ j))]

/-- The increments of the sequence sampled at the greedy stopping times (the last one possibly
incomplete), written as sums of martingale differences. -/
noncomputable def lepIncr (m k : ℕ) : ℂ :=
  ∑ j ∈ range m, if (lepGreedy b η j).2 = k then b (j + 1) - b j else 0

theorem lepIncr_spec (hη : 0 ≤ η) : ∀ m k,
    (k < (lepGreedy b η m).2 → η < ‖lepIncr b η m k‖) ∧
    (k = (lepGreedy b η m).2 → lepIncr b η m k = b m - b (lepGreedy b η m).1) ∧
    ((lepGreedy b η m).2 < k → lepIncr b η m k = 0)
  | 0, k => by
    refine ⟨fun h => by simp [lepGreedy_zero] at h, fun _ => by simp [lepIncr, lepGreedy_zero],
      fun _ => by simp [lepIncr]⟩
  | m + 1, k => by
    have ih := lepIncr_spec hη m k
    have hsucc : lepIncr b η (m + 1) k = lepIncr b η m k +
        if (lepGreedy b η m).2 = k then b (m + 1) - b m else 0 := by
      simp [lepIncr, Finset.sum_range_succ]
    rw [hsucc, lepGreedy_succ]
    split_ifs with hj hk hk
    · -- jump, `k = count m`
      subst hk
      refine ⟨fun _ => ?_, fun h => absurd h (by omega), fun h => absurd h (by omega)⟩
      rw [ih.2.1 rfl]
      calc η < ‖b (m + 1) - b (lepGreedy b η m).1‖ := hj
        _ = _ := by congr 1; ring
    · -- jump, `k ≠ count m`
      simp only [add_zero]
      refine ⟨fun h => ih.1 (by omega), fun h => ?_, fun h => ih.2.2 (by omega)⟩
      rw [ih.2.2 (by omega)]; simp
    · -- no jump, `k = count m`
      subst hk
      refine ⟨fun h => absurd h (lt_irrefl _), fun _ => ?_, fun h => absurd h (lt_irrefl _)⟩
      rw [ih.2.1 rfl]; ring
    · -- no jump, `k ≠ count m`
      simp only [add_zero]
      exact ⟨fun h => ih.1 h, fun h => absurd h.symm hk, fun h => ih.2.2 h⟩

theorem lepIncr_sq_sum (hη : 0 ≤ η) (m : ℕ) :
    (lepGreedy b η m).2 * η ^ 2 ≤ ∑ k ∈ range (m + 1), ‖lepIncr b η m k‖ ^ 2 := by
  have hsub : range (lepGreedy b η m).2 ⊆ range (m + 1) := by
    intro k hk
    simp only [Finset.mem_range] at hk ⊢
    have := lepGreedy_snd_le b η m
    omega
  calc ((lepGreedy b η m).2 : ℝ) * η ^ 2 = ∑ k ∈ range (lepGreedy b η m).2, η ^ 2 := by simp
    _ ≤ ∑ k ∈ range (lepGreedy b η m).2, ‖lepIncr b η m k‖ ^ 2 := by
        refine Finset.sum_le_sum fun k hk => ?_
        have := (lepIncr_spec b η hη m k).1 (Finset.mem_range.mp hk)
        exact pow_le_pow_left₀ hη this.le 2
    _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => by positivity

theorem lepIncr_rademacher (m : ℕ) (u : Finset ℕ) :
    rademacherSum (range (m + 1)) u (lepIncr b η m) =
      ∑ j ∈ range m, (if (lepGreedy b η j).2 ∈ u then (1 : ℝ) else -1) • (b (j + 1) - b j) := by
  classical
  calc rademacherSum (range (m + 1)) u (lepIncr b η m)
      = ∑ k ∈ range (m + 1), ∑ j ∈ range m, (if (lepGreedy b η j).2 = k then
          (if k ∈ u then b (j + 1) - b j else -(b (j + 1) - b j)) else 0) := by
        unfold rademacherSum lepIncr
        refine Finset.sum_congr rfl fun k _ => ?_
        split_ifs with hk
        · refine Finset.sum_congr rfl fun j _ => ?_
          split_ifs <;> rfl
        · rw [← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl fun j _ => ?_
          split_ifs <;> simp
    _ = ∑ j ∈ range m, ∑ k ∈ range (m + 1), (if (lepGreedy b η j).2 = k then
          (if k ∈ u then b (j + 1) - b j else -(b (j + 1) - b j)) else 0) := Finset.sum_comm
    _ = _ := by
        refine Finset.sum_congr rfl fun j hj => ?_
        rw [Finset.sum_ite_eq, ite_eq_left]
        · split_ifs <;> simp
        · have := lepGreedy_snd_le b η j
          simp only [Finset.mem_range] at hj ⊢
          omega

end Greedy

/-! ### The jump inequality on a finite regular filtration -/

section TreeJump

/-- **Lépingle's inequality on finite regular filtrations**: with `N_ω` the number of greedy
`η`-stopping times of `k ↦ E_k F (ω)` in `[1, M]`,
`∑_ω (η² N_ω)^{p/2} ≤ C ∑_ω |F ω|^p`, uniformly. -/
theorem lep_tree_jump {K : ℕ} (hK : 1 ≤ K) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ω : Type) [Fintype Ω] (L : Type) [DecidableEq L] (lab : ℕ → Ω → L)
      (M : ℕ), (∀ k ω ω', lab (k + 1) ω = lab (k + 1) ω' → lab k ω = lab k ω') →
      (∀ k ω, (lepAtom lab k ω).card ≤ K * (lepAtom lab (k + 1) ω).card) →
      (∀ ω ω', lab M ω = lab M ω' → ω = ω') →
      ∀ (F : Ω → ℂ) (η : ℝ), 0 < η →
      ∑ ω, (η ^ 2 * (lepGreedy (fun k => lepAvg lab k F ω) η M).2) ^ (p / 2) ≤
        C * ∑ ω, ‖F ω‖ ^ p := by
  classical
  obtain ⟨CT, hCT, hT⟩ := lepMTBound_exists hK hp
  have hp0 : 0 < p := by linarith
  set c := khintchineLowerConst p with hc
  have hc0 : 0 < c := khintchineLowerConst_pos p
  refine ⟨(c⁻¹) ^ p * CT ^ p, by positivity, ?_⟩
  intro Ω _ L _ lab M hr hreg hleaf F η hη
  set bω : Ω → ℕ → ℂ := fun ω k => lepAvg lab k F ω with hbω
  set s := range (M + 1)
  set v : Finset ℕ → ℕ → Ω → ℝ := fun u k ω =>
    if (lepGreedy (bω ω) η k).2 ∈ u then 1 else -1 with hv
  have hv_meas : ∀ u k, LepMeas lab k (v u k) := by
    intro u k ω ω' h
    have : lepGreedy (bω ω) η k = lepGreedy (bω ω') η k :=
      lepGreedy_congr η k fun i hi => lepAvg_meas lab i F ω ω' (lepLab_mono hr hi h)
    simp only [hv, this]
  have hv1 : ∀ u k ω, |v u k ω| ≤ 1 := by
    intro u k ω; simp only [hv]; split_ifs <;> simp
  have hrad : ∀ u ω, rademacherSum s u (lepIncr (bω ω) η M) = lepMT lab M (v u) F ω := by
    intro u ω
    rw [lepIncr_rademacher]
    rfl
  -- pointwise estimate
  have hpt : ∀ ω, (η ^ 2 * (lepGreedy (bω ω) η M).2) ^ (p / 2) ≤
      (c⁻¹) ^ p * rademacherMean s (fun u => ‖lepMT lab M (v u) F ω‖ ^ p) := by
    intro ω
    set S := ∑ k ∈ s, ‖lepIncr (bω ω) η M k‖ ^ 2 with hS
    have hS0 : 0 ≤ S := Finset.sum_nonneg fun _ _ => by positivity
    have h1 : η ^ 2 * (lepGreedy (bω ω) η M).2 ≤ S := by
      rw [mul_comm]; exact lepIncr_sq_sum (bω ω) η hη.le M
    have hkh := khintchine_lower_rpow ℂ s (lepIncr (bω ω) η M) hp0
    simp_rw [hrad] at hkh
    rw [← hS] at hkh
    calc (η ^ 2 * (lepGreedy (bω ω) η M).2) ^ (p / 2) ≤ S ^ (p / 2) :=
          Real.rpow_le_rpow (by positivity) h1 (by positivity)
      _ = (c⁻¹) ^ p * (c * Real.sqrt S) ^ p := by
          rw [Real.mul_rpow hc0.le (Real.sqrt_nonneg _), ← mul_assoc,
            ← Real.mul_rpow (inv_nonneg.mpr hc0.le) hc0.le, inv_mul_cancel₀ hc0.ne',
            Real.one_rpow, one_mul, Real.sqrt_eq_rpow, ← Real.rpow_mul hS0]
          ring_nf
      _ ≤ _ := mul_le_mul_of_nonneg_left hkh (by positivity)
  have hmean : ∀ u ∈ s.powerset, ∑ ω, ‖lepMT lab M (v u) F ω‖ ^ p ≤
      CT ^ p * ∑ ω, ‖F ω‖ ^ p :=
    fun u _ => hT Ω L lab M hr hreg hleaf (v u) (hv_meas u) (hv1 u) F
  calc ∑ ω, (η ^ 2 * (lepGreedy (fun k => lepAvg lab k F ω) η M).2) ^ (p / 2)
      ≤ ∑ ω, (c⁻¹) ^ p * rademacherMean s (fun u => ‖lepMT lab M (v u) F ω‖ ^ p) :=
        Finset.sum_le_sum fun ω _ => hpt ω
    _ = (c⁻¹) ^ p * ((2 ^ s.card : ℝ)⁻¹ *
          ∑ u ∈ s.powerset, ∑ ω, ‖lepMT lab M (v u) F ω‖ ^ p) := by
        rw [← Finset.mul_sum]
        congr 1
        simp only [rademacherMean]
        rw [← Finset.mul_sum, Finset.sum_comm]
    _ ≤ (c⁻¹) ^ p * ((2 ^ s.card : ℝ)⁻¹ *
          ∑ u ∈ s.powerset, CT ^ p * ∑ ω, ‖F ω‖ ^ p) := by
        gcongr with u hu
        exact hmean u hu
    _ = (c⁻¹) ^ p * CT ^ p * ∑ ω, ‖F ω‖ ^ p := by
        rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul]
        push_cast
        field_simp

end TreeJump


/-! ### The dyadic filtration on a block of `ℤⁿ` -/

section DyadicTree

theorem lep_ediv_eq_iff {d : ℤ} (hd : 0 < d) (x q : ℤ) :
    x / d = q ↔ x ∈ Finset.Ico (q * d) (q * d + d) := by
  rw [Finset.mem_Ico]
  constructor
  · rintro rfl
    refine ⟨(Int.le_ediv_iff_mul_le hd).mp le_rfl, ?_⟩
    have := (Int.ediv_lt_iff_lt_mul hd).mp (lt_add_one (x / d))
    linarith
  · rintro ⟨h1, h2⟩
    have a1 := (Int.le_ediv_iff_mul_le hd).mpr h1
    have a2 : x / d < q + 1 := (Int.ediv_lt_iff_lt_mul hd).mpr (by linarith)
    omega

theorem lep_ediv_congr {d D : ℤ} (hd : 0 < d) (hdD : d ∣ D) {x y : ℤ} (h : x / d = y / d) :
    x / D = y / D := by
  obtain ⟨e, rfl⟩ := hdD
  rw [← Int.ediv_ediv_of_nonneg hd.le, ← Int.ediv_ediv_of_nonneg hd.le, h]

variable (n : ℕ)

/-- The block index `⌊m / 2^M⌋` of a lattice point `m ∈ ℤⁿ`. -/
def lepBlock {n : ℕ} (M : ℕ) (m : Fin n → ℤ) : Fin n → ℤ := fun i => m i / 2 ^ M

/-- The block `{m ∈ ℤⁿ | ⌊m / 2^M⌋ = c}` of `2^{nM}` lattice points. -/
abbrev LepFib (M : ℕ) (c : Fin n → ℤ) : Type :=
  {m : Fin n → ℤ // lepBlock M m = c}

instance (M : ℕ) (c : Fin n → ℤ) : Fintype (LepFib n M c) :=
  Fintype.subtype (Fintype.piFinset fun i => Finset.Ico (c i * 2 ^ M) (c i * 2 ^ M + 2 ^ M))
    (fun m => by
      simp only [Fintype.mem_piFinset, funext_iff, lepBlock]
      exact forall_congr' fun i => (lep_ediv_eq_iff (by positivity) (m i) (c i)).symm)

/-- The dyadic labels on a block: level `k` is the index of the dyadic sub-block of side
`2^{M-k}`. -/
def lepDLab (M : ℕ) (c : Fin n → ℤ) (k : ℕ) (ω : LepFib n M c) : Fin n → ℤ :=
  fun i => ω.1 i / 2 ^ (M - k)

variable {n}

theorem lepDLab_refine (M : ℕ) (c : Fin n → ℤ) (k : ℕ) (ω ω' : LepFib n M c)
    (h : lepDLab n M c (k + 1) ω = lepDLab n M c (k + 1) ω') :
    lepDLab n M c k ω = lepDLab n M c k ω' := by
  funext i
  have hi := congrFun h i
  simp only [lepDLab] at hi ⊢
  exact lep_ediv_congr (by positivity) (pow_dvd_pow 2 (by omega)) hi

theorem lepDLab_leaf (M : ℕ) (c : Fin n → ℤ) (ω ω' : LepFib n M c)
    (h : lepDLab n M c M ω = lepDLab n M c M ω') : ω = ω' := by
  apply Subtype.ext
  funext i
  have hi := congrFun h i
  simpa [lepDLab] using hi

theorem lepDLab_card (M : ℕ) (c : Fin n → ℤ) (k : ℕ) (ω : LepFib n M c) :
    (lepAtom (lepDLab n M c) k ω).card = (2 ^ (M - k)) ^ n := by
  classical
  set d : ℤ := 2 ^ (M - k) with hd
  have hd0 : 0 < d := by positivity
  have hmap : (lepAtom (lepDLab n M c) k ω).map (Function.Embedding.subtype _) =
      Fintype.piFinset fun i => Finset.Ico (ω.1 i / d * d) (ω.1 i / d * d + d) := by
    refine Finset.ext fun m => ?_
    simp only [Finset.mem_map, Function.Embedding.coe_subtype, Fintype.mem_piFinset]
    constructor
    · rintro ⟨ω', hω', rfl⟩ i
      have := congrFun ((mem_lepAtom _).mp hω') i
      simp only [lepDLab] at this
      exact (lep_ediv_eq_iff hd0 _ _).mp this
    · intro hm
      have hm' : ∀ i, m i / d = ω.1 i / d := fun i => (lep_ediv_eq_iff hd0 _ _).mpr (hm i)
      have hfib : lepBlock M m = c := by
        rw [← ω.2]
        funext i
        exact lep_ediv_congr hd0 (pow_dvd_pow 2 (Nat.sub_le M k)) (hm' i)
      refine ⟨⟨m, hfib⟩, (mem_lepAtom _).mpr ?_, rfl⟩
      funext i
      exact hm' i
  rw [← Finset.card_map (Function.Embedding.subtype _), hmap, Fintype.card_piFinset]
  simp only [Int.card_Ico, add_sub_cancel_left, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin, hd]
  congr 1

theorem lepDLab_reg (M : ℕ) (c : Fin n → ℤ) (k : ℕ) (ω : LepFib n M c) :
    (lepAtom (lepDLab n M c) k ω).card ≤ 2 ^ n * (lepAtom (lepDLab n M c) (k + 1) ω).card := by
  rw [lepDLab_card, lepDLab_card, ← mul_pow]
  refine Nat.pow_le_pow_left ?_ n
  rw [← pow_succ']
  exact Nat.pow_le_pow_right (by norm_num) (by omega)

end DyadicTree


/-! ### Jump counting functions -/

section Jumps

/-- The `λ`-jump counting function of a sequence `a : ℤ → ℂ`: the supremum of all `N` such that
there are `s₁ < t₁ < s₂ < t₂ < ⋯ < s_N < t_N` with `|a_{t_i} - a_{s_i}| > λ`. -/
noncomputable def seqJumpCount (lam : ℝ) (a : ℤ → ℂ) : ℝ≥0∞ :=
  ⨆ (N : ℕ) (s : Fin N → ℤ) (t : Fin N → ℤ) (_ : ∀ i, s i < t i)
    (_ : ∀ i j, i < j → t i < s j)
    (_ : ∀ i, lam < ‖a (t i) - a (s i)‖), (N : ℝ≥0∞)

/-- The `λ`-jump counting function restricted to the window `[-J, J]`. -/
noncomputable def lepWinJump (lam : ℝ) (a : ℤ → ℂ) (J : ℕ) : ℝ≥0∞ :=
  ⨆ (N : ℕ) (s : Fin N → ℤ) (t : Fin N → ℤ) (_ : ∀ i, s i < t i)
    (_ : ∀ i j, i < j → t i < s j)
    (_ : ∀ i, -(J : ℤ) ≤ s i ∧ t i ≤ J) (_ : ∀ i, lam < ‖a (t i) - a (s i)‖), (N : ℝ≥0∞)

theorem seqJumpCount_eq_iSup (lam : ℝ) (a : ℤ → ℂ) :
    seqJumpCount lam a = ⨆ J : ℕ, lepWinJump lam a J := by
  apply le_antisymm
  · refine iSup_le fun N => iSup_le fun s => iSup_le fun t => iSup_le fun h1 =>
      iSup_le fun h2 => iSup_le fun h3 => ?_
    set J : ℕ := ∑ i, ((s i).natAbs + (t i).natAbs) with hJ
    have hw : ∀ i, -(J : ℤ) ≤ s i ∧ t i ≤ J := by
      intro i
      have : (s i).natAbs + (t i).natAbs ≤ J :=
        Finset.single_le_sum (f := fun i => (s i).natAbs + (t i).natAbs)
          (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      omega
    refine le_iSup_of_le J ?_
    exact le_iSup_of_le N (le_iSup_of_le s (le_iSup_of_le t (le_iSup_of_le h1
      (le_iSup_of_le h2 (le_iSup_of_le hw (le_iSup_of_le h3 le_rfl))))))
  · refine iSup_le fun J => iSup_le fun N => iSup_le fun s => iSup_le fun t => iSup_le fun h1 =>
      iSup_le fun h2 => iSup_le fun _ => iSup_le fun h3 => ?_
    exact le_iSup_of_le N (le_iSup_of_le s (le_iSup_of_le t (le_iSup_of_le h1
      (le_iSup_of_le h2 (le_iSup_of_le h3 le_rfl)))))

theorem lepWinJump_mono (lam : ℝ) (a : ℤ → ℂ) : Monotone (lepWinJump lam a) := by
  intro J J' hJ
  refine iSup_le fun N => iSup_le fun s => iSup_le fun t => iSup_le fun h1 =>
      iSup_le fun h2 => iSup_le fun hw => iSup_le fun h3 => ?_
  have hw' : ∀ i, -(J' : ℤ) ≤ s i ∧ t i ≤ J' := fun i => by
    have := hw i; have : (J : ℤ) ≤ J' := by exact_mod_cast hJ
    constructor <;> linarith [(hw i).1, (hw i).2]
  exact le_iSup_of_le N (le_iSup_of_le s (le_iSup_of_le t (le_iSup_of_le h1
    (le_iSup_of_le h2 (le_iSup_of_le hw' (le_iSup_of_le h3 le_rfl))))))

theorem lepWinJump_congr (lam : ℝ) {a a' : ℤ → ℂ} (J : ℕ)
    (h : ∀ j, -(J : ℤ) ≤ j → j ≤ J → a j = a' j) : lepWinJump lam a J = lepWinJump lam a' J := by
  unfold lepWinJump
  refine iSup_congr fun N => iSup_congr fun s => iSup_congr fun t => iSup_congr fun h1 =>
    iSup_congr fun _ => iSup_congr fun hw => ?_
  have : (∀ i, lam < ‖a (t i) - a (s i)‖) ↔ (∀ i, lam < ‖a' (t i) - a' (s i)‖) := by
    refine forall_congr' fun i => ?_
    have := hw i; have := h1 i
    rw [h (t i) (by omega) (by omega), h (s i) (by omega) (by omega)]
  exact iSup_congr_Prop this fun _ => rfl

/-- Jumps in the window `[-J, J]` are controlled by the greedy stopping times at level `λ/2`. -/
theorem lepWinJump_le_greedy {lam : ℝ} (hlam : 0 ≤ lam) (a : ℤ → ℂ) (J : ℕ) (b : ℕ → ℂ)
    (hb : ∀ k ≤ 2 * J, a ((k : ℤ) - J) = b k) :
    lepWinJump lam a J ≤ ((lepGreedy b (lam / 2) (2 * J)).2 : ℝ≥0∞) := by
  refine iSup_le fun N => iSup_le fun s => iSup_le fun t => iSup_le fun h1 =>
      iSup_le fun h2 => iSup_le fun hw => iSup_le fun h3 => ?_
  have e : ∀ u : ℤ, -(J : ℤ) ≤ u → u ≤ J → b (u + J).toNat = a u := by
    intro u hu1 hu2
    rw [← hb _ (by omega)]
    congr 1; omega
  have := lepGreedy_config b (lam / 2) (by positivity) (s := fun i => (s i + J).toNat)
    (t := fun i => (t i + J).toNat) (m := 2 * J)
    (fun i => by have := hw i; have := h1 i; omega)
    (fun i j hij => by
      have := hw i; have := hw j; have := h1 i; have := h2 i j hij; omega)
    (fun i => by
      have := hw i; have := h1 i
      change 2 * (lam / 2) < ‖b (t i + J).toNat - b (s i + J).toNat‖
      rw [e _ (by omega) (by omega), e _ (by omega) (by omega)]
      linarith [h3 i])
    (fun i => by have := hw i; have := h1 i; omega)
  exact_mod_cast this

end Jumps

/-! ### Dyadic cubes and averages on `ℝⁿ` -/

section Euclid

/-- The half-open dyadic cube `Q_j(x) = {y | ∀ i, ⌊2^j y_i⌋ = ⌊2^j x_i⌋}` of side `2^{-j}`
containing `x`. -/
def dyadicCube (n : ℕ) (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    Set (EuclideanSpace ℝ (Fin n)) :=
  {y | ∀ i, ⌊(2 : ℝ) ^ j * y i⌋ = ⌊(2 : ℝ) ^ j * x i⌋}

/-- The dyadic martingale `E_j f(x) = 2^{jn} ∫_{Q_j(x)} f`: the average of `f` over the dyadic
cube of side `2^{-j}` containing `x`. -/
noncomputable def dyadicAvg (n : ℕ) (j : ℤ) (f : EuclideanSpace ℝ (Fin n) → ℂ)
    (x : EuclideanSpace ℝ (Fin n)) : ℂ :=
  (((2 : ℝ) ^ (j * n) : ℝ) : ℂ) * ∫ y in dyadicCube n j x, f y

variable {n : ℕ}

/-- The index `(⌊2^j x_i⌋)_i ∈ ℤⁿ` of the dyadic cube of generation `j` containing `x`. -/
noncomputable def lepIdx (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) : Fin n → ℤ :=
  fun i => ⌊(2 : ℝ) ^ j * x i⌋

theorem measurable_lepIdx (j : ℤ) : Measurable (lepIdx (n := n) j) := by
  refine measurable_pi_iff.mpr fun i => ?_
  exact Int.measurable_floor.comp (by fun_prop)

theorem dyadicCube_eq (j : ℤ) (x : EuclideanSpace ℝ (Fin n)) :
    dyadicCube n j x = lepIdx j ⁻¹' {lepIdx j x} := by
  ext y; simp [dyadicCube, lepIdx, funext_iff]

theorem lepIdx_div {j J : ℤ} (d : ℕ) (hd : J = j + d) (x : EuclideanSpace ℝ (Fin n))
    (i : Fin n) : lepIdx j x i = lepIdx J x i / 2 ^ d := by
  simp only [lepIdx]
  have : (2 : ℝ) ^ j * x i = (2 : ℝ) ^ J * x i / ((2 ^ d : ℕ) : ℝ) := by
    rw [hd, zpow_add₀ two_ne_zero]
    push_cast
    field_simp
    norm_cast
  rw [this, Int.floor_div_natCast]
  push_cast; rfl

theorem measurableSet_lepIdx (J : ℤ) (m : Fin n → ℤ) :
    MeasurableSet (lepIdx (n := n) J ⁻¹' {m}) :=
  measurable_lepIdx J (measurableSet_singleton m)

theorem volume_lepIdx (J : ℤ) (m : Fin n → ℤ) :
    volume (lepIdx (n := n) J ⁻¹' {m}) = ENNReal.ofReal ((2 : ℝ) ^ (-J)) ^ n := by
  have he := EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin n)
  have h2 : (0 : ℝ) < 2 ^ J := zpow_pos two_pos J
  have hset : lepIdx (n := n) J ⁻¹' {m} = (MeasurableEquiv.toLp 2 (Fin n → ℝ)).symm ⁻¹'
      (Set.univ.pi fun i => Set.Ico ((m i : ℝ) / 2 ^ J) ((m i + 1) / 2 ^ J)) := by
    ext y
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_pi, Set.mem_univ, true_implies,
      Set.mem_Ico]
    change (fun i => ⌊(2 : ℝ) ^ J * y i⌋) = m ↔
      ∀ i, (m i : ℝ) / 2 ^ J ≤ y i ∧ y i < (m i + 1) / 2 ^ J
    rw [funext_iff]
    refine forall_congr' fun i => ?_
    rw [Int.floor_eq_iff, div_le_iff₀ h2, lt_div_iff₀ h2, mul_comm (y i)]
  rw [hset, he.measure_preimage_equiv, Real.volume_pi_Ico]
  have : ∀ i, ((m i : ℝ) + 1) / 2 ^ J - m i / 2 ^ J = (2 : ℝ) ^ (-J) := fun i => by
    rw [← sub_div, add_sub_cancel_left, zpow_neg, one_div]
  simp only [this, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

/-- A function factoring through a measurable map into a countable discrete space is
measurable. -/
theorem lep_measurable_of_factor {X β κ : Type*} [MeasurableSpace X] [MeasurableSpace β]
    [MeasurableSpace κ] [Countable κ] [MeasurableSingletonClass κ] {φ : X → κ}
    (hφ : Measurable φ) {g : X → β} (hg : ∀ x x', φ x = φ x' → g x = g x') : Measurable g := by
  intro S _
  have : g ⁻¹' S = φ ⁻¹' (φ '' (g ⁻¹' S)) := by
    ext x
    constructor
    · intro hx; exact ⟨x, hx, rfl⟩
    · rintro ⟨x', hx', hxx'⟩
      simp only [Set.mem_preimage] at hx' ⊢
      rw [hg x x' hxx'.symm]; exact hx'
  rw [this]
  exact hφ (Set.to_countable _).measurableSet

end Euclid


/-! ### Reduction of the windowed inequality on `ℝⁿ` to the finite blocks -/

section Window

variable {n : ℕ}

/-- Hölder's inequality on a set: `|∫_Q f|^p ≤ |Q|^{p-1} ∫_Q |f|^p`. -/
theorem lep_holder_set {Q : Set (EuclideanSpace ℝ (Fin n))} {p : ℝ} (hp : 1 ≤ p)
    {f : EuclideanSpace ℝ (Fin n) → ℂ} (hf : AEStronglyMeasurable f volume) :
    ‖∫ y in Q, f y‖ₑ ^ p ≤ volume Q ^ (p - 1) * ∫⁻ y in Q, ‖f y‖ₑ ^ p := by
  have hp0 : 0 < p := by linarith
  have h1 : ‖∫ y in Q, f y‖ₑ ≤ eLpNorm f 1 (volume.restrict Q) :=
    (enorm_integral_le_lintegral_enorm _).trans (eLpNorm_one_eq_lintegral_enorm hf.restrict).ge
  have h2 := eLpNorm_le_eLpNorm_mul_rpow_measure_univ (μ := volume.restrict Q) (p := 1)
    (q := ENNReal.ofReal p) (by simpa using hp) hf.restrict
  rw [Measure.restrict_apply_univ, eLpNorm_ofReal_eq_lintegral_rpow_enorm hf.restrict hp0,
    ENNReal.toReal_one, ENNReal.toReal_ofReal hp0.le, div_one] at h2
  calc ‖∫ y in Q, f y‖ₑ ^ p ≤ ((∫⁻ y in Q, ‖f y‖ₑ ^ p) ^ (1 / p) * volume Q ^ (1 - 1 / p)) ^ p :=
        ENNReal.rpow_le_rpow (h1.trans h2) hp0.le
    _ = volume Q ^ (p - 1) * ∫⁻ y in Q, ‖f y‖ₑ ^ p := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          mul_comm]
        congr 1
        · congr 1; field_simp
        · rw [one_div_mul_cancel hp0.ne', ENNReal.rpow_one]

theorem lep_psi_eq {lam : ℝ} (hlam : 0 ≤ lam) (N : ℕ) {p : ℝ} (hp : 0 < p) :
    (ENNReal.ofReal lam * (N : ℝ≥0∞) ^ (1 / 2 : ℝ)) ^ p =
      ENNReal.ofReal (2 ^ p * ((lam / 2) ^ 2 * N) ^ (p / 2)) := by
  rw [← ENNReal.ofReal_natCast, ENNReal.ofReal_rpow_of_nonneg (Nat.cast_nonneg _) (by norm_num),
    ← ENNReal.ofReal_mul hlam, ENNReal.ofReal_rpow_of_nonneg (by positivity) hp.le]
  congr 1
  rw [Real.mul_rpow hlam (by positivity), ← Real.rpow_mul (Nat.cast_nonneg _),
    Real.mul_rpow (by positivity) (Nat.cast_nonneg _), ← mul_assoc]
  have h2 : ((lam / 2) ^ 2) ^ (p / 2) = (lam / 2) ^ p := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
    congr 1; push_cast; ring
  rw [h2, ← Real.mul_rpow (by norm_num) (by positivity), show 2 * (lam / 2) = lam by ring,
    show 1 / 2 * p = p / 2 by ring]

/-- The dyadic averages at `x` only depend on the dyadic cube of a finer generation. -/
theorem lep_dyadicAvg_congr {j J : ℤ} (hjJ : j ≤ J) (f : EuclideanSpace ℝ (Fin n) → ℂ)
    {x x' : EuclideanSpace ℝ (Fin n)} (h : lepIdx J x = lepIdx J x') :
    dyadicAvg n j f x = dyadicAvg n j f x' := by
  have hd : J = j + ((J - j).toNat : ℕ) := by omega
  have : dyadicCube n j x = dyadicCube n j x' := by
    rw [dyadicCube_eq, dyadicCube_eq]
    congr 2
    funext i
    rw [lepIdx_div _ hd, lepIdx_div _ hd x', h]
  simp only [dyadicAvg, this]

/-- The windowed jump inequality on `ℝⁿ`, uniformly in the window. -/
theorem lep_window_bound {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ f : EuclideanSpace ℝ (Fin n) → ℂ, MemLp f (ENNReal.ofReal p) volume →
      ∀ lam : ℝ, 0 < lam → ∀ J : ℕ,
      ∫⁻ x, (ENNReal.ofReal lam *
          lepWinJump lam (fun j => dyadicAvg n j f x) J ^ (1 / 2 : ℝ)) ^ p ≤
        ENNReal.ofReal C * ∫⁻ x, ‖f x‖ₑ ^ p := by
  obtain ⟨C, hC, hT⟩ := lep_tree_jump (K := 2 ^ n) Nat.one_le_two_pow hp
  refine ⟨2 ^ p * C, by positivity, ?_⟩
  intro f hf lam hlam J
  have hp0 : 0 < p := by linarith
  have hfm := hf.aestronglyMeasurable
  set M := 2 * J with hM
  set a : (Fin n → ℤ) → ℂ := fun m =>
    (((2 : ℝ) ^ ((J : ℤ) * n) : ℝ) : ℂ) * ∫ y in lepIdx (J : ℤ) ⁻¹' {m}, f y with ha
  set F : ∀ c, LepFib n M c → ℂ := fun c ω => a ω.1 with hF
  set cntc : ∀ c, LepFib n M c → ℕ := fun c ω =>
    (lepGreedy (fun k => lepAvg (lepDLab n M c) k (F c) ω) (lam / 2) M).2 with hcntc
  set cnt : (Fin n → ℤ) → ℕ := fun m => cntc (lepBlock M m) ⟨m, rfl⟩ with hcnt_def
  have hcnt : ∀ c (ω : LepFib n M c), cnt ω.1 = cntc c ω := by
    rintro c ⟨m, rfl⟩; rfl
  have hIO : ∀ m' : Fin n → ℤ, IntegrableOn f (lepIdx (J : ℤ) ⁻¹' {m'}) volume := by
    intro m'
    have hfin : volume (lepIdx (n := n) (J : ℤ) ⁻¹' {m'}) ≠ ∞ := by
      rw [volume_lepIdx]; exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    have : IsFiniteMeasure (volume.restrict (lepIdx (n := n) (J : ℤ) ⁻¹' {m'})) :=
      isFiniteMeasure_restrict.mpr hfin
    exact (hf.restrict _).integrable (by rw [ENNReal.one_le_ofReal]; linarith)
  -- the dyadic averages are the averages of the finite filtration on the block
  have hR1 : ∀ x : EuclideanSpace ℝ (Fin n), ∀ k ≤ M,
      dyadicAvg n ((k : ℤ) - J) f x =
        lepAvg (lepDLab n M (lepBlock M (lepIdx J x))) k (F _) ⟨lepIdx J x, rfl⟩ := by
    intro x k hk
    set m := lepIdx (J : ℤ) x with hm
    set c := lepBlock M m with hc
    set ω₀ : LepFib n M c := ⟨m, rfl⟩ with hω₀
    set j : ℤ := (k : ℤ) - J with hj
    have hjd : (J : ℤ) = j + ((M - k : ℕ) : ℤ) := by
      rw [hj, Nat.cast_sub hk, hM]; push_cast; ring
    have hcube : dyadicCube n j x =
        ⋃ ω' ∈ lepAtom (lepDLab n M c) k ω₀, lepIdx (J : ℤ) ⁻¹' {ω'.1} := by
      ext y
      simp only [dyadicCube_eq, Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion,
        exists_prop]
      constructor
      · intro hy
        have hy' : ∀ i, lepIdx (J : ℤ) y i / 2 ^ (M - k) = m i / 2 ^ (M - k) := fun i => by
          rw [hm, ← lepIdx_div _ hjd, ← lepIdx_div _ hjd]; exact congrFun hy i
        refine ⟨⟨lepIdx J y, ?_⟩, (mem_lepAtom _).mpr ?_, rfl⟩
        · rw [hc]; funext i
          exact lep_ediv_congr (by positivity) (pow_dvd_pow 2 (Nat.sub_le M k)) (hy' i)
        · funext i; exact hy' i
      · rintro ⟨ω', hω', hy⟩
        have hl := (mem_lepAtom _).mp hω'
        funext i
        rw [lepIdx_div _ hjd, lepIdx_div _ hjd x, hy]
        exact congrFun hl i
    have hint : ∫ y in dyadicCube n j x, f y =
        ∑ ω' ∈ lepAtom (lepDLab n M c) k ω₀, ∫ y in lepIdx (J : ℤ) ⁻¹' {ω'.1}, f y := by
      rw [hcube]
      refine integral_biUnion_finset _ (fun ω' _ => measurableSet_lepIdx _ _) ?_
        (fun ω' _ => hIO _)
      intro ω₁ _ ω₂ _ hne
      refine Set.disjoint_left.mpr fun y h1 h2 => hne (Subtype.ext ?_)
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at h1 h2
      rw [← h1, ← h2]
    have hpow : (2 : ℝ) ^ (j * n) =
        (((2 ^ (M - k)) ^ n : ℕ) : ℝ)⁻¹ * (2 : ℝ) ^ ((J : ℤ) * n) := by
      rw [hjd, add_mul, zpow_add₀ two_ne_zero]
      have : (((2 ^ (M - k)) ^ n : ℕ) : ℝ) = (2 : ℝ) ^ (((M - k : ℕ) : ℤ) * n) := by
        push_cast
        rw [← pow_mul, ← zpow_natCast]
        push_cast; ring_nf
      rw [this]
      field_simp
    rw [dyadicAvg, hint, lepAvg, lepDLab_card]
    simp only [hF, ha]
    rw [← Finset.mul_sum, Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul, ← hpow]
  -- pointwise control of the windowed jumps
  have hpt : ∀ x : EuclideanSpace ℝ (Fin n),
      lepWinJump lam (fun j => dyadicAvg n j f x) J ≤ (cnt (lepIdx J x) : ℝ≥0∞) :=
    fun x => lepWinJump_le_greedy hlam.le _ J _ (fun k hk => hR1 x k hk)
  set Ψ : (Fin n → ℤ) → ℝ≥0∞ := fun m =>
    (ENNReal.ofReal lam * (cnt m : ℝ≥0∞) ^ (1 / 2 : ℝ)) ^ p with hΨ
  set V : ℝ≥0∞ := ENNReal.ofReal ((2 : ℝ) ^ (-(J : ℤ))) ^ n with hV
  have step2 : ∫⁻ x, (ENNReal.ofReal lam *
        lepWinJump lam (fun j => dyadicAvg n j f x) J ^ (1 / 2 : ℝ)) ^ p ≤
      ∫⁻ x, Ψ (lepIdx J x) :=
    lintegral_mono fun x => ENNReal.rpow_le_rpow (by
      gcongr; exact hpt x) hp0.le
  have step3 : ∫⁻ x, Ψ (lepIdx J x) = ∑' m, Ψ m * V := by
    rw [← lintegral_map (measurable_of_countable Ψ) (measurable_lepIdx _), lintegral_countable']
    congr 1; funext m
    rw [Measure.map_apply (measurable_lepIdx _) (measurableSet_singleton m), volume_lepIdx]
  have hsig : ∀ G : (Fin n → ℤ) → ℝ≥0∞, ∑' m, G m = ∑' c, ∑ ω : LepFib n M c, G ω.1 := by
    intro G
    rw [← (Equiv.sigmaFiberEquiv (lepBlock (n := n) M)).tsum_eq, ENNReal.tsum_sigma']
    congr 1; funext c
    rw [tsum_fintype]
    rfl
  have step5 : ∀ c, ∑ ω : LepFib n M c, Ψ ω.1 ≤
      ENNReal.ofReal (2 ^ p * C) * ∑ ω : LepFib n M c, ‖a ω.1‖ₑ ^ p := by
    intro c
    have hTc := hT (LepFib n M c) (Fin n → ℤ) (lepDLab n M c) M (lepDLab_refine M c)
      (lepDLab_reg M c) (lepDLab_leaf M c) (F c) (lam / 2) (by positivity)
    have hΨc : ∀ ω : LepFib n M c, Ψ ω.1 =
        ENNReal.ofReal (2 ^ p * ((lam / 2) ^ 2 * (cntc c ω : ℝ)) ^ (p / 2)) := by
      intro ω
      simp only [hΨ]
      rw [hcnt c ω]
      exact lep_psi_eq hlam.le _ hp0
    have hfin : ∀ ω : LepFib n M c, ‖a ω.1‖ₑ ^ p = ENNReal.ofReal (‖F c ω‖ ^ p) := fun ω => by
      rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le]
    simp only [hΨc, hfin]
    rw [← ENNReal.ofReal_sum_of_nonneg (fun _ _ => by positivity),
      ← ENNReal.ofReal_sum_of_nonneg (fun _ _ => by positivity),
      ← ENNReal.ofReal_mul (by positivity), ← Finset.mul_sum]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [mul_assoc]
    exact mul_le_mul_of_nonneg_left hTc (by positivity)
  have step7 : ∀ m, V * ‖a m‖ₑ ^ p ≤ ∫⁻ y in lepIdx (J : ℤ) ⁻¹' {m}, ‖f y‖ₑ ^ p := by
    intro m
    have hH := lep_holder_set (Q := lepIdx (J : ℤ) ⁻¹' {m}) hp.le hfm
    rw [volume_lepIdx, ← hV] at hH
    have hW : ‖(((2 : ℝ) ^ ((J : ℤ) * n) : ℝ) : ℂ)‖ₑ =
        ENNReal.ofReal ((2 : ℝ) ^ ((J : ℤ) * n)) := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    have hV0 : V ≠ 0 := by
      rw [hV]; exact pow_ne_zero _ (by simp)
    have hVt : V ≠ ∞ := by rw [hV]; exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    have hVW : V * ENNReal.ofReal ((2 : ℝ) ^ ((J : ℤ) * n)) = 1 := by
      rw [hV, ← ENNReal.ofReal_pow (by positivity), ← ENNReal.ofReal_mul (by positivity),
        ← zpow_natCast, ← zpow_mul, ← zpow_add₀ two_ne_zero]
      simp
    calc V * ‖a m‖ₑ ^ p = V * (ENNReal.ofReal ((2 : ℝ) ^ ((J : ℤ) * n)) ^ p *
          ‖∫ y in lepIdx (J : ℤ) ⁻¹' {m}, f y‖ₑ ^ p) := by
          simp only [ha]
          rw [enorm_mul, hW, ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      _ ≤ V * (ENNReal.ofReal ((2 : ℝ) ^ ((J : ℤ) * n)) ^ p *
          (V ^ (p - 1) * ∫⁻ y in lepIdx (J : ℤ) ⁻¹' {m}, ‖f y‖ₑ ^ p)) := by gcongr
      _ = (V * ENNReal.ofReal ((2 : ℝ) ^ ((J : ℤ) * n))) ^ p *
          ∫⁻ y in lepIdx (J : ℤ) ⁻¹' {m}, ‖f y‖ₑ ^ p := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
          conv_rhs => rw [show p = 1 + (p - 1) by ring]
          rw [ENNReal.rpow_add _ _ hV0 hVt, ENNReal.rpow_one, ← show p = 1 + (p - 1) by ring]
          ring
      _ = _ := by rw [hVW, ENNReal.one_rpow, one_mul]
  have step8 : ∑' m, ∫⁻ y in lepIdx (J : ℤ) ⁻¹' {m}, ‖f y‖ₑ ^ p = ∫⁻ y, ‖f y‖ₑ ^ p := by
    rw [← lintegral_iUnion (fun m => measurableSet_lepIdx _ m)]
    · have : (⋃ m, lepIdx (n := n) (J : ℤ) ⁻¹' {m}) = Set.univ := by
        ext y; simp
      rw [this, Measure.restrict_univ]
    · intro m₁ m₂ hne
      exact Set.disjoint_left.mpr fun y h1 h2 => hne (h1.symm.trans h2)
  calc ∫⁻ x, (ENNReal.ofReal lam *
        lepWinJump lam (fun j => dyadicAvg n j f x) J ^ (1 / 2 : ℝ)) ^ p
      ≤ ∫⁻ x, Ψ (lepIdx J x) := step2
    _ = (∑' c, ∑ ω : LepFib n M c, Ψ ω.1) * V := by
        rw [step3, ENNReal.tsum_mul_right, hsig]
    _ ≤ (∑' c, ENNReal.ofReal (2 ^ p * C) * ∑ ω : LepFib n M c, ‖a ω.1‖ₑ ^ p) * V := by
        gcongr with c
        exact step5 c
    _ = ENNReal.ofReal (2 ^ p * C) * ∑' m, V * ‖a m‖ₑ ^ p := by
        rw [ENNReal.tsum_mul_left, hsig (fun m => V * ‖a m‖ₑ ^ p)]
        simp only [← Finset.mul_sum, ENNReal.tsum_mul_left]
        ring
    _ ≤ ENNReal.ofReal (2 ^ p * C) * ∑' m, ∫⁻ y in lepIdx (J : ℤ) ⁻¹' {m}, ‖f y‖ₑ ^ p := by
        gcongr with m
        exact step7 m
    _ = _ := by rw [step8]

end Window


/-! ### Main results -/

section Main

variable {n : ℕ}

theorem lep_rpow_iSup {ι : Sort*} (w : ι → ℝ≥0∞) {y : ℝ} (hy : 0 < y) :
    (⨆ i, w i) ^ y = ⨆ i, w i ^ y := by
  have := (ENNReal.orderIsoRpow y hy).map_iSup w
  simpa only [ENNReal.orderIsoRpow_apply] using this

theorem measurable_lepWinJump (f : EuclideanSpace ℝ (Fin n) → ℂ) (lam : ℝ) (J : ℕ) :
    Measurable fun x => lepWinJump lam (fun j => dyadicAvg n j f x) J :=
  lep_measurable_of_factor (measurable_lepIdx (J : ℤ)) fun _ _ h =>
    lepWinJump_congr lam J fun _ _ hj => lep_dyadicAvg_congr hj f h

/-- The jump counting function of the dyadic martingale is measurable. -/
theorem measurable_seqJumpCount_dyadicAvg (f : EuclideanSpace ℝ (Fin n) → ℂ) (lam : ℝ) :
    Measurable fun x => seqJumpCount lam (fun j => dyadicAvg n j f x) := by
  simp_rw [seqJumpCount_eq_iSup]
  exact Measurable.iSup fun J => measurable_lepWinJump f lam J

/-- Measurability of `x ↦ λ (N_λ(E_j f(x) : j ∈ ℤ))^{1/2}`. -/
theorem measurable_lepingle (f : EuclideanSpace ℝ (Fin n) → ℂ) (lam : ℝ) :
    Measurable fun x => ENNReal.ofReal lam *
      (seqJumpCount lam (fun j => dyadicAvg n j f x)) ^ (1 / 2 : ℝ) :=
  ((measurable_seqJumpCount_dyadicAvg f lam).pow_const _).const_mul _

/-- A.e.-measurability of `x ↦ λ (N_λ(E_j f(x) : j ∈ ℤ))^{1/2}`. -/
theorem aemeasurable_lepingle (f : EuclideanSpace ℝ (Fin n) → ℂ) (lam : ℝ) :
    AEMeasurable (fun x => ENNReal.ofReal lam *
      (seqJumpCount lam (fun j => dyadicAvg n j f x)) ^ (1 / 2 : ℝ)) volume :=
  (measurable_lepingle f lam).aemeasurable

/-- **Lépingle's jump inequality for the dyadic martingale on `ℝⁿ`**: for `1 < p < ∞` there is
a constant `C` such that for all `f ∈ L^p(ℝⁿ)` and all `λ > 0`,
`‖λ (N_λ(E_j f : j ∈ ℤ))^{1/2}‖_{L^p} ≤ C ‖f‖_{L^p}`, where `E_j f` is the average of `f` over
the dyadic cube of side `2^{-j}` containing the point and `N_λ` counts the `λ`-jumps. -/
theorem lepingle_jump_inequality (n : ℕ) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0, ∀ f : EuclideanSpace ℝ (Fin n) → ℂ, MemLp f (ENNReal.ofReal p) volume →
      ∀ lam : ℝ, 0 < lam →
      eLpNorm (fun x => ENNReal.ofReal lam *
          (seqJumpCount lam (fun j => dyadicAvg n j f x)) ^ (1 / 2 : ℝ))
          (ENNReal.ofReal p) volume ≤
        C * eLpNorm f (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC, hW⟩ := lep_window_bound (n := n) hp
  have hp0 : 0 < p := by linarith
  set C' : ℝ≥0∞ := ENNReal.ofReal C ^ (1 / p) with hC'def
  have hC' : C' ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top
  refine ⟨C'.toNNReal, ?_⟩
  intro f hf lam hlam
  rw [ENNReal.coe_toNNReal hC']
  set g : ℕ → EuclideanSpace ℝ (Fin n) → ℝ≥0∞ := fun J x =>
    (ENNReal.ofReal lam * lepWinJump lam (fun j => dyadicAvg n j f x) J ^ (1 / 2 : ℝ)) ^ p
    with hg
  have hg_meas : ∀ J, Measurable (g J) := fun J =>
    (((measurable_lepWinJump f lam J).pow_const _).const_mul _).pow_const _
  have hg_mono : Monotone g := by
    intro J J' h x
    simp only [hg]
    gcongr
    exact lepWinJump_mono lam _ h
  have hsup : ∀ x, (ENNReal.ofReal lam *
      seqJumpCount lam (fun j => dyadicAvg n j f x) ^ (1 / 2 : ℝ)) ^ p = ⨆ J, g J x := by
    intro x
    rw [seqJumpCount_eq_iSup, lep_rpow_iSup _ (by norm_num), ENNReal.mul_iSup,
      lep_rpow_iSup _ hp0]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp0) ENNReal.ofReal_ne_top
      (measurable_lepingle f lam).aestronglyMeasurable, ENNReal.toReal_ofReal hp0.le,
    eLpNorm_ofReal_eq_lintegral_rpow_enorm hf.aestronglyMeasurable hp0]
  simp only [enorm_eq_self]
  simp_rw [hsup]
  rw [lintegral_iSup hg_meas hg_mono]
  have hle : (⨆ J, ∫⁻ x, g J x) ≤ ENNReal.ofReal C * ∫⁻ x, ‖f x‖ₑ ^ p :=
    iSup_le fun J => hW f hf lam hlam J
  calc (⨆ J, ∫⁻ x, g J x) ^ (1 / p) ≤ (ENNReal.ofReal C * ∫⁻ x, ‖f x‖ₑ ^ p) ^ (1 / p) :=
        ENNReal.rpow_le_rpow hle (by positivity)
    _ = C' * (∫⁻ x, ‖f x‖ₑ ^ p) ^ (1 / p) := ENNReal.mul_rpow_of_nonneg _ _ (by positivity)

end Main

end Auto
