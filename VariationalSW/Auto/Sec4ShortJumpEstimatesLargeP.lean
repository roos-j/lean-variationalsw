/-! ## Littlewood–Paley projections (paper §4.1, (`eq:decompk`)) -/


/-- `dyadicPhi` has compact support. -/
theorem hasCompactSupport_dyadicPhi (n : ℕ) : HasCompactSupport (dyadicPhi n) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) 2) fun t ht => ?_
  refine dyadicPhi_eq_zero_of_ge ?_
  simp only [Metric.mem_closedBall, dist_zero_right, not_le] at ht
  exact ht.le

/-- `φ_ℓ` has compact support. -/
theorem hasCompactSupport_dyadicPhiScale (n : ℕ) (ℓ : ℤ) :
    HasCompactSupport (dyadicPhiScale n ℓ) :=
  (hasCompactSupport_dyadicPhi n).comp_isClosedEmbedding
    (Homeomorph.smulOfNeZero ((2 : ℝ) ^ (-ℓ)) (zpow_ne_zero _ two_ne_zero)).isClosedEmbedding

/-- The smoothed frequency window `θ̃ = φ_{-1} + φ_0 + φ_1`. -/
def lpThetaTildeFun (n : ℕ) (ξ : Rn n) : ℝ :=
  dyadicPhiScale n (-1) ξ + dyadicPhiScale n 0 ξ + dyadicPhiScale n 1 ξ

/-- `θ̃ = η(ξ/2) - η(4ξ)` (telescoping; paper §4.2, `	ilde P`). -/
theorem lpThetaTildeFun_eq (n : ℕ) (ξ : Rn n) :
    lpThetaTildeFun n ξ = dyadicEta n ((2 : ℝ) ^ (-(1 : ℤ)) • ξ) -
      dyadicEta n ((2 : ℝ) ^ (-((-1 : ℤ) - 1)) • ξ) := by
  rw [← sum_Icc_dyadicPhiScale n (by norm_num)]
  rw [show Finset.Icc (-1 : ℤ) 1 = {-1, 0, 1} by decide, Finset.sum_insert (by decide),
    Finset.sum_insert (by decide), Finset.sum_singleton, lpThetaTildeFun]
  ring

/-- `θ̃ = 1` where `φ ≠ 0`. -/
theorem lpThetaTildeFun_eq_one {n : ℕ} {ξ : Rn n} (h : dyadicPhi n ξ ≠ 0) :
    lpThetaTildeFun n ξ = 1 := by
  obtain ⟨h1, h2⟩ := dyadicPhi_ne_zero h
  rw [lpThetaTildeFun_eq, dyadicEta_eq_one, dyadicEta_eq_zero, sub_zero]
  · rw [norm_smul, Real.norm_of_nonneg (by positivity)]
    norm_num; linarith
  · rw [norm_smul, Real.norm_of_nonneg (by positivity)]
    norm_num; linarith


/-- `θ̃` is smooth. -/
theorem contDiff_lpThetaTildeFun (n : ℕ) : ContDiff ℝ (⊤ : ℕ∞) (lpThetaTildeFun n) :=
  ((contDiff_dyadicPhiScale n _).add (contDiff_dyadicPhiScale n _)).add
    (contDiff_dyadicPhiScale n _)

/-- `θ̃` has compact support. -/
theorem hasCompactSupport_lpThetaTildeFun (n : ℕ) : HasCompactSupport (lpThetaTildeFun n) :=
  ((hasCompactSupport_dyadicPhiScale n _).add (hasCompactSupport_dyadicPhiScale n _)).add
    (hasCompactSupport_dyadicPhiScale n _)

/-- A real smooth compactly supported function as a complex Schwartz function. -/
def realSchwartz {n : ℕ} (g : Rn n → ℝ) (h1 : ContDiff ℝ (⊤ : ℕ∞) g)
    (h2 : HasCompactSupport g) : 𝓢(Rn n, ℂ) :=
  HasCompactSupport.toSchwartzMap (f := fun ξ => ((g ξ : ℝ) : ℂ))
    (h2.comp_left (g := fun r : ℝ => (r : ℂ)) (by simp))
    (ofRealCLM.contDiff.comp h1)

@[simp] theorem realSchwartz_apply {n : ℕ} (g : Rn n → ℝ) (h1 : ContDiff ℝ (⊤ : ℕ∞) g)
    (h2 : HasCompactSupport g) (ξ : Rn n) : realSchwartz g h1 h2 ξ = (g ξ : ℂ) := rfl

/-- The Littlewood–Paley frequency window `𝓕ψ = φ` (paper §4.1, after (`eq:mainest`)). -/
def lpTheta (n : ℕ) : 𝓢(Rn n, ℂ) :=
  realSchwartz (dyadicPhi n) (contDiff_dyadicPhi n) (hasCompactSupport_dyadicPhi n)

/-- The widened frequency window `θ̃ = φ_{-1} + φ_0 + φ_1`, equal to `1` on the support of `φ`. -/
def lpThetaTilde (n : ℕ) : 𝓢(Rn n, ℂ) :=
  realSchwartz (lpThetaTildeFun n) (contDiff_lpThetaTildeFun n)
    (hasCompactSupport_lpThetaTildeFun n)

/-- The Littlewood–Paley kernel `ψ = 𝓕⁻¹ φ` (paper §4.1, `P_k`). -/
def lpPsi (n : ℕ) : 𝓢(Rn n, ℂ) := 𝓕⁻ (lpTheta n)

/-- The kernel `ψ̃ = 𝓕⁻¹ θ̃` of the widened projections `P̃_k` (paper §4.2, `\tilde P_{j+k}`). -/
def lpPsiTilde (n : ℕ) : 𝓢(Rn n, ℂ) := 𝓕⁻ (lpThetaTilde n)

/-- `𝓕 ψ = φ` (paper §4.1, definition of `P_k`). -/
theorem fourier_lpPsi (n : ℕ) : 𝓕 (lpPsi n : Rn n → ℂ) = fun ξ => (dyadicPhi n ξ : ℂ) := by
  rw [← SchwartzMap.fourier_coe, lpPsi, FourierTransform.fourier_fourierInv_eq]; rfl

/-- `𝓕 ψ̃ = θ̃`. -/
theorem fourier_lpPsiTilde (n : ℕ) :
    𝓕 (lpPsiTilde n : Rn n → ℂ) = fun ξ => (lpThetaTildeFun n ξ : ℂ) := by
  rw [← SchwartzMap.fourier_coe, lpPsiTilde, FourierTransform.fourier_fourierInv_eq]; rfl

/-- `∫ g = 𝓕 g (0)`. -/
theorem integral_eq_fourier_zero {n : ℕ} (g : Rn n → ℂ) : ∫ x, g x = 𝓕 g 0 := by
  rw [Real.fourier_eq]; simp

/-- `ψ` has mean zero (`φ(0) = 0`), as required by the Littlewood–Paley inequality. -/
theorem integral_lpPsi (n : ℕ) : ∫ x, lpPsi n x = 0 := by
  rw [integral_eq_fourier_zero, fourier_lpPsi]
  simp [dyadicPhi_eq_zero_of_le (by simp : ‖(0 : Rn n)‖ ≤ 1 / 2)]

/-- `θ̃(0) = 0`. -/
theorem lpThetaTildeFun_zero (n : ℕ) : lpThetaTildeFun n 0 = 0 := by
  simp [lpThetaTildeFun, dyadicPhiScale, dyadicPhi_eq_zero_of_le]

/-- `ψ̃` has mean zero. -/
theorem integral_lpPsiTilde (n : ℕ) : ∫ x, lpPsiTilde n x = 0 := by
  rw [integral_eq_fourier_zero, fourier_lpPsiTilde]
  simp [lpThetaTildeFun_zero]

/-- The linear equivalence `x ↦ 2^k x`. -/
def dilEquiv (n : ℕ) (k : ℤ) : Rn n ≃L[ℝ] Rn n :=
  (LinearEquiv.smulOfNeZero ℝ (Rn n) ((2 : ℝ) ^ k)
    (zpow_ne_zero _ two_ne_zero)).toContinuousLinearEquiv

/-- The dyadic dilate `ψ_k = 2^{kn} ψ(2^k ·)` as a Schwartz function. -/
def schwartzDilate {n : ℕ} (ψ : 𝓢(Rn n, ℂ)) (k : ℤ) : 𝓢(Rn n, ℂ) :=
  (((2 : ℝ) : ℂ) ^ (k * (n : ℤ))) • SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (dilEquiv n k) ψ

/-- The Schwartz dilate agrees with `lpDilate`. -/
theorem coe_schwartzDilate {n : ℕ} (ψ : 𝓢(Rn n, ℂ)) (k : ℤ) :
    (schwartzDilate ψ k : Rn n → ℂ) = lpDilate n ψ k := by
  funext x; simp [schwartzDilate, lpDilate, dilEquiv]

/-- The convolution `ψ_k * f` of a Schwartz function `f` with the dilate `ψ_k`
(the Littlewood–Paley projections `P_k f = ψ_k * f` of paper §4.1). -/
def lpConv {n : ℕ} (ψ : 𝓢(Rn n, ℂ)) (k : ℤ) (f : 𝓢(Rn n, ℂ)) : 𝓢(Rn n, ℂ) :=
  SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (schwartzDilate ψ k) f

/-- The Littlewood–Paley projection `P_k f = ψ_k * f`, `𝓕(P_k f)(ξ) = φ(2^{-k} ξ) 𝓕 f(ξ)`
(paper §4.1, (`eq:decompk`)). -/
def lpProj (n : ℕ) (k : ℤ) (f : 𝓢(Rn n, ℂ)) : 𝓢(Rn n, ℂ) := lpConv (lpPsi n) k f

/-- The widened projection `P̃_k f = ψ̃_k * f` (paper §4.2), with `P_k = P_k P̃_k`. -/
def lpProjTilde (n : ℕ) (k : ℤ) (f : 𝓢(Rn n, ℂ)) : 𝓢(Rn n, ℂ) := lpConv (lpPsiTilde n) k f

/-- Pointwise form of `ψ_k * f`: `∫ ψ_k(x - y) f(y) dy`. -/
theorem lpConv_apply {n : ℕ} (ψ : 𝓢(Rn n, ℂ)) (k : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    lpConv ψ k f x = ∫ y, lpDilate n ψ k (x - y) * f y := by
  rw [lpConv, SchwartzMap.convolution_apply, convolution_def, coe_schwartzDilate,
    ← integral_sub_left_eq_self _ volume x]
  simp

/-- Convolution theorem: `𝓕(ψ_k * f)(ξ) = 𝓕ψ(2^{-k} ξ) 𝓕f(ξ)`. -/
theorem fourier_lpConv {n : ℕ} (ψ : 𝓢(Rn n, ℂ)) (k : ℤ) (f : 𝓢(Rn n, ℂ)) (ξ : Rn n) :
    𝓕 (lpConv ψ k f : Rn n → ℂ) ξ =
      𝓕 (ψ : Rn n → ℂ) (((2 : ℝ) ^ k)⁻¹ • ξ) * 𝓕 (f : Rn n → ℂ) ξ := by
  rw [← SchwartzMap.fourier_coe, lpConv, SchwartzMap.fourier_convolution,
    SchwartzMap.pairing_apply_apply, ContinuousLinearMap.mul_apply',
    SchwartzMap.fourier_coe, SchwartzMap.fourier_coe, coe_schwartzDilate, fourier_lpDilate]

/-- Fourier representation of `ψ_k * f`. -/
theorem lpConv_eq_integral {n : ℕ} (ψ : 𝓢(Rn n, ℂ)) (k : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    lpConv ψ k f x = ∫ ξ, 𝐞 (inner ℝ ξ x) •
      (𝓕 (ψ : Rn n → ℂ) (((2 : ℝ) ^ k)⁻¹ • ξ) * 𝓕 (f : Rn n → ℂ) ξ) := by
  have h := congrArg (fun g : 𝓢(Rn n, ℂ) => g x)
    (FourierPair.fourierInv_fourier_eq (E := 𝓢(Rn n, ℂ)) (F := 𝓢(Rn n, ℂ)) (lpConv ψ k f))
  rw [← h, SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
  congr 1; funext ξ
  rw [SchwartzMap.fourier_coe, fourier_lpConv]

/-- `(2^k)⁻¹ ξ = 2^{-k} ξ`. -/
theorem two_zpow_inv_smul (k : ℤ) {n : ℕ} (ξ : Rn n) :
    ((2 : ℝ) ^ k)⁻¹ • ξ = (2 : ℝ) ^ (-k) • ξ := by rw [zpow_neg]

/-- Fourier representation of `P_k f` (paper §4.1). -/
theorem lpProj_eq_integral {n : ℕ} (k : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    lpProj n k f x = ∫ ξ, 𝐞 (inner ℝ ξ x) •
      ((dyadicPhiScale n k ξ : ℂ) * 𝓕 (f : Rn n → ℂ) ξ) := by
  rw [lpProj, lpConv_eq_integral, fourier_lpPsi]
  simp only [two_zpow_inv_smul]; rfl

/-- `ℝⁿ` is nontrivial for `n ≥ 1`. -/
theorem nontrivial_rn {n : ℕ} (hn : 1 ≤ n) : Nontrivial (Rn n) :=
  ⟨⟨EuclideanSpace.single ⟨0, hn⟩ 1, 0, by simp⟩⟩

/-- `φ_k(0) = 0`. -/
theorem dyadicPhiScale_zero (n : ℕ) (k : ℤ) : dyadicPhiScale n k 0 = 0 :=
  dyadicPhiScale_eq_zero_of_le (by rw [norm_zero]; positivity)

/-- Fourier inversion for Schwartz functions, pointwise. -/
theorem schwartz_eq_integral_fourier {n : ℕ} (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    f x = ∫ ξ, 𝐞 (inner ℝ ξ x) • 𝓕 (f : Rn n → ℂ) ξ := by
  have h := congrArg (fun g : 𝓢(Rn n, ℂ) => g x)
    (FourierPair.fourierInv_fourier_eq (E := 𝓢(Rn n, ℂ)) (F := 𝓢(Rn n, ℂ)) f)
  rw [← h, SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
  rfl

/-- The Fourier transform of a Schwartz function is continuous. -/
theorem continuous_fourier_schwartz {n : ℕ} (f : 𝓢(Rn n, ℂ)) :
    Continuous (𝓕 (f : Rn n → ℂ)) := by
  rw [← SchwartzMap.fourier_coe]; exact (𝓕 f).continuous

/-- The Fourier transform of a Schwartz function is integrable. -/
theorem integrable_fourier_schwartz {n : ℕ} (f : 𝓢(Rn n, ℂ)) :
    Integrable (𝓕 (f : Rn n → ℂ)) := by
  rw [← SchwartzMap.fourier_coe]; exact (𝓕 f).integrable

/-- Dominated convergence over the dyadic frequency partition: for an integrable `G`,
`∑_k ∫ φ_k G = ∫ G` (`n ≥ 1`). -/
theorem hasSum_integral_dyadicPhiScale_mul {n : ℕ} (hn : 1 ≤ n) {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] {G : Rn n → E} (hG : Integrable G) :
    HasSum (fun k : ℤ => ∫ ξ, dyadicPhiScale n k ξ • G ξ) (∫ ξ, G ξ) := by
  have := nontrivial_rn hn
  refine hasSum_integral_of_dominated_convergence (fun k ξ => dyadicPhiScale n k ξ * ‖G ξ‖)
    (fun k => ((contDiff_dyadicPhiScale n k).continuous.aestronglyMeasurable).smul
      hG.aestronglyMeasurable)
    (fun k => ae_of_all _ fun ξ => by
      rw [norm_smul, Real.norm_of_nonneg (dyadicPhiScale_nonneg n k ξ)])
    (ae_of_all _ fun ξ => ?_) ?_ ?_
  · rcases eq_or_ne ξ 0 with rfl | hξ
    · simp only [dyadicPhiScale_zero, zero_mul]; exact summable_zero
    · exact ((hasSum_dyadicPhiScale hξ).mul_right _).summable
  · refine hG.norm.congr ?_
    filter_upwards [Measure.ae_ne volume 0] with ξ hξ
    rw [tsum_mul_right, tsum_dyadicPhiScale hξ, one_mul]
  · filter_upwards [Measure.ae_ne volume 0] with ξ hξ
    simpa using (hasSum_dyadicPhiScale hξ).smul_const (G ξ)

/-- **Reproducing formula** `f = ∑_k P_k f` (paper §4.1, (`eq:decompk`)), pointwise, for Schwartz
`f` and `n ≥ 1`. -/
theorem hasSum_lpProj {n : ℕ} (hn : 1 ≤ n) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    HasSum (fun k : ℤ => lpProj n k f x) (f x) := by
  rw [schwartz_eq_integral_fourier f x]
  simp_rw [lpProj_eq_integral]
  have hG : Integrable (fun ξ => 𝐞 (inner ℝ ξ x) • 𝓕 (f : Rn n → ℂ) ξ) := by
    refine (integrable_fourier_schwartz f).norm.mono' ?_ (ae_of_all _ fun ξ => ?_)
    · exact ((Real.continuous_fourierChar.comp (continuous_id.inner continuous_const)).smul
        (continuous_fourier_schwartz f)).aestronglyMeasurable
    · rw [Circle.norm_smul]
  convert hasSum_integral_dyadicPhiScale_mul hn hG using 2 with k
  congr 1; funext ξ
  simp only [Circle.smul_def, Complex.real_smul]; ring

/-- The `L¹` size of the frequency pieces: `‖P_k f‖_∞ ≤ ∫ φ_k |𝓕 f|`. -/
theorem norm_lpProj_le {n : ℕ} (k : ℤ) (f : 𝓢(Rn n, ℂ)) (y : Rn n) :
    ‖lpProj n k f y‖ ≤ ∫ ξ, dyadicPhiScale n k ξ * ‖𝓕 (f : Rn n → ℂ) ξ‖ := by
  rw [lpProj_eq_integral]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; funext ξ
  rw [Circle.norm_smul, norm_mul, Complex.norm_real, Real.norm_of_nonneg
    (dyadicPhiScale_nonneg n k ξ)]

/-- **Decomposition of integrals against an integrable kernel** (paper (`eq:decompk`)): for
integrable `a`, `∫ f(x - t) a(t) dt = ∑_k ∫ P_k f(x - t) a(t) dt`. -/
theorem hasSum_integral_lpProj_mul {n : ℕ} (hn : 1 ≤ n) (f : 𝓢(Rn n, ℂ)) {a : Rn n → ℂ}
    (ha : Integrable a) (x : Rn n) :
    HasSum (fun k : ℤ => ∫ t, lpProj n k f (x - t) * a t) (∫ t, f (x - t) * a t) := by
  set c : ℤ → ℝ := fun k => ∫ ξ, dyadicPhiScale n k ξ * ‖𝓕 (f : Rn n → ℂ) ξ‖ with hc
  have hcs : HasSum c (∫ ξ, ‖𝓕 (f : Rn n → ℂ) ξ‖) := by
    have := hasSum_integral_dyadicPhiScale_mul hn (integrable_fourier_schwartz f).norm
    simpa [smul_eq_mul] using this
  refine hasSum_integral_of_dominated_convergence (fun k t => c k * ‖a t‖)
    (fun k => (((lpProj n k f).continuous.comp (continuous_sub_left x)).aestronglyMeasurable).mul
      ha.aestronglyMeasurable)
    (fun k => ae_of_all _ fun t => by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_right (norm_lpProj_le k f _) (norm_nonneg _))
    (ae_of_all _ fun t => (hcs.summable.mul_right _)) ?_
    (ae_of_all _ fun t => (hasSum_lpProj hn f (x - t)).mul_right (a t))
  simp_rw [tsum_mul_right]
  exact ha.norm.const_mul _

/-- `φ_ℓ K` is integrable. -/
theorem IsHomogeneousCZKernel.integrable_dyadicPhiScale_mul {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (ℓ : ℤ) :
    Integrable (fun t => dyadicPhiScale n ℓ t * czKernel n Ω t) := by
  have hsupp : tsupport (dyadicPhiScale n ℓ) ⊆ ({0}ᶜ : Set (Rn n)) := by
    intro t ht h0
    rw [mem_singleton_iff] at h0
    subst h0
    refine (notMem_tsupport_iff_eventuallyEq.2 ?_) ht
    filter_upwards [Metric.ball_mem_nhds (0 : Rn n) (zpow_pos two_pos (ℓ - 1))] with s hs
    exact dyadicPhiScale_eq_zero_of_le (mem_ball_zero_iff.1 hs).le
  have h := osc_integrable_mul_of_tsupport (μ := volume) isOpen_compl_singleton
    hΩ.contDiffOn_czKernel.continuousOn (contDiff_dyadicPhiScale n ℓ).continuous
    (hasCompactSupport_dyadicPhiScale n ℓ) hsupp
  simpa [mul_comm] using h

/-- The kernel `e^{iu|t|^α} φ_ℓ(t) K(t)` of the pieces `𝓗^{(u)}_ℓ` (`eq:Hul`). -/
def pieceKernel (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ) (t : Rn n) : ℂ :=
  exp (I * u * (‖t‖ ^ α : ℝ)) * ((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ)

/-- `𝓗^{(u)}_ℓ f(x) = ∫ f(x - t) (e^{iu|·|^α} φ_ℓ K)(t) dt` (paper (`eq:Hul`)). -/
theorem modulatedPiece_eq_pieceKernel (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ)
    (f : Rn n → ℂ) (x : Rn n) :
    modulatedPiece n α Ω u ℓ f x = ∫ t, f (x - t) * pieceKernel n α Ω u ℓ t := by
  simp only [modulatedPiece, pieceKernel, mul_assoc]

/-- `|e^{iu|t|^α} φ_ℓ(t) K(t)| = |φ_ℓ(t) K(t)|`. -/
theorem norm_pieceKernel (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ) (t : Rn n) :
    ‖pieceKernel n α Ω u ℓ t‖ = ‖dyadicPhiScale n ℓ t * czKernel n Ω t‖ := by
  rw [pieceKernel, norm_mul, norm_exp_I_mul_mul, one_mul, Complex.norm_real]

/-- The piece kernels are integrable. -/
theorem IsHomogeneousCZKernel.integrable_pieceKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α u : ℝ) (ℓ : ℤ) :
    Integrable (pieceKernel n α Ω u ℓ) := by
  refine (hΩ.integrable_dyadicPhiScale_mul ℓ).norm.mono' ?_
    (ae_of_all _ fun t => (norm_pieceKernel n α Ω u ℓ t).le)
  refine (Measurable.mul ?_ ?_).aestronglyMeasurable
  · exact Complex.measurable_exp.comp (measurable_const.mul
      (Complex.measurable_ofReal.comp (measurable_norm.pow_const α)))
  · exact Complex.measurable_ofReal.comp
      ((measurable_dyadicPhiScale n ℓ).mul hΩ.measurable_czKernel)

/-- **Littlewood–Paley decomposition of the pieces** (paper (`eq:decompk`)):
`𝓗^{(u)}_ℓ f(x) = ∑_k 𝓗^{(u)}_ℓ P_k f(x)` for Schwartz `f`. -/
theorem IsHomogeneousCZKernel.hasSum_modulatedPiece_lpProj {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) (α u : ℝ) (ℓ : ℤ) (f : 𝓢(Rn n, ℂ))
    (x : Rn n) :
    HasSum (fun k : ℤ => modulatedPiece n α Ω u ℓ (lpProj n k f) x)
      (modulatedPiece n α Ω u ℓ f x) := by
  simp_rw [modulatedPiece_eq_pieceKernel]
  exact hasSum_integral_lpProj_mul hn f (hΩ.integrable_pieceKernel α u ℓ) x

/-! ### Countable triangle inequalities -/

/-- `V^r` of the zero family vanishes. -/
theorem variationNorm_zero_fun {r : ℝ} (hr : 0 < r) (𝒥 : Set ℝ) :
    variationNorm r 𝒥 (fun _ => (0 : ℂ)) = 0 := by
  refine le_antisymm (variationNorm_le fun J u _ _ => ?_) zero_le
  simp [ENNReal.zero_rpow_of_pos hr, hr]

/-- Finite triangle inequality for `V^r`, `r ≥ 1`. -/
theorem variationNorm_finsetSum_le {ι : Type*} {r : ℝ} (hr : 1 ≤ r) (𝒥 : Set ℝ)
    (b : ι → ℝ → ℂ) (s : Finset ι) :
    variationNorm r 𝒥 (fun u => ∑ i ∈ s, b i u) ≤ ∑ i ∈ s, variationNorm r 𝒥 (b i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [variationNorm_zero_fun (by linarith : (0 : ℝ) < r)]
  | insert i s hi ih =>
    simp_rw [Finset.sum_insert hi]
    exact (variationNorm_add_le hr 𝒥 (b i) (fun u => ∑ i ∈ s, b i u)).trans (add_le_add le_rfl ih)

/-- **Countable triangle inequality for `V^r`**: if `a = ∑_i b_i` pointwise on `𝒥`, then
`V^r_𝒥(a) ≤ ∑_i V^r_𝒥(b_i)` (`r ≥ 1`). -/
theorem variationNorm_le_tsum_of_hasSum {ι : Type*} {r : ℝ} (hr : 1 ≤ r) {𝒥 : Set ℝ}
    {a : ℝ → ℂ} {b : ι → ℝ → ℂ} (h : ∀ u ∈ 𝒥, HasSum (fun i => b i u) (a u)) :
    variationNorm r 𝒥 a ≤ ∑' i, variationNorm r 𝒥 (b i) := by
  have hA : ∀ v ∈ 𝒥, Tendsto (fun s : Finset ι => ∑ i ∈ s, b i v) atTop (𝓝 (a v)) :=
    fun v hv => h v hv
  refine variationNorm_le fun J u hu hm => ?_
  have hlim : Tendsto (fun s : Finset ι => (∑ i' : Fin J,
      ‖(∑ i ∈ s, b i (u i'.succ)) - ∑ i ∈ s, b i (u i'.castSucc)‖ₑ ^ r) ^ (1 / r)) atTop
      (𝓝 ((∑ i' : Fin J, ‖a (u i'.succ) - a (u i'.castSucc)‖ₑ ^ r) ^ (1 / r))) := by
    refine (ENNReal.continuous_rpow_const.tendsto _).comp (tendsto_finsetSum _ fun i' _ => ?_)
    exact (ENNReal.continuous_rpow_const.tendsto _).comp ((continuous_enorm.tendsto _).comp
      ((hA _ (hm _)).sub (hA _ (hm _))))
  exact le_of_tendsto' hlim fun s => (le_variationNorm (a := fun v => ∑ i ∈ s, b i v) hu hm).trans
    ((variationNorm_finsetSum_le hr 𝒥 b s).trans (ENNReal.sum_le_tsum s))

/-- **Minkowski's inequality in `ℓ^r` for countable sums** in `[0, ∞]`:
`(∑_j (∑_i c_{ij})^r)^{1/r} ≤ ∑_i (∑_j c_{ij}^r)^{1/r}` (`r ≥ 1`). -/
theorem tsum_rpow_tsum_le {ι κ : Type*} {r : ℝ} (hr : 1 ≤ r) (c : ι → κ → ℝ≥0∞) :
    (∑' j, (∑' i, c i j) ^ r) ^ (1 / r) ≤ ∑' i, (∑' j, c i j ^ r) ^ (1 / r) := by
  classical
  have hr0 : 0 < r := by linarith
  have hfin : ∀ (s : Finset ι) (t : Finset κ),
      (∑ j ∈ t, (∑ i ∈ s, c i j) ^ r) ^ (1 / r) ≤ ∑ i ∈ s, (∑ j ∈ t, c i j ^ r) ^ (1 / r) := by
    intro s t
    induction s using Finset.induction_on with
    | empty => simp [ENNReal.zero_rpow_of_pos hr0, hr0]
    | insert i s hi ih =>
      simp_rw [Finset.sum_insert hi]
      exact (ENNReal.Lp_add_le t (fun j => c i j) (fun j => ∑ i ∈ s, c i j) hr).trans
        (add_le_add le_rfl ih)
  set B := ∑' i, (∑' j, c i j ^ r) ^ (1 / r)
  have ht : ∀ t : Finset κ, (∑ j ∈ t, (∑' i, c i j) ^ r) ^ (1 / r) ≤ B := by
    intro t
    have hlim : Tendsto (fun s : Finset ι => (∑ j ∈ t, (∑ i ∈ s, c i j) ^ r) ^ (1 / r)) atTop
        (𝓝 ((∑ j ∈ t, (∑' i, c i j) ^ r) ^ (1 / r))) := by
      refine (ENNReal.continuous_rpow_const.tendsto _).comp (tendsto_finsetSum _ fun j _ => ?_)
      have : Tendsto (fun s : Finset ι => ∑ i ∈ s, c i j) atTop (𝓝 (∑' i, c i j)) :=
        ENNReal.summable.hasSum
      exact (ENNReal.continuous_rpow_const.tendsto _).comp this
    refine le_of_tendsto' hlim fun s => (hfin s t).trans ?_
    refine (Finset.sum_le_sum fun i _ => ?_).trans (ENNReal.sum_le_tsum s)
    exact ENNReal.rpow_le_rpow (ENNReal.sum_le_tsum t) (by positivity)
  refine rpow_one_div_le_of_le_rpow hr0 ?_
  rw [ENNReal.tsum_eq_iSup_sum]
  exact iSup_le fun t => le_rpow_of_rpow_one_div_le hr0 (ht t)

/-- The family `u ↦ 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x)` of paper (`eq:mainest1`). -/
def shortPiece (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ)) (j : ℤ) (x : Rn n) :
    ℝ → ℂ :=
  fun u => modulatedPiece n α Ω u (ℓ - j) (lpProj n (j + k) f) x

/-- The quantity `‖V^r_j 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x)‖_{ℓ^r_j}` of paper (`eq:mainest1`),
`(∑_j V^r_{J_j}(u ↦ 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x))^r)^{1/r}`. -/
def shortPieceVar (r : ℝ) (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ))
    (x : Rn n) : ℝ≥0∞ :=
  (∑' j : ℤ, variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ^ r) ^ (1 / r)

/-- **The decomposition (`eq:decompl`), (`eq:decompk`) for the short variation**: for Schwartz `f`
and `r ≥ 1`, `S_r(𝓗 f)(x) ≤ ∑_{ℓ, k} ‖V^r_j 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x)‖_{ℓ^r_j}` (paper §4.1). -/
theorem IsHomogeneousCZKernel.shortVariation_le_tsum_shortPieceVar {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α r : ℝ} (hα : 0 < α) (hr : 1 ≤ r)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    shortVariation r α (fun u => modulatedSI n α Ω u f x) ≤
      ∑' ℓ : ℤ, ∑' k : ℤ, shortPieceVar r n α Ω ℓ k f x := by
  have hj : ∀ j : ℤ, variationNorm r (shortInterval α j) (fun u => modulatedSI n α Ω u f x) ≤
      ∑' p : ℤ × ℤ, variationNorm r (shortInterval α j) (shortPiece n α Ω p.1 p.2 f j x) := by
    intro j
    rw [ENNReal.tsum_prod (f := fun ℓ k =>
      variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x))]
    refine (variationNorm_le_tsum_of_hasSum hr (b := fun ℓ : ℤ => fun u =>
      modulatedPiece n α Ω u (ℓ - j) f x) fun u _ => ?_).trans
      (ENNReal.tsum_le_tsum fun ℓ => variationNorm_le_tsum_of_hasSum hr fun u _ => ?_)
    · exact (Equiv.subRight j).hasSum_iff (f := fun m => modulatedPiece n α Ω u m f x) |>.2
        (hΩ.hasSum_modulatedPiece hn hα u f x)
    · exact (Equiv.addLeft j).hasSum_iff
        (f := fun m => modulatedPiece n α Ω u (ℓ - j) (lpProj n m f) x) |>.2
        (hΩ.hasSum_modulatedPiece_lpProj hn α u (ℓ - j) f x)
  have hr0 : 0 < r := by linarith
  calc shortVariation r α (fun u => modulatedSI n α Ω u f x)
      ≤ (∑' j : ℤ, (∑' p : ℤ × ℤ,
          variationNorm r (shortInterval α j) (shortPiece n α Ω p.1 p.2 f j x)) ^ r) ^ (1 / r) :=
        ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun j =>
          ENNReal.rpow_le_rpow (hj j) hr0.le) (by positivity)
    _ ≤ ∑' p : ℤ × ℤ, shortPieceVar r n α Ω p.1 p.2 f x := tsum_rpow_tsum_le hr _
    _ = ∑' ℓ : ℤ, ∑' k : ℤ, shortPieceVar r n α Ω ℓ k f x :=
        ENNReal.tsum_prod (f := fun ℓ k => shortPieceVar r n α Ω ℓ k f x)

/-! ## Elementary tools for (`est1`), (`est2`) -/

/-- **`V¹` of a Lipschitz family**: if `|F(u) - F(v)| ≤ L |u - v|` on `[a, b]`, then
`V¹_{[a,b]} F ≤ L (b - a)`. -/
theorem variationNorm_one_le_of_lipschitz {a b : ℝ} {L : ℝ≥0∞} {F : ℝ → ℂ}
    (hF : ∀ u ∈ Icc a b, ∀ v ∈ Icc a b, u ≤ v → ‖F v - F u‖ₑ ≤ L * ENNReal.ofReal (v - u)) :
    variationNorm 1 (Icc a b) F ≤ L * ENNReal.ofReal (b - a) := by
  refine variationNorm_le fun J u hu hm => ?_
  simp only [ENNReal.rpow_one, div_one]
  calc ∑ i : Fin J, ‖F (u i.succ) - F (u i.castSucc)‖ₑ
      ≤ ∑ i : Fin J, ∫⁻ _ in Ioc (u i.castSucc) (u i.succ), L := by
        refine Finset.sum_le_sum fun i _ => ?_
        rw [setLIntegral_const, Real.volume_Ioc]
        exact hF _ (hm _) _ (hm _) (hu (Fin.castSucc_lt_succ (i := i))).le
    _ ≤ ∫⁻ _ in Icc a b, L := sum_setLIntegral_Ioc_le hu hm _
    _ = L * ENNReal.ofReal (b - a) := by rw [setLIntegral_const, Real.volume_Icc]

/-- `V^r ≤ V¹` for `r ≥ 1`. -/
theorem variationNorm_le_variationNorm_one {r : ℝ} (hr : 1 ≤ r) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    variationNorm r 𝒥 a ≤ variationNorm 1 𝒥 a :=
  variationNorm_le_of_le one_pos hr 𝒥 a

/-- `ℓ^r ⊆ ℓ^q` for `0 < q ≤ r`: `(∑ a_j^r)^{1/r} ≤ (∑ a_j^q)^{1/q}` in `[0, ∞]`. -/
theorem tsum_rpow_one_div_le {ι : Type*} {q r : ℝ} (hq : 0 < q) (hqr : q ≤ r) (a : ι → ℝ≥0∞) :
    (∑' j, a j ^ r) ^ (1 / r) ≤ (∑' j, a j ^ q) ^ (1 / q) := by
  have hr : 0 < r := hq.trans_le hqr
  set M := (∑' j, a j ^ q) ^ (1 / q) with hM_def
  have hx : ∀ j, a j ≤ M := fun j => by
    calc a j = (a j ^ q) ^ (1 / q) := (rpow_rpow_one_div hq.ne' _).symm
      _ ≤ M := ENNReal.rpow_le_rpow (ENNReal.le_tsum (f := fun j => a j ^ q) j) (by positivity)
  have hMq : M ^ q = ∑' j, a j ^ q := by rw [hM_def]; exact rpow_one_div_rpow hq.ne' _
  refine rpow_one_div_le_of_le_rpow hr ?_
  calc ∑' j, a j ^ r ≤ ∑' j, M ^ (r - q) * a j ^ q := by
        refine ENNReal.tsum_le_tsum fun j => ?_
        calc a j ^ r = a j ^ q * a j ^ (r - q) := by
              rw [← ENNReal.rpow_add_of_nonneg _ _ hq.le (sub_nonneg.2 hqr), add_sub_cancel]
          _ ≤ a j ^ q * M ^ (r - q) :=
              mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hx j) (sub_nonneg.2 hqr))
          _ = _ := mul_comm _ _
    _ = M ^ (r - q) * M ^ q := by rw [ENNReal.tsum_mul_left, hMq]
    _ = M ^ r := by
        rw [← ENNReal.rpow_add_of_nonneg _ _ (sub_nonneg.2 hqr) hq.le, sub_add_cancel]

/-- `eLpNorm (c · G) = c · eLpNorm G` for `[0, ∞]`-valued `G` and `c < ∞`. -/
theorem eLpNorm_const_mul_ennreal {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {G : X → ℝ≥0∞} (hG : AEMeasurable G μ) {c : ℝ≥0∞} (hc : c ≠ ∞) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x => c * G x) (ENNReal.ofReal p) μ = c * eLpNorm G (ENNReal.ofReal p) μ := by
  have hp0 : ENNReal.ofReal p ≠ 0 := by simpa using hp
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top
      (hG.const_mul c).aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top hG.aestronglyMeasurable,
    ENNReal.toReal_ofReal hp.le]
  simp only [enorm_eq_self]
  simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le]
  rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hp.le hc),
    ENNReal.mul_rpow_of_nonneg _ _ (by positivity), rpow_rpow_one_div hp.ne']

/-- **Monotone convergence for `ℓ^q`-sums in `L^p`**: a bound for all symmetric partial sums
`∑_{|j| ≤ N}` passes to `∑_{j ∈ ℤ}`. -/
theorem eLpNorm_tsum_rpow_le_of_partial {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {a : ℤ → X → ℝ≥0∞} (ha : ∀ j, AEMeasurable (a j) μ) {q p : ℝ} (hp : 0 < p)
    {B : ℝ≥0∞}
    (h : ∀ N : ℕ, eLpNorm (fun x => (∑ j ∈ Finset.Icc (-(N : ℤ)) N, a j x) ^ q)
      (ENNReal.ofReal p) μ ≤ B) :
    eLpNorm (fun x => (∑' j, a j x) ^ q) (ENNReal.ofReal p) μ ≤ B := by
  have hp0 : ENNReal.ofReal p ≠ 0 := by simpa using hp
  have hmN : ∀ N : ℕ, AEMeasurable (fun x => (∑ j ∈ Finset.Icc (-(N : ℤ)) N, a j x) ^ q) μ :=
    fun N => (Finset.aemeasurable_fun_sum _ fun j _ => ha j).pow_const q
  have hm : AEMeasurable (fun x => (∑' j, a j x) ^ q) μ :=
    (AEMeasurable.tsum ha).pow_const q
  have hmono : Monotone fun N : ℕ => Finset.Icc (-(N : ℤ)) N := fun N M hNM => by
    intro j hj; simp only [Finset.mem_Icc] at hj ⊢; constructor <;> omega
  have hcov : ∀ j : ℤ, ∃ N : ℕ, j ∈ Finset.Icc (-(N : ℤ)) N := fun j =>
    ⟨j.natAbs, by simp only [Finset.mem_Icc]; constructor <;> omega⟩
  have htend : Tendsto (fun N : ℕ => Finset.Icc (-(N : ℤ)) N) atTop atTop :=
    tendsto_atTop_finset_of_monotone hmono hcov
  have hlim : ∀ x, Tendsto (fun N : ℕ => ((∑ j ∈ Finset.Icc (-(N : ℤ)) N, a j x) ^ q) ^ p)
      atTop (𝓝 (((∑' j, a j x) ^ q) ^ p)) := by
    intro x
    have h1 : Tendsto (fun s : Finset ℤ => ∑ j ∈ s, a j x) atTop (𝓝 (∑' j, a j x)) :=
      ENNReal.summable.hasSum
    exact (ENNReal.continuous_rpow_const.tendsto _).comp
      ((ENNReal.continuous_rpow_const.tendsto _).comp (h1.comp htend))
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top hm.aestronglyMeasurable,
    ENNReal.toReal_ofReal hp.le]
  simp only [enorm_eq_self]
  refine rpow_one_div_le_of_le_rpow hp ?_
  calc ∫⁻ x, ((∑' j, a j x) ^ q) ^ p ∂μ
      = ∫⁻ x, liminf (fun N : ℕ => ((∑ j ∈ Finset.Icc (-(N : ℤ)) N, a j x) ^ q) ^ p) atTop ∂μ :=
        lintegral_congr fun x => (hlim x).liminf_eq.symm
    _ ≤ liminf (fun N : ℕ => ∫⁻ x, ((∑ j ∈ Finset.Icc (-(N : ℤ)) N, a j x) ^ q) ^ p ∂μ) atTop :=
        lintegral_liminf_le' fun N => (hmN N).pow_const p
    _ ≤ B ^ p := by
        refine liminf_le_of_le (by isBoundedDefault) fun b hb => ?_
        obtain ⟨N, hN⟩ := hb.exists
        refine hN.trans ?_
        have := h N
        rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top
          (hmN N).aestronglyMeasurable, ENNReal.toReal_ofReal hp.le] at this
        simp only [enorm_eq_self] at this
        exact le_rpow_of_rpow_one_div_le hp this

/-- `fsMaximal` and `lpMaximal` coincide. -/
theorem fsMaximal_eq_lpMaximal {n : ℕ} (f : Rn n → ℂ) : fsMaximal n f = lpMaximal f := rfl

/-- **Fefferman–Stein + Littlewood–Paley**: for a mean-zero Schwartz `ψ` and `1 < p < ∞`,
`‖(∑_j (M (ψ_{j+k} * f))²)^{1/2}‖_p ≤ C ‖f‖_p`, uniformly in `k ∈ ℤ` (paper §4.2, proof of
(`est1`), (`est2`)). -/
theorem eLpNorm_sqrt_tsum_maximal_lpConv_le {n : ℕ} (hn : 1 ≤ n) (ψ : 𝓢(Rn n, ℂ))
    (hψ : ∫ x, ψ x = 0) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (k : ℤ) (f : 𝓢(Rn n, ℂ)),
      eLpNorm (fun x => (∑' j : ℤ, lpMaximal (lpConv ψ (j + k) f) x ^ 2) ^ (1 / 2 : ℝ))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨C₁, hC₁⟩ := fefferman_stein n hn hp
  obtain ⟨C₂, -, hC₂⟩ := littlewood_paley (by omega : 0 < n) ψ hψ hp
  refine ⟨C₁ * ENNReal.ofReal C₂, ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top,
    fun k f => ?_⟩
  have hmeas : ∀ j : ℤ, AEMeasurable (fun x => lpMaximal (lpConv ψ (j + k) f) x ^ 2) := by
    intro j
    rw [← fsMaximal_eq_lpMaximal, fsMaximal_eq_hlMaximal]
    exact (fs_measurable_maximal (lpConv ψ (j + k) f).continuous.aestronglyMeasurable).pow_const
      2 |>.aemeasurable
  refine eLpNorm_tsum_rpow_le_of_partial hmeas (by linarith) fun N => ?_
  set s := Finset.Icc (-(N : ℤ)) N
  have h1 := hC₁ s (fun j => (lpConv ψ (j + k) f : Rn n → ℂ))
    (fun j _ => (lpConv ψ (j + k) f).continuous.aestronglyMeasurable)
  simp only [fsMaximal_eq_lpMaximal] at h1
  refine h1.trans ?_
  rw [mul_assoc]
  gcongr
  have h2 := hC₂ (s.map (addRightEmbedding k)) f (f.memLp _)
  simp only [Finset.sum_map, addRightEmbedding_apply] at h2
  simp_rw [lpConv_apply]
  exact h2

/-- `∫_{|t| ≤ R} |g(x - t)| dt ≤ |B_R| M g(x)`, in weighted form: if `w ≤ c 𝟙_{B(0,R)}`, then
`∫ |g(x - t)| w(t) dt ≤ c |B(0, R)| M g(x)`. -/
theorem lintegral_mul_le_maximal_of_ball {n : ℕ} {g : Rn n → ℂ} (hg : Continuous g) (x : Rn n)
    {w : Rn n → ℝ≥0∞} {c : ℝ≥0∞} {R : ℝ} (hR : 0 < R)
    (hw : ∀ t, w t ≤ (Metric.closedBall (0 : Rn n) R).indicator (fun _ => c) t) :
    ∫⁻ t, ‖g (x - t)‖ₑ * w t ≤
      c * volume (Metric.closedBall (0 : Rn n) R) * lpMaximal g x := by
  have hind : ∀ t, (Metric.closedBall (0 : Rn n) R).indicator (fun t => ‖g (x - t)‖ₑ) t =
      (Metric.closedBall x R).indicator (fun y => ‖g y‖ₑ) (x - t) := by
    intro t
    have : (x - t ∈ Metric.closedBall x R) ↔ (t ∈ Metric.closedBall (0 : Rn n) R) := by
      simp [Metric.mem_closedBall, dist_eq_norm]
    by_cases ht : t ∈ Metric.closedBall (0 : Rn n) R
    · rw [indicator_of_mem ht, indicator_of_mem (this.2 ht)]
    · rw [indicator_of_notMem ht, indicator_of_notMem (fun h => ht (this.1 h))]
  calc ∫⁻ t, ‖g (x - t)‖ₑ * w t
      ≤ ∫⁻ t, c * (Metric.closedBall (0 : Rn n) R).indicator (fun t => ‖g (x - t)‖ₑ) t := by
        refine lintegral_mono fun t => ?_
        by_cases ht : t ∈ Metric.closedBall (0 : Rn n) R
        · have := hw t
          rw [indicator_of_mem ht] at this ⊢
          rw [mul_comm]; exact mul_le_mul' this le_rfl
        · have := hw t
          rw [indicator_of_notMem ht] at this ⊢
          rw [nonpos_iff_eq_zero.1 this, mul_zero, mul_zero]
    _ = c * ∫⁻ y, (Metric.closedBall x R).indicator (fun y => ‖g y‖ₑ) y := by
        have hmeas : Measurable fun t =>
            (Metric.closedBall (0 : Rn n) R).indicator (fun t => ‖g (x - t)‖ₑ) t :=
          (hg.comp (continuous_sub_left x)).enorm.measurable.indicator
            Metric.isClosed_closedBall.measurableSet
        rw [lintegral_const_mul c hmeas]
        simp_rw [hind]
        rw [lintegral_sub_left_eq_self (fun y => (Metric.closedBall x R).indicator
          (fun y => ‖g y‖ₑ) y) x]
    _ = c * ∫⁻ y in Metric.closedBall x R, ‖g y‖ₑ := by
        rw [lintegral_indicator Metric.isClosed_closedBall.measurableSet]
    _ ≤ c * (volume (Metric.closedBall x R) * lpMaximal g x) := by
        gcongr; exact lp_setLIntegral_closedBall_le g x hR
    _ = c * volume (Metric.closedBall (0 : Rn n) R) * lpMaximal g x := by
        rw [Measure.addHaar_closedBall_center, mul_assoc]

/-- The sup bound `W_m = C / (2^{m-1})^n` of `|φ_m K|`. -/
def pieceSup (n : ℕ) (C : ℝ) (m : ℤ) : ℝ := C / ((2 : ℝ) ^ (m - 1)) ^ n

/-- `|φ_m(t) K(t)| ≤ W_m 𝟙_{|t| ≤ 2^{m+1}}`. -/
theorem abs_dyadicPhiScale_mul_czKernel_le {n : ℕ} {Ω : Rn n → ℝ} {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |Ω t| ≤ C) (m : ℤ) (t : Rn n) :
    |dyadicPhiScale n m t * czKernel n Ω t| ≤
      (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (m + 1))).indicator
        (fun _ => pieceSup n C m) t := by
  by_cases h : dyadicPhiScale n m t = 0
  · rw [h, zero_mul, abs_zero]
    exact indicator_nonneg (fun _ _ => by unfold pieceSup; positivity) _
  obtain ⟨h1, h2⟩ := dyadicPhiScale_ne_zero h
  have hmem : t ∈ Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (m + 1)) := by
    simpa using h2.le
  rw [indicator_of_mem hmem, abs_mul, abs_of_nonneg (dyadicPhiScale_nonneg n m t), czKernel,
    abs_div, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ n), pieceSup]
  have hpos : (0 : ℝ) < (2 : ℝ) ^ (m - 1) := zpow_pos two_pos _
  calc dyadicPhiScale n m t * (|Ω t| / ‖t‖ ^ n) ≤ 1 * (C / ‖t‖ ^ n) :=
        mul_le_mul (dyadicPhiScale_le_one n m t) (div_le_div_of_nonneg_right (hC t)
          (by positivity)) (by positivity) zero_le_one
    _ ≤ C / ((2 : ℝ) ^ (m - 1)) ^ n := by
        rw [one_mul]
        exact div_le_div_of_nonneg_left hC0 (by positivity)
          (pow_le_pow_left₀ hpos.le h1.le n)

/-- `|t|^α |φ_m(t) K(t)| ≤ 2^{(m+1)α} W_m 𝟙_{|t| ≤ 2^{m+1}}` (`α ≥ 0`). -/
theorem rpow_mul_abs_dyadicPhiScale_mul_czKernel_le {n : ℕ} {Ω : Rn n → ℝ} {C : ℝ}
    (hC0 : 0 ≤ C) (hC : ∀ t, |Ω t| ≤ C) {α : ℝ} (hα : 0 ≤ α) (m : ℤ) (t : Rn n) :
    ‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t| ≤
      (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (m + 1))).indicator
        (fun _ => (2 : ℝ) ^ (((m : ℝ) + 1) * α) * pieceSup n C m) t := by
  have h := abs_dyadicPhiScale_mul_czKernel_le hC0 hC m t
  by_cases hmem : t ∈ Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (m + 1))
  · rw [indicator_of_mem hmem] at h ⊢
    have ht : ‖t‖ ≤ (2 : ℝ) ^ (m + 1) := by simpa using hmem
    have hpow : ‖t‖ ^ α ≤ (2 : ℝ) ^ (((m : ℝ) + 1) * α) := by
      calc ‖t‖ ^ α ≤ ((2 : ℝ) ^ (m + 1)) ^ α := Real.rpow_le_rpow (norm_nonneg _) ht hα
        _ = (2 : ℝ) ^ (((m : ℝ) + 1) * α) := by
          rw [← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]; push_cast; rfl
    exact mul_le_mul hpow h (abs_nonneg _) (by positivity)
  · rw [indicator_of_notMem hmem] at h ⊢
    rw [le_antisymm h (abs_nonneg _), mul_zero]

/-- `|B(0, 2^{m+1})| W_m = 4^n C |B(0,1)|`. -/
theorem volume_closedBall_mul_pieceSup (n : ℕ) {C : ℝ} (hC0 : 0 ≤ C) (m : ℤ) :
    ENNReal.ofReal (pieceSup n C m) * volume (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (m + 1))) =
      ENNReal.ofReal (4 ^ n * C) * volume (Metric.ball (0 : Rn n) 1) := by
  rw [Measure.addHaar_closedBall _ _ (by positivity), finrank_euclideanSpace_fin, ← mul_assoc,
    ← ENNReal.ofReal_mul (by unfold pieceSup; positivity)]
  congr 2
  have h1 : (2 : ℝ) ^ (m + 1) = 4 * (2 : ℝ) ^ (m - 1) := by
    rw [show m + 1 = (m - 1) + 2 by ring, zpow_add₀ (by norm_num)]; norm_num; ring
  have hpos : (0 : ℝ) < (2 : ℝ) ^ (m - 1) := zpow_pos two_pos _
  rw [pieceSup, h1, mul_pow]
  field_simp

/-- **Lipschitz dependence on `u`** of the pieces (`eq:Hul`):
`|𝓗^{(v)}_m g(x) - 𝓗^{(u)}_m g(x)| ≤ |v - u| ∫ |g(x - t)| |t|^α |φ_m(t) K(t)| dt`. -/
theorem IsHomogeneousCZKernel.enorm_modulatedPiece_sub_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α u v : ℝ) (m : ℤ) (g : 𝓢(Rn n, ℂ)) (x : Rn n) :
    ‖modulatedPiece n α Ω v m g x - modulatedPiece n α Ω u m g x‖ₑ ≤
      ENNReal.ofReal |v - u| * ∫⁻ t, ‖g (x - t)‖ₑ *
        ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|) := by
  have hint : ∀ w, Integrable (fun t => g (x - t) * pieceKernel n α Ω w m t) := fun w =>
    (hΩ.integrable_pieceKernel α w m).bdd_mul (c := SchwartzMap.seminorm ℝ 0 0 g)
      (g.continuous.comp (continuous_sub_left x)).aestronglyMeasurable
      (ae_of_all _ fun t => SchwartzMap.norm_le_seminorm ℝ g _)
  rw [modulatedPiece_eq_pieceKernel, modulatedPiece_eq_pieceKernel, ← integral_sub (hint v)
    (hint u)]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun t => ?_
  have hpk : ‖pieceKernel n α Ω v m t - pieceKernel n α Ω u m t‖ ≤
      |v - u| * (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|) := by
    rw [pieceKernel, pieceKernel, ← sub_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have := norm_exp_sub_exp_le v u (‖t‖ ^ α)
    rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ α)] at this
    calc _ ≤ |v - u| * ‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t| :=
          mul_le_mul_of_nonneg_right this (abs_nonneg _)
      _ = _ := by ring
  rw [← mul_sub, enorm_mul]
  calc ‖g (x - t)‖ₑ * ‖pieceKernel n α Ω v m t - pieceKernel n α Ω u m t‖ₑ
      ≤ ‖g (x - t)‖ₑ * ENNReal.ofReal (|v - u| *
          (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|)) :=
        mul_le_mul' le_rfl (by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hpk)
    _ = _ := by rw [ENNReal.ofReal_mul (abs_nonneg _)]; ring

/-- The `u`-length of the short interval `J_j`: `|J_j| ≤ 2^{(j+1)α}`. -/
theorem dyadicPoint_sub_le (α : ℝ) (j : ℤ) :
    dyadicPoint α (j + 1) - dyadicPoint α j ≤ (2 : ℝ) ^ (((j : ℝ) + 1) * α) := by
  have := dyadicPoint_pos α j
  rw [dyadicPoint]; push_cast; linarith

/-- **Pointwise bound behind (`est1`)**: for `u ∈ J_j`, the `V^r`-norm of
`u ↦ 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x)` is at most `4^n C |B₁| 2^{(ℓ+2)α} M(P_{j+k} f)(x)`. -/
theorem IsHomogeneousCZKernel.variationNorm_shortPiece_le_maximal {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 < α) {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |Ω t| ≤ C) {r : ℝ} (hr : 1 ≤ r) (ℓ k j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 2) * α) * (4 ^ n * C)) *
        volume (Metric.ball (0 : Rn n) 1) * lpMaximal (lpProj n (j + k) f) x := by
  set g := lpProj n (j + k) f
  set m : ℤ := ℓ - j
  have hlip : ∀ u ∈ shortInterval α j, ∀ v ∈ shortInterval α j, u ≤ v →
      ‖shortPiece n α Ω ℓ k f j x v - shortPiece n α Ω ℓ k f j x u‖ₑ ≤
        (ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * α) * (4 ^ n * C)) *
          volume (Metric.ball (0 : Rn n) 1) * lpMaximal g x) * ENNReal.ofReal (v - u) := by
    intro u _ v _ huv
    refine (hΩ.enorm_modulatedPiece_sub_le α u v m g x).trans ?_
    rw [abs_of_nonneg (sub_nonneg.2 huv), mul_comm]
    refine mul_le_mul' ?_ le_rfl
    refine (lintegral_mul_le_maximal_of_ball g.continuous x (zpow_pos two_pos (m + 1))
      (c := ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * α) * pieceSup n C m)) fun t => ?_).trans
      (le_of_eq ?_)
    · have := rpow_mul_abs_dyadicPhiScale_mul_czKernel_le hC0 hC hα.le m t
      by_cases ht : t ∈ Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (m + 1))
      · rw [indicator_of_mem ht] at this ⊢; exact ENNReal.ofReal_le_ofReal this
      · rw [indicator_of_notMem ht] at this ⊢
        rw [le_antisymm this (by positivity), ENNReal.ofReal_zero]
    · rw [ENNReal.ofReal_mul (by positivity), mul_assoc (ENNReal.ofReal _),
        volume_closedBall_mul_pieceSup n hC0 m, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  calc variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x)
      ≤ variationNorm 1 (shortInterval α j) (shortPiece n α Ω ℓ k f j x) :=
        variationNorm_le_variationNorm_one hr _ _
    _ ≤ (ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * α) * (4 ^ n * C)) *
          volume (Metric.ball (0 : Rn n) 1) * lpMaximal g x) *
          ENNReal.ofReal (dyadicPoint α (j + 1) - dyadicPoint α j) :=
        variationNorm_one_le_of_lipschitz hlip
    _ ≤ (ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * α) * (4 ^ n * C)) *
          volume (Metric.ball (0 : Rn n) 1) * lpMaximal g x) *
          ENNReal.ofReal ((2 : ℝ) ^ (((j : ℝ) + 1) * α)) := by
        gcongr; exact dyadicPoint_sub_le α j
    _ = _ := by
        have he : (2 : ℝ) ^ (((m : ℝ) + 1) * α) * (4 ^ n * C) * (2 : ℝ) ^ (((j : ℝ) + 1) * α) =
            (2 : ℝ) ^ (((ℓ : ℝ) + 2) * α) * (4 ^ n * C) := by
          rw [mul_right_comm, ← Real.rpow_add two_pos]
          congr 2; simp only [m]; push_cast; ring
        rw [← he, ENNReal.ofReal_mul (p := (2 : ℝ) ^ (((m : ℝ) + 1) * α) * (4 ^ n * C))
          (by positivity)]
        ring

/-- Continuity of `(x, u) ↦ ∫ g(x - t) e^{iu|t|^α} φ_m(t) K(t) dt` (dominated convergence). -/
theorem IsHomogeneousCZKernel.continuous_modulatedPiece_uncurry {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (m : ℤ) (g : 𝓢(Rn n, ℂ)) :
    Continuous fun p : Rn n × ℝ => modulatedPiece n α Ω p.2 m g p.1 := by
  simp_rw [modulatedPiece_eq_pieceKernel]
  refine continuous_of_dominated (bound := fun t => SchwartzMap.seminorm ℝ 0 0 g *
      ‖dyadicPhiScale n m t * czKernel n Ω t‖) (fun p => ?_) (fun p => ae_of_all _ fun t => ?_)
    ((hΩ.integrable_dyadicPhiScale_mul m).norm.const_mul _) (ae_of_all _ fun t => ?_)
  · exact ((g.continuous.comp (continuous_sub_left p.1)).aestronglyMeasurable).mul
      (hΩ.integrable_pieceKernel α p.2 m).aestronglyMeasurable
  · rw [norm_mul, norm_pieceKernel]
    exact mul_le_mul_of_nonneg_right (SchwartzMap.norm_le_seminorm ℝ g _) (norm_nonneg _)
  · refine (g.continuous.comp (continuous_fst.sub continuous_const)).mul ?_
    simp only [pieceKernel]
    exact (Complex.continuous_exp.comp ((continuous_const.mul
      (Complex.continuous_ofReal.comp continuous_snd)).mul continuous_const)).mul continuous_const

/-- Continuity of `u ↦ 𝓗^{(u)}_m g(x)`. -/
theorem IsHomogeneousCZKernel.continuous_modulatedPiece_u {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (m : ℤ) (g : 𝓢(Rn n, ℂ)) (x : Rn n) :
    Continuous fun u => modulatedPiece n α Ω u m g x := by
  have h2 : Continuous fun u : ℝ => ((x, u) : Rn n × ℝ) := continuous_const.prodMk continuous_id
  have := (hΩ.continuous_modulatedPiece_uncurry α m g).comp h2
  exact this

/-- Continuity of `x ↦ 𝓗^{(u)}_m g(x)`. -/
theorem IsHomogeneousCZKernel.continuous_modulatedPiece_x {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (m : ℤ) (g : 𝓢(Rn n, ℂ)) (u : ℝ) :
    Continuous fun x => modulatedPiece n α Ω u m g x := by
  have h2 : Continuous fun x : Rn n => ((x, u) : Rn n × ℝ) := continuous_id.prodMk continuous_const
  have := (hΩ.continuous_modulatedPiece_uncurry α m g).comp h2
  exact this

/-- Measurability of `x ↦ ‖V^r_j 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x)‖_{ℓ^r_j}` (`α > 0`). -/
theorem IsHomogeneousCZKernel.measurable_shortPieceVar {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 < α) (r : ℝ) (ℓ k : ℤ)
    (f : 𝓢(Rn n, ℂ)) : Measurable (shortPieceVar r n α Ω ℓ k f) := by
  have key : ∀ j : ℤ, Measurable fun x =>
      variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ^ r := by
    intro j
    have hA : ∀ u, Measurable fun x => shortPiece n α Ω ℓ k f j x u := fun u =>
      (hΩ.continuous_modulatedPiece_x α (ℓ - j) (lpProj n (j + k) f) u).measurable
    have hcu : ∀ x, Continuous (shortPiece n α Ω ℓ k f j x) := fun x =>
      hΩ.continuous_modulatedPiece_u α (ℓ - j) (lpProj n (j + k) f) x
    have := measurable_variationNorm_of_ratCast (A := shortPiece n α Ω ℓ k f j) hA hcu r
      (shortInterval_subset_closure hα j)
    exact this.pow_const r
  exact (Measurable.tsum key).pow_const _

set_option maxHeartbeats 400000 in
-- The proof elaborates several large `[0, ∞]`-valued expressions involving `eLpNorm`.
/-- **Estimate (`est1`)** (paper §4.2): for `1 < p < ∞` and `r ≥ 2` there is `C` such that for all
`ℓ, k ∈ ℤ` and Schwartz `f`,
`‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ C 2^{ℓα} ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.est1 {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {r : ℝ} (hr : 2 ≤ r) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ)),
      eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        C * ENNReal.ofReal ((2 : ℝ) ^ ((ℓ : ℝ) * α)) * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨CΩ, hC0, hC⟩ := hΩ.exists_bound
  obtain ⟨CM, hCM, hM⟩ := eLpNorm_sqrt_tsum_maximal_lpConv_le hn (lpPsi n) (integral_lpPsi n) hp
  obtain ⟨A, hA_def⟩ : ∃ A : ℝ≥0∞, A = ENNReal.ofReal ((2 : ℝ) ^ (2 * α) * (4 ^ n * CΩ)) *
    volume (Metric.ball (0 : Rn n) 1) := ⟨_, rfl⟩
  have hA : A ≠ ∞ := by
    rw [hA_def]; exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top measure_ball_lt_top.ne
  refine ⟨A * CM, ENNReal.mul_ne_top hA hCM, fun ℓ k f => ?_⟩
  have hr0 : 0 < r := by linarith
  obtain ⟨c, hc_def⟩ : ∃ c : ℝ≥0∞, c = ENNReal.ofReal ((2 : ℝ) ^ ((ℓ : ℝ) * α)) * A :=
    ⟨_, rfl⟩
  have hc : c ≠ ∞ := by rw [hc_def]; exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hA
  obtain ⟨Mf, hMf⟩ : ∃ Mf : ℤ → Rn n → ℝ≥0∞,
      Mf = fun j x => lpMaximal (lpConv (lpPsi n) (j + k) f) x := ⟨_, rfl⟩
  have hpt : ∀ x, shortPieceVar r n α Ω ℓ k f x ≤
      c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ) := by
    intro x
    have h1 : ∀ j : ℤ, variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ≤
        c * Mf j x := by
      intro j
      refine (hΩ.variationNorm_shortPiece_le_maximal hα hC0 hC (by linarith) ℓ k j f x).trans
        (le_of_eq ?_)
      have he : (2 : ℝ) ^ (((ℓ : ℝ) + 2) * α) * (4 ^ n * CΩ) =
          (2 : ℝ) ^ ((ℓ : ℝ) * α) * ((2 : ℝ) ^ (2 * α) * (4 ^ n * CΩ)) := by
        have h2 : (2 : ℝ) ^ (((ℓ : ℝ) + 2) * α) = 2 ^ ((ℓ : ℝ) * α) * 2 ^ (2 * α) := by
          rw [← Real.rpow_add two_pos]; ring_nf
        rw [h2]; ring
      rw [he, ENNReal.ofReal_mul (by positivity), hc_def, hA_def, hMf]
      simp only [lpProj]
      ring
    calc shortPieceVar r n α Ω ℓ k f x
        ≤ (∑' j : ℤ, (c * Mf j x) ^ r) ^ (1 / r) :=
          ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun j =>
            ENNReal.rpow_le_rpow (h1 j) hr0.le) (by positivity)
      _ = c * (∑' j : ℤ, Mf j x ^ r) ^ (1 / r) := by
          simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le]
          rw [ENNReal.tsum_mul_left, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
            rpow_rpow_one_div hr0.ne']
      _ ≤ c * (∑' j : ℤ, Mf j x ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) :=
          mul_le_mul' le_rfl (tsum_rpow_one_div_le (by norm_num) hr _)
      _ = c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ) := by
          simp_rw [ENNReal.rpow_two]
  have hGm : AEMeasurable (fun x => (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ)) := by
    refine (AEMeasurable.tsum fun j => ?_).pow_const _
    rw [hMf]
    simp only
    rw [← fsMaximal_eq_lpMaximal, fsMaximal_eq_hlMaximal]
    exact ((fs_measurable_maximal
      (lpConv (lpPsi n) (j + k) f).continuous.aestronglyMeasurable).pow_const 2).aemeasurable
  calc eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p)
      ≤ eLpNorm (fun x => c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) :=
        eLpNorm_mono_enorm (g := fun x => c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ))
          (hΩ.measurable_shortPieceVar hα r ℓ k f).aestronglyMeasurable
          fun x => by simpa only [enorm_eq_self] using hpt x
    _ = c * eLpNorm (fun x => (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) :=
        eLpNorm_const_mul_ennreal hGm hc (show (0 : ℝ) < p by linarith)
    _ ≤ c * (CM * eLpNorm f (ENNReal.ofReal p)) := by
        rw [hMf]; exact mul_le_mul' le_rfl (hM k f)
    _ = A * CM * ENNReal.ofReal ((2 : ℝ) ^ ((ℓ : ℝ) * α)) * eLpNorm f (ENNReal.ofReal p) := by
        rw [hc_def]; ring

/-! ## The reproducing identity `P_k = P_k P̃_k` and maximal function bounds -/

/-- Fourier injectivity on Schwartz space. -/
theorem schwartz_eq_of_fourier_eq {n : ℕ} {a b : 𝓢(Rn n, ℂ)}
    (h : ∀ ξ, 𝓕 (a : Rn n → ℂ) ξ = 𝓕 (b : Rn n → ℂ) ξ) : a = b := by
  have h' : 𝓕 a = 𝓕 b := by
    ext ξ; rw [SchwartzMap.fourier_coe, SchwartzMap.fourier_coe]; exact h ξ
  rw [← FourierPair.fourierInv_fourier_eq (E := 𝓢(Rn n, ℂ)) (F := 𝓢(Rn n, ℂ)) a, h',
    FourierPair.fourierInv_fourier_eq]

/-- **`P_k = P_k P̃_k`** (paper §4.2, `\tilde P_{j+k}`): `ψ_k * f = ψ_k * (ψ̃_k * f)`. -/
theorem lpProj_eq_lpConv_lpProjTilde {n : ℕ} (k : ℤ) (f : 𝓢(Rn n, ℂ)) :
    lpProj n k f = lpConv (lpPsi n) k (lpProjTilde n k f) := by
  refine schwartz_eq_of_fourier_eq fun ξ => ?_
  rw [lpProj, lpProjTilde, fourier_lpConv, fourier_lpConv, fourier_lpConv, fourier_lpPsi,
    fourier_lpPsiTilde]
  simp only
  by_cases h : dyadicPhi n (((2 : ℝ) ^ k)⁻¹ • ξ) = 0
  · rw [h]; simp
  · rw [lpThetaTildeFun_eq_one h]; simp

/-- Mean value estimate with decay: if `|∇ψ(w)| ≤ D (1 + |w|)^{-N}` and `|b| ≤ 4`, then
`|ψ(a - b) - ψ(a)| ≤ 5^N D |b| (1 + |a|)^{-N}`. -/
theorem norm_sub_le_of_decay_of_le_four {n : ℕ} {ψ : Rn n → ℂ} (hψ : Differentiable ℝ ψ)
    {D : ℝ} {N : ℕ} (hd : ∀ w, (1 + ‖w‖) ^ N * ‖fderiv ℝ ψ w‖ ≤ D) {a b : Rn n}
    (hb : ‖b‖ ≤ 4) :
    ‖ψ (a - b) - ψ a‖ ≤ 5 ^ N * D * ‖b‖ / (1 + ‖a‖) ^ N := by
  have hbound : ∀ w ∈ Metric.closedBall a ‖b‖,
      ‖fderiv ℝ ψ w‖ ≤ 5 ^ N * D / (1 + ‖a‖) ^ N := by
    intro w hw
    rw [Metric.mem_closedBall, dist_eq_norm] at hw
    have h1 : 1 + ‖a‖ ≤ 5 * (1 + ‖w‖) := by
      have := norm_sub_norm_le a w
      rw [norm_sub_rev] at this
      nlinarith [norm_nonneg w, norm_sub_rev w a]
    have h3 : (1 + ‖a‖) ^ N ≤ 5 ^ N * (1 + ‖w‖) ^ N := by
      rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) h1 N
    rw [le_div_iff₀ (by positivity)]
    calc ‖fderiv ℝ ψ w‖ * (1 + ‖a‖) ^ N ≤ ‖fderiv ℝ ψ w‖ * (5 ^ N * (1 + ‖w‖) ^ N) :=
          mul_le_mul_of_nonneg_left h3 (norm_nonneg _)
      _ = 5 ^ N * ((1 + ‖w‖) ^ N * ‖fderiv ℝ ψ w‖) := by ring
      _ ≤ 5 ^ N * D := by gcongr; exact hd w
  have hmem : a - b ∈ Metric.closedBall a ‖b‖ := by
    rw [Metric.mem_closedBall, dist_eq_norm]; simp
  have h := (convex_closedBall a ‖b‖).norm_image_sub_le_of_norm_fderiv_le
    (fun w _ => hψ w) hbound (Metric.mem_closedBall_self (norm_nonneg b)) hmem
  calc ‖ψ (a - b) - ψ a‖ ≤ 5 ^ N * D / (1 + ‖a‖) ^ N * ‖a - b - a‖ := h
    _ = 5 ^ N * D * ‖b‖ / (1 + ‖a‖) ^ N := by
        rw [sub_sub_cancel_left, norm_neg]; ring

/-- The dilated version: for `2^i |t| ≤ 4`,
`|ψ_i(z - t) - ψ_i(z)| ≤ 5^N D 2^i |t| 2^{in} (1 + 2^i |z|)^{-N}`. -/
theorem norm_lpDilate_sub_le {n : ℕ} {ψ : Rn n → ℂ} (hψ : Differentiable ℝ ψ)
    {D : ℝ} {N : ℕ} (hd : ∀ w, (1 + ‖w‖) ^ N * ‖fderiv ℝ ψ w‖ ≤ D) (i : ℤ) {z t : Rn n}
    (ht : (2 : ℝ) ^ i * ‖t‖ ≤ 4) :
    ‖lpDilate n ψ i (z - t) - lpDilate n ψ i z‖ ≤
      5 ^ N * D * ((2 : ℝ) ^ i * ‖t‖) * ((2 : ℝ) ^ i) ^ n / (1 + (2 : ℝ) ^ i * ‖z‖) ^ N := by
  have hc : 0 < (2 : ℝ) ^ i := zpow_pos two_pos i
  have hpow : ((2 : ℝ) : ℂ) ^ (i * (n : ℤ)) = ((((2 : ℝ) ^ i) ^ n : ℝ) : ℂ) := by
    rw [← zpow_natCast, ← zpow_mul, Complex.ofReal_zpow]
  have h1 : lpDilate n ψ i (z - t) - lpDilate n ψ i z =
      ((((2 : ℝ) ^ i) ^ n : ℝ) : ℂ) *
        (ψ ((2 : ℝ) ^ i • z - (2 : ℝ) ^ i • t) - ψ ((2 : ℝ) ^ i • z)) := by
    simp only [lpDilate, smul_sub, mul_sub, hpow]
  have hb : ‖(2 : ℝ) ^ i • t‖ ≤ 4 := by rw [norm_smul, Real.norm_of_nonneg hc.le]; exact ht
  have h2 := norm_sub_le_of_decay_of_le_four hψ hd (a := (2 : ℝ) ^ i • z) hb
  rw [norm_smul, norm_smul, Real.norm_of_nonneg hc.le] at h2
  rw [h1, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  calc ((2 : ℝ) ^ i) ^ n * ‖ψ ((2 : ℝ) ^ i • z - (2 : ℝ) ^ i • t) - ψ ((2 : ℝ) ^ i • z)‖
      ≤ ((2 : ℝ) ^ i) ^ n * (5 ^ N * D * ((2 : ℝ) ^ i * ‖t‖) /
          (1 + (2 : ℝ) ^ i * ‖z‖) ^ N) := mul_le_mul_of_nonneg_left h2 (by positivity)
    _ = _ := by ring

/-- **Convolution with a radially decreasing majorant** (Stein, lintegral form):
if `Φ ≥ 0` is nonincreasing on `[0, ∞)`, then
`∫ |h(y)| Φ(|x - y|) dy ≤ (∫ Φ(|z|) dz) · M h(x)`. -/
theorem lintegral_mul_radial_le_maximal {n : ℕ} (hn : 0 < n) {Φ : ℝ → ℝ}
    (hΦ : AntitoneOn Φ (Ici 0)) (hΦ0 : ∀ r, 0 ≤ r → 0 ≤ Φ r) {h : Rn n → ℂ}
    (hh : AEStronglyMeasurable h volume) (x : Rn n) :
    ∫⁻ y, ‖h y‖ₑ * ENNReal.ofReal (Φ ‖x - y‖) ≤
      (∫⁻ z : Rn n, ENNReal.ofReal (Φ ‖z‖)) * lpMaximal h x := by
  set Φ' : ℝ → ℝ := fun r => Φ (max r 0) with hΦ'_def
  have hΦ' : Antitone Φ' := fun r s hrs =>
    hΦ (mem_Ici.2 (le_max_right _ _)) (mem_Ici.2 (le_max_right _ _)) (max_le_max hrs le_rfl)
  have hΦ'n : ∀ z : Rn n, Φ' ‖z‖ = Φ ‖z‖ := fun z => by
    simp only [Φ', max_eq_left (norm_nonneg z)]
  have hφm : Measurable fun z : Rn n => Φ' ‖z‖ := hΦ'.measurable.comp measurable_norm
  have hφ0 : ∀ z : Rn n, 0 ≤ Φ' ‖z‖ := fun z => hΦ0 _ (le_max_right _ _)
  have hmx : Measurable fun y : Rn n => Φ' ‖x - y‖ :=
    hφm.comp (measurable_const.sub measurable_id)
  have hmt : Measurable fun t : ℝ => volume {z : Rn n | t < Φ' ‖z‖} := by
    refine Antitone.measurable fun t t' htt => measure_mono fun z hz => ?_
    exact lt_of_le_of_lt htt hz
  calc ∫⁻ y, ‖h y‖ₑ * ENNReal.ofReal (Φ ‖x - y‖)
      = ∫⁻ y, ‖h y‖ₑ * ENNReal.ofReal (Φ' ‖x - y‖) := by simp_rw [hΦ'n]
    _ = ∫⁻ y, ENNReal.ofReal (Φ' ‖x - y‖) ∂(volume.withDensity fun y => ‖h y‖ₑ) :=
        (lintegral_withDensity_eq_lintegral_mul₀ hh.enorm
          hmx.ennreal_ofReal.aemeasurable).symm
    _ = ∫⁻ t in Ioi 0, (volume.withDensity fun y => ‖h y‖ₑ) {y | t < Φ' ‖x - y‖} :=
        lintegral_eq_lintegral_meas_lt _ (ae_of_all _ fun y => hφ0 _) hmx.aemeasurable
    _ ≤ ∫⁻ t in Ioi 0, volume {z : Rn n | t < Φ' ‖z‖} * lpMaximal h x := by
        refine lintegral_mono fun t => ?_
        rw [withDensity_apply _ (measurableSet_lt measurable_const hmx)]
        exact lp_setLIntegral_le_of_radial hn h x (S := {z | t < Φ' ‖z‖})
          fun z hz w hw => lt_of_lt_of_le hz (hΦ' hw)
    _ = (∫⁻ t in Ioi 0, volume {z : Rn n | t < Φ' ‖z‖}) * lpMaximal h x :=
        lintegral_mul_const _ hmt
    _ = (∫⁻ z : Rn n, ENNReal.ofReal (Φ ‖z‖)) * lpMaximal h x := by
        rw [← lintegral_eq_lintegral_meas_lt volume (ae_of_all _ hφ0) hφm.aemeasurable]
        simp_rw [hΦ'n]

/-- The scaled Japanese bracket `Φ_i(r) = 2^{in} (1 + 2^i r)^{-(n+1)}` has
`∫ Φ_i(|z|) dz = ∫ (1 + |z|)^{-(n+1)} dz`. -/
theorem lintegral_scaled_bracket (n : ℕ) (i : ℤ) :
    ∫⁻ z : Rn n, ENNReal.ofReal (((2 : ℝ) ^ i) ^ n / (1 + (2 : ℝ) ^ i * ‖z‖) ^ (n + 1)) =
      ∫⁻ z : Rn n, ENNReal.ofReal (1 / (1 + ‖z‖) ^ (n + 1)) := by
  have hc : 0 < (2 : ℝ) ^ i := zpow_pos two_pos i
  have h1 : ∀ z : Rn n, ((2 : ℝ) ^ i) ^ n / (1 + (2 : ℝ) ^ i * ‖z‖) ^ (n + 1) =
      ((2 : ℝ) ^ i) ^ n * (1 / (1 + ‖(2 : ℝ) ^ i • z‖) ^ (n + 1)) := fun z => by
    rw [norm_smul, Real.norm_of_nonneg hc.le]; ring
  simp_rw [h1, ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ((2 : ℝ) ^ i) ^ n)]
  have hF : Measurable fun z : Rn n => ENNReal.ofReal (1 / (1 + ‖z‖) ^ (n + 1)) := by fun_prop
  have hmap := Measure.map_addHaar_smul (volume : Measure (Rn n)) hc.ne'
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    show (∫⁻ a : Rn n, ENNReal.ofReal (1 / (1 + ‖(2 : ℝ) ^ i • a‖) ^ (n + 1))) =
      ∫⁻ y, ENNReal.ofReal (1 / (1 + ‖y‖) ^ (n + 1)) ∂(Measure.map ((2 : ℝ) ^ i • ·) volume)
      from (lintegral_map hF (measurable_const_smul _)).symm,
    hmap, lintegral_smul_measure, finrank_euclideanSpace_fin, smul_eq_mul, ← mul_assoc,
    ← ENNReal.ofReal_mul (by positivity), abs_of_pos (by positivity),
    mul_inv_cancel₀ (by positivity), ENNReal.ofReal_one, one_mul]

/-- **Mean zero of the pieces** (paper §4.2, before (`est2`)):
`∫ e^{iu|t|^α} φ_m(t) K(t) dt = 0`. -/
theorem IsHomogeneousCZKernel.integral_pieceKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) (α u : ℝ) (m : ℤ) :
    ∫ t, pieceKernel n α Ω u m t = 0 := by
  set e₀ : Rn n := EuclideanSpace.single ⟨0, hn⟩ 1
  have he₀ : ‖e₀‖ = 1 := by simp [e₀]
  have h := hΩ.integral_radial_mul_czKernel hn
    (fun r => exp (I * u * ((r ^ α : ℝ) : ℂ)) * ((dyadicPhiScale n m (r • e₀) : ℝ) : ℂ))
  refine (integral_congr_ae (ae_of_all _ fun t => ?_)).trans h
  have : dyadicPhiScale n m (‖t‖ • e₀) = dyadicPhiScale n m t :=
    dyadicPhiScale_congr_norm m (by rw [norm_smul, he₀, mul_one, norm_norm])
  simp only [pieceKernel, this]
  push_cast; ring

/-- Lipschitz dependence on `u` of `∫ G(t) e^{iu|t|^α} φ_m(t) K(t) dt` for bounded `G`. -/
theorem IsHomogeneousCZKernel.enorm_integral_pieceKernel_sub_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α u v : ℝ) (m : ℤ) {G : Rn n → ℂ}
    (hG : AEStronglyMeasurable G volume) {c : ℝ} (hc : ∀ t, ‖G t‖ ≤ c) :
    ‖(∫ t, G t * pieceKernel n α Ω v m t) - ∫ t, G t * pieceKernel n α Ω u m t‖ₑ ≤
      ENNReal.ofReal |v - u| * ∫⁻ t, ‖G t‖ₑ *
        ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|) := by
  have hint : ∀ w, Integrable (fun t => G t * pieceKernel n α Ω w m t) := fun w =>
    (hΩ.integrable_pieceKernel α w m).bdd_mul hG (ae_of_all _ hc)
  rw [← integral_sub (hint v) (hint u)]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun t => ?_
  have hpk : ‖pieceKernel n α Ω v m t - pieceKernel n α Ω u m t‖ ≤
      |v - u| * (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|) := by
    rw [pieceKernel, pieceKernel, ← sub_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have := norm_exp_sub_exp_le v u (‖t‖ ^ α)
    rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ α)] at this
    calc _ ≤ |v - u| * ‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t| :=
          mul_le_mul_of_nonneg_right this (abs_nonneg _)
      _ = _ := by ring
  rw [← mul_sub, enorm_mul]
  calc ‖G t‖ₑ * ‖pieceKernel n α Ω v m t - pieceKernel n α Ω u m t‖ₑ
      ≤ ‖G t‖ₑ * ENNReal.ofReal (|v - u| *
          (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|)) :=
        mul_le_mul' le_rfl (by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hpk)
    _ = _ := by rw [ENNReal.ofReal_mul (abs_nonneg _)]; ring

/-- The pieces in subtracted form (mean zero): `𝓗^{(u)}_m g(x) = ∫ (g(x - t) - g(x)) e^{iu|t|^α}
φ_m(t) K(t) dt` (paper §4.2). -/
theorem IsHomogeneousCZKernel.modulatedPiece_eq_integral_sub {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) (α u : ℝ) (m : ℤ) (g : 𝓢(Rn n, ℂ))
    (x : Rn n) :
    modulatedPiece n α Ω u m g x = ∫ t, (g (x - t) - g x) * pieceKernel n α Ω u m t := by
  have hint : Integrable (fun t => g (x - t) * pieceKernel n α Ω u m t) :=
    (hΩ.integrable_pieceKernel α u m).bdd_mul (c := SchwartzMap.seminorm ℝ 0 0 g)
      (g.continuous.comp (continuous_sub_left x)).aestronglyMeasurable
      (ae_of_all _ fun t => SchwartzMap.norm_le_seminorm ℝ g _)
  simp_rw [sub_mul]
  rw [integral_sub hint ((hΩ.integrable_pieceKernel α u m).const_mul _), integral_const_mul,
    hΩ.integral_pieceKernel hn, mul_zero, sub_zero, modulatedPiece_eq_pieceKernel]

/-- The Japanese bracket integral `A_n = ∫ (1 + |z|)^{-(n+1)} dz < ∞`. -/
theorem lintegral_bracket_ne_top (n : ℕ) :
    ∫⁻ z : Rn n, ENNReal.ofReal (1 / (1 + ‖z‖) ^ (n + 1)) ≠ ∞ := by
  have hi : Integrable (fun z : Rn n => (1 + ‖z‖) ^ (-((n + 1 : ℕ) : ℝ))) :=
    integrable_one_add_norm (by rw [finrank_euclideanSpace_fin]; push_cast; linarith)
  have heq : ∀ z : Rn n, (1 + ‖z‖) ^ (-((n + 1 : ℕ) : ℝ)) = 1 / (1 + ‖z‖) ^ (n + 1) := by
    intro z
    rw [Real.rpow_neg (by positivity), Real.rpow_natCast, one_div]
  simp_rw [heq] at hi
  rw [← ofReal_integral_eq_lintegral_ofReal hi (ae_of_all _ fun z => by positivity)]
  exact ENNReal.ofReal_ne_top

/-- **Difference bound for Littlewood–Paley pieces** (paper §4.2, proof of (`est2`)): for
`2^i |t| ≤ 4`, `|P_i f(x - t) - P_i f(x)| ≤ 5^{n+1} D 2^i |t| A_n M(P̃_i f)(x)`, where `D`
bounds `(1 + |w|)^{n+1} |∇ψ(w)|`. -/
theorem enorm_lpProj_sub_le {n : ℕ} (hn : 1 ≤ n) {D : ℝ}
    (hd : ∀ w, (1 + ‖w‖) ^ (n + 1) * ‖fderiv ℝ (lpPsi n) w‖ ≤ D) (i : ℤ) (f : 𝓢(Rn n, ℂ))
    (x t : Rn n) (ht : (2 : ℝ) ^ i * ‖t‖ ≤ 4) :
    ‖lpProj n i f (x - t) - lpProj n i f x‖ₑ ≤
      ENNReal.ofReal (5 ^ (n + 1) * D * ((2 : ℝ) ^ i * ‖t‖)) *
        (∫⁻ z : Rn n, ENNReal.ofReal (1 / (1 + ‖z‖) ^ (n + 1))) *
          lpMaximal (lpProjTilde n i f) x := by
  set h := lpProjTilde n i f
  have hψb : ∀ y, ‖lpDilate n (lpPsi n) i y‖ ≤ SchwartzMap.seminorm ℝ 0 0
      (schwartzDilate (lpPsi n) i) := fun y => by
    rw [← coe_schwartzDilate]; exact SchwartzMap.norm_le_seminorm ℝ _ y
  have hint : ∀ y, Integrable (fun w => lpDilate n (lpPsi n) i (y - w) * h w) := fun y =>
    h.integrable.bdd_mul (((schwartzDilate (lpPsi n) i).continuous.comp
      (continuous_sub_left y)).aestronglyMeasurable.congr (ae_of_all _ fun w => by
        simp [coe_schwartzDilate])) (ae_of_all _ fun w => hψb _)
  rw [lpProj_eq_lpConv_lpProjTilde, lpConv_apply, lpConv_apply, ← integral_sub (hint _) (hint _)]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  have hD0 : 0 ≤ D := (mul_nonneg (by positivity) (norm_nonneg _)).trans (hd 0)
  have hΦ : AntitoneOn (fun r : ℝ => ((2 : ℝ) ^ i) ^ n / (1 + (2 : ℝ) ^ i * r) ^ (n + 1))
      (Ici 0) := by
    intro r hr s hs hrs
    simp only
    have h0 : 0 ≤ (2 : ℝ) ^ i * r := mul_nonneg (zpow_pos two_pos i).le (mem_Ici.1 hr)
    gcongr
  have hmax := lintegral_mul_radial_le_maximal (by omega : 0 < n) hΦ
    (fun r hr => by positivity) h.continuous.aestronglyMeasurable x
  rw [lintegral_scaled_bracket] at hmax
  calc ∫⁻ w, ‖lpDilate n (lpPsi n) i (x - t - w) * h w -
        lpDilate n (lpPsi n) i (x - w) * h w‖ₑ
      ≤ ∫⁻ w, ENNReal.ofReal (5 ^ (n + 1) * D * ((2 : ℝ) ^ i * ‖t‖)) *
          (‖h w‖ₑ * ENNReal.ofReal (((2 : ℝ) ^ i) ^ n /
            (1 + (2 : ℝ) ^ i * ‖x - w‖) ^ (n + 1))) := by
        refine lintegral_mono fun w => ?_
        rw [← sub_mul, enorm_mul, sub_right_comm]
        calc ‖lpDilate n (lpPsi n) i (x - w - t) - lpDilate n (lpPsi n) i (x - w)‖ₑ * ‖h w‖ₑ
            ≤ ENNReal.ofReal (5 ^ (n + 1) * D * ((2 : ℝ) ^ i * ‖t‖) * (((2 : ℝ) ^ i) ^ n /
                (1 + (2 : ℝ) ^ i * ‖x - w‖) ^ (n + 1))) * ‖h w‖ₑ := by
              refine mul_le_mul' ?_ le_rfl
              rw [← ofReal_norm]
              refine ENNReal.ofReal_le_ofReal ((norm_lpDilate_sub_le (lpPsi n).differentiable
                hd i ht).trans (le_of_eq ?_))
              ring
          _ = _ := by rw [ENNReal.ofReal_mul (by positivity)]; ring
    _ = ENNReal.ofReal (5 ^ (n + 1) * D * ((2 : ℝ) ^ i * ‖t‖)) *
          ∫⁻ w, ‖h w‖ₑ * ENNReal.ofReal (((2 : ℝ) ^ i) ^ n /
            (1 + (2 : ℝ) ^ i * ‖x - w‖) ^ (n + 1)) :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ _ := (mul_le_mul' le_rfl hmax).trans_eq (mul_assoc _ _ _).symm

/-- The bracket constant `A_n = ∫ (1 + |z|)^{-(n+1)} dz`. -/
def bracketConst (n : ℕ) : ℝ≥0∞ := ∫⁻ z : Rn n, ENNReal.ofReal (1 / (1 + ‖z‖) ^ (n + 1))

/-- **Pointwise bound behind (`est2`)**: if `k + ℓ ≤ 1`, the `V^r`-norm of
`u ↦ 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x)` on `J_j` is at most
`2^{k+ℓ+ℓα} K₀ A_n |B₁| M(P̃_{j+k} f)(x)`, with `K₀ = 2^{1+2α} 5^{n+1} D 4^n C`. -/
theorem IsHomogeneousCZKernel.variationNorm_shortPiece_le_maximal_tilde {n : ℕ}
    {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α)
    {C : ℝ} (hC0 : 0 ≤ C) (hC : ∀ t, |Ω t| ≤ C) {D : ℝ} (hD0 : 0 ≤ D)
    (hd : ∀ w, (1 + ‖w‖) ^ (n + 1) * ‖fderiv ℝ (lpPsi n) w‖ ≤ D) {r : ℝ} (hr : 1 ≤ r)
    (ℓ k j : ℤ) (hkl : k + ℓ ≤ 1) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (((k : ℝ) + ℓ) + ℓ * α) *
        (2 ^ (1 + 2 * α) * (5 ^ (n + 1) * D) * (4 ^ n * C))) * bracketConst n *
        volume (Metric.ball (0 : Rn n) 1) * lpMaximal (lpProjTilde n (j + k) f) x := by
  set g := lpProj n (j + k) f
  set i : ℤ := j + k
  set m : ℤ := ℓ - j
  obtain ⟨Mh, hMh⟩ : ∃ Mh : ℝ≥0∞, Mh = lpMaximal (lpProjTilde n i f) x := ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℝ≥0∞,
      E = ENNReal.ofReal (5 ^ (n + 1) * D * (2 : ℝ) ^ i) * bracketConst n * Mh := ⟨_, rfl⟩
  have hw : ∀ t : Rn n, ‖g (x - t) - g x‖ₑ *
      ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|) ≤
        E * ENNReal.ofReal (‖t‖ ^ (α + 1) * |dyadicPhiScale n m t * czKernel n Ω t|) := by
    intro t
    by_cases h0 : dyadicPhiScale n m t = 0
    · simp [h0]
    have ht := (dyadicPhiScale_ne_zero h0).2
    have hit : (2 : ℝ) ^ i * ‖t‖ ≤ 4 := by
      calc (2 : ℝ) ^ i * ‖t‖ ≤ (2 : ℝ) ^ i * (2 : ℝ) ^ (m + 1) :=
            mul_le_mul_of_nonneg_left ht.le (by positivity)
        _ = (2 : ℝ) ^ (k + ℓ + 1) := by
            rw [← zpow_add₀ two_ne_zero]; congr 1; simp only [i, m]; ring
        _ ≤ (2 : ℝ) ^ (2 : ℤ) := zpow_le_zpow_right₀ (by norm_num) (by omega)
        _ = 4 := by norm_num
    have hb := enorm_lpProj_sub_le hn hd i f x t hit
    rw [← hMh] at hb
    calc ‖g (x - t) - g x‖ₑ *
          ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|)
        ≤ ENNReal.ofReal (5 ^ (n + 1) * D * ((2 : ℝ) ^ i * ‖t‖)) * bracketConst n * Mh *
          ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|) :=
          mul_le_mul' hb le_rfl
      _ = E * ENNReal.ofReal (‖t‖ ^ (α + 1) * |dyadicPhiScale n m t * czKernel n Ω t|) := by
          have he : 5 ^ (n + 1) * D * ((2 : ℝ) ^ i * ‖t‖) *
              (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|) =
              5 ^ (n + 1) * D * (2 : ℝ) ^ i *
                (‖t‖ ^ (α + 1) * |dyadicPhiScale n m t * czKernel n Ω t|) := by
            rw [Real.rpow_add_one' (norm_nonneg _) (by linarith)]; ring
          have he' : ENNReal.ofReal (5 ^ (n + 1) * D * ((2 : ℝ) ^ i * ‖t‖)) *
              ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|) =
              ENNReal.ofReal (5 ^ (n + 1) * D * (2 : ℝ) ^ i) *
              ENNReal.ofReal (‖t‖ ^ (α + 1) * |dyadicPhiScale n m t * czKernel n Ω t|) := by
            rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity), he]
          calc _ = (ENNReal.ofReal (5 ^ (n + 1) * D * ((2 : ℝ) ^ i * ‖t‖)) *
                ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|)) *
                bracketConst n * Mh := by simp only [bracketConst]; ring
            _ = _ := by rw [he', hE]; ring
  have hint : ∫⁻ t, ENNReal.ofReal (‖t‖ ^ (α + 1) * |dyadicPhiScale n m t * czKernel n Ω t|) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * (α + 1)) * (4 ^ n * C)) *
        volume (Metric.ball (0 : Rn n) 1) := by
    calc ∫⁻ t, ENNReal.ofReal (‖t‖ ^ (α + 1) * |dyadicPhiScale n m t * czKernel n Ω t|)
        ≤ ∫⁻ t, (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (m + 1))).indicator
            (fun _ => ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * (α + 1)) * pieceSup n C m)) t := by
          refine lintegral_mono fun t => ?_
          have := rpow_mul_abs_dyadicPhiScale_mul_czKernel_le hC0 hC (by linarith : 0 ≤ α + 1) m t
          by_cases ht : t ∈ Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (m + 1))
          · rw [indicator_of_mem ht] at this ⊢; exact ENNReal.ofReal_le_ofReal this
          · rw [indicator_of_notMem ht] at this ⊢
            rw [le_antisymm this (by positivity), ENNReal.ofReal_zero]
      _ = _ := by
          rw [lintegral_indicator_const Metric.isClosed_closedBall.measurableSet,
            ENNReal.ofReal_mul (by positivity), mul_assoc, volume_closedBall_mul_pieceSup n hC0 m,
            ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  have hmeasw : Measurable fun t : Rn n =>
      ENNReal.ofReal (‖t‖ ^ (α + 1) * |dyadicPhiScale n m t * czKernel n Ω t|) :=
    ((measurable_norm.pow_const _).mul
      ((measurable_dyadicPhiScale n m).mul hΩ.measurable_czKernel).abs).ennreal_ofReal
  have hlip : ∀ u ∈ shortInterval α j, ∀ v ∈ shortInterval α j, u ≤ v →
      ‖shortPiece n α Ω ℓ k f j x v - shortPiece n α Ω ℓ k f j x u‖ₑ ≤
        (E * (ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * (α + 1)) * (4 ^ n * C)) *
          volume (Metric.ball (0 : Rn n) 1))) * ENNReal.ofReal (v - u) := by
    intro u _ v _ huv
    have hG : ∀ t, ‖g (x - t) - g x‖ ≤ 2 * SchwartzMap.seminorm ℝ 0 0 g := fun t =>
      (norm_sub_le _ _).trans (by linarith [SchwartzMap.norm_le_seminorm ℝ g (x - t),
        SchwartzMap.norm_le_seminorm ℝ g x])
    simp only [shortPiece]
    rw [hΩ.modulatedPiece_eq_integral_sub hn, hΩ.modulatedPiece_eq_integral_sub hn]
    refine (hΩ.enorm_integral_pieceKernel_sub_le α u v m
      ((g.continuous.comp (continuous_sub_left x)).sub continuous_const).aestronglyMeasurable
      hG).trans ?_
    rw [abs_of_nonneg (sub_nonneg.2 huv), mul_comm]
    refine mul_le_mul' ?_ le_rfl
    calc ∫⁻ t, ‖g (x - t) - g x‖ₑ *
          ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n m t * czKernel n Ω t|)
        ≤ ∫⁻ t, E * ENNReal.ofReal (‖t‖ ^ (α + 1) *
            |dyadicPhiScale n m t * czKernel n Ω t|) := lintegral_mono hw
      _ = E * ∫⁻ t, ENNReal.ofReal (‖t‖ ^ (α + 1) *
            |dyadicPhiScale n m t * czKernel n Ω t|) := lintegral_const_mul _ hmeasw
      _ ≤ _ := mul_le_mul' le_rfl hint
  calc variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x)
      ≤ variationNorm 1 (shortInterval α j) (shortPiece n α Ω ℓ k f j x) :=
        variationNorm_le_variationNorm_one hr _ _
    _ ≤ (E * (ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * (α + 1)) * (4 ^ n * C)) *
          volume (Metric.ball (0 : Rn n) 1))) *
          ENNReal.ofReal (dyadicPoint α (j + 1) - dyadicPoint α j) :=
        variationNorm_one_le_of_lipschitz hlip
    _ ≤ (E * (ENNReal.ofReal ((2 : ℝ) ^ (((m : ℝ) + 1) * (α + 1)) * (4 ^ n * C)) *
          volume (Metric.ball (0 : Rn n) 1))) *
          ENNReal.ofReal ((2 : ℝ) ^ (((j : ℝ) + 1) * α)) := by
        gcongr; exact dyadicPoint_sub_le α j
    _ = _ := by
        have he : 5 ^ (n + 1) * D * (2 : ℝ) ^ i *
            ((2 : ℝ) ^ (((m : ℝ) + 1) * (α + 1)) * (4 ^ n * C)) * (2 : ℝ) ^ (((j : ℝ) + 1) * α) =
            (2 : ℝ) ^ (((k : ℝ) + ℓ) + ℓ * α) *
              (2 ^ (1 + 2 * α) * (5 ^ (n + 1) * D) * (4 ^ n * C)) := by
          rw [← Real.rpow_intCast]
          have h1 : (2 : ℝ) ^ ((i : ℤ) : ℝ) * 2 ^ (((m : ℝ) + 1) * (α + 1)) *
              2 ^ (((j : ℝ) + 1) * α) = 2 ^ (((k : ℝ) + ℓ) + ℓ * α) * 2 ^ (1 + 2 * α) := by
            rw [← Real.rpow_add two_pos, ← Real.rpow_add two_pos, ← Real.rpow_add two_pos]
            congr 1; simp only [i, m]; push_cast; ring
          calc 5 ^ (n + 1) * D * (2 : ℝ) ^ ((i : ℤ) : ℝ) *
              ((2 : ℝ) ^ (((m : ℝ) + 1) * (α + 1)) * (4 ^ n * C)) *
                (2 : ℝ) ^ (((j : ℝ) + 1) * α)
              = (2 : ℝ) ^ ((i : ℤ) : ℝ) * 2 ^ (((m : ℝ) + 1) * (α + 1)) *
                2 ^ (((j : ℝ) + 1) * α) * (5 ^ (n + 1) * D * (4 ^ n * C)) := by ring
            _ = _ := by rw [h1]; ring
        rw [hE, hMh, ← he]
        rw [ENNReal.ofReal_mul (p := 5 ^ (n + 1) * D * (2 : ℝ) ^ i *
            ((2 : ℝ) ^ (((m : ℝ) + 1) * (α + 1)) * (4 ^ n * C))) (by positivity),
          ENNReal.ofReal_mul (p := 5 ^ (n + 1) * D * (2 : ℝ) ^ i) (by positivity)]
        ring

/-- The bracket constant is finite. -/
theorem bracketConst_ne_top (n : ℕ) : bracketConst n ≠ ∞ := lintegral_bracket_ne_top n

set_option maxHeartbeats 400000 in
-- The proof elaborates several large `[0, ∞]`-valued expressions involving `eLpNorm`.
/-- **Estimate (`est2`)** (paper §4.2): for `1 < p < ∞` and `r ≥ 2` there is `C` such that for all
`ℓ, k ∈ ℤ` with `k + ℓ ≤ 1` and Schwartz `f`,
`‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ C 2^{ℓ+k} 2^{ℓα} ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.est2 {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω)
    (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {r : ℝ} (hr : 2 ≤ r) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ)), k + ℓ ≤ 1 →
      eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        C * ENNReal.ofReal ((2 : ℝ) ^ (((k : ℝ) + ℓ) + ℓ * α)) * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨CΩ, hC0, hC⟩ := hΩ.exists_bound
  obtain ⟨D, hD0, hd'⟩ := lp_schwartz_decay (lpPsi n) (n + 1) 1
  have hd : ∀ w, (1 + ‖w‖) ^ (n + 1) * ‖fderiv ℝ (lpPsi n) w‖ ≤ D := fun w => by
    rw [← norm_iteratedFDeriv_one]; exact hd' w
  obtain ⟨CM, hCM, hM⟩ := eLpNorm_sqrt_tsum_maximal_lpConv_le hn (lpPsiTilde n)
    (integral_lpPsiTilde n) hp
  obtain ⟨A, hA_def⟩ : ∃ A : ℝ≥0∞, A = ENNReal.ofReal (2 ^ (1 + 2 * α) * (5 ^ (n + 1) * D) *
      (4 ^ n * CΩ)) * bracketConst n * volume (Metric.ball (0 : Rn n) 1) := ⟨_, rfl⟩
  have hA : A ≠ ∞ := by
    rw [hA_def]
    exact ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (bracketConst_ne_top n))
      measure_ball_lt_top.ne
  refine ⟨A * CM, ENNReal.mul_ne_top hA hCM, fun ℓ k f hkl => ?_⟩
  have hr0 : 0 < r := by linarith
  obtain ⟨c, hc_def⟩ : ∃ c : ℝ≥0∞,
      c = ENNReal.ofReal ((2 : ℝ) ^ (((k : ℝ) + ℓ) + ℓ * α)) * A := ⟨_, rfl⟩
  have hc : c ≠ ∞ := by rw [hc_def]; exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hA
  obtain ⟨Mf, hMf⟩ : ∃ Mf : ℤ → Rn n → ℝ≥0∞,
      Mf = fun j x => lpMaximal (lpConv (lpPsiTilde n) (j + k) f) x := ⟨_, rfl⟩
  have hpt : ∀ x, shortPieceVar r n α Ω ℓ k f x ≤
      c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ) := by
    intro x
    have h1 : ∀ j : ℤ, variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ≤
        c * Mf j x := by
      intro j
      refine (hΩ.variationNorm_shortPiece_le_maximal_tilde hn hα hC0 hC hD0 hd (by linarith)
        ℓ k j hkl f x).trans (le_of_eq ?_)
      rw [ENNReal.ofReal_mul (by positivity), hc_def, hA_def, hMf]
      simp only [lpProjTilde]
      ring
    calc shortPieceVar r n α Ω ℓ k f x
        ≤ (∑' j : ℤ, (c * Mf j x) ^ r) ^ (1 / r) :=
          ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun j =>
            ENNReal.rpow_le_rpow (h1 j) hr0.le) (by positivity)
      _ = c * (∑' j : ℤ, Mf j x ^ r) ^ (1 / r) := by
          simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le]
          rw [ENNReal.tsum_mul_left, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
            rpow_rpow_one_div hr0.ne']
      _ ≤ c * (∑' j : ℤ, Mf j x ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) :=
          mul_le_mul' le_rfl (tsum_rpow_one_div_le (by norm_num) hr _)
      _ = c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ) := by
          simp_rw [ENNReal.rpow_two]
  have hGm : AEMeasurable (fun x => (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ)) := by
    refine (AEMeasurable.tsum fun j => ?_).pow_const _
    rw [hMf]
    simp only
    rw [← fsMaximal_eq_lpMaximal, fsMaximal_eq_hlMaximal]
    exact ((fs_measurable_maximal
      (lpConv (lpPsiTilde n) (j + k) f).continuous.aestronglyMeasurable).pow_const 2).aemeasurable
  calc eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p)
      ≤ eLpNorm (fun x => c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) :=
        eLpNorm_mono_enorm (g := fun x => c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ))
          (hΩ.measurable_shortPieceVar hα r ℓ k f).aestronglyMeasurable
          fun x => by simpa only [enorm_eq_self] using hpt x
    _ = c * eLpNorm (fun x => (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) :=
        eLpNorm_const_mul_ennreal hGm hc (show (0 : ℝ) < p by linarith)
    _ ≤ c * (CM * eLpNorm f (ENNReal.ofReal p)) := by
        rw [hMf]; exact mul_le_mul' le_rfl (hM k f)
    _ = A * CM * ENNReal.ofReal ((2 : ℝ) ^ (((k : ℝ) + ℓ) + ℓ * α)) *
          eLpNorm f (ENNReal.ofReal p) := by
        rw [hc_def]; ring

/-! ### Summing (`est1`) and (`est2`) over `ℓ ≤ -k/(2(α+1))` -/

/-- `∑_{m ∈ ℤ} 2^{-c|m|} < ∞` for `c > 0`. -/
theorem tsum_two_rpow_neg_abs_ne_top {c : ℝ} (hc : 0 < c) :
    ∑' m : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(m : ℝ)|))) ≠ ∞ := by
  set ρ : ℝ := (2 : ℝ) ^ (-c)
  have hρ0 : 0 ≤ ρ := by positivity
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have heq : ∀ m : ℤ, (2 : ℝ) ^ (-(c * |(m : ℝ)|)) = ρ ^ m.natAbs := by
    intro m
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    congr 1
    rw [Nat.cast_natAbs, Int.cast_abs]; ring
  have hs : Summable fun m : ℤ => ρ ^ m.natAbs := by
    refine Summable.of_nat_of_neg ?_ ?_
    · simpa using summable_geometric_of_lt_one hρ0 hρ1
    · simpa using summable_geometric_of_lt_one hρ0 hρ1
  simp_rw [heq]
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun m => by positivity) hs]
  exact ENNReal.ofReal_ne_top

/-- The double sum `∑_{ℓ, k} 2^{-c(|ℓ| + |k|)} < ∞`. -/
theorem tsum_tsum_two_rpow_neg_ne_top {c : ℝ} (hc : 0 < c) :
    ∑' ℓ : ℤ, ∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) ≠ ∞ := by
  have h : ∀ ℓ k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) =
      ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(ℓ : ℝ)|))) *
        ENNReal.ofReal ((2 : ℝ) ^ (-(c * |(k : ℝ)|))) := by
    intro ℓ k
    rw [← ENNReal.ofReal_mul (by positivity), ← Real.rpow_add two_pos]; ring_nf
  simp_rw [h, ENNReal.tsum_mul_left, ENNReal.tsum_mul_right]
  exact ENNReal.mul_ne_top (tsum_two_rpow_neg_abs_ne_top hc) (tsum_two_rpow_neg_abs_ne_top hc)

/-- The region `ℓ ≤ -k/(2(α+1))` of paper §4.2. -/
def smallRegion (α : ℝ) (ℓ k : ℤ) : Prop := 2 * (α + 1) * (ℓ : ℝ) ≤ -(k : ℝ)

/-- Decay in the region `ℓ ≤ -k/(2(α+1))`, `k ≥ 0`: `2^{ℓα} ≤ 2^{-c(|ℓ|+|k|)}`,
`c = α/(4(α+1))`. -/
theorem two_rpow_le_of_smallRegion_of_nonneg {α : ℝ} (hα : 0 < α) {ℓ k : ℤ}
    (h : smallRegion α ℓ k) (hk : 0 ≤ k) :
    (2 : ℝ) ^ ((ℓ : ℝ) * α) ≤
      (2 : ℝ) ^ (-(α / (4 * (α + 1)) * (|(ℓ : ℝ)| + |(k : ℝ)|))) := by
  refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
  have hk' : (0 : ℝ) ≤ k := by exact_mod_cast hk
  unfold smallRegion at h
  have hl : (ℓ : ℝ) ≤ 0 := by nlinarith
  rw [abs_of_nonpos hl, abs_of_nonneg hk']
  have h4 : 0 < 4 * (α + 1) := by linarith
  set a := α / (4 * (α + 1)) with ha_def
  have ha0 : 0 ≤ a := by positivity
  have hA : a * (2 * (α + 1)) = α / 2 := by rw [ha_def]; field_simp; ring
  have ha2 : a ≤ α / 2 := by
    rw [ha_def, div_le_div_iff₀ h4 (by norm_num)]; nlinarith
  have hak : a * k ≤ a * (-(2 * (α + 1) * ℓ)) := mul_le_mul_of_nonneg_left (by linarith) ha0
  have h5 : a * (-(2 * (α + 1) * ℓ)) = -(α / 2) * ℓ := by
    rw [show a * (-(2 * (α + 1) * ℓ)) = -(a * (2 * (α + 1))) * ℓ by ring, hA]
  have h6 : (α / 2 - a) * ℓ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (by linarith) hl
  nlinarith

/-- Decay in the region `ℓ ≤ -k/(2(α+1))`, `k ≤ 0`: `2^{k+ℓ+ℓα} ≤ 2^{-c(|ℓ|+|k|)}`. -/
theorem two_rpow_le_of_smallRegion_of_nonpos {α : ℝ} (hα : 0 < α) {ℓ k : ℤ}
    (h : smallRegion α ℓ k) (hk : k ≤ 0) :
    (2 : ℝ) ^ (((k : ℝ) + ℓ) + ℓ * α) ≤
      (2 : ℝ) ^ (-(α / (4 * (α + 1)) * (|(ℓ : ℝ)| + |(k : ℝ)|))) := by
  refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
  have hk' : (k : ℝ) ≤ 0 := by exact_mod_cast hk
  unfold smallRegion at h
  have h4 : 0 < 4 * (α + 1) := by linarith
  have hc : α / (4 * (α + 1)) ≤ 1 / 4 := by
    rw [div_le_iff₀ h4]; linarith
  have hc0 : 0 ≤ α / (4 * (α + 1)) := by positivity
  rw [abs_of_nonpos hk']
  rcases le_total 0 (ℓ : ℝ) with hl | hl
  · rw [abs_of_nonneg hl]
    have : (ℓ : ℝ) * (α + 1) ≤ -k / 2 := by nlinarith
    nlinarith
  · rw [abs_of_nonpos hl]
    nlinarith

/-- `k + ℓ ≤ 1` in the region `ℓ ≤ -k/(2(α+1))`, `k ≤ 0` (so (`est2`) applies). -/
theorem add_le_one_of_smallRegion {α : ℝ} (hα : 0 < α) {ℓ k : ℤ} (h : smallRegion α ℓ k)
    (hk : k ≤ 0) : k + ℓ ≤ 1 := by
  unfold smallRegion at h
  have hk' : (k : ℝ) ≤ 0 := by exact_mod_cast hk
  have : (k : ℝ) + ℓ ≤ 1 := by
    rcases le_total 0 (ℓ : ℝ) with hl | hl
    · nlinarith
    · linarith
  exact_mod_cast this

open Classical in
/-- The indicator `𝟙[ℓ ≤ -k/(2(α+1))]` as an element of `[0, ∞]`. -/
def smallRegionInd (α : ℝ) (ℓ k : ℤ) : ℝ≥0∞ := if smallRegion α ℓ k then 1 else 0

/-- **Sum of (`est1`) and (`est2`) over the region `ℓ ≤ -k/(2(α+1))`** (paper §4.2, end): for
`1 < p < ∞`, `r ≥ 2`,
`∑_{(ℓ, k) : ℓ ≤ -k/(2(α+1))} ‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ C ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.tsum_eLpNorm_shortPieceVar_smallRegion_le {n : ℕ}
    {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α)
    {r : ℝ} (hr : 2 ≤ r) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ f : 𝓢(Rn n, ℂ),
      ∑' ℓ : ℤ, ∑' k : ℤ, smallRegionInd α ℓ k *
        eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        C * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨C₁, hC₁, h₁⟩ := hΩ.est1 hn hα hr hp
  obtain ⟨C₂, hC₂, h₂⟩ := hΩ.est2 hn hα hr hp
  obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = α / (4 * (α + 1)) := ⟨_, rfl⟩
  have hc : 0 < c := by rw [hc_def]; positivity
  obtain ⟨S, hS⟩ : ∃ S : ℝ≥0∞,
      S = ∑' ℓ : ℤ, ∑' k : ℤ, ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) :=
    ⟨_, rfl⟩
  refine ⟨max C₁ C₂ * S, ENNReal.mul_ne_top (max_ne_top hC₁ hC₂)
    (by rw [hS]; exact tsum_tsum_two_rpow_neg_ne_top hc), fun f => ?_⟩
  have hterm : ∀ ℓ k : ℤ, smallRegionInd α ℓ k *
      eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
      max C₁ C₂ * eLpNorm f (ENNReal.ofReal p) *
        ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) := by
    intro ℓ k
    unfold smallRegionInd
    split_ifs with h
    · rw [one_mul]
      rcases le_total 0 k with hk | hk
      · have hb := two_rpow_le_of_smallRegion_of_nonneg hα h hk
        rw [← hc_def] at hb
        refine (h₁ ℓ k f).trans ?_
        rw [mul_right_comm (max C₁ C₂)]
        exact mul_le_mul' (mul_le_mul' (le_max_left _ _) (ENNReal.ofReal_le_ofReal hb)) le_rfl
      · have hb := two_rpow_le_of_smallRegion_of_nonpos hα h hk
        rw [← hc_def] at hb
        refine (h₂ ℓ k f (add_le_one_of_smallRegion hα h hk)).trans ?_
        rw [mul_right_comm (max C₁ C₂)]
        exact mul_le_mul' (mul_le_mul' (le_max_right _ _) (ENNReal.ofReal_le_ofReal hb)) le_rfl
    · rw [zero_mul]; exact zero_le
  refine (ENNReal.tsum_le_tsum fun ℓ => ENNReal.tsum_le_tsum fun k => hterm ℓ k).trans
    (le_of_eq ?_)
  simp_rw [ENNReal.tsum_mul_left]
  rw [hS, mul_right_comm]

/-! ## The single-scale kernels (paper §4.3–4.5, physical-space route) -/

/-- `0 ∉ tsupport φ_ℓ`. -/
theorem tsupport_dyadicPhiScale_subset (n : ℕ) (ℓ : ℤ) :
    tsupport (dyadicPhiScale n ℓ) ⊆ ({0}ᶜ : Set (Rn n)) := by
  intro t ht h0
  rw [mem_singleton_iff] at h0
  subst h0
  refine (notMem_tsupport_iff_eventuallyEq.2 ?_) ht
  filter_upwards [Metric.ball_mem_nhds (0 : Rn n) (zpow_pos two_pos (ℓ - 1))] with s hs
  exact dyadicPhiScale_eq_zero_of_le (mem_ball_zero_iff.1 hs).le

/-- The piece kernel `e^{iu|t|^α} φ_ℓ(t) K(t)` is smooth. -/
theorem IsHomogeneousCZKernel.contDiff_pieceKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α u : ℝ) (ℓ : ℤ) :
    ContDiff ℝ (⊤ : ℕ∞) (pieceKernel n α Ω u ℓ) := by
  have h1 : ContDiffOn ℝ (⊤ : ℕ∞)
      (fun t : Rn n => exp (I * u * ((‖t‖ ^ α : ℝ) : ℂ)) * ((czKernel n Ω t : ℝ) : ℂ))
      ({0}ᶜ : Set (Rn n)) := by
    intro t ht
    have ht' : t ≠ 0 := ht
    refine ContDiffWithinAt.mul ?_ ?_
    · refine (Complex.contDiff_exp.contDiffAt.comp t ?_).contDiffWithinAt
      refine contDiffAt_const.mul (ofRealCLM.contDiff.contDiffAt.comp t ?_)
      exact (contDiffAt_norm ℝ ht').rpow_const_of_ne (norm_ne_zero_iff.2 ht')
    · exact (ofRealCLM.contDiff.contDiffAt.comp_contDiffWithinAt t
        (hΩ.contDiffOn_czKernel t ht))
  have h2 : ContDiff ℝ (⊤ : ℕ∞) (fun t : Rn n => ((dyadicPhiScale n ℓ t : ℝ) : ℂ)) :=
    ofRealCLM.contDiff.comp (contDiff_dyadicPhiScale n ℓ)
  have h3 : tsupport (fun t : Rn n => ((dyadicPhiScale n ℓ t : ℝ) : ℂ)) ⊆ {0}ᶜ :=
    (tsupport_comp_subset (g := fun r : ℝ => (r : ℂ)) Complex.ofReal_zero
      (dyadicPhiScale n ℓ)).trans (tsupport_dyadicPhiScale_subset n ℓ)
  have := osc_contDiff_mul_of_tsupport isOpen_compl_singleton h1 h2 h3
  convert this using 1
  funext t
  simp only [pieceKernel]; push_cast; ring

/-- The piece kernel has compact support. -/
theorem hasCompactSupport_pieceKernel (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ) :
    HasCompactSupport (pieceKernel n α Ω u ℓ) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Rn n) ((2 : ℝ) ^ (ℓ + 1)))
    fun t ht => ?_
  have h : dyadicPhiScale n ℓ t = 0 := by
    by_contra h
    exact ht (by simpa using (dyadicPhiScale_ne_zero h).2.le)
  simp [pieceKernel, h]

/-- The piece kernel `e^{iu|t|^α} φ_ℓ(t) K(t)` as a Schwartz function. -/
def pieceSchwartz {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (α u : ℝ) (ℓ : ℤ) :
    𝓢(Rn n, ℂ) :=
  (hasCompactSupport_pieceKernel n α Ω u ℓ).toSchwartzMap (hΩ.contDiff_pieceKernel α u ℓ)

@[simp] theorem coe_pieceSchwartz {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω)
    (α u : ℝ) (ℓ : ℤ) : (pieceSchwartz hΩ α u ℓ : Rn n → ℂ) = pieceKernel n α Ω u ℓ := rfl

/-- **The single-scale (unit-scale) kernel** of paper §4.3–4.5:
`k_{ℓ,k}(x, v) = (P_k [e^{iv|·|^α} φ_ℓ K])(x) = ∫ ψ_k(x - t) e^{iv|t|^α} φ_ℓ(t) K(t) dt`,
`v ∈ U = [1, 2^α]`. By `modulatedPiece_eq_lpConv_unitKernel`, the operator
`g ↦ 𝓗^{(2^{jα} v)}_{ℓ-j} P_{j+k} g` is the convolution with `2^{jn} k_{ℓ,k}(2^j ·, v)`. -/
def unitKernel {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ)
    (v : ℝ) : 𝓢(Rn n, ℂ) :=
  lpProj n k (pieceSchwartz hΩ α v ℓ)

/-- Pointwise form of the single-scale kernel. -/
theorem unitKernel_apply {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ)
    (ℓ k : ℤ) (v : ℝ) (x : Rn n) :
    unitKernel hΩ α ℓ k v x = ∫ t, lpDilate n (lpPsi n) k (x - t) * pieceKernel n α Ω v ℓ t := by
  rw [unitKernel, lpProj, lpConv_apply, coe_pieceSchwartz]

/-- **Homogeneity of the pieces**: `e^{i 2^{jα} v |t|^α} φ_{ℓ-j}(t) K(t)` is the `L¹`-normalized
dilate `2^{jn} [e^{iv|·|^α} φ_ℓ K](2^j t)`. -/
theorem IsHomogeneousCZKernel.pieceKernel_dyadicPoint_mul {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α v : ℝ) (ℓ j : ℤ) :
    pieceKernel n α Ω (dyadicPoint α j * v) (ℓ - j) = lpDilate n (pieceKernel n α Ω v ℓ) j := by
  funext t
  have hc : 0 < (2 : ℝ) ^ j := zpow_pos two_pos j
  have h1 : ‖(2 : ℝ) ^ j • t‖ ^ α = dyadicPoint α j * ‖t‖ ^ α := by
    rw [norm_smul, Real.norm_of_nonneg hc.le, Real.mul_rpow hc.le (norm_nonneg _),
      dyadicPoint, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]
  have h2 : dyadicPhiScale n ℓ ((2 : ℝ) ^ j • t) = dyadicPhiScale n (ℓ - j) t := by
    simp only [dyadicPhiScale, smul_smul]
    congr 2
    rw [← zpow_add₀ two_ne_zero]; congr 1; ring
  have h3 : czKernel n Ω ((2 : ℝ) ^ j • t) = (((2 : ℝ) ^ j) ^ n)⁻¹ * czKernel n Ω t :=
    hΩ.czKernel_smul hc t
  have hpow : ((2 : ℝ) : ℂ) ^ (j * (n : ℤ)) = ((((2 : ℝ) ^ j) ^ n : ℝ) : ℂ) := by
    rw [← zpow_natCast, ← zpow_mul, Complex.ofReal_zpow]
  simp only [lpDilate, pieceKernel, h1, h2, h3, hpow]
  have hne : (((2 : ℝ) ^ j) ^ n : ℝ) ≠ 0 := by positivity
  push_cast
  field_simp

/-- `𝓕 k_{ℓ,k}(·, v)(ξ) = φ(2^{-k} ξ) 𝓕[e^{iv|·|^α} φ_ℓ K](ξ)`. -/
theorem fourier_unitKernel {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ)
    (ℓ k : ℤ) (v : ℝ) (ξ : Rn n) :
    𝓕 (unitKernel hΩ α ℓ k v : Rn n → ℂ) ξ =
      (dyadicPhi n (((2 : ℝ) ^ k)⁻¹ • ξ) : ℂ) * 𝓕 (pieceKernel n α Ω v ℓ) ξ := by
  rw [unitKernel, lpProj, fourier_lpConv, fourier_lpPsi, coe_pieceSchwartz]

/-- The pieces as Schwartz convolutions: `𝓗^{(u)}_m g = (e^{iu|·|^α} φ_m K) * g`. -/
theorem modulatedPiece_eq_convolution {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω)
    (α u : ℝ) (m : ℤ) (g : 𝓢(Rn n, ℂ)) (x : Rn n) :
    modulatedPiece n α Ω u m g x =
      SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (pieceSchwartz hΩ α u m) g x := by
  rw [SchwartzMap.convolution_apply, convolution_def, modulatedPiece_eq_pieceKernel]
  congr 1; funext t
  rw [coe_pieceSchwartz, ContinuousLinearMap.mul_apply', mul_comm]

/-- **The single-scale operators** (paper §4.3): for `u = 2^{jα} v`,
`𝓗^{(u)}_{ℓ-j} P_{j+k} f(x) = ∫ 2^{jn} k_{ℓ,k}(2^j (x - y), v) f(y) dy`. -/
theorem IsHomogeneousCZKernel.modulatedPiece_eq_lpConv_unitKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α v : ℝ) (ℓ k j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    modulatedPiece n α Ω (dyadicPoint α j * v) (ℓ - j) (lpProj n (j + k) f) x =
      ∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * f y := by
  rw [modulatedPiece_eq_convolution hΩ, ← lpConv_apply]
  congr 1
  refine schwartz_eq_of_fourier_eq fun ξ => ?_
  rw [← SchwartzMap.fourier_coe, SchwartzMap.fourier_convolution,
    SchwartzMap.pairing_apply_apply, ContinuousLinearMap.mul_apply', SchwartzMap.fourier_coe,
    SchwartzMap.fourier_coe, fourier_lpConv, fourier_unitKernel, coe_pieceSchwartz,
    hΩ.pieceKernel_dyadicPoint_mul, fourier_lpDilate, lpProj, fourier_lpConv, fourier_lpPsi]
  simp only
  rw [smul_smul, ← mul_inv, ← zpow_add₀ two_ne_zero]
  ring_nf

/-! ### `L¹`, tail and smoothness bounds of the single-scale kernels -/

/-- Scaling of Lebesgue integrals: `∫ F(2^k x) dx = 2^{-kn} ∫ F`. -/
theorem lintegral_comp_two_zpow_smul {n : ℕ} {F : Rn n → ℝ≥0∞} (hF : Measurable F) (k : ℤ) :
    ∫⁻ x, F ((2 : ℝ) ^ k • x) = ENNReal.ofReal ((((2 : ℝ) ^ k) ^ n)⁻¹) * ∫⁻ x, F x := by
  have hc : 0 < (2 : ℝ) ^ k := zpow_pos two_pos k
  have hmap := Measure.map_addHaar_smul (volume : Measure (Rn n)) hc.ne'
  rw [show (∫⁻ x : Rn n, F ((2 : ℝ) ^ k • x)) =
      ∫⁻ y, F y ∂(Measure.map ((2 : ℝ) ^ k • ·) volume)
      from (lintegral_map hF (measurable_const_smul _)).symm,
    hmap, lintegral_smul_measure, finrank_euclideanSpace_fin, smul_eq_mul,
    abs_of_pos (by positivity)]

/-- `‖ψ_k‖₁ = ‖ψ‖₁`. -/
theorem lintegral_enorm_lpDilate {n : ℕ} {ψ : Rn n → ℂ} (hψ : Measurable ψ) (k : ℤ) :
    ∫⁻ x, ‖lpDilate n ψ k x‖ₑ = ∫⁻ x, ‖ψ x‖ₑ := by
  have hc : 0 < (2 : ℝ) ^ k := zpow_pos two_pos k
  have hpow : ((2 : ℝ) : ℂ) ^ (k * (n : ℤ)) = ((((2 : ℝ) ^ k) ^ n : ℝ) : ℂ) := by
    rw [← zpow_natCast, ← zpow_mul, Complex.ofReal_zpow]
  simp only [lpDilate, hpow, enorm_mul]
  rw [lintegral_const_mul' _ _ (by simp), lintegral_comp_two_zpow_smul hψ.enorm, ← mul_assoc,
    ← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (by positivity),
    ← ENNReal.ofReal_mul (by positivity), mul_inv_cancel₀ (by positivity), ENNReal.ofReal_one,
    one_mul]

/-- `∫ |x| |ψ_k(x)| dx = 2^{-k} ∫ |x| |ψ(x)| dx`. -/
theorem lintegral_norm_mul_enorm_lpDilate {n : ℕ} {ψ : Rn n → ℂ} (hψ : Measurable ψ) (k : ℤ) :
    ∫⁻ x, ‖x‖ₑ * ‖lpDilate n ψ k x‖ₑ =
      ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) * ∫⁻ x, ‖x‖ₑ * ‖ψ x‖ₑ := by
  have hc : 0 < (2 : ℝ) ^ k := zpow_pos two_pos k
  have hpow : ((2 : ℝ) : ℂ) ^ (k * (n : ℤ)) = ((((2 : ℝ) ^ k) ^ n : ℝ) : ℂ) := by
    rw [← zpow_natCast, ← zpow_mul, Complex.ofReal_zpow]
  have hx : ∀ x : Rn n, ‖x‖ₑ = ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) * ‖(2 : ℝ) ^ k • x‖ₑ := by
    intro x
    rw [enorm_smul, ← ofReal_norm, ← ofReal_norm, Real.norm_of_nonneg hc.le, ← mul_assoc,
      ← ENNReal.ofReal_mul (by positivity), inv_mul_cancel₀ hc.ne', ENNReal.ofReal_one, one_mul]
  have hm : Measurable fun x : Rn n => ‖x‖ₑ * ‖ψ x‖ₑ := measurable_enorm.mul hψ.enorm
  have : ∀ x : Rn n, ‖x‖ₑ * ‖lpDilate n ψ k x‖ₑ =
      ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) * ENNReal.ofReal (((2 : ℝ) ^ k) ^ n) *
        (fun y => ‖y‖ₑ * ‖ψ y‖ₑ) ((2 : ℝ) ^ k • x) := by
    intro x
    simp only [lpDilate, hpow, enorm_mul]
    rw [hx x, ← ofReal_norm (((((2 : ℝ) ^ k) ^ n : ℝ) : ℂ)), Complex.norm_real,
      Real.norm_of_nonneg (by positivity)]
    ring
  rw [lintegral_congr this,
    lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top),
    lintegral_comp_two_zpow_smul hm, ← mul_assoc, mul_assoc (ENNReal.ofReal _),
    ← ENNReal.ofReal_mul (by positivity), mul_inv_cancel₀ (by positivity), ENNReal.ofReal_one,
    mul_one]

/-- The convolution `κ(x, v) = ∫ ψ_k(x - t) b_v(t) dt` of `ψ_k` with a family `b_v`. -/
def convKernel (n : ℕ) (k : ℤ) (b : ℝ → Rn n → ℂ) (x : Rn n) (v : ℝ) : ℂ :=
  ∫ t, lpDilate n (lpPsi n) k (x - t) * b v t

/-- The pointwise majorant `G(x) = ∫ |ψ_k(x - t)| β(t) dt` of `κ(x, v)` for `|b_v| ≤ β`. -/
theorem enorm_convKernel_le {n : ℕ} (k : ℤ) {b : ℝ → Rn n → ℂ} {β : Rn n → ℝ≥0∞}
    (hb : ∀ v t, ‖b v t‖ₑ ≤ β t) (x : Rn n) (v : ℝ) :
    ‖convKernel n k b x v‖ₑ ≤ ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t := by
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun t => ?_)
  rw [enorm_mul]; exact mul_le_mul' le_rfl (hb v t)

/-- The difference majorant: `|κ(x - y, v) - κ(x, v)| ≤ ∫ |ψ_k(x - y - t) - ψ_k(x - t)| β(t) dt`. -/
theorem enorm_convKernel_sub_le {n : ℕ} (k : ℤ) {b : ℝ → Rn n → ℂ} {β : Rn n → ℝ≥0∞}
    (hbi : ∀ v, Integrable (b v)) (hb : ∀ v t, ‖b v t‖ₑ ≤ β t) (x y : Rn n) (v : ℝ) :
    ‖convKernel n k b (x - y) v - convKernel n k b x v‖ₑ ≤
      ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - y - t) - lpDilate n (lpPsi n) k (x - t)‖ₑ * β t := by
  have hψb : ∀ z, ‖lpDilate n (lpPsi n) k z‖ ≤
      SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k) := fun z => by
    rw [← coe_schwartzDilate]; exact SchwartzMap.norm_le_seminorm ℝ _ z
  have hint : ∀ z, Integrable (fun t => lpDilate n (lpPsi n) k (z - t) * b v t) := fun z =>
    (hbi v).bdd_mul (((schwartzDilate (lpPsi n) k).continuous.comp
      (continuous_sub_left z)).aestronglyMeasurable.congr (ae_of_all _ fun w => by
        simp [coe_schwartzDilate])) (ae_of_all _ fun w => hψb _)
  rw [convKernel, convKernel, ← integral_sub (hint _) (hint _)]
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun t => ?_)
  rw [← sub_mul, enorm_mul]; exact mul_le_mul' le_rfl (hb v t)

/-- `∫ ∫ |ψ_k(x - t)| β(t) dt dx = ‖ψ‖₁ ∫ β`. -/
theorem lintegral_lintegral_lpDilate_mul {n : ℕ} (k : ℤ) {β : Rn n → ℝ≥0∞} (hβ : Measurable β) :
    ∫⁻ x, ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t =
      (∫⁻ z, ‖lpPsi n z‖ₑ) * ∫⁻ t, β t := by
  have hψm : Measurable (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous.measurable
  rw [lintegral_lintegral_swap ((hψm.comp measurable_sub).enorm.mul
    (hβ.comp measurable_snd)).aemeasurable]
  have hin : ∀ t : Rn n, ∫⁻ x, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t =
      (∫⁻ z, ‖lpDilate n (lpPsi n) k z‖ₑ) * β t := fun t => by
    rw [lintegral_mul_const (f := fun x => ‖lpDilate n (lpPsi n) k (x - t)‖ₑ) _
      (hψm.comp (measurable_sub_const t)).enorm,
      lintegral_sub_right_eq_self (fun z => ‖lpDilate n (lpPsi n) k z‖ₑ) t]
  rw [lintegral_congr hin, lintegral_enorm_lpDilate (lpPsi n).continuous.measurable,
    lintegral_const_mul _ hβ]

/-- The first moment: `∫ |x| ∫ |ψ_k(x - t)| β(t) dt dx ≤ 2^{-k} M₁(ψ) ∫ β + ‖ψ‖₁ ∫ |t| β(t)`. -/
theorem lintegral_norm_mul_lintegral_lpDilate_mul_le {n : ℕ} (k : ℤ) {β : Rn n → ℝ≥0∞}
    (hβ : Measurable β) :
    ∫⁻ x, ‖x‖ₑ * ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t ≤
      ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) * (∫⁻ z, ‖z‖ₑ * ‖lpPsi n z‖ₑ) * (∫⁻ t, β t) +
        (∫⁻ z, ‖lpPsi n z‖ₑ) * ∫⁻ t, ‖t‖ₑ * β t := by
  have hψm : Measurable (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous.measurable
  have hmeas1 : Measurable fun p : Rn n × Rn n =>
      ‖p.1 - p.2‖ₑ * ‖lpDilate n (lpPsi n) k (p.1 - p.2)‖ₑ * β p.2 :=
    ((measurable_sub.enorm).mul (hψm.comp measurable_sub).enorm).mul (hβ.comp measurable_snd)
  have hmeas2 : Measurable fun p : Rn n × Rn n =>
      ‖lpDilate n (lpPsi n) k (p.1 - p.2)‖ₑ * (‖p.2‖ₑ * β p.2) :=
    (hψm.comp measurable_sub).enorm.mul ((measurable_snd.enorm).mul (hβ.comp measurable_snd))
  have key : ∫⁻ x, ‖x‖ₑ * ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t ≤
      (∫⁻ x, ∫⁻ t, ‖x - t‖ₑ * ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t) +
        ∫⁻ x, ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * (‖t‖ₑ * β t) := by
    calc ∫⁻ x, ‖x‖ₑ * ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t
        = ∫⁻ x, ∫⁻ t, ‖x‖ₑ * (‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t) := by
          refine lintegral_congr fun x => ?_
          rw [lintegral_const_mul' _ _ enorm_ne_top]
      _ ≤ ∫⁻ x, ∫⁻ t, (‖x - t‖ₑ * ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t +
            ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * (‖t‖ₑ * β t)) := by
          refine lintegral_mono fun x => lintegral_mono fun t => ?_
          calc ‖x‖ₑ * (‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t)
              ≤ (‖x - t‖ₑ + ‖t‖ₑ) * (‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t) := by
                gcongr
                calc ‖x‖ₑ = ‖(x - t) + t‖ₑ := by rw [sub_add_cancel]
                  _ ≤ _ := enorm_add_le _ _
            _ = _ := by ring
      _ = _ := by
          have h1x : ∀ x : Rn n, Measurable fun t =>
              ‖x - t‖ₑ * ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t := fun x =>
            ((measurable_const.sub measurable_id).enorm.mul
              (hψm.comp (measurable_const.sub measurable_id)).enorm).mul hβ
          rw [lintegral_congr fun x => lintegral_add_left (h1x x) _]
          exact lintegral_add_left (hmeas1.lintegral_prod_right' (ν := volume)) _
  have hin : ∀ t : Rn n,
      ∫⁻ x, ‖x - t‖ₑ * ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t =
      (∫⁻ z, ‖z‖ₑ * ‖lpDilate n (lpPsi n) k z‖ₑ) * β t := fun t => by
    rw [lintegral_mul_const
      (f := fun x => ‖x - t‖ₑ * ‖lpDilate n (lpPsi n) k (x - t)‖ₑ) _
      ((measurable_sub_const t).enorm.mul (hψm.comp (measurable_sub_const t)).enorm),
      lintegral_sub_right_eq_self (fun z => ‖z‖ₑ * ‖lpDilate n (lpPsi n) k z‖ₑ) t]
  have hM1 : ∫⁻ z, ‖z‖ₑ * ‖lpPsi n z‖ₑ ≠ ∞ := by
    have hi := (lpPsi n).integrable_pow_mul volume 1
    refine ne_of_lt (lt_of_le_of_lt (le_of_eq ?_) hi.2)
    refine lintegral_congr fun z => ?_
    simp only [pow_one, enorm_mul, enorm_norm]
  have e1 : (∫⁻ x, ∫⁻ t, ‖x - t‖ₑ * ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t) =
      ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) * (∫⁻ z, ‖z‖ₑ * ‖lpPsi n z‖ₑ) * ∫⁻ t, β t := by
    rw [lintegral_lintegral_swap hmeas1.aemeasurable, lintegral_congr hin,
      lintegral_norm_mul_enorm_lpDilate (lpPsi n).continuous.measurable,
      lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hM1)]
  have e2 : (∫⁻ x, ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * (‖t‖ₑ * β t)) =
      (∫⁻ z, ‖lpPsi n z‖ₑ) * ∫⁻ t, ‖t‖ₑ * β t :=
    lintegral_lintegral_lpDilate_mul (β := fun t => ‖t‖ₑ * β t) k (measurable_enorm.mul hβ)
  rw [e1, e2] at key
  exact key

/-- `∫ |ψ_k(z - y) - ψ_k(z)| dz = ∫ |ψ(w - 2^k y) - ψ(w)| dw`. -/
theorem lintegral_enorm_lpDilate_sub {n : ℕ} (k : ℤ) (y : Rn n) :
    ∫⁻ z, ‖lpDilate n (lpPsi n) k (z - y) - lpDilate n (lpPsi n) k z‖ₑ =
      ∫⁻ w, ‖lpPsi n (w - (2 : ℝ) ^ k • y) - lpPsi n w‖ₑ := by
  have hc : 0 < (2 : ℝ) ^ k := zpow_pos two_pos k
  have hpow : ((2 : ℝ) : ℂ) ^ (k * (n : ℤ)) = ((((2 : ℝ) ^ k) ^ n : ℝ) : ℂ) := by
    rw [← zpow_natCast, ← zpow_mul, Complex.ofReal_zpow]
  have hF : Measurable fun w : Rn n => ‖lpPsi n (w - (2 : ℝ) ^ k • y) - lpPsi n w‖ₑ :=
    ((lpPsi n).continuous.measurable.comp (measurable_id.sub measurable_const)).sub
      (lpPsi n).continuous.measurable |>.enorm
  have : ∀ z : Rn n, ‖lpDilate n (lpPsi n) k (z - y) - lpDilate n (lpPsi n) k z‖ₑ =
      ENNReal.ofReal (((2 : ℝ) ^ k) ^ n) *
        (fun w => ‖lpPsi n (w - (2 : ℝ) ^ k • y) - lpPsi n w‖ₑ) ((2 : ℝ) ^ k • z) := by
    intro z
    simp only [lpDilate, hpow, smul_sub, ← mul_sub, enorm_mul]
    rw [← ofReal_norm (((((2 : ℝ) ^ k) ^ n : ℝ) : ℂ)), Complex.norm_real,
      Real.norm_of_nonneg (by positivity)]
  rw [lintegral_congr this, lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    lintegral_comp_two_zpow_smul hF, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
    mul_inv_cancel₀ (by positivity), ENNReal.ofReal_one, one_mul]

/-- The `L¹` constant of `ψ`. -/
def psiL1 (n : ℕ) : ℝ≥0∞ := ∫⁻ z, ‖lpPsi n z‖ₑ

/-- `‖ψ‖₁ < ∞`. -/
theorem psiL1_ne_top (n : ℕ) : psiL1 n ≠ ∞ := (lpPsi n).integrable.2.ne

/-- `L¹` continuity of translations of `ψ`: `∫ |ψ(w - y) - ψ(w)| dw ≤ L_ψ |y|`, with
`L_ψ = 5^{n+1} D A_n + ‖ψ‖₁`. -/
theorem lintegral_enorm_lpPsi_sub_le {n : ℕ} {D : ℝ}
    (hd : ∀ w, (1 + ‖w‖) ^ (n + 1) * ‖fderiv ℝ (lpPsi n) w‖ ≤ D) (y : Rn n) :
    ∫⁻ w, ‖lpPsi n (w - y) - lpPsi n w‖ₑ ≤
      (ENNReal.ofReal (5 ^ (n + 1) * D) * bracketConst n + psiL1 n) * ENNReal.ofReal ‖y‖ := by
  by_cases hy : ‖y‖ ≤ 4
  · calc ∫⁻ w, ‖lpPsi n (w - y) - lpPsi n w‖ₑ
        ≤ ∫⁻ w, ENNReal.ofReal (5 ^ (n + 1) * D * ‖y‖) *
            ENNReal.ofReal (1 / (1 + ‖w‖) ^ (n + 1)) := by
          refine lintegral_mono fun w => ?_
          rw [← ENNReal.ofReal_mul (by
              have := (mul_nonneg (by positivity) (norm_nonneg _)).trans (hd 0)
              positivity), ← ofReal_norm]
          refine ENNReal.ofReal_le_ofReal ((norm_sub_le_of_decay_of_le_four
            (lpPsi n).differentiable hd hy).trans (le_of_eq ?_))
          ring
      _ = ENNReal.ofReal (5 ^ (n + 1) * D * ‖y‖) * bracketConst n := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, bracketConst]
      _ ≤ _ := by
          have hD : 0 ≤ D := (mul_nonneg (by positivity) (norm_nonneg _)).trans (hd 0)
          rw [ENNReal.ofReal_mul (by positivity), add_mul]
          refine le_add_right (le_of_eq ?_)
          ring
  · have hy4 : 4 < ‖y‖ := not_le.1 hy
    calc ∫⁻ w, ‖lpPsi n (w - y) - lpPsi n w‖ₑ
        ≤ ∫⁻ w, (‖lpPsi n (w - y)‖ₑ + ‖lpPsi n w‖ₑ) :=
          lintegral_mono fun w => enorm_sub_le
      _ = psiL1 n + psiL1 n := by
          rw [lintegral_add_left (f := fun w => ‖lpPsi n (w - y)‖ₑ)
            ((lpPsi n).continuous.comp (continuous_sub_right y)).measurable.enorm,
            lintegral_sub_right_eq_self (fun w => ‖lpPsi n w‖ₑ), psiL1]
      _ = psiL1 n * 2 := by ring
      _ ≤ psiL1 n * ENNReal.ofReal ‖y‖ :=
          mul_le_mul' le_rfl ((ENNReal.ofReal_ofNat 2).symm.le.trans
            (ENNReal.ofReal_le_ofReal (by linarith)))
      _ ≤ _ := mul_le_mul' le_add_self le_rfl

/-- The parameter interval `U = [1, 2^α]` of `v` (so that `u = 2^{jα} v ∈ J_j`). -/
def paramU (α : ℝ) : Set ℝ := Icc 1 ((2 : ℝ) ^ α)

/-- The `L²(U)` norm `‖F‖_{L²_U} = (∫_U |F(v)|² dv)^{1/2}` (the norm `sgrUNorm` of the vector-valued
Seeger theorem with `ν = Lebesgue on U`). -/
def uNorm (α : ℝ) (F : ℝ → ℂ) : ℝ≥0∞ := (∫⁻ v in paramU α, ‖F v‖ₑ ^ 2) ^ (1 / 2 : ℝ)

/-- `|U|^{1/2}`. -/
def uVolSqrt (α : ℝ) : ℝ≥0∞ := volume (paramU α) ^ (1 / 2 : ℝ)

/-- `|U|^{1/2} < ∞`. -/
theorem uVolSqrt_ne_top (α : ℝ) : uVolSqrt α ≠ ∞ := by
  unfold uVolSqrt paramU
  rw [Real.volume_Icc]
  exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top

/-- A pointwise bound `|F(v)| ≤ G` on `U` gives `‖F‖_{L²_U} ≤ |U|^{1/2} G`. -/
theorem uNorm_le_of_le {α : ℝ} {F : ℝ → ℂ} {G : ℝ≥0∞} (h : ∀ v, ‖F v‖ₑ ≤ G) :
    uNorm α F ≤ uVolSqrt α * G := by
  unfold uNorm uVolSqrt
  calc (∫⁻ v in paramU α, ‖F v‖ₑ ^ 2) ^ (1 / 2 : ℝ)
      ≤ (∫⁻ _ in paramU α, G ^ 2) ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_le_rpow (lintegral_mono fun v => pow_le_pow_left₀ zero_le (h v) 2)
          (by norm_num)
    _ = volume (paramU α) ^ (1 / 2 : ℝ) * G := by
        rw [setLIntegral_const, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), mul_comm,
          ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
        norm_num

/-- Generic `L¹(L²_U)` bound: `∫ ‖κ(x, ·)‖_{L²_U} dx ≤ |U|^{1/2} ‖ψ‖₁ ∫ β`. -/
theorem lintegral_uNorm_convKernel_le {n : ℕ} (α : ℝ) (k : ℤ) {b : ℝ → Rn n → ℂ}
    {β : Rn n → ℝ≥0∞} (hβ : Measurable β) (hb : ∀ v t, ‖b v t‖ₑ ≤ β t) :
    ∫⁻ x, uNorm α (fun v => convKernel n k b x v) ≤ uVolSqrt α * psiL1 n * (∫⁻ t, β t) := by
  calc ∫⁻ x, uNorm α (fun v => convKernel n k b x v)
      ≤ ∫⁻ x, uVolSqrt α * ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t :=
        lintegral_mono fun x => uNorm_le_of_le fun v => enorm_convKernel_le k hb x v
    _ = uVolSqrt α * psiL1 n * (∫⁻ t, β t) := by
        rw [lintegral_const_mul' _ _ (uVolSqrt_ne_top α), lintegral_lintegral_lpDilate_mul k hβ,
          psiL1, mul_assoc]

/-- Generic tail bound: `∫_{|x| > R} ‖κ(x, ·)‖_{L²_U} dx ≤ |U|^{1/2} R⁻¹ (2^{-k} M₁(ψ) ∫ β +
‖ψ‖₁ ∫ |t| β)`. -/
theorem setLIntegral_uNorm_convKernel_le {n : ℕ} (α : ℝ) (k : ℤ) {b : ℝ → Rn n → ℂ}
    {β : Rn n → ℝ≥0∞} (hβ : Measurable β) (hb : ∀ v t, ‖b v t‖ₑ ≤ β t) {R : ℝ} (hR : 0 < R) :
    ∫⁻ x in {x : Rn n | R < ‖x‖}, uNorm α (fun v => convKernel n k b x v) ≤
      uVolSqrt α * ENNReal.ofReal R⁻¹ *
        (ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) * (∫⁻ z, ‖z‖ₑ * ‖lpPsi n z‖ₑ) * (∫⁻ t, β t) +
          psiL1 n * ∫⁻ t, ‖t‖ₑ * β t) := by
  have hmeasS : MeasurableSet {x : Rn n | R < ‖x‖} :=
    measurableSet_lt measurable_const measurable_norm
  calc ∫⁻ x in {x : Rn n | R < ‖x‖}, uNorm α (fun v => convKernel n k b x v)
      ≤ ∫⁻ x in {x : Rn n | R < ‖x‖}, uVolSqrt α *
          ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t :=
        setLIntegral_mono' hmeasS fun x _ => uNorm_le_of_le fun v => enorm_convKernel_le k hb x v
    _ ≤ ∫⁻ x, uVolSqrt α * (ENNReal.ofReal R⁻¹ *
          (‖x‖ₑ * ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t)) := by
        rw [← lintegral_indicator hmeasS]
        refine lintegral_mono fun x => ?_
        by_cases hx : x ∈ {x : Rn n | R < ‖x‖}
        · rw [indicator_of_mem hx]
          refine mul_le_mul' le_rfl ?_
          rw [← mul_assoc]
          refine le_mul_of_one_le_left zero_le ?_
          rw [← ofReal_norm, ← ENNReal.ofReal_mul (by positivity)]
          refine ENNReal.one_le_ofReal.2 ?_
          rw [inv_mul_eq_div, le_div_iff₀ hR, one_mul]
          exact le_of_lt hx
        · rw [indicator_of_notMem hx]; exact zero_le
    _ = uVolSqrt α * ENNReal.ofReal R⁻¹ *
          ∫⁻ x, ‖x‖ₑ * ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - t)‖ₑ * β t := by
        rw [lintegral_const_mul' _ _ (uVolSqrt_ne_top α),
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, mul_assoc]
    _ ≤ _ := mul_le_mul' le_rfl (lintegral_norm_mul_lintegral_lpDilate_mul_le k hβ)

/-- Generic smoothness bound:
`∫ ‖κ(x - y, ·) - κ(x, ·)‖_{L²_U} dx ≤ |U|^{1/2} (∫ β) L_ψ 2^k |y|`. -/
theorem lintegral_uNorm_convKernel_sub_le {n : ℕ} (α : ℝ) (k : ℤ) {b : ℝ → Rn n → ℂ}
    {β : Rn n → ℝ≥0∞} (hβ : Measurable β) (hbi : ∀ v, Integrable (b v))
    (hb : ∀ v t, ‖b v t‖ₑ ≤ β t) {D : ℝ}
    (hd : ∀ w, (1 + ‖w‖) ^ (n + 1) * ‖fderiv ℝ (lpPsi n) w‖ ≤ D) (y : Rn n) :
    ∫⁻ x, uNorm α (fun v => convKernel n k b (x - y) v - convKernel n k b x v) ≤
      uVolSqrt α * (∫⁻ t, β t) *
        ((ENNReal.ofReal (5 ^ (n + 1) * D) * bracketConst n + psiL1 n) *
          ENNReal.ofReal ((2 : ℝ) ^ k * ‖y‖)) := by
  have hψm : Measurable (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous.measurable
  have hm : Measurable fun p : Rn n × Rn n =>
      ‖lpDilate n (lpPsi n) k (p.1 - y - p.2) - lpDilate n (lpPsi n) k (p.1 - p.2)‖ₑ * β p.2 :=
    (((hψm.comp ((measurable_fst.sub measurable_const).sub measurable_snd)).sub
      (hψm.comp measurable_sub)).enorm).mul (hβ.comp measurable_snd)
  have hin : ∀ t : Rn n, ∫⁻ x, ‖lpDilate n (lpPsi n) k (x - y - t) -
      lpDilate n (lpPsi n) k (x - t)‖ₑ * β t =
      (∫⁻ z, ‖lpDilate n (lpPsi n) k (z - y) - lpDilate n (lpPsi n) k z‖ₑ) * β t := fun t => by
    have hf : Measurable fun z : Rn n =>
        ‖lpDilate n (lpPsi n) k (z - y) - lpDilate n (lpPsi n) k z‖ₑ :=
      ((hψm.comp (measurable_sub_const y)).sub hψm).enorm
    have : (fun x : Rn n => ‖lpDilate n (lpPsi n) k (x - y - t) -
        lpDilate n (lpPsi n) k (x - t)‖ₑ) =
        fun x => (fun z => ‖lpDilate n (lpPsi n) k (z - y) - lpDilate n (lpPsi n) k z‖ₑ)
          (x - t) := by
      funext x; simp only [sub_right_comm]
    rw [lintegral_mul_const (f := fun x => ‖lpDilate n (lpPsi n) k (x - y - t) -
        lpDilate n (lpPsi n) k (x - t)‖ₑ) _ (by rw [this]; exact hf.comp (measurable_sub_const t)),
      this, lintegral_sub_right_eq_self (fun z =>
        ‖lpDilate n (lpPsi n) k (z - y) - lpDilate n (lpPsi n) k z‖ₑ) t]
  calc ∫⁻ x, uNorm α (fun v => convKernel n k b (x - y) v - convKernel n k b x v)
      ≤ ∫⁻ x, uVolSqrt α * ∫⁻ t, ‖lpDilate n (lpPsi n) k (x - y - t) -
          lpDilate n (lpPsi n) k (x - t)‖ₑ * β t :=
        lintegral_mono fun x => uNorm_le_of_le fun v => enorm_convKernel_sub_le k hbi hb x y v
    _ = uVolSqrt α * ((∫⁻ z, ‖lpDilate n (lpPsi n) k (z - y) -
          lpDilate n (lpPsi n) k z‖ₑ) * ∫⁻ t, β t) := by
        rw [lintegral_const_mul' _ _ (uVolSqrt_ne_top α), lintegral_lintegral_swap hm.aemeasurable,
          lintegral_congr hin, lintegral_const_mul _ hβ]
    _ ≤ _ := by
        rw [lintegral_enorm_lpDilate_sub, mul_comm (∫⁻ _, _), ← mul_assoc]
        refine mul_le_mul' le_rfl ((lintegral_enorm_lpPsi_sub_le hd _).trans (le_of_eq ?_))
        rw [norm_smul, Real.norm_of_nonneg (zpow_pos two_pos k).le]

/-- The `v`-derivative of the piece kernel: `∂_v [e^{iv|t|^α} φ_ℓ(t) K(t)] =
i|t|^α e^{iv|t|^α} φ_ℓ(t) K(t)`. -/
def pieceKernelD (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ) (t : Rn n) : ℂ :=
  (I * ((‖t‖ ^ α : ℝ) : ℂ)) * pieceKernel n α Ω u ℓ t

/-- The `v`-derivative kernel `∂_v k_{ℓ,k}(x, v) = ∫ ψ_k(x - t) i|t|^α e^{iv|t|^α} φ_ℓ(t) K(t) dt`
(paper §4.4: the derivative of the single-scale operators, with an extra factor `≈ 2^{ℓα}`). -/
def unitKernelD (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (ℓ k : ℤ) (x : Rn n) (v : ℝ) : ℂ :=
  convKernel n k (fun v => pieceKernelD n α Ω v ℓ) x v

/-- The single-scale kernel is the convolution kernel `convKernel` of the pieces. -/
theorem unitKernel_eq_convKernel {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω)
    (α : ℝ) (ℓ k : ℤ) (x : Rn n) (v : ℝ) :
    unitKernel hΩ α ℓ k v x = convKernel n k (fun v => pieceKernel n α Ω v ℓ) x v :=
  unitKernel_apply hΩ α ℓ k v x

/-- `∫ |φ_ℓ K| ≤ 4^n C |B₁|` (uniformly in `ℓ`). -/
theorem lintegral_abs_dyadicPhiScale_mul_czKernel_le {n : ℕ} {Ω : Rn n → ℝ} {C : ℝ}
    (hC0 : 0 ≤ C) (hC : ∀ t, |Ω t| ≤ C) {α : ℝ} (hα : 0 ≤ α) (ℓ : ℤ) :
    ∫⁻ t, ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t|) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) * (4 ^ n * C)) *
        volume (Metric.ball (0 : Rn n) 1) := by
  calc ∫⁻ t, ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t|)
      ≤ ∫⁻ t, (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (ℓ + 1))).indicator
          (fun _ => ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) * pieceSup n C ℓ)) t := by
        refine lintegral_mono fun t => ?_
        have := rpow_mul_abs_dyadicPhiScale_mul_czKernel_le hC0 hC hα ℓ t
        by_cases ht : t ∈ Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (ℓ + 1))
        · rw [indicator_of_mem ht] at this ⊢; exact ENNReal.ofReal_le_ofReal this
        · rw [indicator_of_notMem ht] at this ⊢
          rw [le_antisymm this (by positivity), ENNReal.ofReal_zero]
    _ = _ := by
        rw [lintegral_indicator_const Metric.isClosed_closedBall.measurableSet,
          ENNReal.ofReal_mul (by positivity), mul_assoc, volume_closedBall_mul_pieceSup n hC0 ℓ,
          ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]

/-- The first moment: `∫ |t| |t|^α |φ_ℓ K| ≤ 2^{ℓ+1} 2^{(ℓ+1)α} 4^n C |B₁|`. -/
theorem lintegral_norm_mul_abs_dyadicPhiScale_mul_czKernel_le {n : ℕ} {Ω : Rn n → ℝ} {C : ℝ}
    (hC0 : 0 ≤ C) (hC : ∀ t, |Ω t| ≤ C) {α : ℝ} (hα : 0 ≤ α) (ℓ : ℤ) :
    ∫⁻ t, ‖t‖ₑ * ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t|) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (ℓ + 1)) *
        (ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) * (4 ^ n * C)) *
          volume (Metric.ball (0 : Rn n) 1)) := by
  have hpt : ∀ t : Rn n, ‖t‖ₑ * ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n ℓ t *
      czKernel n Ω t|) ≤ ENNReal.ofReal ((2 : ℝ) ^ (ℓ + 1)) *
        ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t|) := by
    intro t
    by_cases h : dyadicPhiScale n ℓ t = 0
    · simp [h]
    · refine mul_le_mul' ?_ le_rfl
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (dyadicPhiScale_ne_zero h).2.le
  refine (lintegral_mono hpt).trans ?_
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  exact mul_le_mul' le_rfl (lintegral_abs_dyadicPhiScale_mul_czKernel_le hC0 hC hα ℓ)

/-- `|∂_v pieces| = |t|^α |φ_ℓ K|` (extended norm form). -/
theorem norm_pieceKernelD (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ) (t : Rn n) :
    ‖pieceKernelD n α Ω u ℓ t‖ₑ =
      ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t|) := by
  rw [pieceKernelD, enorm_mul, enorm_mul, ← ofReal_norm, ← ofReal_norm, ← ofReal_norm,
    norm_pieceKernel, Complex.norm_I, Complex.norm_real, Real.norm_of_nonneg (by positivity),
    Real.norm_eq_abs, ENNReal.ofReal_one, one_mul, ← ENNReal.ofReal_mul (by positivity)]

/-- `|pieces| = |φ_ℓ K|` (extended norm form, exponent `0`). -/
theorem enorm_pieceKernel_eq (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ) (t : Rn n) :
    ‖pieceKernel n α Ω u ℓ t‖ₑ =
      ENNReal.ofReal (‖t‖ ^ (0 : ℝ) * |dyadicPhiScale n ℓ t * czKernel n Ω t|) := by
  rw [Real.rpow_zero, one_mul, ← ofReal_norm, norm_pieceKernel, Real.norm_eq_abs]

/-- The derivative pieces are integrable. -/
theorem IsHomogeneousCZKernel.integrable_pieceKernelD {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α u : ℝ) (ℓ : ℤ) :
    Integrable (pieceKernelD n α Ω u ℓ) := by
  have hc : Continuous (pieceKernelD n α Ω u ℓ) := by
    have h1 : ContinuousOn (fun t : Rn n => I * ((‖t‖ ^ α : ℝ) : ℂ)) ({0}ᶜ : Set (Rn n)) := by
      intro t ht
      have ht' : t ≠ 0 := ht
      refine (continuous_const.continuousAt.mul (Complex.continuous_ofReal.continuousAt.comp
        ?_)).continuousWithinAt
      exact (continuous_norm.continuousAt).rpow_const (Or.inl (norm_ne_zero_iff.2 ht'))
    have h2 : tsupport (pieceKernel n α Ω u ℓ) ⊆ ({0}ᶜ : Set (Rn n)) := by
      refine (tsupport_mul_subset_right (f := fun t => exp (I * u * ((‖t‖ ^ α : ℝ) : ℂ)))
        (g := fun t => ((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ))).trans ?_
      refine (closure_mono fun t ht => ?_).trans (tsupport_dyadicPhiScale_subset n ℓ)
      by_contra h
      exact ht (by simp [Function.notMem_support.1 h])
    exact osc_continuous_mul_of_tsupport isOpen_compl_singleton h1
      (hΩ.contDiff_pieceKernel α u ℓ).continuous h2
  exact hc.integrable_of_hasCompactSupport ((hasCompactSupport_pieceKernel n α Ω u ℓ).mul_left)

/-- **`L¹(L²_U)`, tail and smoothness bounds of the single-scale kernels** (hypotheses `A₁` and
`B` of the vector-valued Seeger theorem; paper §4.4, `prop:Seeger88`). There are constants
`A, B < ∞` (depending on `n, α, Ω`) such that for all `ℓ, k ∈ ℤ`, with `K = k_{ℓ,k}`:
* `∫ ‖K(x, ·)‖_{L²_U} dx ≤ A`;
* `∫_{|x| > R} ‖K(x, ·)‖_{L²_U} dx ≤ B (2^{-k} + 2^{ℓ+1}) / R` for `R > 0`;
* `∫ ‖K(x - y, ·) - K(x, ·)‖_{L²_U} dx ≤ B 2^k |y|`;
and the same for the `v`-derivative kernel `∂_v k_{ℓ,k}` with the extra factor `2^{(ℓ+1)α}`. -/
theorem IsHomogeneousCZKernel.unitKernel_bounds {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 ≤ α) :
    ∃ A B : ℝ≥0∞, A ≠ ∞ ∧ B ≠ ∞ ∧ ∀ ℓ k : ℤ, ∀ a : ℝ, a = 0 ∨ a = α →
      ∀ b : ℝ → Rn n → ℂ, (∀ v t, ‖b v t‖ₑ =
        ENNReal.ofReal (‖t‖ ^ a * |dyadicPhiScale n ℓ t * czKernel n Ω t|)) →
      (∀ v, Integrable (b v)) →
      ∫⁻ x, uNorm α (fun v => convKernel n k b x v) ≤
          A * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) ∧
        (∀ R : ℝ, 0 < R → ∫⁻ x in {x : Rn n | R < ‖x‖}, uNorm α (fun v => convKernel n k b x v) ≤
          B * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) *
            ENNReal.ofReal ((((2 : ℝ) ^ k)⁻¹ + (2 : ℝ) ^ (ℓ + 1)) * R⁻¹)) ∧
        ∀ y : Rn n, ∫⁻ x, uNorm α (fun v => convKernel n k b (x - y) v - convKernel n k b x v) ≤
          B * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) *
            ENNReal.ofReal ((2 : ℝ) ^ k * ‖y‖) := by
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound
  obtain ⟨D, -, hd'⟩ := lp_schwartz_decay (lpPsi n) (n + 1) 1
  have hd : ∀ w, (1 + ‖w‖) ^ (n + 1) * ‖fderiv ℝ (lpPsi n) w‖ ≤ D := fun w => by
    rw [← norm_iteratedFDeriv_one]; exact hd' w
  have hM1 : ∫⁻ z, ‖z‖ₑ * ‖lpPsi n z‖ₑ ≠ ∞ := by
    have hi := (lpPsi n).integrable_pow_mul volume 1
    refine ne_of_lt (lt_of_le_of_lt (le_of_eq ?_) hi.2)
    refine lintegral_congr fun z => ?_
    simp only [pow_one, enorm_mul, enorm_norm]
  set V := ENNReal.ofReal (4 ^ n * C) * volume (Metric.ball (0 : Rn n) 1) with hV
  have hVt : V ≠ ∞ := ENNReal.mul_ne_top ENNReal.ofReal_ne_top measure_ball_lt_top.ne
  set L := ENNReal.ofReal (5 ^ (n + 1) * D) * bracketConst n + psiL1 n
  have hL : L ≠ ∞ := ENNReal.add_ne_top.2 ⟨ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (bracketConst_ne_top n), psiL1_ne_top n⟩
  refine ⟨uVolSqrt α * psiL1 n * V,
    uVolSqrt α * V * (max (∫⁻ z, ‖z‖ₑ * ‖lpPsi n z‖ₑ) (psiL1 n) + L),
    ENNReal.mul_ne_top (ENNReal.mul_ne_top (uVolSqrt_ne_top α) (psiL1_ne_top n)) hVt,
    ENNReal.mul_ne_top (ENNReal.mul_ne_top (uVolSqrt_ne_top α) hVt)
      (ENNReal.add_ne_top.2 ⟨max_ne_top hM1 (psiL1_ne_top n), hL⟩), ?_⟩
  intro ℓ k a ha b hb hbi
  have ha0 : 0 ≤ a := by rcases ha with rfl | rfl <;> linarith
  set β : Rn n → ℝ≥0∞ := fun t => ENNReal.ofReal (‖t‖ ^ a * |dyadicPhiScale n ℓ t *
    czKernel n Ω t|)
  have hβm : Measurable β :=
    ((measurable_norm.pow_const _).mul
      ((measurable_dyadicPhiScale n ℓ).mul hΩ.measurable_czKernel).abs).ennreal_ofReal
  have hb' : ∀ v t, ‖b v t‖ₑ ≤ β t := fun v t => (hb v t).le
  have hI := lintegral_abs_dyadicPhiScale_mul_czKernel_le hC0 hC ha0 ℓ
  have hI' := lintegral_norm_mul_abs_dyadicPhiScale_mul_czKernel_le hC0 hC ha0 ℓ
  have hIV : ∫⁻ t, β t ≤ ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) * V := by
    refine hI.trans (le_of_eq ?_)
    rw [ENNReal.ofReal_mul (by positivity), hV]; ring
  have hIV' : ∫⁻ t, ‖t‖ₑ * β t ≤
      ENNReal.ofReal ((2 : ℝ) ^ (ℓ + 1)) *
        (ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) * V) := by
    refine hI'.trans (le_of_eq ?_)
    rw [ENNReal.ofReal_mul (p := (2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) (by positivity), hV]; ring
  refine ⟨?_, fun R hR => ?_, fun y => ?_⟩
  · refine (lintegral_uNorm_convKernel_le α k hβm hb').trans ?_
    calc uVolSqrt α * psiL1 n * ∫⁻ t, β t
        ≤ uVolSqrt α * psiL1 n * (ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) * V) :=
          mul_le_mul' le_rfl hIV
      _ = _ := by ring
  · refine (setLIntegral_uNorm_convKernel_le α k hβm hb' hR).trans ?_
    set E := ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) * V
    set M := max (∫⁻ z, ‖z‖ₑ * ‖lpPsi n z‖ₑ) (psiL1 n)
    calc uVolSqrt α * ENNReal.ofReal R⁻¹ *
          (ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) * (∫⁻ z, ‖z‖ₑ * ‖lpPsi n z‖ₑ) * (∫⁻ t, β t) +
            psiL1 n * ∫⁻ t, ‖t‖ₑ * β t)
        ≤ uVolSqrt α * ENNReal.ofReal R⁻¹ *
          (ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹) * M * E +
            M * (ENNReal.ofReal ((2 : ℝ) ^ (ℓ + 1)) * E)) := by
          gcongr
          · exact le_max_left _ _
          · exact le_max_right _ _
      _ = uVolSqrt α * V * M * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) *
            (ENNReal.ofReal (((2 : ℝ) ^ k)⁻¹ + (2 : ℝ) ^ (ℓ + 1)) * ENNReal.ofReal R⁻¹) := by
          rw [ENNReal.ofReal_add (by positivity) (by positivity)]
          simp only [E]; ring
      _ ≤ _ := by
          rw [← ENNReal.ofReal_mul (by positivity)]
          gcongr
          exact le_self_add
  · refine (lintegral_uNorm_convKernel_sub_le α k hβm hbi hb' hd y).trans ?_
    calc uVolSqrt α * (∫⁻ t, β t) * (L * ENNReal.ofReal ((2 : ℝ) ^ k * ‖y‖))
        ≤ uVolSqrt α * (ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) * V) *
            (L * ENNReal.ofReal ((2 : ℝ) ^ k * ‖y‖)) := by gcongr
      _ = uVolSqrt α * V * L * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) *
            ENNReal.ofReal ((2 : ℝ) ^ k * ‖y‖) := by ring
      _ ≤ _ := by gcongr; exact le_add_self

/-! ### The `L²` bound `A₂` via Plancherel and the oscillatory multiplier estimate -/

/-- Scaling of the pieces in the other direction:
`e^{iv|t|^α} φ_ℓ(t) K(t) = 2^{-ℓn} [e^{i 2^{ℓα} v |·|^α} φ₀ K](2^{-ℓ} t)`. -/
theorem IsHomogeneousCZKernel.pieceKernel_eq_lpDilate_zero {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α v : ℝ) (ℓ : ℤ) :
    pieceKernel n α Ω v ℓ = lpDilate n (pieceKernel n α Ω (dyadicPoint α ℓ * v) 0) (-ℓ) := by
  have h := hΩ.pieceKernel_dyadicPoint_mul α (dyadicPoint α ℓ * v) 0 (-ℓ)
  rw [zero_sub, neg_neg, ← mul_assoc] at h
  rw [← h]
  congr 1
  rw [dyadicPoint, dyadicPoint, ← Real.rpow_add two_pos]
  push_cast
  ring_nf
  simp

/-- The unit-scale amplitude `φ₀ K` (the case `u = 0`, `ℓ = 0` of the piece kernel). -/
theorem pieceKernel_zero_zero_apply (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (t : Rn n) :
    pieceKernel n α Ω 0 0 t = ((dyadicPhi n t * czKernel n Ω t : ℝ) : ℂ) := by
  simp [pieceKernel, dyadicPhiScale]

/-- The Fourier transform of a unit-scale piece as an oscillatory integral with phase
`w|t|^α - ⟪t, 2πη⟫`. -/
theorem fourier_pieceKernel_zero (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (lam u : ℝ) (η : Rn n) :
    𝓕 (pieceKernel n α Ω (lam * u) 0) η = ∫ t, Complex.exp (Complex.I *
      ((lam * u * ‖t‖ ^ α - ⟪t, (2 * Real.pi) • η⟫ : ℝ) : ℂ)) * pieceKernel n α Ω 0 0 t := by
  rw [Real.fourier_eq']
  congr 1; funext t
  rw [pieceKernel_zero_zero_apply, smul_eq_mul, pieceKernel, ← mul_assoc, ← Complex.exp_add,
    inner_smul_right]
  simp only [dyadicPhiScale, neg_zero, zpow_zero, one_smul]
  congr 2
  push_cast
  ring

/-- **The oscillatory multiplier bound** (paper (`eq:L2_mult_bound`)): for `α > 1` there is `C`
such that for all `ℓ ∈ ℤ`, `v ∈ [1, 2^α]`, `ξ ∈ ℝⁿ`,
`|𝓕[e^{iv|·|^α} φ_ℓ K](ξ)| ≤ C (2^{ℓα})^{-n/2}`. -/
theorem IsHomogeneousCZKernel.norm_fourier_pieceKernel_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 1 < α) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℤ) (v : ℝ) (ξ : Rn n), v ∈ paramU α →
      ‖𝓕 (pieceKernel n α Ω v ℓ) ξ‖ ≤ C * (dyadicPoint α ℓ) ^ (-(n : ℝ) / 2) := by
  set a : Rn n → ℂ := pieceKernel n α Ω 0 0 with ha_def
  have ha : ContDiff ℝ (⊤ : ℕ∞) a := hΩ.contDiff_pieceKernel α 0 0
  have hac : HasCompactSupport a := hasCompactSupport_pieceKernel n α Ω 0 0
  have hsupp : tsupport a ⊆ {t | 1 / 2 ≤ ‖t‖ ∧ ‖t‖ ≤ 2} := by
    refine closure_minimal (fun t ht => ?_) ((isClosed_le continuous_const continuous_norm).inter
      (isClosed_le continuous_norm continuous_const))
    have h : dyadicPhi n t ≠ 0 := by
      intro h; apply ht; simp [ha_def, pieceKernel_zero_zero_apply, h]
    have := dyadicPhi_ne_zero h
    exact ⟨this.1.le, this.2.le⟩
  have hbd : ∀ j : ℕ, ∃ A : ℝ, ∀ x, ‖iteratedFDeriv ℝ j a x‖ ≤ A := fun j =>
    (ha.continuous_iteratedFDeriv (by exact_mod_cast le_top)).norm.bounded_above_of_compact_support
      (hac.iteratedFDeriv j).norm |>.imp fun A hA x => by simpa using hA x
  choose A hA using hbd
  set A' := ∑ j ∈ Finset.range (n + 2), |A j|
  have hA' : ∀ j, j ≤ n + 1 → ∀ x, ‖iteratedFDeriv ℝ j a x‖ ≤ A' := fun j hj x =>
    (hA j x).trans ((le_abs_self _).trans (Finset.single_le_sum (f := fun j => |A j|)
      (fun _ _ => abs_nonneg _) (Finset.mem_range.2 (by omega))))
  obtain ⟨C, hC0, hC⟩ := norm_integral_exp_radial_le n hα ((2 : ℝ) ^ α) A'
  refine ⟨C, hC0, fun ℓ v ξ hv => ?_⟩
  have hlam : 0 < dyadicPoint α ℓ := dyadicPoint_pos α ℓ
  rw [hΩ.pieceKernel_eq_lpDilate_zero, fourier_lpDilate, fourier_pieceKernel_zero]
  have := hC a (dyadicPoint α ℓ) v ((2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)) hlam hv.1 hv.2 ha
    hsupp hA'
  exact this

/-- Joint continuity of the single-scale kernel `(z, v) ↦ k_{ℓ,k}(z, v)`. -/
theorem IsHomogeneousCZKernel.continuous_unitKernel_uncurry {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) :
    Continuous fun p : Rn n × ℝ => unitKernel hΩ α ℓ k p.2 p.1 := by
  simp_rw [unitKernel_apply]
  have hψc : Continuous (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous
  have hψb : ∀ z, ‖lpDilate n (lpPsi n) k z‖ ≤
      SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k) := fun z => by
    rw [← coe_schwartzDilate]; exact SchwartzMap.norm_le_seminorm ℝ _ z
  refine continuous_of_dominated (bound := fun t => SchwartzMap.seminorm ℝ 0 0
      (schwartzDilate (lpPsi n) k) * ‖dyadicPhiScale n ℓ t * czKernel n Ω t‖)
    (fun p => ?_) (fun p => ae_of_all _ fun t => ?_)
    ((hΩ.integrable_dyadicPhiScale_mul ℓ).norm.const_mul _) (ae_of_all _ fun t => ?_)
  · exact ((hψc.comp (continuous_sub_left p.1)).aestronglyMeasurable).mul
      (hΩ.integrable_pieceKernel α p.2 ℓ).aestronglyMeasurable
  · rw [norm_mul, norm_pieceKernel]
    exact mul_le_mul_of_nonneg_right (hψb _) (norm_nonneg _)
  · refine (hψc.comp (continuous_fst.sub continuous_const)).mul ?_
    simp only [pieceKernel]
    exact (Complex.continuous_exp.comp ((continuous_const.mul
      (Complex.continuous_ofReal.comp continuous_snd)).mul continuous_const)).mul continuous_const

/-- The partial sums of the dyadic partition are at most `1`. -/
theorem sum_dyadicPhiScale_le_one {n : ℕ} (s : Finset ℤ) (ξ : Rn n) :
    ∑ j ∈ s, dyadicPhiScale n j ξ ≤ 1 := by
  rcases eq_or_ne ξ 0 with rfl | hξ
  · simp [dyadicPhiScale_zero]
  · rw [← tsum_dyadicPhiScale hξ]
    exact (hasSum_dyadicPhiScale hξ).summable.sum_le_tsum s fun j _ =>
      dyadicPhiScale_nonneg n j ξ

/-- **The `L²` bound `A₂`** (paper (`eq:L2_mult_bound`), with orthogonality in `j`): for `α > 1`
there is `C` such that for all `ℓ, k`, finite `J ⊆ ℤ` and `g ∈ L²`,
`∑_{j ∈ J} ∫ ∫_U |T_{j,v} g(x)|² dv dx ≤ C (2^{ℓα})^{-n} ‖g‖₂²`, where
`T_{j,v} g(x) = ∫ 2^{jn} k_{ℓ,k}(2^j (x - y), v) g(y) dy = 𝓗^{(2^{jα} v)}_{ℓ-j} P_{j+k} g(x)`. -/
theorem IsHomogeneousCZKernel.unitKernel_L2 {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 1 < α) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ k : ℤ) (J : Finset ℤ) (g : Rn n → ℂ), MemLp g 2 →
      ∫⁻ x, ∑ j ∈ J, ∫⁻ v in paramU α,
          ‖∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y‖ₑ ^ 2 ≤
        ENNReal.ofReal (C * dyadicPoint α ℓ ^ (-(n : ℝ))) * ∫⁻ x, ‖g x‖ₑ ^ 2 := by
  obtain ⟨C₀, hC₀0, hC₀⟩ := hΩ.norm_fourier_pieceKernel_le hα
  refine ⟨2 * C₀ ^ 2 * (2 ^ α - 1), by
    have : (1 : ℝ) ≤ 2 ^ α := Real.one_le_rpow (by norm_num) (by linarith)
    have : 0 ≤ (2 : ℝ) ^ α - 1 := by linarith
    positivity, fun ℓ k J g hg => ?_⟩
  set ν : Measure ℝ := volume.restrict (paramU α)
  have hlam : 0 < dyadicPoint α ℓ := dyadicPoint_pos α ℓ
  set M : ℝ := (C₀ * dyadicPoint α ℓ ^ (-(n : ℝ) / 2)) ^ 2
  -- the multiplier bound
  have hM : ∀ v ∈ paramU α, ∀ ξ, ∑ j ∈ J,
      ‖𝓕 (lpDilate n (unitKernel hΩ α ℓ k v) j) ξ‖ ^ 2 ≤ M := by
    intro v hv ξ
    have hterm : ∀ j : ℤ, ‖𝓕 (lpDilate n (unitKernel hΩ α ℓ k v) j) ξ‖ ^ 2 ≤
        M * dyadicPhiScale n (j + k) ξ := by
      intro j
      rw [fourier_lpDilate, fourier_unitKernel, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (dyadicPhi_nonneg _ _), mul_pow]
      have h1 := hC₀ ℓ v (((2 : ℝ) ^ j)⁻¹ • ξ) hv
      have h2 : dyadicPhi n (((2 : ℝ) ^ k)⁻¹ • ((2 : ℝ) ^ j)⁻¹ • ξ) =
          dyadicPhiScale n (j + k) ξ := by
        rw [dyadicPhiScale, smul_smul, ← mul_inv, ← zpow_add₀ two_ne_zero, zpow_neg, add_comm]
      rw [h2]
      have h3 := dyadicPhiScale_nonneg n (j + k) ξ
      have h4 := dyadicPhiScale_le_one n (j + k) ξ
      have h5 : dyadicPhiScale n (j + k) ξ ^ 2 ≤ dyadicPhiScale n (j + k) ξ := by nlinarith
      calc dyadicPhiScale n (j + k) ξ ^ 2 * ‖𝓕 (pieceKernel n α Ω v ℓ)
            (((2 : ℝ) ^ j)⁻¹ • ξ)‖ ^ 2
          ≤ dyadicPhiScale n (j + k) ξ * M := by
            refine mul_le_mul h5 (pow_le_pow_left₀ (norm_nonneg _) h1 2) (by positivity) h3
        _ = _ := mul_comm _ _
    calc ∑ j ∈ J, ‖𝓕 (lpDilate n (unitKernel hΩ α ℓ k v) j) ξ‖ ^ 2
        ≤ ∑ j ∈ J, M * dyadicPhiScale n (j + k) ξ := Finset.sum_le_sum fun j _ => hterm j
      _ = M * ∑ j ∈ J.map (addRightEmbedding k), dyadicPhiScale n j ξ := by
          rw [Finset.mul_sum, Finset.sum_map]; rfl
      _ ≤ M * 1 := mul_le_mul_of_nonneg_left (sum_dyadicPhiScale_le_one _ ξ) (by positivity)
      _ = M := mul_one M
  -- measurability
  have hKc : ∀ j : ℤ, Continuous fun p : Rn n × ℝ =>
      lpDilate n (unitKernel hΩ α ℓ k p.2) j p.1 := by
    intro j
    have := hΩ.continuous_unitKernel_uncurry α ℓ k
    have h2 : Continuous fun p : Rn n × ℝ => (((2 : ℝ) ^ j • p.1, p.2) : Rn n × ℝ) :=
      (continuous_fst.const_smul ((2 : ℝ) ^ j)).prodMk continuous_snd
    have h3 := continuous_const (y := ((2 : ℝ) : ℂ) ^ (j * (n : ℤ))) |>.mul (this.comp h2)
    exact h3
  have hΦm : ∀ j : ℤ, AEStronglyMeasurable (fun p : Rn n × ℝ =>
      ∫ y, lpDilate n (unitKernel hΩ α ℓ k p.2) j (p.1 - y) * g y) (volume.prod ν) := by
    intro j
    refine AEStronglyMeasurable.integral_prod_right' (f := fun q : (Rn n × ℝ) × Rn n =>
      lpDilate n (unitKernel hΩ α ℓ k q.1.2) j (q.1.1 - q.2) * g q.2) ?_
    refine AEStronglyMeasurable.mul ?_ (hg.aestronglyMeasurable.comp_snd)
    exact ((hKc j).comp ((continuous_fst.comp continuous_fst |>.sub continuous_snd).prodMk
      (continuous_snd.comp continuous_fst))).aestronglyMeasurable
  have hFm : ∀ j : ℤ, AEMeasurable (Function.uncurry fun x v =>
      ‖∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y‖ₑ ^ 2) (volume.prod ν) :=
    fun j => ((hΦm j).enorm.pow_const 2)
  -- the L² bound for fixed v
  have hv2 : ∀ v ∈ paramU α, ∑ j ∈ J, ∫⁻ x,
      ‖∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y‖ₑ ^ 2 ≤
        2 * ENNReal.ofReal M * ∫⁻ x, ‖g x‖ₑ ^ 2 := by
    intro v hv
    have hk : ∀ j ∈ J, Integrable (lpDilate n (unitKernel hΩ α ℓ k v) j) := fun j _ =>
      integrable_lpDilate (unitKernel hΩ α ℓ k v).integrable j
    have h := lp_sum_eLpNorm_conv_le J hk (hM v hv) hg
    have hconv : ∀ j, (fun x => ∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y) =
        lpDilate n (unitKernel hΩ α ℓ k v) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g :=
      fun j => funext fun x => (convolution_eq_integral_sub _ _ x).symm
    have hmeas : ∀ j ∈ J, AEStronglyMeasurable
        (lpDilate n (unitKernel hΩ α ℓ k v) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) := by
      intro j hj
      exact (memLp_convolution_of_memLp one_le_two
        (memLp_one_iff_integrable.2 (hk j hj)) hg).aestronglyMeasurable
    rw [← lp_eLpNorm_two_sq hg.aestronglyMeasurable]
    refine le_trans (le_of_eq ?_) h
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [lp_eLpNorm_two_sq (hmeas j hj), ← hconv j]
  have hU : ν univ = ENNReal.ofReal ((2 : ℝ) ^ α - 1) := by
    simp only [ν, Measure.restrict_apply_univ, paramU, Real.volume_Icc]
  calc ∫⁻ x, ∑ j ∈ J, ∫⁻ v in paramU α,
        ‖∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y‖ₑ ^ 2
      = ∑ j ∈ J, ∫⁻ x, ∫⁻ v, ‖∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y‖ₑ ^ 2 ∂ν :=
        lintegral_finsetSum' J fun j _ => (hFm j).lintegral_prod_right'
    _ = ∑ j ∈ J, ∫⁻ v, ∫⁻ x,
          ‖∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y‖ₑ ^ 2 ∂volume ∂ν :=
        Finset.sum_congr rfl fun j _ => lintegral_lintegral_swap (hFm j)
    _ = ∫⁻ v, ∑ j ∈ J, ∫⁻ x,
          ‖∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y‖ₑ ^ 2 ∂volume ∂ν :=
        (lintegral_finsetSum' J fun j _ => (hFm j).lintegral_prod_left').symm
    _ ≤ ∫⁻ _ in paramU α, 2 * ENNReal.ofReal M * ∫⁻ x, ‖g x‖ₑ ^ 2 :=
        setLIntegral_mono' measurableSet_Icc fun v hv => hv2 v hv
    _ = ENNReal.ofReal ((2 : ℝ) ^ α - 1) * (2 * ENNReal.ofReal M) * ∫⁻ x, ‖g x‖ₑ ^ 2 := by
        rw [setLIntegral_const, ← Measure.restrict_apply_univ, ← hU]; ring
    _ = _ := by
        have hM' : M = C₀ ^ 2 * dyadicPoint α ℓ ^ (-(n : ℝ)) := by
          simp only [M]
          rw [mul_pow, ← Real.rpow_mul_natCast hlam.le]
          congr 2; push_cast; ring
        have h1 : (1 : ℝ) ≤ 2 ^ α := Real.one_le_rpow (by norm_num) (by linarith)
        have h2 : (2 : ℝ≥0∞) * ENNReal.ofReal (C₀ ^ 2 * dyadicPoint α ℓ ^ (-(n : ℝ))) =
            ENNReal.ofReal (2 * (C₀ ^ 2 * dyadicPoint α ℓ ^ (-(n : ℝ)))) := by
          rw [ENNReal.ofReal_mul (p := 2) (by norm_num), ENNReal.ofReal_ofNat]
        rw [hM', h2, ← ENNReal.ofReal_mul (by linarith)]
        congr 2
        ring

/-! ## Cases 2 and 3 (paper §4.5): nonstationary phase -/

/-- Scaling of the derivative pieces:
`i|t|^α e^{iv|t|^α} φ_ℓ(t) K(t) = 2^{ℓα} 2^{-ℓn} [i|·|^α e^{i 2^{ℓα} v|·|^α} φ₀ K](2^{-ℓ} t)`. -/
theorem IsHomogeneousCZKernel.pieceKernelD_eq_lpDilate_zero {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α v : ℝ) (ℓ : ℤ) :
    pieceKernelD n α Ω v ℓ = fun t => ((dyadicPoint α ℓ : ℝ) : ℂ) *
      lpDilate n (pieceKernelD n α Ω (dyadicPoint α ℓ * v) 0) (-ℓ) t := by
  funext t
  have h := congrFun (hΩ.pieceKernel_eq_lpDilate_zero α v ℓ) t
  have hc : 0 < (2 : ℝ) ^ (-ℓ) := zpow_pos two_pos _
  have hn : ‖(2 : ℝ) ^ (-ℓ) • t‖ ^ α = (dyadicPoint α ℓ)⁻¹ * ‖t‖ ^ α := by
    rw [norm_smul, Real.norm_of_nonneg hc.le, Real.mul_rpow hc.le (norm_nonneg _),
      dyadicPoint, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_neg
      (by norm_num)]
    push_cast; ring_nf
  rw [pieceKernelD, h]
  simp only [lpDilate, pieceKernelD]
  rw [hn]
  have hl : (dyadicPoint α ℓ : ℝ) ≠ 0 := (dyadicPoint_pos α ℓ).ne'
  have hl' : ((dyadicPoint α ℓ : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hl
  push_cast
  field_simp

/-- The amplitude `b = i|s|^α φ₀(s) K(s)` (`= pieceKernelD 0 0`). -/
theorem IsHomogeneousCZKernel.contDiff_pieceKernelD_zero {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (pieceKernelD n α Ω 0 0) := by
  have h1 : ContDiffOn ℝ (⊤ : ℕ∞) (fun t : Rn n => I * ((‖t‖ ^ α : ℝ) : ℂ))
      ({0}ᶜ : Set (Rn n)) := by
    intro t ht
    have ht' : t ≠ 0 := ht
    refine (contDiffAt_const.mul (ofRealCLM.contDiff.contDiffAt.comp t ?_)).contDiffWithinAt
    exact (contDiffAt_norm ℝ ht').rpow_const_of_ne (norm_ne_zero_iff.2 ht')
  have h2 : tsupport (pieceKernel n α Ω 0 0) ⊆ ({0}ᶜ : Set (Rn n)) := by
    refine (closure_mono fun t ht => ?_).trans (tsupport_dyadicPhiScale_subset n 0)
    by_contra h
    exact ht (by simp [pieceKernel, Function.notMem_support.1 h])
  exact osc_contDiff_mul_of_tsupport isOpen_compl_singleton h1
    (hΩ.contDiff_pieceKernel α 0 0) h2

/-- The derivative pieces have compact support. -/
theorem hasCompactSupport_pieceKernelD (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ) :
    HasCompactSupport (pieceKernelD n α Ω u ℓ) :=
  (hasCompactSupport_pieceKernel n α Ω u ℓ).mul_left

/-- The unit-scale derivative amplitude is supported in the annulus `1/2 ≤ |t| ≤ 2`. -/
theorem tsupport_pieceKernelD_zero (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) :
    tsupport (pieceKernelD n α Ω 0 0) ⊆ {t | 1 / 2 ≤ ‖t‖ ∧ ‖t‖ ≤ 2} := by
  refine closure_minimal (fun t ht => ?_) ((isClosed_le continuous_const continuous_norm).inter
    (isClosed_le continuous_norm continuous_const))
  have h : dyadicPhi n t ≠ 0 := by
    intro h; apply ht
    simp [pieceKernelD, pieceKernel_zero_zero_apply, h]
  have := dyadicPhi_ne_zero h
  exact ⟨this.1.le, this.2.le⟩

/-- The Fourier transform of a unit-scale derivative piece as an oscillatory integral. -/
theorem fourier_pieceKernelD_zero (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (lam u : ℝ) (η : Rn n) :
    𝓕 (pieceKernelD n α Ω (lam * u) 0) η = ∫ t, Complex.exp (Complex.I *
      ((lam * u * ‖t‖ ^ α - ⟪t, (2 * Real.pi) • η⟫ : ℝ) : ℂ)) * pieceKernelD n α Ω 0 0 t := by
  rw [Real.fourier_eq']
  congr 1; funext t
  simp only [pieceKernelD, pieceKernel, smul_eq_mul, inner_smul_right, dyadicPhiScale, neg_zero,
    zpow_zero, one_smul]
  rw [show Complex.exp (Complex.I * (((lam * u * ‖t‖ ^ α - 2 * Real.pi * ⟪t, η⟫ : ℝ) : ℂ))) =
    Complex.exp (((-2 * Real.pi * ⟪t, η⟫ : ℝ) : ℂ) * Complex.I) *
      Complex.exp (Complex.I * ((lam * u : ℝ) : ℂ) * ((‖t‖ ^ α : ℝ) : ℂ)) by
    rw [← Complex.exp_add]; congr 1; push_cast; ring]
  simp only [Complex.ofReal_zero, mul_zero, zero_mul, Complex.exp_zero, one_mul]
  push_cast
  ring

/-- The `L¹` norms of the derivatives of the amplitude `b`. -/
def ampDerivSum (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (N : ℕ) : ℝ :=
  ∑ j ∈ Finset.range (N + 1), ∫ x, ‖iteratedFDeriv ℝ j (pieceKernelD n α Ω 0 0) x‖

/-- The amplitude constants are nonnegative. -/
theorem ampDerivSum_nonneg (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (N : ℕ) :
    0 ≤ ampDerivSum n α Ω N :=
  Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _

/-- **Nonstationary phase for the derivative pieces** (paper (`eq:multiplier_expansion2`)):
if `|2π 2^ℓ ξ| ≥ 2α 2^α 2^{|α-1|} 2^{ℓα}` or `|2π 2^ℓ ξ| ≤ α 2^{-|α-1|} 2^{ℓα}/2`, then for
`v ∈ [1, 2^α]`, `|𝓕[i|·|^α e^{iv|·|^α} φ_ℓ K](ξ)| ≤ C_N 2^{ℓα} (2^{ℓα} + |2π 2^ℓ ξ|)^{-N}`. -/
theorem IsHomogeneousCZKernel.norm_fourier_pieceKernelD_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 1 < α) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℤ) (v : ℝ) (ξ : Rn n), v ∈ paramU α →
      (2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| * dyadicPoint α ℓ ≤
          ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖ ∨
        ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖ ≤
          α * 2 ^ (-|α - 1|) * dyadicPoint α ℓ / 2) →
      ‖𝓕 (pieceKernelD n α Ω v ℓ) ξ‖ ≤ C * dyadicPoint α ℓ *
        (dyadicPoint α ℓ + ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖) ^ (-(N : ℝ)) := by
  obtain ⟨C, hC0, hC⟩ := norm_integral_exp_radial_le_of_nonstationary n N hα ((2 : ℝ) ^ α)
  refine ⟨C * ampDerivSum n α Ω N, mul_nonneg hC0 (ampDerivSum_nonneg n α Ω N),
    fun ℓ v ξ hv hcond => ?_⟩
  have hlam : 0 < dyadicPoint α ℓ := dyadicPoint_pos α ℓ
  have hF : 𝓕 (pieceKernelD n α Ω v ℓ) ξ = ((dyadicPoint α ℓ : ℝ) : ℂ) *
      𝓕 (pieceKernelD n α Ω (dyadicPoint α ℓ * v) 0) (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ) := by
    have hlin : ∀ (c : ℂ) (g : Rn n → ℂ), 𝓕 (fun t => c * g t) ξ = c * 𝓕 g ξ := by
      intro c g
      rw [Real.fourier_eq, Real.fourier_eq, ← integral_const_mul]
      congr 1; funext t; simp only [Circle.smul_def]; ring
    rw [hΩ.pieceKernelD_eq_lpDilate_zero, hlin, fourier_lpDilate]
  rw [hF, norm_mul, Complex.norm_real, Real.norm_of_nonneg hlam.le, fourier_pieceKernelD_zero]
  have := hC (pieceKernelD n α Ω 0 0) (dyadicPoint α ℓ) v
    ((2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)) hlam hv.1 hv.2 (hΩ.contDiff_pieceKernelD_zero α)
    (tsupport_pieceKernelD_zero n α Ω) hcond
  calc dyadicPoint α ℓ * ‖∫ t, Complex.exp (Complex.I * ((dyadicPoint α ℓ * v * ‖t‖ ^ α -
        ⟪t, (2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)⟫ : ℝ) : ℂ)) * pieceKernelD n α Ω 0 0 t‖
      ≤ dyadicPoint α ℓ * (C * (dyadicPoint α ℓ +
          ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖) ^ (-(N : ℝ)) * ampDerivSum n α Ω N) :=
        mul_le_mul_of_nonneg_left this hlam.le
    _ = _ := by ring

/-- `|i|t|^α e^{iv|t|^α} φ_ℓ(t) K(t)| = |t|^α |φ_ℓ(t) K(t)|`. -/
theorem norm_pieceKernelD_real (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (u : ℝ) (ℓ : ℤ) (t : Rn n) :
    ‖pieceKernelD n α Ω u ℓ t‖ = ‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t| := by
  rw [pieceKernelD, norm_mul, norm_mul, norm_pieceKernel, Complex.norm_I, Complex.norm_real,
    Real.norm_of_nonneg (by positivity), Real.norm_eq_abs, one_mul]

/-- The `v`-derivative of the Fourier transform of the pieces. -/
theorem IsHomogeneousCZKernel.hasDerivAt_fourier_pieceKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ : ℤ) (ξ : Rn n) (w₀ : ℝ) :
    HasDerivAt (fun w => 𝓕 (pieceKernel n α Ω w ℓ) ξ) (𝓕 (pieceKernelD n α Ω w₀ ℓ) ξ) w₀ := by
  simp_rw [Real.fourier_eq]
  have hd : ∀ (t : Rn n) (w : ℝ), HasDerivAt (fun w => 𝐞 (-⟪t, ξ⟫) • pieceKernel n α Ω w ℓ t)
      (𝐞 (-⟪t, ξ⟫) • pieceKernelD n α Ω w ℓ t) w := by
    intro t w
    have h1 : HasDerivAt (fun w : ℝ => I * (w : ℂ) * ((‖t‖ ^ α : ℝ) : ℂ))
        (I * 1 * ((‖t‖ ^ α : ℝ) : ℂ)) w :=
      ((hasDerivAt_id w).ofReal_comp.const_mul I).mul_const _
    set c : ℂ := ((𝐞 (-⟪t, ξ⟫) : ℂ)) * ((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ)
    have e1 : (fun w => 𝐞 (-⟪t, ξ⟫) • pieceKernel n α Ω w ℓ t) =
        fun w : ℝ => c * Complex.exp (I * (w : ℂ) * ((‖t‖ ^ α : ℝ) : ℂ)) := by
      funext w; simp only [c, Circle.smul_def, pieceKernel]; ring
    rw [e1]
    convert h1.cexp.const_mul c using 1
    simp only [c, Circle.smul_def, pieceKernelD, pieceKernel]
    ring
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le (s := univ) (bound := fun t =>
      ‖pieceKernelD n α Ω 0 ℓ t‖) Filter.univ_mem
    (Eventually.of_forall fun w => ?_) ?_ ?_ (ae_of_all _ fun t w _ => ?_)
    (hΩ.integrable_pieceKernelD α 0 ℓ).norm (ae_of_all _ fun t w _ => hd t w)).2
  · exact ((Real.fourierIntegral_convergent_iff ξ).2
      (hΩ.integrable_pieceKernel α w ℓ)).aestronglyMeasurable
  · exact (Real.fourierIntegral_convergent_iff ξ).2 (hΩ.integrable_pieceKernel α w₀ ℓ)
  · exact ((Real.fourierIntegral_convergent_iff ξ).2
      (hΩ.integrable_pieceKernelD α w₀ ℓ)).aestronglyMeasurable
  · rw [Circle.norm_smul, norm_pieceKernelD_real, norm_pieceKernelD_real]

/-- **Case 2** of paper §4.3 (no critical point, `k ≫ ℓ(α-1)`), in the explicit form
`2α 2^α 2^{|α-1|} 2^{ℓα} ≤ π 2^{ℓ+k}`. -/
def case2Cond (α : ℝ) (ℓ k : ℤ) : Prop :=
  2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| * dyadicPoint α ℓ ≤ Real.pi * (2 : ℝ) ^ (ℓ + k)

/-- **Case 3** of paper §4.3 (no critical point, `k ≪ ℓ(α-1)`), in the explicit form
`8π 2^{ℓ+k} ≤ α 2^{-|α-1|} 2^{ℓα}`. -/
def case3Cond (α : ℝ) (ℓ k : ℤ) : Prop :=
  8 * Real.pi * (2 : ℝ) ^ (ℓ + k) ≤ α * 2 ^ (-|α - 1|) * dyadicPoint α ℓ

/-- The norm of the rescaled frequency `ξ' = 2π 2^ℓ ξ`. -/
theorem norm_rescaled_freq {n : ℕ} (ℓ : ℤ) (ξ : Rn n) :
    ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖ = 2 * Real.pi * (2 : ℝ) ^ ℓ * ‖ξ‖ := by
  rw [norm_smul, norm_smul, Real.norm_of_nonneg (by positivity),
    Real.norm_of_nonneg (by positivity), zpow_neg, inv_inv]; ring

/-- On the support of `φ(2^{-k} ·)`: `π 2^{ℓ+k} < |ξ'| < 4π 2^{ℓ+k}`. -/
theorem rescaled_freq_bounds {n : ℕ} {ℓ k : ℤ} {ξ : Rn n} (h : dyadicPhiScale n k ξ ≠ 0) :
    Real.pi * (2 : ℝ) ^ (ℓ + k) < ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖ ∧
      ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖ < 4 * Real.pi * (2 : ℝ) ^ (ℓ + k) := by
  obtain ⟨h1, h2⟩ := dyadicPhiScale_ne_zero h
  rw [norm_rescaled_freq]
  have hl : (0 : ℝ) < 2 ^ ℓ := zpow_pos two_pos ℓ
  have e1 : (2 : ℝ) ^ (k - 1) = 2 ^ k / 2 := by rw [zpow_sub_one₀ two_ne_zero]; ring
  have e2 : (2 : ℝ) ^ (k + 1) = 2 ^ k * 2 := by rw [zpow_add_one₀ two_ne_zero]
  rw [zpow_add₀ two_ne_zero]
  rw [e1] at h1; rw [e2] at h2
  have hp := Real.pi_pos
  constructor <;> nlinarith [mul_pos hp hl]

/-- The nonstationary-phase bound on the support, in Cases 2 and 3:
`|𝓕[i|·|^α e^{iw|·|^α} φ_ℓ K](ξ)| ≤ C 2^{ℓα} (2^{ℓα} + π 2^{ℓ+k})^{-N}`. -/
theorem IsHomogeneousCZKernel.norm_fourier_pieceKernelD_le_case {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 1 < α) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ k : ℤ) (w : ℝ) (ξ : Rn n), w ∈ paramU α →
      (case2Cond α ℓ k ∨ case3Cond α ℓ k) → dyadicPhiScale n k ξ ≠ 0 →
      ‖𝓕 (pieceKernelD n α Ω w ℓ) ξ‖ ≤ C * dyadicPoint α ℓ *
        (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ)) := by
  obtain ⟨C, hC0, hC⟩ := hΩ.norm_fourier_pieceKernelD_le hα N
  refine ⟨C, hC0, fun ℓ k w ξ hw hcase hξ => ?_⟩
  obtain ⟨hb1, hb2⟩ := rescaled_freq_bounds (ℓ := ℓ) hξ
  have hlam := dyadicPoint_pos α ℓ
  have hcond : 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| * dyadicPoint α ℓ ≤
        ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖ ∨
      ‖(2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)‖ ≤
        α * 2 ^ (-|α - 1|) * dyadicPoint α ℓ / 2 := by
    rcases hcase with h | h
    · exact Or.inl (h.trans hb1.le)
    · right
      unfold case3Cond at h
      have := Real.pi_pos
      have h2 : (0 : ℝ) < 2 ^ (ℓ + k) := zpow_pos two_pos _
      linarith
  refine (hC ℓ w ξ hw hcond).trans ?_
  have hp : (0 : ℝ) < dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k) := by
    have := Real.pi_pos; positivity
  exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_nonpos hp (by linarith)
    (neg_nonpos.2 (Nat.cast_nonneg N))) (by positivity)

/-- Integrability of `ξ ↦ e(⟪ξ, z⟫) φ_k(ξ) 𝓕f(ξ)` for Schwartz `f`. -/
theorem integrable_fourierChar_dyadic_mul {n : ℕ} (k : ℤ) (f : 𝓢(Rn n, ℂ)) (z : Rn n) :
    Integrable (fun ξ => 𝐞 (inner ℝ ξ z) • ((dyadicPhiScale n k ξ : ℂ) *
      𝓕 (f : Rn n → ℂ) ξ)) := by
  refine (integrable_fourier_schwartz f).norm.mono' ?_ (ae_of_all _ fun ξ => ?_)
  · exact ((Real.continuous_fourierChar.comp (continuous_id.inner continuous_const)).smul
      ((Complex.continuous_ofReal.comp (contDiff_dyadicPhiScale n k).continuous).mul
        (continuous_fourier_schwartz f))).aestronglyMeasurable
  · rw [Circle.norm_smul, norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (dyadicPhiScale_nonneg n k ξ)]
    exact mul_le_of_le_one_left (norm_nonneg _) (dyadicPhiScale_le_one n k ξ)

/-- **Sup bound for kernel differences in Cases 2, 3** (paper §4.5): for `v ≤ v'` in `U`,
`|k_{ℓ,k}(z, v') - k_{ℓ,k}(z, v)| ≤ (v' - v) C 2^{ℓα} (2^{ℓα} + π 2^{ℓ+k})^{-N} |B(0, 2^{k+1})|`. -/
theorem IsHomogeneousCZKernel.norm_unitKernel_sub_le_E1 {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 1 < α) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ k : ℤ) (v v' : ℝ) (z : Rn n), v ∈ paramU α → v' ∈ paramU α →
      v ≤ v' → (case2Cond α ℓ k ∨ case3Cond α ℓ k) →
      ‖unitKernel hΩ α ℓ k v' z - unitKernel hΩ α ℓ k v z‖ ≤
        (v' - v) * (C * dyadicPoint α ℓ *
          (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ))) *
          volume.real (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (k + 1))) := by
  obtain ⟨C, hC0, hC⟩ := hΩ.norm_fourier_pieceKernelD_le_case hα N
  refine ⟨C, hC0, fun ℓ k v v' z hv hv' hvv' hcase => ?_⟩
  set B := C * dyadicPoint α ℓ * (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ))
  have hB : 0 ≤ B := by
    have := dyadicPoint_pos α ℓ
    have := Real.pi_pos
    positivity
  have hmvt : ∀ ξ, dyadicPhiScale n k ξ ≠ 0 →
      ‖𝓕 (pieceKernel n α Ω v' ℓ) ξ - 𝓕 (pieceKernel n α Ω v ℓ) ξ‖ ≤ B * (v' - v) := by
    intro ξ hξ
    refine norm_image_sub_le_of_norm_deriv_le_segment'
      (f := fun w => 𝓕 (pieceKernel n α Ω w ℓ) ξ)
      (f' := fun w => 𝓕 (pieceKernelD n α Ω w ℓ) ξ)
      (fun w _ => (hΩ.hasDerivAt_fourier_pieceKernel α ℓ ξ w).hasDerivWithinAt)
      (fun w hw => hC ℓ k w ξ ⟨hv.1.trans hw.1, hw.2.le.trans hv'.2⟩ hcase hξ) v'
      ⟨hvv', le_rfl⟩
  have hrep : unitKernel hΩ α ℓ k v' z - unitKernel hΩ α ℓ k v z =
      ∫ ξ, 𝐞 (inner ℝ ξ z) • ((dyadicPhiScale n k ξ : ℂ) *
        (𝓕 (pieceKernel n α Ω v' ℓ) ξ - 𝓕 (pieceKernel n α Ω v ℓ) ξ)) := by
    rw [unitKernel, unitKernel, lpProj_eq_integral, lpProj_eq_integral,
      ← integral_sub (integrable_fourierChar_dyadic_mul k _ z)
        (integrable_fourierChar_dyadic_mul k _ z)]
    congr 1; funext ξ
    rw [coe_pieceSchwartz, coe_pieceSchwartz, mul_sub, smul_sub]
  rw [hrep]
  have hS : MeasurableSet (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (k + 1))) :=
    Metric.isClosed_closedBall.measurableSet
  have hint : Integrable ((Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (k + 1))).indicator
      (fun _ => B * (v' - v))) :=
    (integrableOn_const (by exact measure_closedBall_lt_top.ne)).integrable_indicator hS
  refine (norm_integral_le_of_norm_le hint (ae_of_all _ fun ξ => ?_)).trans (le_of_eq ?_)
  · by_cases h : dyadicPhiScale n k ξ = 0
    · rw [h]; simp only [Complex.ofReal_zero, zero_mul, smul_zero, norm_zero]
      exact indicator_nonneg (fun _ _ => mul_nonneg hB (by linarith)) _
    · have hmem : ξ ∈ Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (k + 1)) := by
        simpa using (dyadicPhiScale_ne_zero h).2.le
      rw [indicator_of_mem hmem, Circle.norm_smul, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (dyadicPhiScale_nonneg n k ξ)]
      exact (mul_le_of_le_one_left (norm_nonneg _) (dyadicPhiScale_le_one n k ξ)).trans
        (hmvt ξ h)
  · rw [integral_indicator_const _ hS, smul_eq_mul]; ring

/-- The geometric factor `c₁ = (1 + 2^{ℓ+1}) max(1, 2^{-k})`. -/
def decayFactor (ℓ k : ℤ) : ℝ := (1 + (2 : ℝ) ^ (ℓ + 1)) * max 1 ((2 : ℝ) ^ (-k))

/-- `c₁ > 0`. -/
theorem decayFactor_pos (ℓ k : ℤ) : 0 < decayFactor ℓ k := by
  unfold decayFactor; positivity

/-- `1 + |z| ≤ c₁ (1 + 2^k |z - t|)` for `|t| ≤ 2^{ℓ+1}`. -/
theorem one_add_norm_le_decayFactor {n : ℕ} (ℓ k : ℤ) {z t : Rn n}
    (ht : ‖t‖ ≤ (2 : ℝ) ^ (ℓ + 1)) :
    1 + ‖z‖ ≤ decayFactor ℓ k * (1 + (2 : ℝ) ^ k * ‖z - t‖) := by
  unfold decayFactor
  set R := (2 : ℝ) ^ (ℓ + 1)
  set m := max 1 ((2 : ℝ) ^ (-k))
  have hm1 : 1 ≤ m := le_max_left _ _
  have hm2 : (2 : ℝ) ^ (-k) ≤ m := le_max_right _ _
  have hk : (2 : ℝ) ^ (-k) * (2 : ℝ) ^ k = 1 := by
    rw [← zpow_add₀ two_ne_zero]; simp
  have hk0 : (0 : ℝ) < 2 ^ k := zpow_pos two_pos k
  have hmk : 1 ≤ m * (2 : ℝ) ^ k := by nlinarith
  have hy := norm_nonneg (z - t)
  have hR : 0 ≤ R := by positivity
  have hz : ‖z‖ ≤ ‖z - t‖ + R := by
    calc ‖z‖ = ‖(z - t) + t‖ := by rw [sub_add_cancel]
      _ ≤ ‖z - t‖ + ‖t‖ := norm_add_le _ _
      _ ≤ _ := by linarith
  nlinarith [mul_le_mul_of_nonneg_left hmk hy, mul_nonneg hR hy, mul_nonneg hR
    (mul_nonneg (by linarith : (0:ℝ) ≤ m - 1) (le_refl (0:ℝ)))]

/-- **Decay bound for kernel differences** (physical space): for `v ≤ v'`,
`|k_{ℓ,k}(z, v') - k_{ℓ,k}(z, v)| ≤ (v' - v) 2^{kn} D₀ c₁^M (1 + |z|)^{-M} 2^{(ℓ+1)α} 4^n C |B₁|`,
where `(1 + |w|)^M |ψ(w)| ≤ D₀`. -/
theorem IsHomogeneousCZKernel.enorm_unitKernel_sub_le_E2 {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 ≤ α) {C : ℝ} (hC0 : 0 ≤ C)
    (hC : ∀ t, |Ω t| ≤ C) {M : ℕ} {D₀ : ℝ}
    (hD : ∀ w, (1 + ‖w‖) ^ M * ‖lpPsi n w‖ ≤ D₀) (ℓ k : ℤ) (v v' : ℝ) (hvv' : v ≤ v')
    (z : Rn n) :
    ‖unitKernel hΩ α ℓ k v' z - unitKernel hΩ α ℓ k v z‖ₑ ≤
      ENNReal.ofReal ((v' - v) * (((2 : ℝ) ^ k) ^ n * D₀ * decayFactor ℓ k ^ M /
        (1 + ‖z‖) ^ M) * ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) * (4 ^ n * C))) *
        volume (Metric.ball (0 : Rn n) 1) := by
  have hD0 : 0 ≤ D₀ := (mul_nonneg (by positivity) (norm_nonneg _)).trans (hD 0)
  set Q := ((2 : ℝ) ^ k) ^ n * D₀ * decayFactor ℓ k ^ M / (1 + ‖z‖) ^ M with hQ
  have hQ0 : 0 ≤ Q := by have := decayFactor_pos ℓ k; positivity
  have hψb : ∀ y, ‖lpDilate n (lpPsi n) k y‖ ≤
      SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k) := fun y => by
    rw [← coe_schwartzDilate]; exact SchwartzMap.norm_le_seminorm ℝ _ y
  have hint : ∀ w, Integrable (fun t => lpDilate n (lpPsi n) k (z - t) * pieceKernel n α Ω w ℓ t) :=
    fun w => (hΩ.integrable_pieceKernel α w ℓ).bdd_mul
      (((schwartzDilate (lpPsi n) k).continuous.comp (continuous_sub_left z)).aestronglyMeasurable
        |>.congr (ae_of_all _ fun t => by simp [coe_schwartzDilate])) (ae_of_all _ fun t => hψb _)
  rw [unitKernel_apply, unitKernel_apply, ← integral_sub (hint v') (hint v)]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  have hpt : ∀ t, ‖lpDilate n (lpPsi n) k (z - t) * pieceKernel n α Ω v' ℓ t -
      lpDilate n (lpPsi n) k (z - t) * pieceKernel n α Ω v ℓ t‖ₑ ≤
      ENNReal.ofReal ((v' - v) * Q) *
        ENNReal.ofReal (‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t|) := by
    intro t
    by_cases h0 : dyadicPhiScale n ℓ t = 0
    · simp [pieceKernel, h0]
    have ht := (dyadicPhiScale_ne_zero h0).2.le
    have hpk : ‖pieceKernel n α Ω v' ℓ t - pieceKernel n α Ω v ℓ t‖ ≤
        (v' - v) * (‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t|) := by
      rw [pieceKernel, pieceKernel, ← sub_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
      have := norm_exp_sub_exp_le v' v (‖t‖ ^ α)
      rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖t‖ ^ α),
        abs_of_nonneg (sub_nonneg.2 hvv')] at this
      calc _ ≤ (v' - v) * ‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t| :=
            mul_le_mul_of_nonneg_right this (abs_nonneg _)
        _ = _ := by ring
    have hψ : ‖lpDilate n (lpPsi n) k (z - t)‖ ≤ Q := by
      have hc : 0 < (2 : ℝ) ^ k := zpow_pos two_pos k
      have hpow : ((2 : ℝ) : ℂ) ^ (k * (n : ℤ)) = ((((2 : ℝ) ^ k) ^ n : ℝ) : ℂ) := by
        rw [← zpow_natCast, ← zpow_mul, Complex.ofReal_zpow]
      have h1 := hD ((2 : ℝ) ^ k • (z - t))
      rw [norm_smul, Real.norm_of_nonneg hc.le] at h1
      have h2 := one_add_norm_le_decayFactor (z := z) ℓ k ht
      have hfac := decayFactor_pos ℓ k
      have h3 : (1 + ‖z‖) ^ M ≤ decayFactor ℓ k ^ M * (1 + (2 : ℝ) ^ k * ‖z - t‖) ^ M := by
        rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) h2 M
      simp only [lpDilate, hpow, norm_mul, Complex.norm_real, Real.norm_of_nonneg
        (by positivity : (0 : ℝ) ≤ ((2 : ℝ) ^ k) ^ n)]
      rw [hQ, le_div_iff₀ (by positivity)]
      have h4 : (1 + (2 : ℝ) ^ k * ‖z - t‖) ^ M * ‖lpPsi n ((2 : ℝ) ^ k • (z - t))‖ ≤ D₀ := h1
      calc ((2 : ℝ) ^ k) ^ n * ‖lpPsi n ((2 : ℝ) ^ k • (z - t))‖ * (1 + ‖z‖) ^ M
          ≤ ((2 : ℝ) ^ k) ^ n * ‖lpPsi n ((2 : ℝ) ^ k • (z - t))‖ *
              (decayFactor ℓ k ^ M * (1 + (2 : ℝ) ^ k * ‖z - t‖) ^ M) := by gcongr
        _ = ((2 : ℝ) ^ k) ^ n * decayFactor ℓ k ^ M *
              ((1 + (2 : ℝ) ^ k * ‖z - t‖) ^ M * ‖lpPsi n ((2 : ℝ) ^ k • (z - t))‖) := by ring
        _ ≤ ((2 : ℝ) ^ k) ^ n * decayFactor ℓ k ^ M * D₀ := by gcongr
        _ = _ := by ring
    rw [← mul_sub, enorm_mul, ← ofReal_norm, ← ofReal_norm, ← ENNReal.ofReal_mul (norm_nonneg _),
      ← ENNReal.ofReal_mul (mul_nonneg (sub_nonneg.2 hvv') hQ0)]
    refine ENNReal.ofReal_le_ofReal ?_
    calc ‖lpDilate n (lpPsi n) k (z - t)‖ * ‖pieceKernel n α Ω v' ℓ t - pieceKernel n α Ω v ℓ t‖
        ≤ Q * ((v' - v) * (‖t‖ ^ α * |dyadicPhiScale n ℓ t * czKernel n Ω t|)) :=
          mul_le_mul hψ hpk (norm_nonneg _) hQ0
      _ = _ := by ring
  refine (lintegral_mono hpt).trans ?_
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine (mul_le_mul' le_rfl (lintegral_abs_dyadicPhiScale_mul_czKernel_le hC0 hC hα ℓ)).trans
    (le_of_eq ?_)
  rw [← mul_assoc, ← ENNReal.ofReal_mul (mul_nonneg (sub_nonneg.2 hvv') hQ0)]

set_option maxHeartbeats 400000 in
-- The proof elaborates several large `[0, ∞]`-valued expressions involving `eLpNorm`.
/-- **Assembly**: pointwise bounds `V^r_j(x) ≤ c M(P̃_{j+k} f)(x)` give
`‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ c C_M ‖f‖_p` (`r ≥ 2`; Fefferman–Stein and
Littlewood–Paley for `ψ̃`). -/
theorem IsHomogeneousCZKernel.eLpNorm_shortPieceVar_le_of_pointwise {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 0 < α) {r : ℝ} (hr : 2 ≤ r)
    {p : ℝ} (hp : 1 < p) :
    ∃ CM : ℝ≥0∞, CM ≠ ∞ ∧ ∀ (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ)) (c : ℝ≥0∞), c ≠ ∞ →
      (∀ j x, variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ≤
        c * lpMaximal (lpProjTilde n (j + k) f) x) →
      eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        c * CM * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨CM, hCM, hM⟩ := eLpNorm_sqrt_tsum_maximal_lpConv_le hn (lpPsiTilde n)
    (integral_lpPsiTilde n) hp
  refine ⟨CM, hCM, fun ℓ k f c hc h1 => ?_⟩
  have hr0 : 0 < r := by linarith
  obtain ⟨Mf, hMf⟩ : ∃ Mf : ℤ → Rn n → ℝ≥0∞,
      Mf = fun j x => lpMaximal (lpConv (lpPsiTilde n) (j + k) f) x := ⟨_, rfl⟩
  have hpt : ∀ x, shortPieceVar r n α Ω ℓ k f x ≤
      c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ) := by
    intro x
    have h1' : ∀ j : ℤ, variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ≤
        c * Mf j x := fun j => by rw [hMf]; exact h1 j x
    refine (ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun j =>
      ENNReal.rpow_le_rpow (h1' j) hr0.le) (by positivity)).trans ?_
    rw [show (∑' j : ℤ, (c * Mf j x) ^ r) ^ (1 / r) = c * (∑' j : ℤ, Mf j x ^ r) ^ (1 / r) by
      simp_rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le]
      rw [ENNReal.tsum_mul_left, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        rpow_rpow_one_div hr0.ne']]
    refine mul_le_mul' le_rfl ((tsum_rpow_one_div_le (by norm_num) hr _).trans (le_of_eq ?_))
    simp_rw [ENNReal.rpow_two]
  have hGm : AEMeasurable (fun x => (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ)) := by
    refine (AEMeasurable.tsum fun j => ?_).pow_const _
    rw [hMf]
    simp only
    rw [← fsMaximal_eq_lpMaximal, fsMaximal_eq_hlMaximal]
    exact ((fs_measurable_maximal
      (lpConv (lpPsiTilde n) (j + k) f).continuous.aestronglyMeasurable).pow_const 2).aemeasurable
  have key := eLpNorm_const_mul_ennreal hGm hc (show (0 : ℝ) < p by linarith)
  refine (eLpNorm_mono_enorm (g := fun x => c * (∑' j : ℤ, Mf j x ^ 2) ^ (1 / 2 : ℝ))
    (hΩ.measurable_shortPieceVar hα r ℓ k f).aestronglyMeasurable
    fun x => by simpa only [enorm_eq_self] using hpt x).trans ?_
  rw [key, mul_assoc]
  refine mul_le_mul' le_rfl ?_
  rw [hMf]; exact hM k f

/-- `P_k`-localized kernels absorb `P̃`: `ψ^{(j)} * f = ψ^{(j)} * P̃_{j+k} f` for
`ψ = k_{ℓ,k}(·, v)`. -/
theorem lpConv_unitKernel_lpProjTilde {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω)
    (α : ℝ) (ℓ k j : ℤ) (v : ℝ) (f : 𝓢(Rn n, ℂ)) :
    lpConv (unitKernel hΩ α ℓ k v) j f =
      lpConv (unitKernel hΩ α ℓ k v) j (lpProjTilde n (j + k) f) := by
  refine schwartz_eq_of_fourier_eq fun ξ => ?_
  rw [fourier_lpConv, fourier_lpConv, lpProjTilde, fourier_lpConv, fourier_lpPsiTilde,
    fourier_unitKernel]
  simp only
  have he : ((2 : ℝ) ^ k)⁻¹ • ((2 : ℝ) ^ j)⁻¹ • ξ = ((2 : ℝ) ^ (j + k))⁻¹ • ξ := by
    rw [smul_smul, ← mul_inv, ← zpow_add₀ two_ne_zero, add_comm]
  rw [he]
  by_cases h : dyadicPhi n (((2 : ℝ) ^ (j + k))⁻¹ • ξ) = 0
  · rw [h]; simp
  · rw [lpThetaTildeFun_eq_one h]; simp

/-- The size `S_{ℓ,k} = (E₁ E₂)^{1/2}` of the kernel differences in Cases 2 and 3, with
`E₁ = C₁ 2^{ℓα} (2^{ℓα} + π 2^{ℓ+k})^{-N} |B(0, 2^{k+1})|` (nonstationary phase) and
`E₂ = 2^{kn} D₀ c₁^{2(n+1)} 2^{(ℓ+1)α} 4^n C |B₁|` (physical decay). -/
def caseSize (n N : ℕ) (α C₁ D₀ C : ℝ) (ℓ k : ℤ) : ℝ :=
  √((C₁ * dyadicPoint α ℓ * (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ)) *
      volume.real (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (k + 1)))) *
    (((2 : ℝ) ^ k) ^ n * D₀ * decayFactor ℓ k ^ (2 * (n + 1)) *
      ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) * (4 ^ n * C)) * volume.real (Metric.ball (0 : Rn n) 1)))

/-- **Kernel differences in Cases 2 and 3** (paper §4.5):
`|k_{ℓ,k}(z, v') - k_{ℓ,k}(z, v)| ≤ (v' - v) S_{ℓ,k} (1 + |z|)^{-(n+1)}`. -/
theorem IsHomogeneousCZKernel.norm_unitKernel_sub_le_case {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 1 < α) (N : ℕ) :
    ∃ C₁ D₀ C : ℝ, 0 ≤ C₁ ∧ 0 ≤ D₀ ∧ 0 ≤ C ∧ ∀ (ℓ k : ℤ) (v v' : ℝ) (z : Rn n),
      v ∈ paramU α → v' ∈ paramU α → v ≤ v' → (case2Cond α ℓ k ∨ case3Cond α ℓ k) →
      ‖unitKernel hΩ α ℓ k v' z - unitKernel hΩ α ℓ k v z‖ ≤
        (v' - v) * caseSize n N α C₁ D₀ C ℓ k / (1 + ‖z‖) ^ (n + 1) := by
  obtain ⟨C₁, hC₁0, hE1⟩ := hΩ.norm_unitKernel_sub_le_E1 hα N
  obtain ⟨D₀, hD₀0, hD⟩ := lp_schwartz_decay (lpPsi n) (2 * (n + 1)) 0
  obtain ⟨C, hC0, hC⟩ := hΩ.exists_bound
  have hD' : ∀ w, (1 + ‖w‖) ^ (2 * (n + 1)) * ‖lpPsi n w‖ ≤ D₀ := fun w => by
    have := hD w; rwa [norm_iteratedFDeriv_zero] at this
  refine ⟨C₁, D₀, C, hC₁0, hD₀0, hC0, fun ℓ k v v' z hv hv' hvv' hcase => ?_⟩
  set Δ := ‖unitKernel hΩ α ℓ k v' z - unitKernel hΩ α ℓ k v z‖
  set E1 := C₁ * dyadicPoint α ℓ * (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ)) *
      volume.real (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (k + 1)))
  set E2 := ((2 : ℝ) ^ k) ^ n * D₀ * decayFactor ℓ k ^ (2 * (n + 1)) *
      ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) * (4 ^ n * C)) * volume.real (Metric.ball (0 : Rn n) 1)
  have hw : 0 < 1 + ‖z‖ := by positivity
  have hdv : 0 ≤ v' - v := sub_nonneg.2 hvv'
  have hA : Δ ≤ (v' - v) * E1 := by
    have := hE1 ℓ k v v' z hv hv' hvv' hcase
    calc Δ ≤ _ := this
      _ = (v' - v) * E1 := by simp only [E1]; ring
  have hB : Δ ≤ (v' - v) * E2 / ((1 + ‖z‖) ^ (n + 1)) ^ 2 := by
    have h2 := hΩ.enorm_unitKernel_sub_le_E2 (zero_lt_one.trans hα).le hC0 hC hD' ℓ k v v' hvv' z
    rw [← ofReal_measureReal (μ := volume) (s := Metric.ball (0 : Rn n) 1)
      measure_ball_lt_top.ne, ← ENNReal.ofReal_mul (by
        have := decayFactor_pos ℓ k
        have := hD₀0
        positivity), ← ofReal_norm] at h2
    have h3 := (ENNReal.ofReal_le_ofReal_iff (by
        have := decayFactor_pos ℓ k
        positivity)).1 h2
    refine h3.trans (le_of_eq ?_)
    simp only [E2]
    rw [← pow_mul, mul_comm (n + 1) 2]
    field_simp
  have hE1 : 0 ≤ E1 := by
    have := dyadicPoint_pos α ℓ; have := Real.pi_pos; simp only [E1]; positivity
  have hE2 : 0 ≤ E2 := by
    have := decayFactor_pos ℓ k; simp only [E2]; positivity
  have hsq : Δ ^ 2 ≤ ((v' - v) / (1 + ‖z‖) ^ (n + 1)) ^ 2 * (E1 * E2) := by
    have h0 : 0 ≤ Δ := norm_nonneg _
    calc Δ ^ 2 = Δ * Δ := sq Δ
      _ ≤ ((v' - v) * E1) * ((v' - v) * E2 / ((1 + ‖z‖) ^ (n + 1)) ^ 2) :=
          mul_le_mul hA hB h0 (by positivity)
      _ = _ := by field_simp
  have := Real.sqrt_le_sqrt hsq
  rw [Real.sqrt_sq (norm_nonneg _), Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by positivity)]
    at this
  calc Δ ≤ _ := this
    _ = _ := by unfold caseSize; ring

/-- The scaled bracket `2^{jn}(1 + 2^j r)^{-(n+1)}` is nonincreasing in `r ≥ 0`. -/
theorem antitoneOn_scaled_bracket (n : ℕ) (j : ℤ) :
    AntitoneOn (fun r : ℝ => ((2 : ℝ) ^ j) ^ n / (1 + (2 : ℝ) ^ j * r) ^ (n + 1)) (Ici 0) := by
  intro r hr s hs hrs
  have h0 : 0 ≤ (2 : ℝ) ^ j * r := mul_nonneg (zpow_pos two_pos j).le (mem_Ici.1 hr)
  simp only
  gcongr

/-- **Pointwise bound in Cases 2 and 3**: if the kernel differences satisfy
`|k(z, v') - k(z, v)| ≤ (v' - v) S (1 + |z|)^{-(n+1)}`, then
`V^r_j(u ↦ 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x)) ≤ 2^α S A_n M(P̃_{j+k} f)(x)`. -/
theorem IsHomogeneousCZKernel.variationNorm_shortPiece_le_of_kernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} {ℓ k : ℤ} {S : ℝ}
    (hS0 : 0 ≤ S)
    (hK : ∀ (v v' : ℝ) (z : Rn n), v ∈ paramU α → v' ∈ paramU α → v ≤ v' →
      ‖unitKernel hΩ α ℓ k v' z - unitKernel hΩ α ℓ k v z‖ ≤ (v' - v) * S / (1 + ‖z‖) ^ (n + 1))
    {r : ℝ} (hr : 1 ≤ r) (j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ α * S) * bracketConst n *
        lpMaximal (lpProjTilde n (j + k) f) x := by
  set d := dyadicPoint α j
  have hd : 0 < d := dyadicPoint_pos α j
  set h := lpProjTilde n (j + k) f
  have hd1 : dyadicPoint α (j + 1) = d * 2 ^ α := by
    simp only [d, dyadicPoint]; rw [← Real.rpow_add two_pos]; push_cast; ring_nf
  have hrep : ∀ u, shortPiece n α Ω ℓ k f j x u =
      ∫ y, lpDilate n (unitKernel hΩ α ℓ k (u / d)) j (x - y) * h y := by
    intro u
    have := hΩ.modulatedPiece_eq_lpConv_unitKernel α (u / d) ℓ k j f x
    rw [mul_div_cancel₀ u hd.ne', ← lpConv_apply, lpConv_unitKernel_lpProjTilde,
      lpConv_apply] at this
    exact this
  have hbd : ∀ v, ∀ w, ‖lpDilate n (unitKernel hΩ α ℓ k v) j w‖ ≤
      SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (unitKernel hΩ α ℓ k v) j) := fun v w => by
    rw [← coe_schwartzDilate]; exact SchwartzMap.norm_le_seminorm ℝ _ w
  have hint : ∀ v, Integrable (fun y => lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * h y) :=
    fun v => h.integrable.bdd_mul (((schwartzDilate (unitKernel hΩ α ℓ k v) j).continuous.comp
      (continuous_sub_left x)).aestronglyMeasurable.congr (ae_of_all _ fun w => by
        simp [coe_schwartzDilate])) (ae_of_all _ fun w => hbd v _)
  have hmax := lintegral_mul_radial_le_maximal (by omega : 0 < n) (antitoneOn_scaled_bracket n j)
    (fun r hr => by positivity) h.continuous.aestronglyMeasurable x
  rw [lintegral_scaled_bracket] at hmax
  have hlip : ∀ u ∈ shortInterval α j, ∀ u' ∈ shortInterval α j, u ≤ u' →
      ‖shortPiece n α Ω ℓ k f j x u' - shortPiece n α Ω ℓ k f j x u‖ₑ ≤
        (ENNReal.ofReal (S / d) * bracketConst n * lpMaximal h x) * ENNReal.ofReal (u' - u) := by
    intro u hu u' hu' huu'
    have hvU : ∀ w ∈ shortInterval α j, w / d ∈ paramU α := by
      intro w hw
      refine ⟨(le_div_iff₀ hd).2 (by simpa [d] using hw.1), (div_le_iff₀ hd).2 ?_⟩
      rw [mul_comm, ← hd1]; exact hw.2
    have hvv : u / d ≤ u' / d := div_le_div_of_nonneg_right huu' hd.le
    rw [hrep, hrep, ← integral_sub (hint _) (hint _)]
    refine (enorm_integral_le_lintegral_enorm _).trans ?_
    have hpt : ∀ y, ‖lpDilate n (unitKernel hΩ α ℓ k (u' / d)) j (x - y) * h y -
        lpDilate n (unitKernel hΩ α ℓ k (u / d)) j (x - y) * h y‖ₑ ≤
        ENNReal.ofReal ((u' / d - u / d) * S) * (‖h y‖ₑ * ENNReal.ofReal
          (((2 : ℝ) ^ j) ^ n / (1 + (2 : ℝ) ^ j * ‖x - y‖) ^ (n + 1))) := by
      intro y
      have hc : 0 < (2 : ℝ) ^ j := zpow_pos two_pos j
      have hpow : ((2 : ℝ) : ℂ) ^ (j * (n : ℤ)) = ((((2 : ℝ) ^ j) ^ n : ℝ) : ℂ) := by
        rw [← zpow_natCast, ← zpow_mul, Complex.ofReal_zpow]
      have hk := hK (u / d) (u' / d) ((2 : ℝ) ^ j • (x - y)) (hvU u hu) (hvU u' hu') hvv
      rw [norm_smul, Real.norm_of_nonneg hc.le] at hk
      rw [← sub_mul, enorm_mul, mul_comm (‖_‖ₑ), mul_left_comm]
      refine mul_le_mul' le_rfl ?_
      rw [← ofReal_norm, ← ENNReal.ofReal_mul (by
        have := sub_nonneg.2 hvv; positivity)]
      refine ENNReal.ofReal_le_ofReal ?_
      simp only [lpDilate, hpow, ← mul_sub, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (by positivity : (0 : ℝ) ≤ ((2 : ℝ) ^ j) ^ n)]
      calc ((2 : ℝ) ^ j) ^ n * ‖unitKernel hΩ α ℓ k (u' / d) ((2 : ℝ) ^ j • (x - y)) -
            unitKernel hΩ α ℓ k (u / d) ((2 : ℝ) ^ j • (x - y))‖
          ≤ ((2 : ℝ) ^ j) ^ n * ((u' / d - u / d) * S / (1 + (2 : ℝ) ^ j * ‖x - y‖) ^ (n + 1)) :=
            mul_le_mul_of_nonneg_left hk (by positivity)
        _ = _ := by ring
    refine (lintegral_mono hpt).trans ?_
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    calc ENNReal.ofReal ((u' / d - u / d) * S) * ∫⁻ y, ‖h y‖ₑ * ENNReal.ofReal
          (((2 : ℝ) ^ j) ^ n / (1 + (2 : ℝ) ^ j * ‖x - y‖) ^ (n + 1))
        ≤ ENNReal.ofReal ((u' / d - u / d) * S) * (bracketConst n * lpMaximal h x) :=
          mul_le_mul' le_rfl hmax
      _ = _ := by
          rw [show (u' / d - u / d) * S = S / d * (u' - u) by field_simp,
            ENNReal.ofReal_mul (div_nonneg hS0 hd.le)]
          ring
  calc variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x)
      ≤ variationNorm 1 (shortInterval α j) (shortPiece n α Ω ℓ k f j x) :=
        variationNorm_le_variationNorm_one hr _ _
    _ ≤ (ENNReal.ofReal (S / d) * bracketConst n * lpMaximal h x) *
          ENNReal.ofReal (dyadicPoint α (j + 1) - dyadicPoint α j) :=
        variationNorm_one_le_of_lipschitz hlip
    _ ≤ (ENNReal.ofReal (S / d) * bracketConst n * lpMaximal h x) *
          ENNReal.ofReal (d * 2 ^ α) := by
        gcongr; rw [hd1]; linarith
    _ = _ := by
        rw [mul_comm _ (ENNReal.ofReal _), ← mul_assoc, ← mul_assoc,
          ← ENNReal.ofReal_mul (by positivity)]
        congr 3
        field_simp

/-! ### The case division of paper §4.3 and the arithmetic of the regions -/

/-- **Case 1** of paper §4.3 (treated with the vector-valued Seeger theorem, not in this file):
`ℓ ≥ 0`, `ℓ > -k/(2(α+1))`, and neither the Case 2 nor the Case 3 condition holds (so
`k = ℓ(α-1) + O(1)`). -/
def case1Region (α : ℝ) (ℓ k : ℤ) : Prop :=
  0 ≤ ℓ ∧ ¬ smallRegion α ℓ k ∧ ¬ case2Cond α ℓ k ∧ ¬ case3Cond α ℓ k

/-- The remaining region `ℓ > -k/(2(α+1))` outside Case 1 (Cases 2, 3 and finitely many pairs
with `ℓ < 0`), treated directly in this file. -/
def restRegion (α : ℝ) (ℓ k : ℤ) : Prop := ¬ smallRegion α ℓ k ∧ ¬ case1Region α ℓ k

/-- Integer powers of `2` as real powers. -/
theorem two_zpow_eq_rpow (k : ℤ) : (2 : ℝ) ^ k = (2 : ℝ) ^ (k : ℝ) := (Real.rpow_intCast 2 k).symm

/-- Case 2 forces `ℓα < ℓ + k`. -/
theorem lt_of_case2Cond {α : ℝ} (hα : 1 < α) {ℓ k : ℤ} (h : case2Cond α ℓ k) :
    (ℓ : ℝ) * α < ℓ + k := by
  unfold case2Cond dyadicPoint at h
  have h1 : (2 : ℝ) ≤ 2 ^ α := by
    simpa using Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hα.le
  have h2 : (1 : ℝ) ≤ 2 ^ |α - 1| := Real.one_le_rpow (by norm_num) (abs_nonneg _)
  have hK : 4 ≤ 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| := by
    calc (4 : ℝ) = 2 * 2 * 1 := by norm_num
      _ ≤ 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| := by
          gcongr
          linarith
  have hp : 0 < (2 : ℝ) ^ ((ℓ : ℝ) * α) := by positivity
  have hpi := Real.pi_lt_four
  rw [two_zpow_eq_rpow] at h
  have h3 : (2 : ℝ) ^ ((ℓ : ℝ) * α) < (2 : ℝ) ^ (((ℓ + k : ℤ) : ℝ)) := by
    have h4 : (0 : ℝ) < 2 ^ (((ℓ + k : ℤ) : ℝ)) := by positivity
    nlinarith
  have := (Real.rpow_lt_rpow_left_iff (by norm_num : (1 : ℝ) < 2)).1 h3
  push_cast at this; linarith

/-- `α 2^{-|α-1|} ≤ 2` for `α ≥ 1`. -/
theorem mul_two_rpow_neg_abs_le {α : ℝ} (hα : 1 ≤ α) : α * (2 : ℝ) ^ (-|α - 1|) ≤ 2 := by
  have hb : 1 + α * 1 ≤ (1 + 1 : ℝ) ^ α := one_add_mul_self_le_rpow_one_add (by norm_num) hα
  rw [abs_of_nonneg (by linarith), Real.rpow_neg (by norm_num), ← div_eq_mul_inv,
    div_le_iff₀ (by positivity), Real.rpow_sub (by norm_num), Real.rpow_one]
  norm_num at hb
  rw [mul_div_cancel₀ _ (by norm_num : (2 : ℝ) ≠ 0)]
  linarith

/-- Case 3 forces `ℓ + k < ℓα`. -/
theorem lt_of_case3Cond {α : ℝ} (hα : 1 < α) {ℓ k : ℤ} (h : case3Cond α ℓ k) :
    (ℓ : ℝ) + k < ℓ * α := by
  unfold case3Cond dyadicPoint at h
  have h1 := mul_two_rpow_neg_abs_le hα.le
  have hp : 0 < (2 : ℝ) ^ ((ℓ : ℝ) * α) := by positivity
  have hpi := Real.pi_gt_three
  rw [two_zpow_eq_rpow] at h
  have h3 : (2 : ℝ) ^ (((ℓ + k : ℤ) : ℝ)) < (2 : ℝ) ^ ((ℓ : ℝ) * α) := by
    have h4 : (0 : ℝ) < 2 ^ (((ℓ + k : ℤ) : ℝ)) := by positivity
    nlinarith [mul_le_mul_of_nonneg_right h1 hp.le]
  have := (Real.rpow_lt_rpow_left_iff (by norm_num : (1 : ℝ) < 2)).1 h3
  push_cast at this; linarith

/-- In Case 2 outside the small region: `ℓ + k ≥ (|ℓ| + |k|)/4`. -/
theorem quarter_le_of_case2 {α : ℝ} (hα : 1 < α) {ℓ k : ℤ} (hs : ¬ smallRegion α ℓ k)
    (h : case2Cond α ℓ k) : (|(ℓ : ℝ)| + |(k : ℝ)|) / 4 ≤ ℓ + k := by
  have h2 := lt_of_case2Cond hα h
  unfold smallRegion at hs
  push Not at hs
  rcases le_or_gt 0 (ℓ : ℝ) with hl | hl
  · have hk : (0 : ℝ) ≤ k := by nlinarith
    rw [abs_of_nonneg hl, abs_of_nonneg hk]; linarith
  · have hk : (0 : ℝ) ≤ k := by nlinarith
    rw [abs_of_neg hl, abs_of_nonneg hk]
    nlinarith

/-- In Case 3 outside the small region: `ℓα ≥ α (|ℓ| + |k|)/(2α + 3)`. -/
theorem le_of_case3 {α : ℝ} (hα : 1 < α) {ℓ k : ℤ} (hs : ¬ smallRegion α ℓ k)
    (h : case3Cond α ℓ k) : α * (|(ℓ : ℝ)| + |(k : ℝ)|) / (2 * α + 3) ≤ ℓ * α := by
  have h3 := lt_of_case3Cond hα h
  unfold smallRegion at hs
  push Not at hs
  have hl : (0 : ℝ) < ℓ := by
    by_contra hl; push Not at hl; nlinarith
  rw [abs_of_pos hl, div_le_iff₀ (by linarith)]
  rcases le_or_gt 0 (k : ℝ) with hk | hk
  · rw [abs_of_nonneg hk]; nlinarith
  · rw [abs_of_neg hk]; nlinarith

/-- The exceptional pairs (`ℓ < 0`, not small, not Case 2) are bounded:
`2^{(|ℓ| + |k|)/4} ≤ 2α 2^α 2^{|α-1|}/π`. -/
theorem rpow_le_of_not_case2 {α : ℝ} (hα : 1 < α) {ℓ k : ℤ} (hs : ¬ smallRegion α ℓ k)
    (hl : ℓ < 0) (h : ¬ case2Cond α ℓ k) :
    (2 : ℝ) ^ ((|(ℓ : ℝ)| + |(k : ℝ)|) / 4) ≤ 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| / Real.pi := by
  unfold case2Cond dyadicPoint at h
  push Not at h
  unfold smallRegion at hs
  push Not at hs
  have hl' : (ℓ : ℝ) < 0 := by exact_mod_cast hl
  have hk : (0 : ℝ) ≤ k := by nlinarith
  have hq : (|(ℓ : ℝ)| + |(k : ℝ)|) / 4 ≤ ℓ + k := by
    rw [abs_of_neg hl', abs_of_nonneg hk]; nlinarith
  have hlam1 : (2 : ℝ) ^ ((ℓ : ℝ) * α) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by nlinarith)
  have hK : 0 ≤ 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| := by have := hα; positivity
  rw [le_div_iff₀ Real.pi_pos]
  calc (2 : ℝ) ^ ((|(ℓ : ℝ)| + |(k : ℝ)|) / 4) * Real.pi
      ≤ (2 : ℝ) ^ (((ℓ + k : ℤ) : ℝ)) * Real.pi := by
        gcongr
        · norm_num
        · push_cast; exact hq
    _ = Real.pi * (2 : ℝ) ^ (ℓ + k) := by rw [two_zpow_eq_rpow (ℓ + k)]; ring
    _ ≤ 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| * 2 ^ ((ℓ : ℝ) * α) := h.le
    _ ≤ 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| * 1 := by gcongr
    _ = _ := mul_one _

/-- The decay rate `c₀ = α/(4(2α+3))` of `2^{ℓα} + π 2^{ℓ+k}` in Cases 2 and 3. -/
def caseRate (α : ℝ) : ℝ := α / (4 * (2 * α + 3))

/-- The polynomial growth exponent `A = 2α + 2n + 2(n+1)` of the remaining factors. -/
def caseGrowth (n : ℕ) (α : ℝ) : ℝ := 2 * α + 2 * n + 2 * (n + 1)

/-- The order `N` of nonstationary phase used in Cases 2 and 3: `N c₀ ≥ A + 2`. -/
def caseOrder (n : ℕ) (α : ℝ) : ℕ := ⌈(caseGrowth n α + 2) / caseRate α⌉₊

/-- The choice of `N`: `N c₀ ≥ A + 2`. -/
theorem caseOrder_mul_le {n : ℕ} {α : ℝ} (hα : 0 < α) :
    caseGrowth n α + 2 ≤ caseOrder n α * caseRate α := by
  have hc : 0 < caseRate α := by unfold caseRate; positivity
  rw [← div_le_iff₀ hc]; exact Nat.le_ceil _

/-- The lower bound `2^{ℓα} + π 2^{ℓ+k} ≥ 2^{c₀ (|ℓ| + |k|)}` in Cases 2 and 3. -/
theorem rpow_caseRate_le {α : ℝ} (hα : 1 < α) {ℓ k : ℤ} (hs : ¬ smallRegion α ℓ k)
    (hc : case2Cond α ℓ k ∨ case3Cond α ℓ k) :
    (2 : ℝ) ^ (caseRate α * (|(ℓ : ℝ)| + |(k : ℝ)|)) ≤
      dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k) := by
  have hm : 0 ≤ |(ℓ : ℝ)| + |(k : ℝ)| := by positivity
  have hα0 : 0 < α := by linarith
  have hlam : 0 < dyadicPoint α ℓ := dyadicPoint_pos α ℓ
  have hz : (0 : ℝ) < 2 ^ (ℓ + k) := zpow_pos two_pos _
  rcases hc with h | h
  · have hq := quarter_le_of_case2 hα hs h
    have hc4 : caseRate α ≤ 1 / 4 := by
      unfold caseRate; rw [div_le_iff₀ (by positivity)]; nlinarith
    calc (2 : ℝ) ^ (caseRate α * (|(ℓ : ℝ)| + |(k : ℝ)|))
        ≤ (2 : ℝ) ^ (((ℓ + k : ℤ) : ℝ)) := by
          refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
          push_cast; nlinarith
      _ = (2 : ℝ) ^ (ℓ + k) := (two_zpow_eq_rpow _).symm
      _ ≤ _ := by nlinarith [Real.pi_gt_three]
  · have hq := le_of_case3 hα hs h
    have hc4 : caseRate α ≤ α / (2 * α + 3) := by
      unfold caseRate
      exact div_le_div_of_nonneg_left hα0.le (by positivity) (by linarith)
    calc (2 : ℝ) ^ (caseRate α * (|(ℓ : ℝ)| + |(k : ℝ)|))
        ≤ (2 : ℝ) ^ ((ℓ : ℝ) * α) := by
          refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
          calc caseRate α * (|(ℓ : ℝ)| + |(k : ℝ)|)
              ≤ α / (2 * α + 3) * (|(ℓ : ℝ)| + |(k : ℝ)|) := by gcongr
            _ = α * (|(ℓ : ℝ)| + |(k : ℝ)|) / (2 * α + 3) := by ring
            _ ≤ _ := hq
      _ = dyadicPoint α ℓ := rfl
      _ ≤ _ := by nlinarith [Real.pi_gt_three]

/-- `2^ℓ ≤ 2^{|ℓ|}` etc. -/
theorem two_zpow_le_rpow_abs (k : ℤ) : (2 : ℝ) ^ k ≤ (2 : ℝ) ^ (|(k : ℝ)|) := by
  rw [two_zpow_eq_rpow]
  exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (le_abs_self _)

/-- `c₁ ≤ 2^{|ℓ| + |k| + 2}`. -/
theorem decayFactor_le (ℓ k : ℤ) :
    decayFactor ℓ k ≤ (2 : ℝ) ^ (|(ℓ : ℝ)| + |(k : ℝ)| + 2) := by
  unfold decayFactor
  have h1 : 1 + (2 : ℝ) ^ (ℓ + 1) ≤ (2 : ℝ) ^ (|(ℓ : ℝ)| + 2) := by
    have ha : (2 : ℝ) ^ (ℓ + 1) ≤ (2 : ℝ) ^ (|(ℓ : ℝ)| + 1) := by
      rw [two_zpow_eq_rpow]
      exact Real.rpow_le_rpow_of_exponent_le (by norm_num)
        (by push_cast; linarith [le_abs_self (ℓ : ℝ)])
    have hb : (1 : ℝ) ≤ (2 : ℝ) ^ (|(ℓ : ℝ)| + 1) :=
      Real.one_le_rpow (by norm_num) (by positivity)
    have he : (2 : ℝ) ^ (|(ℓ : ℝ)| + 2) = 2 * (2 : ℝ) ^ (|(ℓ : ℝ)| + 1) := by
      rw [show |(ℓ : ℝ)| + 2 = 1 + (|(ℓ : ℝ)| + 1) by ring, Real.rpow_add two_pos,
        Real.rpow_one]
    linarith
  have h2 : max 1 ((2 : ℝ) ^ (-k)) ≤ (2 : ℝ) ^ (|(k : ℝ)|) := by
    refine max_le (Real.one_le_rpow (by norm_num) (abs_nonneg _)) ?_
    refine (two_zpow_le_rpow_abs (-k)).trans (le_of_eq ?_)
    push_cast; rw [abs_neg]
  calc (1 + (2 : ℝ) ^ (ℓ + 1)) * max 1 ((2 : ℝ) ^ (-k))
      ≤ (2 : ℝ) ^ (|(ℓ : ℝ)| + 2) * (2 : ℝ) ^ (|(k : ℝ)|) :=
        mul_le_mul h1 h2 (by positivity) (by positivity)
    _ = _ := by rw [← Real.rpow_add two_pos]; ring_nf

/-- **Decay of the Case 2/3 sizes**: with `N = caseOrder n α`,
`S_{ℓ,k} ≤ K^{1/2} 2^{-(|ℓ| + |k|)}` for all `(ℓ, k)` in Cases 2, 3 outside the small region. -/
theorem caseSize_le {n : ℕ} {α : ℝ} (hα : 1 < α) {C₁ D₀ C : ℝ} (hC₁ : 0 ≤ C₁) (hD₀ : 0 ≤ D₀)
    (hC : 0 ≤ C) {ℓ k : ℤ} (hs : ¬ smallRegion α ℓ k)
    (hc : case2Cond α ℓ k ∨ case3Cond α ℓ k) :
    caseSize n (caseOrder n α) α C₁ D₀ C ℓ k ≤
      √(C₁ * D₀ * (4 ^ n * C) * volume.real (Metric.ball (0 : Rn n) 1) ^ 2 *
        (2 : ℝ) ^ ((n : ℝ) + 2 * 2 * (n + 1) + α)) *
        (2 : ℝ) ^ (-(|(ℓ : ℝ)| + |(k : ℝ)|)) := by
  set m := |(ℓ : ℝ)| + |(k : ℝ)| with hm_def
  have hm : 0 ≤ m := by positivity
  have hα0 : 0 < α := by linarith
  set N := caseOrder n α
  set V := volume.real (Metric.ball (0 : Rn n) 1)
  have hV : 0 ≤ V := measureReal_nonneg
  set e : ℝ → ℝ := fun x => (2 : ℝ) ^ x with he
  have emono : ∀ {x y : ℝ}, x ≤ y → e x ≤ e y := fun h =>
    Real.rpow_le_rpow_of_exponent_le (by norm_num) h
  have epos : ∀ x, 0 < e x := fun x => by simp only [e]; positivity
  have eadd : ∀ x y, e (x + y) = e x * e y := fun x y => Real.rpow_add two_pos x y
  -- the individual factors
  have f1 : dyadicPoint α ℓ ≤ e (α * m) := by
    have hl : (ℓ : ℝ) ≤ m := (le_abs_self _).trans (le_add_of_nonneg_right (abs_nonneg _))
    exact emono (by nlinarith)
  have hX := rpow_caseRate_le hα hs hc
  have f2 : (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ)) ≤
      e (-(N * caseRate α * m)) := by
    calc (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ))
        ≤ ((2 : ℝ) ^ (caseRate α * m)) ^ (-(N : ℝ)) :=
          Real.rpow_le_rpow_of_nonpos (by positivity) hX (by simp)
      _ = _ := by rw [← Real.rpow_mul (by norm_num)]; congr 1; ring
  have f3 : volume.real (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (k + 1))) ≤
      e (n * (m + 1)) * V := by
    rw [Measure.addHaar_real_closedBall _ _ (by positivity), finrank_euclideanSpace_fin]
    refine mul_le_mul_of_nonneg_right ?_ hV
    rw [two_zpow_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    refine emono ?_
    push_cast
    nlinarith [le_abs_self (k : ℝ), abs_nonneg (ℓ : ℝ), (Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
  have f4 : ((2 : ℝ) ^ k) ^ n ≤ e (n * m) := by
    rw [two_zpow_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    refine emono ?_
    nlinarith [le_abs_self (k : ℝ), abs_nonneg (ℓ : ℝ), (Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
  have f5 : decayFactor ℓ k ^ (2 * (n + 1)) ≤ e ((m + 2) * (2 * (n + 1))) := by
    calc decayFactor ℓ k ^ (2 * (n + 1)) ≤ (e (m + 2)) ^ (2 * (n + 1)) :=
          pow_le_pow_left₀ (decayFactor_pos ℓ k).le (decayFactor_le ℓ k) _
      _ = _ := by
          simp only [e]
          rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]; push_cast; ring_nf
  have f6 : (2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) ≤ e ((m + 1) * α) := emono (by
    refine mul_le_mul_of_nonneg_right ?_ hα0.le
    linarith [le_abs_self (ℓ : ℝ), abs_nonneg (k : ℝ)])
  have hNc := caseOrder_mul_le (n := n) hα0
  unfold caseGrowth at hNc
  -- combine
  have hY : (C₁ * dyadicPoint α ℓ * (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ)) *
        volume.real (Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ (k + 1)))) *
      (((2 : ℝ) ^ k) ^ n * D₀ * decayFactor ℓ k ^ (2 * (n + 1)) *
        ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) * (4 ^ n * C)) * V) ≤
      (C₁ * D₀ * (4 ^ n * C) * V ^ 2 * e ((n : ℝ) + 2 * 2 * (n + 1) + α)) * e (-(2 * m)) := by
    have hp1 : 0 ≤ (dyadicPoint α ℓ + Real.pi * (2 : ℝ) ^ (ℓ + k)) ^ (-(N : ℝ)) := by
      have := dyadicPoint_pos α ℓ; have := Real.pi_pos; positivity
    set a1 := α * m
    set a2 := -(N * caseRate α * m)
    set a3 := (n : ℝ) * (m + 1)
    set a4 := (n : ℝ) * m
    set a5 := (m + 2) * (2 * ((n : ℝ) + 1))
    set a6 := (m + 1) * α
    have hprod : e a1 * e a2 * e a3 * e a4 * e a5 * e a6 = e (a1 + a2 + a3 + a4 + a5 + a6) := by
      simp only [eadd]
    have hsum : a1 + a2 + a3 + a4 + a5 + a6 ≤ ((n : ℝ) + 2 * 2 * (n + 1) + α) + -(2 * m) := by
      simp only [a1, a2, a3, a4, a5, a6]
      nlinarith [mul_le_mul_of_nonneg_right hNc hm]
    calc _ ≤ (C₁ * e a1 * e a2 * (e a3 * V)) *
          (e a4 * D₀ * e a5 * (e a6 * (4 ^ n * C)) * V) := by
          gcongr <;> first | positivity | exact (dyadicPoint_pos α ℓ).le |
            exact (decayFactor_pos ℓ k).le | exact pow_nonneg (decayFactor_pos ℓ k).le _ |
            exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by positivity) hD₀)
              (pow_nonneg (decayFactor_pos ℓ k).le _)) (by positivity)) hV
      _ = (C₁ * D₀ * (4 ^ n * C) * V ^ 2) * (e a1 * e a2 * e a3 * e a4 * e a5 * e a6) := by
          ring
      _ = (C₁ * D₀ * (4 ^ n * C) * V ^ 2) * e (a1 + a2 + a3 + a4 + a5 + a6) := by rw [hprod]
      _ ≤ (C₁ * D₀ * (4 ^ n * C) * V ^ 2) *
            (e ((n : ℝ) + 2 * 2 * (n + 1) + α) * e (-(2 * m))) := by
          rw [← eadd]; gcongr; exact emono hsum
      _ = _ := by ring
  unfold caseSize
  calc √(_) ≤ √((C₁ * D₀ * (4 ^ n * C) * V ^ 2 * e ((n : ℝ) + 2 * 2 * (n + 1) + α)) *
        e (-(2 * m))) := Real.sqrt_le_sqrt hY
    _ = _ := by
        rw [Real.sqrt_mul (by have := epos ((n : ℝ) + 2 * 2 * (n + 1) + α); positivity)]
        congr 1
        rw [show -(2 * m) = -m * 2 by ring]
        simp only [e]
        rw [Real.rpow_mul (by norm_num), Real.rpow_two, Real.sqrt_sq (by positivity)]

open Classical in
/-- The indicator of the remaining region (Cases 2, 3 and the exceptional pairs) in `[0, ∞]`. -/
def restRegionInd (α : ℝ) (ℓ k : ℤ) : ℝ≥0∞ := if restRegion α ℓ k then 1 else 0

open Classical in
/-- The indicator of Case 1 in `[0, ∞]`. -/
def case1RegionInd (α : ℝ) (ℓ k : ℤ) : ℝ≥0∞ := if case1Region α ℓ k then 1 else 0

/-- Per-pair bound in the remaining region:
`‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ G 2^{-(|ℓ| + |k|)} ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_shortPieceVar_restRegion_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {r : ℝ} (hr : 2 ≤ r)
    {p : ℝ} (hp : 1 < p) :
    ∃ G : ℝ≥0∞, G ≠ ∞ ∧ ∀ (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ)), restRegion α ℓ k →
      eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        G * eLpNorm f (ENNReal.ofReal p) *
          ENNReal.ofReal ((2 : ℝ) ^ (-(1 * (|(ℓ : ℝ)| + |(k : ℝ)|)))) := by
  have hα0 : 0 < α := by linarith
  obtain ⟨C₁, D₀, C, hC₁, hD₀, hC, hK⟩ := hΩ.norm_unitKernel_sub_le_case hα (caseOrder n α)
  obtain ⟨CM, hCM, hA⟩ := hΩ.eLpNorm_shortPieceVar_le_of_pointwise hn hα0 hr hp
  obtain ⟨CE, hCE, hE1⟩ := hΩ.est1 hn hα0 hr hp
  obtain ⟨Ksz, hKsz⟩ : ∃ Ksz : ℝ, Ksz = √(C₁ * D₀ * (4 ^ n * C) *
      volume.real (Metric.ball (0 : Rn n) 1) ^ 2 * (2 : ℝ) ^ ((n : ℝ) + 2 * 2 * (n + 1) + α)) :=
    ⟨_, rfl⟩
  obtain ⟨Kc, hKcd⟩ : ∃ Kc : ℝ, Kc = 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| / Real.pi := ⟨_, rfl⟩
  obtain ⟨G₁, hG₁d⟩ : ∃ G₁ : ℝ≥0∞,
      G₁ = ENNReal.ofReal ((2 : ℝ) ^ α * Ksz) * bracketConst n * CM := ⟨_, rfl⟩
  obtain ⟨G₂, hG₂d⟩ : ∃ G₂ : ℝ≥0∞, G₂ = CE * ENNReal.ofReal (Kc ^ 4) := ⟨_, rfl⟩
  have hG₁ : G₁ ≠ ∞ := by
    rw [hG₁d]; exact ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (bracketConst_ne_top n)) hCM
  have hG₂ : G₂ ≠ ∞ := by rw [hG₂d]; exact ENNReal.mul_ne_top hCE ENNReal.ofReal_ne_top
  refine ⟨max G₁ G₂, max_ne_top hG₁ hG₂, fun ℓ k f hrest => ?_⟩
  obtain ⟨m, hmd⟩ : ∃ m : ℝ, m = |(ℓ : ℝ)| + |(k : ℝ)| := ⟨_, rfl⟩
  have hm : 0 ≤ m := by rw [hmd]; positivity
  rw [← hmd]
  rw [one_mul]
  obtain ⟨hs, hc1⟩ := hrest
  by_cases hc : case2Cond α ℓ k ∨ case3Cond α ℓ k
  · obtain ⟨S, hSd⟩ : ∃ S : ℝ, S = caseSize n (caseOrder n α) α C₁ D₀ C ℓ k := ⟨_, rfl⟩
    have hS0 : 0 ≤ S := by rw [hSd]; exact Real.sqrt_nonneg _
    have hSle := caseSize_le (n := n) hα hC₁ hD₀ hC hs hc
    rw [← hSd, ← hKsz, ← hmd] at hSle
    have hV := fun j x => hΩ.variationNorm_shortPiece_le_of_kernel hn hS0
      (fun v v' z hv hv' hvv' => hSd ▸ hK ℓ k v v' z hv hv' hvv' hc)
      (by linarith : (1 : ℝ) ≤ r) j f x
    refine (hA ℓ k f _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (bracketConst_ne_top n))
      hV).trans ?_
    have h2 : ENNReal.ofReal ((2 : ℝ) ^ α * S) ≤
        ENNReal.ofReal ((2 : ℝ) ^ α * Ksz) * ENNReal.ofReal ((2 : ℝ) ^ (-m)) := by
      have hKsz0 : 0 ≤ Ksz := by rw [hKsz]; exact Real.sqrt_nonneg _
      rw [← ENNReal.ofReal_mul (mul_nonneg (by positivity) hKsz0)]
      refine ENNReal.ofReal_le_ofReal ?_
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left hSle (by positivity)
    have e1 : ENNReal.ofReal ((2 : ℝ) ^ α * Ksz) * ENNReal.ofReal ((2 : ℝ) ^ (-m)) *
        bracketConst n * CM * eLpNorm f (ENNReal.ofReal p) =
        G₁ * eLpNorm f (ENNReal.ofReal p) * ENNReal.ofReal ((2 : ℝ) ^ (-m)) := by
      rw [hG₁d]; ring
    refine (mul_le_mul' (mul_le_mul' (mul_le_mul' h2 le_rfl) le_rfl) le_rfl).trans ?_
    rw [e1]
    exact mul_le_mul' (mul_le_mul' (le_max_left _ _) le_rfl) le_rfl
  · push Not at hc
    have hl : ℓ < 0 := by
      by_contra hl
      exact hc1 ⟨not_lt.1 hl, hs, hc.1, hc.2⟩
    have hb := rpow_le_of_not_case2 hα hs hl hc.1
    rw [← hKcd, ← hmd] at hb
    have hKc : 0 ≤ Kc := le_trans (by positivity) hb
    have h1 : (2 : ℝ) ^ ((ℓ : ℝ) * α) ≤ Kc ^ 4 * (2 : ℝ) ^ (-m) := by
      have hl' : (ℓ : ℝ) < 0 := by exact_mod_cast hl
      have h3 : (2 : ℝ) ^ ((ℓ : ℝ) * α) ≤ 1 :=
        Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by nlinarith)
      have h4 : (2 : ℝ) ^ m ≤ Kc ^ 4 := by
        calc (2 : ℝ) ^ m = ((2 : ℝ) ^ (m / 4)) ^ 4 := by
              rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]; push_cast; ring_nf
          _ ≤ Kc ^ 4 := pow_le_pow_left₀ (by positivity) hb 4
      have h5 : (2 : ℝ) ^ m * (2 : ℝ) ^ (-m) = 1 := by
        rw [← Real.rpow_add two_pos]; simp
      have h6 : 0 < (2 : ℝ) ^ (-m) := by positivity
      nlinarith
    refine (hE1 ℓ k f).trans ?_
    have h7 : ENNReal.ofReal ((2 : ℝ) ^ ((ℓ : ℝ) * α)) ≤
        ENNReal.ofReal (Kc ^ 4) * ENNReal.ofReal ((2 : ℝ) ^ (-m)) := by
      rw [← ENNReal.ofReal_mul (by positivity)]; exact ENNReal.ofReal_le_ofReal h1
    have e2 : CE * (ENNReal.ofReal (Kc ^ 4) * ENNReal.ofReal ((2 : ℝ) ^ (-m))) *
        eLpNorm f (ENNReal.ofReal p) =
        G₂ * eLpNorm f (ENNReal.ofReal p) * ENNReal.ofReal ((2 : ℝ) ^ (-m)) := by
      rw [hG₂d]; ring
    refine (mul_le_mul' (mul_le_mul' le_rfl h7) le_rfl).trans ?_
    rw [e2]
    exact mul_le_mul' (mul_le_mul' (le_max_right _ _) le_rfl) le_rfl

/-- **Cases 2, 3 summed** (paper §4.5, the remaining region `ℓ > -k/(2(α+1))` outside Case 1):
for `α > 1`, `1 < p < ∞`, `r ≥ 2`,
`∑_{(ℓ,k) ∈ rest} ‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ C ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.tsum_eLpNorm_shortPieceVar_restRegion_le {n : ℕ}
    {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α)
    {r : ℝ} (hr : 2 ≤ r) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ f : 𝓢(Rn n, ℂ),
      ∑' ℓ : ℤ, ∑' k : ℤ, restRegionInd α ℓ k *
        eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        C * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨G, hG, hterm⟩ := hΩ.eLpNorm_shortPieceVar_restRegion_le hn hα hr hp
  obtain ⟨S, hS⟩ : ∃ S : ℝ≥0∞, S = ∑' ℓ : ℤ, ∑' k : ℤ,
      ENNReal.ofReal ((2 : ℝ) ^ (-(1 * (|(ℓ : ℝ)| + |(k : ℝ)|)))) := ⟨_, rfl⟩
  refine ⟨G * S, ENNReal.mul_ne_top hG (by rw [hS]; exact tsum_tsum_two_rpow_neg_ne_top one_pos),
    fun f => ?_⟩
  have hb : ∀ ℓ k : ℤ, restRegionInd α ℓ k *
      eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
      G * eLpNorm f (ENNReal.ofReal p) *
        ENNReal.ofReal ((2 : ℝ) ^ (-(1 * (|(ℓ : ℝ)| + |(k : ℝ)|)))) := by
    intro ℓ k
    unfold restRegionInd
    split_ifs with h
    · rw [one_mul]; exact hterm ℓ k f h
    · rw [zero_mul]; exact zero_le
  refine (ENNReal.tsum_le_tsum fun ℓ => ENNReal.tsum_le_tsum fun k => hb ℓ k).trans
    (le_of_eq ?_)
  simp_rw [ENNReal.tsum_mul_left]
  rw [hS]; ring

/-! ## Assembly of the short variation estimate (paper (`eq:mainest_Sect4`)) -/

/-- Finite Minkowski inequality for `[0, ∞]`-valued functions. -/
theorem eLpNorm_finsetSum_le_ennreal {X ι : Type*} [MeasurableSpace X] {μ : Measure X}
    (s : Finset ι) (F : ι → X → ℝ≥0∞) {p : ℝ≥0∞} (hp : 1 ≤ p) :
    eLpNorm (fun x => ∑ i ∈ s, F i x) p μ ≤ ∑ i ∈ s, eLpNorm (F i) p μ := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    exact (eLpNorm_zero (ε := ℝ≥0∞)).le.trans le_rfl
  | insert i s hi ih =>
    simp_rw [Finset.sum_insert hi]
    exact (eLpNorm_add_le (f := F i) (g := fun x => ∑ i ∈ s, F i x) hp).trans
      (add_le_add le_rfl ih)

/-- **Countable Minkowski inequality** for `[0, ∞]`-valued measurable functions indexed by `ℤ`:
`‖∑_j F_j‖_p ≤ ∑_j ‖F_j‖_p` (`1 ≤ p < ∞`). -/
theorem eLpNorm_tsum_int_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F : ℤ → X → ℝ≥0∞} (hF : ∀ j, AEMeasurable (F j) μ) {p : ℝ} (hp : 1 ≤ p) :
    eLpNorm (fun x => ∑' j, F j x) (ENNReal.ofReal p) μ ≤
      ∑' j, eLpNorm (F j) (ENNReal.ofReal p) μ := by
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using hp
  have h := eLpNorm_tsum_rpow_le_of_partial (q := 1) (μ := μ) hF (by linarith : (0 : ℝ) < p)
    (B := ∑' j, eLpNorm (F j) (ENNReal.ofReal p) μ) fun N => by
      simp only [ENNReal.rpow_one]
      exact (eLpNorm_finsetSum_le_ennreal _ F hp1).trans (ENNReal.sum_le_tsum _)
  simpa only [ENNReal.rpow_one] using h

/-- The three regions partition `ℤ × ℤ`: `𝟙_small + 𝟙_{Case 1} + 𝟙_rest = 1`. -/
theorem smallRegionInd_add_case1RegionInd_add_restRegionInd (α : ℝ) (ℓ k : ℤ) :
    smallRegionInd α ℓ k + case1RegionInd α ℓ k + restRegionInd α ℓ k = 1 := by
  unfold smallRegionInd case1RegionInd restRegionInd
  by_cases hs : smallRegion α ℓ k
  · have h1 : ¬ case1Region α ℓ k := fun h => h.2.1 hs
    have h2 : ¬ restRegion α ℓ k := fun h => h.1 hs
    simp only [hs, h1, h2, ↓reduceIte, add_zero]
  · by_cases h1 : case1Region α ℓ k
    · have h2 : ¬ restRegion α ℓ k := fun h => h.2 h1
      simp only [hs, h1, h2, ↓reduceIte, add_zero, zero_add]
    · have h2 : restRegion α ℓ k := ⟨hs, h1⟩
      simp only [hs, h1, h2, ↓reduceIte, zero_add]

/-- **The short variation estimate modulo Case 1** (paper (`eq:mainest_Sect4`), (`eq:mainest`)):
for `α > 1`, `1 < p < ∞`, `r ≥ 2` there is `C < ∞` such that for Schwartz `f`, whenever the
Case 1 pieces satisfy `∑_{(ℓ,k) ∈ Case 1} ‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤
C₁ ‖f‖_p`, then `‖S_r(𝓗 f)‖_p ≤ (C + C₁) ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_shortVariation_le_of_case1 {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {r : ℝ} (hr : 2 ≤ r)
    {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (C₁ : ℝ≥0∞) (f : 𝓢(Rn n, ℂ)),
      ∑' ℓ : ℤ, ∑' k : ℤ, case1RegionInd α ℓ k *
          eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        C₁ * eLpNorm f (ENNReal.ofReal p) →
      eLpNorm (fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) ≤ (C + C₁) * eLpNorm f (ENNReal.ofReal p) := by
  have hα0 : 0 < α := by linarith
  obtain ⟨Cs, hCs, hs⟩ := hΩ.tsum_eLpNorm_shortPieceVar_smallRegion_le hn hα0 hr hp
  obtain ⟨Cr, hCr, hrest⟩ := hΩ.tsum_eLpNorm_shortPieceVar_restRegion_le hn hα hr hp
  refine ⟨Cs + Cr, ENNReal.add_ne_top.2 ⟨hCs, hCr⟩, fun C₁ f h1 => ?_⟩
  have hm : ∀ ℓ k, Measurable (shortPieceVar r n α Ω ℓ k f) := fun ℓ k =>
    hΩ.measurable_shortPieceVar hα0 r ℓ k f
  obtain ⟨E, hE⟩ : ∃ E : ℤ → ℤ → ℝ≥0∞,
      E = fun ℓ k => eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) := ⟨_, rfl⟩
  have hstep1 : eLpNorm (fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x))
      (ENNReal.ofReal p) ≤ eLpNorm (fun x => ∑' ℓ : ℤ, ∑' k : ℤ, shortPieceVar r n α Ω ℓ k f x)
        (ENNReal.ofReal p) :=
    eLpNorm_mono_enorm (hΩ.measurable_shortVariation_modulatedSI hn hα0 f r).aestronglyMeasurable
      fun x => by
        simp only [enorm_eq_self]
        exact hΩ.shortVariation_le_tsum_shortPieceVar hn hα0 (by linarith) f x
  have hstep2 : eLpNorm (fun x => ∑' ℓ : ℤ, ∑' k : ℤ, shortPieceVar r n α Ω ℓ k f x)
      (ENNReal.ofReal p) ≤ ∑' ℓ : ℤ, ∑' k : ℤ, E ℓ k := by
    rw [hE]
    refine (eLpNorm_tsum_int_le (F := fun ℓ x => ∑' k : ℤ, shortPieceVar r n α Ω ℓ k f x)
      (fun ℓ => (Measurable.tsum fun k => hm ℓ k).aemeasurable) hp.le).trans ?_
    exact ENNReal.tsum_le_tsum fun ℓ => eLpNorm_tsum_int_le (fun k => (hm ℓ k).aemeasurable) hp.le
  have hsplit : ∑' ℓ : ℤ, ∑' k : ℤ, E ℓ k =
      ∑' ℓ : ℤ, ∑' k : ℤ, smallRegionInd α ℓ k * E ℓ k +
        ∑' ℓ : ℤ, ∑' k : ℤ, case1RegionInd α ℓ k * E ℓ k +
          ∑' ℓ : ℤ, ∑' k : ℤ, restRegionInd α ℓ k * E ℓ k := by
    rw [← ENNReal.tsum_add, ← ENNReal.tsum_add]
    refine tsum_congr fun ℓ => ?_
    rw [← ENNReal.tsum_add, ← ENNReal.tsum_add]
    refine tsum_congr fun k => ?_
    rw [← add_mul, ← add_mul, smallRegionInd_add_case1RegionInd_add_restRegionInd, one_mul]
  refine hstep1.trans (hstep2.trans ((le_of_eq hsplit).trans ?_))
  simp only [hE]
  exact (add_le_add (add_le_add (hs f) h1) (hrest f)).trans (le_of_eq (by ring))

/-! ### The bound `A_∞ ≲ λ^{-1/2}` (integration in `v` first) -/

/-- `∫_ℝ (1 + κ|r - r₀|)^{-2} dr ≤ π/κ`, with integrability. -/
theorem integral_one_add_mul_abs_sub_sq_le {κ : ℝ} (hκ : 0 < κ) (r₀ : ℝ) :
    Integrable (fun r : ℝ => ((1 + κ * |r - r₀|) ^ 2)⁻¹) ∧
      ∫ r : ℝ, ((1 + κ * |r - r₀|) ^ 2)⁻¹ ≤ Real.pi / κ := by
  have hi : Integrable (fun r : ℝ => (1 + (κ * (r - r₀)) ^ 2)⁻¹) := by
    have h1 := (integrable_inv_one_add_sq).comp_mul_left' hκ.ne'
    exact h1.comp_sub_right r₀
  have hval : ∫ r : ℝ, (1 + (κ * (r - r₀)) ^ 2)⁻¹ = Real.pi / κ := by
    rw [integral_sub_right_eq_self (fun r => (1 + (κ * r) ^ 2)⁻¹) r₀,
      Measure.integral_comp_mul_left (fun r => (1 + r ^ 2)⁻¹) κ, integral_univ_inv_one_add_sq,
      smul_eq_mul, abs_inv, abs_of_pos hκ]
    ring
  have hle : ∀ r : ℝ, ((1 + κ * |r - r₀|) ^ 2)⁻¹ ≤ (1 + (κ * (r - r₀)) ^ 2)⁻¹ := by
    intro r
    refine inv_anti₀ (by positivity) ?_
    have : (κ * (r - r₀)) ^ 2 = (κ * |r - r₀|) ^ 2 := by rw [mul_pow, mul_pow, sq_abs]
    rw [this]; nlinarith [mul_nonneg hκ.le (abs_nonneg (r - r₀))]
  have hg : Integrable (fun r : ℝ => ((1 + κ * |r - r₀|) ^ 2)⁻¹) :=
    hi.mono' (by fun_prop) (ae_of_all _ fun r => by
      rw [Real.norm_of_nonneg (by positivity)]; exact hle r)
  exact ⟨hg, (integral_mono hg hi hle).trans_eq hval⟩

/-- The slope bound: `|r^α - ρ^α| ≥ α 2^{-|α-1|} |r - ρ|` for `r, ρ ∈ [1/2, 2]`, `α ≥ 1`. -/
theorem abs_rpow_sub_rpow_ge {α : ℝ} (hα : 1 ≤ α) {r ρ : ℝ} (hr : r ∈ Icc (1 / 2 : ℝ) 2)
    (hρ : ρ ∈ Icc (1 / 2 : ℝ) 2) :
    α * (2 : ℝ) ^ (-|α - 1|) * |r - ρ| ≤ |r ^ α - ρ ^ α| := by
  have hpos : ∀ x ∈ Icc (1 / 2 : ℝ) 2, x ≠ 0 := fun x hx => by linarith [hx.1]
  have key := (convex_Icc (1 / 2 : ℝ) 2).mul_sub_le_image_sub_of_le_deriv
    (f := fun x => x ^ α) (C := α * 2 ^ (-|α - 1|))
    (fun x hx => (Real.continuousAt_rpow_const x α (Or.inl (hpos x hx))).continuousWithinAt)
    (fun x hx => by
      rw [interior_Icc] at hx
      exact (Real.hasDerivAt_rpow_const (Or.inl (hpos x (Ioo_subset_Icc_self hx))
        )).differentiableAt.differentiableWithinAt)
    (fun x hx => by
      rw [interior_Icc] at hx
      rw [(Real.hasDerivAt_rpow_const (Or.inl (hpos x (Ioo_subset_Icc_self hx)))).deriv]
      exact mul_le_mul_of_nonneg_left (osc_rpow_lower hx.1.le hx.2.le _) (by linarith))
  rcases le_total ρ r with h | h
  · have := key ρ hρ r hr h
    rw [abs_of_nonneg (sub_nonneg.2 h)]
    exact this.trans (le_abs_self _)
  · have := key r hr ρ hρ h
    rw [abs_sub_comm r ρ, abs_sub_comm (r ^ α), abs_of_nonneg (sub_nonneg.2 h)]
    exact this.trans (le_abs_self _)

/-- **The radial integral**: for `r₀ ∈ ℝ`,
`∫_{1/2 ≤ |s| ≤ 2} (1 + κ| |s| - r₀ |)^{-2} ds ≤ n |B₁| 2^{n-1} π/κ`. -/
theorem lintegral_annulus_le {n : ℕ} (hn : 1 ≤ n) {κ : ℝ} (hκ : 0 < κ) (r₀ : ℝ) :
    ∫⁻ s : Rn n, ENNReal.ofReal ((Icc (1 / 2 : ℝ) 2).indicator
      (fun y => ((1 + κ * |y - r₀|) ^ 2)⁻¹) ‖s‖) ≤
      ENNReal.ofReal (n * volume.real (Metric.ball (0 : Rn n) 1) * 2 ^ (n - 1) *
        (Real.pi / κ)) := by
  have := nontrivial_rn hn
  set f : ℝ → ℝ := (Icc (1 / 2 : ℝ) 2).indicator (fun y => ((1 + κ * |y - r₀|) ^ 2)⁻¹)
  have hf0 : ∀ y, 0 ≤ f y := fun y => indicator_nonneg (fun _ _ => by positivity) _
  have hf1 : ∀ y, f y ≤ 1 := fun y => by
    simp only [f, indicator]
    split_ifs
    · exact inv_le_one_of_one_le₀ (one_le_pow₀ (by
        have := mul_nonneg hκ.le (abs_nonneg (y - r₀)); linarith))
    · norm_num
  have hfm : Measurable f :=
    (Measurable.inv ((measurable_const.add (measurable_const.mul
      (measurable_id.sub_const _).abs)).pow_const 2)).indicator measurableSet_Icc
  obtain ⟨hgi, hgle⟩ := integral_one_add_mul_abs_sub_sq_le hκ r₀
  have hint : Integrable (fun s : Rn n => f ‖s‖) := by
    refine ((integrableOn_const (C := (1 : ℝ)) (by exact measure_closedBall_lt_top.ne)
      (s := Metric.closedBall (0 : Rn n) 2)).integrable_indicator
        Metric.isClosed_closedBall.measurableSet).mono'
        (hfm.comp measurable_norm).aestronglyMeasurable
      (ae_of_all _ fun s => ?_)
    rw [Real.norm_of_nonneg (hf0 _)]
    by_cases hs : ‖s‖ ≤ 2
    · rw [indicator_of_mem (by simpa using hs)]; exact hf1 _
    · rw [indicator_of_notMem (by simpa using hs)]
      simp only [f, indicator_of_notMem (show ‖s‖ ∉ Icc (1 / 2 : ℝ) 2 from fun h => hs h.2),
        le_refl]
  rw [← ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ fun s => hf0 _)]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [integral_fun_norm_addHaar volume f, finrank_euclideanSpace_fin, nsmul_eq_mul, smul_eq_mul]
  have hV : 0 ≤ volume.real (Metric.ball (0 : Rn n) 1) := measureReal_nonneg
  have hpt : ∀ y ∈ Ioi (0 : ℝ), y ^ (n - 1) • f y ≤ 2 ^ (n - 1) * ((1 + κ * |y - r₀|) ^ 2)⁻¹ := by
    intro y hy
    rw [smul_eq_mul]
    by_cases hy2 : y ∈ Icc (1 / 2 : ℝ) 2
    · simp only [f, indicator_of_mem hy2]
      exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (le_of_lt hy) hy2.2 _) (by positivity)
    · simp only [f, indicator_of_notMem hy2, mul_zero]; positivity
  have h1 : ∫ y in Ioi (0 : ℝ), y ^ (n - 1) • f y ≤
      ∫ y in Ioi (0 : ℝ), 2 ^ (n - 1) * ((1 + κ * |y - r₀|) ^ 2)⁻¹ := by
    refine setIntegral_mono_on ?_ ((hgi.const_mul _).integrableOn) measurableSet_Ioi hpt
    refine (((hgi.const_mul (2 ^ (n - 1) : ℝ)).integrableOn (s := Ioi 0))).mono' ?_ ?_
    · exact ((measurable_id.pow_const _).smul hfm).aestronglyMeasurable
    · refine (ae_restrict_iff' measurableSet_Ioi).2 (ae_of_all _ fun y hy => ?_)
      have hnn : 0 ≤ y ^ (n - 1) • f y := by
        rw [smul_eq_mul]; exact mul_nonneg (pow_nonneg (le_of_lt hy) _) (hf0 _)
      rw [Real.norm_of_nonneg hnn]
      exact hpt y hy
  have h2 : ∫ y in Ioi (0 : ℝ), 2 ^ (n - 1) * ((1 + κ * |y - r₀|) ^ 2)⁻¹ ≤
      2 ^ (n - 1) * (Real.pi / κ) := by
    rw [integral_const_mul]
    refine mul_le_mul_of_nonneg_left ((setIntegral_le_integral hgi (ae_of_all _ fun y =>
      by positivity)).trans hgle) (by positivity)
  calc (n : ℝ) * (volume.real (Metric.ball (0 : Rn n) 1) *
        ∫ y in Ioi (0 : ℝ), y ^ (n - 1) • f y)
      ≤ n * (volume.real (Metric.ball (0 : Rn n) 1) * (2 ^ (n - 1) * (Real.pi / κ))) := by
        gcongr; exact h1.trans h2
    _ = _ := by ring

/-- A smooth bump `χ` on `ℝ` with `χ = 1` on `U = [1, 2^α]` and `0 ≤ χ ≤ 1`. -/
def bumpU (α : ℝ) : ContDiffBump ((1 + (2 : ℝ) ^ α) / 2) where
  rIn := ((2 : ℝ) ^ α - 1) / 2 + 1
  rOut := ((2 : ℝ) ^ α - 1) / 2 + 2
  rIn_pos := by
    have : (0 : ℝ) < 2 ^ α := by positivity
    linarith
  rIn_lt_rOut := by linarith

/-- `χ = 1` on `U`. -/
theorem bumpU_eq_one {α : ℝ} {v : ℝ} (hv : v ∈ paramU α) : bumpU α v = 1 := by
  refine (bumpU α).one_of_mem_closedBall ?_
  rw [Metric.mem_closedBall, Real.dist_eq, abs_le]
  simp only [bumpU]
  constructor <;> linarith [hv.1, hv.2]

/-- The bump `χ` as a complex Schwartz function on `ℝ`. -/
def bumpUSchwartz (α : ℝ) : 𝓢(ℝ, ℂ) :=
  HasCompactSupport.toSchwartzMap (f := fun v => ((bumpU α v : ℝ) : ℂ))
    ((bumpU α).hasCompactSupport.comp_left (g := fun r : ℝ => (r : ℂ)) (by simp))
    (ofRealCLM.contDiff.comp (bumpU α).contDiff)

/-- Values of the bump as a Schwartz function. -/
theorem bumpUSchwartz_apply (α v : ℝ) : bumpUSchwartz α v = ((bumpU α v : ℝ) : ℂ) := rfl

/-- `∫ χ(v) e^{ivw} dv = 𝓕χ(-w/(2π))`. -/
theorem integral_bumpU_mul_exp (α w : ℝ) :
    ∫ v : ℝ, ((bumpU α v : ℝ) : ℂ) * Complex.exp (I * ((v * w : ℝ) : ℂ)) =
      𝓕 (bumpUSchwartz α : ℝ → ℂ) (-w / (2 * Real.pi)) := by
  rw [Real.fourier_eq']
  congr 1; funext v
  rw [smul_eq_mul, bumpUSchwartz_apply, mul_comm]
  congr 2
  simp only [RCLike.inner_apply, conj_trivial]
  push_cast
  field_simp

/-- The decay `|𝓕χ(w)| ≤ D (1 + |w|)^{-2}`. -/
theorem exists_fourier_bumpU_le (α : ℝ) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ w : ℝ, ‖𝓕 (bumpUSchwartz α : ℝ → ℂ) w‖ ≤ D / (1 + |w|) ^ 2 := by
  obtain ⟨D, hD0, hD⟩ := lp_schwartz_decay (𝓕 (bumpUSchwartz α)) 2 0
  refine ⟨D, hD0, fun w => ?_⟩
  have := hD w
  rw [norm_iteratedFDeriv_zero, SchwartzMap.fourier_coe, Real.norm_eq_abs] at this
  rw [le_div_iff₀ (by positivity), mul_comm]; exact this

/-- The phase factor `e^{i λ v |s|^α}`. -/
def radPhase (α lam v : ℝ) {n : ℕ} (s : Rn n) : ℂ := Complex.exp (I * ((lam * v * ‖s‖ ^ α : ℝ) : ℂ))

/-- `|e^{iλv|s|^α}| = 1`. -/
theorem norm_radPhase (α lam v : ℝ) {n : ℕ} (s : Rn n) : ‖radPhase α lam v s‖ = 1 := by
  rw [radPhase, show I * ((lam * v * ‖s‖ ^ α : ℝ) : ℂ) = ((lam * v * ‖s‖ ^ α : ℝ) : ℂ) * I by
    ring]
  exact Complex.norm_exp_ofReal_mul_I _

/-- `e^{iλv|s|^α} conj(e^{iλv|s'|^α}) = e^{iλv(|s|^α - |s'|^α)}`. -/
theorem radPhase_mul_conj (α lam v : ℝ) {n : ℕ} (s s' : Rn n) :
    radPhase α lam v s * conj (radPhase α lam v s') =
      Complex.exp (I * ((v * (lam * (‖s‖ ^ α - ‖s'‖ ^ α)) : ℝ) : ℂ)) := by
  rw [radPhase, radPhase, ← Complex.exp_conj, ← Complex.exp_add, map_mul, Complex.conj_I,
    Complex.conj_ofReal]
  congr 1; push_cast; ring

/-- Continuity of the phase in `v`. -/
theorem continuous_radPhase_left (α lam : ℝ) {n : ℕ} (s : Rn n) :
    Continuous fun v : ℝ => radPhase α lam v s := by
  unfold radPhase
  exact Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
    ((continuous_const.mul continuous_id).mul continuous_const)))

/-- Joint measurability of the phase. -/
theorem measurable_radPhase_uncurry (α lam : ℝ) {n : ℕ} :
    Measurable fun p : ℝ × Rn n => radPhase α lam p.1 p.2 := by
  unfold radPhase
  exact Complex.measurable_exp.comp (measurable_const.mul (Complex.measurable_ofReal.comp
    ((measurable_const.mul measurable_fst).mul ((measurable_norm.comp measurable_snd).pow_const
      α))))

/-- The bump `χ` is integrable. -/
theorem integrable_bumpU (α : ℝ) : Integrable fun v : ℝ => (bumpU α v : ℝ) :=
  (bumpU α).continuous.integrable_of_hasCompactSupport (bumpU α).hasCompactSupport

/-- **The `TT*` identity** behind `A_∞`: with `J(v) = ∫ e^{iλv|s|^α} F(s) ds`,
`∫ χ(v) |J(v)|² dv = ∫∫ F(s) conj F(s') 𝓕χ(-λ(|s|^α - |s'|^α)/(2π)) ds ds'`. -/
theorem integral_bumpU_mul_sq_eq {n : ℕ} {F : Rn n → ℂ} (hF : Measurable F)
    (hFi : Integrable F) (α lam : ℝ) :
    ∫ v : ℝ, ((bumpU α v : ℝ) : ℂ) * ((∫ s, radPhase α lam v s * F s) *
        conj (∫ s, radPhase α lam v s * F s)) =
      ∫ z : Rn n × Rn n, (F z.1 * conj (F z.2)) *
        𝓕 (bumpUSchwartz α : ℝ → ℂ) (-(lam * (‖z.1‖ ^ α - ‖z.2‖ ^ α)) / (2 * Real.pi)) := by
  have h1 : ∀ v, (∫ s, radPhase α lam v s * F s) * conj (∫ s, radPhase α lam v s * F s) =
      ∫ z : Rn n × Rn n, radPhase α lam v z.1 * conj (radPhase α lam v z.2) *
        (F z.1 * conj (F z.2)) := by
    intro v
    rw [← integral_conj, ← integral_prod_mul]
    congr 1; funext z
    simp only [map_mul]; ring
  simp_rw [h1, ← integral_const_mul]
  have hm : Measurable fun p : ℝ × (Rn n × Rn n) => ((bumpU α p.1 : ℝ) : ℂ) *
      (radPhase α lam p.1 p.2.1 * conj (radPhase α lam p.1 p.2.2) *
        (F p.2.1 * conj (F p.2.2))) := by
    have hr1 : Measurable fun p : ℝ × (Rn n × Rn n) => radPhase α lam p.1 p.2.1 :=
      (measurable_radPhase_uncurry α lam).comp
        (measurable_fst.prodMk (measurable_fst.comp measurable_snd))
    have hr2 : Measurable fun p : ℝ × (Rn n × Rn n) => radPhase α lam p.1 p.2.2 :=
      (measurable_radPhase_uncurry α lam).comp
        (measurable_fst.prodMk (measurable_snd.comp measurable_snd))
    exact ((Complex.measurable_ofReal.comp ((bumpU α).continuous.measurable.comp
      measurable_fst)).mul ((hr1.mul (Complex.continuous_conj.measurable.comp hr2)).mul
        ((hF.comp (measurable_fst.comp measurable_snd)).mul
          (Complex.continuous_conj.measurable.comp (hF.comp (measurable_snd.comp
            measurable_snd))))))
  have hint : Integrable (Function.uncurry fun (v : ℝ) (z : Rn n × Rn n) =>
      ((bumpU α v : ℝ) : ℂ) * (radPhase α lam v z.1 * conj (radPhase α lam v z.2) *
        (F z.1 * conj (F z.2)))) := by
    refine ((integrable_bumpU α).mul_prod (hFi.norm.mul_prod hFi.norm)).mono'
      hm.aestronglyMeasurable (ae_of_all _ fun p => ?_)
    simp only [Function.uncurry, norm_mul, Complex.norm_real, Real.norm_of_nonneg
      ((bumpU α).nonneg), norm_radPhase, RCLike.norm_conj, one_mul]
    rfl
  rw [integral_integral_swap hint]
  congr 1; funext z
  have h2 : ∀ v : ℝ, ((bumpU α v : ℝ) : ℂ) * (radPhase α lam v z.1 * conj (radPhase α lam v z.2) *
      (F z.1 * conj (F z.2))) = (F z.1 * conj (F z.2)) * (((bumpU α v : ℝ) : ℂ) *
        Complex.exp (I * ((v * (lam * (‖z.1‖ ^ α - ‖z.2‖ ^ α)) : ℝ) : ℂ))) := by
    intro v; rw [radPhase_mul_conj]; ring
  simp_rw [h2]
  rw [integral_const_mul, integral_bumpU_mul_exp]

/-- The inner (`s'`) bound of the `TT*` argument. -/
theorem lintegral_inner_osc_le {n : ℕ} (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {F : Rn n → ℂ}
    {W D lam : ℝ} (hW : ∀ s, ‖F s‖ ≤ W) (hsupp : ∀ s, F s ≠ 0 → ‖s‖ ∈ Icc (1 / 2 : ℝ) 2)
    (hD0 : 0 ≤ D) (hlam : 0 < lam) {s : Rn n} (hs : ‖s‖ ∈ Icc (1 / 2 : ℝ) 2) :
    ∫⁻ s', ‖F s'‖ₑ * ENNReal.ofReal (D / (1 + lam * |‖s‖ ^ α - ‖s'‖ ^ α| / (2 * Real.pi)) ^ 2) ≤
      ENNReal.ofReal (W * D) * ENNReal.ofReal (n * volume.real (Metric.ball (0 : Rn n) 1) *
        2 ^ (n - 1) * (Real.pi / (lam * (α * (2 : ℝ) ^ (-|α - 1|)) / (2 * Real.pi)))) := by
  set c₁ := α * (2 : ℝ) ^ (-|α - 1|)
  have hα0 : 0 < α := by linarith
  have hc₁ : 0 < c₁ := by positivity
  set κ := lam * c₁ / (2 * Real.pi)
  have hκ : 0 < κ := by have := Real.pi_pos; positivity
  have hW0 : 0 ≤ W := (norm_nonneg _).trans (hW 0)
  have hpt : ∀ s', ‖F s'‖ₑ * ENNReal.ofReal (D / (1 + lam * |‖s‖ ^ α - ‖s'‖ ^ α| /
      (2 * Real.pi)) ^ 2) ≤ ENNReal.ofReal (W * D) * ENNReal.ofReal ((Icc (1 / 2 : ℝ) 2).indicator
        (fun y => ((1 + κ * |y - ‖s‖|) ^ 2)⁻¹) ‖s'‖) := by
    intro s'
    by_cases h0 : F s' = 0
    · simp [h0]
    have hs' := hsupp s' h0
    rw [indicator_of_mem hs', ← ENNReal.ofReal_mul (by positivity), ← ofReal_norm,
      ← ENNReal.ofReal_mul (norm_nonneg _)]
    refine ENNReal.ofReal_le_ofReal ?_
    have hsl := abs_rpow_sub_rpow_ge hα.le hs hs'
    have hk : κ * |‖s'‖ - ‖s‖| ≤ lam * |‖s‖ ^ α - ‖s'‖ ^ α| / (2 * Real.pi) := by
      rw [abs_sub_comm ‖s'‖ ‖s‖]
      simp only [κ]
      have hpi := Real.pi_pos
      rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right (by positivity), mul_assoc]
      exact mul_le_mul_of_nonneg_left hsl hlam.le
    have hden : ((1 + κ * |‖s'‖ - ‖s‖|) ^ 2) ≤
        (1 + lam * |‖s‖ ^ α - ‖s'‖ ^ α| / (2 * Real.pi)) ^ 2 :=
      pow_le_pow_left₀ (by positivity) (by linarith) 2
    calc ‖F s'‖ * (D / (1 + lam * |‖s‖ ^ α - ‖s'‖ ^ α| / (2 * Real.pi)) ^ 2)
        ≤ W * (D * ((1 + κ * |‖s'‖ - ‖s‖|) ^ 2)⁻¹) := by
          refine mul_le_mul (hW s') ?_ (by positivity) hW0
          rw [div_eq_mul_inv]
          exact mul_le_mul_of_nonneg_left (inv_anti₀ (by positivity) hden) hD0
      _ = _ := by ring
  refine (lintegral_mono hpt).trans ?_
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  exact mul_le_mul' le_rfl (lintegral_annulus_le hn hκ ‖s‖)

/-- **The `L^∞ → L²_U` estimate for radial oscillatory integrals** (core of `A_∞`, integration
in `v` first): if `|F| ≤ W` is supported in `1/2 ≤ |s| ≤ 2`, then for `λ > 0`,
`∫_U |∫ e^{iλv|s|^α} F(s) ds|² dv ≤ C W² / λ`. -/
theorem lintegral_osc_sq_le {n : ℕ} (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (F : Rn n → ℂ) (W lam : ℝ), Measurable F → (∀ s, ‖F s‖ ≤ W) →
      (∀ s, F s ≠ 0 → ‖s‖ ∈ Icc (1 / 2 : ℝ) 2) → 0 < lam →
      ∫⁻ v in paramU α, ‖∫ s, radPhase α lam v s * F s‖ₑ ^ 2 ≤
        ENNReal.ofReal (C * W ^ 2 / lam) := by
  obtain ⟨D, hD0, hD⟩ := exists_fourier_bumpU_le α
  have hα0 : 0 < α := by linarith
  set c₁ := α * (2 : ℝ) ^ (-|α - 1|)
  have hc₁ : 0 < c₁ := by positivity
  set V := volume.real (Metric.ball (0 : Rn n) 1)
  set V2 := volume.real (Metric.closedBall (0 : Rn n) 2)
  have hV : 0 ≤ V := measureReal_nonneg
  have hV2 : 0 ≤ V2 := measureReal_nonneg
  refine ⟨D * (n * V * 2 ^ (n - 1)) * V2 * (2 * Real.pi * Real.pi / c₁), by
    have := Real.pi_pos; positivity, fun F W lam hF hW hsupp hlam => ?_⟩
  have hW0 : 0 ≤ W := (norm_nonneg _).trans (hW 0)
  have hFball : ∀ s, ‖F s‖ ≤ (Metric.closedBall (0 : Rn n) 2).indicator (fun _ => W) s := by
    intro s
    by_cases h0 : F s = 0
    · rw [h0, norm_zero]; exact indicator_nonneg (fun _ _ => hW0) _
    · rw [indicator_of_mem (by simpa using (hsupp s h0).2)]; exact hW s
  have hFi : Integrable F :=
    ((integrableOn_const (C := W) (by exact measure_closedBall_lt_top.ne)).integrable_indicator
      Metric.isClosed_closedBall.measurableSet).mono' hF.aestronglyMeasurable
      (ae_of_all _ hFball)
  set J : ℝ → ℂ := fun v => ∫ s, radPhase α lam v s * F s
  set M := ∫ s, ‖F s‖
  have hJb : ∀ v, ‖J v‖ ≤ M := fun v => (norm_integral_le_integral_norm _).trans
    (le_of_eq (by congr 1; funext s; rw [norm_mul, norm_radPhase, one_mul]))
  have hJc : Continuous J := by
    refine continuous_of_dominated (bound := fun s => ‖F s‖)
      (fun v => ((measurable_radPhase_uncurry α lam).comp
        (measurable_const.prodMk measurable_id)).aestronglyMeasurable.mul hF.aestronglyMeasurable)
      (fun v => ae_of_all _ fun s => by rw [norm_mul, norm_radPhase, one_mul]) hFi.norm
      (ae_of_all _ fun s => (continuous_radPhase_left α lam s).mul continuous_const)
  -- step a
  have hstepA : ∫⁻ v in paramU α, ‖J v‖ₑ ^ 2 ≤
      ∫⁻ v, ENNReal.ofReal (bumpU α v * ‖J v‖ ^ 2) := by
    change ∫⁻ v in Icc 1 ((2 : ℝ) ^ α), ‖J v‖ₑ ^ 2 ≤ _
    rw [← lintegral_indicator measurableSet_Icc]
    refine lintegral_mono fun v => ?_
    by_cases hv : v ∈ paramU α
    · rw [indicator_of_mem (show v ∈ Icc 1 ((2 : ℝ) ^ α) from hv), bumpU_eq_one hv, one_mul,
        ← ofReal_norm,
        ENNReal.ofReal_pow (norm_nonneg _)]
    · rw [indicator_of_notMem (show v ∉ Icc 1 ((2 : ℝ) ^ α) from hv)]; exact zero_le
  -- step b
  have hint : Integrable fun v => bumpU α v * ‖J v‖ ^ 2 :=
    ((integrable_bumpU α).mul_const (M ^ 2)).mono'
      ((bumpU α).continuous.mul (hJc.norm.pow 2)).aestronglyMeasurable
      (ae_of_all _ fun v => by
        rw [Real.norm_of_nonneg (mul_nonneg (bumpU α).nonneg (by positivity))]
        exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hJb v) 2)
          (bumpU α).nonneg)
  rw [← ofReal_integral_eq_lintegral_ofReal hint
    (ae_of_all _ fun v => mul_nonneg (bumpU α).nonneg (by positivity))] at hstepA
  -- step c
  have hstepC : ∫ v, bumpU α v * ‖J v‖ ^ 2 ≤
      ‖∫ v : ℝ, ((bumpU α v : ℝ) : ℂ) * (J v * conj (J v))‖ := by
    have : ∫ v : ℝ, ((bumpU α v : ℝ) : ℂ) * (J v * conj (J v)) =
        ((∫ v, bumpU α v * ‖J v‖ ^ 2 : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      congr 1; funext v
      rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]; push_cast; ring
    rw [this, Complex.norm_real, Real.norm_eq_abs]
    exact le_abs_self _
  rw [integral_bumpU_mul_sq_eq hF hFi α lam] at hstepC
  set K : Rn n → Rn n → ℝ≥0∞ := fun s s' => ‖F s'‖ₑ *
    ENNReal.ofReal (D / (1 + lam * |‖s‖ ^ α - ‖s'‖ ^ α| / (2 * Real.pi)) ^ 2)
  have hKm : Measurable fun z : Rn n × Rn n => ‖F z.1‖ₑ * K z.1 z.2 := by
    simp only [K]
    refine (hF.comp measurable_fst).enorm.mul ((hF.comp measurable_snd).enorm.mul ?_)
    refine Measurable.ennreal_ofReal (measurable_const.div ((measurable_const.add
      ((measurable_const.mul (((measurable_norm.comp measurable_fst).pow_const α).sub
        ((measurable_norm.comp measurable_snd).pow_const α)).abs).div_const _)).pow_const 2))
  have hstepD : ‖∫ z : Rn n × Rn n, (F z.1 * conj (F z.2)) *
      𝓕 (bumpUSchwartz α : ℝ → ℂ) (-(lam * (‖z.1‖ ^ α - ‖z.2‖ ^ α)) / (2 * Real.pi))‖ₑ ≤
      ∫⁻ z : Rn n × Rn n, ‖F z.1‖ₑ * K z.1 z.2 := by
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun z => ?_)
    simp only [K]
    rw [enorm_mul, enorm_mul, RCLike.enorm_conj, mul_assoc]
    refine mul_le_mul' le_rfl (mul_le_mul' le_rfl ?_)
    rw [← ofReal_norm]
    have hpi : (0 : ℝ) < 2 * Real.pi := by have := Real.pi_pos; positivity
    have habs : |-(lam * (‖z.1‖ ^ α - ‖z.2‖ ^ α)) / (2 * Real.pi)| =
        lam * |‖z.1‖ ^ α - ‖z.2‖ ^ α| / (2 * Real.pi) := by
      rw [abs_div, abs_neg, abs_mul, abs_of_pos hlam, abs_of_pos hpi]
    refine ENNReal.ofReal_le_ofReal ((hD _).trans (le_of_eq ?_))
    rw [habs]
  have hR : ∀ s, ‖F s‖ₑ * ∫⁻ s', K s s' ≤ ‖F s‖ₑ * (ENNReal.ofReal (W * D) *
      ENNReal.ofReal (n * V * 2 ^ (n - 1) * (Real.pi / (lam * c₁ / (2 * Real.pi))))) := by
    intro s
    by_cases h0 : F s = 0
    · simp [h0]
    exact mul_le_mul' le_rfl (lintegral_inner_osc_le hn hα hW hsupp hD0 hlam (hsupp s h0))
  have hFl : ∫⁻ s, ‖F s‖ₑ ≤ ENNReal.ofReal (W * V2) := by
    calc ∫⁻ s, ‖F s‖ₑ ≤ ∫⁻ s, (Metric.closedBall (0 : Rn n) 2).indicator
          (fun _ => ENNReal.ofReal W) s := by
          refine lintegral_mono fun s => ?_
          have := hFball s
          by_cases hs : s ∈ Metric.closedBall (0 : Rn n) 2
          · rw [indicator_of_mem hs] at this ⊢; rw [← ofReal_norm]
            exact ENNReal.ofReal_le_ofReal this
          · rw [indicator_of_notMem hs] at this ⊢
            rw [norm_le_zero_iff.1 this, enorm_zero]
      _ = ENNReal.ofReal (W * V2) := by
          rw [lintegral_indicator_const Metric.isClosed_closedBall.measurableSet,
            ENNReal.ofReal_mul hW0, ofReal_measureReal (by exact measure_closedBall_lt_top.ne)]
  calc ∫⁻ v in paramU α, ‖∫ s, radPhase α lam v s * F s‖ₑ ^ 2
      ≤ ENNReal.ofReal (∫ v, bumpU α v * ‖J v‖ ^ 2) := hstepA
    _ ≤ ENNReal.ofReal ‖∫ z : Rn n × Rn n, (F z.1 * conj (F z.2)) *
        𝓕 (bumpUSchwartz α : ℝ → ℂ) (-(lam * (‖z.1‖ ^ α - ‖z.2‖ ^ α)) / (2 * Real.pi))‖ :=
        ENNReal.ofReal_le_ofReal hstepC
    _ ≤ ∫⁻ z : Rn n × Rn n, ‖F z.1‖ₑ * K z.1 z.2 := by rw [ofReal_norm]; exact hstepD
    _ = ∫⁻ s, ‖F s‖ₑ * ∫⁻ s', K s s' := by
        rw [Measure.volume_eq_prod, lintegral_prod _ hKm.aemeasurable]
        refine lintegral_congr fun s => ?_
        exact lintegral_const_mul' (‖F s‖ₑ) (fun s' => K s s') enorm_ne_top
    _ ≤ ∫⁻ s, ‖F s‖ₑ * (ENNReal.ofReal (W * D) *
          ENNReal.ofReal (n * V * 2 ^ (n - 1) * (Real.pi / (lam * c₁ / (2 * Real.pi))))) :=
        lintegral_mono hR
    _ = (∫⁻ s, ‖F s‖ₑ) * (ENNReal.ofReal (W * D) *
          ENNReal.ofReal (n * V * 2 ^ (n - 1) * (Real.pi / (lam * c₁ / (2 * Real.pi))))) :=
        lintegral_mul_const' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top)
    _ ≤ ENNReal.ofReal (W * V2) * (ENNReal.ofReal (W * D) *
          ENNReal.ofReal (n * V * 2 ^ (n - 1) * (Real.pi / (lam * c₁ / (2 * Real.pi))))) :=
        mul_le_mul' hFl le_rfl
    _ = _ := by
        have hpi := Real.pi_pos
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        field_simp

/-- Fubini for the single-scale operator: `∫ k_{ℓ,k}(x - y, v) g(y) dy = ∫ p(t) (ψ_k * g)(x - t) dt`
with `p = e^{iv|·|^α} φ_ℓ K`. -/
theorem IsHomogeneousCZKernel.integral_unitKernel_mul_eq {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) (v : ℝ) {g : Rn n → ℂ}
    (hg : Measurable g) {B : ℝ} (hgb : ∀ y, ‖g y‖ ≤ B) (x : Rn n) :
    ∫ y, unitKernel hΩ α ℓ k v (x - y) * g y =
      ∫ t, pieceKernel n α Ω v ℓ t * ∫ y, lpDilate n (lpPsi n) k (x - t - y) * g y := by
  have hψc : Continuous (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous
  have hψi : Integrable (lpDilate n (lpPsi n) k) := integrable_lpDilate (lpPsi n).integrable k
  have hpk := hΩ.integrable_pieceKernel α v ℓ
  have hpkm : Measurable (pieceKernel n α Ω v ℓ) :=
    (hΩ.contDiff_pieceKernel α v ℓ).continuous.measurable
  set f : Rn n × Rn n → ℂ := fun p =>
    lpDilate n (lpPsi n) k (x - p.1 - p.2) * pieceKernel n α Ω v ℓ p.2 * g p.1
  have hfm : Measurable f :=
    ((hψc.measurable.comp ((measurable_const.sub measurable_fst).sub measurable_snd)).mul
      (hpkm.comp measurable_snd)).mul (hg.comp measurable_fst)
  have hB : 0 ≤ B := (norm_nonneg _).trans (hgb 0)
  have hint : Integrable f (volume.prod volume) := by
    rw [integrable_prod_iff' hfm.aestronglyMeasurable]
    constructor
    · refine ae_of_all _ fun t => ?_
      have h1 : Integrable fun y => lpDilate n (lpPsi n) k (x - t - y) :=
        (hψi.comp_sub_left (x - t))
      refine ((h1.mul_const (pieceKernel n α Ω v ℓ t)).bdd_mul (c := B)
        (hg.aestronglyMeasurable) (ae_of_all _ hgb)).congr (ae_of_all _ fun y => ?_)
      simp only [f, sub_right_comm x y t]; ring
    · refine (hpk.norm.mul_const (∫ z, ‖lpDilate n (lpPsi n) k z‖ * B)).mono'
        (hfm.norm.stronglyMeasurable.integral_prod_left'.aestronglyMeasurable)
        (ae_of_all _ fun t => ?_)
      rw [Real.norm_of_nonneg (integral_nonneg fun _ => norm_nonneg _)]
      calc ∫ y, ‖f (y, t)‖ ≤ ∫ y, ‖pieceKernel n α Ω v ℓ t‖ * (‖lpDilate n (lpPsi n) k
            (x - t - y)‖ * B) := by
            refine integral_mono_of_nonneg (ae_of_all _ fun _ => norm_nonneg _)
              (((hψi.comp_sub_left (x - t)).norm.mul_const B).const_mul _)
              (ae_of_all _ fun y => ?_)
            have he : ‖f (y, t)‖ = ‖lpDilate n (lpPsi n) k (x - t - y)‖ *
                ‖pieceKernel n α Ω v ℓ t‖ * ‖g y‖ := by
              simp only [f, norm_mul, sub_right_comm x y t]
            change ‖f (y, t)‖ ≤ _
            rw [he]
            have hprod := mul_nonneg (norm_nonneg (lpDilate n (lpPsi n) k (x - t - y)))
              (norm_nonneg (pieceKernel n α Ω v ℓ t))
            nlinarith [mul_le_mul_of_nonneg_left (hgb y) hprod]
        _ = ‖pieceKernel n α Ω v ℓ t‖ * ∫ z, ‖lpDilate n (lpPsi n) k z‖ * B := by
            rw [integral_const_mul]
            congr 1
            exact integral_sub_left_eq_self (fun z => ‖lpDilate n (lpPsi n) k z‖ * B) _ (x - t)
  simp_rw [unitKernel_apply]
  have h2 : ∀ y, (∫ t, lpDilate n (lpPsi n) k (x - y - t) * pieceKernel n α Ω v ℓ t) * g y =
      ∫ t, f (y, t) := fun y => by
    rw [← integral_mul_const]
  simp_rw [h2]
  rw [integral_integral_swap (f := fun y t => f (y, t)) hint]
  congr 1; funext t
  rw [← integral_const_mul]
  congr 1; funext y
  simp only [f]; rw [sub_right_comm x y t]; ring

/-- Rescaling the piece integral to the unit annulus:
`∫ e^{iv|t|^α} φ_ℓ(t) K(t) H(t) dt = ∫ e^{i 2^{ℓα} v |s|^α} φ₀(s) K(s) H(2^ℓ s) ds`. -/
theorem IsHomogeneousCZKernel.integral_pieceKernel_mul_eq {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α v : ℝ) (ℓ : ℤ) (H : Rn n → ℂ) :
    ∫ t, pieceKernel n α Ω v ℓ t * H t =
      ∫ s, radPhase α (dyadicPoint α ℓ) v s * (pieceKernel n α Ω 0 0 s * H ((2 : ℝ) ^ ℓ • s)) := by
  have hc : 0 < (2 : ℝ) ^ ℓ := zpow_pos two_pos ℓ
  have key := Measure.integral_comp_smul (volume : Measure (Rn n))
    (fun t => pieceKernel n α Ω v ℓ t * H t) ((2 : ℝ) ^ ℓ)
  rw [finrank_euclideanSpace_fin, abs_of_pos (by positivity)] at key
  have hpt : ∀ s : Rn n, pieceKernel n α Ω v ℓ ((2 : ℝ) ^ ℓ • s) * H ((2 : ℝ) ^ ℓ • s) =
      ((((2 : ℝ) ^ ℓ) ^ n)⁻¹ : ℝ) • (radPhase α (dyadicPoint α ℓ) v s *
        (pieceKernel n α Ω 0 0 s * H ((2 : ℝ) ^ ℓ • s))) := by
    intro s
    rw [hΩ.pieceKernel_eq_lpDilate_zero α v ℓ]
    simp only [lpDilate, smul_smul]
    rw [← zpow_add₀ two_ne_zero, neg_add_cancel, zpow_zero, one_smul]
    have hpow : ((2 : ℝ) : ℂ) ^ (-ℓ * (n : ℤ)) = (((((2 : ℝ) ^ ℓ) ^ n)⁻¹ : ℝ) : ℂ) := by
      rw [Complex.ofReal_inv, ← zpow_natCast, ← zpow_mul, Complex.ofReal_zpow, ← zpow_neg]
      ring_nf
    rw [hpow, Complex.real_smul]
    simp only [pieceKernel, radPhase, dyadicPhiScale, neg_zero, zpow_zero, one_smul]
    push_cast
    simp only [mul_zero, zero_mul, Complex.exp_zero]
    ring_nf
  simp_rw [hpt, integral_smul] at key
  have hne : (((2 : ℝ) ^ ℓ) ^ n)⁻¹ ≠ 0 := by positivity
  rw [← sub_eq_zero, ← smul_sub, smul_eq_zero] at key
  rcases key with h | h
  · exact absurd h hne
  · exact (sub_eq_zero.1 h).symm

/-- **The `L^∞ → L^∞(L²_U)` bound `A_∞`** (paper §4.4, proof route item 3): for `α > 1` there is
`C` such that for all `ℓ, k ∈ ℤ`, measurable `g` with `|g| ≤ 1` and all `x`,
`∫_U |∫ k_{ℓ,k}(x - y, v) g(y) dy|² dv ≤ C (2^{ℓα})^{-1}`. -/
theorem IsHomogeneousCZKernel.unitKernel_Linfty {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ k : ℤ) (g : Rn n → ℂ), Measurable g → (∀ y, ‖g y‖ ≤ 1) →
      ∀ x : Rn n, ∫⁻ v in paramU α, ‖∫ y, unitKernel hΩ α ℓ k v (x - y) * g y‖ₑ ^ 2 ≤
        ENNReal.ofReal (C / dyadicPoint α ℓ) := by
  obtain ⟨Cc, hCc0, hCc⟩ := lintegral_osc_sq_le hn hα
  obtain ⟨CΩ, hC0, hC⟩ := hΩ.exists_bound
  set Bψ := ∫ z, ‖lpPsi n z‖
  have hBψ : 0 ≤ Bψ := integral_nonneg fun _ => norm_nonneg _
  set W := pieceSup n CΩ 0 * Bψ
  have hW0 : 0 ≤ W := by unfold W pieceSup; positivity
  refine ⟨Cc * W ^ 2, by positivity, fun ℓ k g hg hgb x => ?_⟩
  have hψc : Continuous (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous
  set H : Rn n → ℂ := fun t => ∫ y, lpDilate n (lpPsi n) k (x - t - y) * g y
  have hHb : ∀ t, ‖H t‖ ≤ Bψ := by
    intro t
    refine (norm_integral_le_integral_norm _).trans ?_
    calc ∫ y, ‖lpDilate n (lpPsi n) k (x - t - y) * g y‖
        ≤ ∫ y, ‖lpDilate n (lpPsi n) k (x - t - y)‖ := by
          refine integral_mono_of_nonneg (ae_of_all _ fun _ => norm_nonneg _)
            ((integrable_lpDilate (lpPsi n).integrable k).comp_sub_left (x - t)).norm
            (ae_of_all _ fun y => ?_)
          simp only [norm_mul]
          exact mul_le_of_le_one_right (norm_nonneg _) (hgb y)
      _ = ∫ z, ‖lpDilate n (lpPsi n) k z‖ :=
          integral_sub_left_eq_self (fun z => ‖lpDilate n (lpPsi n) k z‖) _ (x - t)
      _ = Bψ := by
          rw [integral_norm_eq_lintegral_enorm hψc.aestronglyMeasurable,
            lintegral_enorm_lpDilate (lpPsi n).continuous.measurable,
            ← integral_norm_eq_lintegral_enorm (lpPsi n).continuous.aestronglyMeasurable]
  have hHm : Measurable H := by
    have hm : Measurable fun p : Rn n × Rn n => lpDilate n (lpPsi n) k (x - p.1 - p.2) * g p.2 :=
      (hψc.measurable.comp ((measurable_const.sub measurable_fst).sub measurable_snd)).mul
        (hg.comp measurable_snd)
    exact hm.stronglyMeasurable.integral_prod_right'.measurable
  set F : Rn n → ℂ := fun s => pieceKernel n α Ω 0 0 s * H ((2 : ℝ) ^ ℓ • s)
  have hFm : Measurable F :=
    (hΩ.contDiff_pieceKernel α 0 0).continuous.measurable.mul
      (hHm.comp (measurable_const_smul _))
  have hFb : ∀ s, ‖F s‖ ≤ W := by
    intro s
    simp only [F, W]
    rw [norm_mul, norm_pieceKernel]
    have h1 := abs_dyadicPhiScale_mul_czKernel_le hC0 hC 0 s
    have h1' : |dyadicPhiScale n 0 s * czKernel n Ω s| ≤ pieceSup n CΩ 0 := by
      refine h1.trans ?_
      by_cases hs : s ∈ Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ ((0 : ℤ) + 1))
      · rw [indicator_of_mem hs]
      · rw [indicator_of_notMem hs]; unfold pieceSup; positivity
    exact mul_le_mul (by rw [Real.norm_eq_abs]; exact h1') (hHb _) (norm_nonneg _)
      (by unfold pieceSup; positivity)
  have hFs : ∀ s, F s ≠ 0 → ‖s‖ ∈ Icc (1 / 2 : ℝ) 2 := by
    intro s hs
    have h : dyadicPhi n s ≠ 0 := by
      intro h; apply hs
      simp [F, pieceKernel_zero_zero_apply, h]
    have := dyadicPhi_ne_zero h
    exact ⟨this.1.le, this.2.le⟩
  have hrep : ∀ v, ∫ y, unitKernel hΩ α ℓ k v (x - y) * g y =
      ∫ s, radPhase α (dyadicPoint α ℓ) v s * F s := by
    intro v
    rw [hΩ.integral_unitKernel_mul_eq α ℓ k v hg hgb x, hΩ.integral_pieceKernel_mul_eq]
  simp_rw [hrep]
  refine (hCc F W (dyadicPoint α ℓ) hFm hFb hFs (dyadicPoint_pos α ℓ)).trans (le_of_eq ?_)
  ring_nf

/-- `∂_v [e^{iv|t|^α} φ_ℓ(t) K(t)] = i|t|^α e^{iv|t|^α} φ_ℓ(t) K(t)`. -/
theorem hasDerivAt_pieceKernel (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (ℓ : ℤ) (t : Rn n) (v : ℝ) :
    HasDerivAt (fun w => pieceKernel n α Ω w ℓ t) (pieceKernelD n α Ω v ℓ t) v := by
  have h1 : HasDerivAt (fun w : ℝ => I * (w : ℂ) * ((‖t‖ ^ α : ℝ) : ℂ))
      (I * 1 * ((‖t‖ ^ α : ℝ) : ℂ)) v :=
    ((hasDerivAt_id v).ofReal_comp.const_mul I).mul_const _
  convert h1.cexp.mul_const ((dyadicPhiScale n ℓ t * czKernel n Ω t : ℝ) : ℂ) using 1
  · rfl
  · rw [pieceKernelD, pieceKernel]; ring

/-- **The `v`-derivative of the single-scale kernel**:
`∂_v k_{ℓ,k}(z, v) = ∫ ψ_k(z - t) i|t|^α e^{iv|t|^α} φ_ℓ(t) K(t) dt` (`unitKernelD`). -/
theorem IsHomogeneousCZKernel.hasDerivAt_unitKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) (z : Rn n) (v : ℝ) :
    HasDerivAt (fun w => unitKernel hΩ α ℓ k w z) (unitKernelD n α Ω ℓ k z v) v := by
  simp_rw [unitKernel_apply]
  have hψc : Continuous (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous
  set Sψ := SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k)
  have hψb : ∀ y, ‖lpDilate n (lpPsi n) k y‖ ≤ Sψ := fun y => by
    rw [← coe_schwartzDilate]; exact SchwartzMap.norm_le_seminorm ℝ _ y
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le (s := univ) (bound := fun t =>
      Sψ * ‖pieceKernelD n α Ω 0 ℓ t‖) Filter.univ_mem
    (Eventually.of_forall fun w => ?_) ?_ ?_ (ae_of_all _ fun t w _ => ?_)
    ((hΩ.integrable_pieceKernelD α 0 ℓ).norm.const_mul _)
    (ae_of_all _ fun t w _ => (hasDerivAt_pieceKernel n α Ω ℓ t w).const_mul _)).2
  · exact ((hψc.comp (continuous_sub_left z)).aestronglyMeasurable).mul
      (hΩ.integrable_pieceKernel α w ℓ).aestronglyMeasurable
  · exact (hΩ.integrable_pieceKernel α v ℓ).bdd_mul
      ((hψc.comp (continuous_sub_left z)).aestronglyMeasurable) (ae_of_all _ fun t => hψb _)
  · exact ((hψc.comp (continuous_sub_left z)).aestronglyMeasurable).mul
      (hΩ.integrable_pieceKernelD α v ℓ).aestronglyMeasurable
  · rw [norm_mul, norm_pieceKernelD_real, norm_pieceKernelD_real]
    exact mul_le_mul_of_nonneg_right (hψb _) (by positivity)

/-! ## Case 1 (paper §4.4): the vector-valued Seeger theorem and the `V²`-embedding -/

/-- The parameter measure `ν = dv` on `U = [1, 2^α]` of the vector-valued Seeger theorem. -/
def uMeasure (α : ℝ) : Measure ℝ := volume.restrict (paramU α)

instance (α : ℝ) : IsFiniteMeasure (uMeasure α) :=
  isFiniteMeasure_restrict.2 (by simp [paramU, Real.volume_Icc])

/-- `sgrUNorm` for `ν = dv` on `U` is `uNorm`. -/
theorem sgrUNorm_uMeasure (α : ℝ) (F : ℝ → ℂ) : sgrUNorm (uMeasure α) F = uNorm α F := rfl

/-- The Case 1 kernel family `k_j(x, v) = k_{ℓ,k}(x, v)` (independent of `j`; paper §4.4). -/
def case1Ker {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) :
    ℤ → Rn n → ℝ → ℂ :=
  fun _ x v => unitKernel hΩ α ℓ k v x

/-- The Case 1 derivative kernel family `k_j(x, v) = ∂_v k_{ℓ,k}(x, v)` (paper §4.4). -/
def case1KerD (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (ℓ k : ℤ) : ℤ → Rn n → ℝ → ℂ :=
  fun _ x v => unitKernelD n α Ω ℓ k x v

/-- The Seeger operators of `case1Ker` are the pieces: `T_j f(x, v) = 𝓗^{(2^{jα}v)}_{ℓ-j}
P_{j+k} f(x)` (paper §4.3, scaling). -/
theorem IsHomogeneousCZKernel.sgrOp_case1Ker {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) (v : ℝ) :
    sgrOp (case1Ker hΩ α ℓ k) j f x v = shortPiece n α Ω ℓ k f j x (dyadicPoint α j * v) := by
  simp only [shortPiece]
  rw [hΩ.modulatedPiece_eq_lpConv_unitKernel]
  simp only [sgrOp, sgrKer, case1Ker, lpDilate, Complex.ofReal_zpow]

/-- `2^{(j+1)α} = 2^{jα} 2^α`. -/
theorem dyadicPoint_add_one (α : ℝ) (j : ℤ) :
    dyadicPoint α (j + 1) = dyadicPoint α j * (2 : ℝ) ^ α := by
  rw [dyadicPoint, dyadicPoint, ← Real.rpow_add two_pos]; push_cast; ring_nf

/-- **Reparametrization of the short intervals**: `V^r_{J_j}(a) = V^r_U(v ↦ a(2^{jα} v))`,
since `v ↦ 2^{jα} v` is an increasing bijection of `U = [1, 2^α]` onto `J_j`. -/
theorem variationNorm_shortInterval_eq (α r : ℝ) (j : ℤ) (a : ℝ → ℂ) :
    variationNorm r (shortInterval α j) a =
      variationNorm r (paramU α) (fun v => a (dyadicPoint α j * v)) := by
  have hc := dyadicPoint_pos α j
  set c := dyadicPoint α j
  have hJ : shortInterval α j = Icc c (c * (2 : ℝ) ^ α) := by
    rw [shortInterval, dyadicPoint_add_one]
  refine le_antisymm (variationNorm_le fun J u hu hm => ?_) (variationNorm_le fun J u hu hm => ?_)
  · have hu' : StrictMono fun i => u i / c := fun i i' h => div_lt_div_of_pos_right (hu h) hc
    have hm' : ∀ i, u i / c ∈ paramU α := by
      intro i
      have := hm i
      rw [hJ] at this
      refine ⟨(le_div_iff₀ hc).2 (by linarith [this.1]), (div_le_iff₀ hc).2 ?_⟩
      linarith [this.2]
    have h2 : ∀ i, c * (u i / c) = u i := fun i => mul_div_cancel₀ _ hc.ne'
    have := le_variationNorm (a := fun v => a (c * v)) (r := r) (u := fun i => u i / c) hu' hm'
    simp only [h2] at this
    exact this
  · have hu' : StrictMono fun i => c * u i := fun i i' h => mul_lt_mul_of_pos_left (hu h) hc
    have hm' : ∀ i, c * u i ∈ shortInterval α j := by
      intro i
      rw [hJ]
      exact ⟨by nlinarith [(hm i).1], mul_le_mul_of_nonneg_left (hm i).2 hc.le⟩
    exact le_variationNorm (a := a) (r := r) (u := fun i => c * u i) hu' hm'

/-- The uniform bound `|∫ ψ_k(z - t) b_v(t) dt| ≤ ‖ψ_k‖_∞ ∫ β` for `|b_v| ≤ β`. -/
theorem norm_convKernel_le_of_le {n : ℕ} (k : ℤ) {b : ℝ → Rn n → ℂ} {β : Rn n → ℝ}
    (hβ : Integrable β) (hb : ∀ v t, ‖b v t‖ ≤ β t) (z : Rn n) (v : ℝ) :
    ‖convKernel n k b z v‖ ≤
      SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k) * ∫ t, β t := by
  rw [← integral_const_mul]
  refine norm_integral_le_of_norm_le (hβ.const_mul _) (ae_of_all _ fun t => ?_)
  rw [norm_mul]
  have h1 : ‖lpDilate n (lpPsi n) k (z - t)‖ ≤
      SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact SchwartzMap.norm_le_seminorm ℝ _ _
  exact mul_le_mul h1 (hb v t) (norm_nonneg _) (apply_nonneg _ _)

/-- Joint continuity of `(z, v) ↦ ∫ ψ_k(z - t) b_v(t) dt` (dominated convergence). -/
theorem continuous_convKernel_uncurry {n : ℕ} (k : ℤ) {b : ℝ → Rn n → ℂ} {β : Rn n → ℝ}
    (hβ : Integrable β) (hb : ∀ v t, ‖b v t‖ ≤ β t) (hbm : ∀ v, AEStronglyMeasurable (b v))
    (hbc : ∀ t, Continuous fun v => b v t) :
    Continuous fun p : Rn n × ℝ => convKernel n k b p.1 p.2 := by
  have hψc : Continuous (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous
  have hψb : ∀ z, ‖lpDilate n (lpPsi n) k z‖ ≤
      SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k) := fun z => by
    rw [← coe_schwartzDilate]; exact SchwartzMap.norm_le_seminorm ℝ _ z
  refine continuous_of_dominated (bound := fun t =>
      SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k) * β t)
    (fun p => ?_) (fun p => ae_of_all _ fun t => ?_) (hβ.const_mul _) (ae_of_all _ fun t => ?_)
  · exact ((hψc.comp (continuous_sub_left p.1)).aestronglyMeasurable).mul (hbm p.2)
  · rw [norm_mul]; exact mul_le_mul (hψb _) (hb _ _) (norm_nonneg _) (apply_nonneg _ _)
  · exact (hψc.comp (continuous_fst.sub continuous_const)).mul ((hbc t).comp continuous_snd)

/-- Continuity of the pieces in the modulation parameter. -/
theorem continuous_pieceKernel_param (n : ℕ) (α : ℝ) (Ω : Rn n → ℝ) (ℓ : ℤ) (t : Rn n) :
    Continuous fun v => pieceKernel n α Ω v ℓ t := by
  simp only [pieceKernel]
  exact (Complex.continuous_exp.comp ((continuous_const.mul Complex.continuous_ofReal).mul
    continuous_const)).mul continuous_const

/-- Joint continuity of the derivative kernel `(z, v) ↦ ∂_v k_{ℓ,k}(z, v)`. -/
theorem IsHomogeneousCZKernel.continuous_unitKernelD_uncurry {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) :
    Continuous fun p : Rn n × ℝ => unitKernelD n α Ω ℓ k p.1 p.2 :=
  continuous_convKernel_uncurry k (hΩ.integrable_pieceKernelD α 0 ℓ).norm
    (fun v t => by rw [norm_pieceKernelD_real, norm_pieceKernelD_real])
    (fun v => (hΩ.integrable_pieceKernelD α v ℓ).aestronglyMeasurable)
    (fun t => continuous_const.mul (continuous_pieceKernel_param n α Ω ℓ t))

/-- Uniform bounds for the single-scale kernels and their `v`-derivatives (fixed `ℓ, k`). -/
theorem IsHomogeneousCZKernel.exists_bound_unitKernel {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) :
    ∃ M : ℝ, ∀ z v, ‖unitKernel hΩ α ℓ k v z‖ ≤ M ∧ ‖unitKernelD n α Ω ℓ k z v‖ ≤ M := by
  obtain ⟨S, hS⟩ : ∃ S, S = SchwartzMap.seminorm ℝ 0 0 (schwartzDilate (lpPsi n) k) := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := hS ▸ apply_nonneg _ _
  have hI1 : 0 ≤ S * (∫ t, ‖dyadicPhiScale n ℓ t * czKernel n Ω t‖) :=
    mul_nonneg hS0 (integral_nonneg fun _ => norm_nonneg _)
  have hI2 : 0 ≤ S * ∫ t, ‖pieceKernelD n α Ω 0 ℓ t‖ :=
    mul_nonneg hS0 (integral_nonneg fun _ => norm_nonneg _)
  refine ⟨S * (∫ t, ‖dyadicPhiScale n ℓ t * czKernel n Ω t‖) +
    S * ∫ t, ‖pieceKernelD n α Ω 0 ℓ t‖, fun z v => ⟨?_, ?_⟩⟩
  · rw [unitKernel_eq_convKernel]
    have h1 := norm_convKernel_le_of_le k (hΩ.integrable_dyadicPhiScale_mul ℓ).norm
      (fun v t => (norm_pieceKernel n α Ω v ℓ t).le) z v
    rw [← hS] at h1
    exact h1.trans (le_add_of_nonneg_right hI2)
  · have h1 := norm_convKernel_le_of_le k (b := fun v => pieceKernelD n α Ω v ℓ)
      (hΩ.integrable_pieceKernelD α 0 ℓ).norm
      (fun v t => by rw [norm_pieceKernelD_real, norm_pieceKernelD_real]) z v
    rw [← hS] at h1
    exact h1.trans (le_add_of_nonneg_left hI1)

/-- Composition with a jointly continuous two-variable function. -/
theorem continuous_comp_uncurry {n : ℕ} {X : Type*} [TopologicalSpace X] {κ : Rn n → ℝ → ℂ}
    (hκ : Continuous fun p : Rn n × ℝ => κ p.1 p.2) {a : X → Rn n} {b : X → ℝ}
    (ha : Continuous a) (hb : Continuous b) : Continuous fun x => κ (a x) (b x) :=
  hκ.comp (ha.prodMk hb)

/-- `|K_j(z, v)| ≤ 2^{jn} M` for `|k_j| ≤ M`. -/
theorem norm_sgrKer_le {n : ℕ} {U : Type*} {κ : ℤ → Rn n → U → ℂ} (j : ℤ) {M : ℝ}
    (hM : ∀ z v, ‖κ j z v‖ ≤ M) (z : Rn n) (v : U) :
    ‖sgrKer κ j z v‖ ≤ (2 : ℝ) ^ (j * n) * M := by
  rw [sgrKer, norm_mul, Complex.norm_real, Real.norm_of_nonneg (zpow_nonneg zero_le_two _)]
  exact mul_le_mul_of_nonneg_left (hM _ _) (zpow_nonneg zero_le_two _)

/-- Continuity of `y ↦ K_j(x - y, v)` and of `(x, v) ↦ K_j(x - y, v)`. -/
theorem continuous_sgrKer_comp {n : ℕ} {X : Type*} [TopologicalSpace X] {κ : ℤ → Rn n → ℝ → ℂ}
    (j : ℤ) (hκ : Continuous fun p : Rn n × ℝ => κ j p.1 p.2) {a : X → Rn n} {b : X → ℝ}
    (ha : Continuous a) (hb : Continuous b) : Continuous fun x => sgrKer κ j (a x) (b x) :=
  continuous_const.mul (continuous_comp_uncurry hκ (ha.const_smul ((2 : ℝ) ^ j)) hb)

/-- Joint continuity of the Seeger operators `(x, v) ↦ T_j f(x, v)` for bounded continuous
kernels and integrable `f`. -/
theorem continuous_sgrOp_uncurry {n : ℕ} {κ : ℤ → Rn n → ℝ → ℂ} (j : ℤ)
    (hκ : Continuous fun p : Rn n × ℝ => κ j p.1 p.2) {M : ℝ} (hM : ∀ z v, ‖κ j z v‖ ≤ M)
    {f : Rn n → ℂ} (hf : Integrable f) :
    Continuous fun p : Rn n × ℝ => sgrOp κ j f p.1 p.2 := by
  refine continuous_of_dominated (bound := fun y => (2 : ℝ) ^ (j * n) * M * ‖f y‖)
    (fun p => ?_) (fun p => ae_of_all _ fun y => ?_) (hf.norm.const_mul _)
    (ae_of_all _ fun y => ?_)
  · exact (continuous_sgrKer_comp j hκ (continuous_const.sub continuous_id)
      continuous_const).aestronglyMeasurable.mul hf.aestronglyMeasurable
  · rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (norm_sgrKer_le j hM _ _) (norm_nonneg _)
  · exact (continuous_sgrKer_comp j hκ (continuous_fst.sub continuous_const)
      continuous_snd).mul continuous_const

/-- **Differentiation under the integral** for the Seeger operators:
`∂_v T_j f(x, v) = ∫ 2^{jn} ∂_v k_j(2^j(x - y), v) f(y) dy`. -/
theorem hasDerivAt_sgrOp {n : ℕ} {κ κ' : ℤ → Rn n → ℝ → ℂ} (j : ℤ)
    (hd : ∀ z v, HasDerivAt (fun w => κ j z w) (κ' j z v) v)
    (hκ : Continuous fun p : Rn n × ℝ => κ j p.1 p.2)
    (hκ' : Continuous fun p : Rn n × ℝ => κ' j p.1 p.2)
    {M : ℝ} (hM : ∀ z v, ‖κ j z v‖ ≤ M) (hM' : ∀ z v, ‖κ' j z v‖ ≤ M)
    {f : Rn n → ℂ} (hf : Integrable f) (x : Rn n) (v : ℝ) :
    HasDerivAt (fun w => sgrOp κ j f x w) (sgrOp κ' j f x v) v := by
  have hc : ∀ (c : ℤ → Rn n → ℝ → ℂ), Continuous (fun p : Rn n × ℝ => c j p.1 p.2) → ∀ w,
      AEStronglyMeasurable (fun y => sgrKer c j (x - y) w * f y) := fun c hc w =>
    (continuous_sgrKer_comp j hc (continuous_const.sub continuous_id)
      continuous_const).aestronglyMeasurable.mul hf.aestronglyMeasurable
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le (s := univ) (x₀ := v)
    (F := fun w y => sgrKer κ j (x - y) w * f y) (F' := fun w y => sgrKer κ' j (x - y) w * f y)
    (bound := fun y => (2 : ℝ) ^ (j * n) * M * ‖f y‖) Filter.univ_mem
    (Eventually.of_forall fun w => hc _ hκ w) ?_ (hc _ hκ' v) (ae_of_all _ fun y w _ => ?_)
    (hf.norm.const_mul _) (ae_of_all _ fun y w _ => ?_)).2
  · refine ((hf.norm.const_mul ((2 : ℝ) ^ (j * n) * M)).mono' (hc _ hκ v)
      (ae_of_all _ fun y => ?_))
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (norm_sgrKer_le j hM _ _) (norm_nonneg _)
  · rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (norm_sgrKer_le j hM' _ _) (norm_nonneg _)
  · simp only [sgrKer]
    exact ((hd _ w).const_mul _).mul_const _

/-- **The `V²`-embedding at one scale** (route replacement of (`eq:Lplqlq`) with `q = 2`): with
`T_j f(x, v) = 𝓗^{(2^{jα}v)}_{ℓ-j} P_{j+k} f(x)` and `∂_v T_j f` given by `case1KerD`,
`(V²_{J_j} T_j f(x))² ≤ 32 ‖T_j f(x, ·)‖_{L²_U} ‖∂_v T_j f(x, ·)‖_{L²_U}`. -/
theorem IsHomogeneousCZKernel.variationNorm_shortPiece_sq_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    variationNorm 2 (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ^ (2 : ℝ) ≤
      32 * (∫⁻ v, ‖sgrOp (case1Ker hΩ α ℓ k) j f x v‖ₑ ^ 2 ∂uMeasure α) ^ (1 / 2 : ℝ) *
        (∫⁻ v, ‖sgrOp (case1KerD n α Ω ℓ k) j f x v‖ₑ ^ 2 ∂uMeasure α) ^ (1 / 2 : ℝ) := by
  obtain ⟨M, hM⟩ := hΩ.exists_bound_unitKernel α ℓ k
  have hc : Continuous fun p : Rn n × ℝ => case1Ker hΩ α ℓ k j p.1 p.2 :=
    hΩ.continuous_unitKernel_uncurry α ℓ k
  have hcD : Continuous fun p : Rn n × ℝ => case1KerD n α Ω ℓ k j p.1 p.2 :=
    hΩ.continuous_unitKernelD_uncurry α ℓ k
  have hM1 : ∀ z v, ‖case1Ker hΩ α ℓ k j z v‖ ≤ M := fun z v => (hM z v).1
  have hM2 : ∀ z v, ‖case1KerD n α Ω ℓ k j z v‖ ≤ M := fun z v => (hM z v).2
  have hdk : ∀ z v, HasDerivAt (fun w => case1Ker hΩ α ℓ k j z w) (case1KerD n α Ω ℓ k j z v) v :=
    fun z v => hΩ.hasDerivAt_unitKernel α ℓ k z v
  have hfi : Integrable (f : Rn n → ℂ) := f.integrable
  have hd : ∀ v, HasDerivAt (fun w => sgrOp (case1Ker hΩ α ℓ k) j f x w)
      (sgrOp (case1KerD n α Ω ℓ k) j f x v) v := fun v =>
    hasDerivAt_sgrOp j hdk hc hcD hM1 hM2 hfi x v
  have hcont : Continuous fun v => sgrOp (case1KerD n α Ω ℓ k) j f x v :=
    continuous_comp_uncurry (continuous_sgrOp_uncurry j hcD hM2 hfi) continuous_const
      continuous_id
  rw [variationNorm_shortInterval_eq]
  have he : (fun v => shortPiece n α Ω ℓ k f j x (dyadicPoint α j * v)) =
      fun v => sgrOp (case1Ker hΩ α ℓ k) j f x v :=
    funext fun v => (hΩ.sgrOp_case1Ker α ℓ k j f x v).symm
  rw [he]
  have := variationNorm_rpow_le_of_hasDerivWithinAt (a := 1) (b := (2 : ℝ) ^ α) one_le_two
    (fun u _ => (hd u).hasDerivWithinAt) hcont.continuousOn
  refine this.trans (le_of_eq ?_)
  simp only [uMeasure, paramU, ENNReal.rpow_two]
  norm_num


/-- **Cauchy–Schwarz over the scales**: `∑_{j ∈ J} (V²_j)² ≤ 32 S_J(k)(x) S_J(∂_v k)(x)` with the
Seeger square functions `S_J`. -/
theorem IsHomogeneousCZKernel.sum_variationNorm_sq_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ)) (J : Finset ℤ)
    (x : Rn n) :
    ∑ j ∈ J, variationNorm 2 (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ^ (2 : ℝ) ≤
      32 * (sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J f x *
        sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J f x) := by
  set a : ℤ → ℝ≥0∞ := fun j => ∫⁻ v, ‖sgrOp (case1Ker hΩ α ℓ k) j f x v‖ₑ ^ 2 ∂uMeasure α
  set b : ℤ → ℝ≥0∞ := fun j => ∫⁻ v, ‖sgrOp (case1KerD n α Ω ℓ k) j f x v‖ₑ ^ 2 ∂uMeasure α
  have hsq : ∀ c : ℝ≥0∞, (c ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = c := fun c => rpow_one_div_rpow
    two_ne_zero c
  calc ∑ j ∈ J, variationNorm 2 (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ^ (2 : ℝ)
      ≤ ∑ j ∈ J, 32 * (a j ^ (1 / 2 : ℝ) * b j ^ (1 / 2 : ℝ)) := by
        refine Finset.sum_le_sum fun j _ => ?_
        rw [← mul_assoc]
        exact hΩ.variationNorm_shortPiece_sq_le α ℓ k j f x
    _ = 32 * ∑ j ∈ J, a j ^ (1 / 2 : ℝ) * b j ^ (1 / 2 : ℝ) := by rw [Finset.mul_sum]
    _ ≤ 32 * ((∑ j ∈ J, (a j ^ (1 / 2 : ℝ)) ^ (2 : ℝ)) ^ (1 / 2 : ℝ) *
          (∑ j ∈ J, (b j ^ (1 / 2 : ℝ)) ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) :=
        mul_le_mul' le_rfl (ENNReal.inner_le_Lp_mul_Lq J _ _ Real.HolderConjugate.two_two)
    _ = _ := by simp only [hsq, sgrSq, a, b]

/-- **Hölder for geometric means**: `‖(g h)^{1/2}‖_p ≤ ‖g‖_p^{1/2} ‖h‖_p^{1/2}`. -/
theorem eLpNorm_sqrt_mul_le {X : Type*} [MeasurableSpace X] {μ : Measure X} {g h : X → ℝ≥0∞}
    (hg : AEMeasurable g μ) (hh : AEMeasurable h μ) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x => (g x * h x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) μ ≤
      eLpNorm g (ENNReal.ofReal p) μ ^ (1 / 2 : ℝ) *
        eLpNorm h (ENNReal.ofReal p) μ ^ (1 / 2 : ℝ) := by
  have hp0 : ENNReal.ofReal p ≠ 0 := by simpa using hp
  have hm : AEMeasurable (fun x => (g x * h x) ^ (1 / 2 : ℝ)) μ := (hg.mul hh).pow_const _
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top hm.aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top hg.aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top hh.aestronglyMeasurable,
    ENNReal.toReal_ofReal hp.le]
  simp only [enorm_eq_self]
  have hpt : ∀ x, ((g x * h x) ^ (1 / 2 : ℝ)) ^ p =
      (g x ^ (p / 2)) * (h x ^ (p / 2)) := fun x => by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ENNReal.mul_rpow_of_nonneg _ _ hp.le,
      ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
    ring_nf
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq μ Real.HolderConjugate.two_two
    (hg.pow_const (p / 2)) (hh.pow_const (p / 2))
  have hsq : ∀ c : ℝ≥0∞, (c ^ (p / 2)) ^ (2 : ℝ) = c ^ p := fun c => by
    rw [← ENNReal.rpow_mul]; ring_nf
  simp only [hsq] at hH
  calc (∫⁻ x, ((g x * h x) ^ (1 / 2 : ℝ)) ^ p ∂μ) ^ (1 / p)
      ≤ ((∫⁻ x, g x ^ p ∂μ) ^ (1 / 2 : ℝ) * (∫⁻ x, h x ^ p ∂μ) ^ (1 / 2 : ℝ)) ^ (1 / p) := by
        refine ENNReal.rpow_le_rpow ?_ (by positivity)
        simp only [hpt]
        exact hH
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, mul_comm (1 / 2 : ℝ) (1 / p)]

/-- Measurability of the Seeger square functions for bounded continuous kernels. -/
theorem measurable_sgrSq_of_continuous {n : ℕ} {κ : ℤ → Rn n → ℝ → ℂ} (ν : Measure ℝ)
    [SFinite ν] (J : Finset ℤ) (hκ : ∀ j, Continuous fun p : Rn n × ℝ => κ j p.1 p.2) {M : ℝ}
    (hM : ∀ j z v, ‖κ j z v‖ ≤ M) {f : Rn n → ℂ} (hf : Integrable f) :
    Measurable (sgrSq ν κ J f) := by
  unfold sgrSq
  refine (Finset.measurable_sum _ fun j _ => ?_).pow_const _
  exact ((continuous_sgrOp_uncurry j (hκ j) (hM j) hf).measurable.enorm.pow_const
    2).lintegral_prod_right'

/-- Measurability of the Case 1 Seeger square functions. -/
theorem IsHomogeneousCZKernel.measurable_sgrSq_case1 {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) (J : Finset ℤ) (f : 𝓢(Rn n, ℂ)) :
    Measurable (sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J f) ∧
      Measurable (sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J f) := by
  obtain ⟨M, hM⟩ := hΩ.exists_bound_unitKernel α ℓ k
  have hfi : Integrable (f : Rn n → ℂ) := f.integrable
  exact ⟨measurable_sgrSq_of_continuous _ J (fun _ => hΩ.continuous_unitKernel_uncurry α ℓ k)
      (fun _ z v => (hM z v).1) hfi,
    measurable_sgrSq_of_continuous _ J (fun _ => hΩ.continuous_unitKernelD_uncurry α ℓ k)
      (fun _ z v => (hM z v).2) hfi⟩

/-- Measurability of `x ↦ V^r_{J_j}(u ↦ 𝓗^{(u)}_{ℓ-j} P_{j+k} f(x))`. -/
theorem IsHomogeneousCZKernel.measurable_variationNorm_shortPiece {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 < α) (r : ℝ) (ℓ k j : ℤ)
    (f : 𝓢(Rn n, ℂ)) :
    Measurable fun x => variationNorm r (shortInterval α j) (shortPiece n α Ω ℓ k f j x) := by
  have hA : ∀ u, Measurable fun x => shortPiece n α Ω ℓ k f j x u := fun u =>
    (hΩ.continuous_modulatedPiece_x α (ℓ - j) (lpProj n (j + k) f) u).measurable
  have hcu : ∀ x, Continuous (shortPiece n α Ω ℓ k f j x) := fun x =>
    hΩ.continuous_modulatedPiece_u α (ℓ - j) (lpProj n (j + k) f) x
  exact measurable_variationNorm_of_ratCast (A := shortPiece n α Ω ℓ k f j) hA hcu r
    (shortInterval_subset_closure hα j)

/-- Monotonicity in `r`: `‖V^r_j(…)‖_{ℓ^r_j} ≤ ‖V^q_j(…)‖_{ℓ^q_j}` for `0 < q ≤ r`. -/
theorem shortPieceVar_le_of_le {n : ℕ} {Ω : Rn n → ℝ} {α q r : ℝ} (hq : 0 < q) (hqr : q ≤ r)
    (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    shortPieceVar r n α Ω ℓ k f x ≤ shortPieceVar q n α Ω ℓ k f x := by
  unfold shortPieceVar
  refine (tsum_rpow_one_div_le hq hqr _).trans (ENNReal.rpow_le_rpow
    (ENNReal.tsum_le_tsum fun j => ENNReal.rpow_le_rpow (variationNorm_le_of_le hq hqr _ _)
      hq.le) (by positivity))

set_option maxHeartbeats 1000000 in
-- The proof elaborates several large `[0, ∞]`-valued expressions involving `eLpNorm`.
/-- **Case 1 reduction (S1)** (paper §4.4, (`eq:Lplqlq`) replaced by the `V²`-embedding): for
`r ≥ 2` and `p > 0`, if the Seeger square functions of `k_{ℓ,k}` and `∂_v k_{ℓ,k}` satisfy
`‖S_J(k) f‖_p ≤ X ‖f‖_p` and `‖S_J(∂_v k) f‖_p ≤ Y ‖f‖_p` for all finite `J`, then
`‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ (32 X Y)^{1/2} ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_shortPieceVar_le_of_sgrSq {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 < α) {r : ℝ} (hr : 2 ≤ r) {p : ℝ}
    (hp : 0 < p) (ℓ k : ℤ) (f : 𝓢(Rn n, ℂ)) {X Y : ℝ≥0∞}
    (hX : ∀ J : Finset ℤ, eLpNorm (sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J f)
      (ENNReal.ofReal p) ≤ X * eLpNorm f (ENNReal.ofReal p))
    (hY : ∀ J : Finset ℤ, eLpNorm (sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J f)
      (ENNReal.ofReal p) ≤ Y * eLpNorm f (ENNReal.ofReal p)) :
    eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
      (32 * X * Y) ^ (1 / 2 : ℝ) * eLpNorm f (ENNReal.ofReal p) := by
  set F := eLpNorm f (ENNReal.ofReal p)
  have hm2 : ∀ j, AEMeasurable (fun x =>
      variationNorm 2 (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ^ (2 : ℝ)) :=
    fun j => ((hΩ.measurable_variationNorm_shortPiece hα 2 ℓ k j f).pow_const _).aemeasurable
  have h2 : eLpNorm (shortPieceVar 2 n α Ω ℓ k f) (ENNReal.ofReal p) ≤
      (32 * X * Y) ^ (1 / 2 : ℝ) * F := by
    refine eLpNorm_tsum_rpow_le_of_partial hm2 hp fun N => ?_
    set J := Finset.Icc (-(N : ℤ)) N
    obtain ⟨hS1, hS2⟩ := hΩ.measurable_sgrSq_case1 α ℓ k J f
    have hpt : ∀ x, (∑ j ∈ J, variationNorm 2 (shortInterval α j)
        (shortPiece n α Ω ℓ k f j x) ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤ (32 : ℝ≥0∞) ^ (1 / 2 : ℝ) *
          (sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J f x *
            sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J f x) ^ (1 / 2 : ℝ) := fun x => by
      rw [← ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
      exact ENNReal.rpow_le_rpow (hΩ.sum_variationNorm_sq_le α ℓ k f J x) (by norm_num)
    have hG : AEMeasurable (fun x => (sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J f x *
        sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J f x) ^ (1 / 2 : ℝ)) :=
      ((hS1.mul hS2).pow_const _).aemeasurable
    have hmJ : Measurable fun x => (∑ j ∈ J, variationNorm 2 (shortInterval α j)
        (shortPiece n α Ω ℓ k f j x) ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
      refine Measurable.pow_const ?_ _
      exact Finset.measurable_sum J fun j _ =>
        (hΩ.measurable_variationNorm_shortPiece hα 2 ℓ k j f).pow_const _
    calc eLpNorm (fun x => (∑ j ∈ J, variationNorm 2 (shortInterval α j)
          (shortPiece n α Ω ℓ k f j x) ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p)
        ≤ eLpNorm (fun x => (32 : ℝ≥0∞) ^ (1 / 2 : ℝ) *
          (sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J f x *
            sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) :=
          by refine eLpNorm_mono_enorm hmJ.aestronglyMeasurable fun x => ?_
             simp only [enorm_eq_self]; exact hpt x
      _ = (32 : ℝ≥0∞) ^ (1 / 2 : ℝ) * eLpNorm (fun x =>
          (sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J f x *
            sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J f x) ^ (1 / 2 : ℝ)) (ENNReal.ofReal p) :=
          eLpNorm_const_mul_ennreal hG
            (ENNReal.rpow_ne_top_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2) ENNReal.ofNat_ne_top) hp
      _ ≤ (32 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ((X * F) ^ (1 / 2 : ℝ) * (Y * F) ^ (1 / 2 : ℝ)) := by
          refine mul_le_mul' le_rfl ((eLpNorm_sqrt_mul_le hS1.aemeasurable hS2.aemeasurable
            hp).trans (mul_le_mul' ?_ ?_))
          · exact ENNReal.rpow_le_rpow (hX J) (by norm_num : (0 : ℝ) ≤ 1 / 2)
          · exact ENNReal.rpow_le_rpow (hY J) (by norm_num : (0 : ℝ) ≤ 1 / 2)
      _ = (32 * X * Y) ^ (1 / 2 : ℝ) * F := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 2),
            ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 2),
            ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 2),
            ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 2)]
          have hF : F ^ (1 / 2 : ℝ) * F ^ (1 / 2 : ℝ) = F := by
            rw [← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]; norm_num
          calc (32 : ℝ≥0∞) ^ (1 / 2 : ℝ) * (X ^ (1 / 2 : ℝ) * F ^ (1 / 2 : ℝ) *
                (Y ^ (1 / 2 : ℝ) * F ^ (1 / 2 : ℝ)))
              = (32 : ℝ≥0∞) ^ (1 / 2 : ℝ) * X ^ (1 / 2 : ℝ) * Y ^ (1 / 2 : ℝ) *
                (F ^ (1 / 2 : ℝ) * F ^ (1 / 2 : ℝ)) := by ring
            _ = _ := by rw [hF]
  refine le_trans (eLpNorm_mono_enorm
    (hΩ.measurable_shortPieceVar hα r ℓ k f).aestronglyMeasurable fun x => ?_) h2
  simp only [enorm_eq_self]
  exact shortPieceVar_le_of_le two_pos hr ℓ k f x

/-! ### The hypotheses of the vector-valued Seeger theorem for the Case 1 kernels -/

/-- The Seeger operators of a `j`-independent family `k_j(x, v) = ψ_v(x)` are the convolutions
with the dilates `2^{jn} ψ_v(2^j ·)`. -/
theorem sgrOp_eq_lpDilate {n : ℕ} (ψ : ℝ → Rn n → ℂ) (j : ℤ) (g : Rn n → ℂ) (x : Rn n)
    (v : ℝ) : sgrOp (fun _ z w => ψ w z) j g x v = ∫ y, lpDilate n (ψ v) j (x - y) * g y := by
  simp only [sgrOp, sgrKer, lpDilate, Complex.ofReal_zpow]

/-- `S_J(k) g(x)² = ∑_{j ∈ J} ∫_U |T_j g(x, v)|² dv`. -/
theorem sgrSq_sq {n : ℕ} (ν : Measure ℝ) (κ : ℤ → Rn n → ℝ → ℂ) (J : Finset ℤ) (g : Rn n → ℂ)
    (x : Rn n) : sgrSq ν κ J g x ^ 2 = ∑ j ∈ J, ∫⁻ v, ‖sgrOp κ j g x v‖ₑ ^ 2 ∂ν :=
  sgr_rpow_half_sq _

/-- **A generic `L²` bound** (Plancherel, orthogonality in `j`; the argument of
`IsHomogeneousCZKernel.unitKernel_L2`): if `|𝓕 b_v| ≤ M` for `v ∈ U`, then the Seeger square
function of `k_j(x, v) = (P_k b_v)(x)` satisfies `‖S_J g‖₂² ≤ 2 M² |U| ‖g‖₂²`. -/
theorem lpProj_L2_of_fourier_le {n : ℕ} {α : ℝ} (hα : 0 ≤ α) (k : ℤ) (b : ℝ → 𝓢(Rn n, ℂ))
    {M : ℝ} (hb : ∀ v ∈ paramU α, ∀ ξ, ‖𝓕 (b v : Rn n → ℂ) ξ‖ ≤ M)
    (hc : Continuous fun p : Rn n × ℝ => lpProj n k (b p.2) p.1) (J : Finset ℤ)
    (g : Rn n → ℂ) (hg : MemLp g 2) :
    ∫⁻ x, ∑ j ∈ J, ∫⁻ v in paramU α, ‖∫ y, lpDilate n (lpProj n k (b v)) j (x - y) * g y‖ₑ ^ 2 ≤
      ENNReal.ofReal (2 * M ^ 2 * ((2 : ℝ) ^ α - 1)) * ∫⁻ x, ‖g x‖ₑ ^ 2 := by
  set ν : Measure ℝ := volume.restrict (paramU α)
  have hM : ∀ v ∈ paramU α, ∀ ξ, ∑ j ∈ J,
      ‖𝓕 (lpDilate n (lpProj n k (b v)) j) ξ‖ ^ 2 ≤ M ^ 2 := by
    intro v hv ξ
    have hterm : ∀ j : ℤ, ‖𝓕 (lpDilate n (lpProj n k (b v)) j) ξ‖ ^ 2 ≤
        M ^ 2 * dyadicPhiScale n (j + k) ξ := by
      intro j
      rw [fourier_lpDilate, lpProj, fourier_lpConv, fourier_lpPsi, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (dyadicPhi_nonneg _ _), mul_pow]
      have h1 := hb v hv (((2 : ℝ) ^ j)⁻¹ • ξ)
      have h2 : dyadicPhi n (((2 : ℝ) ^ k)⁻¹ • ((2 : ℝ) ^ j)⁻¹ • ξ) =
          dyadicPhiScale n (j + k) ξ := by
        rw [dyadicPhiScale, smul_smul, ← mul_inv, ← zpow_add₀ two_ne_zero, zpow_neg, add_comm]
      rw [h2]
      have h3 := dyadicPhiScale_nonneg n (j + k) ξ
      have h4 := dyadicPhiScale_le_one n (j + k) ξ
      have h5 : dyadicPhiScale n (j + k) ξ ^ 2 ≤ dyadicPhiScale n (j + k) ξ := by nlinarith
      calc dyadicPhiScale n (j + k) ξ ^ 2 * ‖𝓕 (b v : Rn n → ℂ) (((2 : ℝ) ^ j)⁻¹ • ξ)‖ ^ 2
          ≤ dyadicPhiScale n (j + k) ξ * M ^ 2 :=
            mul_le_mul h5 (pow_le_pow_left₀ (norm_nonneg _) h1 2) (by positivity) h3
        _ = _ := mul_comm _ _
    calc ∑ j ∈ J, ‖𝓕 (lpDilate n (lpProj n k (b v)) j) ξ‖ ^ 2
        ≤ ∑ j ∈ J, M ^ 2 * dyadicPhiScale n (j + k) ξ := Finset.sum_le_sum fun j _ => hterm j
      _ = M ^ 2 * ∑ j ∈ J.map (addRightEmbedding k), dyadicPhiScale n j ξ := by
          rw [Finset.mul_sum, Finset.sum_map]; rfl
      _ ≤ M ^ 2 * 1 := mul_le_mul_of_nonneg_left (sum_dyadicPhiScale_le_one _ ξ) (by positivity)
      _ = M ^ 2 := mul_one _
  have hKc : ∀ j : ℤ, Continuous fun p : Rn n × ℝ =>
      lpDilate n (lpProj n k (b p.2)) j p.1 := fun j =>
    continuous_const.mul (continuous_comp_uncurry (κ := fun z v => lpProj n k (b v) z) hc
      (continuous_fst.const_smul ((2 : ℝ) ^ j)) continuous_snd)
  have hΦm : ∀ j : ℤ, AEStronglyMeasurable (fun p : Rn n × ℝ =>
      ∫ y, lpDilate n (lpProj n k (b p.2)) j (p.1 - y) * g y) (volume.prod ν) := by
    intro j
    refine AEStronglyMeasurable.integral_prod_right' (f := fun q : (Rn n × ℝ) × Rn n =>
      lpDilate n (lpProj n k (b q.1.2)) j (q.1.1 - q.2) * g q.2) ?_
    refine AEStronglyMeasurable.mul ?_ (hg.aestronglyMeasurable.comp_snd)
    exact ((hKc j).comp ((continuous_fst.comp continuous_fst |>.sub continuous_snd).prodMk
      (continuous_snd.comp continuous_fst))).aestronglyMeasurable
  have hFm : ∀ j : ℤ, AEMeasurable (Function.uncurry fun x v =>
      ‖∫ y, lpDilate n (lpProj n k (b v)) j (x - y) * g y‖ₑ ^ 2) (volume.prod ν) :=
    fun j => ((hΦm j).enorm.pow_const 2)
  have hv2 : ∀ v ∈ paramU α, ∑ j ∈ J, ∫⁻ x,
      ‖∫ y, lpDilate n (lpProj n k (b v)) j (x - y) * g y‖ₑ ^ 2 ≤
        2 * ENNReal.ofReal (M ^ 2) * ∫⁻ x, ‖g x‖ₑ ^ 2 := by
    intro v hv
    have hk : ∀ j ∈ J, Integrable (lpDilate n (lpProj n k (b v)) j) := fun j _ =>
      integrable_lpDilate (lpProj n k (b v)).integrable j
    have h := lp_sum_eLpNorm_conv_le J hk (hM v hv) hg
    have hconv : ∀ j, (fun x => ∫ y, lpDilate n (lpProj n k (b v)) j (x - y) * g y) =
        lpDilate n (lpProj n k (b v)) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g :=
      fun j => funext fun x => (convolution_eq_integral_sub _ _ x).symm
    have hmeas : ∀ j ∈ J, AEStronglyMeasurable
        (lpDilate n (lpProj n k (b v)) j ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) := by
      intro j hj
      exact (memLp_convolution_of_memLp one_le_two
        (memLp_one_iff_integrable.2 (hk j hj)) hg).aestronglyMeasurable
    rw [← lp_eLpNorm_two_sq hg.aestronglyMeasurable]
    refine le_trans (le_of_eq ?_) h
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [lp_eLpNorm_two_sq (hmeas j hj), ← hconv j]
  have hU : ν univ = ENNReal.ofReal ((2 : ℝ) ^ α - 1) := by
    simp only [ν, Measure.restrict_apply_univ, paramU, Real.volume_Icc]
  have h1 : (1 : ℝ) ≤ 2 ^ α := Real.one_le_rpow (by norm_num) hα
  calc ∫⁻ x, ∑ j ∈ J, ∫⁻ v in paramU α,
        ‖∫ y, lpDilate n (lpProj n k (b v)) j (x - y) * g y‖ₑ ^ 2
      = ∑ j ∈ J, ∫⁻ x, ∫⁻ v, ‖∫ y, lpDilate n (lpProj n k (b v)) j (x - y) * g y‖ₑ ^ 2 ∂ν :=
        lintegral_finsetSum' J fun j _ => (hFm j).lintegral_prod_right'
    _ = ∑ j ∈ J, ∫⁻ v, ∫⁻ x,
          ‖∫ y, lpDilate n (lpProj n k (b v)) j (x - y) * g y‖ₑ ^ 2 ∂volume ∂ν :=
        Finset.sum_congr rfl fun j _ => lintegral_lintegral_swap (hFm j)
    _ = ∫⁻ v, ∑ j ∈ J, ∫⁻ x,
          ‖∫ y, lpDilate n (lpProj n k (b v)) j (x - y) * g y‖ₑ ^ 2 ∂volume ∂ν :=
        (lintegral_finsetSum' J fun j _ => (hFm j).lintegral_prod_left').symm
    _ ≤ ∫⁻ _ in paramU α, 2 * ENNReal.ofReal (M ^ 2) * ∫⁻ x, ‖g x‖ₑ ^ 2 :=
        setLIntegral_mono' measurableSet_Icc fun v hv => hv2 v hv
    _ = ENNReal.ofReal ((2 : ℝ) ^ α - 1) * (2 * ENNReal.ofReal (M ^ 2)) *
          ∫⁻ x, ‖g x‖ₑ ^ 2 := by
        rw [setLIntegral_const, ← Measure.restrict_apply_univ, ← hU]; ring
    _ = _ := by
        have h2 : (2 : ℝ≥0∞) * ENNReal.ofReal (M ^ 2) = ENNReal.ofReal (2 * M ^ 2) := by
          rw [ENNReal.ofReal_mul (p := 2) (by norm_num), ENNReal.ofReal_ofNat]
        rw [h2, ← ENNReal.ofReal_mul (by linarith)]
        congr 2
        ring

/-- Smoothness of the derivative pieces `i|t|^α e^{iu|t|^α} φ_ℓ(t) K(t)`. -/
theorem IsHomogeneousCZKernel.contDiff_pieceKernelD {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α u : ℝ) (ℓ : ℤ) :
    ContDiff ℝ (⊤ : ℕ∞) (pieceKernelD n α Ω u ℓ) := by
  have h1 : ContDiffOn ℝ (⊤ : ℕ∞) (fun t : Rn n => I * ((‖t‖ ^ α : ℝ) : ℂ))
      ({0}ᶜ : Set (Rn n)) := by
    intro t ht
    have ht' : t ≠ 0 := ht
    refine (contDiffAt_const.mul (ofRealCLM.contDiff.contDiffAt.comp t ?_)).contDiffWithinAt
    exact (contDiffAt_norm ℝ ht').rpow_const_of_ne (norm_ne_zero_iff.2 ht')
  have h2 : tsupport (pieceKernel n α Ω u ℓ) ⊆ ({0}ᶜ : Set (Rn n)) := by
    refine (closure_mono fun t ht => ?_).trans (tsupport_dyadicPhiScale_subset n ℓ)
    by_contra h
    exact ht (by simp [pieceKernel, Function.notMem_support.1 h])
  exact osc_contDiff_mul_of_tsupport isOpen_compl_singleton h1 (hΩ.contDiff_pieceKernel α u ℓ) h2

/-- The derivative piece as a Schwartz function. -/
def pieceSchwartzD {n : ℕ} {Ω : Rn n → ℝ} (hΩ : IsHomogeneousCZKernel n Ω) (α u : ℝ) (ℓ : ℤ) :
    𝓢(Rn n, ℂ) :=
  (hasCompactSupport_pieceKernelD n α Ω u ℓ).toSchwartzMap (hΩ.contDiff_pieceKernelD α u ℓ)

/-- `∂_v k_{ℓ,k}(·, v) = P_k[i|·|^α e^{iv|·|^α} φ_ℓ K]`. -/
theorem IsHomogeneousCZKernel.unitKernelD_eq_lpProj {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k : ℤ) (x : Rn n) (v : ℝ) :
    unitKernelD n α Ω ℓ k x v = lpProj n k (pieceSchwartzD hΩ α v ℓ) x := by
  rw [lpProj, lpConv_apply]; rfl

/-- **The oscillatory multiplier bound for the derivative pieces** (as
`IsHomogeneousCZKernel.norm_fourier_pieceKernel_le`, with the amplitude `i|s|^α φ₀ K`): for `α > 1`,
`|𝓕[i|·|^α e^{iv|·|^α} φ_ℓ K](ξ)| ≤ C 2^{ℓα} (2^{ℓα})^{-n/2}` for `v ∈ [1, 2^α]`. -/
theorem IsHomogeneousCZKernel.norm_fourier_pieceKernelD_le_mul {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 1 < α) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℤ) (v : ℝ) (ξ : Rn n), v ∈ paramU α →
      ‖𝓕 (pieceKernelD n α Ω v ℓ) ξ‖ ≤
        C * (dyadicPoint α ℓ * (dyadicPoint α ℓ) ^ (-(n : ℝ) / 2)) := by
  set a : Rn n → ℂ := pieceKernelD n α Ω 0 0 with ha_def
  have ha : ContDiff ℝ (⊤ : ℕ∞) a := hΩ.contDiff_pieceKernelD_zero α
  have hac : HasCompactSupport a := hasCompactSupport_pieceKernelD n α Ω 0 0
  have hbd : ∀ j : ℕ, ∃ A : ℝ, ∀ x, ‖iteratedFDeriv ℝ j a x‖ ≤ A := fun j =>
    (ha.continuous_iteratedFDeriv (by exact_mod_cast le_top)).norm.bounded_above_of_compact_support
      (hac.iteratedFDeriv j).norm |>.imp fun A hA x => by simpa using hA x
  choose A hA using hbd
  set A' := ∑ j ∈ Finset.range (n + 2), |A j|
  have hA' : ∀ j, j ≤ n + 1 → ∀ x, ‖iteratedFDeriv ℝ j a x‖ ≤ A' := fun j hj x =>
    (hA j x).trans ((le_abs_self _).trans (Finset.single_le_sum (f := fun j => |A j|)
      (fun _ _ => abs_nonneg _) (Finset.mem_range.2 (by omega))))
  obtain ⟨C, hC0, hC⟩ := norm_integral_exp_radial_le n hα ((2 : ℝ) ^ α) A'
  refine ⟨C, hC0, fun ℓ v ξ hv => ?_⟩
  have hlam : 0 < dyadicPoint α ℓ := dyadicPoint_pos α ℓ
  have hlin : ∀ (c : ℂ) (g : Rn n → ℂ), 𝓕 (fun t => c * g t) ξ = c * 𝓕 g ξ := by
    intro c g
    rw [Real.fourier_eq, Real.fourier_eq, ← integral_const_mul]
    congr 1; funext t; simp only [Circle.smul_def]; ring
  rw [hΩ.pieceKernelD_eq_lpDilate_zero, hlin, fourier_lpDilate, fourier_pieceKernelD_zero,
    norm_mul, Complex.norm_real, Real.norm_of_nonneg hlam.le]
  have := hC a (dyadicPoint α ℓ) v ((2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)) hlam hv.1 hv.2 ha
    (tsupport_pieceKernelD_zero n α Ω) hA'
  calc dyadicPoint α ℓ * ‖∫ t, Complex.exp (Complex.I * ((dyadicPoint α ℓ * v * ‖t‖ ^ α -
        ⟪t, (2 * Real.pi) • (((2 : ℝ) ^ (-ℓ))⁻¹ • ξ)⟫ : ℝ) : ℂ)) * a t‖
      ≤ dyadicPoint α ℓ * (C * dyadicPoint α ℓ ^ (-(n : ℝ) / 2)) :=
        mul_le_mul_of_nonneg_left this hlam.le
    _ = _ := by ring

/-- **(H2) for the Case 1 kernels** (Seeger's hypothesis; paper (`eq:L2_mult_bound`)): for `α > 1`
there is `C` such that for all `ℓ, k`, finite `J` and `g ∈ L²`,
`‖S_J(k_{ℓ,k}) g‖₂² ≤ C (2^{ℓα})^{-n} ‖g‖₂²` and
`‖S_J(∂_v k_{ℓ,k}) g‖₂² ≤ C (2^{ℓα})² (2^{ℓα})^{-n} ‖g‖₂²`. -/
theorem IsHomogeneousCZKernel.case1_H2 {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 1 < α) :
    ∃ C : ℝ, 0 < C ∧ ∀ (ℓ k : ℤ) (J : Finset ℤ) (g : Rn n → ℂ), MemLp g 2 →
      (∫⁻ x, sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J g x ^ 2 ≤
        ENNReal.ofReal (C * dyadicPoint α ℓ ^ (-(n : ℝ))) * ∫⁻ x, ‖g x‖ₑ ^ 2) ∧
      ∫⁻ x, sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J g x ^ 2 ≤
        ENNReal.ofReal (C * (dyadicPoint α ℓ ^ 2 * dyadicPoint α ℓ ^ (-(n : ℝ)))) *
          ∫⁻ x, ‖g x‖ₑ ^ 2 := by
  obtain ⟨C₁, hC₁0, hC₁⟩ := hΩ.unitKernel_L2 hα
  obtain ⟨C₂, hC₂0, hC₂⟩ := hΩ.norm_fourier_pieceKernelD_le_mul hα
  have hα0 : 0 ≤ α := by linarith
  have h1 : (1 : ℝ) ≤ 2 ^ α := Real.one_le_rpow (by norm_num) hα0
  refine ⟨C₁ + 2 * C₂ ^ 2 * ((2 : ℝ) ^ α - 1) + 1, by positivity, fun ℓ k J g hg => ⟨?_, ?_⟩⟩
  · have := hC₁ ℓ k J g hg
    have e1 : ∀ j x v, sgrOp (case1Ker hΩ α ℓ k) j g x v =
        ∫ y, lpDilate n (unitKernel hΩ α ℓ k v) j (x - y) * g y := fun j x v =>
      sgrOp_eq_lpDilate (fun v z => unitKernel hΩ α ℓ k v z) j g x v
    simp only [sgrSq_sq, e1, uMeasure]
    refine this.trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have hX : 0 ≤ dyadicPoint α ℓ ^ (-(n : ℝ)) := by have := dyadicPoint_pos α ℓ; positivity
    have := mul_nonneg (add_nonneg (mul_nonneg (by positivity : (0 : ℝ) ≤ 2 * C₂ ^ 2)
      (sub_nonneg.2 h1)) zero_le_one) hX
    nlinarith
  · have hlam := dyadicPoint_pos α ℓ
    have hc : Continuous fun p : Rn n × ℝ => lpProj n k (pieceSchwartzD hΩ α p.2 ℓ) p.1 := by
      have := hΩ.continuous_unitKernelD_uncurry α ℓ k
      simp_rw [hΩ.unitKernelD_eq_lpProj] at this
      exact this
    have := lpProj_L2_of_fourier_le hα0 k (fun v => pieceSchwartzD hΩ α v ℓ)
      (fun v hv ξ => hC₂ ℓ v ξ hv) hc J g hg
    have hK : case1KerD n α Ω ℓ k = fun _ z w => lpProj n k (pieceSchwartzD hΩ α w ℓ) z :=
      funext fun _ => funext fun z => funext fun w => hΩ.unitKernelD_eq_lpProj α ℓ k z w
    have e2 : ∀ j x v, sgrOp (case1KerD n α Ω ℓ k) j g x v =
        ∫ y, lpDilate n (lpProj n k (pieceSchwartzD hΩ α v ℓ)) j (x - y) * g y := fun j x v => by
      rw [hK]; exact sgrOp_eq_lpDilate (fun v z => lpProj n k (pieceSchwartzD hΩ α v ℓ) z) j g x v
    simp only [sgrSq_sq, e2, uMeasure]
    refine this.trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have hX : 0 ≤ dyadicPoint α ℓ ^ 2 * dyadicPoint α ℓ ^ (-(n : ℝ)) := by positivity
    have hsq : (C₂ * (dyadicPoint α ℓ * dyadicPoint α ℓ ^ (-(n : ℝ) / 2))) ^ 2 =
        C₂ ^ 2 * (dyadicPoint α ℓ ^ 2 * dyadicPoint α ℓ ^ (-(n : ℝ))) := by
      rw [mul_pow, mul_pow, ← Real.rpow_natCast (dyadicPoint α ℓ ^ (-(n : ℝ) / 2)),
        ← Real.rpow_mul hlam.le]
      norm_num
    rw [hsq]
    have : 0 ≤ C₁ * (dyadicPoint α ℓ ^ 2 * dyadicPoint α ℓ ^ (-(n : ℝ))) := by positivity
    have h2 : 0 ≤ (2 : ℝ) ^ α - 1 := by linarith
    nlinarith [mul_nonneg (mul_nonneg (sq_nonneg C₂) h2) hX]

/-- The scale factor `2^{-k} + 2^{ℓ+1} + 2^k` of the tail and smoothness constants. -/
def case1Scale (ℓ k : ℤ) : ℝ := ((2 : ℝ) ^ k)⁻¹ + (2 : ℝ) ^ (ℓ + 1) + (2 : ℝ) ^ k

/-- `case1Scale ℓ k > 0`. -/
theorem case1Scale_pos (ℓ k : ℤ) : 0 < case1Scale ℓ k := by unfold case1Scale; positivity

/-- **(H1), (Htail), (Hsmooth) for the Case 1 kernels** (Seeger's hypotheses; from
`IsHomogeneousCZKernel.unitKernel_bounds`): there are `A, B > 0` such that for all `ℓ, k, j`,
with `S = 2^{-k} + 2^{ℓ+1} + 2^k` and `a = 0` for `k_{ℓ,k}`, `a = α` for `∂_v k_{ℓ,k}`:
`∫ ‖k(x)‖_{L²_U} ≤ A 2^{(ℓ+1)a}`, `∫_{|x|>R} ‖k(x)‖_{L²_U} ≤ B 2^{(ℓ+1)a} S / R`,
`∫ ‖k(x - y) - k(x)‖_{L²_U} ≤ B 2^{(ℓ+1)a} S |y|`. -/
theorem IsHomogeneousCZKernel.case1_L1 {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α : ℝ} (hα : 0 ≤ α) :
    ∃ A B : ℝ, 0 < A ∧ 0 < B ∧ ∀ ℓ k j : ℤ, ∀ κ : ℤ → Rn n → ℝ → ℂ, ∀ a : ℝ,
      ((κ = case1Ker hΩ α ℓ k ∧ a = 0) ∨ (κ = case1KerD n α Ω ℓ k ∧ a = α)) →
      (∫⁻ x, sgrUNorm (uMeasure α) (κ j x) ≤
        ENNReal.ofReal (A * (2 : ℝ) ^ (((ℓ : ℝ) + 1) * a))) ∧
      (∀ R : ℝ, 0 < R → ∫⁻ x in {x : Rn n | R < ‖x‖}, sgrUNorm (uMeasure α) (κ j x) ≤
        ENNReal.ofReal (B * (2 : ℝ) ^ (((ℓ : ℝ) + 1) * a) * case1Scale ℓ k / R)) ∧
      ∀ y : Rn n, ∫⁻ x, sgrUNorm (uMeasure α) (κ j (x - y) - κ j x) ≤
        ENNReal.ofReal (B * (2 : ℝ) ^ (((ℓ : ℝ) + 1) * a) * case1Scale ℓ k * ‖y‖) := by
  obtain ⟨A, B, hA, hB, h⟩ := hΩ.unitKernel_bounds hα
  refine ⟨A.toReal + 1, B.toReal + 1, by positivity, by positivity, fun ℓ k j κ a hκ => ?_⟩
  have hAle : A ≤ ENNReal.ofReal (A.toReal + 1) :=
    (ENNReal.ofReal_toReal hA).symm.le.trans (ENNReal.ofReal_le_ofReal (by linarith))
  have hBle : B ≤ ENNReal.ofReal (B.toReal + 1) :=
    (ENNReal.ofReal_toReal hB).symm.le.trans (ENNReal.ofReal_le_ofReal (by linarith))
  -- reduce to `convKernel`
  obtain ⟨b, hbκ, hb, hbi⟩ : ∃ b : ℝ → Rn n → ℂ, (∀ x, κ j x = fun v => convKernel n k b x v) ∧
      (∀ v t, ‖b v t‖ₑ = ENNReal.ofReal (‖t‖ ^ a * |dyadicPhiScale n ℓ t * czKernel n Ω t|)) ∧
      ∀ v, Integrable (b v) := by
    rcases hκ with ⟨rfl, rfl⟩ | ⟨rfl, ha'⟩
    · exact ⟨fun v => pieceKernel n α Ω v ℓ, fun x => funext fun v =>
        unitKernel_eq_convKernel hΩ α ℓ k x v, fun v t => enorm_pieceKernel_eq n α Ω v ℓ t,
        fun v => hΩ.integrable_pieceKernel α v ℓ⟩
    · exact ⟨fun v => pieceKernelD n α Ω v ℓ, fun x => rfl, fun v t => by
        rw [ha']; exact norm_pieceKernelD n α Ω v ℓ t, fun v => hΩ.integrable_pieceKernelD α v ℓ⟩
  have ha : a = 0 ∨ a = α := by rcases hκ with ⟨-, h⟩ | ⟨-, h⟩ <;> simp [h]
  obtain ⟨h1, h2, h3⟩ := h ℓ k a ha b hb hbi
  have hS : ((2 : ℝ) ^ k)⁻¹ + (2 : ℝ) ^ (ℓ + 1) ≤ case1Scale ℓ k := by
    unfold case1Scale; have : (0 : ℝ) < 2 ^ k := by positivity
    linarith
  have hk : (2 : ℝ) ^ k ≤ case1Scale ℓ k := by
    unfold case1Scale; have : (0 : ℝ) < (2 ^ k)⁻¹ := by positivity
    have : (0 : ℝ) < 2 ^ (ℓ + 1) := by positivity
    linarith
  have hE := ENNReal.ofReal_pos.2 (by positivity : (0 : ℝ) < 2 ^ (((ℓ : ℝ) + 1) * a))
  refine ⟨?_, fun R hR => ?_, fun y => ?_⟩
  · simp only [hbκ, sgrUNorm_uMeasure]
    refine h1.trans ?_
    rw [ENNReal.ofReal_mul (by positivity)]
    exact mul_le_mul' hAle le_rfl
  · simp only [hbκ, sgrUNorm_uMeasure]
    refine (h2 R hR).trans ?_
    calc B * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) *
          ENNReal.ofReal ((((2 : ℝ) ^ k)⁻¹ + (2 : ℝ) ^ (ℓ + 1)) * R⁻¹)
        ≤ ENNReal.ofReal (B.toReal + 1) * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) *
          ENNReal.ofReal (case1Scale ℓ k * R⁻¹) := by
          gcongr
      _ = _ := by
          rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
          congr 1; ring
  · have e : ∀ x, sgrUNorm (uMeasure α) (κ j (x - y) - κ j x) = uNorm α (fun v =>
        convKernel n k b (x - y) v - convKernel n k b x v) := fun x => by
      rw [hbκ, hbκ]; rfl
    simp only [e]
    refine (h3 y).trans ?_
    calc B * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) *
          ENNReal.ofReal ((2 : ℝ) ^ k * ‖y‖)
        ≤ ENNReal.ofReal (B.toReal + 1) * ENNReal.ofReal ((2 : ℝ) ^ (((ℓ : ℝ) + 1) * a)) *
          ENNReal.ofReal (case1Scale ℓ k * ‖y‖) := by
          gcongr
      _ = _ := by
          rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
          congr 1; ring

/-- Fubini for `convKernel`-type kernels: `∫ (ψ_k * b)(x - y) g(y) dy = ∫ b(t) (ψ_k * g)(x - t) dt`
for integrable measurable `b` and bounded measurable `g`. -/
theorem integral_convKernel_mul_eq {n : ℕ} (k : ℤ) {b : Rn n → ℂ} (hbi : Integrable b)
    (hbm : Measurable b) {g : Rn n → ℂ} (hg : Measurable g) {B : ℝ} (hgb : ∀ y, ‖g y‖ ≤ B)
    (x : Rn n) :
    ∫ y, (∫ t, lpDilate n (lpPsi n) k (x - y - t) * b t) * g y =
      ∫ t, b t * ∫ y, lpDilate n (lpPsi n) k (x - t - y) * g y := by
  have hψc : Continuous (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous
  have hψi : Integrable (lpDilate n (lpPsi n) k) := integrable_lpDilate (lpPsi n).integrable k
  set f : Rn n × Rn n → ℂ := fun p => lpDilate n (lpPsi n) k (x - p.1 - p.2) * b p.2 * g p.1
  have hfm : Measurable f :=
    ((hψc.measurable.comp ((measurable_const.sub measurable_fst).sub measurable_snd)).mul
      (hbm.comp measurable_snd)).mul (hg.comp measurable_fst)
  have hint : Integrable f (volume.prod volume) := by
    rw [integrable_prod_iff' hfm.aestronglyMeasurable]
    constructor
    · refine ae_of_all _ fun t => ?_
      have h1 : Integrable fun y => lpDilate n (lpPsi n) k (x - t - y) :=
        (hψi.comp_sub_left (x - t))
      refine ((h1.mul_const (b t)).bdd_mul (c := B)
        (hg.aestronglyMeasurable) (ae_of_all _ hgb)).congr (ae_of_all _ fun y => ?_)
      simp only [f, sub_right_comm x y t]; ring
    · refine (hbi.norm.mul_const (∫ z, ‖lpDilate n (lpPsi n) k z‖ * B)).mono'
        (hfm.norm.stronglyMeasurable.integral_prod_left'.aestronglyMeasurable)
        (ae_of_all _ fun t => ?_)
      rw [Real.norm_of_nonneg (integral_nonneg fun _ => norm_nonneg _)]
      calc ∫ y, ‖f (y, t)‖ ≤ ∫ y, ‖b t‖ * (‖lpDilate n (lpPsi n) k (x - t - y)‖ * B) := by
            refine integral_mono_of_nonneg (ae_of_all _ fun _ => norm_nonneg _)
              (((hψi.comp_sub_left (x - t)).norm.mul_const B).const_mul _)
              (ae_of_all _ fun y => ?_)
            have he : ‖f (y, t)‖ = ‖lpDilate n (lpPsi n) k (x - t - y)‖ * ‖b t‖ * ‖g y‖ := by
              simp only [f, norm_mul, sub_right_comm x y t]
            change ‖f (y, t)‖ ≤ _
            rw [he]
            have hprod := mul_nonneg (norm_nonneg (lpDilate n (lpPsi n) k (x - t - y)))
              (norm_nonneg (b t))
            nlinarith [mul_le_mul_of_nonneg_left (hgb y) hprod]
        _ = ‖b t‖ * ∫ z, ‖lpDilate n (lpPsi n) k z‖ * B := by
            rw [integral_const_mul]
            congr 1
            exact integral_sub_left_eq_self (fun z => ‖lpDilate n (lpPsi n) k z‖ * B) _ (x - t)
  have h2 : ∀ y, (∫ t, lpDilate n (lpPsi n) k (x - y - t) * b t) * g y =
      ∫ t, f (y, t) := fun y => by
    rw [← integral_mul_const]
  simp_rw [h2]
  rw [integral_integral_swap (f := fun y t => f (y, t)) hint]
  congr 1; funext t
  rw [← integral_const_mul]
  congr 1; funext y
  simp only [f]; rw [sub_right_comm x y t]; ring

/-- Rescaling the derivative piece integral to the unit annulus:
`∫ i|t|^α e^{iv|t|^α} φ_ℓ(t) K(t) H(t) dt = 2^{ℓα} ∫ e^{i 2^{ℓα} v |s|^α} [i|s|^α φ₀(s) K(s)]
H(2^ℓ s) ds`. -/
theorem IsHomogeneousCZKernel.integral_pieceKernelD_mul_eq {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α v : ℝ) (ℓ : ℤ) (H : Rn n → ℂ) :
    ∫ t, pieceKernelD n α Ω v ℓ t * H t = (dyadicPoint α ℓ : ℂ) *
      ∫ s, radPhase α (dyadicPoint α ℓ) v s * (pieceKernelD n α Ω 0 0 s * H ((2 : ℝ) ^ ℓ • s)) := by
  have h := hΩ.integral_pieceKernel_mul_eq α v ℓ (fun t => (I * ((‖t‖ ^ α : ℝ) : ℂ)) * H t)
  have hc : 0 < (2 : ℝ) ^ ℓ := zpow_pos two_pos ℓ
  have hn : ∀ s : Rn n, ‖(2 : ℝ) ^ ℓ • s‖ ^ α = dyadicPoint α ℓ * ‖s‖ ^ α := fun s => by
    rw [norm_smul, Real.norm_of_nonneg hc.le, Real.mul_rpow hc.le (norm_nonneg _),
      dyadicPoint, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]
  rw [← integral_const_mul]
  convert h using 2
  · funext t; simp only [pieceKernelD]; ring
  · funext s; simp only [pieceKernelD, hn]; push_cast; ring

/-- **The `L^∞ → L^∞(L²_U)` bound for the derivative kernels** (`A_∞` for `∂_v k_{ℓ,k}`; same
proof as `IsHomogeneousCZKernel.unitKernel_Linfty` with the amplitude `i|s|^α φ₀ K`): for `α > 1`
there is `C` such that for all `ℓ, k`, measurable `g` with `|g| ≤ 1` and all `x`,
`∫_U |∫ ∂_v k_{ℓ,k}(x - y, v) g(y) dy|² dv ≤ C 2^{ℓα}`. -/
theorem IsHomogeneousCZKernel.unitKernelD_Linfty {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ k : ℤ) (g : Rn n → ℂ), Measurable g → (∀ y, ‖g y‖ ≤ 1) →
      ∀ x : Rn n, ∫⁻ v in paramU α, ‖∫ y, unitKernelD n α Ω ℓ k (x - y) v * g y‖ₑ ^ 2 ≤
        ENNReal.ofReal (C * dyadicPoint α ℓ) := by
  obtain ⟨Cc, hCc0, hCc⟩ := lintegral_osc_sq_le hn hα
  obtain ⟨CΩ, hC0, hC⟩ := hΩ.exists_bound
  have hα0 : 0 ≤ α := by linarith
  set Bψ := ∫ z, ‖lpPsi n z‖
  have hBψ : 0 ≤ Bψ := integral_nonneg fun _ => norm_nonneg _
  set W := (2 : ℝ) ^ α * pieceSup n CΩ 0 * Bψ
  have hW0 : 0 ≤ W := by unfold W pieceSup; positivity
  refine ⟨Cc * W ^ 2, by positivity, fun ℓ k g hg hgb x => ?_⟩
  have hψc : Continuous (lpDilate n (lpPsi n) k) := by
    rw [← coe_schwartzDilate]; exact (schwartzDilate (lpPsi n) k).continuous
  set H : Rn n → ℂ := fun t => ∫ y, lpDilate n (lpPsi n) k (x - t - y) * g y
  have hHb : ∀ t, ‖H t‖ ≤ Bψ := by
    intro t
    refine (norm_integral_le_integral_norm _).trans ?_
    calc ∫ y, ‖lpDilate n (lpPsi n) k (x - t - y) * g y‖
        ≤ ∫ y, ‖lpDilate n (lpPsi n) k (x - t - y)‖ := by
          refine integral_mono_of_nonneg (ae_of_all _ fun _ => norm_nonneg _)
            ((integrable_lpDilate (lpPsi n).integrable k).comp_sub_left (x - t)).norm
            (ae_of_all _ fun y => ?_)
          simp only [norm_mul]
          exact mul_le_of_le_one_right (norm_nonneg _) (hgb y)
      _ = ∫ z, ‖lpDilate n (lpPsi n) k z‖ :=
          integral_sub_left_eq_self (fun z => ‖lpDilate n (lpPsi n) k z‖) _ (x - t)
      _ = Bψ := by
          rw [integral_norm_eq_lintegral_enorm hψc.aestronglyMeasurable,
            lintegral_enorm_lpDilate (lpPsi n).continuous.measurable,
            ← integral_norm_eq_lintegral_enorm (lpPsi n).continuous.aestronglyMeasurable]
  have hHm : Measurable H := by
    have hm : Measurable fun p : Rn n × Rn n => lpDilate n (lpPsi n) k (x - p.1 - p.2) * g p.2 :=
      (hψc.measurable.comp ((measurable_const.sub measurable_fst).sub measurable_snd)).mul
        (hg.comp measurable_snd)
    exact hm.stronglyMeasurable.integral_prod_right'.measurable
  set F : Rn n → ℂ := fun s => pieceKernelD n α Ω 0 0 s * H ((2 : ℝ) ^ ℓ • s)
  have hFm : Measurable F :=
    (hΩ.contDiff_pieceKernelD_zero α).continuous.measurable.mul
      (hHm.comp (measurable_const_smul _))
  have hFs : ∀ s, F s ≠ 0 → ‖s‖ ∈ Icc (1 / 2 : ℝ) 2 := by
    intro s hs
    have h : dyadicPhi n s ≠ 0 := by
      intro h; apply hs
      simp [F, pieceKernelD, pieceKernel_zero_zero_apply, h]
    have := dyadicPhi_ne_zero h
    exact ⟨this.1.le, this.2.le⟩
  have hFb : ∀ s, ‖F s‖ ≤ W := by
    intro s
    by_cases h0 : F s = 0
    · rw [h0, norm_zero]; exact hW0
    have hs := hFs s h0
    simp only [F, W]
    rw [norm_mul, norm_pieceKernelD_real]
    have h1 := abs_dyadicPhiScale_mul_czKernel_le hC0 hC 0 s
    have h1' : |dyadicPhiScale n 0 s * czKernel n Ω s| ≤ pieceSup n CΩ 0 := by
      refine h1.trans ?_
      by_cases hs : s ∈ Metric.closedBall (0 : Rn n) ((2 : ℝ) ^ ((0 : ℤ) + 1))
      · rw [indicator_of_mem hs]
      · rw [indicator_of_notMem hs]; unfold pieceSup; positivity
    have h2 : ‖s‖ ^ α ≤ (2 : ℝ) ^ α := Real.rpow_le_rpow (norm_nonneg _) hs.2 hα0
    have h3 : 0 ≤ pieceSup n CΩ 0 := by unfold pieceSup; positivity
    exact mul_le_mul (mul_le_mul h2 h1' (abs_nonneg _) (by positivity)) (hHb _) (norm_nonneg _)
      (by positivity)
  have hrep : ∀ v, ∫ y, unitKernelD n α Ω ℓ k (x - y) v * g y =
      (dyadicPoint α ℓ : ℂ) * ∫ s, radPhase α (dyadicPoint α ℓ) v s * F s := by
    intro v
    have := integral_convKernel_mul_eq k (hΩ.integrable_pieceKernelD α v ℓ)
      (hΩ.contDiff_pieceKernelD α v ℓ).continuous.measurable hg hgb x
    rw [show (fun y => unitKernelD n α Ω ℓ k (x - y) v * g y) = fun y =>
      (∫ t, lpDilate n (lpPsi n) k (x - y - t) * pieceKernelD n α Ω v ℓ t) * g y from rfl, this]
    exact hΩ.integral_pieceKernelD_mul_eq α v ℓ H
  have hlam := dyadicPoint_pos α ℓ
  simp_rw [hrep, enorm_mul, mul_pow]
  rw [lintegral_const_mul' _ _ (by simp)]
  refine (mul_le_mul' le_rfl (hCc F W (dyadicPoint α ℓ) hFm hFb hFs hlam)).trans (le_of_eq ?_)
  rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hlam.le,
    ← ENNReal.ofReal_pow hlam.le, ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  field_simp

/-- **From unit-scale `L^∞` bounds to Seeger's hypothesis (H∞)**: if
`∫_U |∫ κ(x - y, v) g(y) dy|² dv ≤ A²` for all measurable `|g| ≤ 1` and all `x`, then the
dilated operators `T_j f(x, v) = ∫ 2^{jn} κ(2^j(x - y), v) f(y) dy` satisfy
`‖T_j f(x, ·)‖_{L²_U} ≤ A ‖f‖_∞` (change of variables `y ↦ 2^{-j} y`; `f` is modified on a null
set to be bounded everywhere). -/
theorem sgrUNorm_sgrOp_le_of_unit {n : ℕ} {α : ℝ} (κ : Rn n → ℝ → ℂ) {A : ℝ} (hA : 0 ≤ A)
    (h : ∀ g : Rn n → ℂ, Measurable g → (∀ y, ‖g y‖ ≤ 1) → ∀ x,
      ∫⁻ v in paramU α, ‖∫ y, κ (x - y) v * g y‖ₑ ^ 2 ≤ ENNReal.ofReal (A ^ 2))
    (j : ℤ) {f : Rn n → ℂ} (hf : Measurable f) (hft : eLpNorm f ⊤ volume < ∞) (x : Rn n) :
    sgrUNorm (uMeasure α) (sgrOp (fun _ => κ) j f x) ≤ ENNReal.ofReal A * eLpNorm f ⊤ volume := by
  set E := eLpNorm f ⊤ volume
  set M := E.toReal
  have hEM : E = ENNReal.ofReal M := (ENNReal.ofReal_toReal hft.ne).symm
  have hM0 : 0 ≤ M := ENNReal.toReal_nonneg
  set f' : Rn n → ℂ := {y | ‖f y‖ ≤ M}.indicator f
  have hmS : MeasurableSet {y | ‖f y‖ ≤ M} := measurableSet_le hf.norm measurable_const
  have hf'm : Measurable f' := hf.indicator hmS
  have hf'b : ∀ y, ‖f' y‖ ≤ M := fun y => by
    by_cases hy : ‖f y‖ ≤ M
    · rw [show f' y = f y from indicator_of_mem (s := {y | ‖f y‖ ≤ M}) hy f]; exact hy
    · rw [show f' y = 0 from indicator_of_notMem (s := {y | ‖f y‖ ≤ M}) hy f, norm_zero]
      exact hM0
  have hae : f =ᵐ[volume] f' := by
    have h1 := ae_le_eLpNormEssSup (f := f) (μ := volume)
    rw [← eLpNorm_exponent_top hf.aestronglyMeasurable] at h1
    filter_upwards [h1] with y hy
    have hy' : ‖f y‖ ≤ M := by
      rw [← toReal_enorm]; exact ENNReal.toReal_mono hft.ne hy
    exact (indicator_of_mem (s := {y | ‖f y‖ ≤ M}) hy' f).symm
  have hc : 0 < (2 : ℝ) ^ j := zpow_pos two_pos j
  -- the change of variables
  have hscale : ∀ v, sgrOp (fun _ => κ) j f x v =
      ∫ w, κ ((2 : ℝ) ^ j • x - w) v * f' (((2 : ℝ) ^ j)⁻¹ • w) := by
    intro v
    have h1 : sgrOp (fun _ => κ) j f x v = ∫ y, sgrKer (fun _ => κ) j (x - y) v * f' y := by
      unfold sgrOp; exact integral_congr_ae (hae.mono fun y hy => by simp only [hy])
    have key := Measure.integral_comp_smul (volume : Measure (Rn n))
      (fun w => κ ((2 : ℝ) ^ j • x - w) v * f' (((2 : ℝ) ^ j)⁻¹ • w)) ((2 : ℝ) ^ j)
    rw [finrank_euclideanSpace_fin, abs_of_pos (by positivity)] at key
    have hpt : ∀ y, sgrKer (fun _ => κ) j (x - y) v * f' y =
        ((((2 : ℝ) ^ j) ^ n : ℝ) : ℂ) * (κ ((2 : ℝ) ^ j • x - (2 : ℝ) ^ j • y) v *
          f' (((2 : ℝ) ^ j)⁻¹ • (2 : ℝ) ^ j • y)) := fun y => by
      rw [inv_smul_smul₀ hc.ne', sgrKer, smul_sub, ← zpow_natCast, ← zpow_mul]
      ring
    simp_rw [h1, hpt]
    rw [integral_const_mul, key, Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul,
      mul_inv_cancel₀ (by positivity), Complex.ofReal_one, one_mul]
  rcases hM0.eq_or_lt with hM | hM
  · -- `f = 0` a.e.
    have h0 : ∀ v, sgrOp (fun _ => κ) j f x v = 0 := fun v => by
      rw [hscale]
      refine integral_eq_zero_of_ae (ae_of_all _ fun w => ?_)
      have := hf'b (((2 : ℝ) ^ j)⁻¹ • w)
      rw [← hM, norm_le_zero_iff] at this
      simp [this]
    simp only [sgrUNorm, h0, enorm_zero]
    simp
  set g : Rn n → ℂ := fun w => ((M : ℂ))⁻¹ * f' (((2 : ℝ) ^ j)⁻¹ • w)
  have hgm : Measurable g := measurable_const.mul (hf'm.comp (measurable_const_smul _))
  have hgb : ∀ w, ‖g w‖ ≤ 1 := fun w => by
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hM0, inv_mul_le_iff₀ hM,
      mul_one]
    exact hf'b _
  have hrep : ∀ v, sgrOp (fun _ => κ) j f x v = (M : ℂ) * ∫ w, κ ((2 : ℝ) ^ j • x - w) v * g w := by
    intro v
    rw [hscale, ← integral_const_mul]
    congr 1; funext w
    have hM' : (M : ℂ) ≠ 0 := by exact_mod_cast hM.ne'
    simp only [g]; field_simp
  have hb := h g hgm hgb ((2 : ℝ) ^ j • x)
  unfold sgrUNorm uMeasure
  simp_rw [hrep, enorm_mul, mul_pow]
  rw [lintegral_const_mul' _ _ (by simp)]
  calc (‖(M : ℂ)‖ₑ ^ 2 * ∫⁻ v in paramU α, ‖∫ w, κ ((2 : ℝ) ^ j • x - w) v * g w‖ₑ ^ 2) ^
        (1 / 2 : ℝ)
      ≤ (ENNReal.ofReal M ^ 2 * ENNReal.ofReal A ^ 2) ^ (1 / 2 : ℝ) := by
        refine ENNReal.rpow_le_rpow (mul_le_mul' (le_of_eq ?_) ?_) (by norm_num)
        · rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hM0]
        · rwa [← ENNReal.ofReal_pow hA]
    _ = ENNReal.ofReal A * E := by
        rw [← mul_pow, sgr_sq_rpow_half, hEM, mul_comm]

/-- **(H∞) for the Case 1 kernels** (Seeger's hypothesis for `p ≥ 2`; from
`IsHomogeneousCZKernel.unitKernel_Linfty`, `IsHomogeneousCZKernel.unitKernelD_Linfty` and
dilation): for `α > 1` there is `C` such that for all `ℓ, k, j`, measurable essentially bounded `f`
and all `x`, `‖T_j f(x, ·)‖_{L²_U} ≤ C (2^{ℓα})^{-1/2} ‖f‖_∞` for `k_{ℓ,k}` and
`≤ C (2^{ℓα})^{1/2} ‖f‖_∞` for `∂_v k_{ℓ,k}`. -/
theorem IsHomogeneousCZKernel.case1_Hinf {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) :
    ∃ C : ℝ, 0 < C ∧ ∀ (ℓ k j : ℤ) (f : Rn n → ℂ), Measurable f → eLpNorm f ⊤ volume < ∞ →
      ∀ x, sgrUNorm (uMeasure α) (sgrOp (case1Ker hΩ α ℓ k) j f x) ≤
          ENNReal.ofReal (C * dyadicPoint α ℓ ^ (-(1 / 2 : ℝ))) * eLpNorm f ⊤ volume ∧
        sgrUNorm (uMeasure α) (sgrOp (case1KerD n α Ω ℓ k) j f x) ≤
          ENNReal.ofReal (C * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) * eLpNorm f ⊤ volume := by
  obtain ⟨C₁, hC₁0, hC₁⟩ := hΩ.unitKernel_Linfty hn hα
  obtain ⟨C₂, hC₂0, hC₂⟩ := hΩ.unitKernelD_Linfty hn hα
  refine ⟨√(C₁ + C₂ + 1), by positivity, fun ℓ k j f hf hft x => ⟨?_, ?_⟩⟩
  · have hlam := dyadicPoint_pos α ℓ
    refine sgrUNorm_sgrOp_le_of_unit (fun z v => unitKernel hΩ α ℓ k v z) (by positivity)
      (fun g hg hgb x => (hC₁ ℓ k g hg hgb x).trans (ENNReal.ofReal_le_ofReal ?_)) j hf hft x
    rw [mul_pow, Real.sq_sqrt (by positivity), ← Real.rpow_natCast, ← Real.rpow_mul hlam.le,
      show (-(1 / 2 : ℝ)) * ((2 : ℕ) : ℝ) = -1 by norm_num, Real.rpow_neg_one, div_eq_mul_inv]
    exact mul_le_mul_of_nonneg_right (by linarith) (by positivity)
  · have hlam := dyadicPoint_pos α ℓ
    refine sgrUNorm_sgrOp_le_of_unit (fun z v => unitKernelD n α Ω ℓ k z v) (by positivity)
      (fun g hg hgb x => (hC₂ ℓ k g hg hgb x).trans (ENNReal.ofReal_le_ofReal ?_)) j hf hft x
    rw [mul_pow, Real.sq_sqrt (by positivity), ← Real.rpow_natCast, ← Real.rpow_mul hlam.le]
    norm_num
    exact mul_le_mul_of_nonneg_right (by linarith) (by positivity)

/-- Measurability of the Case 1 kernels (Seeger's joint measurability hypothesis). -/
theorem IsHomogeneousCZKernel.measurable_case1Ker {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k j : ℤ) :
    Measurable (Function.uncurry (case1Ker hΩ α ℓ k j)) ∧
      Measurable (Function.uncurry (case1KerD n α Ω ℓ k j)) :=
  ⟨(hΩ.continuous_unitKernel_uncurry α ℓ k).measurable,
    (hΩ.continuous_unitKernelD_uncurry α ℓ k).measurable⟩

/-- The width `W` of Case 1: `|k - ℓ(α - 1)| ≤ W` (paper §4.3: `k = ℓ(α-1) + O(1)`). -/
def case1Width (α : ℝ) : ℝ :=
  |Real.logb 2 (2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1| / Real.pi)| +
    |Real.logb 2 (8 * Real.pi / (α * 2 ^ (-|α - 1|)))|

/-- **Case 1 forces `k = ℓ(α-1) + O(1)`**: `|k - ℓ(α-1)| ≤ W` on `case1Region`. -/
theorem abs_sub_le_case1Width {α : ℝ} (hα : 1 < α) {ℓ k : ℤ} (h : case1Region α ℓ k) :
    |(k : ℝ) - ℓ * (α - 1)| ≤ case1Width α := by
  obtain ⟨-, -, h2, h3⟩ := h
  unfold case2Cond dyadicPoint at h2
  unfold case3Cond dyadicPoint at h3
  push Not at h2 h3
  have hα0 : 0 < α := by linarith
  have hpi := Real.pi_pos
  set c₂ := 2 * α * (2 : ℝ) ^ α * 2 ^ |α - 1|
  set c₃ := α * (2 : ℝ) ^ (-|α - 1|)
  have hc₂ : 0 < c₂ := by positivity
  have hc₃ : 0 < c₃ := by positivity
  rw [two_zpow_eq_rpow] at h2 h3
  push_cast at h2 h3
  have e1 : (ℓ + k : ℝ) - ℓ * α < Real.logb 2 (c₂ / Real.pi) := by
    rw [Real.lt_logb_iff_rpow_lt (by norm_num) (by positivity), Real.rpow_sub two_pos,
      lt_div_iff₀ (by positivity), div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
    linarith
  have e2 : ℓ * α - (ℓ + k : ℝ) < Real.logb 2 (8 * Real.pi / c₃) := by
    rw [Real.lt_logb_iff_rpow_lt (by norm_num) (by positivity), Real.rpow_sub two_pos,
      lt_div_iff₀ (by positivity), div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
    linarith
  unfold case1Width
  rw [abs_le]
  constructor
  · have := le_abs_self (Real.logb 2 (8 * Real.pi / c₃))
    have := abs_nonneg (Real.logb 2 (c₂ / Real.pi))
    linarith
  · have := le_abs_self (Real.logb 2 (c₂ / Real.pi))
    have := abs_nonneg (Real.logb 2 (8 * Real.pi / c₃))
    linarith

/-! ### Case 1 for `p ≥ 2` (paper §4.4, (`eq:mainest_Sect4`)) -/

/-- Seeger's constant `(A log(2 + B/A) + A₂)^{1-2/p} A₂^{2/p}` is homogeneous of degree one in
`(A, A₂, B)`. -/
theorem seeger_rhs_smul {p s A A₂ B : ℝ} (hs : 0 < s) (hA : 0 < A) (hA₂ : 0 < A₂) (hB : 0 ≤ B) :
    (s * A * Real.log (2 + s * B / (s * A)) + s * A₂) ^ (1 - 2 / p) * (s * A₂) ^ (2 / p) =
      s * ((A * Real.log (2 + B / A) + A₂) ^ (1 - 2 / p) * A₂ ^ (2 / p)) := by
  have hL : 0 ≤ Real.log (2 + B / A) := Real.log_nonneg (by
    have : 0 ≤ B / A := by positivity
    linarith)
  rw [mul_div_mul_left _ _ hs.ne', show s * A * Real.log (2 + B / A) + s * A₂ =
    s * (A * Real.log (2 + B / A) + A₂) by ring, Real.mul_rpow hs.le (by positivity),
    Real.mul_rpow hs.le hA₂.le]
  have : s ^ (1 - 2 / p) * s ^ (2 / p) = s := by
    rw [← Real.rpow_add hs]; norm_num
  calc s ^ (1 - 2 / p) * (A * Real.log (2 + B / A) + A₂) ^ (1 - 2 / p) *
        (s ^ (2 / p) * A₂ ^ (2 / p))
      = (s ^ (1 - 2 / p) * s ^ (2 / p)) *
          ((A * Real.log (2 + B / A) + A₂) ^ (1 - 2 / p) * A₂ ^ (2 / p)) := by ring
    _ = _ := by rw [this]

/-- **The decay of Seeger's constant in Case 1** (`p ≥ 2`): with `A = K λ^{-1/2}`,
`A₂ = K λ^{-n/2}`, `λ ≥ 1`,
`λ^{1/2} (A L + A₂)^{1-2/p} A₂^{2/p} ≤ K (L + 1) λ^{-(n-1)/p}`. -/
theorem seeger_rhs_le {n : ℕ} (hn : 1 ≤ n) {p K L lam : ℝ} (hp : 2 ≤ p) (hK : 0 < K)
    (hL : 0 ≤ L) (hlam : 1 ≤ lam) :
    lam ^ (1 / 2 : ℝ) * ((K * lam ^ (-(1 / 2 : ℝ)) * L + K * lam ^ (-(n : ℝ) / 2)) ^ (1 - 2 / p) *
      (K * lam ^ (-(n : ℝ) / 2)) ^ (2 / p)) ≤ K * (L + 1) * lam ^ (-((n : ℝ) - 1) / p) := by
  have hl0 : 0 < lam := by linarith
  have hp0 : 0 < p := by linarith
  have hθ0 : 0 ≤ 1 - 2 / p := by rw [sub_nonneg, div_le_one hp0]; exact hp
  have hθ1 : 1 - 2 / p ≤ 1 := by have : 0 ≤ 2 / p := by positivity
                                 linarith
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  set a := lam ^ (-(1 / 2 : ℝ))
  set b := lam ^ (-(n : ℝ) / 2)
  have ha : 0 < a := by positivity
  have hb : 0 < b := by positivity
  have hba : b ≤ a := Real.rpow_le_rpow_of_exponent_le hlam (by linarith)
  have h1 : K * a * L + K * b ≤ K * a * (L + 1) := by nlinarith
  have h2 : (K * a * L + K * b) ^ (1 - 2 / p) ≤ (K * a * (L + 1)) ^ (1 - 2 / p) :=
    Real.rpow_le_rpow (by positivity) h1 hθ0
  have h3 : (L + 1) ^ (1 - 2 / p) ≤ L + 1 := by
    calc (L + 1) ^ (1 - 2 / p) ≤ (L + 1) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by linarith) hθ1
      _ = L + 1 := Real.rpow_one _
  have hexp : lam ^ (1 / 2 : ℝ) * a ^ (1 - 2 / p) * b ^ (2 / p) =
      lam ^ (-((n : ℝ) - 1) / p) := by
    simp only [a, b]
    rw [← Real.rpow_mul hl0.le, ← Real.rpow_mul hl0.le, ← Real.rpow_add hl0,
      ← Real.rpow_add hl0]
    congr 1
    field_simp
    ring
  have hK' : K ^ (1 - 2 / p) * K ^ (2 / p) = K := by rw [← Real.rpow_add hK]; norm_num
  calc lam ^ (1 / 2 : ℝ) * ((K * a * L + K * b) ^ (1 - 2 / p) * (K * b) ^ (2 / p))
      ≤ lam ^ (1 / 2 : ℝ) * ((K * a * (L + 1)) ^ (1 - 2 / p) * (K * b) ^ (2 / p)) := by
        gcongr
    _ = (K ^ (1 - 2 / p) * K ^ (2 / p)) * (L + 1) ^ (1 - 2 / p) *
          (lam ^ (1 / 2 : ℝ) * a ^ (1 - 2 / p) * b ^ (2 / p)) := by
        rw [Real.mul_rpow (by positivity) (by linarith), Real.mul_rpow hK.le ha.le,
          Real.mul_rpow hK.le hb.le]
        ring
    _ ≤ K * (L + 1) * lam ^ (-((n : ℝ) - 1) / p) := by
        rw [hK', hexp]
        gcongr

/-- `2^{(ℓ+1)α} = 2^α 2^{ℓα}`. -/
theorem two_rpow_add_one_mul (α : ℝ) (ℓ : ℤ) :
    (2 : ℝ) ^ (((ℓ : ℝ) + 1) * α) = (2 : ℝ) ^ α * dyadicPoint α ℓ := by
  rw [dyadicPoint, ← Real.rpow_add two_pos]; ring_nf

set_option maxHeartbeats 1000000 in
-- The proof checks the eleven hypotheses of the vector-valued Seeger theorem twice.
/-- **Case 1 single pieces for `p ≥ 2`** (paper §4.4, route: Seeger's theorem with (H∞) and the
`V²`-embedding): for `α > 1`, `r ≥ 2`, `2 ≤ p < ∞` there is `C` such that for all `ℓ ≥ 0`, all
`k` and Schwartz `f`, with `λ = 2^{ℓα}` and `L = log(2 + (2^{-k} + 2^{ℓ+1} + 2^k) λ^{1/2})`,
`‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ C (L + 1) λ^{-(n-1)/p} ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_shortPieceVar_le_of_ge_two {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 1 ≤ n) {α : ℝ} (hα : 1 < α) {r : ℝ} (hr : 2 ≤ r)
    {p : ℝ} (hp : 2 ≤ p) :
    ∃ C : ℝ, 0 < C ∧ ∀ ℓ k : ℤ, 0 ≤ ℓ → ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        ENNReal.ofReal (C * (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1) *
          dyadicPoint α ℓ ^ (-((n : ℝ) - 1) / p)) * eLpNorm f (ENNReal.ofReal p) := by
  have hα0 : 0 < α := by linarith
  have hp0 : 0 < p := by linarith
  obtain ⟨CS, hCS, hSeeger⟩ := seeger_ge_two (n := n) (by omega) hp
  obtain ⟨C2, hC2, hH2⟩ := hΩ.case1_H2 hα
  obtain ⟨A1, B0, hA1, hB0, hL1⟩ := hΩ.case1_L1 hα0.le
  obtain ⟨Ci, hCi, hHi⟩ := hΩ.case1_Hinf hn hα
  have h2α : (1 : ℝ) ≤ 2 ^ α := Real.one_le_rpow (by norm_num) hα0.le
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = √C2 + B0 * 2 ^ α + Ci + 1 := ⟨_, rfl⟩
  have hK0 : 0 < K := by rw [hK]; positivity
  have hKC2 : C2 ≤ K ^ 2 := by
    have : √C2 ≤ K := by rw [hK]; have := hB0.le; have := hCi.le; nlinarith
    calc C2 = √C2 ^ 2 := (Real.sq_sqrt hC2.le).symm
      _ ≤ K ^ 2 := pow_le_pow_left₀ (Real.sqrt_nonneg _) this 2
  have hKB : B0 * 2 ^ α ≤ K := by rw [hK]; have := Real.sqrt_nonneg C2; linarith
  have hKB' : B0 ≤ K := le_trans (le_mul_of_one_le_right hB0.le h2α) hKB
  have hKi : Ci ≤ K := by rw [hK]; have := Real.sqrt_nonneg C2; nlinarith
  refine ⟨√32 * CS * K, by positivity, fun ℓ k hℓ f => ?_⟩
  obtain ⟨lam, hlam⟩ : ∃ lam, lam = dyadicPoint α ℓ := ⟨_, rfl⟩
  have hl0 : 0 < lam := hlam ▸ dyadicPoint_pos α ℓ
  have hl1 : 1 ≤ lam := by
    rw [hlam]; exact Real.one_le_rpow (by norm_num) (by positivity)
  obtain ⟨S, hS⟩ : ∃ S, S = case1Scale ℓ k := ⟨_, rfl⟩
  have hS0 : 0 < S := hS ▸ case1Scale_pos ℓ k
  have hfp : MemLp (f : Rn n → ℂ) (ENNReal.ofReal p) := f.memLp _
  have hf2 : MemLp (f : Rn n → ℂ) 2 := f.memLp _
  -- the parameters for `k_{ℓ,k}`
  set A := K * lam ^ (-(1 / 2 : ℝ))
  set A₂ := K * lam ^ (-(n : ℝ) / 2)
  have hA : 0 < A := by positivity
  have hA₂ : 0 < A₂ := by positivity
  have hlamA : lam * lam ^ (-(1 / 2 : ℝ)) = lam ^ (1 / 2 : ℝ) := by
    rw [← Real.rpow_one_add' hl0.le (by norm_num)]; norm_num
  have hBA : K * S / A = S * lam ^ (1 / 2 : ℝ) := by
    simp only [A]
    rw [Real.rpow_neg hl0.le]
    field_simp
  have hX : ∀ J : Finset ℤ, eLpNorm (sgrSq (uMeasure α) (case1Ker hΩ α ℓ k) J f)
      (ENNReal.ofReal p) ≤ ENNReal.ofReal (CS * ((A * Real.log (2 + K * S / A) + A₂) ^
        (1 - 2 / p) * A₂ ^ (2 / p))) * eLpNorm f (ENNReal.ofReal p) := by
    intro J
    have := hSeeger (uMeasure α) (case1Ker hΩ α ℓ k) J A (K * S) hA A₂ hA₂ (by positivity)
      (fun j => (hΩ.measurable_case1Ker α ℓ k j).1) ?_ ?_ ?_ ?_ ?_ f hfp hf2
    · refine this.trans (le_of_eq ?_); rw [mul_assoc]
    · intro g hg
      refine (hH2 ℓ k J g hg).1.trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
      rw [← hlam, mul_pow, ← Real.rpow_natCast (lam ^ (-(n : ℝ) / 2)) 2,
        ← Real.rpow_mul hl0.le, show -(n : ℝ) / 2 * ((2 : ℕ) : ℝ) = -n by push_cast; ring]
      exact mul_le_mul_of_nonneg_right hKC2 (by positivity)
    · intro j _ R hR
      refine ((hL1 ℓ k j _ 0 (Or.inl ⟨rfl, rfl⟩)).2.1 R (by linarith)).trans
        (ENNReal.ofReal_le_ofReal ?_)
      rw [← hS, mul_zero, Real.rpow_zero, mul_one]
      gcongr
    · intro j _ y
      refine ((hL1 ℓ k j _ 0 (Or.inl ⟨rfl, rfl⟩)).2.2 y).trans (ENNReal.ofReal_le_ofReal ?_)
      rw [← hS, mul_zero, Real.rpow_zero, mul_one]
      gcongr
    · intro j _
      exact ((hL1 ℓ k j _ 0 (Or.inl ⟨rfl, rfl⟩)).1).trans_lt ENNReal.ofReal_lt_top
    · intro j _ g hg _ hgt
      refine ae_of_all _ fun x => ((hHi ℓ k j g hg hgt x).1).trans ?_
      rw [← hlam]
      gcongr
      exact mul_le_mul_of_nonneg_right hKi (by positivity)
  -- the parameters for `∂_v k_{ℓ,k}`
  have hY : ∀ J : Finset ℤ, eLpNorm (sgrSq (uMeasure α) (case1KerD n α Ω ℓ k) J f)
      (ENNReal.ofReal p) ≤ ENNReal.ofReal (CS * (lam * ((A * Real.log (2 + K * S / A) + A₂) ^
        (1 - 2 / p) * A₂ ^ (2 / p)))) * eLpNorm f (ENNReal.ofReal p) := by
    intro J
    have := hSeeger (uMeasure α) (case1KerD n α Ω ℓ k) J (lam * A) (lam * (K * S))
      (by positivity) (lam * A₂) (by positivity) (by positivity)
      (fun j => (hΩ.measurable_case1Ker α ℓ k j).2) ?_ ?_ ?_ ?_ ?_ f hfp hf2
    · refine this.trans (le_of_eq ?_)
      rw [← seeger_rhs_smul hl0 hA hA₂ (by positivity), mul_assoc]
    · intro g hg
      refine (hH2 ℓ k J g hg).2.trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
      rw [← hlam, mul_pow, mul_pow, ← Real.rpow_natCast (lam ^ (-(n : ℝ) / 2)) 2,
        ← Real.rpow_mul hl0.le, show -(n : ℝ) / 2 * ((2 : ℕ) : ℝ) = -n by push_cast; ring]
      nlinarith [mul_le_mul_of_nonneg_right hKC2
        (by positivity : 0 ≤ lam ^ 2 * lam ^ (-(n : ℝ)))]
    · intro j _ R hR
      refine ((hL1 ℓ k j _ α (Or.inr ⟨rfl, rfl⟩)).2.1 R (by linarith)).trans
        (ENNReal.ofReal_le_ofReal ?_)
      rw [← hS, two_rpow_add_one_mul, ← hlam]
      have : B0 * (2 ^ α * lam) * S ≤ lam * (K * S) := by
        calc B0 * (2 ^ α * lam) * S = (B0 * 2 ^ α) * (lam * S) := by ring
          _ ≤ K * (lam * S) := mul_le_mul_of_nonneg_right hKB (by positivity)
          _ = lam * (K * S) := by ring
      exact div_le_div_of_nonneg_right this (by linarith)
    · intro j _ y
      refine ((hL1 ℓ k j _ α (Or.inr ⟨rfl, rfl⟩)).2.2 y).trans (ENNReal.ofReal_le_ofReal ?_)
      rw [← hS, two_rpow_add_one_mul, ← hlam]
      have : B0 * (2 ^ α * lam) * S ≤ lam * (K * S) := by
        calc B0 * (2 ^ α * lam) * S = (B0 * 2 ^ α) * (lam * S) := by ring
          _ ≤ K * (lam * S) := mul_le_mul_of_nonneg_right hKB (by positivity)
          _ = lam * (K * S) := by ring
      exact mul_le_mul_of_nonneg_right this (norm_nonneg _)
    · intro j _
      exact ((hL1 ℓ k j _ α (Or.inr ⟨rfl, rfl⟩)).1).trans_lt ENNReal.ofReal_lt_top
    · intro j _ g hg _ hgt
      refine ae_of_all _ fun x => ((hHi ℓ k j g hg hgt x).2).trans ?_
      rw [← hlam]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      change Ci * lam ^ (1 / 2 : ℝ) ≤ lam * (K * lam ^ (-(1 / 2 : ℝ)))
      rw [← mul_assoc, mul_comm lam K, mul_assoc, hlamA]
      exact mul_le_mul_of_nonneg_right hKi (by positivity)
  -- combine with the `V²` reduction
  set Q := (A * Real.log (2 + K * S / A) + A₂) ^ (1 - 2 / p) * A₂ ^ (2 / p)
  have hL : 0 ≤ Real.log (2 + K * S / A) := Real.log_nonneg (by
    have : 0 ≤ K * S / A := by positivity
    linarith)
  have hQ : 0 ≤ Q := by positivity
  refine (hΩ.eLpNorm_shortPieceVar_le_of_sgrSq hα0 hr hp0 ℓ k f hX hY).trans
    (mul_le_mul' ?_ le_rfl)
  rw [← ENNReal.ofReal_ofNat, ← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_mul
    (by positivity), ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
  refine ENNReal.ofReal_le_ofReal ?_
  have hdec := seeger_rhs_le hn hp hK0 hL hl1
  have hsq : (32 * (CS * Q) * (CS * (lam * Q))) ^ (1 / 2 : ℝ) =
      √32 * CS * (lam ^ (1 / 2 : ℝ) * Q) := by
    rw [show 32 * (CS * Q) * (CS * (lam * Q)) = (√32 * CS * Q) ^ 2 * lam by
      rw [mul_pow, mul_pow, Real.sq_sqrt (by norm_num)]; ring,
      Real.mul_rpow (by positivity) hl0.le, ← Real.sqrt_eq_rpow, Real.sqrt_sq (by positivity)]
    ring
  rw [hsq]
  calc √32 * CS * (lam ^ (1 / 2 : ℝ) * Q)
      ≤ √32 * CS * (K * (Real.log (2 + K * S / A) + 1) * lam ^ (-((n : ℝ) - 1) / p)) := by
        gcongr
    _ = _ := by rw [hBA, hS, hlam]; ring

/-- `1 + x ≤ K 2^{εx}` for `x ≥ 0` (with `K = max 1 (1/(ε log 2))`). -/
theorem one_add_le_mul_two_rpow {ε : ℝ} (hε : 0 < ε) :
    ∃ K : ℝ, 0 < K ∧ ∀ x : ℝ, 0 ≤ x → 1 + x ≤ K * (2 : ℝ) ^ (ε * x) := by
  have hl : 0 < Real.log 2 := Real.log_pos one_lt_two
  refine ⟨max 1 (1 / (ε * Real.log 2)), by positivity, fun x hx => ?_⟩
  have h1 : 1 + ε * Real.log 2 * x ≤ (2 : ℝ) ^ (ε * x) := by
    rw [Real.rpow_def_of_pos two_pos]
    have := Real.add_one_le_exp (Real.log 2 * (ε * x))
    nlinarith
  have hM1 : 1 ≤ max 1 (1 / (ε * Real.log 2)) := le_max_left _ _
  have hM2 : 1 / (ε * Real.log 2) ≤ max 1 (1 / (ε * Real.log 2)) := le_max_right _ _
  have hx' : x = 1 / (ε * Real.log 2) * (ε * Real.log 2 * x) := by field_simp
  calc 1 + x = 1 + 1 / (ε * Real.log 2) * (ε * Real.log 2 * x) := by rw [← hx']
    _ ≤ max 1 (1 / (ε * Real.log 2)) * 1 +
          max 1 (1 / (ε * Real.log 2)) * (ε * Real.log 2 * x) := by
        gcongr
        · linarith
    _ = max 1 (1 / (ε * Real.log 2)) * (1 + ε * Real.log 2 * x) := by ring
    _ ≤ _ := by gcongr

/-- `2^{-k} + 2^{ℓ+1} + 2^k ≤ 2^{|ℓ| + |k| + 2}`. -/
theorem case1Scale_le (ℓ k : ℤ) :
    case1Scale ℓ k ≤ (2 : ℝ) ^ (|(ℓ : ℝ)| + |(k : ℝ)| + 2) := by
  unfold case1Scale
  have h1 : ((2 : ℝ) ^ k)⁻¹ ≤ (2 : ℝ) ^ (|(ℓ : ℝ)| + |(k : ℝ)|) := by
    rw [← zpow_neg]
    refine (two_zpow_le_rpow_abs (-k)).trans (Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_)
    push_cast; rw [abs_neg]; linarith [abs_nonneg (ℓ : ℝ)]
  have h2 : (2 : ℝ) ^ (ℓ + 1) ≤ 2 * (2 : ℝ) ^ (|(ℓ : ℝ)| + |(k : ℝ)|) := by
    rw [zpow_add₀ two_ne_zero, zpow_one, mul_comm]
    gcongr
    refine (two_zpow_le_rpow_abs ℓ).trans (Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_)
    linarith [abs_nonneg (k : ℝ)]
  have h3 : (2 : ℝ) ^ k ≤ (2 : ℝ) ^ (|(ℓ : ℝ)| + |(k : ℝ)|) :=
    (two_zpow_le_rpow_abs k).trans (Real.rpow_le_rpow_of_exponent_le (by norm_num)
      (by linarith [abs_nonneg (ℓ : ℝ)]))
  have h4 : (2 : ℝ) ^ (|(ℓ : ℝ)| + |(k : ℝ)| + 2) = 4 * (2 : ℝ) ^ (|(ℓ : ℝ)| + |(k : ℝ)|) := by
    rw [Real.rpow_add two_pos]; norm_num; ring
  rw [h4]; linarith

/-- **Summable decay in Case 1** (`n ≥ 2`): for `δ > 0` there are `G, c > 0` with
`(log(2 + (2^{-k} + 2^{ℓ+1} + 2^k) λ^{1/2}) + 1) λ^{-δ} ≤ G 2^{-c(|ℓ| + |k|)}` on `case1Region`
(`λ = 2^{ℓα}`), using `k = ℓ(α - 1) + O(1)`. -/
theorem case1_decay_le {α : ℝ} (hα : 1 < α) {δ : ℝ} (hδ : 0 < δ) :
    ∃ G c : ℝ, 0 < G ∧ 0 < c ∧ ∀ ℓ k : ℤ, case1Region α ℓ k →
      (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1) *
        dyadicPoint α ℓ ^ (-δ) ≤ G * (2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|))) := by
  have hα0 : 0 < α := by linarith
  set W := case1Width α
  set ε := α * δ / (1 + α)
  have hε : 0 < ε := by positivity
  obtain ⟨K, hK0, hK⟩ := one_add_le_mul_two_rpow (half_pos hε)
  have hW0 : 0 ≤ W := by unfold W case1Width; positivity
  refine ⟨(1 + α) * 4 * K * (2 : ℝ) ^ (ε * W), ε / 2, by positivity, by positivity,
    fun ℓ k h => ?_⟩
  have hℓ : (0 : ℝ) ≤ ℓ := by exact_mod_cast h.1
  have hw := abs_sub_le_case1Width hα h
  set m := |(ℓ : ℝ)| + |(k : ℝ)|
  have hm0 : 0 ≤ m := by positivity
  have hk : |(k : ℝ)| ≤ ℓ * α + W := by
    have := abs_sub_abs_le_abs_sub (k : ℝ) (ℓ * (α - 1))
    rw [abs_of_nonneg (by nlinarith : (0 : ℝ) ≤ ℓ * (α - 1))] at this
    nlinarith
  have hm : m ≤ (1 + α) * ℓ + W := by
    simp only [m]; rw [abs_of_nonneg hℓ]; linarith
  have hlm : (ℓ : ℝ) ≤ m := by simp only [m]; rw [abs_of_nonneg hℓ]; linarith [abs_nonneg (k : ℝ)]
  -- the logarithm
  have hlam : dyadicPoint α ℓ ^ (1 / 2 : ℝ) ≤ (2 : ℝ) ^ (α * m) := by
    rw [dyadicPoint, ← Real.rpow_mul (by norm_num)]
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (by nlinarith)
  have harg : 2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ) ≤
      (2 : ℝ) ^ ((1 + α) * m + 3) := by
    have h1 := case1Scale_le ℓ k
    have h2 : case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ) ≤ (2 : ℝ) ^ ((1 + α) * m + 2) := by
      calc case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)
          ≤ (2 : ℝ) ^ (m + 2) * (2 : ℝ) ^ (α * m) :=
            mul_le_mul h1 hlam (Real.rpow_nonneg (dyadicPoint_pos α ℓ).le _) (by positivity)
        _ = _ := by rw [← Real.rpow_add two_pos]; ring_nf
    have h3 : (2 : ℝ) ≤ (2 : ℝ) ^ ((1 + α) * m + 2) := by
      calc (2 : ℝ) = 2 ^ (1 : ℝ) := (Real.rpow_one 2).symm
        _ ≤ _ := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by nlinarith)
    have h4 : (2 : ℝ) ^ ((1 + α) * m + 3) = 2 * (2 : ℝ) ^ ((1 + α) * m + 2) := by
      rw [show (1 + α) * m + 3 = 1 + ((1 + α) * m + 2) by ring, Real.rpow_add two_pos,
        Real.rpow_one]
    rw [h4]; linarith
  have hlog : Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1 ≤
      (1 + α) * (4 * (1 + m)) := by
    have h1 := Real.log_le_log (add_pos_of_pos_of_nonneg two_pos (mul_nonneg
      (case1Scale_pos ℓ k).le (Real.rpow_nonneg (dyadicPoint_pos α ℓ).le _))) harg
    rw [Real.log_rpow two_pos] at h1
    have h2 : Real.log 2 < 1 := by have := Real.log_two_lt_d9; linarith
    have h3 : 0 ≤ (1 + α) * m + 3 := by positivity
    nlinarith
  -- the decay
  have hdec : dyadicPoint α ℓ ^ (-δ) ≤ (2 : ℝ) ^ (ε * W) * (2 : ℝ) ^ (-(ε * m)) := by
    rw [dyadicPoint, ← Real.rpow_mul (by norm_num), ← Real.rpow_add two_pos]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : ε * m ≤ ε * ((1 + α) * ℓ + W) := mul_le_mul_of_nonneg_left hm hε.le
    have he : ε * ((1 + α) * ℓ) = ℓ * α * δ := by simp only [ε]; field_simp
    nlinarith
  have hpoly : 1 + m ≤ K * (2 : ℝ) ^ (ε / 2 * m) := hK m hm0
  have hsplit : (2 : ℝ) ^ (-(ε * m)) = (2 : ℝ) ^ (-(ε / 2 * m)) * (2 : ℝ) ^ (-(ε / 2 * m)) := by
    rw [← Real.rpow_add two_pos]; ring_nf
  have hcancel : (2 : ℝ) ^ (ε / 2 * m) * (2 : ℝ) ^ (-(ε / 2 * m)) = 1 := by
    rw [← Real.rpow_add two_pos]; simp
  calc (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1) *
        dyadicPoint α ℓ ^ (-δ)
      ≤ ((1 + α) * (4 * (1 + m))) * ((2 : ℝ) ^ (ε * W) * (2 : ℝ) ^ (-(ε * m))) := by
        refine mul_le_mul hlog hdec (Real.rpow_nonneg (dyadicPoint_pos α ℓ).le _) (by positivity)
    _ ≤ ((1 + α) * (4 * (K * (2 : ℝ) ^ (ε / 2 * m)))) *
          ((2 : ℝ) ^ (ε * W) * (2 : ℝ) ^ (-(ε * m))) := by gcongr
    _ = (1 + α) * 4 * K * (2 : ℝ) ^ (ε * W) * ((2 : ℝ) ^ (ε / 2 * m) *
          (2 : ℝ) ^ (-(ε / 2 * m))) * (2 : ℝ) ^ (-(ε / 2 * m)) := by rw [hsplit]; ring
    _ = _ := by rw [hcancel]; ring

/-- **Summation over Case 1**: if `E_{ℓ,k} ≤ C (L_{ℓ,k} + 1) λ^{-δ} F` on `case1Region` (with
`L_{ℓ,k} = log(2 + (2^{-k} + 2^{ℓ+1} + 2^k) λ^{1/2})`, `λ = 2^{ℓα}`, `δ > 0`), then
`∑_{(ℓ,k) ∈ Case 1} E_{ℓ,k} ≤ C₁ F` with `C₁` depending only on `α, δ, C`. -/
theorem case1_tsum_le_of_decay {α : ℝ} (hα : 1 < α) {δ C : ℝ} (hδ : 0 < δ) (hC : 0 ≤ C) :
    ∃ C₁ : ℝ≥0∞, C₁ ≠ ∞ ∧ ∀ (E : ℤ → ℤ → ℝ≥0∞) (F : ℝ≥0∞), (∀ ℓ k : ℤ, case1Region α ℓ k →
      E ℓ k ≤ ENNReal.ofReal (C * (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) +
        1) * dyadicPoint α ℓ ^ (-δ)) * F) →
      ∑' ℓ : ℤ, ∑' k : ℤ, case1RegionInd α ℓ k * E ℓ k ≤ C₁ * F := by
  obtain ⟨G, c, hG, hc, hdec⟩ := case1_decay_le hα hδ
  obtain ⟨T, hT⟩ : ∃ T : ℝ≥0∞, T = ∑' ℓ : ℤ, ∑' k : ℤ,
      ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) := ⟨_, rfl⟩
  refine ⟨ENNReal.ofReal (C * G) * T, ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (by rw [hT]; exact tsum_tsum_two_rpow_neg_ne_top hc), fun E F hE => ?_⟩
  have hb : ∀ ℓ k : ℤ, case1RegionInd α ℓ k * E ℓ k ≤
      ENNReal.ofReal (C * G) * F * ENNReal.ofReal ((2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) := by
    intro ℓ k
    unfold case1RegionInd
    split_ifs with h
    · rw [one_mul]
      have := hdec ℓ k h
      refine (hE ℓ k h).trans (le_trans (mul_le_mul' (ENNReal.ofReal_le_ofReal
        (q := C * G * (2 : ℝ) ^ (-(c * (|(ℓ : ℝ)| + |(k : ℝ)|)))) ?_) le_rfl) (le_of_eq ?_))
      · rw [mul_assoc, mul_assoc]
        exact mul_le_mul_of_nonneg_left this hC
      · rw [ENNReal.ofReal_mul (by positivity)]; ring
    · rw [zero_mul]; exact zero_le
  refine (ENNReal.tsum_le_tsum fun ℓ => ENNReal.tsum_le_tsum fun k => hb ℓ k).trans
    (le_of_eq ?_)
  simp_rw [ENNReal.tsum_mul_left]
  rw [hT]; ring

/-- **The Case 1 sum for `n ≥ 2`, `2 ≤ p < ∞`** (paper §4.4, (`eq:mainest_Sect4`) for Case 1):
`∑_{(ℓ,k) ∈ Case 1} ‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ C₁ ‖f‖_p` (`r ≥ 2`). -/
theorem IsHomogeneousCZKernel.tsum_eLpNorm_shortPieceVar_case1_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 2 ≤ n) {α : ℝ} (hα : 1 < α) {r : ℝ} (hr : 2 ≤ r)
    {p : ℝ} (hp : 2 ≤ p) :
    ∃ C₁ : ℝ≥0∞, C₁ ≠ ∞ ∧ ∀ f : 𝓢(Rn n, ℂ),
      ∑' ℓ : ℤ, ∑' k : ℤ, case1RegionInd α ℓ k *
        eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
        C₁ * eLpNorm f (ENNReal.ofReal p) := by
  have hp0 : 0 < p := by linarith
  obtain ⟨C, hC, hpiece⟩ := hΩ.eLpNorm_shortPieceVar_le_of_ge_two (by omega) hα hr hp
  have hδ : 0 < ((n : ℝ) - 1) / p := by
    have : (2 : ℝ) ≤ n := by exact_mod_cast hn
    exact div_pos (by linarith) hp0
  obtain ⟨C₁, hC₁, hsum⟩ := case1_tsum_le_of_decay hα hδ hC.le
  refine ⟨C₁, hC₁, fun f => hsum _ _ fun ℓ k h => ?_⟩
  have := hpiece ℓ k h.1 f
  rwa [neg_div] at this

/-- **The short variation estimate for `n ≥ 2`, `2 ≤ p < ∞`** (paper (`eq:mainest_Sect4`), under
(`eq:cond_n2`) and in fact for all `p ≥ 2`; route item 3 of `automation/instructions.md`): for
`α > 1` and `r ≥ 2` there is `C < ∞` such that for all Schwartz `f`,
`‖S_r(𝓗 f)‖_p ≤ C ‖f‖_p`, where `S_r` is the short variation
`(∑_j V^r_{J_j}(u ↦ 𝓗^{(u)}f)^r)^{1/r}`.
The case `r = 2` (relevant for the jump inequality) is included. -/
theorem IsHomogeneousCZKernel.eLpNorm_shortVariation_le_of_two_le_n {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (hn : 2 ≤ n) {α : ℝ} (hα : 1 < α) {r : ℝ} (hr : 2 ≤ r)
    {p : ℝ} (hp : 2 ≤ p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ f : 𝓢(Rn n, ℂ),
      eLpNorm (fun x => shortVariation r α (fun u => modulatedSI n α Ω u f x))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨C, hC, hmain⟩ := hΩ.eLpNorm_shortVariation_le_of_case1 (by omega) hα hr
    (by linarith : (1 : ℝ) < p)
  obtain ⟨C₁, hC₁, h1⟩ := hΩ.tsum_eLpNorm_shortPieceVar_case1_le hn hα hr hp
  exact ⟨C + C₁, ENNReal.add_ne_top.2 ⟨hC, hC₁⟩, fun f => hmain C₁ f (h1 f)⟩

/-! ## Case 1 for `n = 1` (paper §4.4.4, route: Carleson–Sjölin `L^p` bounds, `V^p`-embedding,
log-convexity) -/

/-! ### The identification `ℝ ≅ ℝ¹` -/

/-- The volume-preserving identification `ℝ ≃ ℝ¹ = EuclideanSpace ℝ (Fin 1)`. -/
def rEquiv : ℝ ≃ᵐ Rn 1 :=
  (MeasurableEquiv.funUnique (Fin 1) ℝ).symm.trans (MeasurableEquiv.toLp 2 (Fin 1 → ℝ))

/-- `rEquiv` preserves Lebesgue measure. -/
theorem measurePreserving_rEquiv : MeasurePreserving rEquiv volume volume :=
  (PiLp.volume_preserving_toLp (Fin 1)).comp (volume_preserving_funUnique (Fin 1) ℝ).symm

/-- The coordinate of `rEquiv s` is `s`. -/
@[simp] theorem rEquiv_apply (s : ℝ) (i : Fin 1) : rEquiv s i = s := rfl

/-- `rEquiv` is additive. -/
theorem rEquiv_sub (s t : ℝ) : rEquiv (s - t) = rEquiv s - rEquiv t := by
  ext i; simp

/-- `rEquiv` is homogeneous. -/
theorem rEquiv_mul (c s : ℝ) : rEquiv (c * s) = c • rEquiv s := by
  ext i; simp

/-- `|rEquiv s| = |s|`. -/
theorem norm_rEquiv (s : ℝ) : ‖rEquiv s‖ = |s| := by
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_one, rEquiv_apply, Real.norm_eq_abs, Real.sqrt_sq_eq_abs,
    abs_abs]

/-- Every point of `ℝ¹` is `rEquiv` of its coordinate. -/
theorem rEquiv_symm_apply (x : Rn 1) : rEquiv (x 0) = x := by
  ext i; rw [rEquiv_apply, Fin.fin_one_eq_zero i]

/-- `rEquiv s = s • rEquiv 1`, so `rEquiv` is smooth. -/
theorem rEquiv_eq_smul (s : ℝ) : rEquiv s = s • rEquiv 1 := by
  rw [← rEquiv_mul, mul_one]

/-- Smoothness of `rEquiv`. -/
theorem contDiff_rEquiv : ContDiff ℝ (⊤ : ℕ∞) (rEquiv : ℝ → Rn 1) := by
  have : (rEquiv : ℝ → Rn 1) = fun s => s • rEquiv 1 := funext rEquiv_eq_smul
  rw [this]; exact contDiff_id.smul contDiff_const

/-- Integrals over `ℝ¹` are integrals over `ℝ`. -/
theorem integral_rEquiv (F : Rn 1 → ℂ) : ∫ x, F x = ∫ s : ℝ, F (rEquiv s) :=
  (measurePreserving_rEquiv.integral_comp' F).symm

/-- Lower integrals over `ℝ¹` are lower integrals over `ℝ`. -/
theorem lintegral_rEquiv (F : Rn 1 → ℝ≥0∞) : ∫⁻ x, F x = ∫⁻ s : ℝ, F (rEquiv s) :=
  (measurePreserving_rEquiv.lintegral_comp_emb rEquiv.measurableEmbedding F).symm

/-! ### The phase `Φ(s) = |s|^α` (modified near `0`) -/

/-- The cutoff `ρ(s) = smoothTransition(32 s² - 1)`: `ρ = 0` near `0`, `ρ = 1` for `|s| ≥ 1/4`. -/
def phaseCut (s : ℝ) : ℝ := Real.smoothTransition (32 * s ^ 2 - 1)

/-- The phase `Φ(s) = |s|^α ρ(s)`, smooth on `ℝ`, `= |s|^α` for `|s| ≥ 1/4`. -/
def csPhase (α s : ℝ) : ℝ := ‖s‖ ^ α * phaseCut s

/-- `ρ = 1` for `|s| ≥ 1/4`. -/
theorem phaseCut_eq_one {s : ℝ} (hs : 1 / 4 ≤ |s|) : phaseCut s = 1 := by
  refine Real.smoothTransition.one_of_one_le ?_
  have : (1 / 4 : ℝ) ^ 2 ≤ s ^ 2 := by rw [← sq_abs s]; exact pow_le_pow_left₀ (by norm_num) hs 2
  linarith

/-- `Φ(s) = |s|^α` for `|s| ≥ 1/4`. -/
theorem csPhase_eq {α s : ℝ} (hs : 1 / 4 ≤ |s|) : csPhase α s = |s| ^ α := by
  rw [csPhase, phaseCut_eq_one hs, mul_one, Real.norm_eq_abs]

/-- `Φ` is even. -/
theorem csPhase_neg (α s : ℝ) : csPhase α (-s) = csPhase α s := by
  simp [csPhase, phaseCut]

/-- `Φ` is smooth. -/
theorem contDiff_csPhase (α : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (csPhase α) := by
  have h1 : ContDiffOn ℝ (⊤ : ℕ∞) (fun s : ℝ => ‖s‖ ^ α) ({0}ᶜ : Set ℝ) := by
    intro s hs
    have hs' : s ≠ 0 := hs
    exact ((contDiffAt_norm ℝ hs').rpow_const_of_ne (norm_ne_zero_iff.2 hs')).contDiffWithinAt
  have h2 : ContDiff ℝ (⊤ : ℕ∞) phaseCut :=
    Real.smoothTransition.contDiff.comp ((contDiff_const.mul (contDiff_id.pow 2)).sub
      contDiff_const)
  have h3 : tsupport phaseCut ⊆ ({0}ᶜ : Set ℝ) := by
    intro s hs h0
    rw [Set.mem_singleton_iff] at h0
    subst h0
    refine (notMem_tsupport_iff_eventuallyEq.2 ?_) hs
    filter_upwards [Metric.ball_mem_nhds (0 : ℝ) (by norm_num : (0 : ℝ) < 1 / 8)] with t ht
    refine Real.smoothTransition.zero_of_nonpos ?_
    rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs] at ht
    have : t ^ 2 ≤ (1 / 8) ^ 2 := by rw [← sq_abs t]; exact pow_le_pow_left₀ (abs_nonneg _) ht.le 2
    linarith
  exact osc_contDiff_mul_of_tsupport isOpen_compl_singleton h1 h2 h3

/-- Near `s > 1/4`, `Φ = (·)^α`. -/
theorem csPhase_eventuallyEq {α s : ℝ} (hs : 1 / 4 < s) :
    csPhase α =ᶠ[𝓝 s] fun t => t ^ α := by
  filter_upwards [Ioi_mem_nhds hs] with t ht
  have ht' : (0 : ℝ) < t := by have : (1 / 4 : ℝ) < t := ht; linarith
  rw [csPhase_eq (by rw [abs_of_pos ht']; exact (le_of_lt ht)), abs_of_pos ht']

/-- `Φ'(s) = α s^{α-1}` for `s ≥ 1/2`. -/
theorem deriv_csPhase {α s : ℝ} (hs : 1 / 2 ≤ s) :
    deriv (csPhase α) s = α * s ^ (α - 1) := by
  rw [(csPhase_eventuallyEq (by linarith)).deriv_eq, Real.deriv_rpow_const]

/-- `Φ''(s) = α(α-1) s^{α-2}` for `s ≥ 1/2`. -/
theorem deriv_deriv_csPhase {α s : ℝ} (hs : 1 / 2 ≤ s) :
    deriv (deriv (csPhase α)) s = α * (α - 1) * s ^ (α - 2) := by
  have h : deriv (csPhase α) =ᶠ[𝓝 s] fun t => α * t ^ (α - 1) := by
    filter_upwards [Ioi_mem_nhds (by linarith : (1 / 4 : ℝ) < s)] with t ht
    have ht' : (1 / 4 : ℝ) < t := ht
    rw [((csPhase_eventuallyEq (s := t) ht').deriv_eq), Real.deriv_rpow_const]
  rw [h.deriv_eq, deriv_const_mul _ (Real.differentiableAt_rpow_const_of_ne _
    (by linarith : s ≠ 0)), Real.deriv_rpow_const]
  ring_nf

/-- `Φ'` is odd. -/
theorem deriv_csPhase_neg (α s : ℝ) : deriv (csPhase α) (-s) = -deriv (csPhase α) s := by
  have h := deriv_comp_neg (f := csPhase α) (x := s)
  simp only [csPhase_neg] at h
  linarith

/-- `Φ''` is even. -/
theorem deriv_deriv_csPhase_neg (α s : ℝ) :
    deriv (deriv (csPhase α)) (-s) = deriv (deriv (csPhase α)) s := by
  have hodd : deriv (csPhase α) = fun x => -deriv (csPhase α) (-x) := funext fun x => by
    rw [← deriv_csPhase_neg, neg_neg]
  have := congrArg (fun F => deriv F s) hodd
  rw [deriv.fun_neg, deriv_comp_neg, neg_neg] at this
  exact this.symm

/-- `2^{-|β|} ≤ s^β` for `s ∈ [1/2, 2]`. -/
theorem two_rpow_neg_abs_le_rpow {s β : ℝ} (hs : s ∈ Icc (1 / 2 : ℝ) 2) :
    (2 : ℝ) ^ (-|β|) ≤ s ^ β := by
  have hs0 : 0 < s := by linarith [hs.1]
  rcases le_or_gt 0 β with hβ | hβ
  · rw [abs_of_nonneg hβ, Real.rpow_neg (by norm_num), ← Real.inv_rpow (by norm_num)]
    exact Real.rpow_le_rpow (by norm_num) (by linarith [hs.1]) hβ
  · rw [abs_of_neg hβ, neg_neg]
    exact Real.rpow_le_rpow_of_nonpos hs0 hs.2 hβ.le

/-- The nondegeneracy constant `α²(α-1) 2^{-2|α-2|}`. -/
def csND (α : ℝ) : ℝ := α ^ 2 * (α - 1) * ((2 : ℝ) ^ (-|α - 2|)) ^ 2

/-- **Nondegeneracy on `[1/2, 2]`**: `|Φ''(s)Φ'(t) - Φ''(t)Φ'(s)| = α²(α-1)s^{α-2}t^{α-2}|s - t|
≥ c |s - t|` (the curvature hypothesis of the Carleson–Sjölin theorem). -/
theorem csPhase_nondeg {α : ℝ} (hα : 1 < α) {s t : ℝ} (hs : s ∈ Icc (1 / 2 : ℝ) 2)
    (ht : t ∈ Icc (1 / 2 : ℝ) 2) :
    csND α * |s - t| ≤ |deriv (deriv (csPhase α)) s * deriv (csPhase α) t -
      deriv (deriv (csPhase α)) t * deriv (csPhase α) s| := by
  have hs0 : 0 < s := by linarith [hs.1]
  have ht0 : 0 < t := by linarith [ht.1]
  rw [deriv_csPhase hs.1, deriv_csPhase ht.1, deriv_deriv_csPhase hs.1, deriv_deriv_csPhase ht.1]
  have e1 : s ^ (α - 1) = s ^ (α - 2) * s := by
    rw [← Real.rpow_add_one hs0.ne']; ring_nf
  have e2 : t ^ (α - 1) = t ^ (α - 2) * t := by
    rw [← Real.rpow_add_one ht0.ne']; ring_nf
  have hexp : α * (α - 1) * s ^ (α - 2) * (α * t ^ (α - 1)) -
      α * (α - 1) * t ^ (α - 2) * (α * s ^ (α - 1)) =
      α ^ 2 * (α - 1) * (s ^ (α - 2) * t ^ (α - 2)) * (t - s) := by
    rw [e1, e2]; ring
  have hnn : 0 ≤ α ^ 2 * (α - 1) * (s ^ (α - 2) * t ^ (α - 2)) := by
    have := Real.rpow_nonneg hs0.le (α - 2)
    have := Real.rpow_nonneg ht0.le (α - 2)
    have : 0 ≤ α - 1 := by linarith
    positivity
  rw [hexp, abs_mul, abs_of_nonneg hnn, abs_sub_comm t s]
  unfold csND
  have h1 := two_rpow_neg_abs_le_rpow (β := α - 2) hs
  have h2 := two_rpow_neg_abs_le_rpow (β := α - 2) ht
  have hc : 0 ≤ α ^ 2 * (α - 1) := by have : 0 ≤ α - 1 := by linarith
                                      positivity
  have h3 : ((2 : ℝ) ^ (-|α - 2|)) ^ 2 ≤ s ^ (α - 2) * t ^ (α - 2) := by
    rw [sq]; exact mul_le_mul h1 h2 (by positivity) (Real.rpow_nonneg hs0.le _)
  have := mul_le_mul_of_nonneg_left h3 hc
  exact mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg _)

/-- **Nondegeneracy on `[-2, -1/2]`** (by evenness of `Φ`). -/
theorem csPhase_nondeg_neg {α : ℝ} (hα : 1 < α) {s t : ℝ} (hs : s ∈ Icc (-2 : ℝ) (-(1 / 2)))
    (ht : t ∈ Icc (-2 : ℝ) (-(1 / 2))) :
    csND α * |s - t| ≤ |deriv (deriv (csPhase α)) s * deriv (csPhase α) t -
      deriv (deriv (csPhase α)) t * deriv (csPhase α) s| := by
  obtain ⟨s', rfl⟩ : ∃ s', s = -s' := ⟨-s, by ring⟩
  obtain ⟨t', rfl⟩ : ∃ t', t = -t' := ⟨-t, by ring⟩
  have hs' : s' ∈ Icc (1 / 2 : ℝ) 2 := ⟨by linarith [hs.2], by linarith [hs.1]⟩
  have ht' : t' ∈ Icc (1 / 2 : ℝ) 2 := ⟨by linarith [ht.2], by linarith [ht.1]⟩
  rw [deriv_csPhase_neg, deriv_csPhase_neg, deriv_deriv_csPhase_neg, deriv_deriv_csPhase_neg]
  have e : deriv (deriv (csPhase α)) s' * -deriv (csPhase α) t' -
      deriv (deriv (csPhase α)) t' * -deriv (csPhase α) s' =
      -(deriv (deriv (csPhase α)) s' * deriv (csPhase α) t' -
        deriv (deriv (csPhase α)) t' * deriv (csPhase α) s') := by ring
  rw [e, abs_neg, show -s' - -t' = -(s' - t') by ring, abs_neg]
  exact csPhase_nondeg hα hs' ht'

/-- `Φ' ≠ 0` on `[1/2, 2] ∪ [-2, -1/2]`. -/
theorem deriv_csPhase_ne_zero {α : ℝ} (hα : 0 < α) {s : ℝ}
    (hs : s ∈ Icc (1 / 2 : ℝ) 2 ∨ s ∈ Icc (-2 : ℝ) (-(1 / 2))) : deriv (csPhase α) s ≠ 0 := by
  rcases hs with hs | hs
  · rw [deriv_csPhase hs.1]
    exact mul_ne_zero hα.ne' (Real.rpow_pos_of_pos (by linarith [hs.1]) _).ne'
  · rw [show s = -(-s) by ring, deriv_csPhase_neg, deriv_csPhase (by linarith [hs.2])]
    exact neg_ne_zero.2 (mul_ne_zero hα.ne' (Real.rpow_pos_of_pos (by linarith [hs.2]) _).ne')

/-! ### The Carleson–Sjölin `L^p` bounds in the form used in Case 1 -/

/-- `x^e ≤ 1 + x` for `x ≥ 0`, `0 ≤ e ≤ 1`. -/
theorem rpow_le_one_add {x e : ℝ} (hx : 0 ≤ x) (he0 : 0 ≤ e) (he1 : e ≤ 1) : x ^ e ≤ 1 + x := by
  rcases le_or_gt x 1 with h | h
  · linarith [Real.rpow_le_one hx h he0]
  · calc x ^ e ≤ x ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le h.le he1
      _ = x := Real.rpow_one x
      _ ≤ 1 + x := by linarith

/-- The Carleson–Sjölin decay exponent `β(p) = 1/2` for `p ≤ 4`, `β(p) = 2/p` for `p > 4`. -/
def csExp (p : ℝ) : ℝ := if p ≤ 4 then 1 / 2 else 2 / p

/-- `p β(p) > 1` for `p > 2`. -/
theorem one_lt_mul_csExp {p : ℝ} (hp : 2 < p) : 1 < p * csExp p := by
  unfold csExp
  split_ifs with h
  · linarith
  · rw [mul_div_cancel₀ _ (by linarith)]; norm_num

/-- **The Carleson–Sjölin estimate for `p > 2`** (from `csOp_Lq_mid`, `csOp_L4`, `csOp_Lq_high`):
under the hypotheses of these theorems there is `C ≥ 0` such that
`‖T_λ g‖_p ≤ C λ^{-β(p)} (1 + log λ) ‖g‖_p` for `λ ≥ 2`. -/
theorem csOp_Lp_bound {Φ : ℝ → ℝ} {a : ℝ → ℝ → ℂ} {α' β' c c₀ : ℝ}
    (hΦ : ContDiff ℝ (⊤ : ℕ∞) Φ) (ha : ContDiff ℝ (⊤ : ℕ∞) (Function.uncurry a))
    (ha_supp : HasCompactSupport (Function.uncurry a))
    (hαβ : α' < β') (hc : 0 < c) (hc₀ : 0 < c₀)
    (hs : ∀ s u, a s u ≠ 0 → s ∈ Icc α' β') (hu : ∀ s u, a s u ≠ 0 → c₀ ≤ |u|)
    (hΦ' : ∀ s ∈ Icc α' β', deriv Φ s ≠ 0)
    (hND : ∀ s ∈ Icc α' β', ∀ t ∈ Icc α' β',
      c * |s - t| ≤ |deriv (deriv Φ) s * deriv Φ t - deriv (deriv Φ) t * deriv Φ s|)
    {p : ℝ} (hp : 2 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ lam ≥ 2, ∀ g : ℝ → ℂ, MemLp g (ENNReal.ofReal p) volume →
      eLpNorm (csOp Φ a lam g) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * lam ^ (-csExp p) * (1 + Real.log lam)) *
          eLpNorm g (ENNReal.ofReal p) volume := by
  have hlog : ∀ lam : ℝ, 2 ≤ lam → 0 ≤ Real.log lam := fun lam h =>
    Real.log_nonneg (by linarith)
  rcases lt_trichotomy p 4 with h4 | h4 | h4
  · obtain ⟨C, hC⟩ := csOp_Lq_mid hΦ ha ha_supp hαβ hc hc₀ hs hu hΦ' hND hp h4
    have he : csExp p = 1 / 2 := by simp [csExp, h4.le]
    refine ⟨max C 0, le_max_right _ _, fun lam hlam g hg => ?_⟩
    rw [he]
    refine (hC lam hlam g hg).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have h1 : Real.log lam ^ (1 - 2 / p) ≤ 1 + Real.log lam := rpow_le_one_add (hlog lam hlam)
      (by rw [sub_nonneg, div_le_one (by linarith)]; linarith) (by
        have : 0 ≤ 2 / p := by positivity
        linarith)
    have h2 : 0 ≤ lam ^ (-(1 / 2 : ℝ)) := Real.rpow_nonneg (by linarith) _
    have h3 : 0 ≤ Real.log lam ^ (1 - 2 / p) := Real.rpow_nonneg (hlog lam hlam) _
    calc C * lam ^ (-(1 / 2 : ℝ)) * Real.log lam ^ (1 - 2 / p)
        ≤ max C 0 * lam ^ (-(1 / 2 : ℝ)) * Real.log lam ^ (1 - 2 / p) := by
          gcongr; exact le_max_left _ _
      _ ≤ _ := by gcongr
  · subst h4
    obtain ⟨C, hC⟩ := csOp_L4 hΦ ha ha_supp hαβ hc hc₀ hs hu hND
    have he : csExp 4 = 1 / 2 := by unfold csExp; norm_num
    refine ⟨max C 0, le_max_right _ _, fun lam hlam g hg => ?_⟩
    have e4 : ENNReal.ofReal 4 = 4 := by norm_num
    rw [e4] at hg ⊢
    rw [he]
    refine (hC lam hlam g hg).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have h1 : Real.log lam ^ (1 / 2 : ℝ) ≤ 1 + Real.log lam :=
      rpow_le_one_add (hlog lam hlam) (by norm_num) (by norm_num)
    have h2 : 0 ≤ lam ^ (-(1 / 2 : ℝ)) := Real.rpow_nonneg (by linarith) _
    have h3 : 0 ≤ Real.log lam ^ (1 / 2 : ℝ) := Real.rpow_nonneg (hlog lam hlam) _
    calc C * lam ^ (-(1 / 2 : ℝ)) * Real.log lam ^ (1 / 2 : ℝ)
        ≤ max C 0 * lam ^ (-(1 / 2 : ℝ)) * Real.log lam ^ (1 / 2 : ℝ) := by
          gcongr; exact le_max_left _ _
      _ ≤ _ := by gcongr
  · obtain ⟨C, hC⟩ := csOp_Lq_high hΦ ha ha_supp hαβ hc hc₀ hs hu hND h4
    have he : csExp p = 2 / p := by simp [csExp, not_le.2 h4]
    refine ⟨max C 0, le_max_right _ _, fun lam hlam g hg => ?_⟩
    rw [he]
    refine (hC lam hlam g hg).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have h1 : Real.log lam ^ (2 / p) ≤ 1 + Real.log lam := rpow_le_one_add (hlog lam hlam)
      (by positivity) (by rw [div_le_one (by linarith)]; linarith)
    have h2 : 0 ≤ lam ^ (-(2 / p)) := Real.rpow_nonneg (by linarith) _
    have h3 : 0 ≤ Real.log lam ^ (2 / p) := Real.rpow_nonneg (hlog lam hlam) _
    calc C * lam ^ (-(2 / p)) * Real.log lam ^ (2 / p)
        ≤ max C 0 * lam ^ (-(2 / p)) * Real.log lam ^ (2 / p) := by
          gcongr; exact le_max_left _ _
      _ ≤ _ := by gcongr

/-! ### The amplitudes -/

/-- The cutoff `smoothTransition(2s)` (`= 0` for `s ≤ 0`, `= 1` for `s ≥ 1/2`). -/
def cutPos (s : ℝ) : ℝ := Real.smoothTransition (2 * s)

/-- The bump `χ` in the modulation parameter: `χ = 1` on `U = [1, 2^α]` and `χ(u) ≠ 0 → u ≥ 1/2`
(for `α ≥ 0`). -/
def bumpV (α : ℝ) : ContDiffBump ((1 + (2 : ℝ) ^ α) / 2) where
  rIn := max (((2 : ℝ) ^ α - 1) / 2) (1 / 4)
  rOut := max (((2 : ℝ) ^ α - 1) / 2) (1 / 4) + 1 / 4
  rIn_pos := lt_max_of_lt_right (by norm_num)
  rIn_lt_rOut := by linarith

/-- `χ = 1` on `U`. -/
theorem bumpV_eq_one {α v : ℝ} (hv : v ∈ paramU α) : bumpV α v = 1 := by
  refine (bumpV α).one_of_mem_closedBall ?_
  rw [Metric.mem_closedBall, Real.dist_eq, abs_le]
  simp only [bumpV]
  have := le_max_left (((2 : ℝ) ^ α - 1) / 2) (1 / 4)
  constructor <;> linarith [hv.1, hv.2]

/-- `χ(u) ≠ 0 → u ≥ 1/2` (for `α ≥ 0`). -/
theorem le_of_bumpV_ne_zero {α v : ℝ} (hα : 0 ≤ α) (h : bumpV α v ≠ 0) : 1 / 2 ≤ v := by
  have hv : v ∈ Function.support (bumpV α) := h
  rw [(bumpV α).support_eq, Metric.mem_ball, Real.dist_eq, abs_lt] at hv
  simp only [bumpV] at hv
  have h1 : (1 : ℝ) ≤ 2 ^ α := Real.one_le_rpow (by norm_num) hα
  have h2 : max (((2 : ℝ) ^ α - 1) / 2) (1 / 4) ≤ ((2 : ℝ) ^ α - 1) / 2 + 1 / 4 :=
    max_le (by linarith) (by linarith)
  linarith [hv.1]

/-- The Carleson–Sjölin amplitudes `a_σ(s, u) = B(s) 𝟙_{σ s > 0}(s) χ(u)` (`σ = ±1`; smooth
cutoffs `smoothTransition(2σs)`). -/
def csAmp (α : ℝ) (B : Rn 1 → ℂ) (σ s u : ℝ) : ℂ :=
  B (rEquiv s) * ((cutPos (σ * s) : ℝ) : ℂ) * ((bumpV α u : ℝ) : ℂ)

/-- Smoothness of the amplitudes. -/
theorem contDiff_csAmp (α : ℝ) {B : Rn 1 → ℂ} (hB : ContDiff ℝ (⊤ : ℕ∞) B) (σ : ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (Function.uncurry (csAmp α B σ)) := by
  have h1 : ContDiff ℝ (⊤ : ℕ∞) (fun z : ℝ × ℝ => B (rEquiv z.1)) :=
    (hB.comp contDiff_rEquiv).comp contDiff_fst
  have h2 : ContDiff ℝ (⊤ : ℕ∞) (fun z : ℝ × ℝ => ((cutPos (σ * z.1) : ℝ) : ℂ)) :=
    ofRealCLM.contDiff.comp (Real.smoothTransition.contDiff.comp
      (contDiff_const.mul (contDiff_const.mul contDiff_fst)))
  have h3 : ContDiff ℝ (⊤ : ℕ∞) (fun z : ℝ × ℝ => ((bumpV α z.2 : ℝ) : ℂ)) :=
    ofRealCLM.contDiff.comp ((bumpV α).contDiff.comp contDiff_snd)
  exact (h1.mul h2).mul h3

/-- The support of a unit-scale amplitude `B` (in `1/2 ≤ |t| ≤ 2`) and the cutoff confine
`a_σ` to `σ s ∈ [1/2, 2]`. -/
theorem csAmp_ne_zero {α : ℝ} {B : Rn 1 → ℂ} (hBs : ∀ t, B t ≠ 0 → ‖t‖ ∈ Icc (1 / 2 : ℝ) 2)
    {σ s u : ℝ} (h : csAmp α B σ s u ≠ 0) :
    |s| ∈ Icc (1 / 2 : ℝ) 2 ∧ 0 < σ * s ∧ bumpV α u ≠ 0 := by
  unfold csAmp at h
  have hB : B (rEquiv s) ≠ 0 := fun h0 => h (by rw [h0]; ring)
  have hc : cutPos (σ * s) ≠ 0 := fun h0 => h (by rw [h0]; push_cast; ring)
  have hχ : bumpV α u ≠ 0 := fun h0 => h (by rw [h0]; push_cast; ring)
  refine ⟨by rw [← norm_rEquiv]; exact hBs _ hB, ?_, hχ⟩
  by_contra hneg
  push Not at hneg
  exact hc (Real.smoothTransition.zero_of_nonpos (by linarith))

/-- Compact support of the amplitudes. -/
theorem hasCompactSupport_csAmp (α : ℝ) {B : Rn 1 → ℂ}
    (hBs : ∀ t, B t ≠ 0 → ‖t‖ ∈ Icc (1 / 2 : ℝ) 2) (σ : ℝ) :
    HasCompactSupport (Function.uncurry (csAmp α B σ)) := by
  refine HasCompactSupport.intro (K := Icc (-2 : ℝ) 2 ×ˢ Metric.closedBall
    ((1 + (2 : ℝ) ^ α) / 2) (bumpV α).rOut) (isCompact_Icc.prod (isCompact_closedBall _ _)) ?_
  intro z hz
  by_contra h
  obtain ⟨h1, -, h3⟩ := csAmp_ne_zero hBs h
  apply hz
  refine ⟨⟨by linarith [(abs_le.1 h1.2).1], (abs_le.1 h1.2).2⟩, ?_⟩
  have : z.2 ∈ Function.support (bumpV α) := h3
  rw [(bumpV α).support_eq] at this
  exact Metric.ball_subset_closedBall this

/-- For `u ∈ U`, `a_+ + a_- = B`. -/
theorem csAmp_add {α : ℝ} {B : Rn 1 → ℂ} (hBs : ∀ t, B t ≠ 0 → ‖t‖ ∈ Icc (1 / 2 : ℝ) 2)
    {u : ℝ} (hu : u ∈ paramU α) (s : ℝ) :
    csAmp α B 1 s u + csAmp α B (-1) s u = B (rEquiv s) := by
  unfold csAmp
  rw [bumpV_eq_one hu]
  by_cases h0 : B (rEquiv s) = 0
  · simp [h0]
  have hs := hBs _ h0
  rw [norm_rEquiv] at hs
  rcases le_or_gt 0 s with hs0 | hs0
  · rw [abs_of_nonneg hs0] at hs
    rw [cutPos, cutPos, Real.smoothTransition.one_of_one_le (by linarith [hs.1]),
      Real.smoothTransition.zero_of_nonpos (by linarith)]
    push_cast; ring
  · rw [abs_of_neg hs0] at hs
    rw [cutPos, cutPos, Real.smoothTransition.zero_of_nonpos (by linarith),
      Real.smoothTransition.one_of_one_le (by linarith [hs.1])]
    push_cast; ring

/-! ### The one-dimensional unit-scale operator -/

/-- The unit-scale single-scale operator on `ℝ`:
`Λ h(ξ, v) = ∫ e^{iλv|σ|^α} b(σ) h(ξ - σ) dσ` (paper §4.3 with `n = 1`). -/
def osc1 (α lam : ℝ) (b h : ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  ∫ σ, cexp (I * ((lam * z.2 * |σ| ^ α : ℝ) : ℂ)) * (b σ * h (z.1 - σ))

/-- The Carleson–Sjölin operator with the amplitude `a_σ` in convolution form. -/
theorem csOp_csAmp_eq {α : ℝ} {B : Rn 1 → ℂ} (hBs : ∀ t, B t ≠ 0 → ‖t‖ ∈ Icc (1 / 2 : ℝ) 2)
    (σ' lam : ℝ) (h : ℝ → ℂ) (z : ℝ × ℝ) :
    csOp (csPhase α) (csAmp α B σ') lam h z =
      ∫ s, cexp (I * ((lam * z.2 * |s| ^ α : ℝ) : ℂ)) * (csAmp α B σ' s z.2 * h (z.1 - s)) := by
  unfold csOp
  have := integral_sub_left_eq_self (μ := volume) (fun s : ℝ =>
    cexp (I * lam * z.2 * (csPhase α s : ℂ)) * csAmp α B σ' s z.2 * h (z.1 - s)) z.1
  simp only [sub_sub_cancel] at this
  rw [this]
  congr 1; funext s
  by_cases h0 : csAmp α B σ' s z.2 = 0
  · simp [h0]
  · have := (csAmp_ne_zero hBs h0).1
    rw [csPhase_eq (by linarith [this.1])]
    push_cast; ring_nf

/-- Integrability of the integrand of `Λ` for continuous compactly supported `b` and bounded
measurable `h`. -/
theorem integrable_osc1_integrand {α lam : ℝ} (hα : 0 ≤ α) {b h : ℝ → ℂ} (hb : Continuous b)
    (hbs : HasCompactSupport b) (hh : Measurable h) {M : ℝ} (hM : ∀ y, ‖h y‖ ≤ M)
    (z : ℝ × ℝ) :
    Integrable fun σ => cexp (I * ((lam * z.2 * |σ| ^ α : ℝ) : ℂ)) * (b σ * h (z.1 - σ)) := by
  have hbi : Integrable b := hb.integrable_of_hasCompactSupport hbs
  refine (hbi.norm.mul_const M).mono' ?_ (ae_of_all _ fun σ => ?_)
  · refine (Continuous.aestronglyMeasurable ?_).mul (hb.aestronglyMeasurable.mul
      (hh.comp (measurable_const.sub measurable_id)).aestronglyMeasurable)
    exact Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
      (continuous_const.mul ((continuous_abs).rpow_const fun _ => Or.inr hα))))
  · rw [norm_mul, norm_mul, show I * ((lam * z.2 * |σ| ^ α : ℝ) : ℂ) =
      ((lam * z.2 * |σ| ^ α : ℝ) : ℂ) * I by ring, Complex.norm_exp_ofReal_mul_I, one_mul]
    exact mul_le_mul_of_nonneg_left (hM _) (norm_nonneg _)

/-- `∫ |f|^p = ‖f‖_p^p`. -/
theorem lintegral_enorm_rpow_eq {X : Type*} [MeasurableSpace X] {μ : Measure X} {f : X → ℂ}
    (hf : AEStronglyMeasurable f μ) {p : ℝ} (hp : 0 < p) :
    ∫⁻ x, ‖f x‖ₑ ^ p ∂μ = eLpNorm f (ENNReal.ofReal p) μ ^ p := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top hf,
    ENNReal.toReal_ofReal hp.le, ← ENNReal.rpow_mul, one_div_mul_cancel hp.ne', ENNReal.rpow_one]

/-- The product measure `dξ × dv|_U` is dominated by Lebesgue measure on `ℝ²`. -/
theorem prod_restrict_paramU_le (α : ℝ) :
    (volume : Measure ℝ).prod (volume.restrict (paramU α)) ≤ (volume : Measure (ℝ × ℝ)) := by
  rw [Measure.volume_eq_prod]; exact Measure.prod_mono le_rfl Measure.restrict_le_self

/-- Almost every point of `ℝ × U` has second coordinate in `U`. -/
theorem ae_prod_restrict_paramU (α : ℝ) :
    ∀ᵐ z ∂((volume : Measure ℝ).prod (volume.restrict (paramU α))), z.2 ∈ paramU α := by
  rw [ae_iff]
  have : {z : ℝ × ℝ | ¬ z.2 ∈ paramU α} = univ ×ˢ (paramU α)ᶜ := by ext z; simp
  rw [this, Measure.prod_prod, Measure.restrict_apply' (show MeasurableSet (paramU α) from
    measurableSet_Icc), compl_inter_self,
    measure_empty, mul_zero]

/-- Strong measurability of parameter integrals over `ℝ` of jointly measurable functions. -/
theorem stronglyMeasurable_integral_param {F : ℝ × ℝ → ℝ → ℂ}
    (hF : Measurable fun q : (ℝ × ℝ) × ℝ => F q.1 q.2) :
    StronglyMeasurable fun z => ∫ s, F z s :=
  hF.stronglyMeasurable.integral_prod_right'

/-- **The `L^p(ℝ × U)` bound for `Λ`** (`p > 2`, paper (`eq:localsmooth2`) route replacement):
for a smooth unit-scale amplitude `B` supported in `1/2 ≤ |t| ≤ 2` there is `C` with
`∫∫_{ℝ × U} |Λ h|^p ≤ (C λ^{-β(p)} (1 + log λ))^p ∫ |h|^p` for `λ ≥ 2` and bounded measurable
`h ∈ L^p`; it combines the Carleson–Sjölin estimates for `t > 0` and `t < 0`. -/
theorem osc1_Lp_le {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 2 < p) {B : Rn 1 → ℂ}
    (hB : ContDiff ℝ (⊤ : ℕ∞) B) (hBs : ∀ t, B t ≠ 0 → ‖t‖ ∈ Icc (1 / 2 : ℝ) 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ lam ≥ 2, ∀ h : ℝ → ℂ, Measurable h → (∃ M, ∀ y, ‖h y‖ ≤ M) →
      MemLp h (ENNReal.ofReal p) volume →
      ∫⁻ ξ, ∫⁻ v in paramU α, ‖osc1 α lam (fun s => B (rEquiv s)) h (ξ, v)‖ₑ ^ p ≤
        ENNReal.ofReal (C * lam ^ (-csExp p) * (1 + Real.log lam)) ^ p *
          ∫⁻ ξ, ‖h ξ‖ₑ ^ p := by
  have hα0 : 0 < α := by linarith
  have hp0 : 0 < p := by linarith
  have hcND : 0 < csND α := by
    unfold csND; have : 0 < α - 1 := by linarith
    positivity
  have hu : ∀ σ' s u, csAmp α B σ' s u ≠ 0 → (1 / 2 : ℝ) ≤ |u| := fun σ' s u h =>
    (le_of_bumpV_ne_zero hα0.le (csAmp_ne_zero hBs h).2.2).trans (le_abs_self u)
  have hsP : ∀ s u, csAmp α B 1 s u ≠ 0 → s ∈ Icc (1 / 2 : ℝ) 2 := by
    intro s u h
    obtain ⟨h1, h2, -⟩ := csAmp_ne_zero hBs h
    rw [one_mul] at h2
    rwa [abs_of_pos h2] at h1
  have hsM : ∀ s u, csAmp α B (-1) s u ≠ 0 → s ∈ Icc (-2 : ℝ) (-(1 / 2)) := by
    intro s u h
    obtain ⟨h1, h2, -⟩ := csAmp_ne_zero hBs h
    have : s < 0 := by linarith
    rw [abs_of_neg this] at h1
    exact ⟨by linarith [h1.2], by linarith [h1.1]⟩
  obtain ⟨C₁, hC₁0, hC₁⟩ := csOp_Lp_bound (contDiff_csPhase α) (contDiff_csAmp α hB 1)
    (hasCompactSupport_csAmp α hBs 1) (by norm_num : (1 / 2 : ℝ) < 2) hcND
    (by norm_num : (0 : ℝ) < 1 / 2) hsP (hu 1)
    (fun s hs => deriv_csPhase_ne_zero hα0 (Or.inl hs)) (fun s hs t ht => csPhase_nondeg hα hs ht)
    hp
  obtain ⟨C₂, hC₂0, hC₂⟩ := csOp_Lp_bound (contDiff_csPhase α) (contDiff_csAmp α hB (-1))
    (hasCompactSupport_csAmp α hBs (-1)) (by norm_num : (-2 : ℝ) < -(1 / 2)) hcND
    (by norm_num : (0 : ℝ) < 1 / 2) hsM (hu (-1))
    (fun s hs => deriv_csPhase_ne_zero hα0 (Or.inr hs))
    (fun s hs t ht => csPhase_nondeg_neg hα hs ht) hp
  refine ⟨C₁ + C₂, by positivity, fun lam hlam h hh ⟨M, hM⟩ hhp => ?_⟩
  set μU := (volume : Measure ℝ).prod (volume.restrict (paramU α))
  have hbc : Continuous fun s => B (rEquiv s) := hB.continuous.comp contDiff_rEquiv.continuous
  have hexpc : Continuous fun q : (ℝ × ℝ) × ℝ =>
      cexp (I * ((lam * q.1.2 * |q.2| ^ α : ℝ) : ℂ)) :=
    Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
      ((continuous_const.mul (continuous_snd.comp continuous_fst)).mul
        ((continuous_abs.comp continuous_snd).rpow_const fun _ => Or.inr hα0.le))))
  have hmeas : StronglyMeasurable (osc1 α lam (fun s => B (rEquiv s)) h) := by
    refine stronglyMeasurable_integral_param (F := fun z σ =>
      cexp (I * ((lam * z.2 * |σ| ^ α : ℝ) : ℂ)) * ((fun s => B (rEquiv s)) σ * h (z.1 - σ))) ?_
    exact hexpc.measurable.mul ((hbc.measurable.comp measurable_snd).mul
      (hh.comp ((measurable_fst.comp measurable_fst).sub measurable_snd)))
  have heq : ∀ z : ℝ × ℝ, z.2 ∈ paramU α → osc1 α lam (fun s => B (rEquiv s)) h z =
      csOp (csPhase α) (csAmp α B 1) lam h z + csOp (csPhase α) (csAmp α B (-1)) lam h z := by
    intro z hz
    have hi : ∀ σ' : ℝ, Integrable fun s =>
        cexp (I * ((lam * z.2 * |s| ^ α : ℝ) : ℂ)) * (csAmp α B σ' s z.2 * h (z.1 - s)) := by
      intro σ'
      refine integrable_osc1_integrand hα0.le ?_ ?_ hh hM z
      · exact (contDiff_csAmp α hB σ').continuous.comp (continuous_id.prodMk continuous_const)
      · refine HasCompactSupport.intro (K := Icc (-2 : ℝ) 2) isCompact_Icc fun s hs => ?_
        by_contra h0
        exact hs (abs_le.1 (csAmp_ne_zero hBs h0).1.2)
    rw [csOp_csAmp_eq hBs, csOp_csAmp_eq hBs, ← integral_add (hi 1) (hi (-1))]
    unfold osc1; congr 1; funext s
    rw [← mul_add, ← add_mul, csAmp_add hBs hz]
  have hae : osc1 α lam (fun s => B (rEquiv s)) h =ᵐ[μU] fun z =>
      csOp (csPhase α) (csAmp α B 1) lam h z + csOp (csPhase α) (csAmp α B (-1)) lam h z := by
    filter_upwards [ae_prod_restrict_paramU α] with z hz using heq z hz
  have hL : ∫⁻ ξ, ∫⁻ v in paramU α, ‖osc1 α lam (fun s => B (rEquiv s)) h (ξ, v)‖ₑ ^ p =
      eLpNorm (osc1 α lam (fun s => B (rEquiv s)) h) (ENNReal.ofReal p) μU ^ p := by
    rw [← lintegral_enorm_rpow_eq hmeas.aestronglyMeasurable hp0,
      lintegral_prod _ (hmeas.measurable.enorm.pow_const p).aemeasurable]
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (by linarith)
  rw [hL, eLpNorm_congr_ae hae, lintegral_enorm_rpow_eq hh.aestronglyMeasurable hp0,
    ← ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
  refine ENNReal.rpow_le_rpow ?_ hp0.le
  calc eLpNorm (fun z => csOp (csPhase α) (csAmp α B 1) lam h z +
        csOp (csPhase α) (csAmp α B (-1)) lam h z) (ENNReal.ofReal p) μU
      ≤ eLpNorm (csOp (csPhase α) (csAmp α B 1) lam h) (ENNReal.ofReal p) μU +
          eLpNorm (csOp (csPhase α) (csAmp α B (-1)) lam h) (ENNReal.ofReal p) μU :=
        eLpNorm_add_le (f := csOp (csPhase α) (csAmp α B 1) lam h)
          (g := csOp (csPhase α) (csAmp α B (-1)) lam h) hp1
    _ ≤ eLpNorm (csOp (csPhase α) (csAmp α B 1) lam h) (ENNReal.ofReal p) volume +
          eLpNorm (csOp (csPhase α) (csAmp α B (-1)) lam h) (ENNReal.ofReal p) volume :=
        add_le_add (eLpNorm_mono_measure _ (prod_restrict_paramU_le α))
          (eLpNorm_mono_measure _ (prod_restrict_paramU_le α))
    _ ≤ ENNReal.ofReal (C₁ * lam ^ (-csExp p) * (1 + Real.log lam)) *
            eLpNorm h (ENNReal.ofReal p) volume +
          ENNReal.ofReal (C₂ * lam ^ (-csExp p) * (1 + Real.log lam)) *
            eLpNorm h (ENNReal.ofReal p) volume :=
        add_le_add (hC₁ lam hlam h hhp) (hC₂ lam hlam h hhp)
    _ = ENNReal.ofReal ((C₁ + C₂) * lam ^ (-csExp p) * (1 + Real.log lam)) *
          eLpNorm h (ENNReal.ofReal p) volume := by
        have hX : 0 ≤ lam ^ (-csExp p) * (1 + Real.log lam) := by
          have := Real.log_nonneg (by linarith : (1 : ℝ) ≤ lam)
          have := Real.rpow_nonneg (by linarith : (0 : ℝ) ≤ lam) (-csExp p)
          positivity
        rw [← add_mul, ← ENNReal.ofReal_add (by nlinarith) (by nlinarith)]
        congr 2; ring

/-! ### The rescaled single-scale operators on `ℝⁿ` -/

/-- The rescaled single-scale operator `Θ g(x, v) = ∫ e^{iλv|s|^α} B(s) g(x - c s) ds`; with
`B = φ₀ K`, `λ = 2^{ℓα}`, `c = 2^{ℓ-j}` and `g = P_{j+k} f` it is the piece
`v ↦ 𝓗^{(2^{jα}v)}_{ℓ-j} P_{j+k} f(x)` (`IsHomogeneousCZKernel.shortPiece_eq_scaledOsc`). -/
def scaledOsc (n : ℕ) (α lam c : ℝ) (B g : Rn n → ℂ) (x : Rn n) (v : ℝ) : ℂ :=
  ∫ s, radPhase α lam v s * (B s * g (x - c • s))

/-- `2^{(ℓ-j)α} 2^{jα} = 2^{ℓα}`. -/
theorem dyadicPoint_sub_mul (α : ℝ) (ℓ j : ℤ) :
    dyadicPoint α (ℓ - j) * dyadicPoint α j = dyadicPoint α ℓ := by
  rw [dyadicPoint, dyadicPoint, dyadicPoint, ← Real.rpow_add two_pos]; push_cast; ring_nf

/-- **The pieces in physical space** (scaling `t = 2^{ℓ-j} s`):
`𝓗^{(2^{jα}v)}_{ℓ-j} P_{j+k} f(x) =
∫ e^{i 2^{ℓα} v |s|^α} φ₀(s) K(s) P_{j+k} f(x - 2^{ℓ-j} s) ds`. -/
theorem IsHomogeneousCZKernel.shortPiece_eq_scaledOsc {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) (ℓ k j : ℤ) (f : 𝓢(Rn n, ℂ)) (x : Rn n) (v : ℝ) :
    shortPiece n α Ω ℓ k f j x (dyadicPoint α j * v) =
      scaledOsc n α (dyadicPoint α ℓ) ((2 : ℝ) ^ (ℓ - j)) (pieceKernel n α Ω 0 0)
        (lpProj n (j + k) f) x v := by
  simp only [shortPiece, modulatedPiece_eq_pieceKernel]
  have h := hΩ.integral_pieceKernel_mul_eq α (dyadicPoint α j * v) (ℓ - j)
    (fun t => lpProj n (j + k) f (x - t))
  rw [show (fun t => lpProj n (j + k) f (x - t) * pieceKernel n α Ω (dyadicPoint α j * v)
    (ℓ - j) t) = fun t => pieceKernel n α Ω (dyadicPoint α j * v) (ℓ - j) t *
      lpProj n (j + k) f (x - t) from funext fun t => mul_comm _ _, h]
  unfold scaledOsc
  congr 1; funext s
  congr 1
  simp only [radPhase]
  rw [← mul_assoc, dyadicPoint_sub_mul]

/-- `∂_w e^{iλw|s|^α} = iλ|s|^α e^{iλw|s|^α}`. -/
theorem hasDerivAt_radPhase {n : ℕ} (α lam : ℝ) (s : Rn n) (w : ℝ) :
    HasDerivAt (fun w => radPhase α lam w s)
      (I * ((lam * ‖s‖ ^ α : ℝ) : ℂ) * radPhase α lam w s) w := by
  have h0 : HasDerivAt (fun w : ℝ => lam * w * ‖s‖ ^ α) (lam * 1 * ‖s‖ ^ α) w :=
    ((hasDerivAt_id w).const_mul lam).mul_const _
  have h1 := (h0.ofReal_comp.const_mul I).cexp
  refine h1.congr_deriv ?_
  simp only [radPhase, mul_one]; ring

/-- Continuity of `v ↦ Θ g(x, v)` (dominated convergence). -/
theorem continuous_scaledOsc {n : ℕ} {α lam c : ℝ} {B g : Rn n → ℂ} (hBi : Integrable B)
    (hgm : Measurable g) {M : ℝ} (hM : ∀ y, ‖g y‖ ≤ M) (x : Rn n) :
    Continuous fun v => scaledOsc n α lam c B g x v := by
  refine continuous_of_dominated (bound := fun s => ‖B s‖ * M) (fun v => ?_)
    (fun v => ae_of_all _ fun s => ?_) (hBi.norm.mul_const M) (ae_of_all _ fun s => ?_)
  · exact ((measurable_radPhase_uncurry α lam).comp (measurable_const.prodMk
      measurable_id)).aestronglyMeasurable.mul (hBi.aestronglyMeasurable.mul
        (hgm.comp (measurable_const.sub (measurable_id.const_smul c))).aestronglyMeasurable)
  · rw [norm_mul, norm_radPhase, one_mul, norm_mul]
    exact mul_le_mul_of_nonneg_left (hM _) (norm_nonneg _)
  · exact (continuous_radPhase_left α lam s).mul continuous_const

/-- **Differentiation in `v`**: `∂_v Θ_B g = λ Θ_{B'} g` with `B'(s) = i|s|^α B(s)`. -/
theorem hasDerivAt_scaledOsc {n : ℕ} {α lam c : ℝ} {B g : Rn n → ℂ} (hBi : Integrable B)
    (hB'i : Integrable fun s => (I * ((‖s‖ ^ α : ℝ) : ℂ)) * B s) (hgm : Measurable g) {M : ℝ}
    (hM : ∀ y, ‖g y‖ ≤ M) (x : Rn n) (v : ℝ) :
    HasDerivAt (fun w => scaledOsc n α lam c B g x w)
      ((lam : ℂ) * scaledOsc n α lam c (fun s => (I * ((‖s‖ ^ α : ℝ) : ℂ)) * B s) g x v) v := by
  have hgc : Measurable fun s : Rn n => g (x - c • s) :=
    hgm.comp (measurable_const.sub (measurable_id.const_smul c))
  have hm : ∀ (A : Rn n → ℂ), Integrable A → ∀ w : ℝ,
      AEStronglyMeasurable (fun s => radPhase α lam w s * (A s * g (x - c • s))) := fun A hA w =>
    ((measurable_radPhase_uncurry α lam).comp (measurable_const.prodMk
      measurable_id)).aestronglyMeasurable.mul (hA.aestronglyMeasurable.mul
        hgc.aestronglyMeasurable)
  unfold scaledOsc
  rw [← integral_const_mul]
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le (s := univ) (x₀ := v)
    (F := fun w s => radPhase α lam w s * (B s * g (x - c • s)))
    (F' := fun w s => (lam : ℂ) * (radPhase α lam w s *
      ((I * ((‖s‖ ^ α : ℝ) : ℂ)) * B s * g (x - c • s))))
    (bound := fun s => |lam| * (‖(I * ((‖s‖ ^ α : ℝ) : ℂ)) * B s‖ * M)) Filter.univ_mem
    (Eventually.of_forall fun w => hm B hBi w) ?_ ?_ (ae_of_all _ fun s w _ => ?_)
    ((hB'i.norm.mul_const M).const_mul _) (ae_of_all _ fun s w _ => ?_)).2
  · refine (hBi.norm.mul_const M).mono' (hm B hBi v) (ae_of_all _ fun s => ?_)
    rw [norm_mul, norm_radPhase, one_mul, norm_mul]
    exact mul_le_mul_of_nonneg_left (hM _) (norm_nonneg _)
  · exact (hm _ hB'i v).const_mul _
  · rw [norm_mul, norm_mul, norm_radPhase, one_mul, Complex.norm_real, Real.norm_eq_abs,
      norm_mul]
    exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hM _) (norm_nonneg _))
      (abs_nonneg _)
  · have := (hasDerivAt_radPhase α lam s w).mul_const (B s * g (x - c • s))
    convert this using 1
    push_cast; ring

/-- Measurability of `Λ h` on `ℝ²`. -/
theorem stronglyMeasurable_osc1 {α lam : ℝ} (hα : 0 ≤ α) {b h : ℝ → ℂ} (hb : Continuous b)
    (hh : Measurable h) : StronglyMeasurable (osc1 α lam b h) := by
  have hexpc : Continuous fun q : (ℝ × ℝ) × ℝ =>
      cexp (I * ((lam * q.1.2 * |q.2| ^ α : ℝ) : ℂ)) :=
    Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
      ((continuous_const.mul (continuous_snd.comp continuous_fst)).mul
        ((continuous_abs.comp continuous_snd).rpow_const fun _ => Or.inr hα))))
  refine stronglyMeasurable_integral_param (F := fun z σ =>
    cexp (I * ((lam * z.2 * |σ| ^ α : ℝ) : ℂ)) * (b σ * h (z.1 - σ))) ?_
  exact hexpc.measurable.mul ((hb.measurable.comp measurable_snd).mul
    (hh.comp ((measurable_fst.comp measurable_fst).sub measurable_snd)))

/-- `Θ` on `ℝ¹` is `Λ` after the identification `ℝ ≅ ℝ¹` and the rescaling `ξ ↦ c⁻¹ ξ`. -/
theorem scaledOsc_eq_osc1 (α lam : ℝ) {c : ℝ} (hc : c ≠ 0) (B g : Rn 1 → ℂ) (x : Rn 1)
    (v : ℝ) : scaledOsc 1 α lam c B g x v = osc1 α lam (fun s => B (rEquiv s))
      (fun y => g (rEquiv (c * y))) (c⁻¹ * x 0, v) := by
  unfold scaledOsc osc1
  rw [integral_rEquiv]
  congr 1; funext σ
  simp only [radPhase, norm_rEquiv]
  congr 3
  conv_lhs => rw [← rEquiv_symm_apply x]
  rw [← rEquiv_mul, ← rEquiv_sub]
  congr 1
  field_simp

/-- **The `L^p(ℝ¹ × U)` bound for `Θ`** (`p > 2`; dilation invariance + `osc1_Lp_le`):
`∫∫ |Θ_{2^m} g|^p ≤ (C λ^{-β(p)} (1 + log λ))^p ∫ |g|^p` for `λ ≥ 2`, all `m ∈ ℤ` and bounded
continuous `g ∈ L^p(ℝ¹)`. -/
theorem scaledOsc_Lp_le {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 2 < p) {B : Rn 1 → ℂ}
    (hB : ContDiff ℝ (⊤ : ℕ∞) B) (hBs : ∀ t, B t ≠ 0 → ‖t‖ ∈ Icc (1 / 2 : ℝ) 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ lam ≥ 2, ∀ m : ℤ, ∀ g : Rn 1 → ℂ, Continuous g → (∃ M, ∀ y, ‖g y‖ ≤ M) →
      MemLp g (ENNReal.ofReal p) volume →
      ∫⁻ x, ∫⁻ v in paramU α, ‖scaledOsc 1 α lam ((2 : ℝ) ^ m) B g x v‖ₑ ^ p ≤
        ENNReal.ofReal (C * lam ^ (-csExp p) * (1 + Real.log lam)) ^ p * ∫⁻ x, ‖g x‖ₑ ^ p := by
  obtain ⟨C, hC0, hC⟩ := osc1_Lp_le hα hp hB hBs
  have hα0 : 0 ≤ α := by linarith
  have hp0 : 0 < p := by linarith
  refine ⟨C, hC0, fun lam hlam m g hg ⟨M, hM⟩ hgp => ?_⟩
  set c : ℝ := (2 : ℝ) ^ m
  have hc : 0 < c := zpow_pos two_pos m
  set h : ℝ → ℂ := fun y => g (rEquiv (c * y))
  have hhc : Continuous h := hg.comp (contDiff_rEquiv.continuous.comp (continuous_const.mul
    continuous_id))
  have hbc : Continuous fun s => B (rEquiv s) := hB.continuous.comp contDiff_rEquiv.continuous
  -- the norm of `h`
  have hgm : Measurable fun y : Rn 1 => ‖g y‖ₑ ^ p := (hg.measurable.enorm.pow_const p)
  have hh_eq : ∫⁻ y, ‖h y‖ₑ ^ p = ENNReal.ofReal c⁻¹ * ∫⁻ x, ‖g x‖ₑ ^ p := by
    have h1 : ∫⁻ y, ‖h y‖ₑ ^ p = ∫⁻ y : Rn 1, ‖g (c • y)‖ₑ ^ p := by
      rw [lintegral_rEquiv]
      simp only [h, rEquiv_mul]
    rw [h1, lintegral_comp_two_zpow_smul hgm m, pow_one]
  have hgfin : ∫⁻ x, ‖g x‖ₑ ^ p ≠ ∞ := by
    rw [lintegral_enorm_rpow_eq hg.aestronglyMeasurable hp0]
    exact (ENNReal.rpow_lt_top_of_nonneg hp0.le (ne_of_lt (memLp_iff.1 hgp))).ne
  have hhp : MemLp h (ENNReal.ofReal p) volume := by
    refine memLp_iff.2 ?_
    have : eLpNorm h (ENNReal.ofReal p) volume ^ p < ∞ := by
      rw [← lintegral_enorm_rpow_eq hhc.aestronglyMeasurable hp0, hh_eq]
      exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hgfin.lt_top
    exact (ENNReal.rpow_lt_top_iff_of_pos hp0).1 this
  have hbound := hC lam hlam h hhc.measurable ⟨M, fun y => hM _⟩ hhp
  -- the change of variables in `x`
  have hosc := stronglyMeasurable_osc1 (lam := lam) hα0 hbc hhc.measurable
  set Ψ : Rn 1 → ℝ≥0∞ := fun y => ∫⁻ v in paramU α,
    ‖osc1 α lam (fun s => B (rEquiv s)) h (y 0, v)‖ₑ ^ p
  have hΨm : Measurable Ψ := by
    have : Measurable fun ξ : ℝ => ∫⁻ v in paramU α,
        ‖osc1 α lam (fun s => B (rEquiv s)) h (ξ, v)‖ₑ ^ p :=
      (hosc.measurable.enorm.pow_const p).lintegral_prod_right'
    exact this.comp (measurable_pi_apply 0 |>.comp (MeasurableEquiv.toLp 2 _).symm.measurable)
  have hx : ∀ x : Rn 1, ∫⁻ v in paramU α, ‖scaledOsc 1 α lam c B g x v‖ₑ ^ p =
      Ψ ((2 : ℝ) ^ (-m) • x) := by
    intro x
    simp only [Ψ]
    congr 1; funext v
    rw [scaledOsc_eq_osc1 α lam hc.ne' B g x v]
    congr 4
    simp [c, zpow_neg]
  calc ∫⁻ x, ∫⁻ v in paramU α, ‖scaledOsc 1 α lam c B g x v‖ₑ ^ p
      = ∫⁻ x, Ψ ((2 : ℝ) ^ (-m) • x) := lintegral_congr hx
    _ = ENNReal.ofReal c * ∫⁻ y, Ψ y := by
        rw [lintegral_comp_two_zpow_smul hΨm (-m), pow_one, zpow_neg, inv_inv]
    _ = ENNReal.ofReal c * ∫⁻ ξ, ∫⁻ v in paramU α,
          ‖osc1 α lam (fun s => B (rEquiv s)) h (ξ, v)‖ₑ ^ p := by
        rw [lintegral_rEquiv]; simp only [Ψ, rEquiv_apply]
    _ ≤ ENNReal.ofReal c * (ENNReal.ofReal (C * lam ^ (-csExp p) * (1 + Real.log lam)) ^ p *
          (ENNReal.ofReal c⁻¹ * ∫⁻ x, ‖g x‖ₑ ^ p)) := by
        rw [← hh_eq]; exact mul_le_mul' le_rfl hbound
    _ = _ := by
        have h1 : ENNReal.ofReal c * ENNReal.ofReal c⁻¹ = 1 := by
          rw [← ENNReal.ofReal_mul hc.le, mul_inv_cancel₀ hc.ne', ENNReal.ofReal_one]
        rw [show ∀ a b : ℝ≥0∞, ENNReal.ofReal c * (a * (ENNReal.ofReal c⁻¹ * b)) =
          a * b * (ENNReal.ofReal c * ENNReal.ofReal c⁻¹) from fun a b => by ring, h1, mul_one]

/-! ### The `(p, p)` estimate for `n = 1` (paper (`eq:eachpiece`), `V^p`-embedding) -/

/-- Joint measurability of `(x, v) ↦ Θ g(x, v)`. -/
theorem stronglyMeasurable_scaledOsc {n : ℕ} (α lam c : ℝ) {B g : Rn n → ℂ} (hB : Measurable B)
    (hg : Measurable g) :
    StronglyMeasurable fun q : Rn n × ℝ => scaledOsc n α lam c B g q.1 q.2 := by
  have : Measurable fun r : (Rn n × ℝ) × Rn n =>
      radPhase α lam r.1.2 r.2 * (B r.2 * g (r.1.1 - c • r.2)) :=
    ((measurable_radPhase_uncurry α lam).comp ((measurable_snd.comp measurable_fst).prodMk
      measurable_snd)).mul ((hB.comp measurable_snd).mul (hg.comp ((measurable_fst.comp
        measurable_fst).sub (measurable_snd.const_smul c))))
  exact this.stronglyMeasurable.integral_prod_right'

/-- **The `V^q`-embedding at one scale in physical space**: with `λ = 2^{ℓα}`, `c = 2^{ℓ-j}`,
`g = P_{j+k} f`, `(V^q_{J_j} 𝓗^{(·)}_{ℓ-j} g(x))^q ≤ 2·4^q ‖Θ_{φ₀K} g(x, ·)‖_{L^q_U}^{q-1}
‖λ Θ_{i|·|^α φ₀K} g(x, ·)‖_{L^q_U}` (`q ≥ 1`). -/
theorem IsHomogeneousCZKernel.variationNorm_shortPiece_rpow_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) (α : ℝ) {q : ℝ} (hq : 1 ≤ q) (ℓ k j : ℤ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    variationNorm q (shortInterval α j) (shortPiece n α Ω ℓ k f j x) ^ q ≤
      2 * 4 ^ q * (∫⁻ v in paramU α, ‖scaledOsc n α (dyadicPoint α ℓ) ((2 : ℝ) ^ (ℓ - j))
        (pieceKernel n α Ω 0 0) (lpProj n (j + k) f) x v‖ₑ ^ q) ^ ((q - 1) / q) *
      (∫⁻ v in paramU α, ‖(dyadicPoint α ℓ : ℂ) * scaledOsc n α (dyadicPoint α ℓ)
        ((2 : ℝ) ^ (ℓ - j)) (pieceKernelD n α Ω 0 0) (lpProj n (j + k) f) x v‖ₑ ^ q) ^
          (1 / q) := by
  set g := lpProj n (j + k) f
  have hgm : Measurable (g : Rn n → ℂ) := g.continuous.measurable
  have hM : ∀ y, ‖g y‖ ≤ SchwartzMap.seminorm ℝ 0 0 g := fun y => SchwartzMap.norm_le_seminorm ℝ g y
  rw [variationNorm_shortInterval_eq]
  have he : (fun v => shortPiece n α Ω ℓ k f j x (dyadicPoint α j * v)) = fun v =>
      scaledOsc n α (dyadicPoint α ℓ) ((2 : ℝ) ^ (ℓ - j)) (pieceKernel n α Ω 0 0) g x v :=
    funext fun v => hΩ.shortPiece_eq_scaledOsc α ℓ k j f x v
  rw [he]
  have hd := fun v => hasDerivAt_scaledOsc (lam := dyadicPoint α ℓ) (c := (2 : ℝ) ^ (ℓ - j))
    (hΩ.integrable_pieceKernel α 0 0) (hΩ.integrable_pieceKernelD α 0 0) hgm hM x v
  have hc : Continuous fun v => (dyadicPoint α ℓ : ℂ) * scaledOsc n α (dyadicPoint α ℓ)
      ((2 : ℝ) ^ (ℓ - j)) (pieceKernelD n α Ω 0 0) g x v :=
    continuous_const.mul (continuous_scaledOsc (hΩ.integrable_pieceKernelD α 0 0) hgm hM x)
  exact variationNorm_rpow_le_of_hasDerivWithinAt (a := 1) (b := (2 : ℝ) ^ α) hq
    (fun u _ => (hd u).hasDerivWithinAt) hc.continuousOn

/-- **Hölder in `x`**: `∫ a^{(p-1)/p} b^{1/p} ≤ (∫ a)^{(p-1)/p} (∫ b)^{1/p}` (`p > 1`). -/
theorem lintegral_rpow_mul_rpow_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {a b : X → ℝ≥0∞} (ha : AEMeasurable a μ) (hb : AEMeasurable b μ) {p : ℝ} (hp : 1 < p) :
    ∫⁻ x, a x ^ ((p - 1) / p) * b x ^ (1 / p) ∂μ ≤
      (∫⁻ x, a x ∂μ) ^ ((p - 1) / p) * (∫⁻ x, b x ∂μ) ^ (1 / p) := by
  have hp0 : 0 < p := by linarith
  have hpq : (p / (p - 1)).HolderConjugate p := (Real.HolderConjugate.conjExponent hp).symm
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hpq (ha.pow_const ((p - 1) / p))
    (hb.pow_const (1 / p))
  have e1 : ∀ c : ℝ≥0∞, (c ^ ((p - 1) / p)) ^ (p / (p - 1)) = c := fun c => by
    rw [← ENNReal.rpow_mul, div_mul_div_comm, mul_comm (p - 1) p,
      div_self (by have : 0 < p - 1 := by linarith
                   positivity), ENNReal.rpow_one]
  have e2 : ∀ c : ℝ≥0∞, (c ^ (1 / p)) ^ p = c := fun c => rpow_one_div_rpow hp0.ne' c
  simp only [e1, e2] at h
  have e3 : 1 / (p / (p - 1)) = (p - 1) / p := by rw [one_div_div]
  rw [e3] at h
  exact h

/-- **Littlewood–Paley in `ℓ²`-tsum form**: `‖(∑_j |ψ_{j+k} * f|²)^{1/2}‖_p ≤ C ‖f‖_p`. -/
theorem eLpNorm_sqrt_tsum_lpConv_le {n : ℕ} (hn : 1 ≤ n) (ψ : 𝓢(Rn n, ℂ))
    (hψ : ∫ x, ψ x = 0) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ (k : ℤ) (f : 𝓢(Rn n, ℂ)),
      eLpNorm (fun x => (∑' j : ℤ, ‖lpConv ψ (j + k) f x‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨C₂, -, hC₂⟩ := littlewood_paley (by omega : 0 < n) ψ hψ hp
  refine ⟨ENNReal.ofReal C₂, ENNReal.ofReal_ne_top, fun k f => ?_⟩
  have hmeas : ∀ j : ℤ, AEMeasurable (fun x => ‖lpConv ψ (j + k) f x‖ₑ ^ (2 : ℝ)) := fun j =>
    ((lpConv ψ (j + k) f).continuous.measurable.enorm.pow_const _).aemeasurable
  refine eLpNorm_tsum_rpow_le_of_partial hmeas (by linarith) fun N => ?_
  set s := Finset.Icc (-(N : ℤ)) N
  have h2 := hC₂ (s.map (addRightEmbedding k)) f (f.memLp _)
  simp only [Finset.sum_map, addRightEmbedding_apply] at h2
  have hm : Measurable fun x => (∑ j ∈ s, ‖lpConv ψ (j + k) f x‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
    refine Measurable.pow_const ?_ _
    exact Finset.measurable_sum s fun j _ =>
      (lpConv ψ (j + k) f).continuous.measurable.enorm.pow_const _
  refine le_trans (eLpNorm_mono_enorm hm.aestronglyMeasurable fun x => le_of_eq ?_) h2
  rw [enorm_eq_self, Real.enorm_eq_ofReal (Real.sqrt_nonneg _), Real.sqrt_eq_rpow,
    ← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num),
    ENNReal.ofReal_sum_of_nonneg (fun _ _ => by positivity)]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [lpConv_apply, ← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
  norm_num

/-- The unit-scale amplitude `φ₀ K` is supported in `1/2 ≤ |t| ≤ 2`. -/
theorem pieceKernel_zero_ne_zero {n : ℕ} {α : ℝ} {Ω : Rn n → ℝ} {t : Rn n}
    (h : pieceKernel n α Ω 0 0 t ≠ 0) : ‖t‖ ∈ Icc (1 / 2 : ℝ) 2 := by
  have h' : dyadicPhi n t ≠ 0 := by
    intro h0; apply h; simp [pieceKernel_zero_zero_apply, h0]
  have := dyadicPhi_ne_zero h'
  exact ⟨this.1.le, this.2.le⟩

/-- The unit-scale derivative amplitude `i|t|^α φ₀ K` is supported in `1/2 ≤ |t| ≤ 2`. -/
theorem pieceKernelD_zero_ne_zero {n : ℕ} {α : ℝ} {Ω : Rn n → ℝ} {t : Rn n}
    (h : pieceKernelD n α Ω 0 0 t ≠ 0) : ‖t‖ ∈ Icc (1 / 2 : ℝ) 2 := by
  refine pieceKernel_zero_ne_zero (α := α) (Ω := Ω) fun h0 => h ?_
  rw [pieceKernelD, h0, mul_zero]

/-- `(A^p G)^{(p-1)/p} (B^p A^p G)^{1/p} = A^p B G` in `[0, ∞]`. -/
theorem rpow_mul_rpow_aux {p : ℝ} (hp : 1 < p) (A B G : ℝ≥0∞) :
    (A ^ p * G) ^ ((p - 1) / p) * (B ^ p * A ^ p * G) ^ (1 / p) = A ^ p * B * G := by
  have hp0 : 0 < p := by linarith
  have h1 : 0 ≤ (p - 1) / p := div_nonneg (by linarith) hp0.le
  have h2 : (0 : ℝ) ≤ 1 / p := by positivity
  rw [ENNReal.mul_rpow_of_nonneg _ _ h1, ENNReal.mul_rpow_of_nonneg _ _ h2,
    ENNReal.mul_rpow_of_nonneg _ _ h2, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
    ← ENNReal.rpow_mul]
  have e1 : A ^ (p * ((p - 1) / p)) * A ^ (p * (1 / p)) = A ^ p := by
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity)]
    congr 1; field_simp; ring
  have e2 : G ^ ((p - 1) / p) * G ^ (1 / p) = G := by
    rw [← ENNReal.rpow_add_of_nonneg _ _ h1 h2]
    rw [show (p - 1) / p + 1 / p = 1 by field_simp; ring, ENNReal.rpow_one]
  have eB : B ^ (p * (1 / p)) = B := by rw [mul_one_div_cancel hp0.ne', ENNReal.rpow_one]
  calc A ^ (p * ((p - 1) / p)) * G ^ ((p - 1) / p) *
        (B ^ (p * (1 / p)) * A ^ (p * (1 / p)) * G ^ (1 / p))
      = (A ^ (p * ((p - 1) / p)) * A ^ (p * (1 / p))) * B ^ (p * (1 / p)) *
          (G ^ ((p - 1) / p) * G ^ (1 / p)) := by ring
    _ = _ := by rw [e1, e2, eB]

/-- `λ = 2^{ℓα} ≥ 2` for `ℓ ≥ 1`, `α > 1`. -/
theorem two_le_dyadicPoint {α : ℝ} (hα : 1 < α) {ℓ : ℤ} (hℓ : 1 ≤ ℓ) : 2 ≤ dyadicPoint α ℓ := by
  have hl : (1 : ℝ) ≤ ℓ := by exact_mod_cast hℓ
  calc (2 : ℝ) = 2 ^ (1 : ℝ) := (Real.rpow_one 2).symm
    _ ≤ dyadicPoint α ℓ := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by nlinarith)

set_option maxHeartbeats 1000000 in
-- The proof combines the `V^p`-embedding, Hölder, the Carleson–Sjölin bounds and
-- Littlewood–Paley in `[0, ∞]`-valued arithmetic.
/-- **The `(p, p)` estimate for `n = 1`** (paper (`eq:eachpiece`) with `r = p`; route:
`V^p`-embedding,
Hölder in `x`, the Carleson–Sjölin bounds for `Θ` and `∂_v Θ`, Littlewood–Paley with
`ℓ^p ⊂ ℓ²`): for `α > 1`, `p > 2` there is `C` such that for `ℓ ≥ 1`, all `k` and Schwartz `f`,
`‖(∑_j V^p_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^p)^{1/p}‖_p ≤ C λ^{1/p - β(p)} (1 + log λ) ‖f‖_p`
(`λ = 2^{ℓα}`; note `1/p - β(p) < 0`). -/
theorem IsHomogeneousCZKernel.eLpNorm_shortPieceVar_pp {Ω : Rn 1 → ℝ}
    (hΩ : IsHomogeneousCZKernel 1 Ω) {α : ℝ} (hα : 1 < α) {p : ℝ} (hp : 2 < p) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ℓ k : ℤ, 1 ≤ ℓ → ∀ f : 𝓢(Rn 1, ℂ),
      eLpNorm (shortPieceVar p 1 α Ω ℓ k f) (ENNReal.ofReal p) ≤
        ENNReal.ofReal (C * dyadicPoint α ℓ ^ (1 / p - csExp p) *
          (1 + Real.log (dyadicPoint α ℓ))) * eLpNorm f (ENNReal.ofReal p) := by
  have hα0 : 0 < α := by linarith
  have hp0 : 0 < p := by linarith
  have hp1 : 1 < p := by linarith
  obtain ⟨C₀, hC₀, h0⟩ := scaledOsc_Lp_le hα hp (hΩ.contDiff_pieceKernel α 0 0)
    (fun t h => pieceKernel_zero_ne_zero h)
  obtain ⟨C₁, hC₁, h1⟩ := scaledOsc_Lp_le hα hp (hΩ.contDiff_pieceKernelD_zero α)
    (fun t h => pieceKernelD_zero_ne_zero h)
  obtain ⟨CL, hCL, hLP⟩ := eLpNorm_sqrt_tsum_lpConv_le le_rfl (lpPsi 1) (integral_lpPsi 1) hp1
  refine ⟨(2 * 4 ^ p) ^ (1 / p) * (C₀ + C₁) * CL.toReal, by positivity,
    fun ℓ k hℓ f => ?_⟩
  set lam := dyadicPoint α ℓ
  have hlam2 : 2 ≤ lam := two_le_dyadicPoint hα hℓ
  have hlam0 : 0 < lam := by linarith
  set X := lam ^ (-csExp p) * (1 + Real.log lam)
  have hX : 0 ≤ X := by
    have := Real.log_nonneg (by linarith : (1 : ℝ) ≤ lam)
    have := Real.rpow_nonneg hlam0.le (-csExp p)
    positivity
  set A := ENNReal.ofReal ((C₀ + C₁) * X)
  set G : ℤ → ℝ≥0∞ := fun j => ∫⁻ x, ‖lpProj 1 (j + k) f x‖ₑ ^ p
  -- the bound at one scale
  have hj : ∀ j : ℤ, ∫⁻ x, variationNorm p (shortInterval α j) (shortPiece 1 α Ω ℓ k f j x) ^ p ≤
      2 * 4 ^ p * (A ^ p * ENNReal.ofReal lam * G j) := by
    intro j
    set g := lpProj 1 (j + k) f
    have hgc : Continuous (g : Rn 1 → ℂ) := g.continuous
    have hgM : ∃ M, ∀ y, ‖g y‖ ≤ M := ⟨_, fun y => SchwartzMap.norm_le_seminorm ℝ g y⟩
    have hgp : MemLp (g : Rn 1 → ℂ) (ENNReal.ofReal p) volume := g.memLp _
    set c : ℝ := (2 : ℝ) ^ (ℓ - j)
    set a : Rn 1 → ℝ≥0∞ := fun x => ∫⁻ v in paramU α,
      ‖scaledOsc 1 α lam c (pieceKernel 1 α Ω 0 0) g x v‖ₑ ^ p
    set b : Rn 1 → ℝ≥0∞ := fun x => ∫⁻ v in paramU α,
      ‖(lam : ℂ) * scaledOsc 1 α lam c (pieceKernelD 1 α Ω 0 0) g x v‖ₑ ^ p
    have ham : Measurable a :=
      ((stronglyMeasurable_scaledOsc α lam c (hΩ.contDiff_pieceKernel α 0 0).continuous.measurable
        hgc.measurable).measurable.enorm.pow_const p).lintegral_prod_right'
    have hbm : Measurable b :=
      ((((stronglyMeasurable_scaledOsc α lam c
        (hΩ.contDiff_pieceKernelD_zero α).continuous.measurable
          hgc.measurable).measurable.const_mul (lam : ℂ))).enorm.pow_const p).lintegral_prod_right'
    have hb : ∀ x, b x = ENNReal.ofReal lam ^ p * ∫⁻ v in paramU α,
        ‖scaledOsc 1 α lam c (pieceKernelD 1 α Ω 0 0) g x v‖ₑ ^ p := by
      intro x
      simp only [b, enorm_mul, ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [lintegral_const_mul' _ _ (by
        rw [← ofReal_norm, Complex.norm_real]; exact ENNReal.rpow_ne_top_of_nonneg hp0.le
          ENNReal.ofReal_ne_top)]
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hlam0.le]
    have hA0 : ∫⁻ x, a x ≤ A ^ p * G j := by
      refine (h0 lam hlam2 (ℓ - j) g hgc hgM hgp).trans (mul_le_mul' ?_ le_rfl)
      exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal (by nlinarith)) hp0.le
    have hA1 : ∫⁻ x, b x ≤ ENNReal.ofReal lam ^ p * A ^ p * G j := by
      simp_rw [hb]
      rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top),
        mul_assoc]
      refine mul_le_mul' le_rfl ((h1 lam hlam2 (ℓ - j) g hgc hgM hgp).trans
        (mul_le_mul' ?_ le_rfl))
      exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal (by nlinarith)) hp0.le
    calc ∫⁻ x, variationNorm p (shortInterval α j) (shortPiece 1 α Ω ℓ k f j x) ^ p
        ≤ ∫⁻ x, 2 * 4 ^ p * (a x ^ ((p - 1) / p) * b x ^ (1 / p)) :=
          lintegral_mono fun x => by
            rw [← mul_assoc]; exact hΩ.variationNorm_shortPiece_rpow_le α hp1.le ℓ k j f x
      _ = 2 * 4 ^ p * ∫⁻ x, a x ^ ((p - 1) / p) * b x ^ (1 / p) :=
          lintegral_const_mul _ ((ham.pow_const _).mul (hbm.pow_const _))
      _ ≤ 2 * 4 ^ p * ((∫⁻ x, a x) ^ ((p - 1) / p) * (∫⁻ x, b x) ^ (1 / p)) :=
          mul_le_mul' le_rfl (lintegral_rpow_mul_rpow_le ham.aemeasurable hbm.aemeasurable hp1)
      _ ≤ 2 * 4 ^ p * ((A ^ p * G j) ^ ((p - 1) / p) *
            (ENNReal.ofReal lam ^ p * A ^ p * G j) ^ (1 / p)) := by
          gcongr
      _ = 2 * 4 ^ p * (A ^ p * ENNReal.ofReal lam * G j) := by rw [rpow_mul_rpow_aux hp1]
  -- Littlewood–Paley
  have hLPk : ∑' j : ℤ, G j ≤ (CL * eLpNorm f (ENNReal.ofReal p)) ^ p := by
    set S : Rn 1 → ℝ≥0∞ := fun x =>
      (∑' j : ℤ, ‖lpConv (lpPsi 1) (j + k) f x‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ)
    have hSm : Measurable S := (Measurable.tsum fun j =>
      (lpConv (lpPsi 1) (j + k) f).continuous.measurable.enorm.pow_const _).pow_const _
    have hpt : ∀ x, ∑' j : ℤ, ‖lpProj 1 (j + k) f x‖ₑ ^ p ≤ S x ^ p := fun x =>
      le_rpow_of_rpow_one_div_le hp0 (tsum_rpow_one_div_le two_pos hp.le
        (fun j => ‖lpConv (lpPsi 1) (j + k) f x‖ₑ))
    calc ∑' j : ℤ, G j = ∫⁻ x, ∑' j : ℤ, ‖lpProj 1 (j + k) f x‖ₑ ^ p :=
          (lintegral_tsum fun j =>
            ((lpProj 1 (j + k) f).continuous.measurable.enorm.pow_const p).aemeasurable).symm
      _ ≤ ∫⁻ x, S x ^ p := lintegral_mono hpt
      _ = eLpNorm S (ENNReal.ofReal p) ^ p := by
          rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp0) ENNReal.ofReal_ne_top
            hSm.aestronglyMeasurable, ENNReal.toReal_ofReal hp0.le, ← ENNReal.rpow_mul,
            one_div_mul_cancel hp0.ne', ENNReal.rpow_one]
          simp only [enorm_eq_self]
      _ ≤ _ := ENNReal.rpow_le_rpow (hLP k f) hp0.le
  -- assembly
  have hVm : ∀ j, AEMeasurable fun x =>
      variationNorm p (shortInterval α j) (shortPiece 1 α Ω ℓ k f j x) ^ p := fun j =>
    ((hΩ.measurable_variationNorm_shortPiece hα0 p ℓ k j f).pow_const p).aemeasurable
  have hE : eLpNorm (shortPieceVar p 1 α Ω ℓ k f) (ENNReal.ofReal p) =
      (∑' j : ℤ, ∫⁻ x, variationNorm p (shortInterval α j)
        (shortPiece 1 α Ω ℓ k f j x) ^ p) ^ (1 / p) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp0) ENNReal.ofReal_ne_top
      (hΩ.measurable_shortPieceVar hα0 p ℓ k f).aestronglyMeasurable,
      ENNReal.toReal_ofReal hp0.le, ← lintegral_tsum hVm]
    simp only [enorm_eq_self, shortPieceVar, rpow_one_div_rpow hp0.ne']
  rw [hE]
  have hfin : CL = ENNReal.ofReal CL.toReal := (ENNReal.ofReal_toReal hCL).symm
  calc (∑' j : ℤ, ∫⁻ x, variationNorm p (shortInterval α j) (shortPiece 1 α Ω ℓ k f j x) ^ p) ^
        (1 / p)
      ≤ (2 * 4 ^ p * (A ^ p * ENNReal.ofReal lam * (CL * eLpNorm f (ENNReal.ofReal p)) ^ p)) ^
          (1 / p) := by
        refine ENNReal.rpow_le_rpow ?_ (by positivity)
        refine (ENNReal.tsum_le_tsum hj).trans ?_
        rw [ENNReal.tsum_mul_left, ENNReal.tsum_mul_left]
        exact mul_le_mul' le_rfl (mul_le_mul' le_rfl hLPk)
    _ = ENNReal.ofReal ((2 * 4 ^ p * lam) ^ (1 / p)) * A * CL * eLpNorm f (ENNReal.ofReal p) := by
        rw [show (2 : ℝ≥0∞) * 4 ^ p * (A ^ p * ENNReal.ofReal lam *
            (CL * eLpNorm f (ENNReal.ofReal p) volume) ^ p) = (2 * 4 ^ p * ENNReal.ofReal lam) *
              (A * CL * eLpNorm f (ENNReal.ofReal p) volume) ^ p by
          simp only [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]; ring]
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), rpow_rpow_one_div hp0.ne']
        rw [show (2 : ℝ≥0∞) * 4 ^ p * ENNReal.ofReal lam = ENNReal.ofReal (2 * 4 ^ p * lam) by
          rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by norm_num),
            ENNReal.ofReal_ofNat, ← ENNReal.ofReal_rpow_of_pos (by norm_num), ENNReal.ofReal_ofNat],
          ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
        ring
    _ ≤ _ := by
        rw [hfin, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        refine mul_le_mul' (le_of_eq ?_) le_rfl
        congr 1
        rw [Real.mul_rpow (by positivity : (0 : ℝ) ≤ 2 * 4 ^ p) hlam0.le,
          show (1 / p - csExp p) = 1 / p + -csExp p by ring, Real.rpow_add hlam0]
        simp only [X, ENNReal.toReal_ofReal ENNReal.toReal_nonneg]
        ring

/-! ### Log-convexity of mixed `ℓ^r(V^r)` norms
(route: `2 < r < p` by interpolation at fixed `p`) -/

/-- **Hölder for the interpolation of `ℓ^r` between `ℓ²` and `ℓ^p`** (finite sums): if
`1/r = θ/2 + (1-θ)/p` with `0 < θ < 1`, then
`∑_i (a_i^θ b_i^{1-θ})^r ≤ (∑ a_i²)^{θr/2} (∑ b_i^p)^{(1-θ)r/p}`. -/
theorem sum_rpow_interp_le {ι : Type*} (s : Finset ι) (a b : ι → ℝ≥0∞) {r p θ : ℝ}
    (hr : 0 < r) (hp : 0 < p) (hθ0 : 0 < θ) (hθ1 : θ < 1)
    (hrθ : 1 / r = θ / 2 + (1 - θ) / p) :
    ∑ i ∈ s, (a i ^ θ * b i ^ (1 - θ)) ^ r ≤
      (∑ i ∈ s, a i ^ (2 : ℝ)) ^ (θ * r / 2) * (∑ i ∈ s, b i ^ p) ^ ((1 - θ) * r / p) := by
  have h1θ : 0 < 1 - θ := by linarith
  have hsum : θ * r / 2 + (1 - θ) * r / p = 1 := by
    have : θ * r / 2 + (1 - θ) * r / p = r * (1 / r) := by rw [hrθ]; ring
    rw [this, mul_one_div_cancel hr.ne']
  have hP : (θ * r / 2)⁻¹.HolderConjugate ((1 - θ) * r / p)⁻¹ :=
    Real.HolderConjugate.inv_inv (by positivity) (by positivity) hsum
  have h := ENNReal.inner_le_Lp_mul_Lq s (fun i => a i ^ (θ * r)) (fun i => b i ^ ((1 - θ) * r)) hP
  have e1 : ∀ i, (a i ^ θ * b i ^ (1 - θ)) ^ r = a i ^ (θ * r) * b i ^ ((1 - θ) * r) := fun i => by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hr.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
  have e2 : ∀ i, (a i ^ (θ * r)) ^ (θ * r / 2)⁻¹ = a i ^ (2 : ℝ) := fun i => by
    rw [← ENNReal.rpow_mul]; congr 1; field_simp
  have e3 : ∀ i, (b i ^ ((1 - θ) * r)) ^ ((1 - θ) * r / p)⁻¹ = b i ^ p := fun i => by
    rw [← ENNReal.rpow_mul]; congr 1; field_simp
  simp only [e2, e3, one_div, inv_inv] at h
  simp only [e1]
  exact h

/-- The same for countable sums. -/
theorem tsum_rpow_interp_le {ι : Type*} (a b : ι → ℝ≥0∞) {r p θ : ℝ}
    (hr : 0 < r) (hp : 0 < p) (hθ0 : 0 < θ) (hθ1 : θ < 1)
    (hrθ : 1 / r = θ / 2 + (1 - θ) / p) :
    ∑' i, (a i ^ θ * b i ^ (1 - θ)) ^ r ≤
      (∑' i, a i ^ (2 : ℝ)) ^ (θ * r / 2) * (∑' i, b i ^ p) ^ ((1 - θ) * r / p) := by
  have h1θ : 0 < 1 - θ := by linarith
  rw [ENNReal.tsum_eq_iSup_sum]
  refine iSup_le fun s => (sum_rpow_interp_le s a b hr hp hθ0 hθ1 hrθ).trans ?_
  gcongr
  · exact ENNReal.sum_le_tsum s
  · exact ENNReal.sum_le_tsum s

/-- **Log-convexity of `V^r`**: `V^r ≤ (V²)^θ (V^p)^{1-θ}` for `1/r = θ/2 + (1-θ)/p`. -/
theorem variationNorm_le_interp_two {r p θ : ℝ} (hr : 0 < r) (hp : 0 < p) (hθ0 : 0 < θ)
    (hθ1 : θ < 1) (hrθ : 1 / r = θ / 2 + (1 - θ) / p) (𝒥 : Set ℝ) (a : ℝ → ℂ) :
    variationNorm r 𝒥 a ≤ variationNorm 2 𝒥 a ^ θ * variationNorm p 𝒥 a ^ (1 - θ) := by
  have h1θ : 0 < 1 - θ := by linarith
  refine variationNorm_le fun J u hu hm => ?_
  set d : Fin J → ℝ≥0∞ := fun i => ‖a (u i.succ) - a (u i.castSucc)‖ₑ
  have h := sum_rpow_interp_le Finset.univ d d hr hp hθ0 hθ1 hrθ
  have e : ∀ i, (d i ^ θ * d i ^ (1 - θ)) = d i := fun i => by
    rw [← ENNReal.rpow_add_of_nonneg _ _ hθ0.le h1θ.le, add_sub_cancel, ENNReal.rpow_one]
  simp only [e] at h
  calc (∑ i, d i ^ r) ^ (1 / r)
      ≤ ((∑ i, d i ^ (2 : ℝ)) ^ (θ * r / 2) * (∑ i, d i ^ p) ^ ((1 - θ) * r / p)) ^ (1 / r) :=
        ENNReal.rpow_le_rpow h (by positivity)
    _ = ((∑ i, d i ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) ^ θ * ((∑ i, d i ^ p) ^ (1 / p)) ^ (1 - θ) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
        congr 2 <;> field_simp
    _ ≤ _ := by
        gcongr
        · exact le_variationNorm hu hm
        · exact le_variationNorm hu hm

/-- **Pointwise log-convexity of the mixed norms**:
`‖V^r_j(…)‖_{ℓ^r_j} ≤ ‖V²_j(…)‖_{ℓ²_j}^θ ‖V^p_j(…)‖_{ℓ^p_j}^{1-θ}` for `1/r = θ/2 + (1-θ)/p`. -/
theorem shortPieceVar_le_interp {n : ℕ} {Ω : Rn n → ℝ} {α r p θ : ℝ} (hr : 0 < r) (hp : 0 < p)
    (hθ0 : 0 < θ) (hθ1 : θ < 1) (hrθ : 1 / r = θ / 2 + (1 - θ) / p) (ℓ k : ℤ)
    (f : 𝓢(Rn n, ℂ)) (x : Rn n) :
    shortPieceVar r n α Ω ℓ k f x ≤
      shortPieceVar 2 n α Ω ℓ k f x ^ θ * shortPieceVar p n α Ω ℓ k f x ^ (1 - θ) := by
  have h1θ : 0 < 1 - θ := by linarith
  unfold shortPieceVar
  set V : ℝ → ℤ → ℝ≥0∞ := fun q j =>
    variationNorm q (shortInterval α j) (shortPiece n α Ω ℓ k f j x)
  calc (∑' j, V r j ^ r) ^ (1 / r)
      ≤ (∑' j, (V 2 j ^ θ * V p j ^ (1 - θ)) ^ r) ^ (1 / r) := by
        refine ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun j => ?_) (by positivity)
        exact ENNReal.rpow_le_rpow (variationNorm_le_interp_two hr hp hθ0 hθ1 hrθ _ _) hr.le
    _ ≤ ((∑' j, V 2 j ^ (2 : ℝ)) ^ (θ * r / 2) * (∑' j, V p j ^ p) ^ ((1 - θ) * r / p)) ^ (1 / r) :=
        ENNReal.rpow_le_rpow (tsum_rpow_interp_le _ _ hr hp hθ0 hθ1 hrθ) (by positivity)
    _ = ((∑' j, V 2 j ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) ^ θ * ((∑' j, V p j ^ p) ^ (1 / p)) ^ (1 - θ) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
        congr 2 <;> field_simp

/-- **Hölder in `x` for geometric means**: `‖F^θ G^{1-θ}‖_p ≤ ‖F‖_p^θ ‖G‖_p^{1-θ}`. -/
theorem eLpNorm_interp_rpow_mul_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F G : X → ℝ≥0∞} (hF : AEMeasurable F μ) (hG : AEMeasurable G μ) {p θ : ℝ} (hp : 0 < p)
    (hθ0 : 0 < θ) (hθ1 : θ < 1) :
    eLpNorm (fun x => F x ^ θ * G x ^ (1 - θ)) (ENNReal.ofReal p) μ ≤
      eLpNorm F (ENNReal.ofReal p) μ ^ θ * eLpNorm G (ENNReal.ofReal p) μ ^ (1 - θ) := by
  have h1θ : 0 < 1 - θ := by linarith
  have hp0 : ENNReal.ofReal p ≠ 0 := by simpa using hp
  have hm : AEMeasurable (fun x => F x ^ θ * G x ^ (1 - θ)) μ :=
    (hF.pow_const _).mul (hG.pow_const _)
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top hm.aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top hF.aestronglyMeasurable,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top hG.aestronglyMeasurable,
    ENNReal.toReal_ofReal hp.le]
  simp only [enorm_eq_self]
  have hPQ : θ⁻¹.HolderConjugate (1 - θ)⁻¹ := Real.HolderConjugate.inv_inv hθ0 h1θ (by ring)
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hPQ ((hF.pow_const θ).pow_const p)
    ((hG.pow_const (1 - θ)).pow_const p)
  have e1 : ∀ c : ℝ≥0∞, ((c ^ θ) ^ p) ^ θ⁻¹ = c ^ p := fun c => by
    rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul]; congr 1; field_simp
  have e2 : ∀ c : ℝ≥0∞, ((c ^ (1 - θ)) ^ p) ^ (1 - θ)⁻¹ = c ^ p := fun c => by
    rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul]; congr 1; field_simp
  simp only [Pi.mul_apply, e1, e2, one_div, inv_inv] at h
  calc (∫⁻ x, (F x ^ θ * G x ^ (1 - θ)) ^ p ∂μ) ^ (1 / p)
      ≤ ((∫⁻ x, F x ^ p ∂μ) ^ θ * (∫⁻ x, G x ^ p ∂μ) ^ (1 - θ)) ^ (1 / p) := by
        refine ENNReal.rpow_le_rpow ?_ (by positivity)
        simp only [ENNReal.mul_rpow_of_nonneg _ _ hp.le]
        exact h
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, mul_comm θ, mul_comm (1 - θ)]

/-! ### Case 1 for `n = 1`: assembly -/

/-- `1 + log λ ≤ 2 (L + 1)` with `L = log(2 + (2^{-k} + 2^{ℓ+1} + 2^k) λ^{1/2})`, `ℓ ≥ 0`. -/
theorem one_add_log_le_case1 {α : ℝ} (hα : 0 < α) {ℓ : ℤ} (hℓ : 0 ≤ ℓ) (k : ℤ) :
    1 + Real.log (dyadicPoint α ℓ) ≤
      2 * (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1) := by
  have hl0 := dyadicPoint_pos α ℓ
  have hS : 1 ≤ case1Scale ℓ k := by
    unfold case1Scale
    have h1 : (1 : ℝ) ≤ 2 ^ (ℓ + 1) := one_le_zpow₀ (by norm_num) (by omega)
    have : (0 : ℝ) < (2 ^ k)⁻¹ := by positivity
    have : (0 : ℝ) < 2 ^ k := by positivity
    linarith
  have hsq : 0 < dyadicPoint α ℓ ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos hl0 _
  have h1 : Real.log (dyadicPoint α ℓ) = 2 * Real.log (dyadicPoint α ℓ ^ (1 / 2 : ℝ)) := by
    rw [Real.log_rpow hl0]; ring
  have h2 : Real.log (dyadicPoint α ℓ ^ (1 / 2 : ℝ)) ≤
      Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) :=
    Real.log_le_log hsq (by nlinarith)
  have h3 : 0 ≤ Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) :=
    Real.log_nonneg (by nlinarith)
  have h4 : 0 ≤ Real.log (dyadicPoint α ℓ ^ (1 / 2 : ℝ)) :=
    Real.log_nonneg (Real.one_le_rpow (Real.one_le_rpow (by norm_num)
      (by have : (0 : ℝ) ≤ ℓ := by exact_mod_cast hℓ
          positivity)) (by norm_num))
  linarith

/-- **Interpolation of the single-piece bounds** (log-convexity + Hölder in `x`): from
`‖S_2‖_p ≤ a ‖f‖_p` and `‖S_p‖_p ≤ b ‖f‖_p` get `‖S_r‖_p ≤ a^θ b^{1-θ} ‖f‖_p`
for `1/r = θ/2 + (1-θ)/p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_shortPieceVar_interp_le {n : ℕ} {Ω : Rn n → ℝ}
    (hΩ : IsHomogeneousCZKernel n Ω) {α r p θ : ℝ} (hα : 0 < α) (hr : 0 < r) (hp : 0 < p)
    (hθ0 : 0 < θ) (hθ1 : θ < 1) (hrθ : 1 / r = θ / 2 + (1 - θ) / p) (ℓ k : ℤ)
    (f : 𝓢(Rn n, ℂ)) {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b)
    (h2 : eLpNorm (shortPieceVar 2 n α Ω ℓ k f) (ENNReal.ofReal p) ≤
      ENNReal.ofReal a * eLpNorm f (ENNReal.ofReal p))
    (hpp : eLpNorm (shortPieceVar p n α Ω ℓ k f) (ENNReal.ofReal p) ≤
      ENNReal.ofReal b * eLpNorm f (ENNReal.ofReal p)) :
    eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
      ENNReal.ofReal (a ^ θ * b ^ (1 - θ)) * eLpNorm f (ENNReal.ofReal p) := by
  have h1θ : 0 < 1 - θ := by linarith
  obtain ⟨F, hF⟩ : ∃ F, F = eLpNorm f (ENNReal.ofReal p) := ⟨_, rfl⟩
  rw [← hF] at h2 hpp ⊢
  have step1 : eLpNorm (shortPieceVar r n α Ω ℓ k f) (ENNReal.ofReal p) ≤
      eLpNorm (fun x => shortPieceVar 2 n α Ω ℓ k f x ^ θ *
        shortPieceVar p n α Ω ℓ k f x ^ (1 - θ)) (ENNReal.ofReal p) :=
    eLpNorm_mono_enorm (hΩ.measurable_shortPieceVar hα r ℓ k f).aestronglyMeasurable
      fun x => (enorm_eq_self _).trans_le ((shortPieceVar_le_interp (n := n) (Ω := Ω)
        (α := α) hr hp hθ0 hθ1 hrθ ℓ k f x).trans_eq (enorm_eq_self _).symm)
  have step2 := eLpNorm_interp_rpow_mul_le (μ := volume)
    (hΩ.measurable_shortPieceVar hα 2 ℓ k f).aemeasurable
    (hΩ.measurable_shortPieceVar hα p ℓ k f).aemeasurable hp hθ0 hθ1
  have step3 := mul_le_mul' (ENNReal.rpow_le_rpow h2 hθ0.le) (ENNReal.rpow_le_rpow hpp h1θ.le)
  have hFF : F ^ θ * F ^ (1 - θ) = F := by
    rw [← ENNReal.rpow_add_of_nonneg _ _ hθ0.le h1θ.le, add_sub_cancel, ENNReal.rpow_one]
  have step4 : (ENNReal.ofReal a * F) ^ θ * (ENNReal.ofReal b * F) ^ (1 - θ) =
      ENNReal.ofReal (a ^ θ * b ^ (1 - θ)) * F := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hθ0.le, ENNReal.mul_rpow_of_nonneg _ _ h1θ.le,
      ENNReal.ofReal_rpow_of_nonneg ha hθ0.le, ENNReal.ofReal_rpow_of_nonneg hb h1θ.le,
      ENNReal.ofReal_mul (by positivity)]
    calc ENNReal.ofReal (a ^ θ) * F ^ θ * (ENNReal.ofReal (b ^ (1 - θ)) * F ^ (1 - θ))
        = ENNReal.ofReal (a ^ θ) * ENNReal.ofReal (b ^ (1 - θ)) * (F ^ θ * F ^ (1 - θ)) := by
          ring
      _ = _ := by rw [hFF]
  exact step1.trans (step2.trans (step3.trans step4.le))

/-- The real inequality `(C₂ L)^θ (2 C_p L λ^{-γ})^{1-θ} ≤ (C₂ + 2C_p) L λ^{-(1-θ)γ}`. -/
theorem interp_real_le {C₂ Cp L lam γ θ : ℝ} (hC₂ : 0 ≤ C₂) (hCp : 0 ≤ Cp) (hL : 0 ≤ L)
    (hlam : 0 < lam) (hθ0 : 0 < θ) (hθ1 : θ < 1) :
    (C₂ * L) ^ θ * (2 * Cp * L * lam ^ (-γ)) ^ (1 - θ) ≤
      (C₂ + 2 * Cp) * L * lam ^ (-((1 - θ) * γ)) := by
  have h1θ : 0 < 1 - θ := by linarith
  have hl1 : 0 ≤ lam ^ (-γ) := Real.rpow_nonneg hlam.le _
  have e : (C₂ * L) ^ θ * (2 * Cp * L * lam ^ (-γ)) ^ (1 - θ) =
      (C₂ ^ θ * (2 * Cp) ^ (1 - θ)) * L * lam ^ (-((1 - θ) * γ)) := by
    rw [Real.mul_rpow hC₂ hL, Real.mul_rpow (by positivity) hl1,
      Real.mul_rpow (by positivity) hL, ← Real.rpow_mul hlam.le]
    have hLL : L ^ θ * L ^ (1 - θ) = L := by
      rcases hL.eq_or_lt with h0 | h0
      · rw [← h0, Real.zero_rpow hθ0.ne', zero_mul]
      · rw [← Real.rpow_add h0, add_sub_cancel, Real.rpow_one]
    rw [show -γ * (1 - θ) = -((1 - θ) * γ) by ring]
    calc C₂ ^ θ * L ^ θ * ((2 * Cp) ^ (1 - θ) * L ^ (1 - θ) * lam ^ (-((1 - θ) * γ)))
        = C₂ ^ θ * (2 * Cp) ^ (1 - θ) * (L ^ θ * L ^ (1 - θ)) * lam ^ (-((1 - θ) * γ)) := by
          ring
      _ = _ := by rw [hLL]
  rw [e]
  have hAM := Real.geom_mean_le_arith_mean2_weighted hθ0.le h1θ.le hC₂
    (by positivity : (0 : ℝ) ≤ 2 * Cp) (by ring)
  have hle : C₂ ^ θ * (2 * Cp) ^ (1 - θ) ≤ C₂ + 2 * Cp := by nlinarith
  have hl2 : 0 ≤ lam ^ (-((1 - θ) * γ)) := Real.rpow_nonneg hlam.le _
  gcongr


set_option maxHeartbeats 1000000 in
-- The proof assembles the `(p, 2)` and `(p, p)` bounds by log-convexity in
-- `[0, ∞]`-valued arithmetic.
/-- **Case 1 single pieces for `n = 1`** (paper §4.4.4, (`eq:eachpiece`); route: `(p, p)` by the
`V^p`-embedding and Carleson–Sjölin, `(p, 2)` by Seeger, log-convexity for `2 < r < p`,
monotonicity for `r ≥ p`): for `α > 1`, `p > 2`, `r > 2` there are `C ≥ 0`, `δ > 0` with
`‖(∑_j V^r_j(𝓗^{(u)}_{ℓ-j} P_{j+k} f)^r)^{1/r}‖_p ≤ C (L + 1) λ^{-δ} ‖f‖_p` for all `ℓ ≥ 0`,
`k` (`λ = 2^{ℓα}`, `L` as in `case1_tsum_le_of_decay`). -/
theorem IsHomogeneousCZKernel.eLpNorm_shortPieceVar_le_n_one {Ω : Rn 1 → ℝ}
    (hΩ : IsHomogeneousCZKernel 1 Ω) {α : ℝ} (hα : 1 < α) {r p : ℝ} (hr : 2 < r) (hp : 2 < p) :
    ∃ C δ : ℝ, 0 ≤ C ∧ 0 < δ ∧ ∀ ℓ k : ℤ, 0 ≤ ℓ → ∀ f : 𝓢(Rn 1, ℂ),
      eLpNorm (shortPieceVar r 1 α Ω ℓ k f) (ENNReal.ofReal p) ≤
        ENNReal.ofReal (C * (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1) *
          dyadicPoint α ℓ ^ (-δ)) * eLpNorm f (ENNReal.ofReal p) := by
  have hα0 : 0 < α := by linarith
  have hp0 : 0 < p := by linarith
  have hr0 : 0 < r := by linarith
  obtain ⟨C₂, hC₂, h2⟩ := hΩ.eLpNorm_shortPieceVar_le_of_ge_two le_rfl hα (r := 2) le_rfl hp.le
  obtain ⟨Cp, hCp, hpp⟩ := hΩ.eLpNorm_shortPieceVar_pp hα hp
  have hγ : 0 < csExp p - 1 / p := by
    have := one_lt_mul_csExp hp
    rw [sub_pos, div_lt_iff₀ hp0]; linarith
  set γ := csExp p - 1 / p
  -- the `(p, 2)` bound in the form `C₂ (L + 1)`
  have h2' : ∀ ℓ k : ℤ, 0 ≤ ℓ → ∀ f : 𝓢(Rn 1, ℂ),
      eLpNorm (shortPieceVar 2 1 α Ω ℓ k f) (ENNReal.ofReal p) ≤ ENNReal.ofReal (C₂ *
        (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1)) *
          eLpNorm f (ENNReal.ofReal p) := by
    intro ℓ k hℓ f
    have := h2 ℓ k hℓ f
    simp only [Nat.cast_one, sub_self, neg_zero, zero_div, Real.rpow_zero, mul_one] at this
    exact this
  -- the `(p, p)` bound in the form `2 C_p (L + 1) λ^{-γ}`
  have hpp' : ∀ ℓ k : ℤ, 1 ≤ ℓ → ∀ f : 𝓢(Rn 1, ℂ),
      eLpNorm (shortPieceVar p 1 α Ω ℓ k f) (ENNReal.ofReal p) ≤ ENNReal.ofReal (2 * Cp *
        (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1) *
          dyadicPoint α ℓ ^ (-γ)) * eLpNorm f (ENNReal.ofReal p) := by
    intro ℓ k hℓ f
    refine (hpp ℓ k hℓ f).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have h1 := one_add_log_le_case1 hα0 (by omega : (0 : ℤ) ≤ ℓ) k
    have hl := Real.rpow_nonneg (dyadicPoint_pos α ℓ).le (-γ)
    rw [show 1 / p - csExp p = -γ by simp only [γ]; ring]
    have := mul_le_mul_of_nonneg_left h1 (mul_nonneg hCp hl)
    nlinarith
  -- the case `ℓ = 0`
  have hzero : ∀ (C δ : ℝ), C₂ ≤ C → ∀ k : ℤ, ∀ f : 𝓢(Rn 1, ℂ),
      eLpNorm (shortPieceVar r 1 α Ω 0 k f) (ENNReal.ofReal p) ≤
        ENNReal.ofReal (C * (Real.log (2 + case1Scale 0 k * dyadicPoint α 0 ^ (1 / 2 : ℝ)) + 1) *
          dyadicPoint α 0 ^ (-δ)) * eLpNorm f (ENNReal.ofReal p) := by
    intro C δ hC k f
    refine (eLpNorm_mono_enorm (hΩ.measurable_shortPieceVar hα0 r 0 k f).aestronglyMeasurable
      fun x => ?_).trans ((h2' 0 k le_rfl f).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_)
        le_rfl))
    · simp only [enorm_eq_self]; exact shortPieceVar_le_of_le two_pos hr.le 0 k f x
    · have hd : dyadicPoint α 0 = 1 := by simp [dyadicPoint]
      have hL := Real.log_nonneg (show (1 : ℝ) ≤ 2 + case1Scale 0 k * dyadicPoint α 0 ^
        (1 / 2 : ℝ) by rw [hd, Real.one_rpow]; have := case1Scale_pos 0 k; linarith)
      simp only [hd, Real.one_rpow, mul_one] at hL ⊢
      exact mul_le_mul_of_nonneg_right hC (by linarith)
  rcases le_or_gt p r with hpr | hpr
  · -- `r ≥ p`: monotonicity
    refine ⟨C₂ + 2 * Cp, γ, by positivity, hγ, fun ℓ k hℓ f => ?_⟩
    rcases hℓ.eq_or_lt with h0 | h1
    · subst h0; exact hzero _ _ (by linarith) k f
    · refine (eLpNorm_mono_enorm (hΩ.measurable_shortPieceVar hα0 r ℓ k f).aestronglyMeasurable
        fun x => ?_).trans ((hpp' ℓ k h1 f).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_)
          le_rfl))
      · simp only [enorm_eq_self]; exact shortPieceVar_le_of_le hp0 hpr ℓ k f x
      · have hL := Real.log_nonneg (show (1 : ℝ) ≤ 2 + case1Scale ℓ k * dyadicPoint α ℓ ^
          (1 / 2 : ℝ) by
            have := case1Scale_pos ℓ k
            have := Real.rpow_nonneg (dyadicPoint_pos α ℓ).le (1 / 2 : ℝ)
            nlinarith)
        have hl := Real.rpow_nonneg (dyadicPoint_pos α ℓ).le (-γ)
        have : 0 ≤ C₂ * (Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1) *
          dyadicPoint α ℓ ^ (-γ) := by positivity
        nlinarith
  · -- `2 < r < p`: log-convexity
    set θ := (1 / r - 1 / p) / (1 / 2 - 1 / p)
    have hd : 0 < 1 / 2 - 1 / p := by
      rw [sub_pos]; exact one_div_lt_one_div_of_lt two_pos hp
    have hθ0 : 0 < θ := div_pos (by rw [sub_pos]; exact one_div_lt_one_div_of_lt hr0 hpr) hd
    have hθ1 : θ < 1 := by
      rw [div_lt_one hd]; exact sub_lt_sub_right (one_div_lt_one_div_of_lt two_pos hr) _
    have hrθ : 1 / r = θ / 2 + (1 - θ) / p := by
      rw [show θ / 2 + (1 - θ) / p = 1 / p + θ * (1 / 2 - 1 / p) by ring]
      simp only [θ]; rw [div_mul_cancel₀ _ hd.ne']; ring
    have h1θ : 0 < 1 - θ := by linarith
    refine ⟨C₂ + 2 * Cp, (1 - θ) * γ, by positivity, by positivity, fun ℓ k hℓ f => ?_⟩
    rcases hℓ.eq_or_lt with h0 | h1
    · subst h0; exact hzero _ _ (by linarith) k f
    set L := Real.log (2 + case1Scale ℓ k * dyadicPoint α ℓ ^ (1 / 2 : ℝ)) + 1
    have hL : 1 ≤ L := by
      have := Real.log_nonneg (show (1 : ℝ) ≤ 2 + case1Scale ℓ k * dyadicPoint α ℓ ^
        (1 / 2 : ℝ) by
          have := case1Scale_pos ℓ k
          have := Real.rpow_nonneg (dyadicPoint_pos α ℓ).le (1 / 2 : ℝ)
          nlinarith)
      simp only [L]; linarith
    have hlam := dyadicPoint_pos α ℓ
    have hl1 : 0 ≤ dyadicPoint α ℓ ^ (-γ) := Real.rpow_nonneg hlam.le _
    refine (hΩ.eLpNorm_shortPieceVar_interp_le hα0 hr0 hp0 hθ0 hθ1 hrθ ℓ k f
      (a := C₂ * L) (b := 2 * Cp * L * dyadicPoint α ℓ ^ (-γ)) (by positivity) (by positivity)
      (h2' ℓ k hℓ f) (hpp' ℓ k h1 f)).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    exact interp_real_le hC₂.le hCp (by linarith) hlam hθ0 hθ1

/-- **The short variation estimate for `n = 1`, `2 < p < ∞`, `2 < r < ∞`** (paper
(`eq:mainest_Sect4`) for `n = 1`; route: §4.4.4 with Carleson–Sjölin instead of Thm 1.6): for
`α > 1` there is `C < ∞` such that for all Schwartz `f`, `‖S_r(𝓗 f)‖_p ≤ C ‖f‖_p`. -/
theorem IsHomogeneousCZKernel.eLpNorm_shortVariation_le_n_one {Ω : Rn 1 → ℝ}
    (hΩ : IsHomogeneousCZKernel 1 Ω) {α : ℝ} (hα : 1 < α) {r : ℝ} (hr : 2 < r) {p : ℝ}
    (hp : 2 < p) :
    ∃ C : ℝ≥0∞, C ≠ ∞ ∧ ∀ f : 𝓢(Rn 1, ℂ),
      eLpNorm (fun x => shortVariation r α (fun u => modulatedSI 1 α Ω u f x))
        (ENNReal.ofReal p) ≤ C * eLpNorm f (ENNReal.ofReal p) := by
  obtain ⟨C, hC, hmain⟩ := hΩ.eLpNorm_shortVariation_le_of_case1 le_rfl hα hr.le
    (by linarith : (1 : ℝ) < p)
  obtain ⟨C₀, δ, hC₀, hδ, hpiece⟩ := hΩ.eLpNorm_shortPieceVar_le_n_one hα hr hp
  obtain ⟨C₁, hC₁, hsum⟩ := case1_tsum_le_of_decay hα hδ hC₀
  exact ⟨C + C₁, ENNReal.add_ne_top.2 ⟨hC, hC₁⟩, fun f =>
    hmain C₁ f (hsum _ _ fun ℓ k h => hpiece ℓ k h.1 f)⟩

end

end Auto
